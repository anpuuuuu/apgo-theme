{% comment %}
  購物車商品區塊 - 包含標題
  檔案位置: snippets/cart-products-with-header.liquid
{% endcomment %}

<style>
  /* 購物車商品標題區塊 - 使用加購區塊相同樣式 */
  .cart-products-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: center;
    margin-bottom: 16px;
    padding: 0 12px;
  }

  .cart-products-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary, #000000);
    margin: 0;
    position: relative;
    padding-left: 12px;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cart-products-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 20px;
    background: linear-gradient(135deg, #ff6b35, #f7931e);
    border-radius: 2px;
  }

  /* 可選的操作按鈕（如清空購物車） */
  .cart-products-action {
    background: transparent;
    color: #ff6b35;
    border: 1px solid #ff6b35;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    justify-self: end;
  }

  .cart-products-action:hover {
    background: linear-gradient(135deg, #ff6b35, #f7931e);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
  }

  /* 響應式設計 */
  @media (max-width: 768px) {
    .cart-products-header {
      margin-bottom: 12px;
      padding: 0 8px;
    }

    .cart-products-title {
      font-size: 16px;
    }

    .cart-products-action {
      padding: 5px 12px;
      font-size: 12px;
    }
  }

  @media (max-width: 480px) {
    .cart-products-header {
      gap: 8px;
    }

    .cart-products-title {
      font-size: 14px;
      padding-left: 10px;
    }

    .cart-products-title::before {
      width: 3px;
      height: 16px;
    }

    .cart-products-action {
      padding: 4px 8px;
      font-size: 11px;
      border-radius: 16px;
    }
  }

  @media (max-width: 375px) {
    .cart-products-title {
      font-size: 13px;
      padding-left: 8px;
    }

    .cart-products-title::before {
      width: 2px;
      height: 14px;
    }

    .cart-products-action {
      padding: 3px 8px;
      font-size: 10px;
    }
  }

  /* 原始購物車樣式保持 */
  .cart-page--empty .cart-items__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-block-start: 0;
    text-align: center;
  }

  .cart-page__title + .cart-page__items {
    margin-block-start: var(--margin-lg);
  }

  /* =========================================================
     APGO Cart UI upgrade (2026-05) — inline so cascade order
     guarantees this beats any earlier base.css / section stylesheet.
     ========================================================= */
  .cart-products-title {
    color: #ffffff !important;
    font-size: 15px !important;
    font-weight: 700 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    padding-left: 14px !important;
  }
  .cart-products-title::before {
    width: 4px !important;
    height: 16px !important;
    border-radius: 2px !important;
    background: linear-gradient(180deg, #f08418, #ff9a3c) !important;
  }
  .cart-products-action {
    color: rgba(255, 255, 255, 0.7) !important;
    border-color: rgba(255, 255, 255, 0.12) !important;
    background: transparent !important;
  }
  .cart-products-action:hover {
    color: #f08418 !important;
    border-color: #f08418 !important;
    background: transparent !important;
    box-shadow: none !important;
    transform: none !important;
  }

  /* Cart items wrap → dark card */
  .cart-items {
    background: rgba(255, 255, 255, 0.025) !important;
    border: 1px solid rgba(255, 255, 255, 0.07) !important;
    border-radius: 14px !important;
    padding: 4px 12px !important;
  }
  /* No divider line between items on any viewport. The snippet's default
     adds border-bottom + my own previous override added border-top — kill
     both. */
  .cart-items--dividers .cart-items__table-row,
  .cart-items--dividers .cart-items__table-row + .cart-items__table-row {
    border-top: 0 !important;
    border-bottom: 0 !important;
  }
  .cart-items__table-row {
    padding-block: 14px !important;
  }

  /* Product thumb */
  .cart-items__media-container,
  .cart-items__media {
    border-radius: 10px !important;
    overflow: hidden !important;
    background: rgba(255, 255, 255, 0.04) !important;
    border: 1px solid rgba(255, 255, 255, 0.06) !important;
  }

  /* Title + variant */
  .cart-items__title,
  .cart-items__title a {
    color: rgba(255, 255, 255, 0.95) !important;
    font-weight: 600 !important;
    font-size: 15px !important;
    line-height: 1.35 !important;
    text-decoration: none !important;
  }
  .cart-items__title a:hover { color: #f08418 !important; }
  .cart-items__variants,
  .cart-items__variant,
  .cart-items__bundle {
    color: rgba(255, 255, 255, 0.55) !important;
    font-size: 13px !important;
  }

  /* Inline price under title */
  .cart-items__details .compare-at-price {
    color: rgba(255, 255, 255, 0.35) !important;
    text-decoration: line-through !important;
    font-size: 13px !important;
    margin-left: 4px !important;
  }

  /* Quantity stepper */
  .cart-items__quantity quantity-input,
  .cart-items__quantity .quantity-selector,
  .cart-items__quantity {
    background: rgba(0, 0, 0, 0.35) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-radius: 8px !important;
    overflow: hidden !important;
  }
  .cart-items__quantity button,
  .cart-items__quantity .quantity-selector__button {
    background: transparent !important;
    border: 0 !important;
    color: rgba(255, 255, 255, 0.8) !important;
    width: 32px !important;
    height: 32px !important;
  }
  .cart-items__quantity button:hover,
  .cart-items__quantity .quantity-selector__button:hover {
    color: #f08418 !important;
  }
  .cart-items__quantity input,
  .cart-items__quantity .quantity-selector__input {
    background: transparent !important;
    border: 0 !important;
    color: #ffffff !important;
    font-size: 14px !important;
    text-align: center !important;
    width: 38px !important;
  }

  /* Remove button */
  .cart-items__remove {
    color: rgba(255, 255, 255, 0.45) !important;
    background: transparent !important;
    border: 0 !important;
    padding: 6px !important;
    border-radius: 6px !important;
  }
  .cart-items__remove:hover {
    color: #f08418 !important;
    background: rgba(240, 132, 24, 0.08) !important;
  }

  /* Line-item price column */
  .cart-items__price {
    color: #f08418 !important;
    font-weight: 700 !important;
    font-size: 15px !important;
  }
  .cart-items__price .compare-at-price {
    color: rgba(255, 255, 255, 0.4) !important;
    font-weight: 400 !important;
    font-size: 12px !important;
    text-decoration: line-through !important;
    margin-left: 6px !important;
  }
  .cart-items__price-unit {
    color: rgba(255, 255, 255, 0.5) !important;
    font-size: 12px !important;
  }

  /* Cart-page H1 + count chip (rendered by _cart-title block above) */
  .cart-title,
  .cart-page__title h1 {
    color: #ffffff !important;
    font-weight: 700 !important;
  }
  .cart-title__count {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: 28px !important;
    height: 28px !important;
    padding: 0 8px !important;
    margin-left: 10px !important;
    border-radius: 999px !important;
    background: rgba(240, 132, 24, 0.15) !important;
    color: #f08418 !important;
    font-size: 13px !important;
    font-weight: 600 !important;
  }

  @media (max-width: 749px) {
    /* Align the cart-items area's horizontal edge with the free-shipping
       bar below. .cart-page__items adds its own padding-inline on top of
       the section wrapper, so cards ended up inset from the section edge.
       Zero out the inner paddings and let the cards sit flush with the
       same edge the free-shipping bar uses. */
    .cart-page__items,
    .cart-page__title,
    .cart-page__more-blocks {
      padding-inline: 0 !important;
    }
    .cart-products-header {
      padding: 0 !important;
    }

    /* Outer card chrome off — each row is its own padded block */
    .cart-items {
      padding: 0 !important;
      background: transparent !important;
      border: 0 !important;
    }
    /* Remove white divider line between items */
    .cart-items--dividers .cart-items__table-row {
      border-bottom: 0 !important;
      margin-bottom: 10px !important;
      padding-block: 0 !important;
    }

    /*
      Override the snippet's default grid-template-areas. Default mobile
      layout is 3 columns (media|details|price + qty row). We collapse to
      2 columns + 2 rows so qty + price share the right cell visually.
        +--------+----------------+
        |        | title (ellipsis)|
        | image  | variant         |
        |        | price · [- 1 +] |
        +--------+----------------+
    */
    .cart-items__table-row {
      display: grid !important;
      grid-template-columns: 33% minmax(0, 1fr) !important;
      grid-template-rows: auto auto !important;
      grid-template-areas:
        'media details'
        'media quantity' !important;
      column-gap: 12px !important;
      row-gap: 6px !important;
      align-items: start !important;
      position: relative !important;
      padding: 12px !important;
      background: rgba(255, 255, 255, 0.025) !important;
      border: 1px solid rgba(255, 255, 255, 0.07) !important;
      border-radius: 12px !important;
    }
    /* Image cell — square thumbnail, spans both rows */
    .cart-items__media {
      grid-area: media !important;
      grid-row: 1 / 3 !important;
      padding: 0 !important;
    }
    .cart-items__media-container {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      aspect-ratio: 1 / 1 !important;
      --ratio: 1 !important;
      border-radius: 10px !important;
      overflow: hidden !important;
    }
    /* Use intrinsic max sizing instead of width/height:100% so the image's
       own aspect ratio is preserved and `object-fit: contain` actually has
       a working box (height:100% inside an aspect-ratio container can
       collapse to 0 if the flex parent doesn't pass an explicit height). */
    .cart-items__media-image {
      max-width: 100% !important;
      max-height: 100% !important;
      width: auto !important;
      height: auto !important;
      object-fit: contain !important;
    }
    /* Details cell — title / variant / inline price stacked */
    .cart-items__details {
      grid-area: details !important;
      min-width: 0 !important;
      padding-right: 0 !important;
      padding-bottom: 0 !important;
      color: rgba(255, 255, 255, 0.95) !important;
    }
    .cart-items__details > p:first-child {
      margin: 0 !important;
    }
    .cart-items__title,
    .cart-items__title a {
      display: block !important;
      font-size: 14px !important;
      font-weight: 600 !important;
      line-height: 1.35 !important;
      color: rgba(255, 255, 255, 0.95) !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
      max-width: 100% !important;
    }
    .cart-items__variants,
    .cart-items__variant,
    .cart-items__bundle {
      font-size: 12px !important;
      margin-top: 4px !important;
      color: rgba(255, 255, 255, 0.55) !important;
    }
    /* Price block = last <div> inside details. Orange bold. */
    .cart-items__details > div:last-child {
      margin-top: 6px !important;
      font-size: 15px !important;
      font-weight: 700 !important;
      color: #f08418 !important;
      display: flex !important;
      align-items: baseline !important;
      gap: 6px !important;
    }
    .cart-items__details > div:last-child .compare-at-price {
      color: rgba(255, 255, 255, 0.4) !important;
      font-weight: 400 !important;
      font-size: 12px !important;
    }
    /* Hide the redundant line-item total column on the right */
    .cart-items__price {
      display: none !important;
    }
    /* Quantity stepper: row below the price, in the details column.
       Borderless wrapper per request; small 24×24 +/- buttons. */
    .cart-items__quantity {
      grid-area: quantity !important;
      position: static !important;
      display: flex !important;
      align-items: center !important;
      gap: 4px !important;
      background: transparent !important;
      border: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
      justify-self: start !important;
    }
    /* Inner quantity-selector-component (custom element) */
    .cart-items__quantity .quantity-selector {
      display: inline-flex !important;
      align-items: center !important;
      background: transparent !important;
      border: 0 !important;
      padding: 0 !important;
      gap: 2px !important;
      height: auto !important;
      box-shadow: none !important;
    }
    /* +/- buttons (real class names: quantity-minus, quantity-plus) */
    .cart-items__quantity .quantity-minus,
    .cart-items__quantity .quantity-plus {
      width: 24px !important;
      height: 24px !important;
      min-width: 24px !important;
      min-height: 24px !important;
      padding: 0 !important;
      background: transparent !important;
      border: 1px solid rgba(255, 255, 255, 0.2) !important;
      border-radius: 6px !important;
      color: rgba(255, 255, 255, 0.85) !important;
      box-shadow: none !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
    }
    .cart-items__quantity .quantity-minus .svg-wrapper,
    .cart-items__quantity .quantity-plus .svg-wrapper {
      width: 12px !important;
      height: 12px !important;
    }
    .cart-items__quantity .quantity-minus svg,
    .cart-items__quantity .quantity-plus svg {
      width: 12px !important;
      height: 12px !important;
    }
    /* Quantity numeric input */
    .cart-items__quantity .quantity-selector input[type="number"],
    .cart-items__quantity input[type="number"] {
      width: 24px !important;
      min-width: 24px !important;
      height: 24px !important;
      padding: 0 !important;
      font-size: 13px !important;
      color: #fff !important;
      background: transparent !important;
      border: 0 !important;
      text-align: center !important;
      -moz-appearance: textfield !important;
    }
    .cart-items__quantity input[type="number"]::-webkit-outer-spin-button,
    .cart-items__quantity input[type="number"]::-webkit-inner-spin-button {
      -webkit-appearance: none !important; margin: 0 !important;
    }
    /* Remove button (trash icon) — small */
    .cart-items__remove {
      width: 24px !important;
      height: 24px !important;
      min-width: 24px !important;
      min-height: 24px !important;
      padding: 0 !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      color: rgba(255, 255, 255, 0.5) !important;
    }
    .cart-items__remove svg,
    .cart-items__remove .svg-wrapper {
      width: 14px !important;
      height: 14px !important;
    }
    /* Error row spans full width below the card */
    .cart-items__error {
      grid-column: 1 / -1 !important;
      margin-top: 6px !important;
    }
  }

  /* =========================================================
     Free-gift (GWP) line-item styling — applied via JS adding
     .apgo-cart-item--gift to a .cart-items__table-row when
     item.properties._free_gift === 'true'.
     ========================================================= */
  .apgo-cart-item--gift .apgo-cart-gift-badge {
    display: inline-flex !important;
    align-items: center !important;
    gap: 4px !important;
    padding: 2px 8px !important;
    margin: 4px 0 0 !important;
    border-radius: 999px !important;
    background: linear-gradient(45deg, #f08418, #ff9a3c) !important;
    color: #fff !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase !important;
    line-height: 1.4 !important;
    box-shadow: 0 2px 8px rgba(240, 132, 24, 0.35) !important;
  }
  .apgo-cart-item--gift .apgo-cart-gift-sub {
    display: block !important;
    font-size: 11px !important;
    color: rgba(255, 255, 255, 0.55) !important;
    margin-top: 2px !important;
    font-weight: 500 !important;
  }
  /* Lock quantity stepper buttons + input on gift rows */
  .apgo-cart-item--gift .cart-items__quantity .quantity-minus,
  .apgo-cart-item--gift .cart-items__quantity .quantity-plus,
  .apgo-cart-item--gift .cart-items__quantity .quantity-selector__button {
    opacity: 0.4 !important;
    pointer-events: none !important;
    cursor: not-allowed !important;
  }
  .apgo-cart-item--gift .cart-items__quantity input[type="number"] {
    pointer-events: none !important;
    color: rgba(255, 255, 255, 0.55) !important;
  }
  /* Price column → show "FREE" in green-ish accent */
  .apgo-cart-item--gift .cart-items__price {
    color: #34d399 !important;
    font-weight: 700 !important;
  }
  .apgo-cart-item--gift .cart-items__price .compare-at-price {
    display: none !important;
  }
  .apgo-cart-item--gift .cart-items__details .compare-at-price {
    display: none !important;
  }
</style>

<!-- 購物車商品標題 -->
<div class="cart-products-header">
  <h3 class="cart-products-title">{{ section.settings.header_title | default: 'Cart Item' }}</h3>
  {% if section.settings.show_action_button %}
    {% if section.settings.action_type == 'clear' %}
      <button type="button" class="cart-products-action" onclick="clearCart(event)">
        {{ section.settings.action_text | default: '清空購物車' }}
      </button>
    {% elsif section.settings.action_type == 'link' %}
      <a href="{{ section.settings.action_url }}" class="cart-products-action">
        {{ section.settings.action_text | default: '繼續購物' }}
        <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
          <path d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z"/>
        </svg>
      </a>
    {% endif %}
  {% endif %}
</div>

<!-- 原始購物車商品內容 -->
{% render 'cart-products' %}

{%- comment -%}
  Free-gift line-item decorator. Reads /cart.js, marks rows whose
  line-item properties include `_free_gift === 'true'` with:
    .apgo-cart-item--gift class on the table row
    🎁 FREE GIFT badge inside the details cell
    "Free with <X title>" sub-label (if _gift_from_product is present)
    Trash button gets a localStorage dismiss flag so the gift doesn't
    auto-re-add on next product page visit.
  Reruns on every cart-update event so AJAX-driven changes pick up.
{%- endcomment -%}
<script>
(function () {
  'use strict';

  function decorateGifts() {
    fetch('/cart.js?_=' + Date.now(), { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var giftLines = (cart.items || []).filter(function (i) {
          return i.properties && i.properties._free_gift === 'true';
        });
        /* Build map of line-key → gift props so we can match against
           rendered rows that carry a line key in their ref or attr. */
        var giftByVariant = {};
        giftLines.forEach(function (l) { giftByVariant[l.variant_id] = l; });

        document.querySelectorAll('.cart-items__table-row').forEach(function (row) {
          /* Find which variant this row represents. The remove button has
             on:click="/onLineItemRemove/<index>" and rows carry the variant
             in their image href / title link. Easiest: read the qty input's
             data-cart-line attribute and look up cart.items[index-1]. */
          var qtyInput = row.querySelector('.cart-items__quantity input[type="number"]');
          var lineIdx = qtyInput ? parseInt(qtyInput.getAttribute('data-cart-line'), 10) : NaN;
          if (isNaN(lineIdx)) return;
          var item = cart.items[lineIdx - 1];
          if (!item) return;

          var isGift = item.properties && item.properties._free_gift === 'true';
          row.classList.toggle('apgo-cart-item--gift', isGift);

          if (isGift) {
            var details = row.querySelector('.cart-items__details');
            if (details && !details.querySelector('.apgo-cart-gift-badge')) {
              var badge = document.createElement('span');
              badge.className = 'apgo-cart-gift-badge';
              badge.textContent = '🎁 Free gift';
              /* Insert badge right after the title <p> */
              var titleP = details.querySelector('p');
              if (titleP) titleP.insertAdjacentElement('afterend', badge);
              else details.prepend(badge);
            }
            if (details && !details.querySelector('.apgo-cart-gift-sub') && item.properties._gift_from_product) {
              var sub = document.createElement('span');
              sub.className = 'apgo-cart-gift-sub';
              sub.textContent = 'Free with ' + item.properties._gift_from_product;
              var existingBadge = details.querySelector('.apgo-cart-gift-badge');
              if (existingBadge) existingBadge.insertAdjacentElement('afterend', sub);
              else details.appendChild(sub);
            }
            /* When user clicks the remove (trash) button, record the
               dismiss so the gift doesn't re-add on next reconcile.
               IMPORTANT: must use sessionStorage to match the global
               reconciler (assets/apgo-gift-reconciler.js). Previously
               used localStorage which the reconciler never read → the
               dismiss flag never "stuck" and Y immediately came back. */
            var removeBtn = row.querySelector('.cart-items__remove');
            if (removeBtn && !removeBtn.dataset.apgoGiftDismissBound) {
              removeBtn.dataset.apgoGiftDismissBound = '1';
              removeBtn.addEventListener('click', function () {
                var xId = item.properties._gift_for;
                if (xId) {
                  try { sessionStorage.setItem('apgo_gift_dismissed_' + xId, '1'); } catch (_) {}
                  /* Also call the exposed helper if available — it goes
                     through the same sessionStorage path but stays robust
                     if the storage key prefix ever changes. */
                  if (typeof window.apgoDismissGift === 'function') {
                    try { window.apgoDismissGift(xId); } catch (_) {}
                  }
                }
              }, true);
            }
          }
        });
      })
      .catch(function () {});
  }

  /*
    Standalone reconciler — when the cart page loads and X has been
    removed (e.g. between sessions, or via quantity → 0 from the cart
    page), the stale Y gift needs to disappear. We have no access to
    APGO_GIFT_MAP here (it lives on the PDP), so we walk all gift
    lines and drop the ones whose `_gift_for` X variant id is no
    longer present in the cart.
  */
  function pruneStaleGifts() {
    return fetch('/cart.js?_=' + Date.now(), { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var presentXIds = new Set((cart.items || []).map(function (i) { return String(i.variant_id); }));
        var ops = [];
        (cart.items || []).forEach(function (i) {
          if (!i.properties || i.properties._free_gift !== 'true') return;
          var xId = i.properties._gift_for;
          if (!xId || presentXIds.has(String(xId))) return;
          var fd = new FormData();
          fd.append('id', i.key);
          fd.append('quantity', '0');
          ops.push(fetch('/cart/change.js', { method: 'POST', headers: { Accept: 'application/json' }, body: fd }).catch(function () {}));
        });
        if (ops.length) {
          return Promise.all(ops).then(function () {
            /* Reload cart page so the rendered items reflect the prune */
            window.location.reload();
          });
        }
      })
      .catch(function () {});
  }

  /* Run on page load + whenever the cart updates */
  document.addEventListener('DOMContentLoaded', function () {
    pruneStaleGifts();
    decorateGifts();
  });
  document.addEventListener('cart:update', function () { setTimeout(decorateGifts, 50); });
  document.addEventListener('cart:updated', function () { setTimeout(decorateGifts, 50); });
  document.addEventListener('cart:refresh', function () { setTimeout(decorateGifts, 50); });
  /* In case cart-update happens before this script runs */
  if (document.readyState !== 'loading') decorateGifts();
})();
</script>

{% if section.settings.show_action_button and section.settings.action_type == 'clear' %}
<script>
  function clearCart(event) {
    event.preventDefault();
    
    if (!confirm('確定要清空購物車嗎？')) {
      return;
    }
    
    // 清空購物車
    fetch(window.Shopify.routes.root + 'cart/clear.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      }
    })
    .then(response => response.json())
    .then(data => {
      // 重新載入頁面或更新購物車顯示
      window.location.reload();
    })
    .catch(error => {
      console.error('清空購物車失敗:', error);
    });
  }
</script>
{% endif %}

