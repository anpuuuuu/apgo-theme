{% comment %}
  購物車商品區塊 - 包含標題
  檔案位置: snippets/cart-products-with-header.liquid
{% endcomment %}

<style>
  /* 購物車商品標題區塊 - 使用加購區塊相同樣式 */
  .cart-products-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px;
    align-items: center;
    margin-bottom: 16px;
    padding: 0 12px;
  }

  .cart-products-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    min-width: 0;
  }

  .cart-products-status {
    display: none;
    grid-column: 1 / -1;
    margin: 0;
    color: #ffb4ab;
    font-size: 12px;
    text-align: right;
  }

  .cart-products-status:not(:empty) {
    display: block;
  }

  .cart-products-title {
    font-size: 18px;
    font-weight: 600;
    color: var(--text-primary, #000000);
    margin: 0;
    position: relative;
    padding-left: 12px;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cart-products-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 20px;
    background: linear-gradient(135deg, #ff6b35, #f7931e);
    border-radius: 2px;
  }

  /* 可選的操作按鈕（如清空購物車） */
  .cart-products-action {
    background: transparent;
    color: #ff6b35;
    border: 1px solid #ff6b35;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    justify-self: end;
  }

  .cart-products-action:hover {
    background: linear-gradient(135deg, #ff6b35, #f7931e);
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
  }

  .cart-products-action:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }

  .cart-products-action--danger:not(:disabled):hover {
    color: #ff8a80 !important;
    border-color: rgba(255, 138, 128, 0.75) !important;
  }

  /* 響應式設計 */
  @media (max-width: 768px) {
    .cart-products-header {
      margin-bottom: 12px;
      padding: 0 8px;
    }

    .cart-products-title {
      font-size: 16px;
    }

    .cart-products-action {
      padding: 5px 12px;
      font-size: 12px;
    }
  }

  @media (max-width: 480px) {
    .cart-products-header {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .cart-products-actions {
      width: 100%;
      justify-content: stretch;
    }

    .cart-products-actions .cart-products-action {
      flex: 1 1 0;
      justify-content: center;
    }

    .cart-products-title {
      font-size: 14px;
      padding-left: 10px;
    }

    .cart-products-title::before {
      width: 3px;
      height: 16px;
    }

    .cart-products-action {
      padding: 4px 8px;
      font-size: 11px;
      border-radius: 16px;
    }
  }

  @media (max-width: 375px) {
    .cart-products-title {
      font-size: 13px;
      padding-left: 8px;
    }

    .cart-products-title::before {
      width: 2px;
      height: 14px;
    }

    .cart-products-action {
      padding: 3px 8px;
      font-size: 10px;
    }
  }

  /* 原始購物車樣式保持 */
  .cart-page--empty .cart-items__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-block-start: 0;
    text-align: center;
  }

  .cart-page__title + .cart-page__items {
    margin-block-start: var(--margin-lg);
  }

  /* =========================================================
     APGO Cart UI upgrade (2026-05) — inline so cascade order
     guarantees this beats any earlier base.css / section stylesheet.
     ========================================================= */
  .cart-products-title {
    color: #ffffff !important;
    font-size: 15px !important;
    font-weight: 700 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    padding-left: 14px !important;
  }
  .cart-products-title::before {
    width: 4px !important;
    height: 16px !important;
    border-radius: 2px !important;
    background: linear-gradient(180deg, #f08418, #ff9a3c) !important;
  }
  .cart-products-action {
    color: rgba(255, 255, 255, 0.7) !important;
    border-color: rgba(255, 255, 255, 0.12) !important;
    background: transparent !important;
  }
  .cart-products-action:hover {
    color: #f08418 !important;
    border-color: #f08418 !important;
    background: transparent !important;
    box-shadow: none !important;
    transform: none !important;
  }

  /* Cart items wrap → dark card */
  .cart-items {
    background: rgba(255, 255, 255, 0.025) !important;
    border: 1px solid rgba(255, 255, 255, 0.07) !important;
    border-radius: 14px !important;
    padding: 4px 12px !important;
  }
  /* No divider line between items on any viewport. The snippet's default
     adds border-bottom + my own previous override added border-top — kill
     both. */
  .cart-items--dividers .cart-items__table-row,
  .cart-items--dividers .cart-items__table-row + .cart-items__table-row {
    border-top: 0 !important;
    border-bottom: 0 !important;
  }
  .cart-items__table-row {
    padding-block: 14px !important;
  }

  /* Product thumb */
  .cart-items__media-container,
  .cart-items__media {
    border-radius: 10px !important;
    overflow: hidden !important;
    background: rgba(255, 255, 255, 0.04) !important;
    border: 1px solid rgba(255, 255, 255, 0.06) !important;
  }

  /* Title + variant */
  .cart-items__title,
  .cart-items__title a {
    color: rgba(255, 255, 255, 0.95) !important;
    font-weight: 600 !important;
    font-size: 15px !important;
    line-height: 1.35 !important;
    text-decoration: none !important;
  }
  .cart-items__title a:hover { color: #f08418 !important; }
  .cart-items__variants,
  .cart-items__variant,
  .cart-items__bundle {
    color: rgba(255, 255, 255, 0.55) !important;
    font-size: 13px !important;
  }

  /* Inline price under title */
  .cart-items__details .compare-at-price {
    color: rgba(255, 255, 255, 0.35) !important;
    text-decoration: line-through !important;
    font-size: 13px !important;
    margin-left: 4px !important;
  }

  /* Quantity stepper */
  .cart-items__quantity quantity-input,
  .cart-items__quantity .quantity-selector,
  .cart-items__quantity {
    background: rgba(0, 0, 0, 0.35) !important;
    border: 1px solid rgba(255, 255, 255, 0.12) !important;
    border-radius: 8px !important;
    overflow: hidden !important;
  }
  .cart-items__quantity button,
  .cart-items__quantity .quantity-selector__button {
    background: transparent !important;
    border: 0 !important;
    color: rgba(255, 255, 255, 0.8) !important;
    width: 32px !important;
    height: 32px !important;
  }
  .cart-items__quantity button:hover,
  .cart-items__quantity .quantity-selector__button:hover {
    color: #f08418 !important;
  }
  .cart-items__quantity input,
  .cart-items__quantity .quantity-selector__input {
    background: transparent !important;
    border: 0 !important;
    color: #ffffff !important;
    font-size: 14px !important;
    text-align: center !important;
    width: 38px !important;
  }

  /* Remove button */
  .cart-items__remove {
    color: rgba(255, 255, 255, 0.45) !important;
    background: transparent !important;
    border: 0 !important;
    padding: 6px !important;
    border-radius: 6px !important;
  }
  .cart-items__remove:hover {
    color: #f08418 !important;
    background: rgba(240, 132, 24, 0.08) !important;
  }

  /* Line-item price column */
  .cart-items__price {
    color: #f08418 !important;
    font-weight: 700 !important;
    font-size: 15px !important;
  }
  .cart-items__price .compare-at-price {
    color: rgba(255, 255, 255, 0.4) !important;
    font-weight: 400 !important;
    font-size: 12px !important;
    text-decoration: line-through !important;
    margin-left: 6px !important;
  }
  .cart-items__price-unit {
    color: rgba(255, 255, 255, 0.5) !important;
    font-size: 12px !important;
  }

  /* Cart-page H1 + count chip (rendered by _cart-title block above) */
  .cart-title,
  .cart-page__title h1 {
    color: #ffffff !important;
    font-weight: 700 !important;
  }
  .cart-title__count {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: 28px !important;
    height: 28px !important;
    padding: 0 8px !important;
    margin-left: 10px !important;
    border-radius: 999px !important;
    background: rgba(240, 132, 24, 0.15) !important;
    color: #f08418 !important;
    font-size: 13px !important;
    font-weight: 600 !important;
  }

  @media (max-width: 749px) {
    /* Align the cart-items area's horizontal edge with the free-shipping
       bar below. .cart-page__items adds its own padding-inline on top of
       the section wrapper, so cards ended up inset from the section edge.
       Zero out the inner paddings and let the cards sit flush with the
       same edge the free-shipping bar uses. */
    .cart-page__items,
    .cart-page__title,
    .cart-page__more-blocks {
      padding-inline: 0 !important;
    }
    .cart-products-header {
      padding: 0 !important;
    }

    /* Outer card chrome off — each row is its own padded block */
    .cart-items {
      padding: 0 !important;
      background: transparent !important;
      border: 0 !important;
    }
    /* Remove white divider line between items */
    .cart-items--dividers .cart-items__table-row {
      border-bottom: 0 !important;
      margin-bottom: 10px !important;
      padding-block: 0 !important;
    }

    /*
      Override the snippet's default grid-template-areas. Default mobile
      layout is 3 columns (media|details|price + qty row). We collapse to
      2 columns + 2 rows so qty + price share the right cell visually.
        +--------+----------------+
        |        | title (ellipsis)|
        | image  | variant         |
        |        | price · [- 1 +] |
        +--------+----------------+
    */
    .cart-items__table-row {
      display: grid !important;
      grid-template-columns: 24px 31% minmax(0, 1fr) !important;
      grid-template-rows: auto auto !important;
      grid-template-areas:
        'selection media details'
        'selection media quantity' !important;
      column-gap: 8px !important;
      row-gap: 6px !important;
      align-items: start !important;
      position: relative !important;
      padding: 12px !important;
      background: rgba(255, 255, 255, 0.025) !important;
      border: 1px solid rgba(255, 255, 255, 0.07) !important;
      border-radius: 12px !important;
    }
    .cart-items__selection {
      grid-area: selection !important;
      align-self: start !important;
      justify-self: start !important;
      padding-top: 2px !important;
    }
    /* Image cell — square thumbnail, spans both rows */
    .cart-items__media {
      grid-area: media !important;
      grid-row: 1 / 3 !important;
      padding: 0 !important;
    }
    .cart-items__media-container {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      aspect-ratio: 1 / 1 !important;
      --ratio: 1 !important;
      border-radius: 10px !important;
      overflow: hidden !important;
    }
    /* Use intrinsic max sizing instead of width/height:100% so the image's
       own aspect ratio is preserved and `object-fit: contain` actually has
       a working box (height:100% inside an aspect-ratio container can
       collapse to 0 if the flex parent doesn't pass an explicit height). */
    .cart-items__media-image {
      max-width: 100% !important;
      max-height: 100% !important;
      width: auto !important;
      height: auto !important;
      object-fit: contain !important;
    }
    /* Details cell — title / variant / inline price stacked */
    .cart-items__details {
      grid-area: details !important;
      min-width: 0 !important;
      padding-right: 0 !important;
      padding-bottom: 0 !important;
      color: rgba(255, 255, 255, 0.95) !important;
    }
    .cart-items__details > p:first-child {
      margin: 0 !important;
    }
    .cart-items__title,
    .cart-items__title a {
      display: block !important;
      font-size: 14px !important;
      font-weight: 600 !important;
      line-height: 1.35 !important;
      color: rgba(255, 255, 255, 0.95) !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
      max-width: 100% !important;
    }
    .cart-items__variants,
    .cart-items__variant,
    .cart-items__bundle {
      font-size: 12px !important;
      margin-top: 4px !important;
      color: rgba(255, 255, 255, 0.55) !important;
    }
    /* Price block = last <div> inside details. Orange bold. */
    .cart-items__details > div:last-child {
      margin-top: 6px !important;
      font-size: 15px !important;
      font-weight: 700 !important;
      color: #f08418 !important;
      display: flex !important;
      align-items: baseline !important;
      gap: 6px !important;
    }
    .cart-items__details > div:last-child .compare-at-price {
      color: rgba(255, 255, 255, 0.4) !important;
      font-weight: 400 !important;
      font-size: 12px !important;
    }
    /* Hide the redundant line-item total column on the right */
    .cart-items__price {
      display: none !important;
    }
    /* Quantity stepper: row below the price, in the details column.
       Borderless wrapper per request; small 24×24 +/- buttons. */
    .cart-items__quantity {
      grid-area: quantity !important;
      position: static !important;
      display: flex !important;
      align-items: center !important;
      gap: 4px !important;
      background: transparent !important;
      border: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
      justify-self: start !important;
    }
    /* Inner quantity-selector-component (custom element) */
    .cart-items__quantity .quantity-selector {
      display: inline-flex !important;
      align-items: center !important;
      background: transparent !important;
      border: 0 !important;
      padding: 0 !important;
      gap: 2px !important;
      height: auto !important;
      box-shadow: none !important;
    }
    /* +/- buttons (real class names: quantity-minus, quantity-plus) */
    .cart-items__quantity .quantity-minus,
    .cart-items__quantity .quantity-plus {
      width: 24px !important;
      height: 24px !important;
      min-width: 24px !important;
      min-height: 24px !important;
      padding: 0 !important;
      background: transparent !important;
      border: 1px solid rgba(255, 255, 255, 0.2) !important;
      border-radius: 6px !important;
      color: rgba(255, 255, 255, 0.85) !important;
      box-shadow: none !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
    }
    .cart-items__quantity .quantity-minus .svg-wrapper,
    .cart-items__quantity .quantity-plus .svg-wrapper {
      width: 12px !important;
      height: 12px !important;
    }
    .cart-items__quantity .quantity-minus svg,
    .cart-items__quantity .quantity-plus svg {
      width: 12px !important;
      height: 12px !important;
    }
    /* Quantity numeric input */
    .cart-items__quantity .quantity-selector input[type="number"],
    .cart-items__quantity input[type="number"] {
      width: 24px !important;
      min-width: 24px !important;
      height: 24px !important;
      padding: 0 !important;
      font-size: 13px !important;
      color: #fff !important;
      background: transparent !important;
      border: 0 !important;
      text-align: center !important;
      -moz-appearance: textfield !important;
    }
    .cart-items__quantity input[type="number"]::-webkit-outer-spin-button,
    .cart-items__quantity input[type="number"]::-webkit-inner-spin-button {
      -webkit-appearance: none !important; margin: 0 !important;
    }
    /* Remove button (trash icon) — small */
    .cart-items__remove {
      width: 24px !important;
      height: 24px !important;
      min-width: 24px !important;
      min-height: 24px !important;
      padding: 0 !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      color: rgba(255, 255, 255, 0.5) !important;
    }
    .cart-items__remove svg,
    .cart-items__remove .svg-wrapper {
      width: 14px !important;
      height: 14px !important;
    }
    /* Error row spans full width below the card */
    .cart-items__error {
      grid-column: 1 / -1 !important;
      margin-top: 6px !important;
    }
  }

  /* =========================================================
     Free-gift (GWP) line-item styling. The class is emitted in
     Liquid and reinforced by JS for APGO gifts and discounted
     zero-price gift lines.
     ========================================================= */
  .apgo-cart-item--gift .apgo-cart-gift-badge {
    display: none !important;
  }
  .apgo-cart-item--gift .apgo-cart-gift-sub {
    display: block !important;
    font-size: 11px !important;
    color: rgba(255, 255, 255, 0.55) !important;
    margin-top: 2px !important;
    font-weight: 500 !important;
  }
  /* Lock quantity stepper buttons + input on gift rows */
  .apgo-cart-item--gift .cart-items__quantity .quantity-minus,
  .apgo-cart-item--gift .cart-items__quantity .quantity-plus,
  .apgo-cart-item--gift .cart-items__quantity .quantity-selector__button {
    opacity: 0.4 !important;
    pointer-events: none !important;
    cursor: not-allowed !important;
  }
  .apgo-cart-item--gift .cart-items__quantity input[type="number"] {
    pointer-events: none !important;
    color: rgba(255, 255, 255, 0.55) !important;
  }
  /* Gift is mandatory — hide the remove/trash button so it can't be deleted */
  .apgo-cart-item--gift .cart-items__remove,
  .apgo-cart-item--gift button[on\:click^="/onLineItemRemove"] {
    display: none !important;
  }
  /* Price column → show "FREE" in green-ish accent (desktop) */
  .apgo-cart-item--gift .cart-items__price {
    color: #34d399 !important;
    font-weight: 700 !important;
  }
  .apgo-cart-item--gift .cart-items__price .compare-at-price {
    display: none !important;
  }
  .apgo-cart-item--gift .cart-items__details .compare-at-price {
    display: none !important;
  }
  /* Mobile (≤749px): inline price lives inside .cart-items__details > div:last-child
     because the right-hand .cart-items__price column is hidden. Mirror the green accent. */
  @media (max-width: 749px) {
    .apgo-cart-item--gift .cart-items__details > div:last-child,
    .apgo-cart-item--gift .cart-items__details > div:last-child span,
    .apgo-cart-item--gift .cart-items__details > div:last-child text-component {
      color: #34d399 !important;
      -webkit-text-fill-color: #34d399 !important;
    }
  }
</style>

<!-- Cart product heading and bulk actions -->
<div class="cart-products-header">
  <h3 class="cart-products-title">{{ block.settings.header_title | default: 'Cart Item' }}</h3>
  {% unless cart.empty? %}
    <div class="cart-products-actions" aria-label="Cart item actions">
      {% if block.settings.show_bulk_actions %}
        <button
          type="button"
          class="cart-products-action"
          data-cart-bulk-action="remove-selected"
          disabled
        >
          {{ block.settings.remove_selected_text | default: 'Remove selected' }}
          <span data-cart-selected-count hidden></span>
        </button>
        <button
          type="button"
          class="cart-products-action cart-products-action--danger"
          data-cart-bulk-action="clear"
          disabled
        >
          {{ block.settings.clear_cart_text | default: 'Clear cart' }}
        </button>
      {% endif %}
      {% if block.settings.show_action_button and block.settings.action_url != blank %}
        <a href="{{ block.settings.action_url }}" class="cart-products-action">
          {{ block.settings.action_text | default: 'Continue shopping' }}
          <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z"/>
          </svg>
        </a>
      {% endif %}
    </div>
    <p class="cart-products-status" data-cart-bulk-status role="status" aria-live="polite"></p>
  {% endunless %}
</div>

<!-- 原始購物車商品內容 -->
{% render 'cart-products' %}

{%- comment -%}
  Free-gift line-item decorator. Reads /cart.js and reinforces the
  locked state for APGO gifts and discount-based zero-price gifts:
    .apgo-cart-item--gift class on the table row
    🎁 FREE GIFT badge inside the details cell
    "Free with <X title>" sub-label (if _gift_from_product is present)
    Disabled selection, quantity and remove controls
  Reruns on every cart-update event so AJAX-driven changes pick up.
{%- endcomment -%}
<script>
(function () {
  'use strict';

  /*
    "Gift" is now a broader concept than just APGO's _free_gift lines:
      A. APGO reconciler / PDP GWP  → item.properties._free_gift === 'true'
      B. AIOD or any Shopify discount-based free-gift app → final_price=0
         with at least one line_level_discount_allocations entry
    Both should get the lockdown class + 🎁 badge on the cart row.
    Class + data-apgo-gift-line are ALSO emitted server-side by
    snippets/cart-products.liquid (no first-paint flicker); this JS
    layer re-applies after cart events fire on the current DOM (in
    case a section morph or drawer render drops the server class).
    The gift-from-product sub-label stays keyed on _gift_from_product
    since AIOD lines don't carry that.
  */
  function decorateGifts() {
    fetch('/cart.js?_=' + Date.now(), { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        function isGiftLine(item) {
          if (item.properties && item.properties._free_gift === 'true') return true;
          if (Number(item.final_price) === 0 &&
              Array.isArray(item.line_level_discount_allocations) &&
              item.line_level_discount_allocations.length > 0) return true;
          return false;
        }

        document.querySelectorAll('.cart-items__table-row').forEach(function (row) {
          /* Find which variant this row represents. The remove button has
             on:click="/onLineItemRemove/<index>" and rows carry the variant
             in their image href / title link. Easiest: read the qty input's
             data-cart-line attribute and look up cart.items[index-1]. */
          var qtyInput = row.querySelector('.cart-items__quantity input[type="number"]');
          var lineIdx = qtyInput ? parseInt(qtyInput.getAttribute('data-cart-line'), 10) : NaN;
          if (isNaN(lineIdx)) return;
          var item = cart.items[lineIdx - 1];
          if (!item) return;

          var isGift = isGiftLine(item);
          row.classList.toggle('apgo-cart-item--gift', isGift);
          /* Mirror the server-side data attribute so the JS entry-point
             guards in component-cart-items.js keep working even if this
             layer had to re-decorate a row that lost its attribute. */
          if (isGift) row.setAttribute('data-apgo-gift-line', '');
          else row.removeAttribute('data-apgo-gift-line');

          var selectCheckbox = row.querySelector('[data-cart-item-select]');
          if (selectCheckbox) {
            selectCheckbox.disabled = isGift;
            selectCheckbox.setAttribute('aria-disabled', isGift ? 'true' : 'false');
            if (isGift) {
              selectCheckbox.checked = false;
              selectCheckbox.setAttribute('title', 'Free gifts are adjusted automatically');
              selectCheckbox.setAttribute('aria-label', 'Free gift cannot be removed separately');
            } else {
              selectCheckbox.removeAttribute('title');
            }
            selectCheckbox.dispatchEvent(new Event('change', { bubbles: true }));
          }

          if (isGift) {
            var details = row.querySelector('.cart-items__details');
            if (details && !details.querySelector('.apgo-cart-gift-badge')) {
              var badge = document.createElement('span');
              badge.className = 'apgo-cart-gift-badge';
              badge.textContent = '🎁 Free gift';
              /* Insert badge right after the title <p> */
              var titleP = details.querySelector('p');
              if (titleP) titleP.insertAdjacentElement('afterend', badge);
              else details.prepend(badge);
            }
            /* Sub-label only fires for APGO gifts (they carry the
               _gift_from_product property). AIOD lines just show the
               plain 🎁 badge — AIOD doesn't tell us which trigger
               product the shampoo came from. */
            if (details && !details.querySelector('.apgo-cart-gift-sub') &&
                item.properties && item.properties._gift_from_product) {
              var sub = document.createElement('span');
              sub.className = 'apgo-cart-gift-sub';
              sub.textContent = 'Free with ' + item.properties._gift_from_product;
              var existingBadge = details.querySelector('.apgo-cart-gift-badge');
              if (existingBadge) existingBadge.insertAdjacentElement('afterend', sub);
              else details.appendChild(sub);
            }
            /* Gift is mandatory: the remove button is hidden via CSS and we
               deliberately do NOT bind any "dismiss" handler, so the gift can
               never be turned off by the customer. When the triggering X is
               removed entirely, pruneStaleGifts() still drops the orphan Y. */
          }
        });
      })
      .catch(function () {});
  }

  /*
    Standalone reconciler — when the cart page loads and X has been
    removed (e.g. between sessions, or via quantity → 0 from the cart
    page), the stale Y gift needs to disappear. We have no access to
    APGO_GIFT_MAP here (it lives on the PDP), so we walk all gift
    lines and drop the ones whose `_gift_for` X variant id is no
    longer present in the cart.
  */
  function pruneStaleGifts() {
    return fetch('/cart.js?_=' + Date.now(), { cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var presentXIds = new Set((cart.items || []).map(function (i) { return String(i.variant_id); }));
        var ops = [];
        (cart.items || []).forEach(function (i) {
          if (!i.properties || i.properties._free_gift !== 'true') return;
          var xId = i.properties._gift_for;
          if (!xId || presentXIds.has(String(xId))) return;
          var fd = new FormData();
          fd.append('id', i.key);
          fd.append('quantity', '0');
          ops.push(fetch('/cart/change.js', { method: 'POST', headers: { Accept: 'application/json' }, body: fd }).catch(function () {}));
        });
        if (ops.length) {
          return Promise.all(ops).then(function () {
            /* Reload cart page so the rendered items reflect the prune */
            window.location.reload();
          });
        }
      })
      .catch(function () {});
  }

  /*
    Stop Enter in qty inputs from submitting the cart form.

    The qty stepper lives inside <form id="cart-form"> whose submit button
    is "Checkout". A keyboard user typing a new qty + Enter triggers the
    native form submit → instant redirect to checkout, bypassing the
    customer's intended qty edit. Intercept Enter on qty inputs and
    blur the field instead — that fires the existing on:blur handler
    which actually updates the qty via /cart/change.js.
  */
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter' && e.keyCode !== 13) return;
    var t = e.target;
    if (!t) return;
    var isQty = t.matches && (
      t.matches('.cart-items__quantity input[type="number"]') ||
      t.matches('quantity-selector-component input[type="number"]') ||
      (t.tagName === 'INPUT' && t.type === 'number' && t.closest && t.closest('.cart-items__quantity'))
    );
    if (!isQty) return;
    e.preventDefault();
    /* Blur triggers Shopify's on:blur="/setQuantity" handler which does
       the actual cart update — same behaviour as clicking out of the field. */
    t.blur();
  }, true);

  /* Run on page load + whenever the cart updates */
  document.addEventListener('DOMContentLoaded', function () {
    pruneStaleGifts();
    decorateGifts();
    installCartMutationObserver();
  });
  /* event-driven retries — useful when no DOM mutation happens but cart
     properties changed (e.g. _gift_for set after add) */
  document.addEventListener('cart:update', function () { setTimeout(decorateGifts, 50); });
  document.addEventListener('cart:updated', function () { setTimeout(decorateGifts, 50); });
  document.addEventListener('cart:refresh', function () { setTimeout(decorateGifts, 50); });
  /* In case cart-update happens before this script runs */
  if (document.readyState !== 'loading') {
    decorateGifts();
    installCartMutationObserver();
  }

  /*
    Shopify Horizon's cart-items component re-renders the entire <table>
    HTML on every quantity change (server-rendered section refresh).
    That blows away the FREE GIFT badge / locked-qty styling we added.
    A 50ms setTimeout after cart:update used to race the re-render and
    lose half the time.

    MutationObserver watches the cart-items wrapper for any descendant
    change. We debounce 80ms after the last mutation (Shopify swaps a
    bunch of nodes at once → batched) and re-decorate. This catches
    EVERY re-render reliably, regardless of event timing.
  */
  var cartMutationObserver = null;
  function installCartMutationObserver() {
    if (cartMutationObserver) return; /* already installed */
    var target = document.querySelector('.cart-items__wrapper, .cart-items, cart-items-component, .cart-form');
    if (!target) return;
    var pending = null;
    cartMutationObserver = new MutationObserver(function () {
      if (pending) clearTimeout(pending);
      pending = setTimeout(function () {
        pending = null;
        decorateGifts();
      }, 80);
    });
    cartMutationObserver.observe(target, { childList: true, subtree: true });
  }
})();
</script>

