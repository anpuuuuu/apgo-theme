{% doc %}
  @prompt
    帮我做一个次级菜单，需要sticky再跑马灯下面，另外帮我填上每一个选项（limitedtimedeals...）
{% enddoc %}
{% liquid
  assign show_apgo_secondary_nav = false
  if request.design_mode or request.visual_preview_mode
    assign show_apgo_secondary_nav = true
  elsif request.page_type == 'collection' and collection != blank and collection.handle == 'all'
    assign show_apgo_secondary_nav = true
  endif
%}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% if show_apgo_secondary_nav %}
{% style %}
  /*
    次選單本體 sticky：與主 header 同一套 --header-height，黑底畫在吸頂層上，避免外層透明 section 先 sticky 造成透缝／只像字在動。
  */
  .ai-secondary-menu-{{ ai_gen_id }} {
    position: sticky;
    top: max(0px, calc(var(--header-height, 60px) - 1px));
    z-index: calc(var(--layer-sticky, 8) - 1);
    width: 100%;
    max-width: none;
    display: block;
    box-sizing: border-box;
    background-color: {{ block.settings.background_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.2);
  }

  .ai-secondary-menu__container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .ai-secondary-menu__container-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-secondary-menu__list-{{ ai_gen_id }} {
    display: flex;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    gap: {{ block.settings.item_spacing }}px;
    justify-content: {{ block.settings.alignment }};
    min-width: max-content;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
  }

  .ai-secondary-menu__item-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-secondary-menu__link-{{ ai_gen_id }} {
    position: relative;
    display: inline-block;
    padding: {{ block.settings.link_padding_vertical }}px {{ block.settings.link_padding_horizontal }}px;
    padding-bottom: calc({{ block.settings.link_padding_vertical }}px + 3px);
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    text-transform: {{ block.settings.text_transform }};
    white-space: nowrap;
    border-radius: {{ block.settings.link_border_radius }}px;
    background-color: transparent;
    transition: color 0.2s ease;
  }

  .ai-secondary-menu__link-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 0;
    height: 1px;
    background-color: {{ block.settings.text_hover_color }};
    transition: width 0.22s ease;
    pointer-events: none;
  }

  .ai-secondary-menu__link-{{ ai_gen_id }}:hover,
  .ai-secondary-menu__link-{{ ai_gen_id }}:focus-visible {
    color: {{ block.settings.text_hover_color }};
    background-color: transparent;
  }

  .ai-secondary-menu__link-{{ ai_gen_id }}:hover::after,
  .ai-secondary-menu__link-{{ ai_gen_id }}:focus-visible::after {
    width: 100%;
  }

  /* 與 collection-all-hub scrollspy 同步（同 #collection- 錨點） */
  .ai-secondary-menu__link-{{ ai_gen_id }}.apgo-catalog-hub-link--active {
    color: {{ block.settings.text_hover_color }} !important;
    background-color: transparent;
  }

  .ai-secondary-menu__link-{{ ai_gen_id }}.apgo-catalog-hub-link--active::after {
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-secondary-menu__link-{{ ai_gen_id }},
    .ai-secondary-menu__link-{{ ai_gen_id }}::after {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-secondary-menu__container-{{ ai_gen_id }} {
      justify-content: flex-start;
    }

    .ai-secondary-menu__list-{{ ai_gen_id }} {
      justify-content: flex-start;
      margin-inline: 0;
      margin-left: 0;
      margin-right: 0;
    }
  }
{% endstyle %}

<secondary-menu-{{ ai_gen_id }} class="ai-secondary-menu-{{ ai_gen_id }}" data-apgo-hub-nav {{ block.shopify_attributes }}>
  <div class="ai-secondary-menu__container-{{ ai_gen_id }}" data-apgo-hub-nav-scroll>
    <ul class="ai-secondary-menu__list-{{ ai_gen_id }}">
      {% for i in (1..10) %}
        {% liquid
          assign link_key = 'link_' | append: i
          assign label_key = 'label_' | append: i
          assign link_url = block.settings[link_key]
          assign link_label = block.settings[label_key]
        %}
        
        {% if link_label != blank %}
          <li class="ai-secondary-menu__item-{{ ai_gen_id }}">
            <a
              href="{% if link_url != blank %}{{ link_url }}{% else %}#{% endif %}"
              class="ai-secondary-menu__link-{{ ai_gen_id }}{% if link_url contains '#collection-' %} apgo-catalog-hub-link{% endif %}"
            >
              {{ link_label }}
            </a>
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</secondary-menu-{{ ai_gen_id }}>

<script>
  (function() {
    class SecondaryMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.container = this.querySelector('.ai-secondary-menu__container-{{ ai_gen_id }}');
        this.setupScrollBehavior();
      }

      setupScrollBehavior() {
        if (!this.container) return;

        let isDown = false;
        let startX;
        let scrollLeft;

        this.container.addEventListener('mousedown', (e) => {
          isDown = true;
          this.container.style.cursor = 'grabbing';
          startX = e.pageX - this.container.offsetLeft;
          scrollLeft = this.container.scrollLeft;
        });

        this.container.addEventListener('mouseleave', () => {
          isDown = false;
          this.container.style.cursor = 'grab';
        });

        this.container.addEventListener('mouseup', () => {
          isDown = false;
          this.container.style.cursor = 'grab';
        });

        this.container.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          e.preventDefault();
          const x = e.pageX - this.container.offsetLeft;
          const walk = (x - startX) * 2;
          this.container.scrollLeft = scrollLeft - walk;
        });
      }
    }

    customElements.define('secondary-menu-{{ ai_gen_id }}', SecondaryMenu{{ ai_gen_id }});
  })();
</script>
{% endif %}

