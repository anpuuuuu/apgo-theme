{%- doc -%}
  Collection-style product card for Special Event page sections.
  Matches Limited Time Deals listing UI (+ drawer, discount badge) without Theme Editor product-card blocks.

  @param {object} product    - Product object
  @param {string} card_uid   - Unique id suffix for this card
  @param {string}  variant_id        - Optional. Editor-picked variant ID
                                       (from the block setting). If set +
                                       matches a real variant on this product,
                                       overrides the default variant-
                                       resolution logic so the card links /
                                       prices that variant.
  @param {boolean} hide_compare_at    - Optional. When true, never render
                                       the strikethrough compare-at price.
                                       Used by the B1F1 scroll zone where
                                       showing an original price under a
                                       'Buy 1 Free 1' framing is confusing.
  @param {number} card_position       - One-based position within the zone.
  @param {boolean} [crate]            - Clearance page card: a red stamp on
                                       the photo (SOLD OUT, LAST BATCH or
                                       the % off) instead of the theme
                                       badges, an "Only N left" line from
                                       real stock (20 or fewer) and an
                                       icon-only Add to cart button.
{%- enddoc -%}

{% liquid
  assign apgo_listing_variant = product.selected_or_first_available_variant

  assign apgo_block_vid = variant_id | default: '' | strip | plus: 0
  assign apgo_resolved_from_block = false
  if apgo_block_vid != 0
    for v in product.variants
      if v.id == apgo_block_vid
        assign apgo_listing_variant = v
        assign apgo_resolved_from_block = true
        break
      endif
    endfor
  endif

  unless apgo_resolved_from_block
    capture apgo_lv_id_raw
      render 'apgo-collection-listing-variant-id', product: product
    endcapture
    assign apgo_lv_id = apgo_lv_id_raw | strip | plus: 0
    if apgo_lv_id != 0
      for v in product.variants
        if v.id == apgo_lv_id
          assign apgo_listing_variant = v
          break
        endif
      endfor
    endif
  endunless

  # Photo and link (2026-10, the homepage cards' rule from 37accb7): the
  # product's first image and its plain product URL, not the default
  # variant's (a laundry card showed the Rose pack). Only a variant picked in
  # the block's "Variant IDs" setting keeps its own photo and ?variant= link,
  # since the card then sells that variant. Price and the cart buttons still
  # use apgo_listing_variant either way.
  assign apgo_card_image = blank
  assign apgo_card_url = product.url
  if apgo_resolved_from_block
    assign apgo_card_image = apgo_listing_variant.featured_image
    assign apgo_card_url = apgo_listing_variant.url
  endif
  if apgo_card_image == blank and product.featured_media != blank
    assign apgo_card_image = product.featured_media.preview_image
  endif
  if apgo_card_image == blank
    assign apgo_card_image = apgo_listing_variant.featured_image
  endif

  assign apgo_card_link_id = 'apgo-event-card-' | append: card_uid | append: '-' | append: product.id

  assign apgo_card_sold_out = false
  unless apgo_listing_variant.available
    assign apgo_card_sold_out = true
  endunless
  if apgo_listing_variant.inventory_management != blank and apgo_listing_variant.inventory_quantity <= 0
    assign apgo_card_sold_out = true
  endif

  assign apgo_crate_qty = 0
  assign apgo_crate_stamp = blank
  if crate
    if apgo_listing_variant.inventory_management != blank
      assign apgo_crate_qty = apgo_listing_variant.inventory_quantity | default: 0
    endif
    if apgo_card_sold_out
      assign apgo_crate_stamp = 'Sold out'
    elsif apgo_crate_qty > 0 and apgo_crate_qty <= 5
      assign apgo_crate_stamp = 'Last batch'
    elsif hide_compare_at != true and apgo_listing_variant.compare_at_price > apgo_listing_variant.price
      assign apgo_crate_off = apgo_listing_variant.compare_at_price | minus: apgo_listing_variant.price | times: 100 | divided_by: apgo_listing_variant.compare_at_price
      if apgo_crate_off >= 5
        assign apgo_crate_stamp = apgo_crate_off | append: '% off'
      endif
    endif
  endif
%}

<product-card
  class="product-card apgo-event-listing-card"
  data-product-id="{{ product.id }}"
  data-product-name="{{ product.title | escape }}"
  data-product-handle="{{ product.handle | escape }}"
  data-variant-id="{{ apgo_listing_variant.id }}"
  data-card-position="{{ card_position }}"
  data-product-variants-size="{{ product.variants.size }}"
  id="product-card-{{ card_uid }}"
>
  <a
    id="{{ apgo_card_link_id | md5 }}"
    href="{{ apgo_card_url }}"
    class="product-card__link"
    ref="productCardLink"
  >
    <span class="visually-hidden">{{ product.title }}</span>
  </a>
  {%- comment -%}
    Color scheme class intentionally removed — the special-event page
    paints card chrome via CSS (deep-brown gradient + gold title) so we
    don't want the theme's color scheme palette overriding it here.
  {%- endcomment -%}
  <div
    class="
      product-card__content
      layout-panel-flex
      layout-panel-flex--column
      product-grid__card
      spacing-style
      border-style
      gap-style
    "
    style="
      --border-width: 0px;
      --border-style: none;
      --border-opacity: 0%;
      --border-radius: 12px;
      --quick-add-display: none;
      --quick-add-mobile-display: none;
    "
  >
    <div class="card-gallery card-gallery--square apgo-event-listing-card__gallery">
      <a href="{{ apgo_card_url }}" class="card-gallery__link">
        {% if apgo_card_image != blank %}
          <img
            src="{{ apgo_card_image | image_url: width: 600 }}"
            alt="{{ product.title | escape }}"
            loading="lazy"
            width="600"
            height="600"
            class="product-media__image"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder-image' }}
        {% endif %}
      </a>
      {%- if crate -%}
        {%- if apgo_crate_stamp != blank -%}
          <span class="apgo-crate-stamp">{{ apgo_crate_stamp }}</span>
        {%- endif -%}
      {%- else -%}
        {% render 'product-card-badges', product: product %}
      {%- endif -%}
    </div>

    <div class="apgo-event-listing-card__body group-block">
      <h3 class="h5 apgo-event-listing-card__title">
        <a href="{{ apgo_card_url }}">{{ product.title }}</a>
      </h3>
      {%- comment -%}
        Footer layout:
          ┌─────────────────────────────────────────┐
          │ RM388.00  (compare-at, strikethrough)   │
          │ RM179.00  (current price)               │
          │ [ Add to cart ]  [ Buy now ]            │
          └─────────────────────────────────────────┘
        Buttons are UI-only stubs for now; cart / checkout wiring
        gets bolted on in a follow-up.
      {%- endcomment -%}
      {%- comment -%}
        Price stack:
          1. compare-at (faded strikethrough) — shown when on sale,
             EXCEPT when the parent scroll zone passes
             hide_compare_at=true (currently: B1F1 zone, where the
             original price would only confuse the 'buy one free one'
             framing)
          2. current price — integer + smaller ".00" + gold gradient + glow
      {%- endcomment -%}
      {%- assign apgo_card_price_cents = apgo_listing_variant.price -%}
      {%- assign apgo_card_compare_cents = apgo_listing_variant.compare_at_price -%}
      {%- assign apgo_card_price_str = apgo_card_price_cents | money | replace: ' MYR', '' | replace: 'MYR', '' -%}
      {%- assign apgo_card_price_parts = apgo_card_price_str | split: '.' -%}
      {%- assign apgo_card_on_sale = false -%}
      {%- if apgo_card_compare_cents > apgo_card_price_cents and hide_compare_at != true -%}
        {%- assign apgo_card_on_sale = true -%}
      {%- endif -%}
      <div class="apgo-event-listing-card__footer">
        <div class="apgo-event-listing-card__price-stack">
          {%- if apgo_card_on_sale -%}
            <span class="apgo-event-listing-card__price-compare">
              {{ apgo_card_compare_cents | money | replace: ' MYR', '' | replace: 'MYR', '' }}
            </span>
          {%- endif -%}
          <span class="apgo-event-listing-card__price-current">
            <span class="apgo-event-listing-card__price-int">{{ apgo_card_price_parts[0] }}</span>{%- if apgo_card_price_parts[1] -%}<span class="apgo-event-listing-card__price-frac">.{{ apgo_card_price_parts[1] }}</span>{%- endif -%}
          </span>
        </div>
        {%- if crate and apgo_card_sold_out == false and apgo_crate_qty > 0 and apgo_crate_qty <= 20 -%}
          <p class="apgo-crate-stock{% if apgo_crate_qty <= 5 %} apgo-crate-stock--low{% endif %}">Only {{ apgo_crate_qty }} left</p>
        {%- endif -%}
        {%- unless apgo_card_sold_out -%}
          <div class="apgo-event-listing-card__actions">
            <button
              type="button"
              class="apgo-event-listing-card__btn apgo-event-listing-card__btn--add"
              data-variant-id="{{ apgo_listing_variant.id }}"
              aria-label="Add {{ product.title | escape }} to cart">
              {%- if crate -%}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 8h12l-1 12H7z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>
              {%- else -%}
                Add to cart
              {%- endif -%}
            </button>
            <button
              type="button"
              class="apgo-event-listing-card__btn apgo-event-listing-card__btn--buy"
              data-variant-id="{{ apgo_listing_variant.id }}"
              aria-label="Buy {{ product.title | escape }} now">
              Buy now
            </button>
          </div>
        {%- else -%}
          <div class="apgo-event-listing-card__actions">
            <button
              type="button"
              class="apgo-event-listing-card__btn apgo-event-listing-card__btn--sold-out"
              disabled
              aria-disabled="true">
              {{ 'products.product.sold_out' | t }}
            </button>
          </div>
        {%- endunless -%}
      </div>
    </div>
  </div>
</product-card>
