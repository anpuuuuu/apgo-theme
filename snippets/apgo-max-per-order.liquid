{%- doc -%}
  Prints the most a shopper may put in one order of each option (variant)
  of a product, or 0 for no limit. Single source for:
    - the v3 product page: snippets/apgo-cc-mobile-buybar.liquid hands it to
      assets/apgo-cc-pdp-picker.js, which checks the cart before adding;
    - the cart page: snippets/cart-products.liquid caps the quantity box.
    - event listing cards: assets/apgo-event-cart.js checks before adding.
  A per-order limit in the theme only: a shopper can still place another
  order, and the cart API itself is not blocked.

  No product is named here (2026-11-23): everything comes from the admin.
    - Product tag apgo-max-per-order-N: every option of the product, N each.
    - Theme settings → APGO — Order limits → "Limits for single options":
      "variant_id:limit" pairs, one option's own limit that beats the tag
      (e.g. a RM1 option limited to 1 inside a deal otherwise limited to 3).

  @param {product} product - The product.
  @param {variant} [variant] - One option of it, for an option's own limit.
{%- enddoc -%}
{%- liquid
  assign apgo_limit = 0
  for apgo_tag in product.tags
    if apgo_tag contains 'apgo-max-per-order-'
      assign apgo_limit = apgo_tag | remove: 'apgo-max-per-order-' | plus: 0
    endif
  endfor
  if variant != blank and settings.apgo_variant_order_limits != blank
    assign apgo_vid = variant.id | append: ''
    assign apgo_pairs = settings.apgo_variant_order_limits | newline_to_br | replace: '<br />', ',' | replace: ' ', '' | split: ','
    for apgo_pair in apgo_pairs
      assign apgo_parts = apgo_pair | strip | split: ':'
      if apgo_parts.size == 2 and apgo_parts[0] == apgo_vid
        assign apgo_limit = apgo_parts[1] | plus: 0
      endif
    endfor
  endif
  echo apgo_limit
-%}
