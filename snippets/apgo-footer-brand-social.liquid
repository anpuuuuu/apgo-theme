{% doc %}
  APGO Footer：品牌區＋社群（與 sections/APGO-footer.liquid 同源）。
  @param {object} s - APGO-footer 的 section
  @param {boolean} [compact] - 手機抽屜用較小 logo／可加 class 給外層 CSS
{% enddoc %}
{% liquid
  assign compact = compact | default: false
  assign lh = s.settings.logo_height | default: 50
  if compact
    assign lh = lh | times: 80 | divided_by: 100
    if lh < 34
      assign lh = 34
    endif
  endif
%}
{% if s.settings.show_brand_section %}
  <div class="apgo-footer-brand{% if compact %} apgo-footer-snippet--drawer{% endif %}">
    {% if s.settings.logo_image %}
      <a href="{{ s.settings.logo_link | default: '/' }}" class="apgo-footer-logo">
        <img
          src="{{ s.settings.logo_image | image_url: width: 200 }}"
          alt="{{ s.settings.logo_alt_text | default: shop.name }}"
          width="200"
          height="{{ lh }}"
          loading="lazy"
        >
      </a>
    {% endif %}

    {% if s.settings.show_tagline %}
      <p class="apgo-brand-tagline">{{ s.settings.brand_tagline }}</p>
    {% endif %}

    {% if s.settings.show_company_info %}
      <p style="font-size: 0.85rem; color: #999999; margin-top: 10px;">
        {{ s.settings.company_name -}}
        <br>
        {% if s.settings.show_tax_id %}
          RegistrationNo.：{{ s.settings.tax_id }}
        {% endif %}
      </p>
    {% endif %}

    {% if s.settings.show_social_media %}
      <div class="apgo-social-section">
        <p class="apgo-social-title">{{ s.settings.social_title }}</p>
        <div class="apgo-social-links">
          {% if s.settings.show_facebook and s.settings.facebook_url != blank %}
            <a href="{{ s.settings.facebook_url }}" class="apgo-social-link" title="Facebook">
              <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          {% endif %}

          {% if s.settings.show_instagram and s.settings.instagram_url != blank %}
            <a href="{{ s.settings.instagram_url }}" class="apgo-social-link" title="Instagram">
              <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zM5.838 12a6.162 6.162 0 1112.324 0 6.162 6.162 0 01-12.324 0zM12 16a4 4 0 110-8 4 4 0 010 8zm4.965-10.405a1.44 1.44 0 112.881.001 1.44 1.44 0 01-2.881-.001z"/>
              </svg>
            </a>
          {% endif %}

          {% if s.settings.show_youtube and s.settings.youtube_url != blank %}
            <a href="{{ s.settings.youtube_url }}" class="apgo-social-link" title="YouTube">
              <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          {% endif %}

          {% if s.settings.show_tiktok and s.settings.tiktok_url != blank %}
            <a href="{{ s.settings.tiktok_url }}" class="apgo-social-link" title="TikTok">
              <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
              </svg>
            </a>
          {% endif %}

          {% if s.settings.show_line and s.settings.line_url != blank %}
            <a href="{{ s.settings.line_url }}" class="apgo-social-link" title="LINE">
              <svg fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 10.304c0-5.369-5.383-9.738-12-9.738-6.616 0-12 4.369-12 9.738 0 4.814 4.269 8.846 10.036 9.608.391.084.922.258 1.057.592.121.303.079.778.039 1.085l-.171 1.027c-.053.303-.242 1.186 1.039.647 1.281-.54 6.911-4.069 9.428-6.967 1.739-1.907 2.572-3.843 2.572-5.992zm-18.988-2.595c.129 0 .234.105.234.234v4.153h2.287c.129 0 .233.105.233.234v.842c0 .129-.104.234-.233.234h-3.363c-.063 0-.119-.025-.161-.065l-.001-.001-.002-.002-.001-.001-.003-.003c-.04-.042-.065-.099-.065-.161v-5.231c0-.129.105-.234.234-.234h.841zm14.992 0c.129 0 .234.105.234.234v.842c0 .129-.105.234-.234.234h-2.287v.883h2.287c.129 0 .234.105.234.234v.842c0 .129-.105.234-.234.234h-2.287v.883h2.287c.129 0 .234.105.234.234v.842c0 .129-.105.234-.234.234h-3.363c-.063 0-.12-.025-.162-.065l-.003-.004-.003-.003c-.04-.042-.065-.099-.065-.161v-5.231c0-.063.025-.119.065-.161l.004-.004.003-.003c.042-.04.099-.065.162-.065h3.363zm-10.443.001c.129 0 .234.105.234.234v5.231c0 .129-.105.234-.234.234h-.842c-.129 0-.234-.105-.234-.234v-5.231c0-.129.105-.234.234-.234h.842zm2.127 0h.008l.012.001.013.001.013.001.013.002.013.003.012.003.007.002.005.001.006.002.013.004.012.004.012.005.012.005.011.005.011.006.011.006.011.007.005.003.006.003.01.007.01.007.01.008.009.008.008.007.008.008.008.009.008.008.008.009.007.009.007.01.007.009.006.01.006.01.005.011.005.01.005.011.004.011.004.011.003.012.003.011.003.013.002.012.002.007v.005l.001.013.001.012v.014l.001.041v3.539l2.146-3.433.001-.001.003-.006.004-.005.004-.006.005-.006.005-.005.005-.006.006-.005.006-.005.006-.005.007-.005.006-.005.007-.004.007-.004.008-.004.007-.004.008-.003.008-.004.008-.003.008-.002.009-.003.008-.002.009-.002.009-.001.009-.002h.009l.009-.001h.01l.009-.001h.053c.129 0 .234.105.234.234v5.231c0 .129-.105.234-.234.234h-.841c-.129 0-.234-.105-.234-.234v-3.539l-2.146 3.433-.001.002-.001.001-.003.005-.003.005-.003.004-.004.005-.004.005-.004.004-.004.005-.005.004-.005.004-.005.004-.005.004-.006.004-.005.003-.006.004-.006.003-.006.003-.007.003-.0