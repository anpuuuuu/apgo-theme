{%- liquid
  assign default_country_code = localization.country.iso_code
  assign default_province = ''
  assign default_city = ''
  assign default_zip = ''
  assign default_address1 = ''

  if customer and customer.default_address
    if customer.default_address.country_code != blank
      assign default_country_code = customer.default_address.country_code
    endif
    assign default_province = customer.default_address.province
    assign default_city = customer.default_address.city
    assign default_zip = customer.default_address.zip
    assign default_address1 = customer.default_address.address1
  endif
-%}

<div class="cart-shipping-estimator-host" data-cart-address-form>
  <div class="cart-shipping-estimator cart-shipping-estimator--enhanced">
    <p class="cart-shipping-estimator__title">{{ 'apgo_cart.shipping_estimate_title' | t }}</p>
    <div class="cart-shipping-estimator__grid">
      <label class="cart-shipping-estimator__field">
        <span>{{ 'apgo_cart.country' | t }}</span>
        <select data-estimator-country>
          {% for country in localization.available_countries %}
            {% if country.iso_code == 'MY' or country.iso_code == 'SG' %}
              <option
                value="{{ country.iso_code }}"
                {% if country.iso_code == default_country_code %}
                  selected
                {% endif %}
              >
                {{ country.name }}
              </option>
            {% endif %}
          {% endfor %}
          {% if default_country_code != 'MY' and default_country_code != 'SG' %}
            <option value="{{ default_country_code }}" selected>{{ default_country_code }}</option>
          {% endif %}
        </select>
      </label>
      <label class="cart-shipping-estimator__field">
        <span>{{ 'apgo_cart.province' | t }}</span>
        <input
          type="text"
          value="{{ default_province | escape }}"
          data-estimator-province
          autocomplete="address-level1"
        >
      </label>
      <label class="cart-shipping-estimator__field">
        <span>{{ 'apgo_cart.city' | t }}</span>
        <input
          type="text"
          value="{{ default_city | escape }}"
          data-estimator-city
          autocomplete="address-level2"
        >
      </label>
      <label class="cart-shipping-estimator__field">
        <span>{{ 'apgo_cart.zip' | t }}</span>
        <input
          type="text"
          value="{{ default_zip | escape }}"
          data-estimator-zip
          autocomplete="postal-code"
        >
      </label>
    </div>
    <label class="cart-shipping-estimator__field cart-shipping-estimator__field--full">
      <span>{{ 'apgo_cart.address1' | t }}</span>
      <input
        type="text"
        value="{{ default_address1 | escape }}"
        data-estimator-address1
        autocomplete="address-line1"
      >
    </label>
    <small class="cart-shipping-estimator__message" data-estimate-message>
      {{ 'apgo_cart.address_ready_for_checkout' | t }}
    </small>
  </div>
</div>

<script>
  (() => {
    if (window.__apgoCartAddressBound) return;
    window.__apgoCartAddressBound = true;

    const root = document.querySelector('[data-cart-address-form]');
    if (!root) return;

    const countryEl = root.querySelector('[data-estimator-country]');
    const provinceEl = root.querySelector('[data-estimator-province]');
    const cityEl = root.querySelector('[data-estimator-city]');
    const zipEl = root.querySelector('[data-estimator-zip]');
    const address1El = root.querySelector('[data-estimator-address1]');
    const messageEl = root.querySelector('[data-estimate-message]');

    const setMessage = (text) => {
      if (messageEl) messageEl.textContent = text || '';
    };

    const getAddress = () => ({
      country: (countryEl?.value || '').trim(),
      province: (provinceEl?.value || '').trim(),
      city: (cityEl?.value || '').trim(),
      zip: (zipEl?.value || '').trim(),
      address1: (address1El?.value || '').trim(),
    });

    const validateAddress = (addr) => {
      const required = ['country', 'province', 'city', 'zip', 'address1'];
      const firstMissingKey = required.find((key) => !addr[key]);
      return { valid: !firstMissingKey, firstMissingKey };
    };

    const focusMissingField = (key) => {
      const map = {
        country: countryEl,
        province: provinceEl,
        city: cityEl,
        zip: zipEl,
        address1: address1El,
      };
      map[key]?.focus();
    };

    const buildCheckoutQuery = (addr) => {
      const q = new URLSearchParams();
      q.set('checkout[shipping_address][country]', addr.country);
      q.set('checkout[shipping_address][province]', addr.province);
      q.set('checkout[shipping_address][city]', addr.city);
      q.set('checkout[shipping_address][zip]', addr.zip);
      q.set('checkout[shipping_address][address1]', addr.address1);
      return q.toString();
    };

    const saveAddressToCartAttributes = async (addr) => {
      try {
        await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            attributes: {
              estimated_shipping_country: addr.country,
              estimated_shipping_province: addr.province,
              estimated_shipping_city: addr.city,
              estimated_shipping_zip: addr.zip,
              estimated_shipping_address1: addr.address1,
            },
          }),
        });
      } catch (_) {}
    };

    window.apgoValidateCheckoutAddress = () => {
      const address = getAddress();
      const check = validateAddress(address);
      if (!check.valid) {
        setMessage(`{{ 'apgo_cart.address_required_error' | t | escape }}`);
        focusMissingField(check.firstMissingKey);
        return { valid: false, query: '' };
      }

      const query = buildCheckoutQuery(address);
      const nextUrl = `${window.location.pathname}?${query}${window.location.hash || ''}`;
      window.history.replaceState({}, '', nextUrl);
      saveAddressToCartAttributes(address);
      setMessage(`{{ 'apgo_cart.address_ready_for_checkout' | t | escape }}`);
      return { valid: true, query };
    };

    window.buildCheckoutParams = () => {
      const result = window.apgoValidateCheckoutAddress();
      return result.valid ? `?${result.query}` : (window.location.search || '');
    };

    const bindCheckoutGuard = (buttonId) => {
      const button = document.getElementById(buttonId);
      if (!button) return;

      button.addEventListener(
        'click',
        (event) => {
          if (button.disabled || button.getAttribute('aria-disabled') === 'true') return;
          const result = window.apgoValidateCheckoutAddress();
          if (!result.valid) {
            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();
            return;
          }
          event.preventDefault();
          const cartBase = (window.Shopify?.routes?.cart_url || '/cart').replace(/\/$/, '');
          window.location.assign(`${cartBase}/checkout?${result.query}`);
        },
        true
      );
    };

    ['input', 'change'].forEach((eventName) => {
      [countryEl, provinceEl, cityEl, zipEl, address1El].forEach((el) => {
        el?.addEventListener(eventName, () => setMessage(''), { passive: true });
      });
    });

    bindCheckoutGuard('checkout');
    bindCheckoutGuard('checkout-standalone');
  })();
</script>

