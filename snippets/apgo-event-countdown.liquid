{%- doc -%}
  APGO Event countdown chip — sits at the top of the Birthday Page
  panel header, above the festive heading lockup. Self-contained:
  inline styles + IIFE script so the snippet drops in anywhere
  without touching the global event stylesheet.

  Hides itself the moment the configured end time is in the past
  (both on first render and mid-tick). Designed for one instance per
  page but defensive against multiples — the JS scopes everything
  to its own root via [data-apgo-event-countdown].

  @param {string} end_iso - ISO 8601 datetime (e.g.
                            '2026-07-03T00:00:00+08:00'). REQUIRED.
                            Past values → countdown hides on load.
  @param {string} label   - Leading text (e.g. '🎉 BIRTHDAY SALE ENDS IN').
                            Optional; suppressed if blank.
{%- enddoc -%}

{%- if end_iso != blank -%}
  {%- comment -%}
    Octagonal cut-corner "ribbon" chip — outer wrapper carries the
    gold gradient + clip-path; inner wrapper carries the dark fill
    + same clip-path. The 1.5px padding gap between the two creates
    the visible gold rim. SVG hourglass replaces the emoji prefix.
  {%- endcomment -%}
  <div
    class="apgo-event-countdown"
    data-apgo-event-countdown
    data-end-iso="{{ end_iso | escape }}"
    aria-live="polite"
  >
    <div class="apgo-event-countdown__inner">
      <span class="apgo-event-countdown__icon" aria-hidden="true">
        <svg viewBox="0 0 16 20" width="14" height="17" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round">
          <line x1="2.5" y1="1.5" x2="13.5" y2="1.5"/>
          <line x1="2.5" y1="18.5" x2="13.5" y2="18.5"/>
          <path d="M 3 1.5 L 13 1.5 L 8 10 L 13 18.5 L 3 18.5 L 8 10 Z"/>
          <path d="M 4.4 3 L 11.6 3 L 8 9 Z" fill="currentColor" stroke="none"/>
          <path d="M 6.4 17 L 9.6 17 L 8.6 15 L 7.4 15 Z" fill="currentColor" stroke="none"/>
        </svg>
      </span>
      {%- if label != blank -%}
        <span class="apgo-event-countdown__label">{{ label }}</span>
      {%- endif -%}
      <div class="apgo-event-countdown__boxes" role="timer">
        <span class="apgo-event-countdown__box">
          <span class="apgo-event-countdown__digit" data-apgo-event-countdown-days>--</span>
          <span class="apgo-event-countdown__unit">d</span>
        </span>
        <span class="apgo-event-countdown__sep" aria-hidden="true">:</span>
        <span class="apgo-event-countdown__box">
          <span class="apgo-event-countdown__digit" data-apgo-event-countdown-hours>--</span>
          <span class="apgo-event-countdown__unit">h</span>
        </span>
        <span class="apgo-event-countdown__sep" aria-hidden="true">:</span>
        <span class="apgo-event-countdown__box">
          <span class="apgo-event-countdown__digit" data-apgo-event-countdown-minutes>--</span>
          <span class="apgo-event-countdown__unit">m</span>
        </span>
        <span class="apgo-event-countdown__sep" aria-hidden="true">:</span>
        <span class="apgo-event-countdown__box">
          <span class="apgo-event-countdown__digit" data-apgo-event-countdown-seconds>--</span>
          <span class="apgo-event-countdown__unit">s</span>
        </span>
      </div>
    </div>
  </div>

  <style>
    /* All scoped under body.apgo-special-event-page so the gold tokens
       defined in apgo-event-page.css are in cascade. */
    /* Option D — "whisper" version. Drops the dark inner fill so the
       panel bg shows through; thinner gold rim; tighter scale. The
       octagon clip-path stays so the ribbon silhouette is preserved
       but the chip recedes against the two heading lockups it sits
       between. */
    body.apgo-special-event-page .apgo-event-countdown {
      --apgo-countdown-cut: 11px;            /* corner cut depth */
      display: inline-block;
      margin: clamp(4px, 1vw, 8px) auto 0;
      padding: 1px;
      max-width: fit-content;
      background: linear-gradient(135deg, rgba(244,210,138,0.55), rgba(248,168,73,0.7), rgba(200,150,31,0.55));
      clip-path: polygon(
        var(--apgo-countdown-cut) 0,
        calc(100% - var(--apgo-countdown-cut)) 0,
        100% var(--apgo-countdown-cut),
        100% calc(100% - var(--apgo-countdown-cut)),
        calc(100% - var(--apgo-countdown-cut)) 100%,
        var(--apgo-countdown-cut) 100%,
        0 calc(100% - var(--apgo-countdown-cut)),
        0 var(--apgo-countdown-cut)
      );
    }
    body.apgo-special-event-page .apgo-event-countdown__inner {
      display: inline-flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: clamp(6px, 1.2vw, 9px);
      padding: clamp(4px, 0.9vw, 6px) clamp(11px, 1.8vw, 16px);
      /* Very faint dark tint instead of the heavy 0.55 fill — the
         panel bg still reads through, but there's just enough
         contrast to keep the gold rim from blurring into the page. */
      background: rgba(0, 0, 0, 0.14);
      clip-path: polygon(
        var(--apgo-countdown-cut) 0,
        calc(100% - var(--apgo-countdown-cut)) 0,
        100% var(--apgo-countdown-cut),
        100% calc(100% - var(--apgo-countdown-cut)),
        calc(100% - var(--apgo-countdown-cut)) 100%,
        var(--apgo-countdown-cut) 100%,
        0 calc(100% - var(--apgo-countdown-cut)),
        0 var(--apgo-countdown-cut)
      );
    }

    /* Hourglass icon — Option D: smaller + no glow halo so it sits
       quietly next to the label instead of pulling attention. */
    body.apgo-special-event-page .apgo-event-countdown__icon {
      display: inline-flex;
      align-items: center;
      color: rgba(248, 168, 73, 0.7);
    }
    body.apgo-special-event-page .apgo-event-countdown__icon svg {
      display: block;
      width: 11px;
      height: 14px;
    }

    body.apgo-special-event-page .apgo-event-countdown__label {
      font-size: clamp(9px, 1.2vw, 10.5px);
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      line-height: 1;
      background: var(--apgo-event-heading-gradient, linear-gradient(135deg, #f4d28a, #f8a849, #c8961f));
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      color: var(--apgo-event-gold-bright, #f8a849);
      opacity: 0.85;
      white-space: nowrap;
    }

    /* Boxed digits — Option D scale-down. Box rims dropped from
       0.42 opacity to 0.22 so they whisper instead of carving hard
       edges; backgrounds dropped from 0.42 to 0.20 to match the
       overall transparency. Digits one size smaller. */
    body.apgo-special-event-page .apgo-event-countdown__boxes {
      display: inline-flex;
      align-items: center;
      gap: clamp(3px, 0.7vw, 5px);
    }
    body.apgo-special-event-page .apgo-event-countdown__box {
      display: inline-flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-width: clamp(28px, 4.4vw, 36px);
      padding: clamp(2px, 0.5vw, 4px) clamp(4px, 0.8vw, 6px);
      background: rgba(0, 0, 0, 0.20);
      border: 1px solid rgba(244, 210, 138, 0.22);
      border-radius: 5px;
      line-height: 1;
    }
    body.apgo-special-event-page .apgo-event-countdown__digit {
      font-size: clamp(13px, 2vw, 16px);
      font-weight: 800;
      font-variant-numeric: tabular-nums; /* fixed-width digits → no jitter */
      letter-spacing: -0.01em;
      background: var(--apgo-event-heading-gradient, linear-gradient(135deg, #f4d28a, #f8a849, #c8961f));
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      color: var(--apgo-event-gold-bright, #f8a849);
    }
    body.apgo-special-event-page .apgo-event-countdown__unit {
      margin-top: 1px;
      font-size: clamp(6px, 0.85vw, 8px);
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: rgba(244, 210, 138, 0.55);
    }
    body.apgo-special-event-page .apgo-event-countdown__sep {
      font-size: clamp(10px, 1.2vw, 12px);
      font-weight: 800;
      color: var(--apgo-event-gold-bright, #f8a849);
      opacity: 0.45;
      line-height: 1;
      padding-bottom: clamp(6px, 1vw, 9px); /* nudge upward so colon aligns with digit, not unit */
    }
    @media (max-width: 480px) {
      /* Narrow viewports: let the chip's inner contents wrap so the
         ribbon doesn't push past the panel's side padding. */
      body.apgo-special-event-page .apgo-event-countdown__inner {
        flex-direction: column;
        gap: 6px;
        padding: 8px 16px;
      }
    }
  </style>

  <script>
    (function () {
      function init(root) {
        if (!root || root.dataset.apgoCountdownReady === '1') return;
        var endIso = root.getAttribute('data-end-iso');
        if (!endIso) return;
        var endMs = Date.parse(endIso);
        if (isNaN(endMs)) {
          /* Bad date — fail closed so we never show a broken timer. */
          root.style.display = 'none';
          return;
        }
        var elDays    = root.querySelector('[data-apgo-event-countdown-days]');
        var elHours   = root.querySelector('[data-apgo-event-countdown-hours]');
        var elMinutes = root.querySelector('[data-apgo-event-countdown-minutes]');
        var elSeconds = root.querySelector('[data-apgo-event-countdown-seconds]');
        if (!elDays || !elHours || !elMinutes || !elSeconds) return;
        root.dataset.apgoCountdownReady = '1';

        function pad(n) { return n < 10 ? '0' + n : '' + n; }

        function tick() {
          var delta = endMs - Date.now();
          if (delta <= 0) {
            /* Expired — disappear entirely. Per spec the rest of the
               page is unaffected so we only hide this chip. */
            root.style.display = 'none';
            if (root._apgoCountdownInterval) {
              clearInterval(root._apgoCountdownInterval);
              root._apgoCountdownInterval = null;
            }
            return;
          }
          var totalSec = Math.floor(delta / 1000);
          var days  = Math.floor(totalSec / 86400);
          var hours = Math.floor((totalSec % 86400) / 3600);
          var mins  = Math.floor((totalSec % 3600) / 60);
          var secs  = totalSec % 60;
          elDays.textContent    = pad(days);
          elHours.textContent   = pad(hours);
          elMinutes.textContent = pad(mins);
          elSeconds.textContent = pad(secs);
        }

        tick();
        /* If the very first tick already hid the chip, don't start the
           interval — saves a no-op every second forever. */
        if (root.style.display === 'none') return;
        root._apgoCountdownInterval = setInterval(tick, 1000);
      }

      function initAll(scope) {
        var nodes = (scope || document).querySelectorAll('[data-apgo-event-countdown]');
        for (var i = 0; i < nodes.length; i++) init(nodes[i]);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function () { initAll(); });
      } else {
        initAll();
      }
      /* Customizer hot-reload — Shopify dispatches this when a section
         is re-rendered. Re-init any countdown nodes inside the new
         markup so the timer keeps ticking after edits. */
      if (window.Shopify && Shopify.designMode) {
        document.addEventListener('shopify:section:load', function (e) { initAll(e.target); });
      }
    })();
  </script>
{%- endif -%}
