{% doc %}
  Renders the Aurora campaign counter from the paid-order shop metafield.

  @param {number} release_total - Sets allocated to the current release.
  @param {number} [manual_deduction] - Additional sets to subtract in the theme editor.
  @param {number} [milestone_total] - Previous sold-out allocation shown as a milestone.
  @param {string} [mode] - Use "compact" on the Aurora product page.
{% enddoc %}

{% liquid
  assign campaign_release_total = release_total | plus: 0
  if campaign_release_total < 1
    assign campaign_release_total = 88
  endif
  assign campaign_flow_baseline = 263
  assign paid_sets_metafield = shop.metafields.apgo_campaign.aurora_paid_sets
  if paid_sets_metafield != blank
    assign campaign_flow_paid_sets = paid_sets_metafield.value | plus: 0 | at_least: 0
  else
    assign campaign_flow_paid_sets = campaign_flow_baseline
  endif
  assign campaign_new_paid_sets = campaign_flow_paid_sets | minus: campaign_flow_baseline | at_least: 0
  assign campaign_manual_deduction = manual_deduction | plus: 0 | at_least: 0
  assign campaign_total_deduction = campaign_new_paid_sets | plus: campaign_manual_deduction
  assign campaign_remaining = campaign_release_total | minus: campaign_total_deduction | at_least: 0 | at_most: campaign_release_total
  assign campaign_claimed = campaign_total_deduction | at_most: campaign_release_total
  assign campaign_progress = campaign_remaining | times: 100.0 | divided_by: campaign_release_total
  assign campaign_milestone_total = milestone_total | plus: 0 | at_least: 0
  assign campaign_has_milestone = false
  if campaign_milestone_total > 0
    assign campaign_has_milestone = true
  endif
  assign low_stock_threshold = campaign_release_total | times: 0.25
%}

{% if mode == 'compact' %}
  <aside
    class="apgo-aurora-mini-counter{% if campaign_remaining <= low_stock_threshold %} is-low{% endif %}"
    data-aurora-stock-counter
    data-total="{{ campaign_release_total }}"
    data-claimed="{{ campaign_claimed }}"
    data-remaining="{{ campaign_remaining }}"
    aria-label="{{ 'apgo_event.aurora_counter.progress_label' | t: remaining: campaign_remaining, total: campaign_release_total }}"
  >
    <span class="apgo-aurora-mini-counter__pulse" aria-hidden="true"></span>
    <strong class="apgo-aurora-mini-counter__number" data-aurora-stock-number>{{ campaign_remaining }}</strong>
    <span class="apgo-aurora-mini-counter__label">
      {% if campaign_remaining > 0 %}
        {{ 'apgo_event.aurora_counter.sets_remaining' | t }}
      {% else %}
        {{ 'apgo_event.aurora_counter.extra_release_sold_out' | t }}
      {% endif %}
    </span>
    <span class="apgo-aurora-mini-counter__track" aria-hidden="true">
      <span
        class="apgo-aurora-mini-counter__fill"
        style="--apgo-stock-progress: {{ campaign_progress }}%;"
      ></span>
    </span>
  </aside>
  <small class="apgo-aurora-mini-counter__promo-note">*For 1+2 promo</small>
{% else %}
  <div
    class="apgo-event-stock-counter{% if campaign_remaining <= low_stock_threshold %} is-low{% endif %}{% if campaign_has_milestone %} is-extension{% endif %}"
    data-aurora-stock-counter
    data-total="{{ campaign_release_total }}"
    data-claimed="{{ campaign_claimed }}"
    data-remaining="{{ campaign_remaining }}"
  >
    {% if campaign_has_milestone %}
      <div class="apgo-event-stock-counter__milestone">
        <span class="apgo-event-stock-counter__milestone-icon" aria-hidden="true">✓</span>
        <span class="apgo-event-stock-counter__milestone-copy">
          <strong>{{ 'apgo_event.aurora_counter.first_release_sold_out' | t: total: campaign_milestone_total }}</strong>
          <small>{{ 'apgo_event.aurora_counter.milestone_thanks' | t }}</small>
        </span>
      </div>
      <div class="apgo-event-stock-counter__extension-head">
        <span>
          {% if campaign_remaining > 0 %}
            {{ 'apgo_event.aurora_counter.extra_release' | t: total: campaign_release_total }}
          {% else %}
            {{ 'apgo_event.aurora_counter.extra_release_sold_out' | t }}
          {% endif %}
        </span>
        <span class="apgo-event-stock-counter__extension-count">
          <strong data-aurora-stock-number>{{ campaign_remaining }}</strong>
          {% if campaign_remaining > 0 %}{{ 'apgo_event.aurora_counter.sets_remaining' | t }}{% endif %}
        </span>
      </div>
    {% else %}
      <div class="apgo-event-stock-counter__number-row">
        <span class="apgo-event-stock-counter__number" data-aurora-stock-number>{{ campaign_remaining }}</span>
        <span class="apgo-event-stock-counter__label">
          {% if campaign_remaining > 0 %}
            {{ 'apgo_event.aurora_counter.sets_remaining' | t }}
          {% else %}
            {{ 'apgo_event.aurora_counter.extra_release_sold_out' | t }}
          {% endif %}
        </span>
      </div>
    {% endif %}
    <div
      class="apgo-event-stock-counter__progress"
      role="progressbar"
      aria-label="{{ 'apgo_event.aurora_counter.progress_label' | t: remaining: campaign_remaining, total: campaign_release_total }}"
      aria-valuemin="0"
      aria-valuemax="{{ campaign_release_total }}"
      aria-valuenow="{{ campaign_remaining }}"
    >
      <span
        class="apgo-event-stock-counter__progress-fill"
        style="--apgo-stock-progress: {{ campaign_progress }}%;"
      ></span>
    </div>
    <div class="apgo-event-stock-counter__meta">
      {% if campaign_has_milestone %}
        <span>{{ 'apgo_event.aurora_counter.extra_release_short' | t: total: campaign_release_total }}</span>
      {% else %}
        <span>{{ 'apgo_event.aurora_counter.limited_release' | t }}</span>
      {% endif %}
      <span>{{ 'apgo_event.aurora_counter.while_stocks_last' | t }}</span>
    </div>
  </div>
  <p class="apgo-event-stock-counter__notice">
    {{ 'apgo_event.aurora_counter.stock_update_notice' | t }}
  </p>
{% endif %}
