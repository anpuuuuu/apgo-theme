{%- doc -%}
  Shipping-label heading used across the clearance page
  (templates/page.clearance-sale.json): a printed note line, a red lot
  code, the title in Anton and a decorative barcode. Styled in
  assets/apgo-clearance-page.css. Renders nothing when title is blank.

  @param {string} title - Heading text.
  @param {string} [note] - Small printed line above the title.
  @param {string} [lot] - Code at the top right, e.g. "LOT 02" or "UPDATE".
  @param {string} [tag] - Heading element name. Defaults to h2.
  @param {boolean} [barcode] - Pass false to leave out the barcode.
  @param {string} [modifier] - Tilt modifier: 'tilt-left' (default) or 'tilt-right'.

  @example
  {% render 'apgo-clearance-label', title: 'Last pieces', note: 'CONTENTS: MIXED STOCK', lot: 'LOT 02' %}
{%- enddoc -%}

{%- if title != blank -%}
  {%- liquid
    assign apgo_label_tag = tag | default: 'h2'
    assign apgo_label_tilt = modifier | default: 'tilt-left'
  -%}
  <header class="apgo-crate-label apgo-crate-label--{{ apgo_label_tilt }}">
    {%- if note != blank -%}
      <span class="apgo-crate-label__note">{{ note | escape }}</span>
    {%- endif -%}
    {%- if lot != blank -%}
      <span class="apgo-crate-label__lot">{{ lot | escape }}</span>
    {%- endif -%}
    <{{ apgo_label_tag }} class="apgo-crate-label__title">{{ title | escape }}</{{ apgo_label_tag }}>
    {%- unless barcode == false -%}
      <span class="apgo-crate-label__barcode" aria-hidden="true"></span>
    {%- endunless -%}
  </header>
{%- endif -%}
