{%- doc -%}
  Premium "stage card" for the APGO Birthday page Featured Stage —
  a richer alternative to the regular apgo-event-listing-card. Used
  by sections/apgo-event-collection-grid.liquid as one half of the
  two-product display pedestal.

  Visual differentiators from the regular listing card:
   - 2-column desktop layout (image left, body right); stacks to image-
     top, body-bottom on mobile.
   - Big serif italic rank number (01 / 02) overlaid on the image.
   - Gold pill badge above the title.
   - Gold gradient CTA pill below the price.
   - Champagne-gold typography.

  @param {object} product - Product object (required)
  @param {string} rank    - "01" or "02" (display only)
  @param {string} badge   - Pill text above title (e.g. "STAR PICK")
  @param {string} cta     - CTA button label (e.g. "View deal")
{%- enddoc -%}

{%- liquid
  assign featured_variant = product.selected_or_first_available_variant
  assign featured_image = featured_variant.featured_image | default: product.featured_image
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

<a class="apgo-event-featured-card" href="{{ product.url }}" data-rank="{{ rank }}">
  <div class="apgo-event-featured-card__media">
    {%- if featured_image != blank -%}
      <img
        class="apgo-event-featured-card__img"
        src="{{ featured_image | image_url: width: 800 }}"
        alt="{{ product.title | escape }}"
        loading="lazy"
        width="800"
        height="800"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'apgo-event-featured-card__placeholder' }}
    {%- endif -%}
    {%- if rank != blank -%}
      <span class="apgo-event-featured-card__rank" aria-hidden="true">{{ rank }}</span>
    {%- endif -%}
  </div>

  <div class="apgo-event-featured-card__body">
    {%- if badge != blank -%}
      <span class="apgo-event-featured-card__badge">{{ badge }}</span>
    {%- endif -%}
    <h4 class="apgo-event-featured-card__title">{{ product.title }}</h4>
    <div class="apgo-event-featured-card__price-row">
      <span class="apgo-event-featured-card__price">{{ product.price | money }}</span>
      {%- if on_sale -%}
        <span class="apgo-event-featured-card__price-compare">{{ product.compare_at_price | money }}</span>
      {%- endif -%}
    </div>
    <span class="apgo-event-featured-card__cta">
      {{ cta | default: 'View deal' }}
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/>
      </svg>
    </span>
  </div>
</a>
