{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block,featured product block, and the product card block.

  @param {product} product_resource - The product to render
  @param {variant} [listing_variant] - When set, price/unit for this variant (e.g. bundle on promo collection)
  @param {boolean} [listing_card_discount] - Collection cards only: hide strikethrough compare-at, show -X% badge by sale price
  @param {boolean} [show_unit_price] - Whether to show the unit price
  @param {boolean} [show_sale_price_first] - Whether to show the sale price first
  @param {boolean} [force_money_without_currency] - If true, always use `money` (no ISO suffix like MYR)
{%- enddoc -%}

{%- liquid
  assign show_unit_price = show_unit_price | default: false
  assign show_sale_price_first = show_sale_price_first | default: false
  assign force_money_without_currency = force_money_without_currency | default: false
  assign listing_card_discount = listing_card_discount | default: false
  if listing_variant != blank
    assign selected_variant = listing_variant
  else
    assign selected_variant = product_resource.selected_or_first_available_variant
  endif
  assign raw_price_cents = selected_variant.price
  assign raw_compare_cents = selected_variant.compare_at_price
  capture apgo_limited_promo_raw
    render 'apgo-limited-promo-data', product: product_resource
  endcapture
  assign apgo_limited_promo_parts = apgo_limited_promo_raw | strip | split: '|'
  assign apgo_limited_promo_price_cents = apgo_limited_promo_parts[0] | plus: 0
  assign apgo_limited_promo_message = apgo_limited_promo_parts[1]
  assign apgo_limited_promo_active = false
  if apgo_limited_promo_price_cents > 0 and selected_variant.price > apgo_limited_promo_price_cents
    assign apgo_limited_promo_active = true
    assign raw_compare_cents = selected_variant.price
    assign raw_price_cents = apgo_limited_promo_price_cents
  endif
  assign discount_pct = 0
  if raw_compare_cents > raw_price_cents and raw_compare_cents > 0
    assign discount_pct = raw_compare_cents | minus: raw_price_cents | times: 100 | divided_by: raw_compare_cents
  endif

  assign price = raw_price_cents
  assign compare_at_price = raw_compare_cents

  assign show_compare_price = false
  if raw_compare_cents > raw_price_cents
    assign show_compare_price = true
  endif

  if product_resource == blank and request.design_mode
    assign price = 1999
  endif

  # Collection listing: show RM… style without trailing currency code (e.g. MYR)
  if force_money_without_currency == false and template.name == 'collection'
    assign force_money_without_currency = true
  endif

  if force_money_without_currency
    assign price = price | money
    assign compare_at_price = compare_at_price | money

  # Checks if product handle matches the closest product's handle (i.e. product page)
  # and if the currency code is enabled for product pages
  elsif product.handle == closest.product.handle and settings.currency_code_enabled_product_pages
    assign price = price | money_with_currency
    assign compare_at_price = compare_at_price | money_with_currency

    # Checks if product handle does not match the closest product's handle (i.e. product card)
    # and if the currency code is enabled for product cards
  elsif product.handle != closest.product.handle and settings.currency_code_enabled_product_cards
    assign price = price | money_with_currency
    assign compare_at_price = compare_at_price | money_with_currency

  else
    assign price = price | money
    assign compare_at_price = compare_at_price | money
  endif

  # Malaysia storefront: money_with_currency appends " MYR"; strip for display (hub / search / cards).
  assign price = price | replace: ' MYR', '' | replace: 'MYR', '' | strip
  assign compare_at_price = compare_at_price | replace: ' MYR', '' | replace: 'MYR', '' | strip
-%}

<div
  ref="priceContainer"
  class="{% if listing_card_discount and show_compare_price and apgo_limited_promo_active == false %}price--listing-discount{% endif %}{% if apgo_limited_promo_active %} price--apgo-limited-promo{% endif %}"
>
  {% if listing_card_discount and show_compare_price and apgo_limited_promo_active == false %}
    <span role="group" class="price-sale-row">
      <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;{{- compare_at_price -}}</span>
      <span class="visually-hidden">{{ 'content.price_sale' | t }}&nbsp;</span>
      <span class="price">{{ price | default: '&nbsp;' }}</span>
      {% if discount_pct > 0 %}
        <span class="price-discount-pct" aria-hidden="true">-{{ discount_pct }}%</span>
      {% endif %}
    </span>
  {% else %}
    {% if show_sale_price_first == false and show_compare_price %}
      <span role="group">
        <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
        <span class="compare-at-price">{{- compare_at_price -}}</span>
      </span>
    {% endif %}

    {% if show_compare_price %}
      <span role="group">
        <span class="visually-hidden">{{ 'content.price_sale' | t }}&nbsp;</span>
        <span class="price">{{ price | default: '&nbsp;' }}</span>
      </span>
    {% else %}
      <span class="price">{{ price | default: '&nbsp;' }}</span>
    {% endif %}

    {% if show_sale_price_first == true and show_compare_price %}
      <span role="group">
        <span class="visually-hidden">{{ 'content.price_regular' | t }}&nbsp;</span>
        <span class="compare-at-price">{{- compare_at_price -}}</span>
      </span>
    {% endif %}
  {% endif %}
  {%- if selected_variant.unit_price and show_unit_price %}
    {%- liquid
      if force_money_without_currency
        assign unit_price = selected_variant.unit_price | money
      elsif product.handle == closest.product.handle and settings.currency_code_enabled_product_pages
        assign unit_price = selected_variant.unit_price | money_with_currency
      elsif product.handle != closest.product.handle and settings.currency_code_enabled_product_cards
        assign unit_price = selected_variant.unit_price | money_with_currency
      else
        assign unit_price = selected_variant.unit_price | money
      endif
      assign unit_price = unit_price | replace: ' MYR', '' | replace: 'MYR', '' | strip
    -%}
    {% render 'unit-price', price: unit_price, measurement: selected_variant.unit_price_measurement %}
  {%- endif -%}
  {%- if apgo_limited_promo_active -%}
    <span class="apgo-promo-limit-note">{{ apgo_limited_promo_message }}</span>
  {%- endif -%}
</div>

{% stylesheet %}
  .price--listing-discount .price-sale-row {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35em 0.5em;
  }

  .price--listing-discount .price-discount-pct {
    font-size: 0.88em;
    font-weight: 600;
    color: #f08418;
    background: rgba(240, 132, 24, 0.24);
    padding: 0.1em 0.38em;
    border-radius: 4px;
    line-height: 1.2;
  }

  .price--apgo-limited-promo .apgo-promo-limit-note {
    display: block;
    width: 100%;
    margin-block-start: 0.35rem;
    color: currentColor;
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.035em;
    opacity: 0.72;
  }
{% endstylesheet %}
