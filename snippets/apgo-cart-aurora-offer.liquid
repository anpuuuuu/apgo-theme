{% doc %}
  Cart add-on offer card (first used for the 11.11 Aurora bundle). Products,
  name and prices come from Theme settings → APGO — Cart add-on offer;
  checkout pricing is controlled by an AIOD rule.
{% enddoc %}
{%- liquid
  assign offer_product = settings.apgo_addon_offer
  assign offer_variant = offer_product.selected_or_first_available_variant
  assign aurora_eligible = false
  assign aurora_offer_in_cart = false
  for item in cart.items
    if item.product_id == settings.apgo_addon_trigger.id and item.quantity > 0
      assign aurora_eligible = true
    elsif item.variant_id == offer_variant.id and item.quantity > 0
      assign aurora_offer_in_cart = true
    endif
  endfor
  assign offer_image = offer_variant.featured_image | default: offer_product.featured_image
  assign offer_price_minor = settings.apgo_addon_price | default: 30 | times: 100 | round
  assign reference_price_minor = settings.apgo_addon_original_price | default: 60 | times: 100 | round
  assign offer_savings_minor = reference_price_minor | minus: offer_price_minor
-%}
{%- if aurora_eligible and offer_variant != blank and localization.country.iso_code == 'MY' and cart.currency.iso_code == 'MYR' -%}
  {%- comment -%} Keep visibility and animation state while the cart morphs the card's contents. {%- endcomment -%}
  <apgo-aurora-offer class="aurora-offer" data-skip-node-update data-available="{{ offer_variant.available }}" aria-labelledby="AuroraOfferTitle"{% if aurora_offer_in_cart %} hidden{% endif %}>
    <div class="aurora-offer__card">
        <svg class="aurora-offer__border" aria-hidden="true" focusable="false">
          {% for beam in (1..6) %}
            <g class="aurora-offer__beam">
              <rect class="aurora-offer__beam-halo" width="100%" height="100%" rx="9" pathLength="100" />
              <rect class="aurora-offer__beam-tail" width="100%" height="100%" rx="9" pathLength="100" />
              <rect class="aurora-offer__beam-core" width="100%" height="100%" rx="9" pathLength="100" />
            </g>
          {% endfor %}
        </svg>
        <div class="aurora-offer__topline">
          <p class="aurora-offer__reason"><span class="aurora-offer__sparkle" aria-hidden="true">✦</span> Specially made for this order</p>
          <div class="aurora-offer__urgency">
            <span class="aurora-offer__timer-label">Ends in</span>
            <span class="aurora-offer__timer" role="timer" aria-label="Time remaining" aria-live="off"><span data-offer-minutes>10</span><span>:</span><span data-offer-seconds>00</span></span>
          </div>
        </div>
        <h2 class="aurora-offer__heading" id="AuroraOfferTitle" title="{{ offer_product.title | escape }} — {{ offer_variant.title | escape }}">Add {{ offer_price_minor | money | replace: cart.currency.iso_code, '' | strip | replace: '.00', '' }} for {{ settings.apgo_addon_name | default: offer_product.title | escape }} <span class="aurora-offer__worth">worth {{ reference_price_minor | money | replace: cart.currency.iso_code, '' | strip | replace: '.00', '' }}</span></h2>
        <div class="aurora-offer__image-wrap">
          {% if offer_image != blank %}
            {{ offer_image | image_url: width: 216 | image_tag: class: 'aurora-offer__image', widths: '72, 144, 216', sizes: '(max-width: 749px) 56px, 64px', loading: 'lazy', alt: offer_product.title }}
          {% endif %}
        </div>
        <div class="aurora-offer__details">
          <div class="aurora-offer__prices">
            <strong class="aurora-offer__price">{{ offer_price_minor | money | replace: cart.currency.iso_code, '' | strip | replace: '.00', '' }}</strong>
            {% if reference_price_minor > offer_price_minor %}
              <s class="aurora-offer__original">{{ reference_price_minor | money | replace: cart.currency.iso_code, '' | strip | replace: '.00', '' }}</s>
            {% endif %}
            {% if offer_savings_minor > 0 %}
              <span class="aurora-offer__saving">Save {{ offer_savings_minor | money | replace: cart.currency.iso_code, '' | strip | replace: '.00', '' }}</span>
            {% endif %}
          </div>
          <p class="aurora-offer__exclusivity"><em>Exclusive 1 set for this order only</em></p>
        </div>
        <button class="aurora-offer__button" data-available="{{ offer_variant.available }}" type="button" disabled aria-describedby="AuroraOfferStatus"><span class="visually-hidden" data-offer-button-label>{{ 'actions.add_to_cart' | t }} — {{ offer_variant.title | escape }}</span><span data-offer-button-icon aria-hidden="true">＋</span></button>
        <p class="aurora-offer__status" id="AuroraOfferStatus" data-offer-status role="status" aria-live="polite" hidden></p>
    </div>
  </apgo-aurora-offer>
{%- endif -%}
