{% doc %}
  Conditional Aurora add-on UI preview; never changes the cart or pricing.
  @param {number} [original_price] - Confirmed reference price in MYR major units, or 0 when pending.
{% enddoc %}
{%- liquid
  assign aurora_eligible = false
  for item in cart.items
    if item.variant_id == 67976724512922 and item.quantity > 0
      assign aurora_eligible = true
      break
    endif
  endfor
  assign offer_product = all_products['apgo-car-interior-coating-200ml-copy']
  assign offer_variant = offer_product.variants | where: 'id', 67977147777178 | first
  assign offer_image = offer_variant.featured_image | default: offer_product.featured_image
  assign offer_price_minor = 3900
  assign reference_price_minor = original_price | default: 0 | times: 100 | round
  assign offer_savings_minor = reference_price_minor | minus: offer_price_minor
-%}
{%- if aurora_eligible and offer_variant != blank and cart.currency.iso_code == 'MYR' -%}
  <apgo-aurora-offer class="aurora-offer" data-duration="600" data-timer-key="apgo:aurora-addon:preview:MYR" aria-labelledby="AuroraOfferTitle">
    <div class="aurora-offer__card">
        <svg class="aurora-offer__border" aria-hidden="true" focusable="false"><rect width="100%" height="100%" rx="9" pathLength="100" /></svg>
        <div class="aurora-offer__image-wrap">
          {% if offer_image != blank %}
            {{ offer_image | image_url: width: 216 | image_tag: class: 'aurora-offer__image', widths: '72, 144, 216', sizes: '(max-width: 749px) 56px, 64px', loading: 'lazy', alt: offer_product.title }}
          {% endif %}
        </div>
        <div class="aurora-offer__details">
          <div class="aurora-offer__topline">
            <p class="aurora-offer__reason"><span class="aurora-offer__sparkle" aria-hidden="true">✦</span> Aurora Bundle exclusive</p>
            <div class="aurora-offer__urgency">
              <span class="aurora-offer__timer-label">Ends in</span>
              <span class="aurora-offer__timer" role="timer" aria-label="Time remaining" aria-live="off"><span data-offer-minutes>10</span><span>:</span><span data-offer-seconds>00</span></span>
            </div>
          </div>
          <h2 class="aurora-offer__heading" id="AuroraOfferTitle" title="{{ offer_product.title | escape }}">Interior Coating 200ml · B1F1</h2>
          <div class="aurora-offer__prices">
            <strong class="aurora-offer__price">{{ offer_price_minor | money | replace: cart.currency.iso_code, '' | strip | replace: '.00', '' }}</strong>
            {% if reference_price_minor > offer_price_minor %}
              <s class="aurora-offer__original">{{ reference_price_minor | money | replace: cart.currency.iso_code, '' | strip | replace: '.00', '' }}</s>
            {% endif %}
            {% if offer_savings_minor > 0 %}
              <span class="aurora-offer__saving">Save {{ offer_savings_minor | money | replace: cart.currency.iso_code, '' | strip | replace: '.00', '' }}</span>
            {% endif %}
            <span class="aurora-offer__preview" id="AuroraOfferPreviewNote" title="UI preview only. No item will be added or discounted.">Preview</span>
          </div>
        </div>
        <button class="aurora-offer__button" type="button" disabled aria-describedby="AuroraOfferPreviewNote"><span class="visually-hidden" data-offer-button-label>Add for {{ offer_price_minor | money | replace: cart.currency.iso_code, '' | strip }} (UI preview only)</span><span aria-hidden="true">＋</span></button>
    </div>
  </apgo-aurora-offer>
{%- endif -%}
