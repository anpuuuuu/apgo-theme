{% liquid
  assign offer_product = offer_block.settings.product
  assign configured_variant_id = offer_block.settings.variant_id | strip
  assign offer_variant = blank

  if offer_product != blank and configured_variant_id != blank
    assign configured_variant_id_number = configured_variant_id | plus: 0
    for product_variant in offer_product.variants
      if product_variant.id == configured_variant_id_number
        assign offer_variant = product_variant
        break
      endif
    endfor
  elsif offer_product != blank and offer_product.has_only_default_variant
    assign offer_variant = offer_product.selected_or_first_available_variant
  endif

  assign display_variant = offer_variant
  if display_variant == blank and offer_product != blank
    assign display_variant = offer_product.selected_or_first_available_variant
  endif

  assign product_quantity_in_cart = 0
  if offer_product != blank
    for cart_item in cart.items
      if cart_item.product_id == offer_product.id
        assign product_quantity_in_cart = product_quantity_in_cart | plus: cart_item.quantity
      endif
    endfor
  endif

  assign max_quantity = offer_block.settings.max_quantity | default: 0
  assign is_at_limit = false
  if max_quantity > 0 and product_quantity_in_cart >= max_quantity
    assign is_at_limit = true
  endif

  comment
    Third state, between ADD and ADDED: already in the cart but still
    under its per-order limit. Without it an offer allowing two units
    showed "ADD" before and after the first click, so a successful add
    looked like a dead button. max_quantity 0 means no limit, which
    lands here too — it can never reach ADDED.
  endcomment
  assign can_add_more = false
  if is_at_limit == false and product_quantity_in_cart > 0
    assign can_add_more = true
  endif

  assign offer_image = display_variant.featured_image | default: offer_product.featured_image
  assign product_url = offer_product.url
  if offer_variant != blank and configured_variant_id != blank
    assign product_url = offer_variant.url
  endif

  assign promo_label = offer_block.settings.promo_price_my
  if is_sg
    assign promo_label = offer_block.settings.promo_price_sg
  endif

  assign use_promo_label = false
  if offer_block.settings.price_mode == 'promo' and promo_label != blank
    assign use_promo_label = true
  endif

  assign compare_price = blank
  if use_promo_label
    if display_variant.compare_at_price > display_variant.price
      assign compare_price = display_variant.compare_at_price
    else
      assign compare_price = display_variant.price
    endif
  elsif display_variant.compare_at_price > display_variant.price
    assign compare_price = display_variant.compare_at_price
  endif

  assign can_quick_add = false
  if offer_variant != blank and offer_variant.available
    assign can_quick_add = true
  endif

  comment
    The saving is the whole reason this card converts, so derive it
    rather than making the merchant type it per offer (and get it wrong
    when a price moves). The promo price is free text — "RM 49.00",
    "$ 24.90" — so strip the currency furniture down to a number before
    comparing it against the variant's compare-at price in cents.
  endcomment
  assign discount_percent = 0
  assign amount_saved = 0
  if compare_price != blank and compare_price > 0
    assign promo_cents = 0
    if use_promo_label
      assign promo_number = promo_label | remove: 'RM' | remove: 'MYR' | remove: 'SGD' | remove: 'S$' | remove: '$' | remove: ',' | remove: ' ' | strip | plus: 0
      assign promo_cents = promo_number | times: 100 | round: 0
    else
      assign promo_cents = display_variant.price
    endif
    if promo_cents > 0 and compare_price > promo_cents
      assign amount_saved = compare_price | minus: promo_cents | round: 0
      comment
        `times: 100.0`, not 100 — two integers make `divided_by` do
        integer division, which floors 64.9% to 64 and quietly
        undersells every offer by a point.
      endcomment
      assign discount_percent = amount_saved | times: 100.0 | divided_by: compare_price | round: 0
    endif
  endif

  comment
    A 0% or ~100% badge means the promo text and the variant price have
    drifted apart — show nothing rather than something false.
  endcomment
  comment
    `!= false` rather than a truthiness test: the section was saved
    before these settings existed, so they read as nil until the merchant
    next opens the editor — and nil should mean "on", not "off".
  endcomment
  assign show_discount_badge = false
  if section.settings.show_discount_badge != false and discount_percent > 0 and discount_percent < 95
    assign show_discount_badge = true
  endif

  assign show_savings = false
  if section.settings.show_savings != false and amount_saved > 0
    assign show_savings = true
  endif

  comment
    The shop's money format carries the ISO code ("RM158.00 MYR"), which
    is noise beside a price the shopper is meant to read at a glance.
  endcomment
  assign saved_display = amount_saved | money_without_trailing_zeros | replace: ' MYR', '' | replace: ' SGD', '' | replace: 'MYR', '' | replace: 'SGD', '' | strip
%}

{% if offer_product != blank %}
  <article
    class="cart-offers-tabs__card"
    data-offer-card
    data-product-id="{{ offer_product.id }}"
    data-max-quantity="{{ max_quantity }}"
    {{ offer_block.shopify_attributes }}
  >
    <a class="cart-offers-tabs__card-link" href="{{ product_url }}">
      <div class="cart-offers-tabs__image cart-offers-tabs__image--{{ image_ratio }}">
        {% if show_discount_badge %}
          <span class="cart-offers-tabs__discount">&minus;{{ discount_percent }}%</span>
        {% endif %}
        {% if offer_image != blank %}
          {{
            offer_image
            | image_url: width: 720
            | image_tag:
              loading: 'lazy',
              widths: '180, 260, 360, 520, 720',
              sizes: '(max-width: 749px) 44vw, (max-width: 989px) 30vw, 280px',
              alt: offer_image.alt | default: offer_product.title
          }}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag }}
        {% endif %}
      </div>

      <div class="cart-offers-tabs__card-body">
        {% comment %}
          The variant name is a SIBLING of the title, not a child of it.
          Nested inside, it counted against the title's two-line clamp:
          a title that filled both lines exactly still got an ellipsis,
          because the hidden variant line after it made the box overflow
          — so the last character of a complete title was eaten to make
          room for a "…" that stood for nothing the reader could see.
        {% endcomment %}
        <h3 class="cart-offers-tabs__product-title">{{ offer_product.title }}</h3>
        {% if display_variant != blank and display_variant.title != 'Default Title' %}
          <p class="cart-offers-tabs__variant">{{ display_variant.title }}</p>
        {% endif %}

        {% comment %}
          No strike-through line: the discount badge and the saving
          already carry the before/after, and a third price on the card
          was one number too many.
        {% endcomment %}
        <div class="cart-offers-tabs__prices">
          <span class="cart-offers-tabs__price-row">
            <span class="cart-offers-tabs__price-current">
              {% if use_promo_label %}
                {{ promo_label }}
              {% elsif display_variant != blank %}
                {{ display_variant.price | money }}
              {% endif %}
            </span>
            {% if show_savings %}
              <span class="cart-offers-tabs__price-saved">save {{ saved_display }}</span>
            {% endif %}
          </span>
        </div>
      </div>
    </a>

    {% if can_quick_add %}
      <button
        type="button"
        class="cart-offers-tabs__action{% if is_at_limit %} is-added{% elsif can_add_more %} is-more{% endif %}"
        data-offer-add
        data-variant-id="{{ offer_variant.id }}"
        data-max-quantity="{{ max_quantity }}"
        data-default-label="{{ section.settings.add_button_text | escape }}"
        data-added-label="{{ section.settings.added_button_text | escape }}"
        data-more-label="{{ section.settings.add_more_button_text | default: 'ADD ANOTHER' | escape }}"
        {% if is_at_limit %}disabled{% endif %}
      >
        {% if is_at_limit %}
          {{ section.settings.added_button_text }}
        {% elsif can_add_more %}
          {{ section.settings.add_more_button_text | default: 'ADD ANOTHER' }}
        {% else %}
          {{ section.settings.add_button_text }}
        {% endif %}
      </button>
    {% elsif display_variant != blank and display_variant.available %}
      <a class="cart-offers-tabs__select-options" href="{{ offer_product.url }}">
        {{ section.settings.select_options_text }}
      </a>
    {% else %}
      <button type="button" class="cart-offers-tabs__action is-sold-out" disabled>
        {{ section.settings.sold_out_text }}
      </button>
    {% endif %}
  </article>
{% endif %}
