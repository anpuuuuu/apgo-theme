{%- doc -%}
  Walk the cart line items; if ANY line's product carries the
  'free-shipping' tag the order qualifies for free shipping
  regardless of the per-market threshold.

  Outputs the title of the FIRST qualifying product (so the cart UI
  can render "🎁 You got free shipping with X" copy). Outputs blank
  if no line qualifies.

  Usage:
    {%- capture apgo_fs_title -%}{%- render 'apgo-cart-free-shipping-product-title' -%}{%- endcapture -%}
    {%- assign apgo_fs_title = apgo_fs_title | strip -%}
    {%- if apgo_fs_title != blank -%} ... unlocked ... {%- endif -%}

  Tag is hardcoded so admins can drop it on any product / variant
  from the Shopify Products page without touching theme code.

  Also qualifies: a full set of the bundle picker's set offer (any 3 for
  RM99, theme settings → APGO — Bundle Widget → Set offer, Malaysia
  only) when "Free shipping with a set" is ticked. Packs of every
  bundle-enabled product count together; free gift lines don't count.
  The JS side of the same rule is in snippets/apgo-cart-free-shipping-lookup.
{%- enddoc -%}
{%- liquid
  assign apgo_fs_out = ''
  for line in cart.items
    if line.product.tags contains 'free-shipping'
      assign apgo_fs_out = line.product.title
      break
    endif
  endfor

  if apgo_fs_out == blank
    capture apgo_fs_set_on
      render 'apgo-bundle-set-offer'
    endcapture
    if apgo_fs_set_on == 'on' and settings.apgo_bundle_set_free_ship_my
      assign apgo_fs_packs = 0
      assign apgo_fs_set_title = ''
      for line in cart.items
        if line.product.metafields.apgo.bundle_enabled and line.properties._free_gift != 'true' and line.final_price > 0
          assign apgo_fs_packs = apgo_fs_packs | plus: line.quantity
          if apgo_fs_set_title == blank
            assign apgo_fs_set_title = line.product.title
          endif
        endif
      endfor
      assign apgo_fs_set_count = settings.apgo_bundle_set_count | default: 3
      if apgo_fs_packs >= apgo_fs_set_count
        assign apgo_fs_out = apgo_fs_set_title
      endif
    endif
  endif

  echo apgo_fs_out
-%}
