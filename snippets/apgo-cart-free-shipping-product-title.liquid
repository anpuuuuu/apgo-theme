{%- doc -%}
  Walk the cart line items; if ANY line's product carries the
  'free-shipping' tag the order qualifies for free shipping
  regardless of the per-market threshold.

  Outputs the title of the FIRST qualifying product (so the cart UI
  can render "🎁 You got free shipping with X" copy). Outputs blank
  if no line qualifies.

  Usage:
    {%- capture apgo_fs_title -%}{%- render 'apgo-cart-free-shipping-product-title' -%}{%- endcapture -%}
    {%- assign apgo_fs_title = apgo_fs_title | strip -%}
    {%- if apgo_fs_title != blank -%} ... unlocked ... {%- endif -%}

  Tag is hardcoded so admins can drop it on any product / variant
  from the Shopify Products page without touching theme code.

  Also qualifies: a full set of one bundle product whose set comes with
  free shipping (snippets/apgo-bundle-set-config: any 3 for RM99 in
  Malaysia, the 11.11 Value Bundle's any 4). Packs of different products
  don't add up; free gift lines don't count. The JS side of the same rule
  is in snippets/apgo-cart-free-shipping-lookup.
{%- enddoc -%}
{%- liquid
  assign apgo_fs_out = ''
  for line in cart.items
    if line.product.tags contains 'free-shipping'
      assign apgo_fs_out = line.product.title
      break
    endif
  endfor

  if apgo_fs_out == blank
    for line in cart.items
      if line.properties._free_gift == 'true' or line.final_price == 0
        continue
      endif
      capture apgo_fs_cfg
        render 'apgo-bundle-set-config', product: line.product
      endcapture
      assign apgo_fs_cfg = apgo_fs_cfg | strip | split: '|'
      if apgo_fs_cfg[3] != '1'
        continue
      endif
      assign apgo_fs_packs = 0
      for other in cart.items
        if other.product_id == line.product_id and other.properties._free_gift != 'true' and other.final_price > 0
          assign apgo_fs_packs = apgo_fs_packs | plus: other.quantity
        endif
      endfor
      assign apgo_fs_set_count = apgo_fs_cfg[1] | plus: 0
      if apgo_fs_packs >= apgo_fs_set_count
        assign apgo_fs_out = line.product.title
        break
      endif
    endfor
  endif

  echo apgo_fs_out
-%}
