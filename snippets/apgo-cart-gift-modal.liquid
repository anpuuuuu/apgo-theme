{%- comment -%}
  Cart follow-up gift picker modal (Glaze promo).
  Rendered globally from layout/theme.liquid when
  settings.apgo_cart_gift_enabled is on. apgo-cart-gift.js opens it when
  the promo bundle's cart quantity entitles the customer to MORE free
  gifts than currently picked (entitled = bundle qty × per; picked =
  cart lines tagged _gift_pick). Self-contained styling (dark) so it
  works on the cart page, drawer, anywhere.
{%- endcomment -%}

<div class="apgo-cart-gift-modal" data-apgo-cart-gift-modal aria-hidden="true" hidden>
  <div class="apgo-cart-gift-modal__backdrop" data-apgo-cart-gift-close></div>
  <div class="apgo-cart-gift-modal__panel" role="dialog" aria-modal="true" aria-label="Choose your free gifts">
    <button type="button" class="apgo-cart-gift-modal__close" data-apgo-cart-gift-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <p class="apgo-cart-gift-modal__lead" data-apgo-cart-gift-lead>You've unlocked more free gifts — choose them below.</p>
    {%- render 'apgo-cc-gift-picker',
      pool: settings.apgo_cart_gift_pool,
      heading: 'Choose your free gifts',
      count: settings.apgo_cart_gift_per,
      property: '_gift_pick',
      location: 'cart' -%}
    <div class="apgo-cart-gift-modal__actions">
      <button type="button" class="apgo-cart-gift-modal__cta" data-apgo-cart-gift-add disabled>Add free gifts</button>
    </div>
  </div>
</div>

<style>
  html.apgo-cart-gift-lock { overflow: hidden; }

  .apgo-cart-gift-modal {
    position: fixed;
    inset: 0;
    z-index: 100400;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity .24s ease;
  }
  .apgo-cart-gift-modal[hidden] { display: none; }
  .apgo-cart-gift-modal.is-open { opacity: 1; pointer-events: auto; }

  .apgo-cart-gift-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.62);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  .apgo-cart-gift-modal__panel {
    position: relative;
    width: 100%;
    max-width: 560px;
    max-height: 84vh;
    overflow-y: auto;
    background: #14161c;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px 20px 0 0;
    padding: 44px 16px calc(16px + env(safe-area-inset-bottom, 10px));
    box-shadow: 0 -16px 48px rgba(0, 0, 0, 0.55);
    transform: translateY(100%);
    transition: transform .3s cubic-bezier(.22, 1, .36, 1);
  }
  .apgo-cart-gift-modal.is-open .apgo-cart-gift-modal__panel { transform: translateY(0); }

  .apgo-cart-gift-modal__close {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 34px;
    height: 34px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.8);
    cursor: pointer;
    padding: 0;
  }
  .apgo-cart-gift-modal__close:hover { background: rgba(255, 255, 255, 0.16); color: #fff; }

  .apgo-cart-gift-modal__lead {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 700;
    color: #f2d896;
  }

  .apgo-cart-gift-modal__actions { margin-top: 14px; }
  .apgo-cart-gift-modal__cta {
    width: 100%;
    padding: 15px 0;
    border: none;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    background: linear-gradient(135deg, #f6dfa4, #d9b25f);
    color: #1a1206;
    transition: opacity .15s ease;
  }
  .apgo-cart-gift-modal__cta:disabled { opacity: 0.4; cursor: not-allowed; }

  /* Gift picker inside this modal (shared apgo-cc-gift-picker snippet) */
  .apgo-cart-gift-modal .apgo-gift-picker { margin: 0; padding: 0; border: none; background: transparent; }
  .apgo-cart-gift-modal .apgo-gift-picker__head {
    display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px;
  }
  .apgo-cart-gift-modal .apgo-gift-picker__heading {
    font-size: 14px; font-weight: 800; letter-spacing: 0.04em; color: #fff; text-transform: uppercase;
  }
  .apgo-cart-gift-modal .apgo-gift-picker__counter {
    flex: 0 0 auto; font-size: 12px; font-weight: 700; color: #fff;
    background: rgba(255, 255, 255, 0.1); border-radius: 999px; padding: 2px 10px;
  }
  .apgo-cart-gift-modal .apgo-gift-picker.is-complete .apgo-gift-picker__counter {
    background: linear-gradient(135deg, #f6dfa4, #d9b25f); color: #1a1206;
  }
  .apgo-cart-gift-modal .apgo-gift-picker__grid { display: flex; flex-direction: column; gap: 8px; }
  .apgo-cart-gift-modal .apgo-gift-card {
    position: relative; display: flex; flex-direction: row; align-items: center; gap: 12px;
    padding: 8px 42px 8px 8px; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 12px;
    background: rgba(255, 255, 255, 0.03); color: #fff; cursor: pointer; text-align: left;
    transition: border-color .15s ease, background .15s ease; -webkit-tap-highlight-color: transparent;
  }
  .apgo-cart-gift-modal .apgo-gift-card:hover:not(.is-disabled):not(.is-soldout) { border-color: rgba(255, 255, 255, 0.32); }
  .apgo-cart-gift-modal .apgo-gift-card__img {
    flex: 0 0 56px; width: 56px; height: 56px; object-fit: contain; border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
  }
  .apgo-cart-gift-modal .apgo-gift-card__title {
    flex: 1 1 auto; min-width: 0; font-size: 12px; line-height: 1.3; color: rgba(255, 255, 255, 0.9);
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.6em;
  }
  .apgo-cart-gift-modal .apgo-gift-card__check {
    position: absolute; top: 50%; right: 12px; transform: translateY(-50%) scale(0.5);
    width: 22px; height: 22px; display: flex; align-items: center; justify-content: center;
    border-radius: 50%; border: 1.5px solid rgba(255, 255, 255, 0.25); color: #1a1206;
    opacity: 0; transition: opacity .12s ease, transform .12s ease;
  }
  .apgo-cart-gift-modal .apgo-gift-card.is-selected { border-color: #d9b25f; background: rgba(217, 178, 95, 0.1); }
  .apgo-cart-gift-modal .apgo-gift-card.is-selected .apgo-gift-card__check {
    opacity: 1; transform: translateY(-50%) scale(1);
    background: linear-gradient(135deg, #f6dfa4, #d9b25f); border-color: #d9b25f;
  }
  .apgo-cart-gift-modal .apgo-gift-card.is-disabled,
  .apgo-cart-gift-modal .apgo-gift-card.is-soldout { opacity: 0.4; cursor: not-allowed; }
  .apgo-cart-gift-modal .apgo-gift-card__soldout { font-size: 10px; font-weight: 700; color: #ff6b6b; text-transform: uppercase; }
  .apgo-cart-gift-modal .apgo-gift-picker__hint { display: none; }

  @media (min-width: 990px) {
    .apgo-cart-gift-modal { align-items: center; padding: 24px; }
    .apgo-cart-gift-modal__panel {
      max-width: 520px;
      border-radius: 20px;
      transform: translateY(14px) scale(0.97);
      opacity: 0;
      transition: transform .24s ease, opacity .24s ease;
    }
    .apgo-cart-gift-modal.is-open .apgo-cart-gift-modal__panel { transform: translateY(0) scale(1); opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .apgo-cart-gift-modal, .apgo-cart-gift-modal__panel { transition: none; }
  }
</style>
