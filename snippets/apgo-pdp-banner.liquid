{%- doc -%}
  Banner under the buy box on APGO product pages. Product banner blocks select
  the products and markets where each banner appears. The first matching block
  with an image wins.

  Rendered at the end of .apgo-cc-pdp__buy-col (sections/apgo_product_page_v3.liquid):
  on desktop that is inside the right-hand buy card, under Add to cart / Buy
  now (outside the card the grid would push it below the taller gallery);
  on phones the inline buttons are hidden, so it sits under the delivery
  line, above Description.

  Also on the laundry template (sections/apgo-mobile-pdp.liquid, tone
  'light'): under the shipping card, at the bottom of the right column on
  desktop and above the description on phones, in that page's cream and
  ink colours.

  Left out where its link would be hidden: a page on the Malaysia-only list
  (snippets/apgo-market-only-pages.liquid), or a product the shopper's market
  can't buy (all_products is empty for it there), e.g. the Malaysian clearance
  bundle for Singapore shoppers.

  @param {string} [tone] - 'light' for the cream laundry page; default dark.
  @param {array} [banner_blocks] - Section blocks containing product banners.
  @param {product} product - Current product.
{%- enddoc -%}
{%- liquid
  assign apgo_pdp_banner = blank
  assign apgo_pdp_banner_link = blank
  assign apgo_pdp_banner_cta = blank
  assign apgo_pdp_banner_alt = blank
  assign apgo_pdp_banner_block = blank
  assign apgo_pdp_banner_market_code = localization.country.iso_code

  for apgo_pdp_banner_candidate in banner_blocks
    if apgo_pdp_banner_candidate.type == 'product_banner'
      assign apgo_pdp_banner_market_allowed = false
      case apgo_pdp_banner_candidate.settings.market
        when 'my'
          if apgo_pdp_banner_market_code == 'MY'
            assign apgo_pdp_banner_market_allowed = true
          endif
        when 'sg'
          if apgo_pdp_banner_market_code == 'SG'
            assign apgo_pdp_banner_market_allowed = true
          endif
        else
          assign apgo_pdp_banner_market_allowed = true
      endcase

      if apgo_pdp_banner_market_allowed and apgo_pdp_banner_candidate.settings.products.size > 0
        assign apgo_pdp_banner_product_matches = false
        for apgo_pdp_banner_product in apgo_pdp_banner_candidate.settings.products
          if apgo_pdp_banner_product.id == product.id
            assign apgo_pdp_banner_product_matches = true
            break
          endif
        endfor

        if apgo_pdp_banner_product_matches
          assign apgo_pdp_banner_candidate_image = apgo_pdp_banner_candidate.settings.image
          if apgo_pdp_banner_market_code == 'SG' and apgo_pdp_banner_candidate.settings.image_sg != blank
            assign apgo_pdp_banner_candidate_image = apgo_pdp_banner_candidate.settings.image_sg
          endif

          if apgo_pdp_banner_candidate_image != blank
            assign apgo_pdp_banner = apgo_pdp_banner_candidate_image
            assign apgo_pdp_banner_link = apgo_pdp_banner_candidate.settings.link
            assign apgo_pdp_banner_cta = apgo_pdp_banner_candidate.settings.cta
            assign apgo_pdp_banner_alt = apgo_pdp_banner_candidate.settings.alt
            if apgo_pdp_banner_market_code == 'SG'
              if apgo_pdp_banner_candidate.settings.link_sg != blank
                assign apgo_pdp_banner_link = apgo_pdp_banner_candidate.settings.link_sg
              endif
              if apgo_pdp_banner_candidate.settings.cta_sg != blank
                assign apgo_pdp_banner_cta = apgo_pdp_banner_candidate.settings.cta_sg
              endif
              if apgo_pdp_banner_candidate.settings.alt_sg != blank
                assign apgo_pdp_banner_alt = apgo_pdp_banner_candidate.settings.alt_sg
              endif
            endif
            assign apgo_pdp_banner_block = apgo_pdp_banner_candidate
            break
          endif
        endif
      endif
    endif
  endfor

  if apgo_pdp_banner != blank and apgo_pdp_banner_link != blank
    capture apgo_pdp_banner_market
      render 'apgo-market-only-pages', part: 'check', url: apgo_pdp_banner_link
    endcapture
    if apgo_pdp_banner_market contains 'hidden'
      assign apgo_pdp_banner = blank
    endif
  endif

  if apgo_pdp_banner != blank and apgo_pdp_banner_link contains '/products/'
    assign apgo_pdp_banner_handle = apgo_pdp_banner_link | split: '/products/' | last | split: '?' | first | split: '#' | first
    assign apgo_pdp_banner_target = all_products[apgo_pdp_banner_handle]
    if apgo_pdp_banner_target == blank or apgo_pdp_banner_target.id == blank
      assign apgo_pdp_banner = blank
    endif
  endif
-%}
{%- if apgo_pdp_banner != blank -%}
  {%- assign apgo_pdp_banner_alt = apgo_pdp_banner_alt | default: apgo_pdp_banner.alt -%}
  {%- assign apgo_pdp_banner_cta = apgo_pdp_banner_cta | strip -%}
  <div class="apgo-pdp-banner{% if tone == 'light' %} apgo-pdp-banner--light{% endif %}"{% if apgo_pdp_banner_block != blank %} {{ apgo_pdp_banner_block.shopify_attributes }}{% endif %}>
    {%- if apgo_pdp_banner_link != blank -%}
      <a class="apgo-pdp-banner__link" href="{{ apgo_pdp_banner_link }}">
    {%- else -%}
      <div class="apgo-pdp-banner__link apgo-pdp-banner__link--static">
    {%- endif -%}
    {{ apgo_pdp_banner
      | image_url: width: 1200
      | image_tag:
        class: 'apgo-pdp-banner__img',
        widths: '400, 600, 800, 1200',
        sizes: '(min-width: 1024px) 480px, calc(100vw - 32px)',
        loading: 'lazy',
        alt: apgo_pdp_banner_alt
    }}
    {%- if apgo_pdp_banner_link != blank -%}
      {%- if apgo_pdp_banner_cta != blank -%}
        <span class="apgo-pdp-banner__cta">
          <span class="apgo-pdp-banner__cta-text">{{ apgo_pdp_banner_cta | escape }}</span>
          <span class="apgo-pdp-banner__cta-arrow" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </span>
      {%- endif -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}
  </div>
  <style>
    .apgo-pdp-banner { margin-top: 16px; }
    .apgo-pdp-banner__link {
      display: block;
      overflow: hidden;
      border: 1px solid rgba(240, 132, 24, 0.35);
      border-radius: 12px;
      background: #141414;
      color: #f08418;
      text-decoration: none;
      transition: border-color .2s ease;
    }
    .apgo-pdp-banner__img {
      display: block;
      width: 100%;
      height: auto;
      transition: transform .3s ease;
    }
    .apgo-pdp-banner__cta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 12px 10px 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: 0.02em;
      line-height: 1.2;
    }
    .apgo-pdp-banner__cta-arrow {
      display: inline-grid;
      flex: 0 0 auto;
      place-items: center;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #f08418;
      color: #0b0b0b;
      transition: transform .2s ease;
    }
    a.apgo-pdp-banner__link:hover { border-color: rgba(240, 132, 24, 0.75); }
    a.apgo-pdp-banner__link:hover .apgo-pdp-banner__img { transform: scale(1.02); }
    a.apgo-pdp-banner__link:hover .apgo-pdp-banner__cta-arrow { transform: translateX(3px); }
    a.apgo-pdp-banner__link:focus-visible { outline: 2px solid #f08418; outline-offset: 3px; }
    /* Laundry page (cream): its own tokens from assets/apgo-pdp.css. */
    .apgo-pdp-banner--light .apgo-pdp-banner__link {
      border-color: var(--apgo-line, rgba(94, 111, 93, 0.15));
      background: var(--apgo-bg-alt, #fdfaf2);
      color: var(--apgo-ink, #2d2e28);
    }
    .apgo-pdp-banner--light a.apgo-pdp-banner__link:hover { border-color: var(--apgo-sage, #5e6f5d); }
    .apgo-pdp-banner--light .apgo-pdp-banner__cta { border-top-color: var(--apgo-line, rgba(94, 111, 93, 0.15)); }
    .apgo-pdp-banner--light .apgo-pdp-banner__cta-arrow {
      background: var(--apgo-ink, #2d2e28);
      color: var(--apgo-bg, #f6f1e7);
    }
    .apgo-pdp-banner--light a.apgo-pdp-banner__link:focus-visible { outline-color: var(--apgo-ink, #2d2e28); }
    @media (prefers-reduced-motion: reduce) {
      .apgo-pdp-banner__img,
      .apgo-pdp-banner__cta-arrow { transition: none; }
    }
  </style>
{%- endif -%}
