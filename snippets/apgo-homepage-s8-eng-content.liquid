<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>APGO Brand Story</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-orange: #f08418;
            --text-white: #ffffff;
            --text-gray: #cccccc;
            --dark-bg: #000000;
        }

        body {
            font-family: 'Arial', 'Microsoft JhengHei', sans-serif;
            background: var(--dark-bg);
            color: var(--text-white);
        }

        /* Brand story main section */
        .brand-story-section {
            background: #000000;
            padding: 100px 0;
            position: relative;
            overflow: visible;
        }

        /* Background decorative effects */
        .brand-story-section::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(240, 132, 24, 0.05) 0%, transparent 70%);
            animation: pulse 4s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
            50% { transform: translate(-50%, -50%) scale(1.2); opacity: 0.8; }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            position: relative;
            z-index: 1;
        }

        /* Title area — revealed via IntersectionObserver */
        .story-header {
            text-align: center;
            margin-bottom: 80px;
            opacity: 0;
            transform: translateY(28px);
            transition: opacity 0.85s ease, transform 0.85s ease;
        }

        .story-header.is-visible {
            opacity: 1;
            transform: translateY(0);
        }

        .story-title {
            font-size: 3rem;
            font-weight: bold;
            margin-bottom: 20px;
            background: linear-gradient(45deg, #f08418, #ff9a3c);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .story-subtitle {
            font-size: 1.2rem;
            color: var(--text-gray);
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.6;
        }

        /* Timeline — snake / zig-zag track (desktop) */
        .timeline {
            position: relative;
            max-width: 1120px;
            margin: 0 auto;
            padding: 20px 0 40px;
        }

        .timeline--snake {
            max-width: 1120px;
        }

        /* Desktop: no central spine (mobile restores ::before below) */
        .timeline--snake::before {
            display: none;
        }

        .timeline-row {
            position: relative;
            display: flex;
            align-items: stretch;
            gap: 0;
            padding: clamp(1.75rem, 4.5vmin, 3.25rem) 0;
            z-index: 0;
        }

        .timeline-row--ltr:first-of-type {
            margin-bottom: clamp(0.5rem, 2vmin, 1.25rem);
        }

        .timeline-row--rtl {
            flex-direction: row-reverse;
            margin-bottom: clamp(0.5rem, 2vmin, 1.25rem);
        }

        .timeline-row--ltr.timeline-row--short {
            margin-bottom: 0;
        }

        .timeline-row--short .timeline-item {
            flex: 1 1 0;
            max-width: 50%;
        }

        .timeline-item {
            position: relative;
            flex: 1 1 0;
            min-width: 0;
            padding: 0 4px;
            z-index: 1;
            opacity: 0;
            transition: opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .timeline-item--slide-right {
            --slide-x: -40px;
        }

        .timeline-item--slide-left {
            --slide-x: 40px;
        }

        @media (min-width: 769px) {
            .timeline-item:not(.is-visible) {
                transform: translate3d(var(--slide-x, -40px), 0, 0);
            }

            .timeline-item.is-visible {
                opacity: 1;
                transform: translate3d(0, 0, 0);
            }
        }

        @media (max-width: 768px) {
            .timeline-item:not(.is-visible) {
                transform: translate3d(0, 22px, 0);
            }

            .timeline-item.is-visible {
                opacity: 1;
                transform: translate3d(0, 0, 0);
            }
        }

        /* Per-segment track strip + chevron joints */
        .timeline-item::before {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            height: 92px;
            background: #0a0a0a;
            z-index: 0;
            pointer-events: none;
            box-shadow:
                inset 0 2px 0 rgba(240, 132, 24, 0.65),
                inset 0 -2px 0 rgba(255, 154, 60, 0.4),
                0 0 22px rgba(240, 132, 24, 0.12);
        }

        .timeline-row--ltr .timeline-item:only-child::before,
        .timeline-row--ltr .timeline-item:first-child:last-child::before {
            clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%);
        }

        .timeline-row--ltr .timeline-item:first-child:not(:only-child)::before {
            clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%);
        }

        .timeline-row--ltr .timeline-item:not(:first-child):not(:last-child)::before {
            clip-path: polygon(16px 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 16px 100%, 0 50%);
        }

        .timeline-row--ltr .timeline-item:last-child:not(:only-child)::before {
            clip-path: polygon(16px 0, 100% 0, 100% 100%, 16px 100%, 0 50%);
        }

        .timeline-row--rtl .timeline-item:first-child:not(:only-child)::before {
            clip-path: polygon(16px 0, 100% 0, 100% 100%, 16px 100%, 0 50%);
        }

        .timeline-row--rtl .timeline-item:not(:first-child):not(:last-child)::before {
            clip-path: polygon(0 50%, 16px 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 16px 100%);
        }

        .timeline-row--rtl .timeline-item:last-child:not(:only-child)::before {
            clip-path: polygon(0 0, calc(100% - 16px) 0, 100% 50%, calc(100% - 16px) 100%, 0 100%);
        }

        /* U-turn: anchored to source card (desktop); height set by --curve-h via JS */
        .timeline-curve-bridge {
            display: none;
            position: absolute;
            z-index: 0;
            pointer-events: none;
            overflow: visible;
        }

        .timeline-curve-bridge svg {
            display: block;
            width: 100%;
            height: 100%;
        }

        .timeline-curve-bridge--right {
            right: 0;
            top: 50%;
            width: clamp(72px, 11vw, 128px);
            height: var(--curve-h, clamp(5rem, 18vmin, 12rem));
            transform: translateY(0);
        }

        .timeline-curve-bridge--left {
            left: 0;
            top: 50%;
            width: clamp(72px, 11vw, 128px);
            height: var(--curve-h, clamp(5rem, 18vmin, 12rem));
            transform: translateY(0);
        }

        .timeline-curve-bridge__stroke {
            fill: none;
            stroke: #0a0a0a;
            stroke-width: 14;
            stroke-linecap: round;
            stroke-linejoin: round;
            vector-effect: non-scaling-stroke;
        }

        .timeline-curve-bridge__glow {
            fill: none;
            stroke: rgba(240, 132, 24, 0.5);
            stroke-width: 5;
            stroke-linecap: round;
            vector-effect: non-scaling-stroke;
        }

        /*
         * 節點 3→4：第一列第三欄 → 第二列第一欄（DOM；row-reverse 後 2017 在視覺右側，軌道起點在右）。
         * 節點 6→7：第二列第三欄 → 第三列第一欄。
         * .timeline-item 分屬不同 .timeline-row，無法用單一父層的 nth-child(3)+(4) 一次選到，故以「列 + 欄」組合。
         */
        @media (min-width: 769px) {
            .timeline-row--ltr:first-of-type > .timeline-item:nth-child(3) .timeline-curve-bridge,
            .timeline-row--rtl > .timeline-item:nth-child(3) .timeline-curve-bridge {
                display: block;
            }
        }

        /* Checkered + orange endcaps (desktop) */
        .timeline-endcap {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 22px;
            height: 92px;
            z-index: 4;
            pointer-events: none;
            border-radius: 2px;
            background: repeating-conic-gradient(#1a1a1a 0% 25%, #eaeaea 0% 50%) 50% / 10px 10px;
            box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.35);
        }

        .timeline-endcap--start {
            left: -6px;
            margin-left: -22px;
        }

        .timeline-endcap--finish {
            right: -6px;
            margin-right: -22px;
        }

        .timeline-endcap--start::before,
        .timeline-endcap--finish::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            width: 3px;
            border-radius: 2px;
            background: linear-gradient(180deg, #ff9a3c, var(--primary-orange), #c45f0a);
        }

        .timeline-endcap--start::before {
            left: -8px;
        }

        .timeline-endcap--finish::after {
            right: -8px;
        }

        /* Content cards */
        .timeline-content {
            position: relative;
            width: 100%;
            max-width: 100%;
            margin: 0 auto;
            padding: 26px 22px;
            background: radial-gradient(circle at top right, rgba(240, 132, 24, 0.1), rgba(0, 0, 0, 0.9) 56%);
            border-radius: 18px;
            border: 1px solid rgba(240, 132, 24, 0.34);
            box-shadow: 0 0 24px rgba(240, 132, 24, 0.18);
            transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
            z-index: 2;
        }

        /* Hover effects */
        .timeline-content:hover {
            transform: translateY(-4px) scale(1.015);
            box-shadow: 0 0 34px rgba(240, 132, 24, 0.32);
            border-color: rgba(240, 132, 24, 0.7);
        }

        /* Timeline dot — mobile only */
        .timeline-dot {
            position: absolute;
            top: 36px;
            left: 50%;
            transform: translateX(-50%);
            width: 24px;
            height: 24px;
            background: var(--primary-orange);
            border: 4px solid var(--dark-bg);
            border-radius: 50%;
            box-shadow: 0 0 30px rgba(240, 132, 24, 0.6);
            z-index: 2;
            animation: glow 2s ease-in-out infinite;
            display: none;
        }

        @keyframes glow {
            0%, 100% { box-shadow: 0 0 30px rgba(240, 132, 24, 0.6); }
            50% { box-shadow: 0 0 50px rgba(240, 132, 24, 0.9); }
        }

        /* Year titles */
        .timeline-year {
            font-size: 2rem;
            font-weight: bold;
            color: var(--primary-orange);
            margin-bottom: 15px;
            position: relative;
            display: inline-block;
        }

        /* Year decorations */
        .timeline-year::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 50px;
            height: 3px;
            background: linear-gradient(90deg, var(--primary-orange), transparent);
            border-radius: 2px;
        }

        /* Milestone titles */
        .milestone-title {
            font-size: 1.3rem;
            font-weight: bold;
            color: var(--text-white);
            margin-bottom: 12px;
        }

        /* Description text */
        .timeline-text {
            color: var(--text-gray);
            line-height: 1.8;
            font-size: 1rem;
        }

        /* Icons */
        .timeline-icon {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 2rem;
            opacity: 0.3;
        }

        @keyframes fadeIn {
            to { opacity: 1; }
        }

        /* Bottom decorative line */
        .decorative-line {
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--primary-orange), transparent);
            margin: 80px auto 0;
            opacity: 0;
            animation: fadeIn 1s ease 1.2s forwards;
        }

        @media (min-width: 769px) {
            .timeline--snake {
                padding-left: 28px;
                padding-right: 28px;
            }
        }

        /* Responsive design */
        @media (max-width: 768px) {
            .brand-story-section {
                padding: 60px 0;
            }

            .story-title {
                font-size: 2rem;
            }

            .story-subtitle {
                font-size: 1rem;
                padding: 0 20px;
            }

            .timeline--snake::before {
                display: block;
                content: '';
                position: absolute;
                top: 0;
                left: 40px;
                transform: none;
                width: 3px;
                height: 100%;
                background: linear-gradient(to bottom,
                    transparent 0%,
                    var(--primary-orange) 18%,
                    #ff9a3c 82%,
                    transparent 100%
                );
            }

            .timeline-row,
            .timeline-row--rtl {
                flex-direction: column;
                padding: 0;
            }

            .timeline-row--short .timeline-item {
                max-width: none;
            }

            .timeline-endcap {
                display: none;
            }

            .timeline-item::before {
                display: none !important;
            }

            .timeline-item {
                flex: none;
                width: 100%;
                padding: 28px 0 0;
            }

            .timeline-content {
                width: calc(100% - 80px);
                margin-left: 80px !important;
                margin-right: 0 !important;
                padding: 25px;
            }

            .timeline-dot {
                display: block;
                left: 40px;
                top: 42px;
            }

            .timeline-year {
                font-size: 1.5rem;
            }

            .milestone-title {
                font-size: 1.1rem;
            }

            .timeline-text {
                font-size: 0.9rem;
            }

            .timeline-icon {
                display: none;
            }
        }

        @media (max-width: 480px) {
            .timeline--snake::before {
                left: 30px;
            }

            .timeline-content {
                width: calc(100% - 60px);
                margin-left: 60px !important;
                padding: 20px;
            }

            .timeline-dot {
                left: 30px;
                width: 20px;
                height: 20px;
            }
        }
    </style>
</head>
<body>
    <section class="brand-story-section">
        <div class="container">
            <!-- Title Area -->
            <div class="story-header">
                <h2 class="story-title">APGO Brand Story</h2>
                <p class="story-subtitle">From electronics manufacturing leader to coating brand pioneer - 17 years of innovation</p>
            </div>

            <!-- Timeline: snake track (desktop) → vertical list (mobile) -->
            <div class="timeline timeline--snake">
                <div class="timeline-row timeline-row--ltr">
                    <div class="timeline-item timeline-item--slide-right">
                        <span class="timeline-endcap timeline-endcap--start" aria-hidden="true"></span>
                        <div class="timeline-content">
                            <span class="timeline-icon">💻</span>
                            <div class="timeline-year">2007</div>
                            <h3 class="milestone-title">Electronics Development Foundation</h3>
                            <p class="timeline-text">
                                Started with electronics development and dashcam OEM manufacturing. The founder accumulated ten years of R&amp;D and manufacturing experience, becoming the driving force behind Taiwan's major well-known brands, establishing the foundation of quality dedication.
                            </p>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                    <div class="timeline-item timeline-item--slide-right">
                        <div class="timeline-content">
                            <span class="timeline-icon">🏭</span>
                            <div class="timeline-year">2011</div>
                            <h3 class="milestone-title">Established Dashcam Factory</h3>
                            <p class="timeline-text">
                                Built professional factory with ISO9001 certification, providing one-stop service from design to production. Gained favor from major manufacturers like ADATA, Sampo, Asustek, and Patriot, even undertaking orders from Singapore's Ministry of Defense.
                            </p>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                    <div class="timeline-item timeline-item--slide-right">
                        <div class="timeline-content">
                            <span class="timeline-icon">🚗</span>
                            <div class="timeline-year">2014</div>
                            <h3 class="milestone-title">Developed First Generation Car Wash Coating</h3>
                            <p class="timeline-text">
                                From a car enthusiast's perspective, the founder began developing car wash coating products. Hoping to enable everyone to care for their beloved cars themselves, experience the joy of DIY, and stop wasting money unnecessarily.
                            </p>
                        </div>
                        <div class="timeline-curve-bridge timeline-curve-bridge--right" aria-hidden="true">
                            <svg viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
                                <path class="timeline-curve-bridge__stroke" d="M 86 0 Q 118 50 86 100" />
                                <path class="timeline-curve-bridge__glow" d="M 86 0 Q 118 50 86 100" />
                            </svg>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                </div>

                <div class="timeline-row timeline-row--rtl">
                    <div class="timeline-item timeline-item--slide-left">
                        <div class="timeline-content">
                            <span class="timeline-icon">🚀</span>
                            <div class="timeline-year">2017</div>
                            <h3 class="milestone-title">APGO Brand Born</h3>
                            <p class="timeline-text">
                                APGO was officially born named after the founder! Adhering to the strict standards of electronics manufacturing, all production materials and processes undergo rigorous quality control, aspiring to become Taiwan's largest coating production factory.
                            </p>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                    <div class="timeline-item timeline-item--slide-left">
                        <div class="timeline-content">
                            <span class="timeline-icon">🌏</span>
                            <div class="timeline-year">2019</div>
                            <h3 class="milestone-title">Entered International Markets</h3>
                            <p class="timeline-text">
                                First generation water coating officially launched, while establishing Malaysian company to expand into Southeast Asian markets. From Taiwan to the world, letting more people experience APGO's quality products.
                            </p>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                    <div class="timeline-item timeline-item--slide-left">
                        <div class="timeline-content">
                            <span class="timeline-icon">⭐</span>
                            <div class="timeline-year">2021</div>
                            <h3 class="milestone-title">Complete Product Upgrade</h3>
                            <p class="timeline-text">
                                Second generation atomic coating series fully upgraded, adding preparation work and interior care series. Same year established Singapore company and received strong recommendations from famous KOLs Cool and Joeman.
                            </p>
                        </div>
                        <div class="timeline-curve-bridge timeline-curve-bridge--left" aria-hidden="true">
                            <svg viewBox="0 0 100 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg" focusable="false">
                                <path class="timeline-curve-bridge__stroke" d="M 14 0 Q -18 50 14 100" />
                                <path class="timeline-curve-bridge__glow" d="M 14 0 Q -18 50 14 100" />
                            </svg>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                </div>

                <div class="timeline-row timeline-row--ltr timeline-row--short">
                    <div class="timeline-item timeline-item--slide-right">
                        <div class="timeline-content">
                            <span class="timeline-icon">🏆</span>
                            <div class="timeline-year">2022</div>
                            <h3 class="milestone-title">Media Recognition &amp; Endorsement</h3>
                            <p class="timeline-text">
                                Famous automotive show host Liao Ying-ting strongly recommended, and famous KOL Liao Lao-da collaborated to launch atomic glaze. Brand influence continues to expand, becoming a leading brand in the automotive beauty industry.
                            </p>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                    <div class="timeline-item timeline-item--slide-right">
                        <div class="timeline-content">
                            <span class="timeline-icon">🚀</span>
                            <div class="timeline-year">2024</div>
                            <h3 class="milestone-title">Sales Milestone</h3>
                            <p class="timeline-text">
                                Annual sales exceeded 50,000 sets, becoming a well-known coating brand in Southeast Asia. From novice housewives to professional coating enthusiasts, everyone can easily get started, bringing automotive beauty into every household.
                            </p>
                        </div>
                        <span class="timeline-endcap timeline-endcap--finish" aria-hidden="true"></span>
                        <div class="timeline-dot"></div>
                    </div>
                </div>
            </div>

            <!-- Decorative Line -->
            <div class="decorative-line"></div>
        </div>
    </section>

    <script>
        function debounce(fn, wait) {
            let t;
            return function () {
                clearTimeout(t);
                t = setTimeout(fn, wait);
            };
        }

        function layoutTimelineCurveBridges() {
            var mq = window.matchMedia('(min-width: 769px)');
            var pairs = [
                [
                    '.timeline-row--ltr:first-of-type > .timeline-item:nth-child(3)',
                    '.timeline-row--rtl > .timeline-item:nth-child(1)'
                ],
                [
                    '.timeline-row--rtl > .timeline-item:nth-child(3)',
                    '.timeline-row--ltr.timeline-row--short > .timeline-item:nth-child(1)'
                ]
            ];
            document.querySelectorAll('.timeline-curve-bridge').forEach(function (b) {
                b.style.removeProperty('--curve-h');
            });
            if (!mq.matches) return;
            pairs.forEach(function (pair) {
                var src = document.querySelector(pair[0]);
                var tgt = document.querySelector(pair[1]);
                var bridge = src ? src.querySelector('.timeline-curve-bridge') : null;
                if (!src || !tgt || !bridge) return;
                var rs = src.getBoundingClientRect();
                var rt = tgt.getBoundingClientRect();
                var midYs = rs.top + rs.height / 2;
                var midYt = rt.top + rt.height / 2;
                var h = Math.max(48, midYt - midYs);
                bridge.style.setProperty('--curve-h', h + 'px');
            });
        }

        const observerOptions = {
            threshold: 0.2,
            rootMargin: '0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                    requestAnimationFrame(layoutTimelineCurveBridges);
                }
            });
        }, observerOptions);

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.timeline-item, .story-header').forEach(el => {
                observer.observe(el);
            });
            var onResize = debounce(layoutTimelineCurveBridges, 100);
            window.addEventListener('resize', onResize);
            requestAnimationFrame(layoutTimelineCurveBridges);
            setTimeout(layoutTimelineCurveBridges, 400);
            var tl = document.querySelector('.timeline--snake');
            if (tl && typeof ResizeObserver !== 'undefined') {
                new ResizeObserver(function () {
                    requestAnimationFrame(layoutTimelineCurveBridges);
                }).observe(tl);
            }
        });

        // Parallax scrolling effect
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            const section = document.querySelector('.brand-story-section');
            
            if (section) {
                const rect = section.getBoundingClientRect();
                if (rect.top < window.innerHeight && rect.bottom > 0) {
                    const parallaxSpeed = 0.3;
                    const yPos = -(scrolled * parallaxSpeed);
                    section.style.backgroundPosition = `center ${yPos}px`;
                }
            }
        });
    </script>
</body>
</html>