<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>APGO Brand Story</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-orange: #f08418;
            --text-white: #ffffff;
            --text-gray: #cccccc;
            --dark-bg: #000000;
        }

        body {
            font-family: 'Arial', 'Microsoft JhengHei', sans-serif;
            background: var(--dark-bg);
            color: var(--text-white);
        }

        /* Brand story main section */
        .brand-story-section {
            background: #000000;
            padding: 100px 0;
            position: relative;
            overflow: visible;
        }

        /* Background decorative effects */
        .brand-story-section::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(240, 132, 24, 0.05) 0%, transparent 70%);
            animation: pulse 4s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }
            50% { transform: translate(-50%, -50%) scale(1.2); opacity: 0.8; }
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
            position: relative;
            z-index: 1;
        }

        /* Title area — revealed via IntersectionObserver */
        .story-header {
            text-align: center;
            margin-bottom: 80px;
            opacity: 0;
            transform: translateY(28px);
            transition: opacity 0.85s ease, transform 0.85s ease;
        }

        .story-header.is-visible {
            opacity: 1;
            transform: translateY(0);
        }

        .story-title {
            font-size: 3rem;
            font-weight: bold;
            margin-bottom: 20px;
            background: linear-gradient(45deg, #f08418, #ff9a3c);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .story-subtitle {
            font-size: 1.2rem;
            color: var(--text-gray);
            max-width: 600px;
            margin: 0 auto;
            line-height: 1.6;
        }

        /* Timeline — 3 / 3 / 2 卡片；桌面賽道為獨立半透明底層 SVG */
        .timeline {
            position: relative;
            max-width: 1120px;
            margin: 0 auto;
            padding: 20px 0 40px;
        }

        .timeline--snake {
            max-width: 1120px;
        }

        .timeline--snake::before {
            display: none;
        }

        .timeline-track-layer {
            display: none;
            position: absolute;
            inset: 0;
            z-index: 0;
            pointer-events: none;
        }

        .timeline-track-svg {
            display: block;
            width: 100%;
            height: 100%;
            overflow: visible;
        }

        .timeline-track-svg .track-main {
            fill: none;
            stroke: rgba(14, 14, 18, 0.48);
            stroke-width: 28;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .timeline-track-svg .track-edge {
            fill: none;
            stroke: rgba(240, 132, 24, 0.38);
            stroke-width: 7;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .timeline-row {
            position: relative;
            display: flex;
            align-items: stretch;
            gap: 0;
            padding: clamp(1.75rem, 4.5vmin, 3.25rem) 0;
            z-index: 1;
        }

        .timeline-row--ltr:first-of-type {
            margin-bottom: clamp(0.5rem, 2vmin, 1.25rem);
        }

        .timeline-row--rtl {
            flex-direction: row-reverse;
            margin-bottom: clamp(0.5rem, 2vmin, 1.25rem);
        }

        .timeline-row--ltr.timeline-row--short {
            margin-bottom: 0;
        }

        .timeline-row--short .timeline-item {
            flex: 1 1 0;
            max-width: 50%;
        }

        .timeline-item {
            position: relative;
            flex: 1 1 0;
            min-width: 0;
            padding: 0 4px;
            z-index: 1;
            opacity: 0;
            transition: opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .timeline-item--slide-right {
            --slide-x: -40px;
        }

        .timeline-item--slide-left {
            --slide-x: 40px;
        }

        @media (min-width: 769px) {
            .timeline-item:not(.is-visible) {
                transform: translate3d(var(--slide-x, -40px), 0, 0);
            }

            .timeline-item.is-visible {
                opacity: 1;
                transform: translate3d(0, 0, 0);
            }

            .timeline-track-layer {
                display: block;
            }

            .timeline-item::before {
                display: none !important;
            }
        }

        @media (max-width: 768px) {
            .timeline-item:not(.is-visible) {
                transform: translate3d(0, 22px, 0);
            }

            .timeline-item.is-visible {
                opacity: 1;
                transform: translate3d(0, 0, 0);
            }
        }

        /* Checkered + orange endcaps (desktop) */
        .timeline-endcap {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 22px;
            height: 92px;
            z-index: 4;
            pointer-events: none;
            border-radius: 2px;
            background: repeating-conic-gradient(#1a1a1a 0% 25%, #eaeaea 0% 50%) 50% / 10px 10px;
            box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.35);
        }

        .timeline-endcap--start {
            left: -6px;
            margin-left: -22px;
        }

        .timeline-endcap--finish {
            right: -6px;
            margin-right: -22px;
        }

        .timeline-endcap--start::before,
        .timeline-endcap--finish::after {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            width: 3px;
            border-radius: 2px;
            background: linear-gradient(180deg, #ff9a3c, var(--primary-orange), #c45f0a);
        }

        .timeline-endcap--start::before {
            left: -8px;
        }

        .timeline-endcap--finish::after {
            right: -8px;
        }

        /* Content cards — 略透明 + 模糊，讓底層賽道透出 */
        .timeline-content {
            position: relative;
            width: 100%;
            max-width: 100%;
            margin: 0 auto;
            padding: 26px 22px;
            background: radial-gradient(circle at top right, rgba(240, 132, 24, 0.14), rgba(0, 0, 0, 0.72) 58%);
            border-radius: 18px;
            border: 1px solid rgba(240, 132, 24, 0.34);
            box-shadow: 0 0 24px rgba(240, 132, 24, 0.18);
            transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
            z-index: 2;
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }

        /* Hover effects */
        .timeline-content:hover {
            transform: translateY(-4px) scale(1.015);
            box-shadow: 0 0 34px rgba(240, 132, 24, 0.32);
            border-color: rgba(240, 132, 24, 0.7);
        }

        /* Timeline dot — mobile only */
        .timeline-dot {
            position: absolute;
            top: 36px;
            left: 50%;
            transform: translateX(-50%);
            width: 24px;
            height: 24px;
            background: var(--primary-orange);
            border: 4px solid var(--dark-bg);
            border-radius: 50%;
            box-shadow: 0 0 30px rgba(240, 132, 24, 0.6);
            z-index: 2;
            animation: glow 2s ease-in-out infinite;
            display: none;
        }

        @keyframes glow {
            0%, 100% { box-shadow: 0 0 30px rgba(240, 132, 24, 0.6); }
            50% { box-shadow: 0 0 50px rgba(240, 132, 24, 0.9); }
        }

        /* Year titles */
        .timeline-year {
            font-size: 2rem;
            font-weight: bold;
            color: var(--primary-orange);
            margin-bottom: 15px;
            position: relative;
            display: inline-block;
        }

        /* Year decorations */
        .timeline-year::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 50px;
            height: 3px;
            background: linear-gradient(90deg, var(--primary-orange), transparent);
            border-radius: 2px;
        }

        /* Milestone titles */
        .milestone-title {
            font-size: 1.3rem;
            font-weight: bold;
            color: var(--text-white);
            margin-bottom: 12px;
        }

        /* Description text */
        .timeline-text {
            color: var(--text-gray);
            line-height: 1.8;
            font-size: 1rem;
        }

        /* Icons */
        .timeline-icon {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 2rem;
            opacity: 0.3;
        }

        @keyframes fadeIn {
            to { opacity: 1; }
        }

        /* Bottom decorative line */
        .decorative-line {
            width: 100px;
            height: 2px;
            background: linear-gradient(90deg, transparent, var(--primary-orange), transparent);
            margin: 80px auto 0;
            opacity: 0;
            animation: fadeIn 1s ease 1.2s forwards;
        }

        @media (min-width: 769px) {
            .timeline--snake {
                padding-left: 28px;
                padding-right: 28px;
            }
        }

        /* Responsive design */
        @media (max-width: 768px) {
            .brand-story-section {
                padding: 60px 0;
            }

            .story-title {
                font-size: 2rem;
            }

            .story-subtitle {
                font-size: 1rem;
                padding: 0 20px;
            }

            .timeline--snake::before {
                display: block;
                content: '';
                position: absolute;
                top: 0;
                left: 40px;
                transform: none;
                width: 3px;
                height: 100%;
                background: linear-gradient(to bottom,
                    transparent 0%,
                    var(--primary-orange) 18%,
                    #ff9a3c 82%,
                    transparent 100%
                );
            }

            .timeline-row,
            .timeline-row--rtl {
                flex-direction: column;
                padding: 0;
            }

            .timeline-row--short .timeline-item {
                max-width: none;
            }

            .timeline-endcap {
                display: none;
            }

            .timeline-item::before {
                display: none !important;
            }

            .timeline-item {
                flex: none;
                width: 100%;
                padding: 28px 0 0;
            }

            .timeline-content {
                width: calc(100% - 80px);
                margin-left: 80px !important;
                margin-right: 0 !important;
                padding: 25px;
            }

            .timeline-dot {
                display: block;
                left: 40px;
                top: 42px;
            }

            .timeline-year {
                font-size: 1.5rem;
            }

            .milestone-title {
                font-size: 1.1rem;
            }

            .timeline-text {
                font-size: 0.9rem;
            }

            .timeline-icon {
                display: none;
            }
        }

        @media (max-width: 480px) {
            .timeline--snake::before {
                left: 30px;
            }

            .timeline-content {
                width: calc(100% - 60px);
                margin-left: 60px !important;
                padding: 20px;
            }

            .timeline-dot {
                left: 30px;
                width: 20px;
                height: 20px;
            }
        }
    </style>
</head>
<body>
    <section class="brand-story-section">
        <div class="container">
            <!-- Title Area -->
            <div class="story-header">
                <h2 class="story-title">APGO Brand Story</h2>
                <p class="story-subtitle">From electronics manufacturing leader to coating brand pioneer - 17 years of innovation</p>
            </div>

            <!-- Timeline: 3+3+2 卡片；桌面賽道為底層半透明 SVG，與卡片分層 -->
            <div class="timeline timeline--snake">
                <div class="timeline-track-layer" aria-hidden="true">
                    <svg class="timeline-track-svg" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                        <path id="timelineTrackEdge" class="track-edge" d=""></path>
                        <path id="timelineTrackMain" class="track-main" d=""></path>
                    </svg>
                </div>
                <div class="timeline-row timeline-row--ltr">
                    <div class="timeline-item timeline-item--slide-right">
                        <span class="timeline-endcap timeline-endcap--start" aria-hidden="true"></span>
                        <div class="timeline-content">
                            <span class="timeline-icon">💻</span>
                            <div class="timeline-year">2007</div>
                            <h3 class="milestone-title">Electronics Development Foundation</h3>
                            <p class="timeline-text">
                                Started with electronics development and dashcam OEM manufacturing. The founder accumulated ten years of R&amp;D and manufacturing experience, becoming the driving force behind Taiwan's major well-known brands, establishing the foundation of quality dedication.
                            </p>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                    <div class="timeline-item timeline-item--slide-right">
                        <div class="timeline-content">
                            <span class="timeline-icon">🏭</span>
                            <div class="timeline-year">2011</div>
                            <h3 class="milestone-title">Established Dashcam Factory</h3>
                            <p class="timeline-text">
                                Built professional factory with ISO9001 certification, providing one-stop service from design to production. Gained favor from major manufacturers like ADATA, Sampo, Asustek, and Patriot, even undertaking orders from Singapore's Ministry of Defense.
                            </p>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                    <div class="timeline-item timeline-item--slide-right">
                        <div class="timeline-content">
                            <span class="timeline-icon">🚗</span>
                            <div class="timeline-year">2014</div>
                            <h3 class="milestone-title">Developed First Generation Car Wash Coating</h3>
                            <p class="timeline-text">
                                From a car enthusiast's perspective, the founder began developing car wash coating products. Hoping to enable everyone to care for their beloved cars themselves, experience the joy of DIY, and stop wasting money unnecessarily.
                            </p>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                </div>

                <div class="timeline-row timeline-row--rtl">
                    <div class="timeline-item timeline-item--slide-left">
                        <div class="timeline-content">
                            <span class="timeline-icon">🚀</span>
                            <div class="timeline-year">2017</div>
                            <h3 class="milestone-title">APGO Brand Born</h3>
                            <p class="timeline-text">
                                APGO was officially born named after the founder! Adhering to the strict standards of electronics manufacturing, all production materials and processes undergo rigorous quality control, aspiring to become Taiwan's largest coating production factory.
                            </p>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                    <div class="timeline-item timeline-item--slide-left">
                        <div class="timeline-content">
                            <span class="timeline-icon">🌏</span>
                            <div class="timeline-year">2019</div>
                            <h3 class="milestone-title">Entered International Markets</h3>
                            <p class="timeline-text">
                                First generation water coating officially launched, while establishing Malaysian company to expand into Southeast Asian markets. From Taiwan to the world, letting more people experience APGO's quality products.
                            </p>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                    <div class="timeline-item timeline-item--slide-left">
                        <div class="timeline-content">
                            <span class="timeline-icon">⭐</span>
                            <div class="timeline-year">2021</div>
                            <h3 class="milestone-title">Complete Product Upgrade</h3>
                            <p class="timeline-text">
                                Second generation atomic coating series fully upgraded, adding preparation work and interior care series. Same year established Singapore company and received strong recommendations from famous KOLs Cool and Joeman.
                            </p>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                </div>

                <div class="timeline-row timeline-row--ltr timeline-row--short">
                    <div class="timeline-item timeline-item--slide-right">
                        <div class="timeline-content">
                            <span class="timeline-icon">🏆</span>
                            <div class="timeline-year">2022</div>
                            <h3 class="milestone-title">Media Recognition &amp; Endorsement</h3>
                            <p class="timeline-text">
                                Famous automotive show host Liao Ying-ting strongly recommended, and famous KOL Liao Lao-da collaborated to launch atomic glaze. Brand influence continues to expand, becoming a leading brand in the automotive beauty industry.
                            </p>
                        </div>
                        <div class="timeline-dot"></div>
                    </div>
                    <div class="timeline-item timeline-item--slide-right">
                        <div class="timeline-content">
                            <span class="timeline-icon">🚀</span>
                            <div class="timeline-year">2024</div>
                            <h3 class="milestone-title">Sales Milestone</h3>
                            <p class="timeline-text">
                                Annual sales exceeded 50,000 sets, becoming a well-known coating brand in Southeast Asia. From novice housewives to professional coating enthusiasts, everyone can easily get started, bringing automotive beauty into every household.
                            </p>
                        </div>
                        <span class="timeline-endcap timeline-endcap--finish" aria-hidden="true"></span>
                        <div class="timeline-dot"></div>
                    </div>
                </div>
            </div>

            <!-- Decorative Line -->
            <div class="decorative-line"></div>
        </div>
    </section>

    <script>
        function debounce(fn, wait) {
            let t;
            return function () {
                clearTimeout(t);
                t = setTimeout(fn, wait);
            };
        }

        function layoutTimelineTrackPath() {
            var root = document.querySelector('.timeline--snake');
            var pathMain = document.getElementById('timelineTrackMain');
            var pathEdge = document.getElementById('timelineTrackEdge');
            var svg = root ? root.querySelector('.timeline-track-svg') : null;
            if (!root || !pathMain || !pathEdge || !svg) return;
            if (window.innerWidth < 769) {
                pathMain.setAttribute('d', '');
                pathEdge.setAttribute('d', '');
                svg.removeAttribute('viewBox');
                return;
            }
            var r0 = root.getBoundingClientRect();
            function box(el) {
                if (!el) return null;
                var r = el.getBoundingClientRect();
                return {
                    left: r.left - r0.left,
                    right: r.right - r0.left,
                    top: r.top - r0.top,
                    bottom: r.bottom - r0.top,
                    width: r.width,
                    height: r.height,
                    cx: r.left - r0.left + r.width / 2,
                    cy: r.top - r0.top + r.height / 2
                };
            }
            var row1 = root.querySelector('.timeline-row--ltr:first-of-type');
            var row2 = root.querySelector('.timeline-row--rtl');
            var row3 = root.querySelector('.timeline-row--short');
            if (!row1 || !row2 || !row3 || row1.children.length < 3 || row2.children.length < 3 || row3.children.length < 2) {
                return;
            }
            var rr1 = row1.getBoundingClientRect();
            var rr2 = row2.getBoundingClientRect();
            var rr3 = row3.getBoundingClientRect();
            var w = Math.max(1, root.offsetWidth);
            var h = Math.max(1, root.offsetHeight);
            svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);
            svg.setAttribute('width', '100%');
            svg.setAttribute('height', String(h));

            var y1 = rr1.top - r0.top + rr1.height * 0.4;
            var y2 = rr2.top - r0.top + rr2.height * 0.4;
            var y3 = rr3.top - r0.top + rr3.height * 0.4;

            var A1 = box(row1.children[0]);
            var A3 = box(row1.children[2]);
            var B1 = box(row2.children[0]);
            var B2 = box(row2.children[1]);
            var B3 = box(row2.children[2]);
            var C1 = box(row3.children[0]);
            var C2 = box(row3.children[1]);
            if (!A1 || !A3 || !B1 || !B2 || !B3 || !C1 || !C2) return;

            var xStart = A1.left + 14;
            var bend1x = A3.left + A3.width * 0.56;
            var dropX = A3.right + 6;
            var dropY = A3.bottom + Math.max(16, (rr2.top - rr1.bottom) * 0.35);
            var entryY4 = B1.top + B1.height * 0.11;
            var joinX = B1.cx;

            var bend2x = B3.left + B3.width * 0.48;
            var drop2X = B3.left - 8;
            var drop2Y = B3.bottom + Math.max(16, (rr3.top - rr2.bottom) * 0.35);
            var entryY7 = C1.top + C1.height * 0.11;

            var d = 'M ' + xStart + ' ' + y1;
            d += ' L ' + bend1x + ' ' + y1;
            d += ' C ' + (bend1x + (dropX - bend1x) * 0.55) + ' ' + (y1 + (dropY - y1) * 0.28) + ' ' + (dropX - 2) + ' ' + (y1 + (dropY - y1) * 0.68) + ' ' + dropX + ' ' + dropY;
            d += ' C ' + (dropX + 36) + ' ' + ((dropY + entryY4) * 0.52) + ' ' + (joinX + 52) + ' ' + (entryY4 - 4) + ' ' + joinX + ' ' + entryY4;
            d += ' L ' + joinX + ' ' + y2;
            d += ' L ' + B2.cx + ' ' + y2;
            d += ' L ' + bend2x + ' ' + y2;
            d += ' C ' + (bend2x - (bend2x - drop2X) * 0.5) + ' ' + (y2 + (drop2Y - y2) * 0.28) + ' ' + (drop2X + 4) + ' ' + (y2 + (drop2Y - y2) * 0.68) + ' ' + drop2X + ' ' + drop2Y;
            d += ' C ' + (drop2X - 40) + ' ' + ((drop2Y + entryY7) * 0.52) + ' ' + (C1.cx - 48) + ' ' + (entryY7 - 4) + ' ' + C1.cx + ' ' + entryY7;
            d += ' L ' + C1.cx + ' ' + y3;
            d += ' L ' + (C2.right - 12) + ' ' + y3;

            pathMain.setAttribute('d', d);
            pathEdge.setAttribute('d', d);
        }

        const observerOptions = {
            threshold: 0.2,
            rootMargin: '0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                    requestAnimationFrame(layoutTimelineTrackPath);
                }
            });
        }, observerOptions);

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.timeline-item, .story-header').forEach(el => {
                observer.observe(el);
            });
            var onResize = debounce(layoutTimelineTrackPath, 100);
            window.addEventListener('resize', onResize);
            requestAnimationFrame(layoutTimelineTrackPath);
            setTimeout(layoutTimelineTrackPath, 400);
            var tl = document.querySelector('.timeline--snake');
            if (tl && typeof ResizeObserver !== 'undefined') {
                new ResizeObserver(function () {
                    requestAnimationFrame(layoutTimelineTrackPath);
                }).observe(tl);
            }
        });

        // Parallax scrolling effect
        window.addEventListener('scroll', () => {
            const scrolled = window.pageYOffset;
            const section = document.querySelector('.brand-story-section');
            
            if (section) {
                const rect = section.getBoundingClientRect();
                if (rect.top < window.innerHeight && rect.bottom > 0) {
                    const parallaxSpeed = 0.3;
                    const yPos = -(scrolled * parallaxSpeed);
                    section.style.backgroundPosition = `center ${yPos}px`;
                }
            }
        });
    </script>
</body>
</html>