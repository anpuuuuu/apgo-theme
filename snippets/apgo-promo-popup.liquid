{%- comment -%}
  Free-gift promo card + draggable reminder bubble (v3 PDP).

  NOT a modal. Most traffic here lands straight from an ad, so the page
  itself is the thing they came to see — the card docks top-centre just
  under the header, leaves the page fully readable and fully clickable,
  and never dims or locks anything behind it.

  Evergreen countdown: the deadline is set on the visitor's FIRST view
  and kept in localStorage, so returning to the page continues the same
  countdown instead of restarting it. Once it lapses the card still
  appears — only the clock is removed. The gift is granted by the
  discount app either way, so the message stays true; we just stop
  claiming urgency (a timer that resets forever is a false-urgency
  claim, and repeat visitors are exactly the people who would notice).

  Accepts:
    heading   {string}  - bold line inside the card
    subtext   {string}  - small line under the gift name
    gift_image {image}  - gift product image
    gift_name {string}  - gift product name
    gift_value {string} - e.g. "Worth RM15"
    cta       {string}  - button label
    hours     {number}  - countdown length (default 2)
    end_at    {string}  - optional real campaign end, e.g. "2026-08-31"
    bubble_label {string} - accessible name for the floating bubble
{%- endcomment -%}

{%- liquid
  assign pp_hours = hours | default: 2 | plus: 0
  if pp_hours < 1
    assign pp_hours = 2
  endif
-%}

{%- comment -%}
  Optional real campaign end (shared by everyone). When set, it caps the
  evergreen window and ends the promo for good once passed.
{%- endcomment -%}
{%- assign pp_end_ts = 0 -%}
{%- if end_at != blank -%}
  {%- assign pp_end_ts = end_at | date: '%s' | plus: 0 | times: 1000 -%}
{%- endif -%}

<div
  class="apgo-promo-popup"
  data-apgo-promo-popup
  data-promo-key="apgo-promo-{{ product.id }}"
  data-promo-hours="{{ pp_hours }}"
  {% if pp_end_ts > 0 %}data-promo-end-ts="{{ pp_end_ts }}"{% endif %}
  role="dialog"
  aria-label="{{ heading | default: 'Free gift offer' | escape }}"
  aria-hidden="true"
  hidden
>
  <button type="button" class="apgo-promo-popup__close" data-apgo-promo-close aria-label="Close">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </button>

  {%- if gift_image != blank -%}
    <div class="apgo-promo-popup__media">
      <img class="apgo-promo-popup__img" src="{{ gift_image | image_url: width: 320 }}" alt="{{ gift_name | default: 'Free gift' | escape }}" loading="lazy" width="160" height="160">
    </div>
  {%- endif -%}

  <div class="apgo-promo-popup__body">
    <div class="apgo-promo-popup__tags">
      <span class="apgo-promo-popup__ribbon">
        <svg class="apgo-promo-popup__ribbon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/>
          <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
        </svg>
        <span>Free gift</span>
      </span>
      {%- if gift_value != blank -%}
        <span class="apgo-promo-popup__value">{{ gift_value }}</span>
      {%- endif -%}
    </div>

    {%- if heading != blank -%}
      <p class="apgo-promo-popup__heading">{{ heading }}</p>
    {%- endif -%}
    {%- if gift_name != blank -%}
      <p class="apgo-promo-popup__gift">{{ gift_name }}</p>
    {%- endif -%}
    {%- if subtext != blank -%}
      <p class="apgo-promo-popup__sub">{{ subtext }}</p>
    {%- endif -%}

    <div class="apgo-promo-popup__foot">
      {%- comment -%}
        JS adds .is-timerless to the card once the window has lapsed,
        which hides this chip — the offer stays, the deadline claim does
        not.
      {%- endcomment -%}
      <span class="apgo-promo-popup__timer" data-apgo-promo-timer>
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/></svg>
        <span class="apgo-promo-popup__timer-value" data-apgo-promo-clock>--:--:--</span>
      </span>
      <button type="button" class="apgo-promo-popup__cta" data-apgo-promo-cta>
        {{ cta | default: 'Shop now' }}
      </button>
    </div>
  </div>
</div>

{%- comment -%}
  Reminder bubble — appears after the card is dismissed. Draggable, and
  snaps flush to whichever side edge it is released nearest, so it always
  hugs the screen instead of floating loose over the content. Defaults to
  the LEFT edge because the right side already carries the chat widget
  and, on mobile, the sticky buy bar.
{%- endcomment -%}
<button
  type="button"
  class="apgo-promo-bubble"
  data-apgo-promo-bubble
  aria-label="{{ bubble_label | default: 'Free gift' | escape }}"
  hidden
>
  <span class="apgo-promo-bubble__dismiss" data-apgo-promo-bubble-dismiss role="button" tabindex="0" aria-label="Hide reminder">
    <svg viewBox="0 0 24 24" width="9" height="9" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </span>
  {%- comment -%}
    Gift-box SVG rather than the product photo: at this size a bottle
    shot is an unreadable blob, while the icon reads instantly as "a gift
    is waiting" and follows currentColor into the urgent state.
  {%- endcomment -%}
  <svg class="apgo-promo-bubble__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/>
    <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/>
  </svg>
  <span class="apgo-promo-bubble__clock" data-apgo-promo-bubble-clock></span>
</button>
