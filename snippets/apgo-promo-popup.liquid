{%- comment -%}
  Free-gift promo popup + draggable reminder bubble (v3 PDP).

  Shown on the gated product only. Evergreen countdown: the deadline is
  set on the visitor's FIRST view and kept in localStorage, so returning
  to the page continues the same countdown instead of restarting it.
  Once it lapses the popup, bubble and timer all stop appearing — the
  gift keeps being granted by the discount app, we simply stop claiming
  urgency (a timer that resets forever is a false-urgency claim).

  Accepts:
    heading   {string}  - popup heading
    subtext   {string}  - line under the gift name
    gift_image {image}  - gift product image
    gift_name {string}  - gift product name
    gift_value {string} - e.g. "Worth RM15"
    cta       {string}  - button label
    hours     {number}  - countdown length (default 12)
    bubble_label {string} - text inside the floating bubble
{%- endcomment -%}

{%- liquid
  assign pp_hours = hours | default: 12 | plus: 0
  if pp_hours < 1
    assign pp_hours = 12
  endif
-%}

<div
  class="apgo-promo-popup"
  data-apgo-promo-popup
  data-promo-key="apgo-promo-{{ product.id }}"
  data-promo-hours="{{ pp_hours }}"
  aria-hidden="true"
  hidden
>
  <div class="apgo-promo-popup__backdrop" data-apgo-promo-close></div>

  <div class="apgo-promo-popup__panel" role="dialog" aria-modal="true" aria-label="{{ heading | default: 'Free gift offer' | escape }}">
    <button type="button" class="apgo-promo-popup__close" data-apgo-promo-close aria-label="Close">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>

    <span class="apgo-promo-popup__badge">{{ 'FREE GIFT' }}</span>

    {%- if heading != blank -%}
      <h3 class="apgo-promo-popup__heading">{{ heading }}</h3>
    {%- endif -%}

    {%- if gift_image != blank -%}
      <img class="apgo-promo-popup__img" src="{{ gift_image | image_url: width: 520 }}" alt="{{ gift_name | default: 'Free gift' | escape }}" loading="lazy" width="240" height="240">
    {%- endif -%}

    {%- if gift_name != blank -%}
      <p class="apgo-promo-popup__gift">{{ gift_name }}</p>
    {%- endif -%}
    {%- if gift_value != blank -%}
      <p class="apgo-promo-popup__value">{{ gift_value }}</p>
    {%- endif -%}
    {%- if subtext != blank -%}
      <p class="apgo-promo-popup__sub">{{ subtext }}</p>
    {%- endif -%}

    <div class="apgo-promo-popup__timer" data-apgo-promo-timer>
      <span class="apgo-promo-popup__timer-label">Order within</span>
      <span class="apgo-promo-popup__timer-value" data-apgo-promo-clock>--:--:--</span>
    </div>

    <button type="button" class="apgo-promo-popup__cta" data-apgo-promo-cta>
      {{ cta | default: 'Shop now' }}
    </button>
  </div>
</div>

{%- comment -%}
  Reminder bubble — appears after the popup is dismissed. Draggable, kept
  inside the viewport, position remembered. Defaults to the LEFT side
  because the right edge already carries the chat widget and, on mobile,
  the sticky buy bar.
{%- endcomment -%}
<button
  type="button"
  class="apgo-promo-bubble"
  data-apgo-promo-bubble
  aria-label="{{ bubble_label | default: 'Free gift' | escape }}"
  hidden
>
  <span class="apgo-promo-bubble__dismiss" data-apgo-promo-bubble-dismiss role="button" tabindex="0" aria-label="Hide reminder">
    <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
  </span>
  {%- if gift_image != blank -%}
    <img class="apgo-promo-bubble__img" src="{{ gift_image | image_url: width: 160 }}" alt="" aria-hidden="true" loading="lazy" width="46" height="46">
  {%- else -%}
    <span class="apgo-promo-bubble__emoji" aria-hidden="true">🎁</span>
  {%- endif -%}
  <span class="apgo-promo-bubble__clock" data-apgo-promo-bubble-clock>--:--</span>
</button>
