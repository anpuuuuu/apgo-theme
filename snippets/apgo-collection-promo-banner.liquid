{%- doc -%}
  APGO Collection promo banner — a click-through card that surfaces the
  current GWP promo at the top of /collections/* pages.

  Layout:
    ┌──────────┬───────────────────────────────────────────┐
    │          │  Grab this deal now                       │
    │  IMG     │  and receive an additional FREE 300ml...  │
    │ (full)   │  [ View deal → ]  🔴 HURRY  03:54:21      │
    └──────────┴───────────────────────────────────────────┘

  Renders only when the configured promo product still exists. Clicking
  the card opens the product page. Countdown ticks down to 23:59 MY
  (GMT+8) and rolls over to the next day automatically.
{%- enddoc -%}

{%- comment -%}
  Banner content resolution — priority order:
    1. If we're on a PDP AND that product is in the promo list, use
       the CURRENT product (its own image + URL) so the banner shows
       the right thumbnail on every promo PDP. Headline / body may
       be overridden by product metafields.
    2. Otherwise (rendered from a collection page), use the global
       Customizer settings → apgo_promo_banner_product.
    3. Final fallback — the original Father's Day handle so nothing
       renders blank if the merchant hasn't configured anything yet.

  Per-product metafield overrides for headline / body / cta (set via
  Shopify Admin → Products → [product] → Metafields):
    custom.promo_banner_headline
    custom.promo_banner_body
    custom.promo_banner_cta
{%- endcomment -%}

{%- liquid
  assign promo_product = blank

  # 1. On a PDP: use the current product if the promo banner list contains it.
  if template.name == 'product' and product != blank
    assign promo_pdp_list = settings.apgo_promo_banner_pdp_products
    if promo_pdp_list != blank and promo_pdp_list.size > 0
      for p in promo_pdp_list
        if p.id == product.id
          assign promo_product = product
          break
        endif
      endfor
    endif
  endif

  # 2. Fallback to global Customizer product picker.
  if promo_product == blank
    assign promo_product = settings.apgo_promo_banner_product
  endif

  # 3. Final legacy fallback so nothing renders blank if merchant
  #    hasn't configured anything yet.
  if promo_product == blank or promo_product.handle == blank
    assign promo_product = all_products['fathers-day-aurora-coating-special-buy-1-free-1']
  endif

  assign promo_handle = promo_product.handle

  # Per-product metafield override for the text fields — falls through
  # to global Customizer settings, then hardcoded default.
  assign meta_headline = promo_product.metafields.custom.promo_banner_headline
  assign meta_body     = promo_product.metafields.custom.promo_banner_body
  assign meta_cta      = promo_product.metafields.custom.promo_banner_cta
  assign promo_headline = meta_headline | default: settings.apgo_promo_banner_headline | default: 'APGO BIRTHDAY EXCLUSIVE'
  assign promo_body     = meta_body     | default: settings.apgo_promo_banner_body     | default: 'Get a FREE 300ml shampoo when you grab this promo bundle.'
  assign promo_cta      = meta_cta      | default: settings.apgo_promo_banner_cta      | default: 'View deal'

  # Countdown gate — global Customizer toggle, then optional per-product
  # metafield override (custom.promo_banner_show_countdown, boolean OR
  # 'true'/'false' string). Handles both metafield definitions so admins
  # can pick whichever is easier.
  assign promo_show_countdown = settings.apgo_promo_banner_show_countdown
  assign meta_countdown = promo_product.metafields.custom.promo_banner_show_countdown
  if meta_countdown != blank
    if meta_countdown == true or meta_countdown == 'true'
      assign promo_show_countdown = true
    else
      assign promo_show_countdown = false
    endif
  endif
-%}
{%- assign promo_timer_label = 'Ends in' -%}
{%- comment -%} Banner uses a daily-recurring 24h countdown that rolls
   forward every midnight (MY GMT+8). Visibility is controlled solely by
   the Theme Settings toggle `apgo_promo_banner_enabled` — no metafield
   expiry, no fixed end date. {%- endcomment -%}
{%- assign promo_daily_end = '00:00' -%}
{%- comment -%}
  On the promo product's own PDP we hide the CTA button — clicking
  "View deal" to land on the same page is pointless. The countdown +
  copy still render so the urgency cue stays.
{%- endcomment -%}
{%- assign on_promo_pdp = false -%}
{%- if template.name == 'product' and product.handle == promo_handle -%}
  {%- assign on_promo_pdp = true -%}
{%- endif -%}
{%- if promo_product != blank and promo_product.handle != blank -%}
  <a class="apgo-promo-banner"
     href="{{ promo_product.url }}"
     aria-label="{{ promo_headline | escape }} — {{ promo_body | escape }}"
     data-apgo-promo-banner
     data-daily-end="{{ promo_daily_end }}"
     data-tz-offset="+08:00">
    {%- if promo_product.featured_image != blank -%}
      <span class="apgo-promo-banner__image-wrap">
        <img class="apgo-promo-banner__image"
             src="{{ promo_product.featured_image | image_url: width: 400 }}"
             alt=""
             loading="lazy">
      </span>
    {%- endif -%}
    <span class="apgo-promo-banner__body">
      <span class="apgo-promo-banner__headline">{{ promo_headline }}</span>
      <span class="apgo-promo-banner__sub">{{ promo_body }}</span>
      {%- if promo_show_countdown -%}
        <span class="apgo-promo-banner__action-row">
          <span class="apgo-promo-banner__pulse-dot" aria-hidden="true"></span>
          <span class="apgo-promo-banner__timer-label">{{ promo_timer_label }}</span>
          <span class="apgo-promo-banner__timer" data-apgo-promo-timer>--:--:--</span>
        </span>
      {%- endif -%}
    </span>
    {%- unless on_promo_pdp -%}
      <span class="apgo-promo-banner__cta-col">
        <span class="apgo-promo-banner__cta">
          {{ promo_cta }}
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/>
          </svg>
        </span>
      </span>
    {%- endunless -%}
  </a>

  <style>
    .apgo-promo-banner,
    .apgo-promo-banner * {
      font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif !important;
    }
    .apgo-promo-banner {
      display: flex;
      align-items: stretch;
      gap: 0;
      max-width: 1200px;
      margin: 16px auto 24px;
      padding: 0;
      border-radius: 16px;
      background: linear-gradient(135deg, #1a1a1a 0%, #0c0c0c 100%);
      border: 1px solid rgba(240, 132, 24, 0.22);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
      color: #fff;
      text-decoration: none;
      position: relative;
      overflow: hidden;
      transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    }
    /* Subtle red urgency pulse glow on the card border */
    .apgo-promo-banner::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 16px;
      pointer-events: none;
      box-shadow: 0 0 0 1px rgba(229, 57, 53, 0);
      animation: apgoPromoBannerGlow 2.4s ease-in-out infinite;
    }
    @keyframes apgoPromoBannerGlow {
      0%, 100% { box-shadow: 0 0 0 1px rgba(229, 57, 53, 0), 0 0 0 rgba(229, 57, 53, 0); }
      50%      { box-shadow: 0 0 0 1px rgba(229, 57, 53, 0.35), 0 0 24px rgba(229, 57, 53, 0.18); }
    }
    .apgo-promo-banner:hover {
      transform: translateY(-2px);
      border-color: rgba(240, 132, 24, 0.4);
      box-shadow: 0 10px 26px rgba(0, 0, 0, 0.55);
    }
    /* Image flush to the left edge — full poster visible (no crop) */
    .apgo-promo-banner__image-wrap {
      flex: 0 0 auto;
      width: 110px;
      align-self: stretch;
      background: #0a0a0a;
      overflow: hidden;
      position: relative;
      display: grid;
      place-items: center;
    }
    .apgo-promo-banner__image {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }
    .apgo-promo-banner__body {
      display: flex;
      flex-direction: column;
      gap: 4px;
      flex: 1 1 auto;
      min-width: 0;
      padding: 12px 14px;
    }
    .apgo-promo-banner__headline {
      font-size: 15px;
      font-weight: 800;
      color: #fff;
      line-height: 1.25;
      letter-spacing: 0.02em;
    }
    .apgo-promo-banner__sub {
      font-size: 12.5px;
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.4;
    }
    /* Right CTA column — its own grid cell, vertically centered */
    .apgo-promo-banner__cta-col {
      flex: 0 0 auto;
      display: grid;
      place-items: center;
      padding: 12px 2px 12px 0;
    }
    /* Bottom action row — red dot + ENDS IN + orange timer */
    .apgo-promo-banner__action-row {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 8px;
      flex-wrap: wrap;
    }
    .apgo-promo-banner__cta {
      flex: 0 0 auto;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 13px;
      border-radius: 999px;
      background: linear-gradient(45deg, #f08418, #ff9a3c);
      color: #fff;
      font-size: 12.5px;
      font-weight: 700;
      letter-spacing: 0.02em;
      box-shadow: 0 3px 10px rgba(240, 132, 24, 0.32);
      white-space: nowrap;
    }
    .apgo-promo-banner__cta svg { transition: transform .2s ease; }
    .apgo-promo-banner:hover .apgo-promo-banner__cta svg { transform: translateX(3px); }

    .apgo-promo-banner__pulse-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #e53935;
      box-shadow: 0 0 0 0 rgba(229, 57, 53, 0.6);
      animation: apgoPromoDotPulse 1.2s ease-out infinite;
    }
    @keyframes apgoPromoDotPulse {
      0%   { box-shadow: 0 0 0 0 rgba(229, 57, 53, 0.7); transform: scale(1); }
      70%  { box-shadow: 0 0 0 10px rgba(229, 57, 53, 0); transform: scale(1.15); }
      100% { box-shadow: 0 0 0 0 rgba(229, 57, 53, 0); transform: scale(1); }
    }
    .apgo-promo-banner__timer-label {
      font-size: 10px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.5);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }
    .apgo-promo-banner__timer {
      font-size: 14px;
      font-weight: 800;
      color: #ff9a3c;
      font-variant-numeric: tabular-nums;
      letter-spacing: 0.05em;
      text-shadow: 0 0 10px rgba(240, 132, 24, 0.4);
      animation: apgoPromoTimerTick 1s steps(2) infinite;
    }
    @keyframes apgoPromoTimerTick {
      0%, 100% { opacity: 1; }
      50%      { opacity: 0.78; }
    }

    @media (max-width: 749px) {
      .apgo-promo-banner {
        margin: 12px auto 16px;
        border-radius: 14px;
      }
      .apgo-promo-banner__image-wrap { width: 92px; }
      .apgo-promo-banner__cta-col { padding: 10px 2px 10px 0; }
      .apgo-promo-banner__body { padding: 10px 12px; gap: 3px; }
      .apgo-promo-banner__headline { font-size: 13px; }
      .apgo-promo-banner__sub { font-size: 11.5px; }
      .apgo-promo-banner__action-row { gap: 8px; margin-top: 6px; }
      .apgo-promo-banner__cta {
        padding: 6px 10px;
        font-size: 11px;
      }
      .apgo-promo-banner__pulse-dot { width: 7px; height: 7px; }
      .apgo-promo-banner__timer { font-size: 12.5px; }
      .apgo-promo-banner__timer-label { font-size: 9px; }
      /* Very narrow phones — drop CTA label, keep only the arrow icon */
      @media (max-width: 380px) {
        .apgo-promo-banner__timer-label { display: none; }
        .apgo-promo-banner__cta {
          font-size: 0;
          padding: 7px 9px;
          gap: 0;
        }
        .apgo-promo-banner__cta svg { width: 14px; height: 14px; }
      }
    }
  </style>

  <script>
  (function () {
    'use strict';
    var root = document.querySelector('[data-apgo-promo-banner]');
    if (!root) return;
    var timerEl = root.querySelector('[data-apgo-promo-timer]');
    if (!timerEl) return;

    /* Daily-recurring countdown to dailyEnd MY. Banner visibility is
       controlled by the Theme Settings toggle; the timer just keeps
       cycling so the urgency cue always feels fresh. */
    var dailyEnd = root.getAttribute('data-daily-end') || '23:59';
    var tz       = root.getAttribute('data-tz-offset') || '+08:00';

    function myTodayStr() {
      var now = new Date(Date.now() + 8 * 3600 * 1000);
      return now.getUTCFullYear() + '-' +
             String(now.getUTCMonth() + 1).padStart(2, '0') + '-' +
             String(now.getUTCDate()).padStart(2, '0');
    }
    function endOfDayMs(day) {
      var iso = day + 'T' + dailyEnd + ':00' + tz;
      var t = Date.parse(iso);
      if (t <= Date.now()) t += 24 * 3600 * 1000;
      return t;
    }

    var endMs = endOfDayMs(myTodayStr());

    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    function tick() {
      var diff = endMs - Date.now();
      if (diff <= 0) {
        /* Roll forward to next day's 23:59 MY */
        endMs = endOfDayMs(myTodayStr());
        diff = endMs - Date.now();
      }
      /* Render up to "Dd HH:MM:SS" when more than 24h, else HH:MM:SS */
      var totalSec = Math.floor(diff / 1000);
      var days  = Math.floor(totalSec / 86400);
      var h     = Math.floor((totalSec % 86400) / 3600);
      var m     = Math.floor((totalSec % 3600) / 60);
      var s     = totalSec % 60;
      timerEl.textContent = (days > 0 ? days + 'd ' : '') + pad(h) + ':' + pad(m) + ':' + pad(s);
    }
    tick();
    var timerId = setInterval(tick, 1000);
  })();
  </script>
{%- endif -%}
