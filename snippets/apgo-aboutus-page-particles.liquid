{% comment %}
  About Us 全頁（#MainContent 內兩個 section）共用一層橘色微粒背景，密度為原設計約一半（3 層 + 較大 tile）。
  微粒在 ::before 且 z-index:0；各 section 為 z-index:1。若內層再用不透明白/黑底蓋滿，粒子會被擋住，故強制兩段主內容外層透明，由 #MainContent 提供黑底。
{% endcomment %}
{% liquid
  assign apgo_aboutus_particles = false
  if request.page_type == 'page' and page.handle == 'about-us'
    assign apgo_aboutus_particles = true
  elsif template.name == 'page' and template.suffix == 'about-us'
    assign apgo_aboutus_particles = true
  endif
%}
{% if apgo_aboutus_particles %}
  <style id="apgo-aboutus-page-particles">
    #MainContent.apgo-aboutus-main-particles {
      position: relative;
      isolation: isolate;
      background: #000;
    }

    #MainContent.apgo-aboutus-main-particles::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      background-image:
        radial-gradient(circle, rgba(240, 132, 24, 0.68) 1.4px, transparent 2.6px),
        radial-gradient(circle, rgba(255, 170, 90, 0.5) 1.2px, transparent 2.4px),
      background-size:
        220px 340px,
        280px 400px,
        240px 360px;
      background-position:
        12% 118%,
        48% 128%,
        82% 122%;
      background-repeat: repeat;
      opacity: 0.88;
      animation: apgo-aboutus-particles-rise 88s linear infinite;
    }

    #MainContent.apgo-aboutus-main-particles > .shopify-section {
      position: relative;
      z-index: 1;
    }

    /* 外層改透明，粒子才看得到；卡片／影片區自有背景 */
    #MainContent.apgo-aboutus-main-particles .apgo-about-page,
    #MainContent.apgo-aboutus-main-particles .brand-story-section {
      background: transparent !important;
    }

    /* custom-liquid 等區塊的色塊底層，會蓋住 MainContent::before，需關掉 */
    #MainContent.apgo-aboutus-main-particles .shopify-section .section-background {
      opacity: 0 !important;
      pointer-events: none;
    }

    @keyframes apgo-aboutus-particles-rise {
      0% {
        background-position:
          12% 118%,
          48% 128%,
          82% 122%;
        opacity: 0.72;
      }
      50% {
        opacity: 0.95;
      }
      100% {
        background-position:
          12% -32%,
          48% -38%,
          82% -34%;
        opacity: 0.78;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #MainContent.apgo-aboutus-main-particles::before {
        animation: none;
        opacity: 0.28;
      }
    }
  </style>
{% endif %}
