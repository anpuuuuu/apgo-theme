{%- doc -%}
  Emits a small <script> tag that populates
  window.APGO_FREE_SHIPPING_LINE_LOOKUP with a {product_id: title} map
  of all currently-in-cart products carrying the 'free-shipping' tag,
  and window.apgoFreeShippingTitle(cart): the title to show in "You got
  free shipping with X", or null. The cart sections call that function
  with the live /cart.js cart instead of walking the lookup themselves.

  It also knows the bundle picker's sets (snippets/apgo-bundle-set-config:
  any 3 for RM99 in Malaysia, the 11.11 Value Bundle's any 4): when a
  set comes with free shipping, a cart holding a full set of that one
  product qualifies too (packs of different products don't add up). Pack
  counts come from the live cart, so changing a quantity on the cart page
  updates at once. Same rule as
  snippets/apgo-cart-free-shipping-product-title (server side).

  Idempotent — calling it from multiple cart sections is fine; the
  last one to run wins and the result is identical regardless. Each
  cart section that needs the dynamic tag-unlock check renders this
  so the global is guaranteed to exist on any cart-page layout
  (different stores include different cart sections).

  Inline script keeps the SSR + dynamic update layers in lockstep:
  whenever Shopify re-renders any cart section after an AJAX cart
  change, the new HTML carries an updated script tag, and the JS-side
  threshold logic picks up the fresh lookup on its next tick.
{%- enddoc -%}
<script data-apgo-free-shipping-lookup>
  window.APGO_FREE_SHIPPING_LINE_LOOKUP = {};
  {%- for line in cart.items -%}
    {%- if line.product.tags contains 'free-shipping' -%}
      window.APGO_FREE_SHIPPING_LINE_LOOKUP["{{ line.product.id }}"] = {{ line.product.title | json }};
    {%- endif -%}
  {%- endfor -%}
  {%- comment -%} Products whose set comes with free shipping: { id: { title, count } }. {%- endcomment -%}
  window.APGO_FREE_SHIPPING_SET = { ids: {} };
  {%- for line in cart.items -%}
    {%- capture apgo_fsl_cfg -%}{%- render 'apgo-bundle-set-config', product: line.product -%}{%- endcapture -%}
    {%- assign apgo_fsl_cfg = apgo_fsl_cfg | strip | split: '|' -%}
    {%- if apgo_fsl_cfg[3] == '1' -%}
      window.APGO_FREE_SHIPPING_SET.ids["{{ line.product.id }}"] = { title: {{ line.product.title | json }}, count: {{ apgo_fsl_cfg[1] | plus: 0 }} };
    {%- endif -%}
  {%- endfor -%}
  {%- comment -%} On the product page the product may not be in the cart yet. {%- endcomment -%}
  {%- if product -%}
    {%- capture apgo_fsl_cfg -%}{%- render 'apgo-bundle-set-config', product: product -%}{%- endcapture -%}
    {%- assign apgo_fsl_cfg = apgo_fsl_cfg | strip | split: '|' -%}
    {%- if apgo_fsl_cfg[3] == '1' -%}
      window.APGO_FREE_SHIPPING_SET.ids["{{ product.id }}"] = { title: {{ product.title | json }}, count: {{ apgo_fsl_cfg[1] | plus: 0 }} };
    {%- endif -%}
  {%- endif -%}
  window.apgoFreeShippingTitle = function (cart) {
    if (!cart || !Array.isArray(cart.items)) return null;
    var tags = window.APGO_FREE_SHIPPING_LINE_LOOKUP || {};
    var sets = (window.APGO_FREE_SHIPPING_SET && window.APGO_FREE_SHIPPING_SET.ids) || {};
    var packs = {};
    for (var i = 0; i < cart.items.length; i++) {
      var line = cart.items[i];
      if (tags[line.product_id]) return tags[line.product_id];
      var isGift = (line.properties && line.properties._free_gift === 'true') || Number(line.final_price) === 0;
      var set = sets[line.product_id];
      if (set && !isGift) {
        packs[line.product_id] = (packs[line.product_id] || 0) + (Number(line.quantity) || 0);
        if (packs[line.product_id] >= set.count) return set.title;
      }
    }
    return null;
  };
</script>
