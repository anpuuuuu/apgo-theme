{% doc %}
  Mobile checkout reassurance below the standalone cart totals.
  Desktop reassurance is rendered below the button in cart-cta.
{% enddoc %}
{%- unless cart == empty -%}
  <div class="apgo-cart-checkout-meta" aria-label="Checkout information">
    <p class="apgo-cart-checkout-meta__trust-title">{{ 'content.checkout_redirect_notice' | t }}</p>
    <ul class="apgo-cart-checkout-meta__trust" role="list">
      <li class="apgo-cart-checkout-meta__trust-item">
        <span class="apgo-cart-checkout-meta__trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </span>
        <span>256-bit SSL encrypted</span>
      </li>
      <li class="apgo-cart-checkout-meta__trust-sep" aria-hidden="true">·</li>
      <li class="apgo-cart-checkout-meta__trust-item">
        <span class="apgo-cart-checkout-meta__trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
        </span>
        <span>Secured by Shopify Payments</span>
      </li>
      <li class="apgo-cart-checkout-meta__trust-sep" aria-hidden="true">·</li>
      <li class="apgo-cart-checkout-meta__trust-item">
        <span class="apgo-cart-checkout-meta__trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </span>
        <span>Buyer protection &amp; easy returns</span>
      </li>
    </ul>
  </div>
{%- endunless -%}

{% stylesheet %}
  .apgo-cart-checkout-meta {
    display: none;
  }
  @media (max-width: 749px) {
    .apgo-cart-checkout-meta {
      display: block;
      margin-block: 16px 4px;
      font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif;
      text-align: center;
    }
    .apgo-cart-checkout-meta__trust-title {
      margin: 10px 0 6px;
      font-size: 12px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.85);
      text-align: center;
      line-height: 1.35;
    }
    .apgo-cart-checkout-meta__trust {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 4px 8px;
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: 10px;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.35;
      text-align: center;
    }
    .apgo-cart-checkout-meta__trust-item {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
    }
    .apgo-cart-checkout-meta__trust-icon {
      display: inline-flex;
      align-items: center;
      color: #f08418;
      flex-shrink: 0;
    }
    .apgo-cart-checkout-meta__trust-sep {
      color: rgba(255, 255, 255, 0.25);
      user-select: none;
    }
  }
{% endstylesheet %}
