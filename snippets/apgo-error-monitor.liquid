{%- comment -%}
  APGO Layer 3: frontend error monitor. Rendered at the very top of <head> so
  it can catch errors from every later script. Reports ONLY errors originating
  from this site's own assets (cdn.shopify.com/**/assets/* or same-origin
  inline) to the Cloudflare worker — third-party scripts, browser extensions
  and cross-origin "Script error." are dropped by design. Holds no credential.
  Endpoint is filled in after the worker's first deploy (docs:
  monitoring/docs/cloudflare-setup.md); until then the script exits instantly.
  Self-test: open any page with ?apgo_em_test=1 to emit one synthetic report.
{%- endcomment -%}
{%- unless request.design_mode -%}
<script>
!function(){try{
var EP='REPLACE_WITH_WORKER_URL';
if(EP.indexOf('REPLACE')>-1)return;
if(!window.addEventListener||!window.JSON)return;
if(/APGO-HealthCheck/.test(navigator.userAgent))return;
var MAX=5,n=0,mem={},sid;
try{sid=sessionStorage.getItem('apgoEmSid');if(!sid){sid=Math.random().toString(36).slice(2,10)+Date.now().toString(36);sessionStorage.setItem('apgoEmSid',sid);}}catch(e){sid='nostore-'+Math.random().toString(36).slice(2,8);}
function ownSrc(s){return !!s&&(s.indexOf(location.origin)===0||/cdn\.shopify\.com\/.+\/assets\//.test(s));}
function ownStack(st){return !!st&&(st.indexOf(location.host)>-1||/cdn\.shopify\.com\/.+\/assets\//.test(st));}
function send(m,src,line,col,stack){try{
if(n>=MAX)return;
var key=m+'|'+src+'|'+line;
try{if(sessionStorage.getItem('apgoEm:'+key))return;sessionStorage.setItem('apgoEm:'+key,'1');}catch(e){if(mem[key])return;mem[key]=1;}
n++;
var p=JSON.stringify({v:1,sid:sid,m:String(m).slice(0,300),src:String(src||'').slice(0,300),line:line>0?line|0:0,col:col>0?col|0:0,stack:String(stack||'').slice(0,1000),url:String(location.href).split('?')[0]});
if(navigator.sendBeacon){navigator.sendBeacon(EP,new Blob([p],{type:'text/plain'}));}
else if(window.fetch){fetch(EP,{method:'POST',body:p,keepalive:true,headers:{'content-type':'text/plain'}}).catch(function(){});}
}catch(e){}}
window.addEventListener('error',function(e){try{
if(!e)return;
var m=e.message||'',f=e.filename||'';
if(!m||m==='Script error.'||m==='Script error')return;
if(/^(chrome|moz|safari|ms-browser)-extension:/.test(f))return;
if(!ownSrc(f))return;
send(m,f,e.lineno,e.colno,e.error&&e.error.stack);
}catch(x){}},true);
window.addEventListener('unhandledrejection',function(e){try{
var r=e&&e.reason,st=(r&&r.stack)||'';
if(!ownStack(st))return;
send('Unhandled rejection: '+String((r&&r.message)||r).slice(0,200),'',0,0,st);
}catch(x){}});
if(/[?&]apgo_em_test=1/.test(location.search)){send('apgo-em-selftest','selftest',1,1,'');}
window.__apgoEM=1;
}catch(e){}}();
</script>
{%- endunless -%}
