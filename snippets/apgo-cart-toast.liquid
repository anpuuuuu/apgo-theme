{% stylesheet %}
  .apgo-cart-toast {
    position: fixed;
    z-index: 100002;
    left: 50%;
    top: calc(10px + env(safe-area-inset-top, 0px));
    bottom: auto;
    max-width: min(280px, calc(100vw - 24px));
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(22, 22, 24, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(240, 132, 24, 0.1) inset;
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.3;
    text-align: center;
    font-family: var(--font-paragraph--family, inherit);
    transform: translate(-50%, -10px) scale(0.96);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .apgo-cart-toast[data-visible] {
    transform: translate(-50%, 0) scale(1);
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .apgo-cart-toast {
      transition: opacity 0.2s ease;
    }

    .apgo-cart-toast[data-visible] {
      transform: translate(-50%, 0) scale(1);
    }
  }

  /*
    Rich cart-success pill — duplicated here from
    assets/apgo-collection-variant-drawer.css so it's globally available for
    any page (PDP buybar, collection drawer, etc.) that wants to emit the
    same toast (checkmark + product name + View Cart + close).
  */
  .apgo-cart-success-toast {
    --apgo-toast-accent: #f08418;
    position: fixed;
    z-index: 100002;
    left: 50%;
    /* Sit below the sticky header + marquee stack. `--apgo-stack-h` is
       maintained by assets/apgo-scroll-hide.js and equals the live combined
       height of #header-group + the free-shipping marquee. Fallback 120px
       covers pages without that script. */
    top: calc(var(--apgo-stack-h, 120px) + 10px + env(safe-area-inset-top, 0px));
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: min(360px, calc(100vw - 24px));
    padding: 8px 10px 8px 12px;
    border-radius: 999px;
    background: rgba(22, 22, 24, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.45),
      0 0 0 1px rgba(240, 132, 24, 0.12) inset;
    color: #f4f4f5;
    font-family: var(--font-paragraph--family, inherit);
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -10px) scale(0.96);
    transition:
      opacity 0.32s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .apgo-cart-success-toast.apgo-cart-success-toast--visible {
    opacity: 1;
    transform: translate(-50%, 0) scale(1);
    pointer-events: auto;
  }
  .apgo-cart-success-toast__check {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, rgba(240, 132, 24, 0.95), rgba(255, 154, 60, 0.9));
    color: #fff;
    box-shadow: 0 2px 8px rgba(240, 132, 24, 0.35);
  }
  .apgo-cart-success-toast__check svg { display: block; }

  .apgo-cart-success-toast--error {
    --apgo-toast-accent: #ff5c64;
    border-color: rgba(255, 92, 100, 0.45);
  }

  .apgo-cart-success-toast--error .apgo-cart-success-toast__check {
    background: #ff5c64;
    color: #fff;
    font-weight: 800;
  }
  .apgo-cart-success-toast__body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
    line-height: 1.25;
  }
  .apgo-cart-success-toast__title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .apgo-cart-success-toast__sub {
    font-size: 0.6875rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .apgo-cart-success-toast__cta {
    flex-shrink: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--apgo-toast-accent);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(240, 132, 24, 0.12);
    border: 1px solid rgba(240, 132, 24, 0.35);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .apgo-cart-success-toast__cta:hover {
    background: rgba(240, 132, 24, 0.22);
    color: #ffb35c;
  }
  .apgo-cart-success-toast__close {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.55);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .apgo-cart-success-toast__close:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  @media (max-width: 480px) {
    .apgo-cart-success-toast {
      max-width: calc(100vw - 16px);
      padding: 7px 8px 7px 10px;
      gap: 8px;
    }
    .apgo-cart-success-toast__title { font-size: 0.75rem; }
    .apgo-cart-success-toast__sub { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .apgo-cart-success-toast { transition: opacity 0.2s ease; }
    .apgo-cart-success-toast.apgo-cart-success-toast--visible {
      transform: translate(-50%, 0) scale(1);
    }
  }
{% endstylesheet %}
