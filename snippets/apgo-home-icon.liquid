{%- doc -%}
  Line icons for the homepage (category tiles, arrows, WhatsApp).
  Drawn on a 24px grid with a round stroke, taken from the homepage
  design canvas so tiles match it one to one.

  @param {string} name - Icon name: book, home, drop, gift, bottle, bucket,
    target, seat, sponge, grid, arrow-right, chevron-left, chevron-right,
    chevron-down, whatsapp
  @param {number} [size] - Rendered width/height in px (default 24)
  @param {number} [stroke] - Stroke width (default 1.6)
  @param {string} [class] - Extra class names
{%- enddoc -%}
{%- liquid
  assign icon_size = size | default: 24
  assign icon_stroke = stroke | default: 1.6
-%}
<svg
  class="apgo-hp-icon{% if class != blank %} {{ class }}{% endif %}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="{{ icon_stroke }}"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case name -%}
    {%- when 'book' -%}
      <path d="M4 6.5c2.5-1 5-1 8 .5 3-1.5 5.5-1.5 8-.5V18c-2.5-1-5-1-8 .5-3-1.5-5.5-1.5-8-.5z"/><path d="M12 7v11.5"/>
    {%- when 'home' -%}
      <path d="M4 11l8-6 8 6v8a1 1 0 0 1-1 1h-4v-5h-6v5H5a1 1 0 0 1-1-1z"/>
    {%- when 'drop' -%}
      <path d="M12 3.5s-5.5 6.2-5.5 10a5.5 5.5 0 0 0 11 0c0-3.8-5.5-10-5.5-10z"/><path d="M9.5 14a2.5 2.5 0 0 0 2.5 2.5"/>
    {%- when 'gift' -%}
      <rect x="4" y="10" width="16" height="10" rx="1"/><path d="M3 7h18v3H3z"/><path d="M12 7v13"/><path d="M12 7c-1.5-3.5-5-4-5-1.5S10 7 12 7zM12 7c1.5-3.5 5-4 5-1.5S14 7 12 7z"/>
    {%- when 'bottle' -%}
      <path d="M9 8h5v3l2 2v7a1 1 0 0 1-1 1H8a1 1 0 0 1-1-1v-7l2-2z"/><path d="M10 8V5h4l3 2"/>
    {%- when 'bucket' -%}
      <path d="M5 9h14l-1.5 11h-11z"/><path d="M7 9a5 5 0 0 1 10 0"/>
    {%- when 'target' -%}
      <circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="7"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/>
    {%- when 'seat' -%}
      <path d="M8 4h5l1 8H9z"/><path d="M7 12h9l1 5H8z"/><path d="M9 17v3M16 17v3"/>
    {%- when 'sponge' -%}
      <path d="M5 6h14v12H5z"/><path d="M5 10h14M5 14h14"/>
    {%- when 'grid' -%}
      <rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>
    {%- when 'arrow-right' -%}
      <path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'chevron-left' -%}
      <path d="M15 6l-6 6 6 6"/>
    {%- when 'chevron-right' -%}
      <path d="M9 6l6 6-6 6"/>
    {%- when 'chevron-down' -%}
      <path d="M6 9l6 6 6-6"/>
    {%- when 'whatsapp' -%}
      <path d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5z"/>
  {%- endcase -%}
</svg>
