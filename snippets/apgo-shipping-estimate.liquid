{%- doc -%}
  Estimated shipping for the cart page, read off the store's weight-based
  rates (Settings → Shipping and delivery → General profile) so the cart
  quotes what checkout charges in West Malaysia and Singapore. East
  Malaysia's flat RM15.00 only applies once the shopper enters an address.

  Each tier is "grams:price" — the price, in the market currency's minor
  units, while the cart weighs less than those grams. Checkout adds the
  store's default package (Settings → Shipping and delivery → Packages:
  XS Box, 50 g) to the products' weight, so each limit here is the admin
  rate's top weight + 1 − 50 g: Singapore's "1.502–2.001 kg $3.80" ends at
  1952 g of products (checked 2026-11-07: a 2.000 kg cart paid $4.30, the
  2.002–2.501 kg rate). A cart under the lowest rate's weight still gets
  that rate (a 300 g Singapore cart paid $2.90). Past the last tier
  checkout offers no rate; the estimate keeps the top price.

  Update both lists whenever the rates or the default package change in
  the admin. Last checked against the admin (General profile) on
  2026-11-07: Singapore went down ($2.90 up to 1.001 kg … $16.80 up to
  17 kg) and West Malaysia gained RM2.90 for 0.1–0.15 kg.

  @param {string} [market] - 'MY' or 'SG': prints the estimate in minor units
  @param {number} [weight] - cart weight in grams (cart.total_weight)
  @param {boolean} [tiers_json] - prints the tiers as a JSON object keyed by currency, for the cart scripts
{%- enddoc -%}
{%- liquid
  assign tiers_myr = '101:290,1952:480,2952:650,3952:750,4952:850,8952:950,14952:1500'
  assign tiers_sgd = '952:290,1452:330,1952:380,2452:430,2952:480,3452:530,3952:580,4452:630,4952:680,5452:780,5952:830,6452:880,6952:930,7452:980,7952:1030,10452:1280,13452:1580,16951:1680'

  if tiers_json
    echo '{"MYR":"' | append: tiers_myr | append: '","SGD":"' | append: tiers_sgd | append: '"}'
  else
    assign tiers = '' | split: ','
    if market == 'MY'
      assign tiers = tiers_myr | split: ','
    elsif market == 'SG'
      assign tiers = tiers_sgd | split: ','
    endif
    assign grams = weight | default: 0
    assign estimate = 0
    for tier in tiers
      assign tier_parts = tier | split: ':'
      assign estimate = tier_parts[1] | plus: 0
      assign tier_below = tier_parts[0] | plus: 0
      if grams < tier_below
        break
      endif
    endfor
    echo estimate
  endif
-%}
