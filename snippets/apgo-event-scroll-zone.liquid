{%- doc -%}
  Horizontal-scroll zone — used by Discount and Buy-1-Free-1 zones on
  the APGO Birthday page. Renders heading → optional decorative banner
  image → a snap-scroll track of product cards (~2.5 cards visible at
  rest).

  Variant-aware data path. Pass card_blocks for fine-grained control
  (each block carries its own product + variant_id picked by the
  editor). Falls back to the legacy `products` array for backwards
  compatibility with pages still using the old product_list setting.

  @param {string} heading      - Zone heading text (e.g. "DISCOUNT DEALS")
  @param {image}  banner_image - Optional decorative banner image
  @param {object[]} card_blocks - Section blocks for this zone (preferred).
                                 Each block has settings.product +
                                 settings.variant_id.
  @param {object[]} products   - Legacy fallback: a flat product array.
                                 Used only when card_blocks is blank.
  @param {string} zone_class   - Modifier suffix added to the wrapper
                                 (used for analytics / per-zone CSS hooks)
  @param {boolean} hide_compare_at - When true, hides the compare-at price.
  @param {boolean} show_scroll_cue - Shows an animated hint and next button when the track overflows.
  @param {string} section_id   - Parent section id, used for unique card ids
{%- enddoc -%}

{%- liquid
  assign apgo_use_blocks = false
  if card_blocks != blank and card_blocks.size > 0
    assign apgo_use_blocks = true
  endif

  # Per-zone compare-at toggle — driven by the section setting passed
  # in via the `hide_compare_at` param (mapped from
  # discount_zone_hide_compare_at / b1f1_zone_hide_compare_at). Default
  # to false so a missing param shows compare-at like before.
  assign apgo_hide_compare = false
  if hide_compare_at == true
    assign apgo_hide_compare = true
  endif

  assign apgo_has_items = false
  if apgo_use_blocks
    for b in card_blocks
      if b.settings.product != blank
        assign apgo_has_items = true
        break
      endif
    endfor
  else
    if products != blank and products.size > 0
      assign apgo_has_items = true
    endif
  endif
-%}

{%- if apgo_has_items -%}
  <section class="apgo-event-scroll-zone apgo-event-scroll-zone--{{ zone_class }}">
    {%- if heading != blank -%}
      <h3 class="apgo-event-scroll-zone__heading">
        <span class="apgo-event-scroll-zone__heading-star" aria-hidden="true">★</span>
        {{ heading }}
        <span class="apgo-event-scroll-zone__heading-star" aria-hidden="true">★</span>
      </h3>
    {%- endif -%}
    {%- if banner_image != blank -%}
      <div class="apgo-event-scroll-zone__banner">
        <img
          class="apgo-event-scroll-zone__banner-img"
          src="{{ banner_image | image_url: width: 1600 }}"
          alt=""
          loading="lazy"
          width="{{ banner_image.width }}"
          height="{{ banner_image.height }}">
      </div>
    {%- endif -%}
    {%- if show_scroll_cue -%}
      <div class="apgo-event-scroll-zone__scroll-hint" data-apgo-scroll-hint aria-hidden="true">
        <span>{{ 'actions.swipe_to_see_more' | t }}</span>
        <span class="apgo-event-scroll-zone__scroll-chevrons" aria-hidden="true">››</span>
      </div>
    {%- endif -%}
    {%- if zone_class == 'discount' -%}
      <p class="apgo-event-scroll-zone__promo-limit">
        {{ 'apgo_event.product_limit_note' | t }}
      </p>
    {%- endif -%}
    <div class="apgo-event-scroll-zone__viewport" data-apgo-scroll-viewport>
      <div class="apgo-event-scroll-zone__track" role="list" data-apgo-scroll-track>
        {%- if apgo_use_blocks -%}
          {%- for block in card_blocks -%}
            {%- assign apgo_block_product = block.settings.product -%}
            {%- if apgo_block_product != blank -%}
              {%- assign apgo_event_card_uid = section_id | append: '-' | append: zone_class | append: '-' | append: block.id -%}
              <div class="apgo-event-scroll-zone__card" role="listitem" {{ block.shopify_attributes }}>
                {% render 'apgo-event-listing-card',
                  product: apgo_block_product,
                  variant_id: block.settings.variant_id,
                  section_id: section_id,
                  card_uid: apgo_event_card_uid,
                  hide_compare_at: apgo_hide_compare %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for product in products -%}
            {%- assign apgo_event_card_uid = section_id | append: '-' | append: zone_class | append: '-' | append: product.id -%}
            <div class="apgo-event-scroll-zone__card" role="listitem">
              {% render 'apgo-event-listing-card',
                product: product,
                section_id: section_id,
                card_uid: apgo_event_card_uid,
                hide_compare_at: apgo_hide_compare %}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      {%- if show_scroll_cue -%}
        <button
          class="apgo-event-scroll-zone__next"
          type="button"
          data-apgo-scroll-next
          aria-label="{{ 'accessibility.show_more_products' | t }}"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.4"/>
          </svg>
        </button>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}
