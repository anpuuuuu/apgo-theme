{%- doc -%}
  Semi-transparent reassurance toast that appears on mobile when the
  bottom buybar / select-option / variant-shell modal opens on the
  Hari Raya Haji Bundle PDP. Tells the user "✅ You're on the right
  page — clicking Add to cart will automatically include the FREE
  gift" so they don't worry they have to do anything extra.

  Mobile only (≤749px). Watches `.is-open` class on three possible
  containers and fires every time any of them opens. No auto-dismiss
  — user closes via the X button (or it disappears when the modal
  itself closes).
{%- enddoc -%}

<div class="apgo-gwp-buybar-hint" data-apgo-gwp-buybar-hint hidden role="status" aria-live="polite">
  <span class="apgo-gwp-buybar-hint__icon" aria-hidden="true">🎁</span>
  <span class="apgo-gwp-buybar-hint__text">
    <strong>You're on the right page.</strong>
    Click <em>Add to cart</em> and the FREE 300ml shampoo is added automatically.
  </span>
  <button type="button"
          class="apgo-gwp-buybar-hint__close"
          data-apgo-gwp-buybar-hint-close
          aria-label="Dismiss">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
</div>

<style>
  .apgo-gwp-buybar-hint {
    position: fixed;
    /* JS positions `top` dynamically to sit just above whichever modal
       panel is currently open. left/transform centers horizontally; the
       Y axis is overridden inline by the script. Fallback `top: 12px`
       handles the brief moment between show() and positionAboveModal()
       running. */
    top: 12px;
    left: 50%;
    transform: translate(-50%, 8px);
    z-index: 100200; /* above confirm-modal (z 100100) + buybar (z 100000) */
    /* Explicit width (not just max-width) so the flex container can't
       shrink-to-fit into a narrow column on mobile. */
    width: min(86vw, 340px);
    box-sizing: border-box;
    padding: 14px 40px 14px 16px;
    border-radius: 14px;
    background: rgba(20, 20, 20, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(240, 132, 24, 0.5);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55), 0 0 24px rgba(240, 132, 24, 0.12);
    color: #fff;
    font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif;
    font-size: 13px;
    line-height: 1.45;
    display: flex;
    align-items: flex-start;
    gap: 10px;
    opacity: 0;
    pointer-events: none;
    transition: opacity .28s ease, transform .35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .apgo-gwp-buybar-hint[hidden] { display: none !important; }
  .apgo-gwp-buybar-hint.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
    pointer-events: auto;
  }
  .apgo-gwp-buybar-hint__icon {
    font-size: 20px;
    line-height: 1;
    flex: 0 0 auto;
    margin-top: 1px;
  }
  .apgo-gwp-buybar-hint__text { flex: 1 1 auto; }
  .apgo-gwp-buybar-hint__text strong {
    color: #ff9a3c;
    font-weight: 700;
    display: block;
    margin-bottom: 2px;
    font-size: 12.5px;
    letter-spacing: 0.02em;
  }
  .apgo-gwp-buybar-hint__text em {
    font-style: normal;
    color: #ff9a3c;
    font-weight: 700;
  }
  /* Close X — top-right inside the toast */
  .apgo-gwp-buybar-hint__close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.85);
    border-radius: 999px;
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: background .15s ease, color .15s ease, transform .15s ease;
  }
  .apgo-gwp-buybar-hint__close:hover {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    transform: scale(1.08);
  }
  /* Mobile-only — hide on desktop where the buybar itself is hidden */
  @media (min-width: 750px) {
    .apgo-gwp-buybar-hint { display: none !important; }
  }
</style>

<script>
(function () {
  'use strict';
  var hint = document.querySelector('[data-apgo-gwp-buybar-hint]');
  if (!hint) return;
  var closeBtn = hint.querySelector('[data-apgo-gwp-buybar-hint-close]');

  /* Place the hint so its bottom edge sits ~12px above the currently
     open modal panel's top edge. Falls back to 12px from viewport top
     if no panel is found (or the modal animation hasn't laid out yet). */
  function positionAboveModal() {
    /* Look for the topmost edge among open panels we know about */
    var panelSelectors = [
      '.apgo-cc-confirm-modal.is-open .apgo-cc-confirm-modal__panel',
      '.apgo-pdp-variant-shell[aria-hidden="false"] .apgo-variant-modal',
      '.apgo-pdp-variant-shell.is-open .apgo-variant-modal'
    ];
    var panelTop = null;
    for (var i = 0; i < panelSelectors.length; i++) {
      var p = document.querySelector(panelSelectors[i]);
      if (p) {
        var rect = p.getBoundingClientRect();
        if (rect.height > 0) {
          if (panelTop === null || rect.top < panelTop) panelTop = rect.top;
        }
      }
    }
    var hintHeight = hint.offsetHeight || 80;
    var safeTopMin = 12; /* never crowd the viewport edge */
    var target;
    if (panelTop !== null && panelTop > 0) {
      target = Math.max(safeTopMin, panelTop - hintHeight - 12);
    } else {
      target = safeTopMin;
    }
    hint.style.top = target + 'px';
  }

  /* Re-run positioning at multiple frames because the modal panel slides
     up via transform animation — its `top` (via getBoundingClientRect)
     changes for ~300ms. Sampling on a few rAF ticks gives the hint a
     chance to land in the right final spot. */
  function reposition(loops) {
    loops = (typeof loops === 'number') ? loops : 6;
    positionAboveModal();
    if (loops > 0) {
      requestAnimationFrame(function () { reposition(loops - 1); });
    }
  }

  function show() {
    if (hint.hasAttribute('hidden')) hint.removeAttribute('hidden');
    /* Force reflow so transition kicks in even on rapid re-show */
    void hint.offsetHeight;
    /* Position FIRST so the slide-in animation starts from above the modal */
    positionAboveModal();
    hint.classList.add('is-visible');
    /* Then keep correcting while the modal panel slides into place */
    requestAnimationFrame(function () { reposition(10); });
  }
  function hide() {
    hint.classList.remove('is-visible');
    /* Hide after transition so it can't intercept taps */
    setTimeout(function () {
      if (!hint.classList.contains('is-visible')) {
        hint.setAttribute('hidden', '');
      }
    }, 350);
  }

  /* Recompute on viewport changes too — keyboard appearing on mobile,
     orientation change, etc. all shift the modal panel's top. */
  window.addEventListener('resize', function () {
    if (hint.classList.contains('is-visible')) positionAboveModal();
  });
  window.addEventListener('scroll', function () {
    if (hint.classList.contains('is-visible')) positionAboveModal();
  }, { passive: true });

  if (closeBtn) closeBtn.addEventListener('click', hide);

  /* Watch only the modals where the user is actually picking a variant
     / about to Add to cart. The cart sheet drawer (.apgo-cc-buybar's
     `is-open`) is NOT included — that just shows the existing cart
     contents and the reassurance toast would be noise there. */
  var SELECTORS = [
    '.apgo-cc-confirm-modal',
    '.apgo-pdp-variant-shell'
  ];

  /* If ANY watched container is currently open, show; else hide. This
     way the hint also auto-disappears when the visitor closes the
     modal without explicitly dismissing the toast. */
  function syncToOpenState() {
    var anyOpen = false;
    for (var i = 0; i < SELECTORS.length; i++) {
      var nodes = document.querySelectorAll(SELECTORS[i]);
      for (var j = 0; j < nodes.length; j++) {
        if (nodes[j].classList.contains('is-open')) { anyOpen = true; break; }
      }
      if (anyOpen) break;
    }
    if (anyOpen) show();
    else hide();
  }

  function attach(el) {
    if (!el || el.__apgoGwpHintWatched) return;
    el.__apgoGwpHintWatched = true;
    var observer = new MutationObserver(function (mutations) {
      for (var i = 0; i < mutations.length; i++) {
        if (mutations[i].attributeName === 'class') {
          syncToOpenState();
          break;
        }
      }
    });
    observer.observe(el, { attributes: true, attributeFilter: ['class'] });
  }

  function scan() {
    SELECTORS.forEach(function (sel) {
      var nodes = document.querySelectorAll(sel);
      for (var i = 0; i < nodes.length; i++) attach(nodes[i]);
    });
  }

  function start() {
    scan();
    syncToOpenState();
    /* Catch elements that mount after initial DOM ready */
    var tries = 0;
    var poll = setInterval(function () {
      scan();
      tries++;
      if (tries > 20) clearInterval(poll); /* ~6s of catch-up */
    }, 300);
    new MutationObserver(scan).observe(document.body, { childList: true, subtree: true });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', start);
  } else {
    start();
  }
})();
</script>
