{%- doc -%}
  Renders product badges for the product card.

  @param {object} product - The product object.
  @param {object} settings - The theme settings object.

  @example
  {% render 'product-card-badges', product: product, settings: settings %}
{%- enddoc -%}
{%- liquid
  assign sold_out = false
  if product.available == false
    assign sold_out = true
  endif

  assign by_compare_price = false
  if product.compare_at_price > product.price
    assign by_compare_price = true
  endif

  assign hot_tag = settings.badge_hot_icon_tag | strip
  if hot_tag == blank
    assign hot_tag = 'apgo-hot'
  endif
  assign by_hot_tag = false
  if product.tags contains hot_tag
    assign by_hot_tag = true
  endif

  assign mode = settings.badge_hot_icon_mode | default: 'compare_price_or_tag'
  assign show_hot_icon = false
  unless sold_out
    case mode
      when 'compare_price_only'
        assign show_hot_icon = by_compare_price
      when 'tag_only'
        assign show_hot_icon = by_hot_tag
      else
        if by_compare_price
          assign show_hot_icon = true
        elsif by_hot_tag
          assign show_hot_icon = true
        endif
    endcase
  endunless

  assign show_badge = false
  if sold_out
    assign show_badge = true
  elsif show_hot_icon
    assign show_badge = true
  endif
-%}

<div
  class="product-badges product-badges--{{ settings.badge_position }}"
  style="
    --badge-border-radius: {{ settings.badge_corner_radius }}px;
    --badge-font-family: var(--font-{{ settings.badge_font_family }}--family); --badge-font-weight: var(--font-{{ settings.badge_font_family }}--weight); --badge-text-transform: {{ settings.badge_text_transform }};
  "
>
  {%- if show_badge -%}
    <div
      class="
        product-badges__badge product-badges__badge--rectangle
        {% if sold_out %} color-{{ settings.badge_sold_out_color_scheme }}{% elsif show_hot_icon %} product-badges__badge--sale{% endif %}
      "
    >
      {%- if sold_out -%}
        {{ 'content.product_badge_sold_out' | t }}
      {%- elsif show_hot_icon -%}
        <span class="visually-hidden">{{ 'content.product_badge_sale' | t }}</span>
        <span class="product-badges__sale-icon" aria-hidden="true">&#x1F525;</span>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-badges {
    position: absolute;
    z-index: var(--layer-flat);
    --badge-inset: max(var(--padding-xs), calc((var(--border-radius) + var(--padding-xs)) * (1 - cos(45deg))));
  }

  .product-badges--bottom-left {
    bottom: calc(var(--badge-inset) + var(--padding-block-start));
    left: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-left {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    left: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges--top-right {
    top: calc(var(--badge-inset) + var(--padding-block-start));
    right: calc(var(--badge-inset) + var(--padding-inline-start));
  }

  .product-badges__badge {
    --badge-font-size: var(--font-size--xs);

    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--color-foreground);
    background: var(--color-background);
    font-size: var(--badge-font-size);
    font-family: var(--badge-font-family);
    font-weight: var(--badge-font-weight);
    text-transform: var(--badge-text-transform);
    border-radius: var(--badge-border-radius);
  }

  .product-badges__badge--rectangle {
    padding-block: var(--badge-rectangle-padding-block);
    padding-inline: var(--badge-rectangle-padding-inline);
  }

  /* 促銷角標：完全無底，僅圖示 */
  .product-badges__badge--sale {
    color: #f08418;
    background: transparent;
    border: none;
    box-shadow: none;
    text-transform: none;
  }

  .product-badges__sale-icon {
    display: inline-block;
    font-size: 1.15em;
    line-height: 1;
    /* 淺色商品圖上仍可辨識，非實心底色 */
    filter: drop-shadow(0 0 1px rgba(0, 0, 0, 0.85)) drop-shadow(0 1px 2px rgba(0, 0, 0, 0.45));
  }
{% endstylesheet %}
