{% doc %}
  Renders a promotional event zone with a heading, limited-offer message, and a banner linked to one product.

  @param {string} heading - Zone heading text.
  @param {string} message - Promotional message shown above the banner.
  @param {boolean} show_counter - Whether to render the campaign stock counter.
  @param {string} counter_total - Total number of campaign sets.
  @param {string} counter_claimed - Number of campaign sets already claimed.
  @param {image} banner_image - Promotional banner image.
  @param {product} product - Product opened when the banner is selected.
  @param {string} variant_id - Optional numeric ID of the promoted product variant.
  @param {string} zone_class - Modifier suffix for the zone wrapper.
{% enddoc %}

{% if banner_image != blank and product != blank %}
  {% liquid
    assign action_variant = product.selected_or_first_available_variant
    assign requested_variant_id = variant_id | default: '' | strip | plus: 0
    if requested_variant_id != 0
      for candidate_variant in product.variants
        if candidate_variant.id == requested_variant_id
          assign action_variant = candidate_variant
          break
        endif
      endfor
    endif
  %}
  <section class="apgo-event-linked-banner-zone apgo-event-linked-banner-zone--{{ zone_class }}">
    {% if heading != blank %}
      <h3 class="apgo-event-scroll-zone__heading">
        <span class="apgo-event-scroll-zone__heading-star" aria-hidden="true">★</span>
        {{ heading | escape }}
        <span class="apgo-event-scroll-zone__heading-star" aria-hidden="true">★</span>
      </h3>
    {% endif %}

    {% if message != blank %}
      <p class="apgo-event-linked-banner-zone__message">{{ message | escape }}</p>
    {% endif %}

    {% if show_counter %}
      {% liquid
        assign campaign_total = counter_total | plus: 0
        if campaign_total < 1
          assign campaign_total = 500
        endif
        assign campaign_claimed = counter_claimed | plus: 0 | at_least: 0 | at_most: campaign_total
        assign campaign_remaining = campaign_total | minus: campaign_claimed
        assign campaign_progress = campaign_remaining | times: 100.0 | divided_by: campaign_total
        assign low_stock_threshold = campaign_total | times: 0.25
      %}
      <div
        class="apgo-event-stock-counter{% if campaign_remaining <= low_stock_threshold %} is-low{% endif %}"
        data-aurora-stock-counter
        data-total="{{ campaign_total }}"
        data-claimed="{{ campaign_claimed }}"
        data-remaining="{{ campaign_remaining }}"
      >
        <div class="apgo-event-stock-counter__number-row">
          <span
            class="apgo-event-stock-counter__number"
            data-aurora-stock-number
          >{{ campaign_remaining }}</span>
          <span class="apgo-event-stock-counter__label">
            {% if campaign_remaining > 0 %}
              {{ 'apgo_event.aurora_counter.sets_remaining' | t }}
            {% else %}
              {{ 'apgo_event.aurora_counter.milestone_reached' | t: total: campaign_total }}
            {% endif %}
          </span>
        </div>
        <div
          class="apgo-event-stock-counter__progress"
          role="progressbar"
          aria-label="{{ 'apgo_event.aurora_counter.progress_label' | t: remaining: campaign_remaining, total: campaign_total }}"
          aria-valuemin="0"
          aria-valuemax="{{ campaign_total }}"
          aria-valuenow="{{ campaign_remaining }}"
        >
          <span
            class="apgo-event-stock-counter__progress-fill"
            style="--apgo-stock-progress: {{ campaign_progress }}%;"
          ></span>
        </div>
        <div class="apgo-event-stock-counter__meta">
          <span>{{ 'apgo_event.aurora_counter.limited_release' | t }}</span>
          <span>{{ 'apgo_event.aurora_counter.while_stocks_last' | t }}</span>
        </div>
      </div>
      <p class="apgo-event-stock-counter__notice">
        {{ 'apgo_event.aurora_counter.stock_update_notice' | t }}
      </p>
    {% endif %}

    <div class="apgo-event-scroll-zone__banner apgo-event-linked-banner-zone__offer">
      <a
        class="apgo-event-linked-banner-zone__link"
        href="{{ action_variant.url }}"
        aria-label="{{ product.title | escape }}"
      >
        {{ banner_image
          | image_url: width: 1600
          | image_tag:
            class: 'apgo-event-scroll-zone__banner-img',
            loading: 'lazy',
            widths: '360, 540, 720, 960, 1200, 1600',
            sizes: '(min-width: 990px) 1200px, calc(100vw - 48px)',
            alt: product.title
        }}
      </a>
      <div class="apgo-event-linked-banner-zone__actions">
        <button
          type="button"
          class="apgo-event-linked-banner-zone__button apgo-event-linked-banner-zone__button--add"
          data-variant-id="{{ action_variant.id }}"
          aria-label="{{ 'actions.add_to_cart' | t }}: {{ product.title | escape }}"
          {% unless action_variant.available %}disabled{% endunless %}
        >
          {% if action_variant.available %}
            {{ 'actions.add_to_cart' | t }}
          {% else %}
            {{ 'products.product.sold_out' | t }}
          {% endif %}
        </button>
        <button
          type="button"
          class="apgo-event-linked-banner-zone__button apgo-event-linked-banner-zone__button--buy"
          data-variant-id="{{ action_variant.id }}"
          aria-label="{{ 'product.buy_now' | t }}: {{ product.title | escape }}"
          {% unless action_variant.available %}disabled{% endunless %}
        >
          {% if action_variant.available %}
            {{ 'product.buy_now' | t }}
          {% else %}
            {{ 'products.product.sold_out' | t }}
          {% endif %}
        </button>
      </div>
    </div>
  </section>
{% endif %}
