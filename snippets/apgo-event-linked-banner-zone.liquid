{% doc %}
  Renders a promotional event zone with a heading, limited-offer message, and a banner linked to one product.

  @param {string} heading - Zone heading text.
  @param {string} message - Promotional message shown above the banner.
  @param {boolean} show_counter - Whether to render the campaign stock counter.
  @param {string} counter_total - Total number of campaign sets.
  @param {string} counter_start_remaining - Remaining sets shown when Flow resumes.
  @param {string} counter_flow_baseline - Paid-set metafield value when Flow resumes.
  @param {image} banner_image - Promotional banner image.
  @param {product} product - Product opened when the banner is selected.
  @param {string} variant_id - Optional numeric ID of the promoted product variant.
  @param {string} zone_class - Modifier suffix for the zone wrapper.
  @param {number} zone_position - One-based campaign section position.
{% enddoc %}

{% if banner_image != blank and product != blank %}
  {% liquid
    assign action_variant = product.selected_or_first_available_variant
    assign requested_variant_id = variant_id | default: '' | strip | plus: 0
    assign apgo_counter_visible = show_counter
    assign apgo_counter_start_remaining = counter_start_remaining
    assign apgo_counter_flow_baseline = counter_flow_baseline
    if template.suffix == 'golden-bull-award'
      assign apgo_counter_visible = true
      assign apgo_counter_start_remaining = 262
      assign apgo_counter_flow_baseline = 9
    endif
    if requested_variant_id != 0
      for candidate_variant in product.variants
        if candidate_variant.id == requested_variant_id
          assign action_variant = candidate_variant
          break
        endif
      endfor
    endif
  %}
  <section
    class="apgo-event-linked-banner-zone apgo-event-linked-banner-zone--{{ zone_class }}"
    data-apgo-campaign-section
    data-section-id="{{ zone_class | escape }}"
    data-section-name="{{ heading | escape }}"
    data-section-position="{{ zone_position }}"
    data-promotion-id="golden_bull_{{ zone_class | escape }}"
    data-product-id="{{ product.id }}"
    data-product-name="{{ product.title | escape }}"
    data-product-handle="{{ product.handle | escape }}"
  >
    {% if heading != blank %}
      <h3 class="apgo-event-scroll-zone__heading">
        <span class="apgo-event-scroll-zone__heading-star" aria-hidden="true">★</span>
        {{ heading | escape }}
        <span class="apgo-event-scroll-zone__heading-star" aria-hidden="true">★</span>
      </h3>
    {% endif %}

    {% if message != blank %}
      <p class="apgo-event-linked-banner-zone__message">{{ message | escape }}</p>
    {% endif %}

    {% if apgo_counter_visible %}
      {% render 'apgo-aurora-stock-counter',
        total: counter_total,
        starting_remaining: apgo_counter_start_remaining,
        flow_baseline: apgo_counter_flow_baseline
      %}
    {% endif %}

    <div class="apgo-event-scroll-zone__banner apgo-event-linked-banner-zone__offer">
      <a
        class="apgo-event-linked-banner-zone__link"
        href="{{ action_variant.url }}"
        data-apgo-campaign-promotion-link
        data-promotion-id="golden_bull_aurora_banner"
        data-promotion-name="{{ heading | escape }}"
        data-variant-id="{{ action_variant.id }}"
        aria-label="{{ product.title | escape }}"
      >
        {{ banner_image
          | image_url: width: 1600
          | image_tag:
            class: 'apgo-event-scroll-zone__banner-img',
            loading: 'lazy',
            widths: '360, 540, 720, 960, 1200, 1600',
            sizes: '(min-width: 990px) 1200px, calc(100vw - 48px)',
            alt: product.title
        }}
      </a>
      <div class="apgo-event-linked-banner-zone__actions">
        <button
          type="button"
          class="apgo-event-linked-banner-zone__button apgo-event-linked-banner-zone__button--add"
          data-variant-id="{{ action_variant.id }}"
          aria-label="{{ 'actions.add_to_cart' | t }}: {{ product.title | escape }}"
          {% unless action_variant.available %}disabled{% endunless %}
        >
          {% if action_variant.available %}
            {{ 'actions.add_to_cart' | t }}
          {% else %}
            {{ 'products.product.sold_out' | t }}
          {% endif %}
        </button>
        <button
          type="button"
          class="apgo-event-linked-banner-zone__button apgo-event-linked-banner-zone__button--buy"
          data-variant-id="{{ action_variant.id }}"
          aria-label="{{ 'product.buy_now' | t }}: {{ product.title | escape }}"
          {% unless action_variant.available %}disabled{% endunless %}
        >
          {% if action_variant.available %}
            {{ 'product.buy_now' | t }}
          {% else %}
            {{ 'products.product.sold_out' | t }}
          {% endif %}
        </button>
      </div>
    </div>
  </section>
{% endif %}
