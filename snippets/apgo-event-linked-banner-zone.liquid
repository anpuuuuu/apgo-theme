{% doc %}
  Renders a promotional event zone with a heading, limited-offer message, and a banner linked to one product.

  @param {string} heading - Zone heading text.
  @param {string} message - Promotional message shown above the banner.
  @param {boolean} show_counter - Whether to render the campaign stock counter.
  @param {string} counter_release_total - Sets allocated to the current release.
  @param {number} counter_manual_deduction - Additional sets subtracted in the theme editor.
  @param {number} counter_milestone_total - Previous sold-out allocation shown as a milestone.
  @param {number} [counter_flow_baseline] - aurora_paid_sets value when Flow is connected; paid sets beyond it reduce the counter live.
  @param {image} banner_image - Promotional banner image.
  @param {product} product - Product opened when the banner is selected.
  @param {string} variant_id - Optional numeric ID of the promoted product variant.
  @param {string} [single_cta_label] - Replaces the two cart buttons with one product-page link.
  @param {string} zone_class - Modifier suffix for the zone wrapper.
  @param {number} zone_position - One-based campaign section position.
  @param {string} [gift_modal_id] - Optional id of the gift picker controlled by this zone.
  @param {string} [block_attributes] - Shopify editor attributes for the owning block.
  @param {boolean} [crate] - Clearance page look: shipping-label heading, content in the
                             page container, no Aurora stock counter.
  @param {string} [lot] - Clearance page only: two-digit lot number, blank when there is no heading.
  @param {string} [box] - Clearance page only: two-digit box number printed on the handling strip.
{% enddoc %}

{% if banner_image != blank and product != blank %}
  {% liquid
    assign action_variant = product.selected_or_first_available_variant
    assign requested_variant_id = variant_id | default: '' | strip | plus: 0
    assign apgo_counter_visible = show_counter
    if requested_variant_id != 0
      for candidate_variant in product.variants
        if candidate_variant.id == requested_variant_id
          assign action_variant = candidate_variant
          break
        endif
      endfor
    endif

    # Sold-out state. The promoted product may use inventory policy
    # "continue selling when out of stock" (CONTINUE), so variant.available
    # stays true even at 0 stock. Mirror the PDP: treat real inventory of 0
    # (tracked variant, inventory_quantity <= 0) as sold out too.
    assign apgo_zone_sold_out = false
    unless action_variant.available
      assign apgo_zone_sold_out = true
    endunless
    if action_variant.inventory_management != blank and action_variant.inventory_quantity != blank and action_variant.inventory_quantity <= 0
      assign apgo_zone_sold_out = true
    endif

    # Clearance page: the Aurora counter is styled for Golden Bull only.
    if crate
      assign apgo_counter_visible = false
      assign apgo_lot_code = blank
      assign apgo_tilt = 'tilt-left'
      if lot != blank
        assign apgo_lot_code = 'LOT ' | append: lot
        assign apgo_lot_parity = lot | plus: 0 | modulo: 2
        if apgo_lot_parity == 0
          assign apgo_tilt = 'tilt-right'
        endif
      endif
    endif
  %}
  <section
    class="apgo-event-linked-banner-zone apgo-event-linked-banner-zone--{{ zone_class }}{% if crate %} apgo-crate-zone apgo-crate-zone--offer{% endif %}"
    {% if gift_modal_id != blank %}data-apgo-event-gift-modal-id="{{ gift_modal_id | escape }}"{% endif %}
    data-apgo-campaign-section
    data-section-id="{{ zone_class | escape }}"
    data-section-name="{{ heading | escape }}"
    data-section-position="{{ zone_position }}"
    data-promotion-id="{{ campaign_id | default: 'golden_bull_award' | escape }}_{{ zone_class | escape }}"
    data-product-id="{{ product.id }}"
    data-product-name="{{ product.title | escape }}"
    data-product-handle="{{ product.handle | escape }}"
    {% if crate and lot != blank %}data-lot="{{ lot }}"{% endif %}
    {{ block_attributes }}
  >
    {% if crate %}
      <div class="apgo-crate-container apgo-crate-zone__inner">
      {% render 'apgo-clearance-label',
        title: heading,
        note: 'FROM: OLD FACTORY → TO: YOUR GARAGE',
        lot: apgo_lot_code,
        modifier: apgo_tilt
      %}
    {% elsif heading != blank %}
      <h3 class="apgo-event-scroll-zone__heading">
        <span class="apgo-event-scroll-zone__heading-star" aria-hidden="true">★</span>
        {{ heading | escape }}
        <span class="apgo-event-scroll-zone__heading-star" aria-hidden="true">★</span>
      </h3>
    {% endif %}

    {% if message != blank %}
      <p class="apgo-event-linked-banner-zone__message">{{ message | escape }}</p>
    {% endif %}

    {% if apgo_counter_visible %}
      {% render 'apgo-aurora-stock-counter',
        release_total: counter_release_total,
        manual_deduction: counter_manual_deduction,
        milestone_total: counter_milestone_total,
        flow_baseline: counter_flow_baseline
      %}
    {% endif %}

    <div class="apgo-event-scroll-zone__banner apgo-event-linked-banner-zone__offer">
      <a
        class="apgo-event-linked-banner-zone__link"
        href="{{ action_variant.url }}"
        data-apgo-campaign-promotion-link
        data-promotion-id="{{ campaign_id | default: 'golden_bull_award' | escape }}_{{ zone_class | escape }}_banner"
        data-promotion-name="{{ heading | escape }}"
        data-variant-id="{{ action_variant.id }}"
        aria-label="{{ product.title | escape }}"
      >
        {{ banner_image
          | image_url: width: 1600
          | image_tag:
            class: 'apgo-event-scroll-zone__banner-img',
            loading: 'lazy',
            widths: '360, 540, 720, 960, 1200, 1600',
            sizes: '(min-width: 990px) 1200px, calc(100vw - 48px)',
            alt: product.title
        }}
      </a>
      {%- if crate -%}
        {%- comment -%} Clearance page: cardboard corner guards and a strip of box handling marks. {%- endcomment -%}
        <span class="apgo-crate-guards" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <div class="apgo-crate-handling" aria-hidden="true">
          <span class="apgo-crate-handling__mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M8 20V6M4 10l4-4 4 4M16 20V6M12 10l4-4 4 4"/></svg>
            This side up
          </span>
          <span class="apgo-crate-handling__mark apgo-crate-handling__mark--extra">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M3 12a9 9 0 0 1 18 0z"/><path d="M12 12v6.5a2 2 0 0 1-4 0M12 3v0.5"/></svg>
            Keep dry
          </span>
          <span class="apgo-crate-handling__mark apgo-crate-handling__mark--extra">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M7 3h10l-1.2 6.4a3.9 3.9 0 0 1-7.6 0z"/><path d="M12 13.4V20M8.5 21h7M11.5 3.5l1.3 2.4-1.2 1.4 1 1.5"/></svg>
            Fragile
          </span>
          <span class="apgo-crate-handling__code">
            <span class="apgo-crate-handling__barcode"></span>
            <span class="apgo-crate-handling__stamp"><span class="apgo-crate-handling__stamp-word">Clearance · </span>Box {{ box | default: '01' }}</span>
          </span>
        </div>
      {%- endif -%}
      <div class="apgo-event-linked-banner-zone__actions">
        {%- if single_cta_label != blank -%}
          {%- comment -%}
            Single-CTA mode (param single_cta_label): one full-width gold
            button that navigates to the product page instead of Add/Buy —
            used for promos that must be bought via the PDP picker (e.g.
            the detergent bundle's tier + scent flow).
          {%- endcomment -%}
          {%- comment -%}
            NOTE: deliberately NO --buy class and NO data-variant-id here —
            apgo-event-cart.js intercepts clicks on .__button--buy elements
            carrying data-variant-id and turns them into cart adds. This CTA
            must NAVIGATE to the PDP, so it stays outside those selectors.
          {%- endcomment -%}
          {%- if apgo_zone_sold_out -%}
            <button type="button" class="apgo-event-linked-banner-zone__button apgo-event-linked-banner-zone__button--single" disabled>
              {{ 'products.product.sold_out' | t }}
            </button>
          {%- else -%}
            <a
              class="apgo-event-linked-banner-zone__button apgo-event-linked-banner-zone__button--single"
              href="{{ action_variant.url }}"
              data-apgo-campaign-promotion-link
              data-promotion-id="{{ campaign_id | default: 'golden_bull_award' | escape }}_{{ zone_class | escape }}_cta"
              data-promotion-name="{{ heading | escape }}"
              aria-label="{{ single_cta_label | escape }}: {{ product.title | escape }}"
            >{{ single_cta_label }}</a>
          {%- endif -%}
        {%- else -%}
        <button
          type="button"
          class="apgo-event-linked-banner-zone__button apgo-event-linked-banner-zone__button--add"
          data-variant-id="{{ action_variant.id }}"
          aria-label="{{ 'actions.add_to_cart' | t }}: {{ product.title | escape }}"
          {% if apgo_zone_sold_out %}disabled{% endif %}
        >
          {% if apgo_zone_sold_out %}
            {{ 'products.product.sold_out' | t }}
          {% else %}
            {{ 'actions.add_to_cart' | t }}
          {% endif %}
        </button>
        <button
          type="button"
          class="apgo-event-linked-banner-zone__button apgo-event-linked-banner-zone__button--buy"
          data-variant-id="{{ action_variant.id }}"
          aria-label="{{ 'product.buy_now' | t }}: {{ product.title | escape }}"
          {% if apgo_zone_sold_out %}disabled{% endif %}
        >
          {% if apgo_zone_sold_out %}
            {{ 'products.product.sold_out' | t }}
          {% else %}
            {{ 'product.buy_now' | t }}
          {% endif %}
        </button>
        {%- endif -%}
      </div>
    </div>
    {% if crate %}
      </div>
    {% endif %}
  </section>
{% endif %}
