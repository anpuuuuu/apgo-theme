{% doc %}
  Renders a promotional event zone with a heading, limited-offer message, and a banner linked to one product.

  @param {string} heading - Zone heading text.
  @param {string} message - Promotional message shown above the banner.
  @param {boolean} show_counter - Whether to render the campaign stock counter.
  @param {string} counter_total - Total number of campaign sets.
  @param {string} counter_claimed - Number of campaign sets already claimed.
  @param {image} banner_image - Promotional banner image.
  @param {product} product - Product opened when the banner is selected.
  @param {string} cta - Optional call-to-action label below the banner image.
  @param {string} zone_class - Modifier suffix for the zone wrapper.
{% enddoc %}

{% if banner_image != blank and product != blank %}
  {% assign link_label = cta | default: product.title %}
  <section class="apgo-event-linked-banner-zone apgo-event-linked-banner-zone--{{ zone_class }}">
    {% if heading != blank %}
      <h3 class="apgo-event-scroll-zone__heading">
        <span class="apgo-event-scroll-zone__heading-star" aria-hidden="true">★</span>
        {{ heading | escape }}
        <span class="apgo-event-scroll-zone__heading-star" aria-hidden="true">★</span>
      </h3>
    {% endif %}

    {% if message != blank %}
      <p class="apgo-event-linked-banner-zone__message">{{ message | escape }}</p>
    {% endif %}

    {% if show_counter %}
      {% liquid
        assign campaign_total = counter_total | plus: 0
        if campaign_total < 1
          assign campaign_total = 500
        endif
        assign campaign_claimed = counter_claimed | plus: 0 | at_least: 0 | at_most: campaign_total
        assign campaign_remaining = campaign_total | minus: campaign_claimed
        assign campaign_progress = campaign_claimed | times: 100.0 | divided_by: campaign_total
      %}
      <div
        class="apgo-event-stock-counter"
        data-aurora-stock-counter
        data-total="{{ campaign_total }}"
        data-claimed="{{ campaign_claimed }}"
        data-remaining="{{ campaign_remaining }}"
      >
        <div class="apgo-event-stock-counter__number-row">
          <span class="apgo-event-stock-counter__number">{{ campaign_remaining }}</span>
          <span class="apgo-event-stock-counter__label">
            {% if campaign_remaining > 0 %}
              {{ 'apgo_event.aurora_counter.sets_remaining' | t }}
            {% else %}
              {{ 'apgo_event.aurora_counter.milestone_reached' | t: total: campaign_total }}
            {% endif %}
          </span>
        </div>
        <div
          class="apgo-event-stock-counter__progress"
          role="progressbar"
          aria-label="{{ 'apgo_event.aurora_counter.progress_label' | t: claimed: campaign_claimed, total: campaign_total }}"
          aria-valuemin="0"
          aria-valuemax="{{ campaign_total }}"
          aria-valuenow="{{ campaign_claimed }}"
        >
          <span
            class="apgo-event-stock-counter__progress-fill"
            style="--apgo-stock-progress: {{ campaign_progress }}%;"
          ></span>
        </div>
        <div class="apgo-event-stock-counter__meta">
          <span>{{ 'apgo_event.aurora_counter.claimed' | t: count: campaign_claimed }}</span>
          <span>{{ 'apgo_event.aurora_counter.total' | t: count: campaign_total }}</span>
        </div>
      </div>
    {% endif %}

    <a
      class="apgo-event-scroll-zone__banner apgo-event-linked-banner-zone__link"
      href="{{ product.url }}"
      aria-label="{{ link_label | escape }}"
    >
      {{ banner_image
        | image_url: width: 1600
        | image_tag:
          class: 'apgo-event-scroll-zone__banner-img',
          loading: 'lazy',
          widths: '360, 540, 720, 960, 1200, 1600',
          sizes: '(min-width: 990px) 1200px, calc(100vw - 48px)',
          alt: product.title
      }}
      {% if cta != blank %}
        <span class="apgo-event-linked-banner-zone__cta">
          {{ cta | escape }}
          <span aria-hidden="true">→</span>
        </span>
      {% endif %}
    </a>
  </section>
{% endif %}
