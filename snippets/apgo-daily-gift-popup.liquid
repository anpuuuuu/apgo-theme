{%- doc -%}
  APGO Daily Gift Popup — center-screen modal style.
  Used on the Hari Raya Haji Bundle product page only.

  Show rules:
    1. Product handle guard on parent section (apgo_product_page_v3.liquid).
    2. Only after `start_str` (MY GMT+8). Empty `end_str` = no expiry.
    3. Once per browser session (sessionStorage).
    4. Per-day localStorage dismiss flag set by X click / backdrop / Esc.

  Edit values in the assign block to change copy / dates.
{%- enddoc -%}

{%- comment -%} ============ EDIT THESE TO CHANGE THE PROMO ============ {%- endcomment -%}
{%- assign start_str       = '2026-05-22' -%}
{%- assign end_str         = '' -%}{%- comment -%} blank = no expiry {%- endcomment -%}
{%- assign end_time_str    = '23:59' -%}
{%- assign badge_text      = 'TODAY ONLY' -%}
{%- assign title_text      = 'Free Car Wash Shampoo' -%}
{%- assign subtitle_text   = 'Add this bundle to cart and we will include it free.' -%}
{%- assign timer_label     = 'Ends in' -%}
{%- assign storage_key_day = 'apgo_gift_popup_haji_day' -%}
{%- assign storage_key_session = 'apgo_gift_popup_haji_seen' -%}
{%- comment -%} ========================================================== {%- endcomment -%}

{%- assign promo_image = product.featured_image -%}

<div
  class="apgo-daily-gift-backdrop"
  data-apgo-daily-gift-backdrop
  hidden
></div>

<aside
  class="apgo-daily-gift"
  data-apgo-daily-gift
  data-start="{{ start_str }}"
  data-end="{{ end_str }}"
  data-daily-end-time="{{ end_time_str }}"
  data-tz-offset="+08:00"
  data-storage-day-key="{{ storage_key_day }}"
  data-storage-session-key="{{ storage_key_session }}"
  hidden
  role="dialog"
  aria-modal="true"
  aria-labelledby="apgoDailyGiftTitle"
>
  <button type="button" class="apgo-daily-gift__close" data-apgo-daily-gift-close aria-label="Close">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <div class="apgo-daily-gift__image-wrap">
    {%- if promo_image != blank -%}
      <img
        class="apgo-daily-gift__image"
        src="{{ promo_image | image_url: width: 600 }}"
        alt="{{ product.title | escape }}"
        loading="lazy"
      >
    {%- else -%}
      <div class="apgo-daily-gift__image-fallback" aria-hidden="true">🎁</div>
    {%- endif -%}
  </div>

  <div class="apgo-daily-gift__body">
    <span class="apgo-daily-gift__badge">🎁 {{ badge_text }}</span>
    <p class="apgo-daily-gift__title" id="apgoDailyGiftTitle">{{ title_text }}</p>
    {%- if subtitle_text != blank -%}
      <p class="apgo-daily-gift__sub">{{ subtitle_text }}</p>
    {%- endif -%}
    <div class="apgo-daily-gift__timer-row">
      <span class="apgo-daily-gift__timer-label">{{ timer_label }}</span>
      <span class="apgo-daily-gift__timer" data-apgo-daily-gift-timer>--:--:--</span>
    </div>
  </div>
</aside>

<style>
  .apgo-daily-gift-backdrop {
    position: fixed;
    inset: 0;
    z-index: 89999;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity .3s ease;
    pointer-events: none;
  }
  .apgo-daily-gift-backdrop.is-visible { opacity: 1; pointer-events: auto; }
  .apgo-daily-gift-backdrop[hidden] { display: none !important; }

  .apgo-daily-gift {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.94);
    z-index: 90000;
    width: min(86vw, 360px);
    border-radius: 18px;
    background: #111;
    border: 1px solid rgba(240, 132, 24, 0.55);
    box-shadow:
      0 20px 60px rgba(0, 0, 0, 0.65),
      0 0 0 1px rgba(240, 132, 24, 0.18) inset,
      0 0 36px rgba(240, 132, 24, 0.18);
    color: #fff;
    opacity: 0;
    transition: opacity .35s cubic-bezier(.16,1,.3,1), transform .35s cubic-bezier(.16,1,.3,1);
    pointer-events: none;
    overflow: hidden;
  }
  .apgo-daily-gift[hidden] { display: none !important; }
  .apgo-daily-gift.is-visible {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    pointer-events: auto;
    animation: apgoGiftPop .55s cubic-bezier(.34,1.56,.64,1);
  }
  @keyframes apgoGiftPop {
    0%   { transform: translate(-50%, -50%) scale(0.88); }
    65%  { transform: translate(-50%, -50%) scale(1.03); }
    100% { transform: translate(-50%, -50%) scale(1);    }
  }

  /* X button — no background, plain white icon */
  .apgo-daily-gift__close {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 32px;
    height: 32px;
    border: 0;
    padding: 0;
    background: transparent;
    color: #ffffff;
    cursor: pointer;
    display: grid;
    place-items: center;
    z-index: 3;
    border-radius: 0;
    opacity: 0.9;
    transition: opacity .15s ease, transform .15s ease;
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.6));
  }
  .apgo-daily-gift__close:hover { opacity: 1; transform: scale(1.1); }
  .apgo-daily-gift__close:active { transform: scale(0.95); }

  .apgo-daily-gift__image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: #0a0a0a;
    overflow: hidden;
  }
  .apgo-daily-gift__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .apgo-daily-gift__image-fallback {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    font-size: 96px;
    line-height: 1;
    background: linear-gradient(135deg, rgba(240, 132, 24, 0.15), rgba(255, 154, 60, 0.05));
  }

  .apgo-daily-gift__body {
    padding: 16px 20px 20px;
    text-align: center;
  }
  .apgo-daily-gift__badge {
    display: inline-block;
    padding: 5px 14px;
    margin-bottom: 12px;
    border-radius: 999px;
    background: linear-gradient(45deg, #f08418, #ff9a3c);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: 0 4px 14px rgba(240, 132, 24, 0.45);
    animation: apgoGiftBadgePulse 2.2s ease-in-out infinite;
  }
  @keyframes apgoGiftBadgePulse {
    0%, 100% { box-shadow: 0 4px 14px rgba(240, 132, 24, 0.45); }
    50%      { box-shadow: 0 4px 22px rgba(240, 132, 24, 0.75); }
  }
  .apgo-daily-gift__title {
    margin: 0 0 6px;
    font-size: 20px;
    font-weight: 800;
    color: #fff;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }
  .apgo-daily-gift__sub {
    margin: 0 0 14px;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.55;
  }
  /* Inline center timer — no box, just label + time on one line */
  .apgo-daily-gift__timer-row {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    background: transparent;
    border: 0;
  }
  .apgo-daily-gift__timer-label {
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .apgo-daily-gift__timer {
    font-weight: 800;
    font-size: 18px;
    color: #f08418;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
    text-shadow: 0 0 12px rgba(240, 132, 24, 0.5);
  }

  @media (min-width: 750px) {
    .apgo-daily-gift {
      width: min(420px, 90vw);
    }
    .apgo-daily-gift__title { font-size: 22px; }
    .apgo-daily-gift__sub { font-size: 14px; }
    .apgo-daily-gift__timer { font-size: 20px; }
  }
</style>

<script>
(function () {
  'use strict';
  var root = document.querySelector('[data-apgo-daily-gift]');
  var backdrop = document.querySelector('[data-apgo-daily-gift-backdrop]');
  if (!root) return;

  var startStr = root.getAttribute('data-start') || '';
  var endStr   = root.getAttribute('data-end')   || '';
  var dailyEnd = root.getAttribute('data-daily-end-time') || '23:59';
  var tz       = root.getAttribute('data-tz-offset') || '+08:00';
  var dayKey   = root.getAttribute('data-storage-day-key');
  var sessKey  = root.getAttribute('data-storage-session-key');

  function myTodayStr() {
    var now = new Date(Date.now() + 8 * 3600 * 1000);
    return now.getUTCFullYear() + '-' +
           String(now.getUTCMonth() + 1).padStart(2, '0') + '-' +
           String(now.getUTCDate()).padStart(2, '0');
  }

  var today = myTodayStr();
  if (startStr && today < startStr) return;
  if (endStr && today > endStr) return; /* blank end_str → never expires */
  try { if (sessKey && sessionStorage.getItem(sessKey) === '1') return; } catch (_) {}
  try { if (dayKey && localStorage.getItem(dayKey) === today) return; } catch (_) {}

  var timerEl = root.querySelector('[data-apgo-daily-gift-timer]');
  var closeEl = root.querySelector('[data-apgo-daily-gift-close]');

  function endOfDayMs() {
    var iso = today + 'T' + dailyEnd + ':00' + tz;
    var t = Date.parse(iso);
    if (t <= Date.now()) t += 24 * 3600 * 1000;
    return t;
  }
  var endMs = endOfDayMs();

  function pad(n) { return n < 10 ? '0' + n : '' + n; }
  function render() {
    var diff = endMs - Date.now();
    if (diff <= 0) {
      var nowToday = myTodayStr();
      if (endStr && nowToday > endStr) { close(true); return false; }
      today = nowToday;
      endMs = endOfDayMs();
      diff = endMs - Date.now();
    }
    var h = Math.floor(diff / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    timerEl.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
    return true;
  }
  if (!render()) return;

  try { if (sessKey) sessionStorage.setItem(sessKey, '1'); } catch (_) {}

  root.removeAttribute('hidden');
  backdrop && backdrop.removeAttribute('hidden');
  setTimeout(function () {
    root.classList.add('is-visible');
    backdrop && backdrop.classList.add('is-visible');
  }, 500);
  var tickId = setInterval(render, 1000);

  function close(silent) {
    root.classList.remove('is-visible');
    backdrop && backdrop.classList.remove('is-visible');
    setTimeout(function () {
      root.setAttribute('hidden', '');
      backdrop && backdrop.setAttribute('hidden', '');
    }, 350);
    clearInterval(tickId);
    if (!silent) {
      try { if (dayKey) localStorage.setItem(dayKey, today); } catch (_) {}
    }
  }

  closeEl && closeEl.addEventListener('click', function () { close(false); });
  backdrop && backdrop.addEventListener('click', function () { close(false); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !root.hasAttribute('hidden')) close(false);
  });
})();
</script>
