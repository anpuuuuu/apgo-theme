{%- doc -%}
  APGO Daily Gift Popup — mobile-first floating mini-card.
  Hardcoded values (not a configurable section). Drop into a PDP via:
    {% render 'apgo-daily-gift-popup' %}
  guarded by `{% if product.handle == 'atomic-glaze-coating-hari-raya-haji-bundle' %}`
  in the parent section so it only appears on that product.

  Edit the {%- assign -%} block below to tweak copy / dates without
  touching the markup.
{%- enddoc -%}

{%- comment -%} ============ EDIT THESE TO CHANGE THE PROMO ============ {%- endcomment -%}
{%- assign start_str       = '2026-05-22' -%}
{%- assign end_str         = '2026-05-24' -%}
{%- assign end_time_str    = '23:59' -%}
{%- assign badge_text      = 'LIMITED' -%}
{%- assign title_text      = 'Free shampoo with every order' -%}
{%- assign subtitle_text   = '3-day promo · Hari Raya special' -%}
{%- assign timer_label     = 'Ends in' -%}
{%- assign storage_key     = 'apgo_gift_popup_haji_bundle' -%}
{%- comment -%} ========================================================== {%- endcomment -%}

<aside
  class="apgo-daily-gift"
  data-apgo-daily-gift
  data-start="{{ start_str }}"
  data-end="{{ end_str }}"
  data-daily-end-time="{{ end_time_str }}"
  data-tz-offset="+08:00"
  data-storage-key="{{ storage_key }}"
  hidden
>
  <button type="button" class="apgo-daily-gift__close" data-apgo-daily-gift-close aria-label="Close">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <div class="apgo-daily-gift__inner">
    <span class="apgo-daily-gift__emoji" aria-hidden="true">🎁</span>
    <div class="apgo-daily-gift__body">
      <span class="apgo-daily-gift__badge">{{ badge_text }}</span>
      <p class="apgo-daily-gift__title">{{ title_text }}</p>
      {%- if subtitle_text != blank -%}
        <p class="apgo-daily-gift__sub">{{ subtitle_text }}</p>
      {%- endif -%}
      <div class="apgo-daily-gift__timer-row">
        <span class="apgo-daily-gift__timer-label">{{ timer_label }}</span>
        <span class="apgo-daily-gift__timer" data-apgo-daily-gift-timer>--:--:--</span>
      </div>
    </div>
  </div>
</aside>

<style>
  .apgo-daily-gift {
    position: fixed;
    left: 12px;
    bottom: 90px;
    z-index: 90000;
    max-width: 280px;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(15, 15, 15, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(240, 132, 24, 0.45);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(240, 132, 24, 0.15) inset;
    color: #fff;
    opacity: 0;
    transform: translateY(20px) scale(0.96);
    transition: opacity .35s cubic-bezier(.16,1,.3,1), transform .35s cubic-bezier(.16,1,.3,1);
    pointer-events: none;
  }
  .apgo-daily-gift[hidden] { display: none !important; }
  .apgo-daily-gift.is-visible { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
  .apgo-daily-gift::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, #f08418, #ff9a3c);
    border-top-left-radius: 14px; border-top-right-radius: 14px;
  }
  .apgo-daily-gift__close {
    position: absolute; top: 4px; right: 4px;
    width: 22px; height: 22px;
    border: 0; padding: 0; border-radius: 4px;
    background: transparent; color: rgba(255, 255, 255, 0.6); cursor: pointer;
    display: grid; place-items: center;
  }
  .apgo-daily-gift__close:hover { color: #fff; }
  .apgo-daily-gift__inner { display: flex; align-items: center; gap: 10px; }
  .apgo-daily-gift__emoji {
    flex: 0 0 auto; width: 56px; height: 56px; border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    display: grid; place-items: center; font-size: 32px; line-height: 1;
  }
  .apgo-daily-gift__body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .apgo-daily-gift__badge {
    align-self: flex-start; display: inline-block; padding: 1px 7px; border-radius: 999px;
    background: linear-gradient(45deg, #f08418, #ff9a3c); color: #fff;
    font-size: 9px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 2px;
  }
  .apgo-daily-gift__title { margin: 0; font-size: 13px; font-weight: 700; color: #fff; line-height: 1.3; }
  .apgo-daily-gift__sub { margin: 1px 0 0; font-size: 11px; color: rgba(255, 255, 255, 0.6); line-height: 1.3; }
  .apgo-daily-gift__timer-row { display: flex; align-items: center; gap: 6px; margin-top: 4px; font-size: 11px; }
  .apgo-daily-gift__timer-label { color: rgba(255, 255, 255, 0.6); }
  .apgo-daily-gift__timer { font-weight: 700; color: #f08418; font-variant-numeric: tabular-nums; letter-spacing: 0.04em; }
  @media (min-width: 750px) {
    .apgo-daily-gift { left: 24px; bottom: 24px; max-width: 320px; padding: 14px 16px; }
    .apgo-daily-gift__title { font-size: 14px; }
    .apgo-daily-gift__sub { font-size: 12px; }
  }
</style>

<script>
(function () {
  'use strict';
  var root = document.querySelector('[data-apgo-daily-gift]');
  if (!root) return;
  var startStr = root.getAttribute('data-start') || '';
  var endStr   = root.getAttribute('data-end')   || '';
  var dailyEnd = root.getAttribute('data-daily-end-time') || '23:59';
  var tz       = root.getAttribute('data-tz-offset') || '+08:00';
  var storageKey = root.getAttribute('data-storage-key');

  function myTodayStr() {
    var now = new Date(Date.now() + 8 * 3600 * 1000);
    return now.getUTCFullYear() + '-' +
           String(now.getUTCMonth() + 1).padStart(2, '0') + '-' +
           String(now.getUTCDate()).padStart(2, '0');
  }

  var today = myTodayStr();
  if (startStr && today < startStr) return;
  if (endStr && today > endStr) return;
  try { if (storageKey && localStorage.getItem(storageKey) === today) return; } catch (_) {}

  var timerEl = root.querySelector('[data-apgo-daily-gift-timer]');
  var closeEl = root.querySelector('[data-apgo-daily-gift-close]');

  function endOfDayMs() {
    var iso = today + 'T' + dailyEnd + ':00' + tz;
    var t = Date.parse(iso);
    if (t <= Date.now()) t += 24 * 3600 * 1000;
    return t;
  }
  var endMs = endOfDayMs();

  function pad(n) { return n < 10 ? '0' + n : '' + n; }
  function render() {
    var diff = endMs - Date.now();
    if (diff <= 0) {
      var nowToday = myTodayStr();
      if (endStr && nowToday > endStr) { root.remove(); return false; }
      today = nowToday;
      endMs = endOfDayMs();
      diff = endMs - Date.now();
    }
    var h = Math.floor(diff / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    timerEl.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
    return true;
  }
  if (!render()) return;

  root.removeAttribute('hidden');
  setTimeout(function () { root.classList.add('is-visible'); }, 400);
  setInterval(render, 1000);

  closeEl && closeEl.addEventListener('click', function () {
    root.classList.remove('is-visible');
    setTimeout(function () { root.setAttribute('hidden', ''); }, 350);
    try { if (storageKey) localStorage.setItem(storageKey, today); } catch (_) {}
  });
})();
</script>
