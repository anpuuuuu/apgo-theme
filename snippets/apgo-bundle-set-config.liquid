{%- doc -%}
  Which "any N packs" set a bundle product sells in this market, for the
  bundle picker, the product subtitle and the cart. Prints
  "kind|count|price_cents|free_ship" or nothing:
    vb  — theme settings → APGO — Value Bundle (any 4): its own Malaysia
          and Singapore products (11.11, 2026-11-05). Malaysia has a set
          price; Singapore's set costs N × its single price.
    set — theme settings → APGO — Bundle Widget → Set offer (any 3 for
          RM99, Malaysia only), for every other bundle-enabled product
          while snippets/apgo-bundle-set-offer is on.
  free_ship is 1 when the set comes with free shipping (shown on the card,
  counted by the cart); the real discounts, gifts and free shipping are
  Shopify's / AIOD's. Capture it and split on "|".

  @param {product} product - The bundle product.
{%- enddoc -%}
{%- liquid
  assign apgo_cfg_sg = false
  if localization.country.iso_code == 'SG'
    assign apgo_cfg_sg = true
  endif
  assign apgo_cfg_vb = false
  if product != blank
    if apgo_cfg_sg and settings.apgo_vb_product_sg != blank and product.id == settings.apgo_vb_product_sg.id
      assign apgo_cfg_vb = true
    elsif apgo_cfg_sg == false and settings.apgo_vb_product_my != blank and product.id == settings.apgo_vb_product_my.id
      assign apgo_cfg_vb = true
    endif
  endif

  if apgo_cfg_vb
    assign apgo_cfg_count = settings.apgo_vb_count | default: 4
    if apgo_cfg_sg
      assign apgo_cfg_price = product.price | times: apgo_cfg_count
    else
      assign apgo_cfg_price = settings.apgo_vb_price_my | strip | times: 100 | round
    endif
    assign apgo_cfg_ship = 0
    if settings.apgo_vb_free_ship
      assign apgo_cfg_ship = 1
    endif
    echo 'vb|' | append: apgo_cfg_count | append: '|' | append: apgo_cfg_price | append: '|' | append: apgo_cfg_ship
  elsif product != blank and product.metafields.apgo.bundle_enabled
    capture apgo_cfg_set_on
      render 'apgo-bundle-set-offer'
    endcapture
    if apgo_cfg_set_on == 'on'
      assign apgo_cfg_count = settings.apgo_bundle_set_count | default: 3
      assign apgo_cfg_price = settings.apgo_bundle_set_price_my | strip | times: 100 | round
      assign apgo_cfg_ship = 0
      if settings.apgo_bundle_set_free_ship_my
        assign apgo_cfg_ship = 1
      endif
      echo 'set|' | append: apgo_cfg_count | append: '|' | append: apgo_cfg_price | append: '|' | append: apgo_cfg_ship
    endif
  endif
-%}
