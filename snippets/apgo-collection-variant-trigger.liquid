{%- doc -%}
  Collection card: one + opens APGO variant drawer (same UI as apgo_product_page), not quick-add.

  @param {object} product - Product object
  @param {object} selected_variant - Variant to pre-select (e.g. listing bundle pick)
{%- enddoc -%}

{%- comment -%}
  Per-product opt-out: products with metafield custom.hide_quick_add = true
  render NO + trigger (e.g. the detergent bundle promo, which must be
  bought through its PDP scent/tier picker, not a bare variant add).
{%- endcomment -%}
{%- if product.metafields.custom.hide_quick_add.value -%}
  {%- comment -%} quick add disabled for this product {%- endcomment -%}
{%- else -%}
{% capture apgo_coll_drawer_json %}
{
  "product_id": {{ product.id }},
  "handle": {{ product.handle | json }},
  "title": {{ product.title | json }},
  "subtitle": {{ product.metafields.apgo.subtitle.value | default: '' | json }},
  "currency": {{ cart.currency.iso_code | json }},
  "featured_image": {% if product.featured_media %}{{ product.featured_media | image_url: width: 800 | json }}{% else %}null{% endif %},
  "featured_image_high": {% if product.featured_media %}{{ product.featured_media | image_url: width: 1200 | json }}{% else %}null{% endif %},
  "variants": [
    {% for v in product.variants %}
      {
        "id": {{ v.id }},
        "title": {{ v.title | json }},
        "price_cents": {{ v.price }},
        "available": {{ v.available }},
        "inventory_quantity": {{ v.inventory_quantity | default: 0 }},
        "show_inventory": {% if v.metafields.custom.show_inventory.value %}true{% else %}false{% endif %},
        "featured_image": {% if v.featured_media %}{{ v.featured_media | image_url: width: 800 | json }}{% else %}null{% endif %},
        "featured_image_high": {% if v.featured_media %}{{ v.featured_media | image_url: width: 1200 | json }}{% else %}null{% endif %},
        "is_bundle": {% if v.metafields.apgo.is_bundle.value %}true{% else %}false{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
{% endcapture %}

<div class="apgo-coll-drawer-pack">
  <script type="application/json" class="apgo-coll-drawer-json">{{ apgo_coll_drawer_json | strip }}</script>
  <button
    type="button"
    class="apgo-coll-drawer-open"
    data-apgo-collection-drawer-open
    data-initial-variant-id="{{ selected_variant.id }}"
    aria-label="{{ 'product.select_variant' | t }}"
  >
    <span class="svg-wrapper apgo-coll-drawer-open__icon" aria-hidden="true">
      {{- 'icon-plus.svg' | inline_asset_content -}}
    </span>
  </button>
</div>

{%- endif -%}

{% stylesheet %}
  .apgo-coll-drawer-pack {
    flex: 0 0 auto;
    align-self: flex-end;
  }

  .apgo-coll-drawer-open {
    --apgo-atc-orange: #f08418;

    display: inline-grid;
    place-items: center;
    min-width: 2.25rem;
    min-height: 2.25rem;
    padding: 0.2rem;
    margin: 0;
    border: none;
    border-radius: 0;
    cursor: pointer;
    background: none;
    color: var(--color-foreground);
    box-shadow: none;
    opacity: 0.72;
    line-height: 0;
    outline: none;
    -webkit-tap-highlight-color: transparent;
  }

  .apgo-coll-drawer-open:hover,
  .apgo-coll-drawer-open:focus-visible {
    opacity: 1;
    color: var(--apgo-atc-orange);
  }

  .apgo-coll-drawer-open:focus-visible {
    outline: 2px solid var(--apgo-atc-orange);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .apgo-coll-drawer-open__icon,
  .apgo-coll-drawer-open__icon svg {
    width: 1.08em;
    height: 1.08em;
    display: block;
  }

  .apgo-coll-drawer-open__icon svg {
    --icon-stroke-width: 2.25px;
  }

{% endstylesheet %}
