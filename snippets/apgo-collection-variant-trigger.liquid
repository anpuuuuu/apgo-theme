{%- doc -%}
  Collection card: one + opens APGO variant drawer (same UI as apgo_product_page), not quick-add.

  @param {object} product - Product object
  @param {object} selected_variant - Variant to pre-select (e.g. listing bundle pick)
{%- enddoc -%}

{% capture apgo_coll_drawer_json %}
{
  "product_id": {{ product.id }},
  "handle": {{ product.handle | json }},
  "title": {{ product.title | json }},
  "subtitle": {{ product.metafields.apgo.subtitle.value | default: '' | json }},
  "currency": {{ cart.currency.iso_code | json }},
  "featured_image": {% if product.featured_media %}{{ product.featured_media | image_url: width: 800 | json }}{% else %}null{% endif %},
  "featured_image_high": {% if product.featured_media %}{{ product.featured_media | image_url: width: 1200 | json }}{% else %}null{% endif %},
  "variants": [
    {% for v in product.variants %}
      {
        "id": {{ v.id }},
        "title": {{ v.title | json }},
        "price_cents": {{ v.price }},
        "available": {{ v.available }},
        "inventory_quantity": {{ v.inventory_quantity | default: 0 }},
        "show_inventory": {% if v.metafields.custom.show_inventory.value %}true{% else %}false{% endif %},
        "featured_image": {% if v.featured_media %}{{ v.featured_media | image_url: width: 800 | json }}{% else %}null{% endif %},
        "featured_image_high": {% if v.featured_media %}{{ v.featured_media | image_url: width: 1200 | json }}{% else %}null{% endif %},
        "is_bundle": {% if v.metafields.apgo.is_bundle.value %}true{% else %}false{% endif %}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
{% endcapture %}

<div class="apgo-coll-drawer-pack">
  <script type="application/json" class="apgo-coll-drawer-json">{{ apgo_coll_drawer_json | strip }}</script>
  <button
    type="button"
    class="apgo-coll-drawer-open"
    data-apgo-collection-drawer-open
    data-initial-variant-id="{{ selected_variant.id }}"
    aria-label="{{ 'product.select_variant' | t }}"
  >
    <span class="svg-wrapper apgo-coll-drawer-open__icon" aria-hidden="true">
      {{- 'icon-plus.svg' | inline_asset_content -}}
    </span>
  </button>
</div>

{% stylesheet %}
  .apgo-coll-drawer-pack {
    flex: 0 0 auto;
    align-self: flex-end;
  }

  .apgo-coll-drawer-open {
    --apgo-atc-orange: #f08418;
    --apgo-atc-orange-soft: rgba(240, 132, 24, 0.36);
    --apgo-atc-glow: rgba(240, 132, 24, 0.34);

    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0.28rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    cursor: pointer;
    background-color: var(--color-background);
    color: var(--color-foreground);
    box-shadow: var(--shadow-popover);
    opacity: 0.72;
    transition:
      opacity 0.28s ease,
      background-color 0.28s ease,
      border-color 0.28s ease,
      color 0.28s ease,
      box-shadow 0.32s ease,
      transform 0.22s ease;
  }

  .apgo-coll-drawer-open::before {
    content: '';
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
    /* Ring glow only — avoid bright center over the + */
    background: radial-gradient(
      circle at 50% 50%,
      transparent 52%,
      var(--apgo-atc-glow) 58%,
      rgba(240, 132, 24, 0.12) 70%,
      transparent 78%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .apgo-coll-drawer-open__icon {
    position: relative;
    z-index: 1;
  }

  .apgo-coll-drawer-open:hover,
  .apgo-coll-drawer-open:focus-visible {
    opacity: 1;
    background-color: var(--apgo-atc-orange-soft);
    border-color: rgba(240, 132, 24, 0.2);
    color: #fff;
    box-shadow: var(--shadow-popover);
    transform: scale(1.06);
    outline: none;
  }

  .apgo-coll-drawer-open:hover .apgo-coll-drawer-open__icon,
  .apgo-coll-drawer-open:focus-visible .apgo-coll-drawer-open__icon {
    filter: drop-shadow(0 0 0.35px rgba(0, 0, 0, 0.55)) drop-shadow(0 0.5px 0 rgba(0, 0, 0, 0.25));
  }

  .apgo-coll-drawer-open:hover::before,
  .apgo-coll-drawer-open:focus-visible::before {
    opacity: 1;
  }

  .apgo-coll-drawer-open:active {
    transform: scale(0.98);
  }

  .apgo-coll-drawer-open__icon,
  .apgo-coll-drawer-open__icon svg {
    width: 1.1em;
    height: 1.1em;
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .apgo-coll-drawer-open,
    .apgo-coll-drawer-open::before {
      transition-duration: 0.01ms;
    }

    .apgo-coll-drawer-open:hover,
    .apgo-coll-drawer-open:focus-visible {
      transform: none;
    }
  }
{% endstylesheet %}
