{% doc %}
  @prompt
    我想要有一个次级菜单在header
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-secondary-menu-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    padding: {{ block.settings.padding_vertical }}px 0;
  }

  .ai-secondary-menu-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-secondary-menu-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: {{ block.settings.alignment }};
    align-items: center;
    gap: {{ block.settings.item_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-secondary-menu-link-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    text-transform: {{ block.settings.text_transform }};
    transition: color 0.3s ease;
    white-space: nowrap;
  }

  .ai-secondary-menu-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-secondary-menu-nav-{{ ai_gen_id }} {
      justify-content: {{ block.settings.mobile_alignment }};
      gap: {{ block.settings.mobile_item_spacing }}px;
    }

    .ai-secondary-menu-link-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_font_size }}px;
    }
  }
{% endstyle %}

<secondary-menu-{{ ai_gen_id }} class="ai-secondary-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-secondary-menu-container-{{ ai_gen_id }}">
    <nav class="ai-secondary-menu-nav-{{ ai_gen_id }}" role="navigation" aria-label="次级导航">
      {% if block.settings.link_1_text != blank %}
        <a href="{{ block.settings.link_1_url }}" class="ai-secondary-menu-link-{{ ai_gen_id }}">
          {{ block.settings.link_1_text }}
        </a>
      {% endif %}

      {% if block.settings.link_2_text != blank %}
        <a href="{{ block.settings.link_2_url }}" class="ai-secondary-menu-link-{{ ai_gen_id }}">
          {{ block.settings.link_2_text }}
        </a>
      {% endif %}

      {% if block.settings.link_3_text != blank %}
        <a href="{{ block.settings.link_3_url }}" class="ai-secondary-menu-link-{{ ai_gen_id }}">
          {{ block.settings.link_3_text }}
        </a>
      {% endif %}

      {% if block.settings.link_4_text != blank %}
        <a href="{{ block.settings.link_4_url }}" class="ai-secondary-menu-link-{{ ai_gen_id }}">
          {{ block.settings.link_4_text }}
        </a>
      {% endif %}

      {% if block.settings.link_5_text != blank %}
        <a href="{{ block.settings.link_5_url }}" class="ai-secondary-menu-link-{{ ai_gen_id }}">
          {{ block.settings.link_5_text }}
        </a>
      {% endif %}

      {% if block.settings.link_6_text != blank %}
        <a href="{{ block.settings.link_6_url }}" class="ai-secondary-menu-link-{{ ai_gen_id }}">
          {{ block.settings.link_6_text }}
        </a>
      {% endif %}

      {% if block.settings.link_7_text != blank %}
        <a href="{{ block.settings.link_7_url }}" class="ai-secondary-menu-link-{{ ai_gen_id }}">
          {{ block.settings.link_7_text }}
        </a>
      {% endif %}

      {% if block.settings.link_8_text != blank %}
        <a href="{{ block.settings.link_8_url }}" class="ai-secondary-menu-link-{{ ai_gen_id }}">
          {{ block.settings.link_8_text }}
        </a>
      {% endif %}
    </nav>
  </div>
</secondary-menu-{{ ai_gen_id }}>

<script>
  (function() {
    class SecondaryMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.highlightCurrentPage();
      }

      highlightCurrentPage() {
        const currentPath = window.location.pathname;
        const links = this.querySelectorAll('.ai-secondary-menu-link-{{ ai_gen_id }}');
        
        links.forEach(link => {
          const linkPath = new URL(link.href).pathname;
          if (linkPath === currentPath) {
            link.style.color = '{{ block.settings.text_hover_color }}';
          }
        });
      }
    }

    customElements.define('secondary-menu-{{ ai_gen_id }}', SecondaryMenu{{ ai_gen_id }});
  })();
</script>

