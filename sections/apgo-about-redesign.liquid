{%- liquid
  # Hero 影片來源優先順序：
  # 1) Shopify 檔案庫挑選的 video（section.settings.hero_video，type: video）
  # 2) 編輯器手貼的 video URL（section.settings.hero_video_url，type: text，可以是任意 .mp4 直連）
  # 沒有任何來源時保留空字串 → <source src=""> 不渲染影片，避免又回到舊片
  assign hero_video_src = ''
  if section.settings.hero_video != blank
    for source in section.settings.hero_video.sources
      if source.format == 'mp4'
        assign hero_video_src = source.url
        break
      endif
    endfor
    if hero_video_src == blank and section.settings.hero_video.sources.first
      assign hero_video_src = section.settings.hero_video.sources.first.url
    endif
  endif
  if hero_video_src == blank and section.settings.hero_video_url != blank
    assign hero_video_src = section.settings.hero_video_url | strip
  endif
-%}
<section class="apgo-about-page">
  <section class="apgo-hero-video" id="apgoHeroVideoSection">
    {%- if hero_video_src != blank -%}
    <video
      id="apgoAboutVideo"
      class="apgo-about-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      {%- if section.settings.hero_video_poster != blank %} poster="{{ section.settings.hero_video_poster | image_url: width: 1600 }}"{% endif -%}
    >
      <source src="{{ hero_video_src }}" type="video/mp4">
    </video>
    {%- endif -%}
    <div class="apgo-video-controls">
      <button type="button" id="apgoSoundToggle" class="apgo-video-control-btn" aria-label="Toggle sound">🔇</button>
      <button type="button" id="apgoFullscreenToggle" class="apgo-video-control-btn" aria-label="Fullscreen">⛶</button>
    </div>
    <div class="apgo-video-overlay"></div>
  </section>

  <section class="apgo-brand-philosophy">
    <h2>Behind every APGO product is a team committed to quality.</h2>
    <p>
      From product development and testing to packaging and delivery, every step is carefully executed to ensure consistency and performance.
      We believe great results don't happen by chance - they are built through dedication, experience, and attention to detail.
    </p>
  </section>

  <section class="apgo-vm-section">
    <article class="apgo-vm-card">
      <div class="apgo-vm-heading">
        <span class="apgo-vm-icon">&gt;&gt;</span>
        <h3>VISION</h3>
      </div>
      <p>To redefine modern car care by setting new standards in performance, quality, and user experience worldwide.</p>
    </article>

    <article class="apgo-vm-card">
      <div class="apgo-vm-heading">
        <span class="apgo-vm-icon">&gt;&gt;</span>
        <h3>MISSION</h3>
      </div>
      <p>We aim to engineer premium car care products and make professional detailing results accessible to every car owner.</p>
    </article>
  </section>
</section>

<style>
  .apgo-about-page {
    background: #000;
    color: #fff;
    font-family: Arial, 'Helvetica Neue', sans-serif;
  }

  .apgo-hero-video {
    position: relative;
    width: 100%;
    aspect-ratio: 1980 / 1020;
    height: auto;
    overflow: hidden;
    background: #050505;
    border-bottom: 1px solid rgba(240, 132, 24, 0.25);
  }

  .apgo-about-video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: none;
  }

  .apgo-video-overlay {
    display: none;
  }

  .apgo-video-controls {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: flex;
    gap: 8px;
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 2;
  }

  .apgo-hero-video:hover .apgo-video-controls,
  .apgo-hero-video:focus-within .apgo-video-controls {
    opacity: 1;
  }

  .apgo-video-control-btn {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(0, 0, 0, 0.45);
    color: #ffffff;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .apgo-video-control-btn:hover {
    background: rgba(0, 0, 0, 0.65);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .apgo-brand-philosophy {
    max-width: 980px;
    margin: 0 auto;
    padding: 72px 24px 56px;
    text-align: center;
  }

  .apgo-brand-philosophy h2 {
    font-size: clamp(1.5rem, 2.7vw, 2.45rem);
    line-height: 1.35;
    margin-bottom: 22px;
    letter-spacing: 0.02em;
  }

  .apgo-brand-philosophy p {
    color: #d2d2d2;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.9;
    max-width: 860px;
    margin: 0 auto;
  }

  .apgo-vm-section {
    max-width: 1220px;
    margin: 0 auto;
    padding: 8px 24px 92px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .apgo-vm-card {
    background: radial-gradient(circle at top right, rgba(240, 132, 24, 0.1), rgba(0, 0, 0, 0.9) 56%);
    border: 1px solid rgba(240, 132, 24, 0.34);
    border-radius: 20px;
    padding: 34px 30px;
    box-shadow: 0 0 24px rgba(240, 132, 24, 0.18);
    transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
  }

  .apgo-vm-card:hover {
    transform: translateY(-4px) scale(1.015);
    box-shadow: 0 0 34px rgba(240, 132, 24, 0.32);
    border-color: rgba(240, 132, 24, 0.7);
  }

  .apgo-vm-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .apgo-vm-icon {
    font-size: 0.95rem;
    font-weight: 700;
    color: #f08418;
  }

  .apgo-vm-card h3 {
    margin: 0;
    font-size: 1.35rem;
    letter-spacing: 0.08em;
  }

  .apgo-vm-card p {
    margin: 0;
    color: #d8d8d8;
    line-height: 1.8;
    font-size: 1rem;
  }

  @media (max-width: 900px) {
    .apgo-vm-section {
      grid-template-columns: 1fr;
      padding-bottom: 70px;
    }

    .apgo-hero-video {
      aspect-ratio: 1980 / 1020;
      height: auto;
    }

    .apgo-video-controls {
      opacity: 1;
      right: 10px;
      bottom: 10px;
    }
  }
</style>

<script>
  (function () {
    const video = document.getElementById('apgoAboutVideo');
    const section = document.getElementById('apgoHeroVideoSection');
    const soundToggle = document.getElementById('apgoSoundToggle');
    const fullscreenToggle = document.getElementById('apgoFullscreenToggle');
    if (!video || !section || !soundToggle || !fullscreenToggle) return;

    video.muted = true;
    soundToggle.textContent = '🔇';

    soundToggle.addEventListener('click', () => {
      video.muted = !video.muted;
      soundToggle.textContent = video.muted ? '🔇' : '🔊';
    });

    fullscreenToggle.addEventListener('click', async () => {
      if (!document.fullscreenElement && section.requestFullscreen) {
        try {
          await section.requestFullscreen();
        } catch (e) {
          // Ignore browser/user-gesture restrictions.
        }
      } else if (document.exitFullscreen) {
        await document.exitFullscreen();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "About Us Redesign",
  "settings": [
    {
      "type": "header",
      "content": "Hero video"
    },
    {
      "type": "video",
      "id": "hero_video",
      "label": "Hero video (from Files)",
      "info": "優先使用此處選擇的影片。若留空則改用下方 URL；都留空則用內建預設影片。"
    },
    {
      "type": "text",
      "id": "hero_video_url",
      "label": "Hero video URL (fallback)",
      "info": "貼上 .mp4 直連 URL（例如 Shopify Files 的 cdn.shopify.com/... 連結）。僅在上方未選擇影片時生效。改成純文字輸入，避免 type:url 的內部資源轉換造成連結讀不到。"
    },
    {
      "type": "image_picker",
      "id": "hero_video_poster",
      "label": "Hero video poster image",
      "info": "影片載入或暫停時顯示的封面圖。可留空。"
    }
  ],
  "presets": [
    {
      "name": "About Us Redesign"
    }
  ]
}
{% endschema %}
