<section class="apgo-about-page">
  <section class="apgo-hero-video" id="apgoHeroVideoSection">
    <video
      id="apgoAboutVideo"
      class="apgo-about-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src="https://cdn.shopify.com/videos/c/o/v/9436e1292daf44e0b1b81614e9def543.mp4" type="video/mp4">
    </video>
    <div class="apgo-video-controls">
      <button type="button" id="apgoSoundToggle" class="apgo-video-control-btn" aria-label="Toggle sound">🔇</button>
      <button type="button" id="apgoFullscreenToggle" class="apgo-video-control-btn" aria-label="Fullscreen">⛶</button>
    </div>
    <div class="apgo-video-overlay"></div>
  </section>

  <section class="apgo-brand-philosophy">
    <h2>Behind every APGO product is a team committed to quality.</h2>
    <p>
      From product development and testing to packaging and delivery, every step is carefully executed to ensure consistency and performance.
      We believe great results don't happen by chance - they are built through dedication, experience, and attention to detail.
    </p>
  </section>

  <section class="apgo-vm-section">
    <article class="apgo-vm-card">
      <div class="apgo-vm-heading">
        <span class="apgo-vm-icon">&gt;&gt;</span>
        <h3>VISION</h3>
      </div>
      <p>To redefine modern car care by setting new standards in performance, quality, and user experience worldwide.</p>
    </article>

    <article class="apgo-vm-card">
      <div class="apgo-vm-heading">
        <span class="apgo-vm-icon">&gt;&gt;</span>
        <h3>MISSION</h3>
      </div>
      <p>We aim to engineer premium car care products and make professional detailing results accessible to every car owner.</p>
    </article>
  </section>
</section>

<style>
  .apgo-about-page {
    background: #000;
    color: #fff;
    font-family: Arial, 'Helvetica Neue', sans-serif;
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .apgo-about-page > section {
    position: relative;
    z-index: 1;
  }

  /* 輕量橘色微粒：由下往上漂，全 section 背景層 */
  .apgo-about-page::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle, rgba(240, 132, 24, 0.5) 1px, transparent 1.8px),
      radial-gradient(circle, rgba(255, 170, 90, 0.38) 1px, transparent 2px),
      radial-gradient(circle, rgba(240, 132, 24, 0.32) 1.2px, transparent 2.2px),
      radial-gradient(circle, rgba(255, 154, 60, 0.42) 0.8px, transparent 1.6px),
      radial-gradient(circle, rgba(240, 132, 24, 0.28) 1px, transparent 2px);
    background-size:
      140px 220px,
      180px 260px,
      110px 190px,
      160px 240px,
      200px 280px;
    background-position:
      10% 100%,
      35% 100%,
      58% 100%,
      78% 100%,
      92% 100%;
    background-repeat: repeat;
    opacity: 0.82;
    animation: apgo-about-particles-rise 22s linear infinite;
  }

  @keyframes apgo-about-particles-rise {
    0% {
      transform: translateY(14%);
      opacity: 0.62;
    }
    50% {
      opacity: 0.92;
    }
    100% {
      transform: translateY(-18%);
      opacity: 0.68;
    }
  }

  .apgo-hero-video {
    position: relative;
    width: 100%;
    aspect-ratio: 1980 / 1020;
    height: auto;
    overflow: hidden;
    background: #050505;
    border-bottom: 1px solid rgba(240, 132, 24, 0.25);
  }

  .apgo-about-video {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: none;
  }

  .apgo-video-overlay {
    display: none;
  }

  .apgo-video-controls {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: flex;
    gap: 8px;
    opacity: 0;
    transition: opacity 0.2s ease;
    z-index: 2;
  }

  .apgo-hero-video:hover .apgo-video-controls,
  .apgo-hero-video:focus-within .apgo-video-controls {
    opacity: 1;
  }

  .apgo-video-control-btn {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(0, 0, 0, 0.45);
    color: #ffffff;
    font-size: 14px;
    line-height: 1;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .apgo-video-control-btn:hover {
    background: rgba(0, 0, 0, 0.65);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .apgo-brand-philosophy {
    max-width: 980px;
    margin: 0 auto;
    padding: 72px 24px 56px;
    text-align: center;
  }

  .apgo-brand-philosophy h2 {
    font-size: clamp(1.5rem, 2.7vw, 2.45rem);
    line-height: 1.35;
    margin-bottom: 22px;
    letter-spacing: 0.02em;
  }

  .apgo-brand-philosophy p {
    color: #d2d2d2;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.9;
    max-width: 860px;
    margin: 0 auto;
  }

  .apgo-vm-section {
    max-width: 1220px;
    margin: 0 auto;
    padding: 8px 24px 92px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .apgo-vm-card {
    background: radial-gradient(circle at top right, rgba(240, 132, 24, 0.1), rgba(0, 0, 0, 0.9) 56%);
    border: 1px solid rgba(240, 132, 24, 0.34);
    border-radius: 20px;
    padding: 34px 30px;
    box-shadow: 0 0 24px rgba(240, 132, 24, 0.18);
    transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
  }

  .apgo-vm-card:hover {
    transform: translateY(-4px) scale(1.015);
    box-shadow: 0 0 34px rgba(240, 132, 24, 0.32);
    border-color: rgba(240, 132, 24, 0.7);
  }

  .apgo-vm-heading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }

  .apgo-vm-icon {
    font-size: 0.95rem;
    font-weight: 700;
    color: #f08418;
  }

  .apgo-vm-card h3 {
    margin: 0;
    font-size: 1.35rem;
    letter-spacing: 0.08em;
  }

  .apgo-vm-card p {
    margin: 0;
    color: #d8d8d8;
    line-height: 1.8;
    font-size: 1rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .apgo-about-page::before {
      animation: none;
      opacity: 0.32;
    }
  }

  @media (max-width: 900px) {
    .apgo-vm-section {
      grid-template-columns: 1fr;
      padding-bottom: 70px;
    }

    .apgo-hero-video {
      aspect-ratio: 1980 / 1020;
      height: auto;
    }

    .apgo-video-controls {
      opacity: 1;
      right: 10px;
      bottom: 10px;
    }
  }
</style>

<script>
  (function () {
    const video = document.getElementById('apgoAboutVideo');
    const section = document.getElementById('apgoHeroVideoSection');
    const soundToggle = document.getElementById('apgoSoundToggle');
    const fullscreenToggle = document.getElementById('apgoFullscreenToggle');
    if (!video || !section || !soundToggle || !fullscreenToggle) return;

    video.muted = true;
    soundToggle.textContent = '🔇';

    soundToggle.addEventListener('click', () => {
      video.muted = !video.muted;
      soundToggle.textContent = video.muted ? '🔇' : '🔊';
    });

    fullscreenToggle.addEventListener('click', async () => {
      if (!document.fullscreenElement && section.requestFullscreen) {
        try {
          await section.requestFullscreen();
        } catch (e) {
          // Ignore browser/user-gesture restrictions.
        }
      } else if (document.exitFullscreen) {
        await document.exitFullscreen();
      }
    });
  })();
</script>

