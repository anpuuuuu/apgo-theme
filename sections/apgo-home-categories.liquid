{% comment %}
  APGO Home — category tiles (2026-09 homepage redesign). Icon, name and item
  count per collection. Phones: 3 per row with a "View all" link in the
  header. Desktop: 5 per row, and the "All products" tile takes the place of
  that link.

  Counts skip products locked to the other market (custom.only_market), the
  same rule the catalog uses; a tile whose collection is empty or missing is
  hidden (e.g. Beginner's Picks until it is stocked). The "All products"
  tile also shows on phones when the other tiles leave the last row short.

  v2: an optional "Featured category" block draws one wide tile first
  (full row on phones, two columns on desktop), e.g. Beginner's Picks. With
  it on the page, desktop drops the "All products" tile (the header link
  "All N products" covers it) so the grid stays two full rows of five.
{% endcomment %}

{%- liquid
  assign cats_market = localization.country.iso_code
  assign cats_phone_count = 0
  assign cats_has_featured = false
-%}

{%- capture cats_tiles -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign tile_count = 0
      assign tile_label = block.settings.label | strip
      assign tile_link = block.settings.link
      assign tile_handle = ''
      assign tile_phone = block.settings.show_on_mobile
      assign tile_no_desktop = false

      if block.type == 'featured'
        assign tile_collection = block.settings.collection
        if tile_collection != blank
          for p in tile_collection.products limit: 50
            assign tile_pm = p.metafields.custom.only_market.value | strip | upcase
            if tile_pm != blank and cats_market != tile_pm
              continue
            endif
            assign tile_count = tile_count | plus: 1
          endfor
        endif
        if tile_count == 0
          continue
        endif
        assign cats_has_featured = true
        assign tile_title = block.settings.title | strip | default: tile_collection.title
        if tile_link == blank
          assign tile_link = tile_collection.url
        endif
      endif
    -%}
    {%- if block.type == 'featured' -%}
      <li class="apgo-home-cats__item apgo-home-cats__item--featured" {{ block.shopify_attributes }}>
        <a
          class="apgo-home-cats__feature"
          href="{{ tile_link }}"
          data-apgo-home-category
          data-category-handle="{{ tile_collection.handle | escape }}"
          data-category-name="{{ tile_title | escape }}"
          data-position="{{ forloop.index }}"
        >
          <span class="apgo-home-cats__feature-icon">
            {%- render 'apgo-home-icon', name: block.settings.icon, size: 26, stroke: 1.8 -%}
          </span>
          <span class="apgo-home-cats__feature-copy">
            {%- if block.settings.eyebrow != blank -%}
              <span class="apgo-home-cats__feature-eyebrow">{{ block.settings.eyebrow | escape }}</span>
            {%- endif -%}
            <span class="apgo-home-cats__feature-title">{{ tile_title | escape }}</span>
            <span class="apgo-home-cats__feature-count">
              {{- tile_count }}
              {% if tile_count == 1 %}item{% else %}items{% endif -%}
            </span>
          </span>
          <span class="apgo-home-cats__feature-arrow">
            {%- render 'apgo-home-icon', name: 'arrow-right', size: 22, stroke: 2 -%}
          </span>
        </a>
      </li>
      {%- continue -%}
    {%- endif -%}
    {%- liquid
      if block.type == 'all_products'
        assign tile_count = collections.all.products_count
        if tile_label == blank
          assign tile_label = 'All Products'
        endif
        if tile_link == blank
          assign tile_link = routes.all_products_collection_url
        endif
        assign tile_handle = 'all'
        if tile_phone == false
          assign cats_phone_remainder = cats_phone_count | modulo: 3
          if cats_phone_remainder != 0
            assign tile_phone = true
          endif
        endif
        if cats_has_featured
          assign tile_no_desktop = true
        endif
      else
        assign tile_collection = block.settings.collection
        if tile_collection != blank
          for p in tile_collection.products limit: 50
            assign tile_pm = p.metafields.custom.only_market.value | strip | upcase
            if tile_pm != blank and cats_market != tile_pm
              continue
            endif
            assign tile_count = tile_count | plus: 1
          endfor
          if tile_label == blank
            assign tile_label = tile_collection.title
          endif
          if tile_link == blank
            assign tile_link = tile_collection.url
          endif
          assign tile_handle = tile_collection.handle
        endif
      endif

      if tile_count == 0
        continue
      endif
      if tile_phone
        assign cats_phone_count = cats_phone_count | plus: 1
      endif
    -%}
    <li class="apgo-home-cats__item{% unless tile_phone %} apgo-home-cats__item--desktop{% endunless %}{% if tile_no_desktop %} apgo-home-cats__item--no-desktop{% endif %}" {{ block.shopify_attributes }}>
      <a
        class="apgo-home-cats__tile"
        href="{{ tile_link }}"
        data-apgo-home-category
        data-category-handle="{{ tile_handle | escape }}"
        data-category-name="{{ tile_label | escape }}"
        data-position="{{ forloop.index }}"
      >
        <span class="apgo-home-cats__icon">
          {%- render 'apgo-home-icon', name: block.settings.icon, size: 32, stroke: 1.5 -%}
        </span>
        <span class="apgo-home-cats__name">{{ tile_label | escape }}</span>
        <span class="apgo-home-cats__count">
          {{- tile_count }}
          {% if tile_count == 1 %}item{% else %}items{% endif -%}
        </span>
      </a>
    </li>
  {%- endfor -%}
{%- endcapture -%}

<script src="{{ 'apgo-campaign-tracking.js' | asset_url }}" defer></script>
<section
  class="apgo-home apgo-home-cats{% if section.settings.background == 'dark' %} apgo-home--dark{% endif %}"
  data-apgo-home-section="categories"
>
  <div class="apgo-hp__container">
    <header class="apgo-hp-head">
      <div class="apgo-hp-head__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="apgo-hp-head__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="apgo-hp-head__title">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.link_label != blank -%}
        <div class="apgo-hp-head__side">
          <a class="apgo-hp-head__link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
            <span class="apgo-hp-head__link-mobile">{{ section.settings.link_label | escape }}</span>
            <span class="apgo-hp-head__link-desktop">
              {{- 'All ' | append: collections.all.products_count | append: ' products' -}}
              {%- render 'apgo-home-icon', name: 'arrow-right', size: 16, stroke: 2 -%}
            </span>
          </a>
        </div>
      {%- endif -%}
    </header>
    <ul class="apgo-home-cats__grid" role="list">
      {{ cats_tiles }}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "APGO Home — Categories",
  "tag": "div",
  "class": "apgo-home-cats-wrapper",
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Browse categories"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Header link on phones",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Header link",
      "info": "Defaults to all products."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "black", "label": "Black" },
        { "value": "dark", "label": "Dark grey" }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "featured",
      "name": "Featured category",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "One wide tile shown first, e.g. Beginner's Picks. Hidden while its collection is empty."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "book", "label": "Book (beginners)" },
            { "value": "drop", "label": "Drop (coatings)" },
            { "value": "gift", "label": "Gift (deals)" },
            { "value": "grid", "label": "Grid" }
          ],
          "default": "book"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small line",
          "default": "New to coating?"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Start with Beginner's Picks",
          "info": "Defaults to the collection title."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to the collection page."
        }
      ]
    },
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "book", "label": "Book (beginners)" },
            { "value": "home", "label": "House (household)" },
            { "value": "drop", "label": "Drop (coatings)" },
            { "value": "gift", "label": "Gift (deals)" },
            { "value": "bottle", "label": "Spray bottle (cleaning)" },
            { "value": "bucket", "label": "Bucket (car wash)" },
            { "value": "target", "label": "Target (restoration)" },
            { "value": "seat", "label": "Seat (interior)" },
            { "value": "sponge", "label": "Sponge (supplies)" },
            { "value": "grid", "label": "Grid (all products)" }
          ],
          "default": "drop"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Name",
          "info": "Defaults to the collection title."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to the collection page. For catalog sections use /collections/all#collection-<handle>."
        },
        {
          "type": "checkbox",
          "id": "show_on_mobile",
          "label": "Show on phones",
          "default": true
        }
      ]
    },
    {
      "type": "all_products",
      "name": "All products",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "grid", "label": "Grid" }
          ],
          "default": "grid"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Name",
          "default": "All Products"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Defaults to all products."
        },
        {
          "type": "checkbox",
          "id": "show_on_mobile",
          "label": "Always show on phones",
          "info": "Off: shows on phones only when it fills a short last row.",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "APGO Home — Categories",
      "category": "APGO"
    }
  ]
}
{% endschema %}
