{% comment %}
  購物車頁-加購推薦區塊
  檔案位置: sections/cart-upsell-recommendations.liquid
{% endcomment %}

<!-- 內聯關鍵樣式防止閃爍 -->
<style>
  /* 移除所有可能的容器背景色 */
  .shopify-section,
  .shopify-section[class*="cart-upsell"],
  [class*="shopify-section-template"][class*="cart_upsell"],
  .section-cart-upsell {
    background-color: transparent !important;
    background: transparent !important;
    background-image: none !important;
  }
  
  /* 確保 wrapper 完全透明 */
  .cart-upsell-wrapper {
    background-color: transparent !important;
    background: transparent !important;
    background-image: none !important;
  }
  
  /* 確保只有內部容器有背景色 */
  .cart-upsell-section {
    background-color: {{ section.settings.loading_bg_color }} !important;
    min-height: 120px;
  }
  
  /* 防止瀏覽器預設的綠色焦點樣式 */
  .cart-upsell-wrapper button:focus,
  .cart-upsell-wrapper a:focus {
    outline: none !important;
    outline-color: transparent !important;
    outline-style: none !important;
  }
</style>

<style>
  /* ========================================
     購物車加購區塊 - AKO 風格設計
     ======================================== */
  
  /* 外層包裝器 — APGO 系統橙與結帳按鈕同款漸變 */
  .cart-upsell-wrapper {
    --apgo-upsell-accent: {{ section.settings.accent_color_start | default: '#f08418' }};
    --apgo-upsell-accent-end: {{ section.settings.accent_color_end | default: '#f7931e' }};
    --apgo-upsell-grad: linear-gradient(135deg, #ff6b35 0%, #f7931e 55%, #ff9a3c 100%);
    width: 100%;
    max-width: 1240px;
    margin: 20px auto 0;
    padding: 0 20px;
    position: relative;
    background: transparent !important;
    background-color: transparent !important;
  }

  /* Product page only: desktop two-thirds width, keep mobile gutters */
  @media (min-width: 769px) {
    .cart-upsell-wrapper.cart-upsell-wrapper--product {
      max-width: min(1200px, 66vw);
    }
  }
  
  /* 頂部標題區域 */
  .upsell-header-outside {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    padding: 0 4px;
  }
  
  /* 標題樣式 - 保持原有設計 */
  .upsell-title-outside {
    font-size: 18px;
    font-weight: 600;
    color: {{ section.settings.text_color }} !important;
    margin: 0;
    position: relative;
    padding-left: 12px;
  }
  
  .upsell-title-outside::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 20px;
    background: {% if section.settings.use_accent_gradient %}
      linear-gradient(135deg, {{ section.settings.accent_color_start }}, {{ section.settings.accent_color_end }})
    {% else %}
      {{ section.settings.accent_color_start }}
    {% endif %} !important;
    border-radius: 2px;
  }
  
  /* 主容器 - 仿 AKO 容器風格 */
  .cart-upsell-section {
    background: transparent !important;
    border-radius: 0;
    box-shadow: none;
    border: none;
    padding: 20px;
    overflow: hidden;
    box-sizing: border-box;
    position: relative;
    will-change: transform;
  }

  /* 頂部橘色線條 - 已移除 */
  .cart-upsell-section::before {
    display: none;
  }
  
  /* 查看熱門加購按鈕 - 放在容器外右下角 */
  .view-popular-btn-wrapper {
    position: absolute;
    bottom: -40px;
    right: 20px;
    z-index: 10;
  }
  
  .view-popular-btn {
    background: transparent !important;
    color: {{ section.settings.accent_color_start }} !important;
    border: 1px solid {{ section.settings.accent_color_start }} !important;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
  }

  .view-popular-btn:hover {
    background: {% if section.settings.use_accent_gradient %}
      linear-gradient(135deg, {{ section.settings.accent_color_start }}, {{ section.settings.accent_color_end }})
    {% else %}
      {{ section.settings.accent_color_start }}
    {% endif %} !important;
    color: #ffffff !important;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(240, 132, 24, 0.3);
  }

  /* 商品滑動容器 */
  .upsell-slider-container {
    position: relative;
    overflow: hidden;
    margin: 0 -20px;
    padding: 0 20px;
  }

  .upsell-slider {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-behavior: smooth;
    padding: 12px 0;
    scrollbar-width: thin;
    scrollbar-color: #f08418 #333333;
    -webkit-overflow-scrolling: touch;
  }

  .upsell-slider::-webkit-scrollbar {
    height: 6px;
  }

  .upsell-slider::-webkit-scrollbar-track {
    background: #333333 !important;
    border-radius: 3px;
  }

  .upsell-slider::-webkit-scrollbar-thumb {
    background: #f08418 !important;
    border-radius: 3px;
  }

  /* 商品卡片 - 橫式佈局 */
  .upsell-product-card {
    flex: 0 0 var(--card-width-desktop, 320px);
    background: linear-gradient(145deg, #2d2d2d, #1a1a1a) !important;
    border: 1px solid #404040 !important;
    border-radius: 10px;
    padding: 16px 10px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .upsell-product-card:hover {
    border-color: #f08418 !important;
    transform: translateY(-4px);
    box-shadow: 
      0 12px 35px rgba(240, 132, 24, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  /* 商品圖片 */
  .upsell-product-image {
    width: 60px;
    height: 70px;
    border-radius: 6px;
    overflow: hidden;
    position: relative;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .upsell-product-image.portrait {
    width: 60px;
    height: 75px;
  }

  .upsell-product-image.landscape {
    width: 70px;
    height: 60px;
  }

  .upsell-product-image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Placeholder SVG 樣式 */
  .upsell-product-image .placeholder-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.3;
    filter: invert(1);
  }

  /* 產品連結樣式 */
  .upsell-product-link {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  .upsell-product-card:hover .upsell-product-title {
    color: #f08418 !important;
  }

  /* 載入狀態樣式 */
  .cart-upsell-section.loading {
    min-height: 150px;
    position: relative;
  }

  .cart-upsell-section.loading::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 40px;
    height: 40px;
    border: 3px solid #333333 !important;
    border-top-color: #f08418 !important;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  /* 商品資訊 */
  .upsell-product-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .upsell-product-title {
    font-size: 13px;
    font-weight: 500;
    color: {{ section.settings.text_color }} !important;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    line-height: 1.3;
  }

  .upsell-product-price {
    font-size: 14px;
    font-weight: 700;
    color: {{ section.settings.accent_color_start }} !important;
    margin: 0;
    text-shadow: 0 0 10px rgba(240, 132, 24, 0.3);
  }

  /* 加入購物車按鈕 */
  .upsell-add-to-cart {
    width: 36px;
    height: 36px;
    background: transparent !important;
    border: 2px solid {{ section.settings.accent_color_start }} !important;
    border-radius: 6px;
    color: {{ section.settings.accent_color_start }} !important;
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    flex-shrink: 0;
    outline: none !important;
    -webkit-tap-highlight-color: transparent;
  }

  .upsell-add-to-cart:focus {
    outline: none !important;
    box-shadow: none !important;
  }

  .upsell-add-to-cart:focus-visible {
    outline: none !important;
    box-shadow: 0 0 0 2px {{ section.settings.accent_color_start }}40 !important;
  }

  .upsell-add-to-cart:active {
    transform: scale(0.95);
  }

  .upsell-add-to-cart * {
    pointer-events: none;
  }

  .upsell-add-to-cart::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: {% if section.settings.use_accent_gradient %}
      linear-gradient(135deg, {{ section.settings.accent_color_start }}, {{ section.settings.accent_color_end }})
    {% else %}
      {{ section.settings.accent_color_start }}
    {% endif %} !important;
    transition: left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 0;
  }

  .upsell-add-to-cart:hover::before {
    left: 0;
  }

  .upsell-add-to-cart span {
    position: relative;
    z-index: 1;
    transition: color 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .upsell-add-to-cart:hover {
    border-color: #f08418 !important;
    color: #ffffff !important;
  }

  .upsell-add-to-cart:hover span {
    color: #ffffff !important;
  }

  .upsell-add-to-cart.loading {
    pointer-events: none;
    opacity: 0.7;
  }

  .upsell-add-to-cart.added {
    border-color: {{ section.settings.accent_color_start }} !important;
    color: {{ section.settings.accent_color_start }} !important;
  }

  .upsell-add-to-cart.added span {
    color: {{ section.settings.accent_color_start }} !important;
  }

  /* 響應式設計 — 手機兩列並排網格 */
  @media (max-width: 768px) {
    .cart-upsell-wrapper {
      padding: 0 16px;
    }

    .upsell-header-outside {
      margin-bottom: 12px;
    }

    .cart-upsell-section {
      padding: 12px;
      border-radius: 12px;
    }

    .upsell-title-outside {
      font-size: 16px;
    }

    .view-popular-btn-wrapper {
      bottom: -50px;
      right: 16px;
    }

    .view-popular-btn {
      padding: 8px 20px;
      font-size: 14px;
    }

    .upsell-slider-container {
      margin: 0;
      padding: 0;
      overflow: visible;
    }

    .upsell-slider {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
      overflow: visible;
      padding: 0;
      scrollbar-width: none;
    }

    .upsell-slider::-webkit-scrollbar {
      display: none;
    }

    .upsell-product-card {
      flex: unset;
      width: auto;
      min-width: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0;
      border-color: #404040 !important;
      border-radius: 10px;
    }

    .upsell-product-card:hover {
      transform: translateY(-2px);
      border-color: #404040 !important;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
    }

    .upsell-product-link {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .upsell-product-image,
    .upsell-product-image.portrait,
    .upsell-product-image.landscape {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      border-radius: 9px 9px 0 0;
      margin: 0;
    }

    .upsell-product-image.portrait {
      aspect-ratio: 4 / 5;
    }

    .upsell-product-image.landscape {
      aspect-ratio: 4 / 3;
    }

    .upsell-product-image img {
      object-fit: cover;
    }

    .upsell-product-info {
      gap: 2px;
      padding: 8px 8px 6px;
    }

    .upsell-product-title {
      font-size: 11px;
      line-height: 1.35;
      -webkit-line-clamp: 2;
    }

    .upsell-product-price {
      font-size: 13px;
      color: var(--apgo-upsell-accent) !important;
      text-shadow: 0 0 8px rgba(240, 132, 24, 0.35);
    }

    .upsell-add-to-cart {
      width: calc(100% - 16px);
      height: 32px;
      margin: 4px 8px 8px;
      align-self: center;
      font-size: 18px;
      border: none !important;
      border-radius: 6px;
      background: var(--apgo-upsell-grad) !important;
      color: #ffffff !important;
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.22),
        0 2px 10px rgba(255, 107, 53, 0.35);
    }

    .upsell-add-to-cart::before {
      display: none;
    }

    .upsell-add-to-cart span {
      color: #ffffff !important;
      font-weight: 700;
    }

    .upsell-add-to-cart:hover,
    .upsell-add-to-cart:active {
      background: linear-gradient(135deg, #ff7a45 0%, #ffa030 55%, #ffb04a 100%) !important;
      color: #ffffff !important;
      border: none !important;
    }

    .upsell-add-to-cart.added {
      background: var(--apgo-upsell-grad) !important;
      color: #ffffff !important;
    }

    .upsell-add-to-cart.added span {
      color: #ffffff !important;
    }
  }

  @media (max-width: 480px) {
    .view-popular-btn-wrapper {
      position: static;
      margin-top: 16px;
      text-align: right;
      padding-right: 4px;
    }
  }

  /* 手機版隱藏價格選項 */
  @media (max-width: 768px) {
    .cart-upsell-wrapper[data-hide-price-mobile="true"] .upsell-product-price {
      display: none;
    }
  }

  /* 手機版隱藏按鈕文字選項 */
  @media (max-width: 480px) {
    .cart-upsell-wrapper[data-hide-button-text="true"] .view-popular-btn {
      width: 32px;
      height: 32px;
      padding: 0;
      border-radius: 50%;
      justify-content: center;
    }
    
    .cart-upsell-wrapper[data-hide-button-text="true"] .view-popular-btn span {
      display: none;
    }
  }
</style>

{% assign is_my_market = false %}
{% if localization.country.iso_code == 'MY' %}
  {% assign is_my_market = true %}
{% endif %}

<div class="cart-upsell-wrapper {% if template.name == 'product' %}cart-upsell-wrapper--product{% endif %}" 
     style="--card-width-desktop: {{ section.settings.card_width_desktop }}px;
            --card-width-tablet: {{ section.settings.card_width_tablet }}px;
            --card-width-mobile-large: {{ section.settings.card_width_mobile_large }}px;
            --card-width-mobile: {{ section.settings.card_width_mobile }}px;
            --button-max-width: {{ section.settings.button_max_width }}px;"
     data-mobile-layout="{{ section.settings.mobile_layout }}"
     data-hide-price-mobile="{{ section.settings.hide_price_mobile }}"
     data-products-visible="{{ section.settings.products_visible_mobile }}"
     data-hide-button-text="{{ section.settings.hide_button_text_mobile }}">
  
  <!-- 標題在容器外 -->
  <div class="upsell-header-outside">
    <h3 class="upsell-title-outside">{{ section.settings.section_title }}</h3>
  </div>
  
  <!-- 主容器 -->
  <div class="cart-upsell-section">
    <div class="upsell-slider-container">
      <div class="upsell-slider" id="upsell-slider-{{ section.id }}">
        {% if section.settings.product_list != blank %}
          {% for product in section.settings.product_list limit: section.settings.max_products %}
            {% assign img_width = 400 %}
            {% case section.settings.image_ratio %}
              {% when 'square' %}
                {% assign img_height = 400 %}
              {% when 'portrait' %}
                {% assign img_height = 500 %}
              {% when 'landscape' %}
                {% assign img_height = 300 %}
              {% else %}
                {% assign img_height = 400 %}
            {% endcase %}
            
            <div class="upsell-product-card">
              <a href="{{ product.url }}" class="upsell-product-link">
                <div class="upsell-product-image {{ section.settings.image_ratio }}">
                  {% if product.featured_image %}
                    <img src="{{ product.featured_image | image_url: width: img_width }}"
                         alt="{{ product.title | escape }}"
                         width="{{ img_width }}"
                         height="{{ img_height }}"
                         loading="lazy">
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {% endif %}
                </div>
                <div class="upsell-product-info">
                  <h4 class="upsell-product-title">{{ product.title }}</h4>
                  {% if section.settings.show_prices %}
                    {% assign upsell_price = product.price | money %}
                    {% if is_my_market %}
                      {% assign upsell_price = upsell_price | replace: ' MYR', '' | replace: 'MYR', '' | strip %}
                    {% endif %}
                    <p class="upsell-product-price">{{ upsell_price }}</p>
                  {% endif %}
                </div>
              </a>
              {% if section.settings.enable_quick_add %}
                <button type="button" 
                        class="upsell-add-to-cart"
                        data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                        data-product-id="{{ product.id }}"
                        onclick="event.preventDefault(); event.stopPropagation(); addToCartUpsell(this, event);">
                  <span>+</span>
                </button>
              {% endif %}
            </div>
          {% endfor %}
        {% else %}
          <!-- 預設商品顯示（編輯器預覽用） -->
          {% assign img_width = 400 %}
          {% case section.settings.image_ratio %}
            {% when 'square' %}
              {% assign img_height = 400 %}
            {% when 'portrait' %}
              {% assign img_height = 500 %}
            {% when 'landscape' %}
              {% assign img_height = 300 %}
            {% else %}
              {% assign img_height = 400 %}
          {% endcase %}
          
          {% for i in (1..4) %}
            <div class="upsell-product-card">
              <div class="upsell-product-image {{ section.settings.image_ratio }}">
                {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="upsell-product-info">
                <h4 class="upsell-product-title">範例商品 {{ i }}</h4>
                {% if section.settings.show_prices %}
                  <p class="upsell-product-price">NT$ {{ i | times: 580 }}</p>
                {% endif %}
              </div>
              {% if section.settings.enable_quick_add %}
                <button type="button" class="upsell-add-to-cart" disabled>
                  <span>+</span>
                </button>
              {% endif %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
  
  <!-- 查看熱門按鈕在容器外右下角 -->
  {% if section.settings.show_popular_button %}
    <div class="view-popular-btn-wrapper">
      <a href="{{ section.settings.popular_items_url }}" class="view-popular-btn">
        <span>{{ section.settings.button_text }}</span>
        <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
          <path d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z"/>
        </svg>
      </a>
    </div>
  {% endif %}
</div>

<script>
  // 防止載入時的白色閃爍
  document.addEventListener('DOMContentLoaded', function() {
    const wrapper = document.querySelector('.cart-upsell-wrapper');
    if (wrapper) {
      wrapper.style.opacity = '0';
      wrapper.style.transition = 'opacity 0.3s ease';
      
      // 確保內容載入後再顯示
      setTimeout(() => {
        wrapper.style.opacity = '1';
      }, 100);
    }
  });

  // 收集需同步重渲染的 cart section（與 product-form.js 相同做法）
  function getCartSectionIds() {
    var ids = [];
    document.querySelectorAll('cart-items-component[data-section-id]').forEach(function (el) {
      if (el.dataset.sectionId) ids.push(el.dataset.sectionId);
    });
    return ids;
  }

  // 一次派發 cart:update，帶 sections HTML + resource，避免二次 section fetch
  function dispatchCartUpdate(cart, sections) {
    document.dispatchEvent(new CustomEvent('cart:update', {
      bubbles: true,
      detail: {
        resource: cart,
        sourceId: 'upsell-block',
        data: {
          itemCount: cart.item_count,
          source: 'upsell-block',
          sections: sections || {}
        }
      }
    }));
  }

  // 加入購物車：單次 add（含 sections）+ 單次 /cart.js，不再 dynamic import
  function addToCartUpsell(button, event) {
    event.preventDefault();
    event.stopPropagation();

    var variantId = button.dataset.variantId;
    if (!variantId) return;

    button.classList.add('loading');
    button.innerHTML = '<span>...</span>';

    var sectionIds = getCartSectionIds();
    var payload = {
      items: [{ id: parseInt(variantId, 10), quantity: 1 }]
    };
    if (sectionIds.length) {
      payload.sections = sectionIds.join(',');
      payload.sections_url = window.location.pathname;
    }

    fetch(window.Shopify.routes.root + 'cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify(payload)
    })
      .then(function (response) { return response.json(); })
      .then(function (data) {
        if (data.status) throw new Error(data.description || data.message || 'Add failed');

        button.classList.remove('loading');
        button.classList.add('added');
        button.innerHTML = '<span>✓</span>';

        // 一次 /cart.js 取得 totals；sections 已從 add 回應帶回，不需再 renderSection
        return fetch('/cart.js', { credentials: 'same-origin', cache: 'no-store' })
          .then(function (res) { return res.json(); })
          .then(function (cart) {
            dispatchCartUpdate(cart, data.sections);
          });
      })
      .then(function () {
        setTimeout(function () {
          button.classList.remove('added');
          button.innerHTML = '<span>+</span>';
        }, 3000);
      })
      .catch(function (error) {
        console.error('加入購物車失敗:', error);
        button.classList.remove('loading');
        button.innerHTML = '<span>✗</span>';
        setTimeout(function () {
          button.innerHTML = '<span>+</span>';
        }, 2000);
      });
  }
</script>

