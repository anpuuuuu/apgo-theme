

<cart-items-component
  class="cart-items-component"
  data-section-id="{{ section.id }}"
>
  <div class="section-background color-{{ section.settings.color_scheme }}"></div>
  <div
    class="section color-{{ section.settings.color_scheme }} section--{{ section.settings.section_width }}"
  >
    <div
      class="cart-page spacing-style{% if cart.empty? %} cart-page--empty{% endif %}"
      style="{% render 'spacing-style', settings: section.settings %}"
    >
      <div class="cart-page__title">
        {%- content_for 'block', id: 'cart-page-title', type: '_cart-title' %}
      </div>

      <div class="cart-page__items">
        {%- content_for 'block', id: 'cart-page-items', type: '_cart-products' %}
      </div>

      <div class="cart-page__checkout-meta">
        {% render 'apgo-cart-checkout-meta' %}
      </div>

      {%- comment -%} Reload once if a discount app adds its gift line after render {%- endcomment -%}
      {% render 'apgo-cart-resync' %}

      <div class="cart-page__more-blocks">
        {%- content_for 'blocks' -%}
      </div>
    </div>
  </div>
</cart-items-component>

{% stylesheet %}
  .cart-page {
    --apgo-cart-inline-space: clamp(12px, 2.2vw, 28px);
    --cart-font-size--2xs: var(--font-size--2xs);
    --cart-font-size--xs: var(--font-size--xs);
    --cart-font-size--sm: var(--font-size--sm);
    --cart-font-size--md: var(--font-size--md);
    --cart-font-size--2xl: var(--font-size--2xl);

    display: grid;
    grid-template-columns: 1fr;
    gap: 0 var(--padding-5xl);
    width: 100%;
    margin: 0 auto;
  }

  .cart-page--empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .cart-page--empty .cart-page__title,
  .cart-page--empty .cart-page__more-blocks {
    margin-top: var(--margin-6xl);
  }

  .cart-page__more-blocks {
    width: 100%;
  }

  .cart-page--empty .cart-title {
    text-align: center;
  }

  .cart-page__main {
    grid-column: 1;
  }

  .cart-page__summary {
    padding-top: var(--padding-xl);
  }

  .cart-page__title,
  .cart-page__items,
  .cart-page__checkout-meta,
  .cart-page__summary,
  .cart-page__more-blocks {
    padding-inline: var(--apgo-cart-inline-space);
  }

  /* Mobile: hide duplicate cart summary sections (sticky + meta replace them).
     NOTE: cart-totals 在手机端會渲染「Shopee 風格 accordion」（Subtotal/Discount/
     Shipping/Estimated total），故 *不* 再隱藏 cart-totals section。只有舊版
     section-cart-combined（Spend More 卡）需隱藏，免運與總計改由 cart-totals 的
     mobile accordion + cart-cta 的 sticky bar 共同承擔。 */
  @media (max-width: 749px) {
    .shopify-section.section-cart-combined {
      display: none !important;
    }
    .shopify-section:has(.cart-sticky-cta) > .cart-cta {
      display: none !important;
    }
    /* AKO custom-liquid on cart is styles-only — no visible markup on this page */
    main[data-template="cart"] .shopify-section:has(.section.spacing-style):not(.section-cart-gwp):not(.shopify-section--main-cart):not(.section-apgo-checkout-steps):not(.section-cart-combined):not(:has([data-cart-sticky-footer])):not(:has([data-section-type="cart-totals"])) {
      display: none !important;
    }
    /* Checkout flow: footer below main adds a large black void above the sticky bar */
    main[data-template="cart"] ~ .shopify-section-group-footer-group {
      display: none !important;
    }
    .shopify-section--main-cart .cart-page {
      padding-block-end: 12px;
    }
  }

  /* Tax disclaimer + trust — mobile only, plain centered text under cart items */
  .cart-page__checkout-meta {
    display: none;
  }
  @media (max-width: 749px) {
    .cart-page__checkout-meta {
      display: block;
      margin-top: 12px;
      text-align: center;
    }
    .apgo-cart-checkout-meta {
      font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif;
      text-align: center;
    }
    .apgo-cart-checkout-meta__trust-title {
      margin: 10px 0 6px;
      font-size: 12px;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.85);
      text-align: center;
      line-height: 1.35;
    }
    .apgo-cart-checkout-meta__trust {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 4px 8px;
      margin: 0;
      padding: 0;
      list-style: none;
      font-size: 10px;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.35;
      text-align: center;
    }
    .apgo-cart-checkout-meta__trust-item {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
    }
    .apgo-cart-checkout-meta__trust-icon {
      display: inline-flex;
      align-items: center;
      color: #f08418;
      flex-shrink: 0;
    }
    .apgo-cart-checkout-meta__trust-sep {
      color: rgba(255, 255, 255, 0.25);
      user-select: none;
    }
  }

  @media screen and (width >= 750px) {
    .cart-page {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .section--page-width .cart-page:has(.cart__container--extend) {
      grid-column: 2 / 4;
      grid-template-columns: 1fr;
    }

    .cart__container--extend {
      height: 100%;
    }
  }

  @media screen and (width >= 1024px) {
    .cart-page {
      max-width: min(1200px, 66vw);
    }
  }

  @media screen and (width >= 1400px) {
    .cart-page {
      grid-template-columns: 1fr;
    }
  }

  /* =========================================================
     APGO Cart UI upgrade (2026-05) — match the PDP visual
     language: dark cards, orange accents, rounded corners,
     compact qty stepper, accented price + buttons.
     Scoped via .cart-page so it doesn't leak into mini-cart drawer.
     ========================================================= */

  /* Outer page: a touch of breathing room above and a max-width nudge */
  .cart-page {
    padding-block: clamp(16px, 4vw, 36px) clamp(24px, 5vw, 64px);
  }

  /* Header — "CART ITEM" → orange-bar accent + brand orange title */
  .cart-items-component .cart-page.cart-page .cart-products-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block-end: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 14px;
  }
  .cart-items-component .cart-page.cart-page .cart-products-title {
    position: relative;
    margin: 0;
    padding-left: 14px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.95);
  }
  .cart-items-component .cart-page.cart-page .cart-products-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 16px;
    border-radius: 2px;
    background: linear-gradient(180deg, var(--primary-orange, #f08418), var(--secondary-orange, #ff9a3c));
  }
  .cart-items-component .cart-page.cart-page .cart-products-action {
    color: rgba(255, 255, 255, 0.7);
    font-size: 13px;
    font-weight: 500;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    padding: 6px 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    transition: border-color .15s ease, color .15s ease;
  }
  .cart-items-component .cart-page.cart-page .cart-products-action:hover {
    border-color: var(--primary-orange, #f08418);
    color: var(--primary-orange, #f08418);
  }

  /* Cart items table → card panel */
  .cart-items-component .cart-page.cart-page .cart-form { width: 100%; }
  .cart-items-component .cart-page.cart-page .cart-items {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 4px 12px;
  }
  .cart-items-component .cart-page.cart-page .cart-items--dividers .cart-items__table-row + .cart-items__table-row {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .cart-items-component .cart-page.cart-page .cart-items__table-row {
    padding-block: 14px;
    transition: background .2s ease;
  }
  .cart-items-component .cart-page.cart-page .cart-items__table-row:hover {
    background: rgba(255, 255, 255, 0.015);
    border-radius: 10px;
  }

  /* Product image — rounded corners + soft border */
  .cart-items-component .cart-page.cart-page .cart-items__media-container,
  .cart-items-component .cart-page.cart-page .cart-items__media {
    border-radius: 10px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* Item text — white title, dim variant */
  .cart-items-component .cart-page.cart-page .cart-items__title,
  .cart-items-component .cart-page.cart-page .cart-items__title a {
    color: rgba(255, 255, 255, 0.95);
    font-weight: 600;
    font-size: 15px;
    line-height: 1.35;
    text-decoration: none;
  }
  .cart-items-component .cart-page.cart-page .cart-items__title a:hover {
    color: var(--primary-orange, #f08418);
  }
  .cart-items-component .cart-page.cart-page .cart-items__variants,
  .cart-items-component .cart-page.cart-page .cart-items__variant,
  .cart-items-component .cart-page.cart-page .cart-items__bundle {
    color: rgba(255, 255, 255, 0.55);
    font-size: 13px;
  }

  /* Inline price (under title) */
  .cart-items-component .cart-page.cart-page .cart-items__details .compare-at-price {
    color: rgba(255, 255, 255, 0.35);
    text-decoration: line-through;
    font-size: 13px;
    margin-left: 4px;
  }

  /* Quantity stepper — match PDP */
  .cart-items-component .cart-page.cart-page .cart-items__quantity quantity-input,
  .cart-items-component .cart-page.cart-page .cart-items__quantity .quantity-selector,
  .cart-items-component .cart-page.cart-page .cart-items__quantity {
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    overflow: hidden;
  }
  .cart-items-component .cart-page.cart-page .cart-items__quantity button,
  .cart-items-component .cart-page.cart-page .cart-items__quantity .quantity-selector__button {
    background: transparent;
    border: 0;
    color: rgba(255, 255, 255, 0.8);
    width: 32px;
    height: 32px;
    cursor: pointer;
    transition: color .15s ease;
  }
  .cart-items-component .cart-page.cart-page .cart-items__quantity button:hover,
  .cart-items-component .cart-page.cart-page .cart-items__quantity .quantity-selector__button:hover {
    color: var(--primary-orange, #f08418);
  }
  .cart-items-component .cart-page.cart-page .cart-items__quantity input,
  .cart-items-component .cart-page.cart-page .cart-items__quantity .quantity-selector__input {
    background: transparent;
    border: 0;
    color: #fff;
    font-size: 14px;
    text-align: center;
    width: 38px;
  }

  /* Remove (trash icon) button */
  .cart-items-component .cart-page.cart-page .cart-items__remove {
    color: rgba(255, 255, 255, 0.45);
    background: transparent;
    border: 0;
    padding: 6px;
    border-radius: 6px;
    cursor: pointer;
    transition: color .15s ease, background .15s ease;
  }
  .cart-items-component .cart-page.cart-page .cart-items__remove:hover {
    color: var(--primary-orange, #f08418);
    background: rgba(240, 132, 24, 0.08);
  }

  /* Line-item price (right column) — accent in primary orange */
  .cart-items-component .cart-page.cart-page .cart-items__price {
    color: var(--primary-orange, #f08418);
    font-weight: 700;
    font-size: 15px;
  }
  .cart-items-component .cart-page.cart-page .cart-items__price .compare-at-price {
    color: rgba(255, 255, 255, 0.4);
    font-weight: 400;
    font-size: 12px;
    margin-left: 6px;
  }
  .cart-items-component .cart-page.cart-page .cart-items__price-unit {
    color: rgba(255, 255, 255, 0.5);
    font-size: 12px;
  }

  /* Empty cart CTA */
  .cart-page--empty .cart-items__empty-button {
    background: linear-gradient(45deg, var(--primary-orange, #f08418), var(--secondary-orange, #ff9a3c));
    color: #fff;
    border: 0;
    border-radius: 10px;
    padding: 12px 24px;
    font-weight: 600;
    cursor: pointer;
  }

  /* Free-shipping progress card */
  .cart-items-component .cart-page.cart-page .cart-free-shipping,
  .cart-items-component .cart-page.cart-page .cart-free-shipping-goal {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 16px 18px;
    margin-top: 14px;
  }

  /* Cart totals card */
  .cart-items-component .cart-page.cart-page .cart-totals,
  .cart-items-component .cart-page.cart-page .cart-summary {
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 18px;
    margin-top: 14px;
  }
  .cart-items-component .cart-page.cart-page .cart-totals__row,
  .cart-items-component .cart-page.cart-page .cart-summary__row {
    display: flex;
    justify-content: space-between;
    padding-block: 6px;
    color: rgba(255, 255, 255, 0.85);
  }
  .cart-items-component .cart-page.cart-page .cart-totals__total,
  .cart-items-component .cart-page.cart-page .cart-summary__total {
    color: var(--primary-orange, #f08418);
    font-weight: 700;
    font-size: 18px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin-top: 8px;
    padding-top: 10px;
  }

  /* Cart CTA / checkout buttons */
  .cart-items-component .cart-page.cart-page .cart-cta button,
  .cart-items-component .cart-page.cart-page .cart-cta a,
  .cart-page button[name="checkout"],
  .cart-items-component .cart-page.cart-page .shopify-payment-button__button--unbranded,
  .cart-page button[type="submit"]:not(.cart-items__quantity button):not(.cart-items__remove) {
    background: linear-gradient(45deg, var(--primary-orange, #f08418), var(--secondary-orange, #ff9a3c));
    color: #fff !important;
    border: 0;
    border-radius: 10px;
    padding: 14px 18px;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    letter-spacing: 0.02em;
    transition: transform .05s ease, opacity .15s ease;
  }
  .cart-items-component .cart-page.cart-page .cart-cta button:active,
  .cart-page button[name="checkout"]:active {
    transform: scale(0.99);
  }

  /* Cart-page title (h1) */
  .cart-items-component .cart-page.cart-page .cart-title,
  .cart-page__title h1 {
    color: #fff;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .cart-page__title .cart-title__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    height: 28px;
    padding: 0 8px;
    margin-left: 10px;
    border-radius: 999px;
    background: rgba(240, 132, 24, 0.15);
    color: var(--primary-orange, #f08418);
    font-size: 13px;
    font-weight: 600;
    vertical-align: middle;
  }

  @media screen and (max-width: 749px) {
    .cart-items-component .cart-page.cart-page .cart-items {
      padding: 0 10px;
    }
    .cart-items-component .cart-page.cart-page .cart-items__table-row {
      padding-block: 12px;
    }
    .cart-items-component .cart-page.cart-page .cart-items__title,
    .cart-items-component .cart-page.cart-page .cart-items__title a {
      font-size: 14px;
    }
    .cart-items-component .cart-page.cart-page .cart-items__price {
      font-size: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
