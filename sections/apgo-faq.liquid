{% liquid
  assign categories = section.blocks | where: 'type', 'category'
  assign qas = section.blocks | where: 'type', 'qa'
%}

<section class="apgo-faq" id="apgo-faq-{{ section.id }}" data-faq-section>
  <div class="apgo-faq__container">
    {% if section.settings.heading != blank %}
      <h2 class="apgo-faq__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="faq-mobile-submenu-bar">
      <button
        class="faq-menu-trigger"
        type="button"
        aria-expanded="false"
        aria-controls="faq-mobile-subdrawer-{{ section.id }}"
        data-faq-menu-trigger
      >
        <span>FAQ</span>
        <span class="faq-menu-trigger__icon" aria-hidden="true"></span>
      </button>
    </div>

    <div class="faq-mobile-subdrawer-backdrop" data-faq-drawer-backdrop hidden></div>
    <aside
      class="faq-mobile-subdrawer"
      id="faq-mobile-subdrawer-{{ section.id }}"
      aria-hidden="true"
      data-faq-mobile-subdrawer
    >
      <div class="faq-mobile-subdrawer__header">
        <p class="faq-mobile-subdrawer__title">FAQ</p>
        <button class="faq-mobile-subdrawer__close" type="button" data-faq-drawer-close aria-label="Close FAQ menu">
          ✕
        </button>
      </div>
      <ul class="faq-mobile-subdrawer__list" role="list">
        {% for category in categories %}
          {% assign category_key = category.settings.key | strip %}
          {% if category_key == blank %}
            {% assign category_key = category.id %}
          {% endif %}
          <li>
            <a
              class="faq-mobile-subdrawer__link"
              href="#faq-category-{{ section.id }}-{{ category_key | handleize }}"
              data-faq-nav-link
              data-faq-drawer-link
            >
              {{ category.settings.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </aside>

    <div class="apgo-faq__layout">
      <aside class="apgo-faq__sidebar" aria-label="FAQ categories">
        <ul class="apgo-faq__category-list" role="list">
          {% for category in categories %}
            {% assign category_key = category.settings.key | strip %}
            {% if category_key == blank %}
              {% assign category_key = category.id %}
            {% endif %}
            <li class="apgo-faq__category-item">
              <a
                class="apgo-faq__category-link"
                href="#faq-category-{{ section.id }}-{{ category_key | handleize }}"
                data-faq-nav-link
                data-faq-desktop-link
              >
                {{ category.settings.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </aside>

      <div class="apgo-faq__content">
        {% for category in categories %}
          {% assign category_key = category.settings.key | strip %}
          {% if category_key == blank %}
            {% assign category_key = category.id %}
          {% endif %}
          {% assign category_anchor = category_key | handleize %}

          <section class="apgo-faq__group" id="faq-category-{{ section.id }}-{{ category_anchor }}" data-faq-group>
            <h3 class="apgo-faq__group-title">{{ category.settings.title }}</h3>

            <div class="apgo-faq__qa-list">
              {% assign has_qa = false %}
              {% for qa in qas %}
                {% assign qa_category_key = qa.settings.category_key | strip %}
                {% if qa_category_key == category_key %}
                  {% assign has_qa = true %}
                  <article class="apgo-faq__qa-item">
                    <button class="apgo-faq__question" type="button" aria-expanded="false" data-faq-question>
                      <span class="apgo-faq__question-text">{{ qa.settings.question }}</span>
                      <span class="apgo-faq__icon" aria-hidden="true"></span>
                    </button>
                    <div class="apgo-faq__answer rte" data-faq-answer hidden>{{ qa.settings.answer }}</div>
                  </article>
                {% endif %}
              {% endfor %}

              {% unless has_qa %}
                <p class="apgo-faq__empty">No questions in this category yet.</p>
              {% endunless %}
            </div>
          </section>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .apgo-faq {
    padding: 48px 0;
    background: #000000;
    color: #ffffff;
  }

  .apgo-faq__container {
    width: min(66.6667vw, 1200px);
    margin: 0 auto;
    background: transparent;
    border-radius: 16px;
    padding: 28px;
  }

  .apgo-faq__heading {
    margin: 0 0 28px;
    text-align: center;
    font-size: clamp(1.75rem, 2.2vw, 2.25rem);
    line-height: 1.2;
    color: #f08418;
  }

  .faq-mobile-submenu-bar {
    display: none;
  }

  .faq-mobile-subdrawer-backdrop {
    display: none;
  }

  .faq-mobile-subdrawer {
    display: none;
  }

  .apgo-faq__layout {
    display: grid;
    grid-template-columns: 30% 70%;
    gap: 32px;
    align-items: start;
  }

  .apgo-faq__sidebar {
    position: sticky;
    top: 96px;
  }

  .apgo-faq__category-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-radius: 16px;
    background: #0f0f0f;
    padding: 12px;
  }

  .apgo-faq__category-link {
    display: block;
    padding: 12px 14px;
    border-radius: 12px;
    color: #ffffff;
    text-decoration: none;
    font-weight: 600;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .apgo-faq__category-link:hover {
    background: #1a1a1a;
  }

  .apgo-faq__category-link.is-active {
    background: #1a1a1a;
    color: #f08418;
  }

  .apgo-faq__content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .apgo-faq__group-title {
    margin: 0 0 16px;
    font-size: 1.5rem;
    line-height: 1.25;
    color: #f08418;
  }

  .apgo-faq__qa-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .apgo-faq__qa-item {
    border-bottom: 1px solid #2a2a2a;
    padding: 4px 0 16px;
  }

  .apgo-faq__question {
    width: 100%;
    margin: 0;
    padding: 10px 0;
    border: 0;
    background: transparent;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    font-size: 1.15rem;
    font-family: inherit;
    font-weight: 700;
    line-height: 1.35;
    color: #ffffff;
  }

  .apgo-faq__icon {
    width: 10px;
    height: 10px;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    transform: rotate(45deg);
    transition: transform 0.25s ease;
    flex-shrink: 0;
  }

  .apgo-faq__question[aria-expanded='true'] .apgo-faq__icon {
    transform: rotate(-135deg);
  }

  .apgo-faq__answer {
    margin: 0;
    color: #cccccc;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.28s ease, opacity 0.22s ease;
  }

  .apgo-faq__answer.is-open {
    opacity: 1;
  }

  .apgo-faq__empty {
    margin: 0;
    color: #cccccc;
  }

  @media screen and (max-width: 990px) {
    .apgo-faq__container {
      width: min(92vw, 1200px);
    }

    .apgo-faq__layout {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .apgo-faq__sidebar {
      position: static;
    }
  }

  @media screen and (max-width: 768px) {
    .apgo-faq {
      padding: 24px 0;
    }

    .apgo-faq__container {
      width: 100%;
      padding: 20px 16px;
      border-radius: 0;
    }

    .faq-mobile-submenu-bar {
      display: block;
      margin: 0 0 16px;
    }

    .faq-menu-trigger {
      width: 100%;
      border: 1px solid #2a2a2a;
      border-radius: 999px;
      background: #111111;
      color: #ffffff;
      min-height: 44px;
      padding: 0 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 0.95rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .faq-menu-trigger__icon {
      width: 8px;
      height: 8px;
      border-right: 2px solid #ffffff;
      border-bottom: 2px solid #ffffff;
      transform: rotate(45deg);
      transition: transform 0.2s ease;
    }

    .faq-menu-trigger[aria-expanded='true'] .faq-menu-trigger__icon {
      transform: rotate(-135deg);
    }

    .apgo-faq__sidebar {
      display: none;
    }

    .faq-mobile-subdrawer-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 45;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }

    .faq-mobile-subdrawer-backdrop.is-open {
      opacity: 1;
      pointer-events: auto;
    }

    .faq-mobile-subdrawer {
      position: fixed;
      top: 0;
      left: 0;
      width: min(85vw, 320px);
      height: 100dvh;
      background: #0f0f0f;
      border-right: 1px solid #2a2a2a;
      transform: translateX(-100%);
      transition: transform 0.28s ease;
      z-index: 50;
      display: flex;
      flex-direction: column;
      pointer-events: none;
    }

    .faq-mobile-subdrawer.is-open {
      transform: translateX(0);
      pointer-events: auto;
    }

    .faq-mobile-subdrawer__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px;
      border-bottom: 1px solid #2a2a2a;
    }

    .faq-mobile-subdrawer__title {
      margin: 0;
      color: #f08418;
      font-weight: 700;
    }

    .faq-mobile-subdrawer__close {
      border: 0;
      background: transparent;
      color: #ffffff;
      font-size: 1.1rem;
      line-height: 1;
      padding: 8px;
    }

    .faq-mobile-subdrawer__list {
      list-style: none;
      margin: 0;
      padding: 8px;
      overflow-y: auto;
    }

    .faq-mobile-subdrawer__link {
      display: block;
      color: #ffffff;
      text-decoration: none;
      padding: 12px;
      border-radius: 10px;
      font-weight: 600;
    }

    .faq-mobile-subdrawer__link.is-active {
      background: #1a1a1a;
      color: #f08418;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var sections = document.querySelectorAll('[data-faq-section]');
    if (!sections.length) return;

    sections.forEach(function (section) {
      var questionButtons = section.querySelectorAll('[data-faq-question]');
      var navLinks = section.querySelectorAll('[data-faq-nav-link]');
      var groups = section.querySelectorAll('[data-faq-group]');
      var drawer = section.querySelector('[data-faq-mobile-subdrawer]');
      var drawerBackdrop = section.querySelector('[data-faq-drawer-backdrop]');
      var drawerTrigger = section.querySelector('[data-faq-menu-trigger]');
      var drawerClose = section.querySelector('[data-faq-drawer-close]');

      function closeAnswer(button, answer) {
        if (!button || !answer) return;
        button.setAttribute('aria-expanded', 'false');
        answer.classList.remove('is-open');
        answer.style.maxHeight = '0px';
        setTimeout(function () {
          if (!answer.classList.contains('is-open')) answer.hidden = true;
        }, 280);
      }

      function openAnswer(button, answer) {
        if (!button || !answer) return;
        answer.hidden = false;
        answer.classList.add('is-open');
        button.setAttribute('aria-expanded', 'true');
        answer.style.maxHeight = answer.scrollHeight + 'px';
      }

      questionButtons.forEach(function (button) {
        button.addEventListener('click', function () {
          var answer = button.parentElement.querySelector('[data-faq-answer]');
          var isExpanded = button.getAttribute('aria-expanded') === 'true';
          if (isExpanded) {
            closeAnswer(button, answer);
          } else {
            openAnswer(button, answer);
          }
        });
      });

      var stickyTop = 96;
      var scrollOffset = stickyTop + 12;

      function isMobile() {
        return window.matchMedia('(max-width: 768px)').matches;
      }

      var bodyScrollLocked = false;
      var previousBodyOverflow = '';
      var previousBodyPaddingRight = '';

      function lockBodyScrollWithGap() {
        if (bodyScrollLocked) return;
        var scrollbarGap = window.innerWidth - document.documentElement.clientWidth;
        previousBodyOverflow = document.body.style.overflow || '';
        previousBodyPaddingRight = document.body.style.paddingRight || '';
        document.body.style.overflow = 'hidden';
        if (scrollbarGap > 0) {
          document.body.style.paddingRight = scrollbarGap + 'px';
        }
        bodyScrollLocked = true;
      }

      function unlockBodyScrollWithGap() {
        if (!bodyScrollLocked) return;
        document.body.style.overflow = previousBodyOverflow;
        document.body.style.paddingRight = previousBodyPaddingRight;
        bodyScrollLocked = false;
      }

      function setDrawerOpen(isOpen) {
        if (!drawer || !drawerBackdrop || !drawerTrigger) return;
        drawer.classList.toggle('is-open', isOpen);
        drawer.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
        drawerBackdrop.hidden = !isOpen;
        drawerBackdrop.classList.toggle('is-open', isOpen);
        drawerTrigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        if (isOpen) {
          lockBodyScrollWithGap();
        } else {
          unlockBodyScrollWithGap();
        }
      }

      function closeMainMenuDrawerIfOpen() {
        var headerDrawerDetails = document.getElementById('Details-menu-drawer-container');
        if (!headerDrawerDetails || !headerDrawerDetails.hasAttribute('open')) return;
        headerDrawerDetails.removeAttribute('open');
        document.documentElement.classList.remove('menu-opening', 'menu-open');
        unlockBodyScrollWithGap();
      }

      if (drawerTrigger && drawer && drawerBackdrop) {
        drawerTrigger.addEventListener('click', function () {
          setDrawerOpen(!drawer.classList.contains('is-open'));
        });
        drawerBackdrop.addEventListener('click', function () {
          setDrawerOpen(false);
        });
        if (drawerClose) {
          drawerClose.addEventListener('click', function () {
            setDrawerOpen(false);
          });
        }
      }

      document.addEventListener('click', function (event) {
        var faqMenuLink = event.target.closest(
          '.menu-drawer a[href*="/pages/faq"], .menu-drawer a[href*="/pages/faq/"], .menu-drawer a[href="#faq"], .menu-drawer a[data-faq-menu-link]'
        );
        if (!faqMenuLink) return;
        if (!section.closest('main, body')) return;

        event.preventDefault();
        closeMainMenuDrawerIfOpen();
        setDrawerOpen(true);
      });

      function setActiveLinkById(activeId) {
        navLinks.forEach(function (link) {
          link.classList.toggle('is-active', link.getAttribute('href') === activeId);
        });
      }

      navLinks.forEach(function (link) {
        link.addEventListener('click', function (event) {
          var targetId = link.getAttribute('href');
          if (!targetId || targetId.charAt(0) !== '#') return;
          var target = section.querySelector(targetId);
          if (!target) return;
          event.preventDefault();
          var targetTop = target.getBoundingClientRect().top + window.scrollY - scrollOffset;
          window.scrollTo({
            top: Math.max(targetTop, 0),
            behavior: 'smooth'
          });
          setActiveLinkById(targetId);
          if (link.hasAttribute('data-faq-drawer-link') && isMobile()) {
            setDrawerOpen(false);
          }
          history.replaceState(null, '', targetId);
        });
      });

      if (groups.length && navLinks.length) {
        function updateActiveNavOnScroll() {
          var currentY = window.scrollY + scrollOffset + 2;
          var activeGroupId = '#' + groups[0].id;

          groups.forEach(function (group) {
            if (group.offsetTop <= currentY) {
              activeGroupId = '#' + group.id;
            }
          });

          setActiveLinkById(activeGroupId);
        }

        var ticking = false;
        function requestScrollspyUpdate() {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(function () {
            updateActiveNavOnScroll();
            ticking = false;
          });
        }

        window.addEventListener('scroll', requestScrollspyUpdate, { passive: true });
        window.addEventListener('resize', requestScrollspyUpdate);
        updateActiveNavOnScroll();
      }

      section.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
          setDrawerOpen(false);
        }
      });

      window.addEventListener('resize', function () {
        if (!isMobile()) {
          setDrawerOpen(false);
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "APGO FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "F.A.Q."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category title",
          "default": "General"
        },
        {
          "type": "text",
          "id": "key",
          "label": "Category key (unique)",
          "info": "Use the same key in related Q&A blocks, e.g. general",
          "default": "general"
        }
      ]
    },
    {
      "type": "qa",
      "name": "Q&A",
      "settings": [
        {
          "type": "text",
          "id": "category_key",
          "label": "Category key",
          "info": "Must match a Category key exactly, e.g. general",
          "default": "general"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Why create an account?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Use this area to provide a clear answer for your customers.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "APGO FAQ",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "General",
            "key": "general"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Register my watch",
            "key": "register-watch"
          }
        },
        {
          "type": "qa",
          "settings": {
            "category_key": "general",
            "question": "Why create an account at www.tissotwatches.com?",
            "answer": "<p>By creating an account, you can register your watch and access your warranty information.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "category_key": "general",
            "question": "What measures has Tissot taken against counterfeiting?",
            "answer": "<p>The group protects technical assets with patents, trademarks, and active legal enforcement.</p>"
          }
        },
        {
          "type": "qa",
          "settings": {
            "category_key": "register-watch",
            "question": "Do Tissot watches come with a warranty?",
            "answer": "<p>Most watches include international warranty coverage. Register your watch to view details.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
