    color: #ffffff;
    font-weight: 400;
  }

  .apgo-insidebox-image {
    display: block;
    width: 100%;
    max-width: none !important;
    height: auto;
    margin: 0 auto;
  }

  /* 短影音展示區 */
  .apgo-video-showcase {
    padding: 24px 0;
    background: var(--dark-bg);
    margin-bottom: 24px;
  }

  .apgo-precautions {
    padding: 0 16px 24px;
    background: var(--dark-bg);
  }

  .apgo-precautions-inner {
    background: #0f0f0f;
    border: 1px solid rgba(240, 132, 24, 0.18);
