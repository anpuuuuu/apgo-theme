    padding: 14px 16px;
  }

.apgo-precautions-header {
    margin: 0 0 12px;
    padding: 0 2px;
  }

  .apgo-precautions-title-outside {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apgo-precautions-title-outside::before {
    content: '▶';
    color: var(--primary-orange);
    font-size: 0.9rem;
  }

  .apgo-precautions-content {
    color: var(--text-light-gray);
    font-size: 0.9rem;
    line-height: 1.7;
    word-break: break-word;
  }

  .apgo-construction-steps {
    padding: 0 16px 28px;
    background: var(--dark-bg);
  }

  .apgo-construction-steps-inner {
    background: #000000;
    border-radius: 14px;
    border: 1px solid var(--border-color);
    padding: 16px 18px 20px;
  }

  .apgo-construction-steps-header {
    margin: 0 0 14px;
  }

  .apgo-construction-steps-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apgo-construction-steps-title::before {
    content: '▶';
    color: var(--primary-orange);
    font-size: 0.9rem;
  }

  .apgo-step-card {
    border-radius: 12px;
    border: 1px solid rgba(240, 132, 24, 0.25);
    background: rgba(26, 26, 26, 0.8);
    padding: 14px 16px;
    margin-bottom: 12px;
  }

  .apgo-step-card:last-child {
    margin-bottom: 0;
  }

  .apgo-step-card-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-white);
    margin: 0 0 8px;
  }

  .apgo-step-card-body {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-light-gray);
    word-break: break-word;
  }

  .apgo-related-mf {
    padding: 0 16px 32px;
    background: var(--dark-bg);
  }

  .apgo-related-mf-inner {
    max-width: none;
    margin: 0 auto;
  }

  .apgo-related-mf-title {
    margin: 0 0 14px;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apgo-related-mf-title::before {
    content: '▶';
    color: var(--primary-orange);
    font-size: 0.9rem;
  }

  .apgo-related-mf-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .apgo-related-mf-card {
    display: block;
    text-decoration: none;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    background: #101010;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .apgo-related-mf-card:hover {
    border-color: rgba(240, 132, 24, 0.5);
  }

  .apgo-related-mf-media {
    aspect-ratio: 1;
    background: #1a1a1a;
  }

  .apgo-related-mf-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0 !important;
  }

  .apgo-related-mf-info {
    padding: 10px 12px 12px;
  }

  .apgo-related-mf-product-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-white);
    margin: 0 0 4px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .apgo-related-mf-price {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--primary-orange);
    margin: 0;
  }

  @media (min-width: 769px) {
    .apgo-related-mf-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  .apgo-customer-review {
    padding: 0 16px 24px;
    background: var(--dark-bg);
  }

  .apgo-customer-review-inner {
    background: #000000;
    border: none;
    border-radius: 14px;
    padding: 14px 16px 18px;
    text-align: center;
    max-width: none;
    margin: 0 auto;
  }

  .apgo-customer-review-header {
    max-width: none;
    margin: 0 auto 12px;
    padding: 0 2px;
  }

  .apgo-customer-review-title-outside {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apgo-customer-review-title-outside::before {
    content: '▶';
    color: var(--primary-orange);
    font-size: 0.9rem;
  }

  .apgo-customer-review-image {
    display: block;
    width: 100%;
    max-width: none !important; /* override template-level global img max-width */
    height: auto;
    border-radius: 10px;
    margin: 0 auto;
  }

  .apgo-customer-review-mobile-only {
    display: none;
  }

  .apgo-customer-review-desktop-only {
    display: block;
  }

  @media (min-width: 769px) {
    .apgo-customer-review-mobile-only {
      display: none !important;
    }

    .apgo-customer-review-desktop-only {
      display: block;
    }

    .apgo-insidebox-inner {
      max-width: min(1200px, 66vw);
      margin-left: auto;
      margin-right: auto;
    }

    .apgo-video-header,
    .apgo-video-scroll-container,
    .apgo-precautions-header,
    .apgo-precautions-inner,
    .apgo-construction-steps-inner,
    .apgo-related-mf-inner,
    .apgo-customer-review-header,
    .apgo-customer-review-inner {
      max-width: min(1200px, 66vw);
      margin-left: auto;
      margin-right: auto;
    }

    .apgo-customer-review {
      padding: 0 8px 24px; /* desktop: near full width with small gutters */
    }

    .apgo-insidebox {
      padding: 0 8px 24px;
    }

    .apgo-customer-review-inner {
      padding: 14px 10px 16px;
    }
  }

  .apgo-video-header {
    padding: 0 16px;
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .apgo-video-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apgo-video-title::before {
    content: '▶';
    color: var(--primary-orange);
    font-size: 0.9rem;
  }

  /* 短影音滾動容器 */
  .apgo-video-scroll-container {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 0 16px 12px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .apgo-video-scroll-container::-webkit-scrollbar {
    display: none;
  }

  /* 短影音卡片 */
  .apgo-video-card {
    flex: 0 0 auto;
    width: 200px;
    height: 356px;
    background: var(--card-bg);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    scroll-snap-align: start;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 1px solid rgba(240, 132, 24, 0.2);
  }

  .apgo-video-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #0a0a0a;
  }

  .apgo-video-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(0, 0, 0, 0.9) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 16px;
  }

  .apgo-video-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 50px;
    height: 50px;
    background: rgba(240, 132, 24, 0.9);
    backdrop-filter: blur(10px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .apgo-video-play-btn::after {
    content: '';
    width: 0;
    height: 0;
    border-left: 15px solid white;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    margin-left: 3px;
  }

  .apgo-video-info {
    position: relative;
    z-index: 2;
  }

  .apgo-video-subtitle {
    font-size: 0.85rem;
    color: var(--text-white);
    font-weight: 600;
    margin-bottom: 4px;
  }

  .apgo-video-views {
    font-size: 0.75rem;
    color: var(--text-gray);
  }

  .apgo-video-duration {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.8);
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.75rem;
    color: white;
  }

  /* 底部購買欄 */
  .apgo-bottom-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: calc(var(--vvb, 0px)); /* ← 用变量控制到底部的偏移 */
    width: 100%;
    box-sizing: border-box;

    background: rgba(0, 0, 0, 0.98);
    backdrop-filter: blur(20px);
    border-top: 1px solid rgba(240, 132, 24, 0.2);

    padding: 12px 16px;
    padding-bottom: max(12px, env(safe-area-inset-bottom)); /* ← 覆盖 Home 指示条安全区 */
    z-index: 1000;
    display: flex;
    gap: 12px;
    align-items: center;

    will-change: transform, bottom, padding-bottom; /* 减少抖动 */
    transform: translateZ(0);
  }

  @media (min-width: 769px) {
    .apgo-bottom-bar {
      width: min(1200px, 66vw);
      left: 50%;
      right: auto;
      transform: translateX(-50%) translateZ(0);
      border: 1px solid rgba(240, 132, 24, 0.2);
      border-bottom: none;
      border-radius: 12px 12px 0 0;
    }
  }

  /*
    固定底欄會蓋住捲到底時的 footer（付款方式等）。
    桌面側欄開啟時底欄隱藏（見 .apgo-pdp-variant-sidebar-open），不需預留。
    數值 ≈ 底欄上下 padding + 按鈕列高度；另加 safe-area 與 iOS 鍵盤時 --vvb 上移後仍留足夠可捲區。
  */
  body:has(.apgo-product-section):not(.apgo-pdp-variant-sidebar-open) footer.apgo-footer {
    padding-bottom: calc(104px + env(safe-area-inset-bottom, 0px));
  }

  .apgo-price-section {
    flex: 1;
  }

  .apgo-original-price {
    font-size: 0.8rem;
    color: var(--text-gray);
    text-decoration: line-through;
    margin-bottom: 2px;
  }

  .apgo-price-value {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--primary-orange);
  }

  .apgo-action-buttons {
    display: flex;
    gap: 8px;
    flex: 1.5;
  }

  .apgo-btn-favorite {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(240, 132, 24, 0.1);
    border: 1px solid var(--primary-orange);
    border-radius: 12px;
    color: var(--primary-orange);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .apgo-btn-favorite.active {
    background: var(--primary-orange);
    color: white;
  }

  .apgo-buy-button {
    flex: 1;
    background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));
    color: white;
    border: none;
    border-radius: 12px;
    padding: 16px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  /* 變體選擇：外層殼（桌面側欄用） */
  .apgo-pdp-variant-shell {
    position: fixed;
    inset: 0;
    z-index: 1998;
    pointer-events: none;
  }

  .apgo-pdp-variant-shell.active {
    pointer-events: auto;
  }

  /* 變體選擇模態框（手機：全寬底抽屜；高度上限約 85% 視窗，內層 flex:1 會撐滿該上限故常感覺「快滿版」） */
  .apgo-variant-modal {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--card-bg);
    border-radius: 24px 24px 0 0;
    padding: 0;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 2000;
    max-height: 85vh;
    max-height: min(85vh, 90dvh);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    -ms-overflow-style: none;
    scrollbar-width: none;
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.5);
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    overscroll-behavior-y: contain;
  }

  .apgo-variant-modal.active {
    transform: translateY(0);
  }

  .apgo-variant-modal-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    max-height: 85vh;
    max-height: min(85vh, 90dvh);
    overscroll-behavior-y: contain;
  }

  .apgo-variant-modal-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 16px;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    overscroll-behavior-y: contain;
  }

  .apgo-variant-modal-footer {
    flex-shrink: 0;
    background: var(--card-bg);
    border-top: 1px solid rgba(240, 132, 24, 0.2);
    padding: 0 16px 16px;
    overscroll-behavior-y: contain;
  }

  .apgo-variant-modal-footer .apgo-modal-buttons {
    position: static;
    padding-top: 12px;
    padding-bottom: 0;
    margin: 0;
  }

  .apgo-modal-header {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--card-bg);
    margin-bottom: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(240, 132, 24, 0.2);
    opacity: 1;
    z-index: 1;
  }

  .apgo-modal-title {
    font-size: 1.3rem;
    font-weight: 600;
    background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .apgo-close-modal {
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: var(--text-gray);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.3rem;
  }

  /* 產品預覽區 */
  .apgo-modal-product-preview {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
    padding: 16px;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 12px;
  }

  .apgo-modal-product-image {
    width: 80px;
    height: 80px;
    object-fit: contain;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
    background: rgba(255, 255, 255, 0.02);
    border-radius: 8px;
    padding: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .apgo-modal-product-image:hover {
    transform: scale(1.05);
  }

  .apgo-modal-product-info {
    flex: 1;
  }

  .apgo-modal-product-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-white);
    margin-bottom: 4px;
  }

  .apgo-modal-product-desc {
    font-size: 0.85rem;
    color: var(--text-gray);
    line-height: 1.4;
  }

  /* 手機／窄螢幕：預覽改為圖在上、文案在下 */
  @media (max-width: 1023px) {
    .apgo-pdp-variant-shell .apgo-modal-product-preview {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 12px;
    }

    .apgo-pdp-variant-shell .apgo-modal-product-image {
      width: 100%;
      max-width: min(280px, 78vw);
      height: auto;
      aspect-ratio: 1;
      object-fit: contain;
    }

    .apgo-pdp-variant-shell .apgo-modal-product-info {
      flex: none;
      width: 100%;
      align-self: stretch;
    }
  }

  /*
    手機端 (≤749px)：把變體選擇模態框拉到滿版，
    讓使用者進來就能一頁看完所有資訊，不需要捲動，
    也不在頂部留任何空白。同時縮小圖片、變體卡片字體與 padding。
  */
  @media (max-width: 749px) {
    .apgo-variant-modal {
      top: 0;
      bottom: 0;
      max-height: 100dvh;
      height: 100dvh;
      border-radius: 0;
      transform: translateY(100%);
    }

    .apgo-variant-modal.active {
      transform: translateY(0);
    }

    .apgo-variant-modal-inner {
      max-height: 100dvh;
      height: 100dvh;
    }

    /*
      Scroll 區轉為 flex column，預覽區用 flex-grow 吃掉下方多餘空間 →
      圖片自動變大；超過上限就停下，避免畸形撐大。
      其他子元素 flex-shrink:0，避免變體卡片被壓縮。
    */
    .apgo-variant-modal-scroll {
      display: flex;
      flex-direction: column;
    }

    .apgo-modal-header,
    .apgo-variant-section,
    .apgo-quantity-selector,
    .apgo-modal-total-line {
      flex-shrink: 0;
    }

    .apgo-modal-header {
      padding-top: max(8px, env(safe-area-inset-top, 0));
      margin-bottom: 10px;
    }

    .apgo-modal-title {
      font-size: 1.1rem;
    }

    /* 預覽區：彈性放大、有最大上限，避免空位浪費同時不過頭 */
    .apgo-pdp-variant-shell .apgo-modal-product-preview {
      flex: 1 1 auto;
      gap: 8px;
      padding: 10px;
      margin-bottom: 14px;
      justify-content: center;
      /* 最低保留 ≈ 圖 140 + 名稱描述兩行；最高不超過視窗一半 */
      min-height: 200px;
      max-height: min(50dvh, 360px);
    }

    .apgo-pdp-variant-shell .apgo-modal-product-image {
      /* height 100% 讓圖片吃掉預覽區的可用高度，配合 aspect-ratio:1 維持正方形 */
      width: auto;
      max-width: min(280px, 70vw);
      height: 100%;
      max-height: min(280px, 40dvh);
      aspect-ratio: 1;
      object-fit: contain;
      flex: 0 1 auto;
    }

    .apgo-modal-product-name {
      font-size: 0.95rem;
      margin-bottom: 2px;
    }

    .apgo-modal-product-desc {
      font-size: 0.78rem;
      line-height: 1.35;
    }

    /* 變體卡片：縮小 padding 與字體 */
    .apgo-variant-section {
      margin-bottom: 14px;
    }

    .apgo-variant-label {
      font-size: 0.78rem;
      margin-bottom: 8px;
    }

    .apgo-variant-options {
      gap: 8px;
    }

    .apgo-variant-option {
      padding: 12px 12px 30px 12px;
      border-radius: 10px;
    }

    .apgo-variant-name {
      font-size: 0.85rem;
      margin-bottom: 2px;
      line-height: 1.25;
    }

    .apgo-variant-price {
      font-size: 0.92rem;
      bottom: 6px;
      left: 12px;
    }

    .apgo-variant-quantity {
      font-size: 0.7rem;
      bottom: 6px;
      right: 8px;
    }

    .apgo-variant-option.selected::after {
      width: 16px;
      height: 16px;
      font-size: 0.7rem;
      top: 6px;
      right: 6px;
    }

    /* 數量區更緊湊 */
    .apgo-quantity-selector {
      margin-bottom: 14px;
    }

    .apgo-quantity-label {
      font-size: 0.8rem;
      margin-bottom: 8px;
    }

    .apgo-quantity-controls {
      gap: 12px;
      padding: 6px;
    }

    .apgo-quantity-btn {
      width: 32px;
      height: 32px;
      font-size: 1.05rem;
    }

    .apgo-quantity-value {
      font-size: 1.05rem;
      min-width: 32px;
    }

    .apgo-modal-total-line {
      font-size: 0.88rem;
      margin-bottom: 12px;
    }

    .apgo-modal-total-line .apgo-modal-total-amount {
      font-size: 1.1rem;
    }

    .apgo-modal-btn {
      padding: 12px;
      font-size: 0.95rem;
    }
  }

  /* 變體選擇區 */
  .apgo-variant-section {
    margin-bottom: 24px;
  }

  .apgo-variant-label {
    font-size: 0.9rem;
    color: var(--text-gray);
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .apgo-variant-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .apgo-variant-option {
    background: rgba(255, 255, 255, 0.03);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 22px 22px 40px 22px;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
  }

  .apgo-variant-option.disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .apgo-variant-option.disabled:hover {
    border-color: rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
  }

  .apgo-variant-quantity {
    position: absolute;
    bottom: 8px;
    right: 12px;
    font-size: 0.8rem;
    color: var(--text-gray);
    background: rgba(0,0,0,0.3);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .apgo-variant-option.selected {
    border-color: var(--primary-orange);
    background: rgba(240, 132, 24, 0.1);
  }

  .apgo-variant-option.selected::after {
    content: '✓';
    position: absolute;
    top: 8px;
    right: 8px;
    width: 20px;
    height: 20px;
    background: var(--primary-orange);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: bold;
  }

  .apgo-variant-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-white);
    margin-bottom: 4px;
  }

  .apgo-variant-price {
    font-size: 1.1rem;
    color: var(--primary-orange);
    font-weight: bold;
    position: absolute;
    bottom: 8px;
    left: 22px;
  }

  /* 數量選擇器 */
  .apgo-quantity-selector {
    margin-bottom: 24px;
  }

  .apgo-quantity-label {
    font-size: 0.9rem;
    color: var(--text-gray);
    margin-bottom: 12px;
  }

  .apgo-quantity-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 8px;
    width: fit-content;
  }

  .apgo-quantity-btn {
    width: 36px;
    height: 36px;
    border: none;
    background: rgba(240, 132, 24, 0.2);
    color: var(--primary-orange);
    border-radius: 8px;
    font-size: 1.2rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .apgo-quantity-value {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-white);
    min-width: 40px;
    text-align: center;
  }

  /* 變體彈窗：單行合計（取代原 Subtotal/Total 卡片） */
  .apgo-modal-total-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 20px;
    padding: 0 2px;
    font-size: 0.95rem;
    color: var(--text-light-gray);
  }

  .apgo-modal-total-line .apgo-modal-total-amount {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary-orange);
    white-space: nowrap;
  }

  /* 模態框按鈕（底部區由 .apgo-variant-modal-footer 承載） */
  .apgo-modal-buttons {
    display: flex;
    gap: 12px;
    background: var(--card-bg);
  }

  .apgo-modal-btn {
    flex: 1;
    padding: 16px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
  }

  .apgo-modal-btn-secondary {
    background: rgba(240, 132, 24, 0.1);
    border: 2px solid var(--primary-orange);
    color: var(--primary-orange);
  }

  .apgo-modal-btn-primary {
    background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));
    color: white;
  }

  .apgo-modal-btn:disabled {
    background: #333333 !important;
    color: #888888 !important;
    border-color: #333333 !important;
    cursor: not-allowed !important;
    background-image: none !important;
  }

  .apgo-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 1999;
  }

  .apgo-modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  /* 桌面：變體右側欄；開啟時主欄左對齊；用數值 margin + transition 做 0.4s 置中→靠左（margin:auto 無法插值） */
  @media (min-width: 1024px) {
    :root {
      --apgo-pdp-motion-duration: 0.4s;
      --apgo-pdp-motion-easing: cubic-bezier(0.37, 0, 0.63, 1);
      --apgo-pdp-pane-max: min(1200px, 66vw);
    }

    /*
      側欄關閉：與 margin:auto + max-width:var(--apgo-pdp-pane-max) 等效的左右留白，
      開啟時改為 margin-left:0（或主圖 16px）+ margin-right:auto，才能與 max-width 同步過渡。
    */
    /* 縮圖／基本資訊：關閉側欄維持全寬，僅過渡 max-width（開啟時變窄靠左） */
    .apgo-product-section .apgo-product-thumbnails,
    .apgo-product-section .apgo-product-info {
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
      transition: max-width var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing);
    }

    .apgo-product-section .apgo-pdp-tabs-inner,
    .apgo-product-section .apgo-insidebox-inner,
    .apgo-product-section .apgo-video-header,
    .apgo-product-section .apgo-video-scroll-container,
    .apgo-product-section .apgo-precautions-header,
    .apgo-product-section .apgo-precautions-inner,
    .apgo-product-section .apgo-construction-steps-inner,
    .apgo-product-section .apgo-related-mf-inner,
    .apgo-product-section .apgo-customer-review-header,
    .apgo-product-section .apgo-customer-review-inner {
      max-width: var(--apgo-pdp-pane-max);
      margin-left: max(0px, calc((100% - min(100%, var(--apgo-pdp-pane-max))) / 2));
      margin-right: max(0px, calc((100% - min(100%, var(--apgo-pdp-pane-max))) / 2));
      transition:
        max-width var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        margin-left var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        margin-right var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing);
    }

    /* 主圖：關閉側欄維持全寬；開啟時 max-width 與 margin 可與 0.4s 同步（100% → 計算寬、0 → 16px） */
    .apgo-product-section .apgo-hero-visual {
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
      transition:
        max-width var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        margin-left var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        margin-right var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing);
    }

    /*
      Suggested products（cart-upsell）與 APGO footer：與主欄同一套置中／靠左 + 0.4s。
      僅在頁面含 .apgo-product-section 時作用（:has），避免影響其他頁。
    */
    body:has(.apgo-product-section) .cart-upsell-wrapper.cart-upsell-wrapper--product,
    body:has(.apgo-product-section) footer.apgo-footer .apgo-footer-container {
      transition:
        max-width var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        margin-left var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        margin-right var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing);
    }

    body:not(.apgo-pdp-variant-sidebar-open):has(.apgo-product-section)
      .cart-upsell-wrapper.cart-upsell-wrapper--product {
      max-width: var(--apgo-pdp-pane-max);
      margin-top: 20px;
      margin-bottom: 0;
      margin-left: max(0px, calc((100% - min(100%, var(--apgo-pdp-pane-max))) / 2));
      margin-right: max(0px, calc((100% - min(100%, var(--apgo-pdp-pane-max))) / 2));
    }

    body:not(.apgo-pdp-variant-sidebar-open):has(.apgo-product-section) footer.apgo-footer .apgo-footer-container {
      max-width: var(--apgo-pdp-pane-max);
      margin-left: max(0px, calc((100% - min(100%, var(--apgo-pdp-pane-max))) / 2));
      margin-right: max(0px, calc((100% - min(100%, var(--apgo-pdp-pane-max))) / 2));
    }

    /* 底欄：側欄關閉時只過渡 left/right；開啟側欄時隱藏底欄（側欄內已有購買按鈕） */
    .apgo-product-section > .apgo-bottom-bar {
      transition:
        left var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        right var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        opacity var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        visibility var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing);
    }

    /* 主圖外層無 section 水平 padding，左緣留 16px；其餘區塊本身或外層已有 padding，margin-left 用 0 以免重複內縮 */
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-hero-visual {
      max-width: min(1200px, calc(100vw - var(--apgo-pdp-sidebar-width, 33.33vw) - 32px));
      margin-left: 16px;
      margin-right: auto;
    }

    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-product-thumbnails,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-product-info,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-pdp-tabs-inner,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-insidebox-inner,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-video-header,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-video-scroll-container,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-precautions-header,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-precautions-inner,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-construction-steps-inner,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-related-mf-inner,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-customer-review-header,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-customer-review-inner {
      max-width: min(1200px, calc(100vw - var(--apgo-pdp-sidebar-width, 33.33vw) - 32px));
      margin-left: 0;
      margin-right: auto;
    }

    body.apgo-pdp-variant-sidebar-open .cart-upsell-wrapper.cart-upsell-wrapper--product {
      max-width: min(1200px, calc(100vw - var(--apgo-pdp-sidebar-width, 33.33vw) - 32px));
      margin-top: 20px;
      margin-left: 0;
      margin-right: auto;
    }

    body.apgo-pdp-variant-sidebar-open footer.apgo-footer .apgo-footer-container {
      max-width: min(1200px, calc(100vw - var(--apgo-pdp-sidebar-width, 33.33vw) - 32px));
      margin-left: 0;
      margin-right: auto;
    }

    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-thumbnails-container {
      justify-content: flex-start;
    }

    body.apgo-pdp-variant-sidebar-open .apgo-product-section > .apgo-bottom-bar {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    /*
      遮罩與側欄：選擇器不依賴 .apgo-pdp-variant-shell.active，關閉動畫結束後 shell 會先失去 active，
      若仍只靠 shell.active，modal 會掉回手機用的 translateY(100%) 造成「收完又閃到下面」。
    */
    .apgo-pdp-variant-shell .apgo-modal-overlay {
      position: absolute;
      inset: 0;
      right: var(--apgo-pdp-sidebar-width, 33.33vw);
      width: auto;
      background: rgba(0, 0, 0, 0.22);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        visibility var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing);
    }

    .apgo-pdp-variant-shell .apgo-modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .apgo-pdp-variant-shell .apgo-variant-modal {
      top: 0;
      right: 0;
      bottom: 0;
      left: auto;
      width: var(--apgo-pdp-sidebar-width, 33.33vw);
      max-height: none;
      height: 100vh;
      height: 100dvh;
      border-radius: 0;
      box-shadow: -12px 0 40px rgba(0, 0, 0, 0.45);
      transform: translateX(105%);
      transition:
        transform var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        opacity 0.3s ease;
    }

    .apgo-pdp-variant-shell .apgo-variant-modal.active {
      transform: translateX(0);
    }

    .apgo-pdp-variant-shell .apgo-variant-modal-inner {
      max-height: none;
      height: 100%;
    }

    .apgo-pdp-variant-shell .apgo-modal-product-preview {
      flex-direction: column;
      align-items: stretch;
      text-align: left;
    }

    .apgo-pdp-variant-shell .apgo-modal-product-image {
      width: 100%;
      max-width: 200px;
      height: auto;
      margin: 0 auto;
    }

    .apgo-pdp-variant-shell .apgo-variant-options {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
    .apgo-pdp-variant-shell .apgo-variant-modal {
      transition: none;
    }

    .apgo-product-section .apgo-hero-visual,
    .apgo-product-section .apgo-product-thumbnails,
    .apgo-product-section .apgo-product-info,
    .apgo-product-section .apgo-pdp-tabs-inner,
    .apgo-product-section .apgo-insidebox-inner,
    .apgo-product-section .apgo-video-header,
    .apgo-product-section .apgo-video-scroll-container,
    .apgo-product-section .apgo-precautions-header,
    .apgo-product-section .apgo-precautions-inner,
    .apgo-product-section .apgo-construction-steps-inner,
    .apgo-product-section .apgo-related-mf-inner,
    .apgo-product-section .apgo-customer-review-header,
    .apgo-product-section .apgo-customer-review-inner,
    body:has(.apgo-product-section) .cart-upsell-wrapper.cart-upsell-wrapper--product,
    body:has(.apgo-product-section) footer.apgo-footer .apgo-footer-container,
    .apgo-product-section > .apgo-bottom-bar {
      transition: none;
    }
  }

  /* 圖片預覽燈箱 */
  .apgo-image-lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.95);
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .apgo-image-lightbox.active {
    display: flex;
  }

  .apgo-lightbox-content {
    position: relative;
    max-width: 90%;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .apgo-lightbox-image {
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    border-radius: 12px;
  }

  .apgo-lightbox-close {
    position: absolute;
    top: -40px;
    right: 0;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.2rem;
  }

  /* 全螢幕影片播放器 */
  .apgo-video-fullscreen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: black;
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .apgo-video-fullscreen.active {
    display: flex;
  }

  .apgo-fullscreen-video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .apgo-close-fullscreen {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    border-radius: 50%;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 3001;
  }

  /* 載入動畫 */
  .apgo-loading-spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: apgoSpin 1s linear infinite;
  }

  @keyframes apgoSpin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 滑動指示器 */
  .apgo-swipe-indicator {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    pointer-events: none;
  }

  .apgo-swipe-dots {
    display: flex;
    gap: 6px;
    padding: 8px 12px;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 20px;
    backdrop-filter: blur(10px);
  }

  .apgo-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    transition: all 0.3s ease;
  }

  .apgo-dot.active {
    width: 16px;
    border-radius: 3px;
    background: var(--primary-orange);
  }

  /* 視頻模態框 */
  .apgo-video-modal {
    position: fixed;
    inset: 0;
    z-index: 3000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .apgo-video-modal.active {
    opacity: 1;
    visibility: visible;
  }

  .apgo-video-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(10px);
  }

  .apgo-video-modal-content {
    position: relative;
    z-index: 1;
    width: 90%;
    max-width: 900px;
    max-height: 80vh;
    animation: apgoModalSlideIn 0.3s ease;
  }

  @keyframes apgoModalSlideIn {
    from {
      transform: translateY(30px) scale(0.95);
      opacity: 0;
    }
    to {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  .apgo-video-modal-close {
    position: absolute;
    top: -40px;
    right: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 2;
  }

  .apgo-video-modal-close:hover {
    background: rgba(240, 132, 24, 0.3);
    border-color: var(--primary-orange);
    transform: rotate(90deg);
  }

  .apgo-video-modal-player {
    width: 100%;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .apgo-video-modal-player video {
    width: 100%;
    height: auto;
    max-height: 70vh;
    display: block;
  }

  .apgo-video-hidden {
    display: none !important;
  }

  .apgo-video-card.loading::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px;
    border: 3px solid rgba(240, 132, 24, 0.3);
    border-top-color: var(--primary-orange);
    border-radius: 50%;
    animation: apgoSpin 1s linear infinite;
    z-index: 10;
  }

  /* iOS Safari 模態框開啟時的 body 樣式 */
  body.modal-open {
    overflow: hidden;
    position: fixed;
    width: 100%;
  }

  /* 成功通知樣式 */
  .add-on-notification {
    position: fixed;
    left: 75%;
    top: 10%;
    transform: translate(-50%, calc(-50% + 10px)) scale(0.98);
    opacity: 0;
    width: min(92vw, 460px);
    max-width: 92vw;
    padding: 18px 20px 18px 20px;
    border-radius: 12px;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    border: 1px solid rgba(240, 132, 24, 0.35);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55), 0 6px 20px rgba(0, 0, 0, 0.35);
    z-index: 99999;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .add-on-notification.show {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }

  .add-on-notification-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .add-on-notification-message {
    color: var(--text-white, #fff);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
  }

  .add-on-notification-link {
    background: linear-gradient(45deg, var(--primary-orange, #f08418), var(--secondary-orange, #ff9a3c));
    color: var(--text-white, #fff);
    text-decoration: none;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
    transition: all 0.25s ease;
    display: inline-block;
    margin: 4px auto 0;
    min-width: 160px;
  }

  .add-on-notification-link:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(240, 132, 24, 0.35);
  }

  .add-on-notification-close {
    background: transparent;
    border: none;
    color: #fff;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0;
    opacity: 0.8;
    transition: opacity 0.25s ease;
    width: 24px;
    height: 24px;
    position: absolute;
    right: 10px;
    top: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .add-on-notification-close:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .apgo-main-container {
      padding-bottom: 84px;
    }

    /* 消除跑馬燈／區塊與主圖之間殘留的一條細縫 */
    .apgo-product-section .apgo-main-container > .apgo-hero-visual:first-child {
      margin-top: -6px;
    }

    .apgo-pdp-looping-lead {
      padding: 0 12px 10px;
    }

    .apgo-pdp-tabs {
      padding: 0 12px 20px;
    }

    .apgo-tab-panel--review,
    .apgo-tab-panel--description {
      width: 100%;
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

    .apgo-tab-panel--review .apgo-tab-empty {
      padding-inline: 0;
    }

    .apgo-tab-desc-layout.has-video {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .apgo-looping-video-wrap,
    .apgo-looping-video-wrap video,
    .apgo-looping-video-wrap iframe,
    .apgo-looping-desc-wrap {
      min-height: 0;
    }

    .apgo-looping-desc-content {
      font-size: 0.85rem;
      line-height: 1.55;
    }

    .apgo-precautions {
      padding: 0 12px 20px;
    }

    .apgo-precautions-inner {
      padding: 12px 12px 14px;
    }

    .apgo-precautions-header {
      margin-bottom: 10px;
    }

    .apgo-precautions-title-outside {
      font-size: 1.05rem;
    }

    .apgo-customer-review {
      padding: 0;
    }

    .apgo-insidebox {
      padding: 0 0 20px;
    }

    .apgo-insidebox-inner {
      padding: 12px 12px 14px;
    }

    .apgo-insidebox-title {
      font-size: 1.45rem;
      line-height: 1;
    }

    .apgo-customer-review-inner {
      padding: 12px 12px 6px;
    }

    .apgo-customer-review-desktop-only {
      display: none;
    }

    .apgo-customer-review-mobile-only {
      display: block;
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: 0;
      overflow: visible;
    }

    .apgo-customer-review-mobile-only .apgo-customer-review-image {
      width: 100%;
      max-width: none !important;
      min-width: 0;
      height: auto;
      margin: 0;
      border-radius: 0;
      object-fit: contain;
    }

    .apgo-customer-review-header {
      margin-bottom: 10px;
    }

    .apgo-video-modal-content {
      width: 100%;
      height: 100%;
      max-width: 100%;
      max-height: 100%;
    }

    .apgo-video-modal-player {
      height: 100%;
      display: flex;
      align-items: center;
      border-radius: 0;
    }

    .apgo-video-modal-player video {
      max-height: 100vh;
    }

    .apgo-video-modal-close {
      top: 20px;
      right: 20px;
      background: rgba(0, 0, 0, 0.7);
    }

    .add-on-notification {
      top: 70px;
      right: 45%;
      left: 55%;
      max-width: calc(100vw - 30px);
      padding: 14px 16px;
      gap: 10px;
    }

    .add-on-notification-message {
      font-size: 0.85rem;
    }

    .add-on-notification-link {
      padding: 10px 16px;
      font-size: 0.82rem;
      justify-content: center;
    }

    .add-on-notification-close {
      width: 22px;
      height: 22px;
      font-size: 1rem;
    }

    .add-on-notification {
      width: min(94vw, 420px);
      padding: 16px 16px 18px;
    }

    .add-on-notification-message {
      font-size: 0.92rem;
    }

    .add-on-notification-link {
      min-width: 140px;
      font-size: 0.88rem;
    }
    .apgo-price-value {
      font-size: 1.3rem;
      font-weight: bold;
      color: var(--primary-orange);
    }
  }
  /*
    Carousel showcase — must be at the end of the file so it wins over the
    earlier base rules. Previous padding-bottom: 28px created the visible
    black band between the image and the thumbnail strip. Zero out the
    padding so the image fills the hero edge-to-edge.
  */
  .apgo-product-showcase {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    padding: 0;
    overflow: hidden;
  }

  .apgo-carousel-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    overflow: hidden;
    min-width: 0;
  }

  .apgo-carousel-track {
    display: flex;
    width: 100%;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
    height: 100%;
    align-items: flex-start;
    flex-shrink: 0;
  }

  .apgo-carousel-slide {
    flex: 0 0 100%;
    min-width: 100%;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    position: relative;
    box-sizing: border-box;
  }
  .apgo-product-showcase,
.apgo-carousel-container,
.apgo-carousel-track {
  touch-action: pan-y;     /* 现代浏览器 */
  -ms-touch-action: pan-y; /* 旧 Edge */
}

  /*
    桌面：主視覺輪播 — 改用「固定高度 + contain」而非「1:1 + contain」。
    1:1 在 ~600px 寬的桌面欄裡會強制 600 高，遇到較寬（非方形）的產品圖時
    上下會留大量 letterbox 空白。固定高度配合 contain 讓圖片填得更滿，
    letterbox 只在實際比例差異時才出現，且明顯較小。
  */
  @media (min-width: 769px) {
    .apgo-hero-visual {
      /* Override base aspect-ratio: 1/1 — use a fixed height tuned for typical product shots */
      aspect-ratio: auto;
      height: clamp(360px, 48vh, 520px);
      max-height: none;
    }

    /* On desktop the carousel dots can sit naturally below the photo —
       show the entire image (contain) instead of cropping (cover) so
       portrait/wide product shots aren't trimmed top/bottom. */
    .apgo-product-image-main.is-cover {
      object-fit: contain;
    }

    .apgo-product-showcase {
      align-items: center;
      justify-content: center;
      /* Tight padding so image takes more of the hero box, less visible letterbox */
      padding: 8px;
    }

    .apgo-carousel-container {
      align-items: center;
      justify-content: flex-start;
      overflow: hidden;
    }

    .apgo-carousel-track,
    .apgo-carousel-slide {
      align-items: center;
      justify-content: center;
    }
  }

  /*
    Desktop 2-col layout for the v3 PDP top region:
      [ gallery + thumbnails + title + performance metrics ]   [ buy col ]
    On mobile the layout stays single-column (no grid applied).
    Triggers from ≥1024px so tablets keep the single column.
    Uses display:contents on .apgo-product-info so its children (header, perf,
    variation, etc.) become direct grid children alongside .apgo-cc-pdp__buy-col;
    that way we don't have to physically hoist the title or metrics out of the
    info wrapper. .apgo-cc-pdp__buy-col is assigned to grid-column 2 and spans
    multiple rows so it sits to the right of the whole left stack.
  */
  @media (min-width: 1024px) {
    body:not(.apgo-pdp-variant-sidebar-open) .apgo-main-container {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      column-gap: 36px;
      align-items: start;
      /* Cap at 1200px (~2/3 of typical desktop viewport) and centre */
      max-width: 1200px;
      margin-left: auto;
      margin-right: auto;
      padding-inline: 24px;
    }

    /* Hero gallery + thumbnails: col 1. Override the dark gradient that the
       mobile-first .apgo-hero-visual rule paints so the desktop card sits flush
       against the page background instead of looking like a separate grey panel. */
    body:not(.apgo-pdp-variant-sidebar-open) .apgo-main-container > .apgo-hero-visual,
    body:not(.apgo-pdp-variant-sidebar-open) .apgo-main-container > .apgo-product-thumbnails {
      grid-column: 1;
    }
    body:not(.apgo-pdp-variant-sidebar-open) .apgo-main-container > .apgo-hero-visual {
      background: transparent;
    }

    /* Let .apgo-product-info's children participate directly in the parent grid */
    body:not(.apgo-pdp-variant-sidebar-open) .apgo-main-container > .apgo-product-info {
      display: contents;
    }

    /* Title + performance metrics + any other .apgo-product-info children default to col 1 */
    body:not(.apgo-pdp-variant-sidebar-open) .apgo-product-header,
    body:not(.apgo-pdp-variant-sidebar-open) .apgo-performance-metrics {
      grid-column: 1;
    }

    /* The Car Care buy panel: col 2, plain card style (no sticky — sits naturally at the top of the right rail). */
    body:not(.apgo-pdp-variant-sidebar-open) .apgo-cc-pdp__buy-col {
      grid-column: 2;
      grid-row: 1 / span 20;
      align-self: start;
      padding: 24px;
      background: rgba(0, 0, 0, 0.35);
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    /* Everything that appears AFTER .apgo-product-info should span full width */
    body:not(.apgo-pdp-variant-sidebar-open) .apgo-main-container > section:not(.apgo-hero-visual):not(.apgo-product-thumbnails):not(.apgo-product-info),
    body:not(.apgo-pdp-variant-sidebar-open) .apgo-main-container > .apgo-pdp-looping-lead,
    body:not(.apgo-pdp-variant-sidebar-open) .apgo-main-container > .apgo-pdp-tabs {
      grid-column: 1 / -1;
    }
  }

  /* =============================================================
     Car Care Inline Price / Variant / Qty / Shipping / CTA (Block A)
     - Uses our theme tokens (--primary-orange, --dark-bg).
     - Mobile-first single-column; desktop inherits.
     ============================================================= */
  .apgo-cc-pdp__price-card {
    /* Tighter margin so the price hugs the title above */
    margin: 4px 0 10px;
  }
  .apgo-cc-pdp__price-card--sale {
    background: rgba(0, 0, 0, 0.4);
    border-left: 3px solid var(--primary-orange, #f08418);
    border-radius: 10px;
    padding: 10px 14px;
  }
  .apgo-cc-pdp__price-top {
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .apgo-cc-pdp__price-label {
    font-size: 12px;
    font-weight: 600;
    color: var(--primary-orange, #f08418);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  /* Deal countdown badge — pulses softly when < 1h remaining to add urgency */
  .apgo-cc-pdp__deal-timer {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 700;
    color: #ffffff;
    background: linear-gradient(45deg, #f08418, #ff9a3c);
    border-radius: 999px;
    letter-spacing: 0.02em;
    line-height: 1;
    box-shadow: 0 2px 8px rgba(240, 132, 24, 0.35);
    font-variant-numeric: tabular-nums;
  }
  .apgo-cc-pdp__deal-timer-icon {
    display: inline-flex;
    align-items: center;
  }
  .apgo-cc-pdp__deal-timer[data-urgent="true"] {
    animation: apgoDealPulse 1.4s ease-in-out infinite;
  }
  @keyframes apgoDealPulse {
    0%, 100% { box-shadow: 0 2px 8px rgba(240, 132, 24, 0.35); transform: scale(1); }
    50%      { box-shadow: 0 4px 18px rgba(240, 132, 24, 0.65); transform: scale(1.04); }
  }
  .apgo-cc-pdp__deal-timer[hidden] { display: none !important; }
  /*
    Two-row layout when on sale:
      row 1: current price (left)  ............  save badge (right)
      row 2: compare-at price strikethrough (left)
    Using flex-wrap + order so we don't need a new wrapper element.
    Current = order 1, Save = order 2 (margin-left:auto pushes right),
    Compare = order 3 with flex-basis:100% forces a new line.
  */
  .apgo-cc-pdp__price-bottom {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    column-gap: 10px;
    row-gap: 4px;
  }
  .apgo-cc-pdp__price-current {
    order: 1;
    font-size: 26px;
    font-weight: 800;
    color: var(--primary-orange, #f08418);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .apgo-cc-pdp__price-save {
    order: 2;
    margin-left: auto;
    font-size: 11px;
    font-weight: 600;
    background: rgba(240, 132, 24, 0.12);
    color: var(--primary-orange, #f08418);
    padding: 3px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .apgo-cc-pdp__price-compare {
    order: 3;
    flex-basis: 100%;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.35);
    text-decoration: line-through;
  }

  /* Promo pills */
  .apgo-cc-pdp__promos {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 14px;
  }
  .apgo-cc-pdp__promo {
    font-size: 11px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }
  .apgo-cc-pdp__promo--orange { background: rgba(240, 132, 24, 0.14); color: #ffaa55; }
  .apgo-cc-pdp__promo--green  { background: rgba( 64, 192,  96, 0.14); color: #8be39a; }
  .apgo-cc-pdp__promo--blue   { background: rgba( 80, 150, 240, 0.14); color: #8db8ff; }
  .apgo-cc-pdp__promo--red    { background: rgba(255,  80,  80, 0.14); color: #ff9a9a; }
  .apgo-cc-pdp__promo--neutral{ background: rgba(255, 255, 255, 0.06); color: rgba(255, 255, 255, 0.7); }

  /* Inline form: dividers between price/variant/qty/shipping */
  .apgo-cc-pdp__form > .apgo-cc-pdp__option-group {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 14px;
    margin-top: 14px;
  }
  .apgo-cc-pdp__form > .apgo-cc-pdp__qty-row {
    /* Tighter vertical rhythm — quantity row sits compactly between the
       variant chips above and the variation block below. */
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 8px;
    margin-top: 8px;
    padding-bottom: 2px;
  }
  .apgo-cc-pdp__form > .apgo-cc-pdp__shipping {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 12px;
    margin-top: 14px;
  }

  /* Option group: label/current value stacked on top, chips full-width below */
  .apgo-cc-pdp__option-group {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
  }
  .apgo-cc-pdp__option-label {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .apgo-cc-pdp__option-name {
    font-size: 13px;
    color: var(--primary-orange, #f08418);
    font-weight: 600;
  }
  /* "(N types)" tail of the label is dimmer/regular weight so the orange
     "Select option" reads as the primary text. */
  .apgo-cc-pdp__option-count {
    color: rgba(255, 255, 255, 0.5);
    font-weight: 400;
    margin-left: 4px;
  }

  /* Variation block rendered right under the lead "Description" text — full
     metafield content, no variant linking. The variant-aware sections still
     live (hidden) inside the inline picker so the confirm modal can pull the
     active section's HTML. */
  .apgo-lead-variation {
    margin-top: 18px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .apgo-lead-variation__title {
    color: var(--primary-orange, #f08418);
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 10px;
    text-transform: none;
  }
  .apgo-lead-variation__body {
    color: rgba(255, 255, 255, 0.85);
    font-size: 14px;
    line-height: 1.7;
    white-space: normal;
  }
  .apgo-cc-pdp__option-current {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.45);
  }
  .apgo-cc-pdp__option-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-start;
  }
  .apgo-cc-pdp__chip {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 5px 12px;
    /* Force transparent background so when the chip is rendered as a <button>
       (confirm modal markup) it doesn't pick up the UA's default light-grey button
       background. The inline picker uses <label> so this was a no-op before. */
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.7);
    font-family: inherit;
    font-size: 12px;
    cursor: pointer;
    transition: background .15s ease, border-color .15s ease, color .15s ease;
    user-select: none;
  }
  .apgo-cc-pdp__chip input { position: absolute; opacity: 0; pointer-events: none; }
  .apgo-cc-pdp__chip:hover { border-color: rgba(240, 132, 24, 0.4); }
  .apgo-cc-pdp__chip.is-active {
    background: var(--primary-orange, #f08418);
    border-color: var(--primary-orange, #f08418);
    color: #fff;
  }

  /* Quantity stepper */
  .apgo-cc-pdp__qty-row {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 12px;
  }
  /* The inline qty row inside the form is desktop-only. Mobile uses the
     confirm modal (opened from the bottom buybar) for quantity selection.
     The modal qty row reuses the same .apgo-cc-pdp__qty-row class but is
     scoped under .apgo-cc-confirm-modal__qty so the hide rule doesn't reach it. */
  .apgo-cc-pdp__qty-row--desktop { display: none; }
  @media (min-width: 1024px) {
    .apgo-cc-pdp__qty-row--desktop { display: flex; }
  }
  .apgo-cc-pdp__qty-row--desktop input[type="number"] {
    width: 44px;
    height: 32px;
    border: 0;
    background: transparent;
    color: #fff;
    text-align: center;
    font-size: 14px;
    -moz-appearance: textfield;
  }
  .apgo-cc-pdp__qty-row--desktop input[type="number"]::-webkit-outer-spin-button,
  .apgo-cc-pdp__qty-row--desktop input[type="number"]::-webkit-inner-spin-button {
    -webkit-appearance: none; margin: 0;
  }
  .apgo-cc-pdp__qty-label {
    flex: 0 0 auto;
    font-size: 13px;
    font-weight: 600;
    color: var(--primary-orange, #f08418);
  }
  .apgo-cc-pdp__qty {
    flex: 0 0 auto;
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.35);
  }
  .apgo-cc-pdp__qty button {
    width: 32px;
    height: 32px;
    background: transparent;
    border: none;
    color: var(--primary-orange, #f08418);
    font-size: 16px;
    cursor: pointer;
  }
  .apgo-cc-pdp__qty input {
    width: 38px;
    height: 32px;
    background: transparent;
    border: none;
    color: #fff;
    text-align: center;
    font-size: 14px;
    -moz-appearance: textfield;
  }
  .apgo-cc-pdp__qty input::-webkit-outer-spin-button,
  .apgo-cc-pdp__qty input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /*
    Variation block (under Quantity, above Shipping).
    Title uses the light-gray of .apgo-cc-pdp__option-name; body uses the dimmer
    gray of .apgo-cc-pdp__option-current — same two-tone hierarchy as the
    variant option group's label/current-value pair.
  */
  .apgo-cc-pdp__variation {
    /* Match the divider style other inline-form rows have */
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 14px;
    margin-top: 14px;
  }
  /* Mobile: hide visually but KEEP IN THE LAYOUT-FREE LAYER so the confirm
     modal can still query `.is-active` for its variant-aware body. Use
     position:absolute + visibility:hidden so it occupies no space yet
     getBoundingClientRect / innerHTML still work. */
  .apgo-cc-pdp__variation--desktop-only {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
    margin: 0;
    padding: 0;
    border: 0;
  }
  @media (min-width: 1024px) {
    .apgo-cc-pdp__variation--desktop-only {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      visibility: visible;
      pointer-events: auto;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 14px;
      margin-top: 14px;
    }
  }
  .apgo-cc-pdp__variation-title {
    margin: 0 0 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--primary-orange, #f08418);
    letter-spacing: 0.02em;
    /* Cancel base.css h4 default text-transform (var(--font-h4--case) resolves
       to uppercase in this theme). Locale value 'Variation' already has the
       capitalisation we want. */
    text-transform: none;
  }
  .apgo-cc-pdp__variation-body {
    font-size: 12px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.45); /* dim gray (matches option-current) */
    white-space: normal;
    word-break: break-word;
  }

  /*
    Variant-aware sections render with BOTH __variation-section + __variation-body.
    The doubled-class selector wins over plain __variation-body so the currently
    visible (non-hidden) section reads in solid white instead of the dim gray
    that the body class otherwise applies. Hidden sections inherit the same
    colour but aren't shown anyway.
  */
  /*
    All variant sections are now always rendered. Default state is dimmed so
    the non-active sections fade into the background; the active one gets
    bumped to solid white via .is-active. Keeps the eye on the relevant
    section without hiding the rest entirely.
  */
  /* Only the active variant section is rendered. Non-active sections stay
     in the DOM so the confirm modal can read their innerHTML, but are
     visually removed from the inline picker layout. */
  .apgo-cc-pdp__variation-section.apgo-cc-pdp__variation-body {
    display: none;
  }
  .apgo-cc-pdp__variation-section.apgo-cc-pdp__variation-body.is-active {
    display: block;
    color: rgba(255, 255, 255, 0.92);
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  /* Shipping info row: label on the left, stock status pushed to the right */
  .apgo-cc-pdp__shipping {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    /* Solid white for the "2–3 business days" label so it doesn't visually fade */
    color: rgba(255, 255, 255, 0.92);
  }
  .apgo-cc-pdp__shipping-sep {
    /* Hide the '·' divider — the two halves are now visually separated by spacing */
    display: none;
  }
  .apgo-cc-pdp__shipping-stock {
    margin-left: auto;
    color: #8be39a;
    font-weight: 600;
  }
  .apgo-cc-pdp__shipping-stock--out { color: #ff9a9a; }

  /*
    CTA row — desktop only (≥1024px). On mobile the fixed bottom buybar
    already provides Add to cart / Buy now, so we suppress this row to avoid
    duplicate buttons stacked above the buybar.
  */
  .apgo-cc-pdp__cta-row {
    display: none;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    margin-top: 16px;
  }
  @media (min-width: 1024px) {
    .apgo-cc-pdp__cta-row { display: grid; gap: 12px; margin-top: 20px; }
    /* Make the inline desktop CTA buttons more prominent than the mobile/modal
       variants — bigger padding + font, slightly larger radius. */
    .apgo-cc-pdp__cta-row .apgo-cc-pdp__cta {
      padding: 14px 18px;
      font-size: 15px;
      border-radius: 10px;
      letter-spacing: 0.02em;
    }
  }
  .apgo-cc-pdp__cta {
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.2;
    cursor: pointer;
    transition: opacity .15s ease, transform .05s ease;
    border: 2px solid var(--primary-orange, #f08418);
  }
  .apgo-cc-pdp__cta--secondary {
    background: transparent;
    color: var(--primary-orange, #f08418);
  }
  .apgo-cc-pdp__cta--primary {
    background: linear-gradient(45deg, var(--primary-orange, #f08418), var(--secondary-orange, #ff9a3c));
    color: #fff;
  }
  .apgo-cc-pdp__cta:active { transform: scale(0.98); }
  .apgo-cc-pdp__cta:disabled { opacity: 0.5; cursor: not-allowed; }

  /* =============================================================
     Purchase-confirm modal — appears when buybar Add/Buy is clicked.
     Centered card with backdrop. Slides up on mobile, scales in on desktop.
     ============================================================= */
  .apgo-cc-confirm-modal {
    position: fixed;
    inset: 0;
    z-index: 100100;
    visibility: hidden;
    pointer-events: none;
  }
  .apgo-cc-confirm-modal.is-open {
    visibility: visible;
    pointer-events: auto;
  }
  .apgo-cc-confirm-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
    opacity: 0;
    transition: opacity .25s ease;
  }
  .apgo-cc-confirm-modal.is-open .apgo-cc-confirm-modal__backdrop {
    opacity: 1;
  }
  .apgo-cc-confirm-modal__panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background: #141414;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px 18px 0 0;
    max-height: 88vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transform: translateY(100%);
    transition: transform .3s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.6);
  }
  .apgo-cc-confirm-modal.is-open .apgo-cc-confirm-modal__panel {
    transform: translateY(0);
  }
  @media (min-width: 750px) {
    .apgo-cc-confirm-modal__panel {
      left: 50%;
      right: auto;
      bottom: auto;
      top: 50%;
      width: min(440px, calc(100vw - 32px));
      transform: translate(-50%, -45%) scale(0.96);
      border-radius: 18px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      transition: transform .25s cubic-bezier(0.22, 1, 0.36, 1), opacity .2s ease;
      opacity: 0;
    }
    .apgo-cc-confirm-modal.is-open .apgo-cc-confirm-modal__panel {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
  }

  .apgo-cc-confirm-modal__close {
    position: absolute;
    top: 8px;
    right: 8px;
    background: transparent;
    border: 0;
    border-radius: 4px;
    width: 28px;
    height: 28px;
    padding: 0;
    color: rgba(255, 255, 255, 0.7);
    display: grid;
    place-items: center;
    cursor: pointer;
    z-index: 1;
    transition: background .15s ease, color .15s ease;
  }
  .apgo-cc-confirm-modal__close:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .apgo-cc-confirm-modal__body {
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 36px 20px 20px;
    flex: 1 1 auto;
    min-height: 0;
  }
  .apgo-cc-confirm-modal__body > * + * {
    margin-top: 16px;
  }

  /* Variation block inside the modal — same look as inline white-on-dim, but only
     the active one is shown (we copy the single active section). */
  .apgo-cc-confirm-modal__variation {
    font-size: 12px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.92);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding-top: 12px;
  }
  .apgo-cc-confirm-modal__variation:empty {
    display: none;
  }
  /* The body content gets dropped in as plain HTML; first line bolder */

  /* Product summary row above the variation block: small thumbnail + price.
     Image is refreshed by syncConfirmModal() to the active variant's featured image. */
  .apgo-cc-confirm-modal__summary {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .apgo-cc-confirm-modal__thumb {
    flex: 0 0 auto;
    width: 96px;
    height: 96px;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
  .apgo-cc-confirm-modal__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .apgo-cc-confirm-modal__summary-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .apgo-cc-confirm-modal__price {
    font-size: 18px;
    font-weight: 700;
    color: var(--primary-orange, #f08418);
  }

  .apgo-cc-confirm-modal__actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    padding: 10px 20px calc(16px + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: #141414;
  }
  /* Intent-based action visibility:
       add  → only Add to cart
       buy  → only Buy now
       both → both buttons (variant area tap → user hasn't expressed intent yet) */
  .apgo-cc-confirm-modal[data-intent="add"] [data-apgo-cc-confirm-buy] { display: none; }
  .apgo-cc-confirm-modal[data-intent="buy"] [data-apgo-cc-confirm-add] { display: none; }
  .apgo-cc-confirm-modal[data-intent="both"] .apgo-cc-confirm-modal__actions {
    grid-template-columns: 1fr 1fr;
  }

  body.apgo-cc-confirm-open {
    overflow: hidden;
  }

  /* =============================================================
     Car Care Mobile Buy Bar (Block B)
     - Fixed bottom, mobile only (≤749px). Desktop hidden.
     - Tokens reused from APGO theme: --primary-orange, --dark-bg, etc.
     ============================================================= */
  .apgo-cc-buybar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 100000;
    pointer-events: none;
    display: block;
  }
  /* Buybar + confirm modal are MOBILE ONLY (≤1023px). Desktop uses the
     inline Add/Buy CTA row + inline qty stepper inside the form. */
  @media (min-width: 1024px) {
    .apgo-cc-buybar { display: none !important; }
    .apgo-cc-confirm-modal { display: none !important; }
  }

  .apgo-cc-buybar__backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    opacity: 0;
    visibility: hidden;
    transition: opacity .25s ease, visibility .25s ease;
    pointer-events: none;
  }
  .apgo-cc-buybar.is-open .apgo-cc-buybar__backdrop {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .apgo-cc-buybar__panel {
    position: relative;
    background: #141414;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px 16px 0 0;
    pointer-events: auto;
    box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.45);
  }

  /* Sheet: collapsed = 0 height; expanded = scrollable up to 65vh */
  .apgo-cc-buybar__sheet {
    max-height: 0;
    overflow: hidden;
    transition: max-height .3s ease;
  }
  .apgo-cc-buybar.is-open .apgo-cc-buybar__sheet {
    max-height: 65vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .apgo-cc-buybar__sheet-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 16px 8px;
    gap: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .apgo-cc-buybar__collapse {
    background: transparent;
    border: none;
    color: var(--text-gray, #a8a8a8);
    font-size: 12px;
    padding: 4px 6px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .apgo-cc-buybar__cart-title {
    padding: 14px 16px 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text-white, #fff);
  }

  .apgo-cc-buybar__items {
    padding: 4px 16px 8px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .apgo-cc-buybar__empty {
    margin: 16px 0;
    color: var(--text-gray, #a8a8a8);
    font-size: 13px;
    text-align: center;
  }
  .apgo-cc-buybar__item {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    align-items: center;
    gap: 10px;
  }
  .apgo-cc-buybar__item-thumb {
    width: 44px;
    height: 44px;
    border-radius: 6px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.04);
  }
  .apgo-cc-buybar__item-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .apgo-cc-buybar__item-info { min-width: 0; }
  .apgo-cc-buybar__item-name {
    font-size: 13px;
    line-height: 1.3;
    color: var(--text-white, #fff);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .apgo-cc-buybar__item-qty {
    font-size: 11px;
    color: var(--text-gray, #a8a8a8);
    margin-top: 2px;
  }
  .apgo-cc-buybar__item-price {
    font-size: 13px;
    font-weight: 600;
    color: var(--primary-orange, #f08418);
    white-space: nowrap;
  }

  .apgo-cc-buybar__subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 12px 16px 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .apgo-cc-buybar__subtotal-label {
    font-size: 12px;
    color: var(--text-gray, #a8a8a8);
  }
  .apgo-cc-buybar__subtotal-val {
    font-size: 16px;
    font-weight: 700;
    color: var(--primary-orange, #f08418);
  }

  /* Bottom CTA bar (always visible) */
  .apgo-cc-buybar__bar {
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .apgo-cc-buybar__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    background: transparent;
    border: none;
    padding: 4px 2px;
    color: inherit;
    cursor: pointer;
    width: 100%;
  }
  /*
    When the mini-cart sheet is expanded, the sheet head already shows a
    Close button + chip with the same item count + total, so the duplicate
    "View cart" handle row below would be redundant. Hide it while open.
  */
  .apgo-cc-buybar.is-open .apgo-cc-buybar__top {
    display: none;
  }
  .apgo-cc-buybar__top-hint {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--text-gray, #a8a8a8);
  }
  .apgo-cc-buybar__top-hint-icon {
    flex-shrink: 0;
    display: block;
  }
  .apgo-cc-buybar__chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: rgba(240, 132, 24, 0.2);
    color: var(--primary-orange, #f08418);
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
  }
  .apgo-cc-buybar__chip-sep { opacity: 0.6; }

  .apgo-cc-buybar__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .apgo-cc-buybar__btn {
    /* Match .apgo-cc-pdp__cta in the modal + inline CTA row for height consistency */
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 1.2;
    font-weight: 600;
    cursor: pointer;
    transition: opacity .15s ease, background .15s ease;
    border: 2px solid var(--primary-orange, #f08418);
    background: transparent;
    color: var(--primary-orange, #f08418);
  }
  .apgo-cc-buybar__btn--buy {
    background: linear-gradient(45deg, var(--primary-orange, #f08418), var(--secondary-orange, #ff9a3c));
    color: #fff;
  }
  .apgo-cc-buybar__btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /*
    Buybar add-to-cart feedback now reuses the global #apgo-cart-toast pill
    (style: snippets/apgo-cart-toast.liquid, JS reused: apgo-cc-buybar.js
    showToast). No section-local toast CSS needed.
  */
</style>

<div class="apgo-product-section" data-apgo-currency="{{ cart.currency.iso_code }}" data-apgo-pdp="v3">
  <!-- 頂部導航 -->

  <!-- 主內容區 -->
  <main class="apgo-main-container">
    <!-- 產品主視覺區 -->
    <section class="apgo-hero-visual">
      {% if section.settings.show_particles %}
        <div class="apgo-floating-particles">
          <div class="apgo-particle" style="left: 10%; animation-delay: 0s;"></div>
          <div class="apgo-particle" style="left: 30%; animation-delay: 2s;"></div>
          <div class="apgo-particle" style="left: 50%; animation-delay: 4s;"></div>
          <div class="apgo-particle" style="left: 70%; animation-delay: 6s;"></div>
          <div class="apgo-particle" style="left: 90%; animation-delay: 8s;"></div>
        </div>
      {% endif %}

      <div class="apgo-product-showcase" id="apgoProductShowcase">
        <div class="apgo-carousel-container">
          <div class="apgo-carousel-track" id="apgoCarouselTrack">
            {% for image in product.images %}
              <div class="apgo-carousel-slide">
                <img
                  src="{{ image | image_url: width: 800 }}"
                  alt="{{ product.title }} - {{ 'product.image_alt' | t: index: forloop.index }}"
                  class="apgo-product-image-main is-cover"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                >
              </div>
            {% endfor %}
          </div>
        </div>

        <!-- 輪播指示點 -->
        <div class="apgo-swipe-indicator">
          <div class="apgo-swipe-dots">
            {% for image in product.images %}
              <span
                class="apgo-dot {% if forloop.first %}active{% endif %}"
                data-index="{{ forloop.index0 }}"
                onclick="apgoGoToSlide({{ forloop.index0 }})"
              ></span>
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="apgo-product-badges">
        {% if product.metafields.apgo.badges %}
          {% for badge_text in product.metafields.apgo.badges.value %}
            <span class="apgo-badge">{{ badge_text }}</span>
          {% endfor %}
        {% else %}
          {% for block in section.blocks %}
            {% if block.type == 'badge' %}
              <span class="apgo-badge">{{ block.settings.text }}</span>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </section>

    <!-- 產品縮圖展示區（編輯器開關：show_thumbnails，預設開） -->
    {% if section.settings.show_thumbnails %}
    <section class="apgo-product-thumbnails{% if subtitle_display == blank %} apgo-product-thumbnails--no-subtitle-below{% endif %}">
      <div class="apgo-thumbnails-container">
        {% for image in product.images %}
          <div
            class="apgo-thumbnail-item {% if forloop.first %}active{% endif %}"
            onclick="apgoSelectThumbnail(this, '{{ image | image_url: width: 1200 }}')"
            data-index="{{ forloop.index0 }}"
          >
            <img
              src="{{ image | image_url: width: 150 }}"
              alt="{{ product.title }} - {{ 'product.image_alt' | t: index: forloop.index }}"
              class="apgo-thumbnail-image"
              loading="lazy"
            >
          </div>
        {% endfor %}
      </div>
    </section>
    {% endif %}

    <!-- 產品基本資訊 -->
    <section class="apgo-product-info{% if subtitle_display == blank %} apgo-product-info--no-subtitle{% endif %}">
      <div class="apgo-product-header">
        <h1 class="apgo-product-name">{{ product.title }}</h1>
        {% comment %}
          副標來自檔案頂端 liquid：custom.product_subtitle（metafield_text）→ fallback apgo.subtitle，變數名 subtitle_display。
        {% endcomment %}
        {% if subtitle_display != blank %}
          <p class="apgo-product-metafield-subtitle">{{ subtitle_display | escape }}</p>
        {% endif %}
      </div>

      {%- comment -%}
        ============================================================
        Car Care inline price / promo / variant / qty / shipping / CTA
        (Phase 2: replaces the old modal-only variant flow.)
        - Money values use Shopify's `money` filter so MY/SG/TW currencies
          render correctly per the active market.
        - Labels in English (Limited time deal / Save / Quantity / In stock /
          Out of stock / Add to cart / Buy now) per user direction.
        - Wraps in <form.apgo-cc-pdp__form> so apgo-cc-buybar.js can read
          variant id + quantity via FormData.
        ============================================================
      {%- endcomment -%}
      {%- assign on_sale = false -%}
      {%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}
      {%- assign save_amount = product.compare_at_price | minus: product.price -%}

      {%- comment -%}
        Buy column wrapper — groups price card + promos + form + variants JSON so the
        desktop 2-col grid can pull this entire block to the right (col 2) while leaving
        the gallery + thumbs + title on the left. On mobile this wrapper is just a passive
        block (display:contents-equivalent), no styles applied.
      {%- endcomment -%}
      <div class="apgo-cc-pdp__buy-col">

      {%- comment -%}
        Price card — boxed style with orange left border on sale; plain large on regular.
        data-cents attributes carry raw cents so the inline JS can re-render via Intl.NumberFormat
        using the active market currency (Liquid's `| money` defaults to shop currency, which can
        mismatch the buyer's market in multi-market stores).
      {%- endcomment -%}
      <div class="apgo-cc-pdp__price-card{% if on_sale %} apgo-cc-pdp__price-card--sale{% endif %}">
        {%- if on_sale -%}
          <div class="apgo-cc-pdp__price-top">
            <span class="apgo-cc-pdp__price-label">{{ section.settings.deal_label | default: 'Limited time deal' }}</span>
            {%- comment -%}
              Optional countdown timer next to the LIMITED TIME DEAL badge.
              Admin sets either a fixed end date/time (section.settings.deal_end_at,
              ISO format like "2026-05-31T23:59:00+08:00") or a per-visitor
              evergreen countdown that restarts on first visit (deal_evergreen_hours).
              JS picks the source at boot.
            {%- endcomment -%}
            {%- assign deal_end = section.settings.deal_end_at | strip -%}
            {%- assign deal_evergreen = section.settings.deal_evergreen_hours | default: 0 -%}
            {%- if deal_end != blank or deal_evergreen > 0 -%}
              <span
                class="apgo-cc-pdp__deal-timer"
                data-apgo-deal-timer
                {% if deal_end != blank %}data-deal-end="{{ deal_end | escape }}"{% endif %}
                {% if deal_evergreen > 0 %}data-deal-evergreen-hours="{{ deal_evergreen }}"{% endif %}
                data-deal-product-id="{{ product.id }}"
                aria-label="{{ section.settings.deal_aria_label | default: 'Deal countdown' | escape }}"
              >
                <span class="apgo-cc-pdp__deal-timer-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="13" r="8"/>
                    <line x1="12" y1="9" x2="12" y2="13"/>
                    <line x1="12" y1="13" x2="15" y2="15"/>
                    <line x1="9" y1="2" x2="15" y2="2"/>
                  </svg>
                </span>
                <span class="apgo-cc-pdp__deal-timer-text" data-apgo-deal-timer-text>{{ section.settings.deal_loading_text | default: 'Ends soon' }}</span>
              </span>
            {%- endif -%}
          </div>
          <div class="apgo-cc-pdp__price-bottom">
            <span class="apgo-cc-pdp__price-current" data-apgo-cc-price data-cents="{{ product.price }}">{{ product.price | money }}</span>
            <span class="apgo-cc-pdp__price-compare" data-apgo-cc-compare data-cents="{{ product.compare_at_price }}">{{ product.compare_at_price | money }}</span>
            <span class="apgo-cc-pdp__price-save" data-apgo-cc-save data-cents="{{ save_amount }}">Save {{ save_amount | money }}</span>
          </div>
        {%- else -%}
          <span class="apgo-cc-pdp__price-current" data-apgo-cc-price data-cents="{{ product.price }}">{{ product.price | money }}</span>
        {%- endif -%}
      </div>

      {%- comment -%} Promo pills row (admin-configurable 1-3 pills with colour). {%- endcomment -%}
      {%- if section.settings.show_promo_pills -%}
        {%- assign p1 = section.settings.promo_pill_1_text -%}
        {%- assign p2 = section.settings.promo_pill_2_text -%}
        {%- assign p3 = section.settings.promo_pill_3_text -%}
        {%- if p1 != blank or p2 != blank or p3 != blank -%}
          <div class="apgo-cc-pdp__promos">
            {%- if p1 != blank -%}
              <span class="apgo-cc-pdp__promo apgo-cc-pdp__promo--{{ section.settings.promo_pill_1_color }}">{{ p1 }}</span>
            {%- endif -%}
            {%- if p2 != blank -%}
              <span class="apgo-cc-pdp__promo apgo-cc-pdp__promo--{{ section.settings.promo_pill_2_color }}">{{ p2 }}</span>
            {%- endif -%}
            {%- if p3 != blank -%}
              <span class="apgo-cc-pdp__promo apgo-cc-pdp__promo--{{ section.settings.promo_pill_3_color }}">{{ p3 }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}

      <form action="/cart/add" method="post" enctype="multipart/form-data" class="apgo-cc-pdp__form" data-apgo-cc-form>
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-apgo-cc-variant-id>

        {%- for option in product.options_with_values -%}
          <div class="apgo-cc-pdp__option-group" data-apgo-cc-option-group data-option-position="{{ option.position }}">
            <div class="apgo-cc-pdp__option-label">
              {%- comment -%}
                Hardcode "Variations" instead of {{ option.name }} so the label
                stays consistent regardless of whatever the admin named the
                option in Shopify (e.g. "Atomic Coating" / "Style" / "Bundle Type").
                If we ever need multi-option products to distinguish their groups,
                fall back to option.name for groups beyond the first.
              {%- endcomment -%}
              {%- comment -%}
                Inline picker label format: "Select option (N type)" where N is
                the number of values in the first option group. The selected
                value used to render here too but the chip itself shows active
                state already, so the duplicated text is suppressed.
              {%- endcomment -%}
              <span class="apgo-cc-pdp__option-name">
                {%- if forloop.first -%}
                  Select option <span class="apgo-cc-pdp__option-count">({{ option.values.size }} type{% if option.values.size != 1 %}s{% endif %})</span>
                {%- else -%}
                  {{ option.name }}
                {%- endif -%}
              </span>
              <span class="apgo-cc-pdp__option-current" data-apgo-cc-option-current hidden></span>
            </div>
            <div class="apgo-cc-pdp__option-chips">
              {%- for value in option.values -%}
                <label class="apgo-cc-pdp__chip {% if option.selected_value == value %}is-active{% endif %}">
                  <input
                    type="radio"
                    name="options[{{ option.name | escape }}]"
                    value="{{ value | escape }}"
                    data-apgo-cc-option-input
                    {% if option.selected_value == value %}checked{% endif %}
                  >
                  <span>{{ value }}</span>
                </label>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}

        {%- comment -%}
          Quantity stepper — desktop only (≥1024px). On mobile the visible row
          is hidden via CSS and the confirm modal (opened from the bottom buybar)
          provides its own qty stepper. The same data-apgo-cc-qty-input below is
          the canonical quantity carrier; the modal mirrors its value back.
        {%- endcomment -%}
        <div class="apgo-cc-pdp__qty-row apgo-cc-pdp__qty-row--desktop">
          <span class="apgo-cc-pdp__qty-label">Quantity</span>
          <div class="apgo-cc-pdp__qty">
            <button type="button" data-apgo-cc-qty="down" aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" value="1" min="1" inputmode="numeric" data-apgo-cc-qty-input>
            <button type="button" data-apgo-cc-qty="up" aria-label="Increase quantity">+</button>
          </div>
        </div>

        {%- comment -%}
          Variation block — variant-aware.
          Source: product.metafields.custom.variation. Admin writes each
          variant's bundle contents separated by a BLANK LINE, e.g.:

            Atomic Sealing Bottle
            Bundle includes:
            ✅ Atomic Coating ×1
            ✅ Coating Cloth ×1
                                    ← blank line splits sections
            Atomic Sealing Bundle
            Bundle includes:
            ✅ Atomic Coating ×1
            ...

          Pipeline:
            1. escape → newline_to_br: turn raw text into HTML-safe markup
               where each \n becomes <br />, so two consecutive newlines
               (blank line) become <br /><br />.
            2. split on <br /><br /> → array of per-variant section strings.
            3. For each section, the first line (before any <br />) is the
               variant key. Stored on data-variant-key (lowercased).
            4. All sections rendered into the DOM with `hidden` attribute.
               apgo_product_page_v3 inline JS reads v.title and toggles
               `hidden` so only the matching section is visible at a time.

          Fallback: if the metafield has no blank lines (single section),
          render exactly as before — the whole body shows for every variant.
        {%- endcomment -%}
        {%- assign variation_inline_raw = product.metafields.custom.variation.value | default: '' | strip -%}
        {%- if variation_inline_raw != blank -%}
          {%- comment -%}
            Variant-aware variation block — DESKTOP ONLY (≥1024px). Shows the
            active variant's bundle contents in the right-side picker. On
            mobile the block is hidden via CSS, but stays in the DOM so the
            confirm modal can still read `.is-active` as its data source.
          {%- endcomment -%}
          <section class="apgo-cc-pdp__variation apgo-cc-pdp__variation--desktop-only" aria-labelledby="apgo-cc-variation-title-{{ section.id }}">
            <h4 class="apgo-cc-pdp__variation-title" id="apgo-cc-variation-title-{{ section.id }}">
              {{ 'product.variation' | t }}
            </h4>

            {%- comment -%}
              Raw metafield text emitted as JSON so JS can apply a robust
              blank-line split regex (Liquid's `split` is exact-string only
              and can't handle '\n  \n' / '\r\n' / trailing-space variations).
              JS builds the per-variant sections at boot.
            {%- endcomment -%}
            <script type="application/json" data-apgo-cc-variation-source>{{ variation_inline_raw | json }}</script>

            <div class="apgo-cc-pdp__variation-sections" data-apgo-cc-variation-sections></div>
          </section>
        {%- endif -%}

        {%- comment -%} Shipping info row: "<label> · ● In stock / Out of stock". {%- endcomment -%}
        {%- if section.settings.show_shipping -%}
          <div class="apgo-cc-pdp__shipping">
            <span class="apgo-cc-pdp__shipping-label">{{ section.settings.shipping_label | default: '2–3 business days' }}</span>
            <span class="apgo-cc-pdp__shipping-sep" aria-hidden="true">·</span>
            <span class="apgo-cc-pdp__shipping-stock{% unless product.available %} apgo-cc-pdp__shipping-stock--out{% endunless %}">
              {%- if product.available -%}● In stock{%- else -%}● Out of stock{%- endif -%}
            </span>
          </div>
        {%- endif -%}

        {%- comment -%}
          Desktop CTA row. Visible only ≥1024px (CSS `.apgo-cc-pdp__cta-row`).
          Mobile commits via the bottom buybar → confirm modal flow instead.
        {%- endcomment -%}
        <div class="apgo-cc-pdp__cta-row">
          <button type="button" class="apgo-cc-pdp__cta apgo-cc-pdp__cta--secondary" data-apgo-cc-add>
            {%- if product.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
          </button>
          <button type="button" class="apgo-cc-pdp__cta apgo-cc-pdp__cta--primary" data-apgo-cc-buy-now>Buy now</button>
        </div>
      </form>

      {%- comment -%}
        Variants JSON for client-side option → variant matching.
        Read by the inline-picker JS at the section's script tail.
      {%- endcomment -%}
      <script type="application/json" data-apgo-cc-variants>
        {{ product.variants | json }}
      </script>

      </div>{%- comment -%} / .apgo-cc-pdp__buy-col {%- endcomment -%}

      {% if product.metafields.apgo.performance_metrics.value %}
        <div class="apgo-performance-metrics">
          <h3 class="apgo-metrics-title">{{ 'product.performance_metrics' | t }}</h3>

          {% if product.metafields.apgo.performance_metrics %}
            {% assign metrics = product.metafields.apgo.performance_metrics.value %}
            {% for metric in metrics %}
              <div class="apgo-metric-item">
                <div class="apgo-metric-header">
                  <span class="apgo-metric-label">{{ metric.label }}</span>
                  <span class="apgo-metric-value">{{ metric.value }}</span>
                </div>
                <div class="apgo-metric-bar">
                  <div class="apgo-metric-fill" style="width: {{ metric.percent }}%;"></div>
                </div>
              </div>
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}
              {% if block.type == 'metric' %}
                <div class="apgo-metric-item">
                  <div class="apgo-metric-header">
                    <span class="apgo-metric-label">{{ block.settings.label }}</span>
                    <span class="apgo-metric-value">{{ block.settings.value }}</span>
                  </div>
                  <div class="apgo-metric-bar">
                    <div class="apgo-metric-fill" style="width: {{ block.settings.percent }}%;"></div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      {% endif %}
    </section>

    {% liquid
      assign tab_desc_media = product.metafields.custom.tab_description_images.value

      assign looping_video_obj = product.metafields.custom.looping_video.value
      assign looping_video_media = blank

      if looping_video_obj != blank
        if looping_video_obj.media_type == 'video' or looping_video_obj.sources != blank
          assign looping_video_media = looping_video_obj
        elsif looping_video_obj.video != blank
          assign looping_video_media = looping_video_obj.video.value | default: looping_video_obj.video
        elsif looping_video_obj.video_file != blank
          assign looping_video_media = looping_video_obj.video_file.value | default: looping_video_obj.video_file
        endif
      endif

      assign has_looping_video = false
      if looping_video_media != blank
        assign has_looping_video = true
      endif
      assign looping_description_value = product.metafields.custom.looping_description

      assign how_to_use_raw = product.metafields.custom.how_to_use.value | default: '' | strip
      assign variation_raw = product.metafields.custom.variation.value | default: '' | strip

      assign desc_has = false
      if product.description != blank
        assign desc_has = true
      endif

      assign loop_desc_has = false
      if looping_description_value != blank
        assign loop_desc_has = true
      endif

      assign gallery_has = false
      if tab_desc_media != blank
        assign gallery_has = true
      endif

      assign description_tab_pic_list = product.metafields.custom.description_pic.value
      assign description_tab_pics_has = false
      if description_tab_pic_list != blank and description_tab_pic_list.size != 0
        assign description_tab_pics_has = true
      endif

      assign sf = subtitle_display | strip

      assign how_has = false
      if how_to_use_raw != blank
        assign how_has = true
      endif

      assign insidebox_image = product.metafields.custom.insidebox.value | default: product.metafields.custom.insidebox
      assign precautions_text = product.metafields.custom.precautions.value | default: product.metafields.custom.precautions
      assign precautions_has = false
      if precautions_text != blank
        assign precautions_has = true
      endif

      assign how_tab_has_any = false
      if how_has or precautions_has
        assign how_tab_has_any = true
      endif

      assign var_has = false
      if variation_raw != blank
        assign var_has = true
      endif

      assign customer_review_image = product.metafields.custom.customer_review.value | default: product.metafields.custom.customer_review
      assign mobile_review_list = product.metafields.custom.customer_review_mobile.value

      assign review_has_any = false
      if customer_review_image != blank
        assign review_has_any = true
      endif
      if mobile_review_list != blank
        assign review_has_any = true
      endif

      assign product_faq_list = product.metafields.custom.product_faq.value
      assign faq_has_any = false
      if product_faq_list != blank
        for faq_entry in product_faq_list
          assign faq_q = faq_entry.question.value | default: faq_entry.question | strip
          assign faq_a = faq_entry.answer.value | default: faq_entry.answer | strip
          if faq_q != blank and faq_a != blank
            assign faq_has_any = true
            break
          endif
        endfor
      endif

      assign lead_has_text = false
      if desc_has or loop_desc_has or sf != blank
        assign lead_has_text = true
      endif
      assign lead_has_visual = false
      if lead_has_text or gallery_has or has_looping_video
        assign lead_has_visual = true
      endif
    %}
    <section class="apgo-pdp-looping-lead" aria-label="Description — video and details">
      <div class="apgo-pdp-tabs-inner">
        <div class="apgo-tab-desc-layout {% if has_looping_video %}has-video{% endif %}">
          {% if has_looping_video %}
            <div class="apgo-looping-video-wrap">
              {{
                looping_video_media
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true
              }}
            </div>
          {% endif %}

          <div class="apgo-looping-desc-wrap">
            <h4 class="apgo-looping-desc-block-title apgo-looping-desc-block-title--leadin">Description</h4>

            {% if gallery_has %}
              <div class="apgo-tab-desc-gallery">
                {% for mf in tab_desc_media %}
                  {% assign mf_mt = mf.media_type | default: '' | downcase %}
                  {% if mf_mt contains 'video' %}
                    {{
                      mf
                      | video_tag:
                        controls: true,
                        muted: false,
                        playsinline: true,
                        preload: 'metadata'
                    }}
                  {% else %}
                    <img
                      src="{{ mf | image_url: width: 1200 }}"
                      alt="{{ product.title | escape }} — {{ forloop.index }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      {% if mf.width and mf.height %}
                        width="{{ mf.width }}"
                        height="{{ mf.height }}"
                      {% endif %}
                    >
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% unless lead_has_visual or var_has %}
              <p class="apgo-tab-empty">No description available.</p>
            {% endunless %}
            {% if lead_has_text %}
              <div class="apgo-looping-desc-content">
                {% if desc_has %}
                  <div class="apgo-looping-desc-block apgo-looping-desc-block--description">
                    {{ product.description }}
                  </div>
                {% elsif loop_desc_has %}
                  {{ looping_description_value | metafield_tag }}
                {% elsif sf != blank %}
                  <div class="apgo-looping-desc-block apgo-looping-desc-block--description">
                    {{ sf | escape | newline_to_br }}
                  </div>
                {% endif %}
              </div>
            {% endif %}

            {%- comment -%}
              Static full-metafield Variation block — shows ALL variants stacked
              for reference. The variant-aware "currently active" block lives in
              the right-side inline picker (desktop) / confirm modal (mobile).
            {%- endcomment -%}
            {%- assign variation_lead_raw = product.metafields.custom.variation.value | default: '' | strip -%}
            {%- if variation_lead_raw != blank -%}
              <section class="apgo-lead-variation" aria-label="Variation contents">
                <h4 class="apgo-lead-variation__title">{{ 'product.variation' | t }}</h4>
                <div class="apgo-lead-variation__body">{{ variation_lead_raw | escape | newline_to_br }}</div>
              </section>
            {%- endif -%}
          </div>
        </div>
      </div>
    </section>

    {% if insidebox_image != blank %}
      <section class="apgo-insidebox">
        <div class="apgo-insidebox-inner">
          <h3 class="apgo-insidebox-title">{{ 'product.whats_included' | t }}</h3>
          <p class="apgo-insidebox-subline">{{ 'product.whats_included_subline' | t }}</p>
          <img
            class="apgo-insidebox-image"
            src="{{ insidebox_image | image_url: width: 2000 }}"
            alt="{{ 'product.whats_included' | t }}"
            loading="lazy"
          >
        </div>
      </section>
    {% endif %}

    <!-- 短影音展示區 -->
    <section class="apgo-video-showcase">
      <div class="apgo-video-header">
        <h3 class="apgo-video-title">{{ 'product.video_showcase' | t }}</h3>
      </div>

      <div class="apgo-video-scroll-container">
        {%- comment -%}
          apgo.demo_videos 的 metafield 型別已被確認為「List of metaobject reference」(metaobject type: apgo_demo_video)。
          先前用 demo_raw.first.video_file 偵測會失敗：Shopify 在這裡的 list-of-metaobject Drop 上，
          .first 取到的代理物件無法讀到內部 field（H6 confirmed via runtime probe），
          但 `for x in demo_raw` 的 loop 變數能正確讀到。因此直接固定走 metaobject 分支。
        {%- endcomment -%}
        {% liquid
          assign demo_raw = product.metafields.apgo.demo_videos.value
          assign use_metaobject_list = false
          assign use_file_list = false
          if demo_raw != blank
            assign use_metaobject_list = true
          endif
        %}
        {% if use_metaobject_list %}
          {% assign video_objects = demo_raw %}
          {% assign sorted_videos = video_objects | sort: 'sort_order' %}

          {% for video_obj in sorted_videos %}
            {% assign video_url = video_obj.video_file | file_url %}
            {%- liquid
              # 封面優先序：
              #   1. metaobject 自定欄位「封面圖片」(handle: cover_image / poster)
              #   2. Shopify 自動為影片檔案產生的 preview_image（fallback；iOS Safari 上 JS 抽幀無法穩定運作）
              assign poster_url = ''
              if video_obj.cover_image != blank
                assign poster_url = video_obj.cover_image | image_url: width: 800
              elsif video_obj.poster != blank
                assign poster_url = video_obj.poster | image_url: width: 800
              elsif video_obj.video_file.preview_image != blank
                assign poster_url = video_obj.video_file.preview_image | image_url: width: 800
              endif
            -%}

            <div
              class="apgo-video-card"
              data-source="metaobject"
              data-video-url="{{ video_url | escape }}"
              data-video-index="{{ forloop.index }}"
            >
              {% if poster_url != blank %}
                <img
                  class="apgo-video-thumbnail"
                  src="{{ poster_url }}"
                  alt="{{ video_obj.title | default: product.title }}"
                  loading="lazy"
                >
              {% else %}
                <div class="apgo-video-thumbnail apgo-video-placeholder" style="position: relative;">
                  <svg
                    width="60"
                    height="60"
                    viewBox="0 0 24 24"
                    fill="#f08418"
                    style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);"
                  >
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  <div style="background: #333; width: 100%; height: 100%;"></div>
                </div>
              {% endif %}

              <div class="apgo-video-overlay">
                <div class="apgo-video-play-btn"></div>
                <div class="apgo-video-info">
                  <div class="apgo-video-subtitle">
                    {% if video_obj.title %}
                      {{ video_obj.title }}
                    {% else %}
                      {{ 'product.video_default_title' | t }}
                    {% endif %}
                  </div>
                  <div class="apgo-video-views">
                    {{ 'product.video_views' | t: count: video_obj.views | default: '1.2萬' }}
                  </div>
                </div>
              </div>
              <span class="apgo-video-duration">
                {{ video_obj.duration | default: '0:45' }}
              </span>
            </div>
          {% endfor %}
        {% elsif use_file_list %}
          {% for file_ref in demo_raw %}
            {% assign video_url = file_ref | file_url %}
            {%- liquid
              assign poster_url = ''
              if file_ref.preview_image != blank
                assign poster_url = file_ref.preview_image | image_url: width: 800
              endif
            -%}
            <div
              class="apgo-video-card"
              data-source="file"
              data-video-url="{{ video_url | escape }}"
              data-video-index="{{ forloop.index }}"
            >
              {% if poster_url != blank %}
                <img
                  class="apgo-video-thumbnail"
                  src="{{ poster_url }}"
                  alt="{{ product.title }}"
                  loading="lazy"
                >
              {% else %}
                <div class="apgo-video-thumbnail apgo-video-placeholder" style="position: relative;">
                  <svg
                    width="60"
                    height="60"
                    viewBox="0 0 24 24"
                    fill="#f08418"
                    style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);"
                  >
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  <div style="background: #333; width: 100%; height: 100%;"></div>
                </div>
              {% endif %}

              <div class="apgo-video-overlay">
                <div class="apgo-video-play-btn"></div>
                <div class="apgo-video-info">
                  <div class="apgo-video-subtitle">
                    {% if file_ref.alt != blank %}
                      {{ file_ref.alt }}
                    {% else %}
                      {{ 'product.video_default_title' | t }} {{ forloop.index }}
                    {% endif %}
                  </div>
                  <div class="apgo-video-views">{{ 'product.video_views' | t: count: forloop.index }}</div>
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="apgo-no-videos">
            <p>{{ 'product.no_videos' | t }}</p>
          </div>
        {% endif %}
      </div>
    </section>

    <section
      class="apgo-pdp-tabs"
      aria-label="Product detail tabs"
      data-apgo-pdp-tabs-root="{{ section.id }}"
    >
      <div class="apgo-pdp-tabs-inner">
        <div class="apgo-pdp-tablist-wrap">
          <div class="apgo-pdp-tablist" role="tablist">
            <button
              type="button"
              class="apgo-pdp-tab"
              role="tab"
              id="apgo-tab-desc-{{ section.id }}"
              aria-controls="apgo-tab-panel-desc-{{ section.id }}"
              aria-selected="true"
              tabindex="0"
            >
              Description
            </button>
            <button
              type="button"
              class="apgo-pdp-tab"
              role="tab"
              id="apgo-tab-how-{{ section.id }}"
              aria-controls="apgo-tab-panel-how-{{ section.id }}"
              aria-selected="false"
              tabindex="-1"
            >
              How to use
            </button>
            {% if faq_has_any %}
              <button
                type="button"
                class="apgo-pdp-tab"
                role="tab"
                id="apgo-tab-faq-{{ section.id }}"
                aria-controls="apgo-tab-panel-faq-{{ section.id }}"
                aria-selected="false"
                tabindex="-1"
              >
                {{ 'product.faq_tab' | t }}
              </button>
            {% endif %}
            <button
              type="button"
              class="apgo-pdp-tab"
              role="tab"
              id="apgo-tab-rev-{{ section.id }}"
              aria-controls="apgo-tab-panel-rev-{{ section.id }}"
              aria-selected="false"
              tabindex="-1"
            >
              Review
            </button>
          </div>
        </div>

        <div class="apgo-tab-panels">
          <div
            class="apgo-tab-panel apgo-looping-desc-content{% if description_tab_pics_has %} apgo-tab-panel--description{% endif %}"
            id="apgo-tab-panel-desc-{{ section.id }}"
            role="tabpanel"
            aria-labelledby="apgo-tab-desc-{{ section.id }}"
          >
            {% if description_tab_pics_has %}
              <div class="apgo-tab-desc-gallery apgo-description-tab-gallery">
                {% for pic in description_tab_pic_list %}
                  {% if pic != blank %}
                    <img
                      src="{{ pic | image_url: width: 1400 }}"
                      alt="{{ product.title | escape }} — {{ forloop.index }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      {% if pic.width and pic.height %}
                        width="{{ pic.width }}"
                        height="{{ pic.height }}"
                      {% endif %}
                    >
                  {% endif %}
                {% endfor %}
              </div>
            {% else %}
              <div class="apgo-tab-pane-empty-slot" aria-hidden="true">&nbsp;</div>
            {% endif %}

          </div>

          <div
            class="apgo-tab-panel"
            id="apgo-tab-panel-how-{{ section.id }}"
            role="tabpanel"
            aria-labelledby="apgo-tab-how-{{ section.id }}"
            hidden
          >
            {% if how_tab_has_any %}
              <div class="apgo-looping-desc-content">
                {% if how_has %}
                  <h4 class="apgo-looping-desc-block-title">{{ 'product.how_to_use' | t }}</h4>
                  <div class="apgo-tab-plain-body">{{ how_to_use_raw | escape | newline_to_br }}</div>
                {% endif %}
                {% if precautions_has %}
                  <h4 class="apgo-looping-desc-block-title">{{ 'product.precautions' | t }}</h4>
                  <div class="apgo-tab-plain-body">{{ precautions_text | escape | newline_to_br }}</div>
                {% endif %}
              </div>
            {% else %}
              <p class="apgo-tab-empty">No usage instructions available.</p>
            {% endif %}
          </div>

          {% if faq_has_any %}
            <div
              class="apgo-tab-panel apgo-tab-panel--faq"
              id="apgo-tab-panel-faq-{{ section.id }}"
              role="tabpanel"
              aria-labelledby="apgo-tab-faq-{{ section.id }}"
              hidden
            >
              <div class="apgo-pdp-faq-list">
                {% for faq_entry in product_faq_list %}
                  {% assign fq = faq_entry.question.value | default: faq_entry.question | strip %}
                  {% assign fa = faq_entry.answer.value | default: faq_entry.answer | strip %}
                  {% if fq != blank and fa != blank %}
                    <details class="apgo-pdp-faq-card">
                      <summary class="apgo-pdp-faq-summary">
                        <span class="apgo-pdp-faq-q">{{ fq | escape }}</span>
                        <span class="apgo-pdp-faq-chevron" aria-hidden="true">
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M6 9l6 6 6-6"/>
                          </svg>
                        </span>
                      </summary>
                      <div class="apgo-pdp-faq-a">{{ fa | escape | newline_to_br }}</div>
                    </details>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endif %}

          <div
            class="apgo-tab-panel apgo-tab-panel--review"
            id="apgo-tab-panel-rev-{{ section.id }}"
            role="tabpanel"
            aria-labelledby="apgo-tab-rev-{{ section.id }}"
            hidden
          >
            {% if review_has_any %}
              <div class="apgo-pdp-review-media-stack">
                {% if customer_review_image != blank %}
                  <img
                    class="apgo-customer-review-image"
                    src="{{ customer_review_image | image_url: width: 2000 }}"
                    alt="Review"
                    loading="lazy"
                  >
                {% endif %}
                {% if mobile_review_list != blank %}
                  {% for mf in mobile_review_list %}
                    {% if mf != blank %}
                      <img
                        class="apgo-customer-review-image"
                        src="{{ mf | image_url: width: 2000 }}"
                        alt="Review {{ forloop.index }}"
                        loading="{% if customer_review_image == blank and forloop.first %}eager{% else %}lazy{% endif %}"
                      >
                    {% endif %}
                  {% endfor %}
                {% endif %}
              </div>
            {% else %}
              <p class="apgo-tab-empty">No customer review images yet.</p>
            {% endif %}
          </div>
        </div>
      </div>
    </section>

    {% liquid
      assign cs_mf = product.metafields.custom.construction_steps
      assign cs_steps = nil
      if cs_mf != blank and cs_mf.value != blank
        assign cs_try = cs_mf.value
        assign cs_probe = cs_try.first.title | default: cs_try.first.desc | default: cs_try.first.description | default: cs_try.first.step
        if cs_probe != blank
          assign cs_steps = cs_try
        else
          assign cs_steps = cs_mf.value | parse_json
        endif
      endif
    %}
    {% if cs_steps != blank %}
      <section class="apgo-construction-steps" id="ConstructionSteps-{{ section.id }}">
        <div class="apgo-construction-steps-inner">
          <header class="apgo-construction-steps-header">
            <h3 class="apgo-construction-steps-title">{{ 'product.construction_steps' | t }}</h3>
          </header>
          {% for step in cs_steps %}
            {% assign st_title = step.title | default: step.step %}
            {% assign st_body = step.desc | default: step.description | default: step.body %}
            {% if st_title != blank or st_body != blank %}
              <article class="apgo-step-card">
                {% if st_title != blank %}
                  <h4 class="apgo-step-card-title">{{ st_title | escape }}</h4>
                {% endif %}
                {% if st_body != blank %}
                  <div class="apgo-step-card-body">{{ st_body | escape | newline_to_br }}</div>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% liquid
      assign rel_mf = product.metafields.custom.related_products
      assign rel_list = nil
      if rel_mf != blank
        assign rel_list = rel_mf.value
      endif
    %}
    {% if rel_list != blank %}
      <section class="apgo-related-mf" id="RelatedMetafield-{{ section.id }}" aria-labelledby="apgo-rel-title-{{ section.id }}">
        <div class="apgo-related-mf-inner">
          <h3 class="apgo-related-mf-title" id="apgo-rel-title-{{ section.id }}">{{ 'product.related_via_metafield' | t }}</h3>
          <div class="apgo-related-mf-grid">
            {% for rp in rel_list limit: 6 %}
              <a class="apgo-related-mf-card" href="{{ rp.url }}">
                <div class="apgo-related-mf-media">
                  {% if rp.featured_image %}
                    <img
                      src="{{ rp.featured_image | image_url: width: 600 }}"
                      alt="{{ rp.title | escape }}"
                      width="600"
                      height="600"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
                <div class="apgo-related-mf-info">
                  <p class="apgo-related-mf-product-title">{{ rp.title }}</p>
                  <p class="apgo-related-mf-price">{{ rp.price_min | money }}</p>
                </div>
              </a>
            {% endfor %}
          </div>
        </div>
      </section>
    {% endif %}

    <!-- 視頻模態框 -->
    <div class="apgo-video-modal" id="apgoVideoModal" aria-hidden="true">
      <div class="apgo-video-modal-overlay"></div>
      <div class="apgo-video-modal-content">
        <button class="apgo-video-modal-close" aria-label="{{ 'general.accessibility.close_modal' | t }}">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
          </svg>
        </button>
        <div class="apgo-video-modal-player" id="apgoVideoPlayer"></div>
      </div>
    </div>

    <!-- 使用步驟時間軸 -->
    <!-- Application Steps removed -->

