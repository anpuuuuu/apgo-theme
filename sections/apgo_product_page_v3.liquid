{% comment %}
  APGO v3 PDP（程式內容同步自 git be16ff9 的 apgo_product_page）
  檔案: sections/apgo_product_page_v3.liquid｜模板: templates/product.v3.json
{% endcomment %}
{% liquid
  assign subtitle_mf = product.metafields['custom']['product_subtitle']
  assign product_metafield_subtitle = ''
  if subtitle_mf != blank
    assign t_sub = subtitle_mf | metafield_text | strip
    if t_sub != blank
      assign product_metafield_subtitle = t_sub
    elsif subtitle_mf.value != blank
      assign product_metafield_subtitle = subtitle_mf.value | strip
    endif
  endif

  assign subtitle_display = product_metafield_subtitle
  if subtitle_display == blank
    assign apgo_sub_mf = product.metafields.apgo.subtitle
    if apgo_sub_mf != blank
      assign t_apgo = apgo_sub_mf | metafield_text | strip
      if t_apgo != blank
        assign subtitle_display = t_apgo
      elsif apgo_sub_mf.value != blank
        assign subtitle_display = apgo_sub_mf.value | strip
      else
        assign subtitle_display = apgo_sub_mf | strip
      endif
    endif
  endif
%}
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  :root {
    --primary-orange: #f08418;
    --secondary-orange: #ff9a3c;
    --dark-bg: #000000;
    --card-bg: #1a1a1a;
    --text-white: #ffffff;
    --text-gray: #b0b0b0;
    --text-light-gray: #cccccc;
    --border-color: #333333;
  }

  .apgo-product-section {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Microsoft JhengHei', sans-serif;
    background: var(--dark-bg);
    color: var(--text-white);
    overflow-x: hidden;
    -ms-overflow-style: none; /* IE 和 Edge */
    scrollbar-width: none; /* Firefox */
    -webkit-font-smoothing: antialiased;
  }

  /* 頂部導航列 */
  .apgo-nav-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 56px;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(240, 132, 24, 0.2);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
  }

  .apgo-back-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(240, 132, 24, 0.1);
    border: 1px solid rgba(240, 132, 24, 0.3);
    border-radius: 50%;
    color: var(--primary-orange);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .apgo-nav-logo {
    height: 35px;
    width: auto;
    filter: brightness(1.1);
  }

  .apgo-nav-actions {
    display: flex;
    gap: 8px;
  }

  .apgo-nav-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    color: var(--text-light-gray);
    cursor: pointer;
  }

  .apgo-cart-count {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 18px;
    height: 18px;
    background: var(--primary-orange);
    color: white;
    border-radius: 50%;
    font-size: 0.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
  }

  /* 主內容區 */
  .apgo-main-container {
    min-height: 100vh;
    padding-bottom: 28px;
    -ms-overflow-style: none; /* IE 和 Edge */
    scrollbar-width: none; /* Firefox */
  }

  /* 產品主視覺區 */
  .apgo-hero-visual {
    position: relative;
    width: 100%;
    height: 400px;
    background: linear-gradient(180deg, rgba(26, 26, 26, 0.8) 0%, rgba(0, 0, 0, 0.95) 100%);
    overflow: hidden;
  }

  /* 動態光點效果 */
  .apgo-floating-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
  }

  .apgo-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: var(--primary-orange);
    border-radius: 50%;
    opacity: 0;
    animation: apgoParticleFloat 10s infinite linear;
  }

  @keyframes apgoParticleFloat {
    0% {
      transform: translateY(100vh) translateX(0);
      opacity: 0;
    }
    10% {
      opacity: 0.6;
    }
    90% {
      opacity: 0.6;
    }
    100% {
      transform: translateY(-10vh) translateX(100px);
      opacity: 0;
    }
  }

  /* 產品展示 */
  .apgo-product-showcase {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    overflow: hidden; /* 添加這行 */
  }

  /* 輪播容器樣式 */
  .apgo-product-showcase {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    overflow: hidden; /* 添加這行 */
  }

  /* 輪播圖片容器 */
  .apgo-carousel-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .apgo-carousel-track {
    display: flex;
    width: 100%;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
    height: 100%;
    align-items: center;
  }

  .apgo-carousel-slide {
    flex: 0 0 100%;
    min-width: 100%;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .apgo-product-image-main {
    animation: none !important;
    transition: opacity 0.2s ease, transform 0.35s ease;
  }

  .apgo-product-image-main.is-cover {
    animation: none !important;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* 產品標籤 */
  .apgo-product-badges {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .apgo-badge {
    background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));
    color: white;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    animation: apgoPulseBadge 2s ease-in-out infinite;
  }

  @keyframes apgoPulseBadge {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  /* 產品縮圖展示區 */
  .apgo-product-thumbnails {
    padding: 20px 16px 32px;
    background: var(--dark-bg);
    margin-bottom: 16px;
  }

  .apgo-thumbnails-container {
    display: flex;
    gap: 12px;
    justify-content: center;
    overflow-x: auto;
    padding: 12px 0;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
    overflow-y: hidden;
    touch-action: pan-x;
    overscroll-behavior-x: contain;
  }

  .apgo-thumbnails-container::-webkit-scrollbar {
    display: none;
  }

  .apgo-thumbnails-container.dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .apgo-thumbnail-item {
    flex: 0 0 auto;
    width: 72px;
    height: 72px;
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    scroll-snap-align: start;
    border: 3px solid transparent;
    background: var(--card-bg);
    touch-action: manipulation;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .apgo-thumbnail-item.active {
    border-color: var(--primary-orange);
    transform: scale(1.08);
    box-shadow: 0 4px 12px rgba(240, 132, 24, 0.3);
  }

  .apgo-thumbnail-item:active {
    transform: scale(0.95);
  }

  .apgo-thumbnail-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #2a2a2a;
    transition: all 0.3s ease;
    border-radius: 12px;
  }

  .apgo-thumbnail-overlay {
    position: absolute;
    inset: 0;
    background: rgba(240, 132, 24, 0.15);
    opacity: 0;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }

  .apgo-thumbnail-item.active .apgo-thumbnail-overlay {
    opacity: 1;
  }

  .apgo-thumbnail-play-icon {
    width: 20px;
    height: 20px;
    background: var(--primary-orange);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 0.7rem;
    opacity: 0.9;
  }

  /* 手機優化 */
  @media (max-width: 768px) {
    .apgo-product-thumbnails {
      padding: 16px 12px 24px;
    }

    .apgo-thumbnails-container {
      gap: 10px;
      padding: 8px 4px;
    }

    .apgo-thumbnail-item {
      width: 68px;
      height: 68px;
      border-radius: 14px;
    }

    .apgo-thumbnail-item.active {
      transform: scale(1.06);
    }
  }

  /* 產品基本資訊 */
  .apgo-product-info {
    padding: 24px 16px;
    background: var(--dark-bg);
  }

  .apgo-product-header {
    text-align: center;
    margin-bottom: 24px;
    padding-bottom: 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .apgo-product-name {
    font-size: 2rem;
    font-weight: bold;
    background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
  }

  .apgo-product-metafield-subtitle {
    margin: 0 auto 10px;
    max-width: 36rem;
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.45;
    color: var(--text-gray);
  }

  .apgo-product-metafield-subtitle + .apgo-product-tagline {
    margin-top: 0;
  }

  .apgo-product-tagline {
    font-size: 1rem;
    color: var(--text-light-gray);
    line-height: 1.5;
    margin-top: 12px;
  }

  /* 性能指標展示 */
  .apgo-performance-metrics {
    background: var(--card-bg);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 24px;
    border: 1px solid rgba(240, 132, 24, 0.2);
  }

  .apgo-metrics-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-white);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apgo-metrics-title::before {
    content: '';
    width: 4px;
    height: 20px;
    background: var(--primary-orange);
    border-radius: 2px;
  }

  .apgo-metric-item {
    margin-bottom: 16px;
  }

  .apgo-metric-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .apgo-metric-label {
    font-size: 0.85rem;
    color: var(--text-gray);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .apgo-metric-value {
    font-size: 0.95rem;
    font-weight: bold;
    background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .apgo-metric-bar {
    height: 8px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }

  .apgo-metric-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary-orange), var(--secondary-orange));
    border-radius: 8px;
    transition: width 1s ease;
    position: relative;
    overflow: hidden;
  }

  .apgo-metric-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
    animation: apgoShine 3s ease-in-out infinite;
  }

  @keyframes apgoShine {
    0% {
      left: -100%;
    }
    100% {
      left: 200%;
    }
  }

  /* PDP tabs (English labels) — video + RTE block below */
  .apgo-pdp-looping-lead {
    padding: 0 16px 12px;
    background: var(--dark-bg);
  }

  .apgo-pdp-tabs {
    padding: 0 16px 24px;
    background: var(--dark-bg);
  }

  .apgo-pdp-tabs-inner {
    max-width: none;
    margin-left: auto;
    margin-right: auto;
  }

  @media (min-width: 769px) {
    .apgo-pdp-tabs-inner {
      max-width: min(1200px, 66vw);
    }
  }

  /*
    Tab 列勿用 sticky：.apgo-product-section 為 overflow-x: hidden，許多環境會讓 sticky 與視窗對齊失準，
    且 sticky + 整條不透明底會疊在全站馬燈（free-shipping-popup）之上（見該區 z-index）。
    改為普通文流區塊，捲進頂區時馬燈層級高於區塊預設層級，馬燈不會再被一整條 Tab 底色蓋掉。
  */
  .apgo-pdp-tablist-wrap {
    position: static;
    top: auto;
    z-index: auto;
    background: transparent;
    border-bottom: 1px solid rgba(240, 132, 24, 0.22);
    margin: 0 0 12px;
    padding: 6px 0 0;
  }

  .apgo-pdp-tablist {
    display: flex;
    flex-wrap: nowrap;
    gap: 4px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .apgo-pdp-tab {
    flex: 0 0 auto;
    padding: 10px 12px;
    margin: 0;
    border: none;
    border-bottom: 2px solid transparent;
    border-radius: 8px 8px 0 0;
    background: transparent;
    color: var(--text-gray);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    white-space: nowrap;
  }

  @media (min-width: 769px) {
    .apgo-pdp-tab {
      font-size: 0.88rem;
      padding: 12px 16px;
    }
  }

  .apgo-pdp-tab[aria-selected="true"] {
    color: var(--primary-orange);
    border-bottom-color: var(--primary-orange);
  }

  .apgo-pdp-tab:focus-visible {
    outline: 2px solid var(--primary-orange);
    outline-offset: 2px;
  }

  .apgo-tab-panel {
    padding: 4px 0 8px;
  }

  .apgo-tab-panel[hidden] {
    display: none !important;
  }

  .apgo-tab-desc-layout {
    display: grid;
    gap: 14px;
    background: #0f0f0f;
    border: 1px solid rgba(240, 132, 24, 0.18);
    border-radius: 14px;
    padding: 12px;
    min-width: 0;
  }

  .apgo-tab-desc-layout.has-video {
    grid-template-columns: minmax(260px, 38%) minmax(0, 1fr);
    align-items: start;
  }

  .apgo-tab-desc-layout:not(.has-video) {
    grid-template-columns: minmax(0, 1fr);
  }

  .apgo-tab-desc-gallery {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 14px;
    width: 100%;
    min-width: 0;
  }

  .apgo-tab-desc-gallery img,
  .apgo-tab-desc-gallery video {
    width: 100%;
    height: auto;
    border-radius: 10px;
    display: block;
    background: #111;
    object-fit: contain;
  }

  /* Review 分頁：不要內層卡片，圖片貼齊 Tabs 區塊左右內邊界 */
  .apgo-tab-panel--review {
    margin-left: -16px;
    margin-right: -16px;
    width: calc(100% + 32px);
    max-width: none;
    box-sizing: border-box;
    padding: 0;
  }

  .apgo-pdp-review-media-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    min-width: 0;
    text-align: left;
  }

  .apgo-pdp-review-media-stack .apgo-customer-review-image {
    margin: 0;
    object-fit: contain;
    border-radius: 0;
    max-width: none !important;
    width: 100%;
    display: block;
  }

  .apgo-tab-panel--review .apgo-tab-empty {
    padding-inline: 16px;
    margin-block: 10px;
  }

  .apgo-tab-empty {
    color: var(--text-gray);
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

  .apgo-tab-pane-empty-slot {
    min-height: 56px;
    box-sizing: border-box;
  }

  .apgo-description-tab-gallery {
    margin-bottom: 0;
  }

  .apgo-tab-plain-body {
    color: var(--text-light-gray);
    font-size: 0.9rem;
    line-height: 1.65;
    word-break: break-word;
    min-width: 0;
  }

  .apgo-looping-video-wrap {
    border-radius: 12px;
    overflow: hidden;
    background: #111;
    min-height: 0;
  }

  .apgo-looping-video-wrap video {
    width: 100%;
    height: auto; /* Let video intrinsic ratio decide height */
    object-fit: contain; /* Avoid cropping */
    display: block;
  }

  .apgo-looping-video-wrap iframe {
    width: 100%;
    height: auto; /* Best-effort; if iframe has no intrinsic ratio, it may rely on embed */
    object-fit: contain;
    display: block;
  }

  .apgo-looping-desc-wrap {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0; /* flex/grid 子項預設 min-width:auto 會阻止換行 */
    min-height: 220px;
    padding: 4px 2px;
  }

  .apgo-pdp-tabs .apgo-looping-desc-wrap {
    min-height: 0;
    justify-content: flex-start;
  }

  /* Column lead-in title: same look as How to use / Variation block titles */
  .apgo-looping-desc-block-title--leadin {
    margin: 0 0 16px;
  }

  .apgo-looping-desc-content {
    color: var(--text-light-gray);
    font-size: 0.9rem;
    line-height: 1.6;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: break-word;
    word-wrap: break-word; /* 舊 WebKit */
  }

  .apgo-looping-desc-content p,
  .apgo-looping-desc-content li {
    margin: 0 0 8px;
    max-width: 100%;
    overflow-wrap: break-word;
  }

  .apgo-looping-desc-content ul,
  .apgo-looping-desc-content ol {
    padding-left: 18px;
    margin: 0 0 8px;
  }

  hr.apgo-looping-desc-divider {
    border: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.2);
    margin: 1rem 0;
  }

  .apgo-looping-desc-block-title {
    color: var(--primary-orange);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 10px;
  }

  [id^='apgo-tab-panel-how-'] .apgo-looping-desc-content .apgo-looping-desc-block-title:not(:first-child) {
    margin-top: 1.25rem;
  }

  /* Match in-RTE section headers (e.g. DESCRIPTION) to block titles */
  .apgo-looping-desc-block--description > h1:first-child,
  .apgo-looping-desc-block--description > h2:first-child,
  .apgo-looping-desc-block--description > h3:first-child,
  .apgo-looping-desc-block--description > h4:first-child,
  .apgo-looping-desc-block--description > h5:first-child,
  .apgo-looping-desc-block--description > h6:first-child {
    color: var(--primary-orange);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin: 0 0 10px;
  }

  .apgo-looping-desc-block-body {
    margin: 0;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .apgo-looping-desc-block--description {
    min-width: 0;
    max-width: 100%;
    overflow-wrap: break-word;
  }

  .apgo-insidebox {
    padding: 0 16px 24px;
    background: var(--dark-bg);
  }

  .apgo-insidebox-inner {
    background: #000000;
    border-radius: 14px;
    padding: 16px 16px 18px;
  }

  .apgo-insidebox-title {
    margin: 0;
    padding: 0;
    font-size: 2.9rem;
    font-weight: 400;
    line-height: 1;
    color: var(--primary-orange);
    text-align: center;
  }

  .apgo-insidebox-subline {
    margin: 4px 0 36px;
    text-align: center;
    font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif;
    font-size: 0.82rem;
    line-height: 1.4;
    color: #ffffff;
    font-weight: 400;
  }

  .apgo-insidebox-image {
    display: block;
    width: 100%;
    max-width: none !important;
    height: auto;
    margin: 0 auto;
  }

  /* 短影音展示區 */
  .apgo-video-showcase {
    padding: 24px 0;
    background: var(--dark-bg);
    margin-bottom: 24px;
  }

  .apgo-precautions {
    padding: 0 16px 24px;
    background: var(--dark-bg);
  }

  .apgo-precautions-inner {
    background: #0f0f0f;
    border: 1px solid rgba(240, 132, 24, 0.18);
    border-radius: 14px;
    padding: 14px 16px;
  }

.apgo-precautions-header {
    margin: 0 0 12px;
    padding: 0 2px;
  }

  .apgo-precautions-title-outside {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apgo-precautions-title-outside::before {
    content: '▶';
    color: var(--primary-orange);
    font-size: 0.9rem;
  }

  .apgo-precautions-content {
    color: var(--text-light-gray);
    font-size: 0.9rem;
    line-height: 1.7;
    word-break: break-word;
  }

  .apgo-construction-steps {
    padding: 0 16px 28px;
    background: var(--dark-bg);
  }

  .apgo-construction-steps-inner {
    background: #000000;
    border-radius: 14px;
    border: 1px solid var(--border-color);
    padding: 16px 18px 20px;
  }

  .apgo-construction-steps-header {
    margin: 0 0 14px;
  }

  .apgo-construction-steps-title {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apgo-construction-steps-title::before {
    content: '▶';
    color: var(--primary-orange);
    font-size: 0.9rem;
  }

  .apgo-step-card {
    border-radius: 12px;
    border: 1px solid rgba(240, 132, 24, 0.25);
    background: rgba(26, 26, 26, 0.8);
    padding: 14px 16px;
    margin-bottom: 12px;
  }

  .apgo-step-card:last-child {
    margin-bottom: 0;
  }

  .apgo-step-card-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-white);
    margin: 0 0 8px;
  }

  .apgo-step-card-body {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--text-light-gray);
    word-break: break-word;
  }

  .apgo-related-mf {
    padding: 0 16px 32px;
    background: var(--dark-bg);
  }

  .apgo-related-mf-inner {
    max-width: none;
    margin: 0 auto;
  }

  .apgo-related-mf-title {
    margin: 0 0 14px;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apgo-related-mf-title::before {
    content: '▶';
    color: var(--primary-orange);
    font-size: 0.9rem;
  }

  .apgo-related-mf-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .apgo-related-mf-card {
    display: block;
    text-decoration: none;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    background: #101010;
    color: inherit;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .apgo-related-mf-card:hover {
    border-color: rgba(240, 132, 24, 0.5);
  }

  .apgo-related-mf-media {
    aspect-ratio: 1;
    background: #1a1a1a;
  }

  .apgo-related-mf-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0 !important;
  }

  .apgo-related-mf-info {
    padding: 10px 12px 12px;
  }

  .apgo-related-mf-product-title {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-white);
    margin: 0 0 4px;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .apgo-related-mf-price {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--primary-orange);
    margin: 0;
  }

  @media (min-width: 769px) {
    .apgo-related-mf-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  .apgo-customer-review {
    padding: 0 16px 24px;
    background: var(--dark-bg);
  }

  .apgo-customer-review-inner {
    background: #000000;
    border: none;
    border-radius: 14px;
    padding: 14px 16px 18px;
    text-align: center;
    max-width: none;
    margin: 0 auto;
  }

  .apgo-customer-review-header {
    max-width: none;
    margin: 0 auto 12px;
    padding: 0 2px;
  }

  .apgo-customer-review-title-outside {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apgo-customer-review-title-outside::before {
    content: '▶';
    color: var(--primary-orange);
    font-size: 0.9rem;
  }

  .apgo-customer-review-image {
    display: block;
    width: 100%;
    max-width: none !important; /* override template-level global img max-width */
    height: auto;
    border-radius: 10px;
    margin: 0 auto;
  }

  .apgo-customer-review-mobile-only {
    display: none;
  }

  .apgo-customer-review-desktop-only {
    display: block;
  }

  @media (min-width: 769px) {
    .apgo-customer-review-mobile-only {
      display: none !important;
    }

    .apgo-customer-review-desktop-only {
      display: block;
    }

    .apgo-insidebox-inner {
      max-width: min(1200px, 66vw);
      margin-left: auto;
      margin-right: auto;
    }

    .apgo-video-header,
    .apgo-video-scroll-container,
    .apgo-precautions-header,
    .apgo-precautions-inner,
    .apgo-construction-steps-inner,
    .apgo-related-mf-inner,
    .apgo-customer-review-header,
    .apgo-customer-review-inner {
      max-width: min(1200px, 66vw);
      margin-left: auto;
      margin-right: auto;
    }

    .apgo-customer-review {
      padding: 0 8px 24px; /* desktop: near full width with small gutters */
    }

    .apgo-insidebox {
      padding: 0 8px 24px;
    }

    .apgo-customer-review-inner {
      padding: 14px 10px 16px;
    }
  }

  .apgo-video-header {
    padding: 0 16px;
    margin-bottom: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .apgo-video-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-white);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apgo-video-title::before {
    content: '▶';
    color: var(--primary-orange);
    font-size: 0.9rem;
  }

  /* 短影音滾動容器 */
  .apgo-video-scroll-container {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 0 16px 12px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .apgo-video-scroll-container::-webkit-scrollbar {
    display: none;
  }

  /* 短影音卡片 */
  .apgo-video-card {
    flex: 0 0 auto;
    width: 200px;
    height: 356px;
    background: var(--card-bg);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    scroll-snap-align: start;
    cursor: pointer;
    transition: all 0.3s ease;
    border: 1px solid rgba(240, 132, 24, 0.2);
  }

  .apgo-video-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #0a0a0a;
  }

  .apgo-video-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(0, 0, 0, 0.9) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 16px;
  }

  .apgo-video-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 50px;
    height: 50px;
    background: rgba(240, 132, 24, 0.9);
    backdrop-filter: blur(10px);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .apgo-video-play-btn::after {
    content: '';
    width: 0;
    height: 0;
    border-left: 15px solid white;
    border-top: 10px solid transparent;
    border-bottom: 10px solid transparent;
    margin-left: 3px;
  }

  .apgo-video-info {
    position: relative;
    z-index: 2;
  }

  .apgo-video-subtitle {
    font-size: 0.85rem;
    color: var(--text-white);
    font-weight: 600;
    margin-bottom: 4px;
  }

  .apgo-video-views {
    font-size: 0.75rem;
    color: var(--text-gray);
  }

  .apgo-video-duration {
    position: absolute;
    top: 12px;
    right: 12px;
    background: rgba(0, 0, 0, 0.8);
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.75rem;
    color: white;
  }

  /* 底部購買欄 */
  .apgo-bottom-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: calc(var(--vvb, 0px)); /* ← 用变量控制到底部的偏移 */
    width: 100%;
    box-sizing: border-box;

    background: rgba(0, 0, 0, 0.98);
    backdrop-filter: blur(20px);
    border-top: 1px solid rgba(240, 132, 24, 0.2);

    padding: 12px 16px;
    padding-bottom: max(12px, env(safe-area-inset-bottom)); /* ← 覆盖 Home 指示条安全区 */
    z-index: 1000;
    display: flex;
    gap: 12px;
    align-items: center;

    will-change: transform, bottom, padding-bottom; /* 减少抖动 */
    transform: translateZ(0);
  }

  @media (min-width: 769px) {
    .apgo-bottom-bar {
      width: min(1200px, 66vw);
      left: 50%;
      right: auto;
      transform: translateX(-50%) translateZ(0);
      border: 1px solid rgba(240, 132, 24, 0.2);
      border-bottom: none;
      border-radius: 12px 12px 0 0;
    }
  }

  /*
    固定底欄會蓋住捲到底時的 footer（付款方式等）。
    桌面側欄開啟時底欄隱藏（見 .apgo-pdp-variant-sidebar-open），不需預留。
    數值 ≈ 底欄上下 padding + 按鈕列高度；另加 safe-area 與 iOS 鍵盤時 --vvb 上移後仍留足夠可捲區。
  */
  body:has(.apgo-product-section):not(.apgo-pdp-variant-sidebar-open) footer.apgo-footer {
    padding-bottom: calc(104px + env(safe-area-inset-bottom, 0px));
  }

  .apgo-price-section {
    flex: 1;
  }

  .apgo-original-price {
    font-size: 0.8rem;
    color: var(--text-gray);
    text-decoration: line-through;
    margin-bottom: 2px;
  }

  .apgo-price-value {
    font-size: 1.5rem;
    font-weight: bold;
    color: var(--primary-orange);
  }

  .apgo-action-buttons {
    display: flex;
    gap: 8px;
    flex: 1.5;
  }

  .apgo-btn-favorite {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(240, 132, 24, 0.1);
    border: 1px solid var(--primary-orange);
    border-radius: 12px;
    color: var(--primary-orange);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .apgo-btn-favorite.active {
    background: var(--primary-orange);
    color: white;
  }

  .apgo-buy-button {
    flex: 1;
    background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));
    color: white;
    border: none;
    border-radius: 12px;
    padding: 16px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  /* 變體選擇：外層殼（桌面側欄用） */
  .apgo-pdp-variant-shell {
    position: fixed;
    inset: 0;
    z-index: 1998;
    pointer-events: none;
  }

  .apgo-pdp-variant-shell.active {
    pointer-events: auto;
  }

  /* 變體選擇模態框（手機：全寬底抽屜；高度上限約 85% 視窗，內層 flex:1 會撐滿該上限故常感覺「快滿版」） */
  .apgo-variant-modal {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--card-bg);
    border-radius: 24px 24px 0 0;
    padding: 0;
    transform: translateY(100%);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 2000;
    max-height: 85vh;
    max-height: min(85vh, 90dvh);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    -ms-overflow-style: none;
    scrollbar-width: none;
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.5);
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    overscroll-behavior-y: contain;
  }

  .apgo-variant-modal.active {
    transform: translateY(0);
  }

  .apgo-variant-modal-inner {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    max-height: 85vh;
    max-height: min(85vh, 90dvh);
    overscroll-behavior-y: contain;
  }

  .apgo-variant-modal-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0 16px;
    -webkit-overflow-scrolling: touch;
    touch-action: pan-y;
    overscroll-behavior-y: contain;
  }

  .apgo-variant-modal-footer {
    flex-shrink: 0;
    background: var(--card-bg);
    border-top: 1px solid rgba(240, 132, 24, 0.2);
    padding: 0 16px 16px;
    overscroll-behavior-y: contain;
  }

  .apgo-variant-modal-footer .apgo-modal-buttons {
    position: static;
    padding-top: 12px;
    padding-bottom: 0;
    margin: 0;
  }

  .apgo-modal-header {
    position: sticky;
    top: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--card-bg);
    margin-bottom: 16px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(240, 132, 24, 0.2);
    opacity: 1;
    z-index: 1;
  }

  .apgo-modal-title {
    font-size: 1.3rem;
    font-weight: 600;
    background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .apgo-close-modal {
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    color: var(--text-gray);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.3rem;
  }

  /* 產品預覽區 */
  .apgo-modal-product-preview {
    display: flex;
    gap: 16px;
    margin-bottom: 24px;
    padding: 16px;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 12px;
  }

  .apgo-modal-product-image {
    width: 80px;
    height: 80px;
    object-fit: contain;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.3));
    background: rgba(255, 255, 255, 0.02);
    border-radius: 8px;
    padding: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .apgo-modal-product-image:hover {
    transform: scale(1.05);
  }

  .apgo-modal-product-info {
    flex: 1;
  }

  .apgo-modal-product-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-white);
    margin-bottom: 4px;
  }

  .apgo-modal-product-desc {
    font-size: 0.85rem;
    color: var(--text-gray);
    line-height: 1.4;
  }

  /* 手機／窄螢幕：預覽改為圖在上、文案在下 */
  @media (max-width: 1023px) {
    .apgo-pdp-variant-shell .apgo-modal-product-preview {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 12px;
    }

    .apgo-pdp-variant-shell .apgo-modal-product-image {
      width: 100%;
      max-width: min(280px, 78vw);
      height: auto;
      aspect-ratio: 1;
      object-fit: contain;
    }

    .apgo-pdp-variant-shell .apgo-modal-product-info {
      flex: none;
      width: 100%;
      align-self: stretch;
    }
  }

  /*
    手機端 (≤749px)：把變體選擇模態框拉到滿版，
    讓使用者進來就能一頁看完所有資訊，不需要捲動，
    也不在頂部留任何空白。同時縮小圖片、變體卡片字體與 padding。
  */
  @media (max-width: 749px) {
    .apgo-variant-modal {
      top: 0;
      bottom: 0;
      max-height: 100dvh;
      height: 100dvh;
      border-radius: 0;
      transform: translateY(100%);
    }

    .apgo-variant-modal.active {
      transform: translateY(0);
    }

    .apgo-variant-modal-inner {
      max-height: 100dvh;
      height: 100dvh;
    }

    /*
      Scroll 區轉為 flex column，預覽區用 flex-grow 吃掉下方多餘空間 →
      圖片自動變大；超過上限就停下，避免畸形撐大。
      其他子元素 flex-shrink:0，避免變體卡片被壓縮。
    */
    .apgo-variant-modal-scroll {
      display: flex;
      flex-direction: column;
    }

    .apgo-modal-header,
    .apgo-variant-section,
    .apgo-quantity-selector,
    .apgo-modal-total-line {
      flex-shrink: 0;
    }

    .apgo-modal-header {
      padding-top: max(8px, env(safe-area-inset-top, 0));
      margin-bottom: 10px;
    }

    .apgo-modal-title {
      font-size: 1.1rem;
    }

    /* 預覽區：彈性放大、有最大上限，避免空位浪費同時不過頭 */
    .apgo-pdp-variant-shell .apgo-modal-product-preview {
      flex: 1 1 auto;
      gap: 8px;
      padding: 10px;
      margin-bottom: 14px;
      justify-content: center;
      /* 最低保留 ≈ 圖 140 + 名稱描述兩行；最高不超過視窗一半 */
      min-height: 200px;
      max-height: min(50dvh, 360px);
    }

    .apgo-pdp-variant-shell .apgo-modal-product-image {
      /* height 100% 讓圖片吃掉預覽區的可用高度，配合 aspect-ratio:1 維持正方形 */
      width: auto;
      max-width: min(280px, 70vw);
      height: 100%;
      max-height: min(280px, 40dvh);
      aspect-ratio: 1;
      object-fit: contain;
      flex: 0 1 auto;
    }

    .apgo-modal-product-name {
      font-size: 0.95rem;
      margin-bottom: 2px;
    }

    .apgo-modal-product-desc {
      font-size: 0.78rem;
      line-height: 1.35;
    }

    /* 變體卡片：縮小 padding 與字體 */
    .apgo-variant-section {
      margin-bottom: 14px;
    }

    .apgo-variant-label {
      font-size: 0.78rem;
      margin-bottom: 8px;
    }

    .apgo-variant-options {
      gap: 8px;
    }

    .apgo-variant-option {
      padding: 12px 12px 30px 12px;
      border-radius: 10px;
    }

    .apgo-variant-name {
      font-size: 0.85rem;
      margin-bottom: 2px;
      line-height: 1.25;
    }

    .apgo-variant-price {
      font-size: 0.92rem;
      bottom: 6px;
      left: 12px;
    }

    .apgo-variant-quantity {
      font-size: 0.7rem;
      bottom: 6px;
      right: 8px;
    }

    .apgo-variant-option.selected::after {
      width: 16px;
      height: 16px;
      font-size: 0.7rem;
      top: 6px;
      right: 6px;
    }

    /* 數量區更緊湊 */
    .apgo-quantity-selector {
      margin-bottom: 14px;
    }

    .apgo-quantity-label {
      font-size: 0.8rem;
      margin-bottom: 8px;
    }

    .apgo-quantity-controls {
      gap: 12px;
      padding: 6px;
    }

    .apgo-quantity-btn {
      width: 32px;
      height: 32px;
      font-size: 1.05rem;
    }

    .apgo-quantity-value {
      font-size: 1.05rem;
      min-width: 32px;
    }

    .apgo-modal-total-line {
      font-size: 0.88rem;
      margin-bottom: 12px;
    }

    .apgo-modal-total-line .apgo-modal-total-amount {
      font-size: 1.1rem;
    }

    .apgo-modal-btn {
      padding: 12px;
      font-size: 0.95rem;
    }
  }

  /* 變體選擇區 */
  .apgo-variant-section {
    margin-bottom: 24px;
  }

  .apgo-variant-label {
    font-size: 0.9rem;
    color: var(--text-gray);
    margin-bottom: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .apgo-variant-options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .apgo-variant-option {
    background: rgba(255, 255, 255, 0.03);
    border: 2px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 22px 22px 40px 22px;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
  }

  .apgo-variant-option.disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .apgo-variant-option.disabled:hover {
    border-color: rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
  }

  .apgo-variant-quantity {
    position: absolute;
    bottom: 8px;
    right: 12px;
    font-size: 0.8rem;
    color: var(--text-gray);
    background: rgba(0,0,0,0.3);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .apgo-variant-option.selected {
    border-color: var(--primary-orange);
    background: rgba(240, 132, 24, 0.1);
  }

  .apgo-variant-option.selected::after {
    content: '✓';
    position: absolute;
    top: 8px;
    right: 8px;
    width: 20px;
    height: 20px;
    background: var(--primary-orange);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    font-weight: bold;
  }

  .apgo-variant-name {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-white);
    margin-bottom: 4px;
  }

  .apgo-variant-price {
    font-size: 1.1rem;
    color: var(--primary-orange);
    font-weight: bold;
    position: absolute;
    bottom: 8px;
    left: 22px;
  }

  /* 數量選擇器 */
  .apgo-quantity-selector {
    margin-bottom: 24px;
  }

  .apgo-quantity-label {
    font-size: 0.9rem;
    color: var(--text-gray);
    margin-bottom: 12px;
  }

  .apgo-quantity-controls {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 8px;
    width: fit-content;
  }

  .apgo-quantity-btn {
    width: 36px;
    height: 36px;
    border: none;
    background: rgba(240, 132, 24, 0.2);
    color: var(--primary-orange);
    border-radius: 8px;
    font-size: 1.2rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .apgo-quantity-value {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-white);
    min-width: 40px;
    text-align: center;
  }

  /* 變體彈窗：單行合計（取代原 Subtotal/Total 卡片） */
  .apgo-modal-total-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 20px;
    padding: 0 2px;
    font-size: 0.95rem;
    color: var(--text-light-gray);
  }

  .apgo-modal-total-line .apgo-modal-total-amount {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--primary-orange);
    white-space: nowrap;
  }

  /* 模態框按鈕（底部區由 .apgo-variant-modal-footer 承載） */
  .apgo-modal-buttons {
    display: flex;
    gap: 12px;
    background: var(--card-bg);
  }

  .apgo-modal-btn {
    flex: 1;
    padding: 16px;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    border: none;
  }

  .apgo-modal-btn-secondary {
    background: rgba(240, 132, 24, 0.1);
    border: 2px solid var(--primary-orange);
    color: var(--primary-orange);
  }

  .apgo-modal-btn-primary {
    background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));
    color: white;
  }

  .apgo-modal-btn:disabled {
    background: #333333 !important;
    color: #888888 !important;
    border-color: #333333 !important;
    cursor: not-allowed !important;
    background-image: none !important;
  }

  .apgo-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 1999;
  }

  .apgo-modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  /* 桌面：變體右側欄；開啟時主欄左對齊；用數值 margin + transition 做 0.4s 置中→靠左（margin:auto 無法插值） */
  @media (min-width: 1024px) {
    :root {
      --apgo-pdp-motion-duration: 0.4s;
      --apgo-pdp-motion-easing: cubic-bezier(0.37, 0, 0.63, 1);
      --apgo-pdp-pane-max: min(1200px, 66vw);
    }

    /*
      側欄關閉：與 margin:auto + max-width:var(--apgo-pdp-pane-max) 等效的左右留白，
      開啟時改為 margin-left:0（或主圖 16px）+ margin-right:auto，才能與 max-width 同步過渡。
    */
    /* 縮圖／基本資訊：關閉側欄維持全寬，僅過渡 max-width（開啟時變窄靠左） */
    .apgo-product-section .apgo-product-thumbnails,
    .apgo-product-section .apgo-product-info {
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
      transition: max-width var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing);
    }

    .apgo-product-section .apgo-pdp-tabs-inner,
    .apgo-product-section .apgo-insidebox-inner,
    .apgo-product-section .apgo-video-header,
    .apgo-product-section .apgo-video-scroll-container,
    .apgo-product-section .apgo-precautions-header,
    .apgo-product-section .apgo-precautions-inner,
    .apgo-product-section .apgo-construction-steps-inner,
    .apgo-product-section .apgo-related-mf-inner,
    .apgo-product-section .apgo-customer-review-header,
    .apgo-product-section .apgo-customer-review-inner {
      max-width: var(--apgo-pdp-pane-max);
      margin-left: max(0px, calc((100% - min(100%, var(--apgo-pdp-pane-max))) / 2));
      margin-right: max(0px, calc((100% - min(100%, var(--apgo-pdp-pane-max))) / 2));
      transition:
        max-width var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        margin-left var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        margin-right var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing);
    }

    /* 主圖：關閉側欄維持全寬；開啟時 max-width 與 margin 可與 0.4s 同步（100% → 計算寬、0 → 16px） */
    .apgo-product-section .apgo-hero-visual {
      max-width: 100%;
      margin-left: 0;
      margin-right: 0;
      transition:
        max-width var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        margin-left var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        margin-right var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing);
    }

    /*
      Suggested products（cart-upsell）與 APGO footer：與主欄同一套置中／靠左 + 0.4s。
      僅在頁面含 .apgo-product-section 時作用（:has），避免影響其他頁。
    */
    body:has(.apgo-product-section) .cart-upsell-wrapper.cart-upsell-wrapper--product,
    body:has(.apgo-product-section) footer.apgo-footer .apgo-footer-container {
      transition:
        max-width var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        margin-left var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        margin-right var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing);
    }

    body:not(.apgo-pdp-variant-sidebar-open):has(.apgo-product-section)
      .cart-upsell-wrapper.cart-upsell-wrapper--product {
      max-width: var(--apgo-pdp-pane-max);
      margin-top: 20px;
      margin-bottom: 0;
      margin-left: max(0px, calc((100% - min(100%, var(--apgo-pdp-pane-max))) / 2));
      margin-right: max(0px, calc((100% - min(100%, var(--apgo-pdp-pane-max))) / 2));
    }

    body:not(.apgo-pdp-variant-sidebar-open):has(.apgo-product-section) footer.apgo-footer .apgo-footer-container {
      max-width: var(--apgo-pdp-pane-max);
      margin-left: max(0px, calc((100% - min(100%, var(--apgo-pdp-pane-max))) / 2));
      margin-right: max(0px, calc((100% - min(100%, var(--apgo-pdp-pane-max))) / 2));
    }

    /* 底欄：側欄關閉時只過渡 left/right；開啟側欄時隱藏底欄（側欄內已有購買按鈕） */
    .apgo-product-section > .apgo-bottom-bar {
      transition:
        left var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        right var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        opacity var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        visibility var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing);
    }

    /* 主圖外層無 section 水平 padding，左緣留 16px；其餘區塊本身或外層已有 padding，margin-left 用 0 以免重複內縮 */
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-hero-visual {
      max-width: min(1200px, calc(100vw - var(--apgo-pdp-sidebar-width, 33.33vw) - 32px));
      margin-left: 16px;
      margin-right: auto;
    }

    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-product-thumbnails,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-product-info,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-pdp-tabs-inner,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-insidebox-inner,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-video-header,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-video-scroll-container,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-precautions-header,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-precautions-inner,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-construction-steps-inner,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-related-mf-inner,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-customer-review-header,
    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-customer-review-inner {
      max-width: min(1200px, calc(100vw - var(--apgo-pdp-sidebar-width, 33.33vw) - 32px));
      margin-left: 0;
      margin-right: auto;
    }

    body.apgo-pdp-variant-sidebar-open .cart-upsell-wrapper.cart-upsell-wrapper--product {
      max-width: min(1200px, calc(100vw - var(--apgo-pdp-sidebar-width, 33.33vw) - 32px));
      margin-top: 20px;
      margin-left: 0;
      margin-right: auto;
    }

    body.apgo-pdp-variant-sidebar-open footer.apgo-footer .apgo-footer-container {
      max-width: min(1200px, calc(100vw - var(--apgo-pdp-sidebar-width, 33.33vw) - 32px));
      margin-left: 0;
      margin-right: auto;
    }

    body.apgo-pdp-variant-sidebar-open .apgo-product-section .apgo-thumbnails-container {
      justify-content: flex-start;
    }

    body.apgo-pdp-variant-sidebar-open .apgo-product-section > .apgo-bottom-bar {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
    }

    /*
      遮罩與側欄：選擇器不依賴 .apgo-pdp-variant-shell.active，關閉動畫結束後 shell 會先失去 active，
      若仍只靠 shell.active，modal 會掉回手機用的 translateY(100%) 造成「收完又閃到下面」。
    */
    .apgo-pdp-variant-shell .apgo-modal-overlay {
      position: absolute;
      inset: 0;
      right: var(--apgo-pdp-sidebar-width, 33.33vw);
      width: auto;
      background: rgba(0, 0, 0, 0.22);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      opacity: 0;
      visibility: hidden;
      transition:
        opacity var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        visibility var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing);
    }

    .apgo-pdp-variant-shell .apgo-modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .apgo-pdp-variant-shell .apgo-variant-modal {
      top: 0;
      right: 0;
      bottom: 0;
      left: auto;
      width: var(--apgo-pdp-sidebar-width, 33.33vw);
      max-height: none;
      height: 100vh;
      height: 100dvh;
      border-radius: 0;
      box-shadow: -12px 0 40px rgba(0, 0, 0, 0.45);
      transform: translateX(105%);
      transition:
        transform var(--apgo-pdp-motion-duration) var(--apgo-pdp-motion-easing),
        opacity 0.3s ease;
    }

    .apgo-pdp-variant-shell .apgo-variant-modal.active {
      transform: translateX(0);
    }

    .apgo-pdp-variant-shell .apgo-variant-modal-inner {
      max-height: none;
      height: 100%;
    }

    .apgo-pdp-variant-shell .apgo-modal-product-preview {
      flex-direction: column;
      align-items: stretch;
      text-align: left;
    }

    .apgo-pdp-variant-shell .apgo-modal-product-image {
      width: 100%;
      max-width: 200px;
      height: auto;
      margin: 0 auto;
    }

    .apgo-pdp-variant-shell .apgo-variant-options {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
    .apgo-pdp-variant-shell .apgo-variant-modal {
      transition: none;
    }

    .apgo-product-section .apgo-hero-visual,
    .apgo-product-section .apgo-product-thumbnails,
    .apgo-product-section .apgo-product-info,
    .apgo-product-section .apgo-pdp-tabs-inner,
    .apgo-product-section .apgo-insidebox-inner,
    .apgo-product-section .apgo-video-header,
    .apgo-product-section .apgo-video-scroll-container,
    .apgo-product-section .apgo-precautions-header,
    .apgo-product-section .apgo-precautions-inner,
    .apgo-product-section .apgo-construction-steps-inner,
    .apgo-product-section .apgo-related-mf-inner,
    .apgo-product-section .apgo-customer-review-header,
    .apgo-product-section .apgo-customer-review-inner,
    body:has(.apgo-product-section) .cart-upsell-wrapper.cart-upsell-wrapper--product,
    body:has(.apgo-product-section) footer.apgo-footer .apgo-footer-container,
    .apgo-product-section > .apgo-bottom-bar {
      transition: none;
    }
  }

  /* 圖片預覽燈箱 */
  .apgo-image-lightbox {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.95);
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .apgo-image-lightbox.active {
    display: flex;
  }

  .apgo-lightbox-content {
    position: relative;
    max-width: 90%;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .apgo-lightbox-image {
    width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    border-radius: 12px;
  }

  .apgo-lightbox-close {
    position: absolute;
    top: -40px;
    right: 0;
    width: 36px;
    height: 36px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.2rem;
  }

  /* 全螢幕影片播放器 */
  .apgo-video-fullscreen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: black;
    z-index: 3000;
    display: none;
    align-items: center;
    justify-content: center;
  }

  .apgo-video-fullscreen.active {
    display: flex;
  }

  .apgo-fullscreen-video {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .apgo-close-fullscreen {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    border-radius: 50%;
    color: white;
    font-size: 1.5rem;
    cursor: pointer;
    z-index: 3001;
  }

  /* 載入動畫 */
  .apgo-loading-spinner {
    display: inline-block;
    width: 20px;
    height: 20px;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: apgoSpin 1s linear infinite;
  }

  @keyframes apgoSpin {
    to {
      transform: rotate(360deg);
    }
  }

  /* 滑動指示器 */
  .apgo-swipe-indicator {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    pointer-events: none;
  }

  .apgo-swipe-dots {
    display: flex;
    gap: 6px;
    padding: 8px 12px;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 20px;
    backdrop-filter: blur(10px);
  }

  .apgo-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    transition: all 0.3s ease;
  }

  .apgo-dot.active {
    width: 16px;
    border-radius: 3px;
    background: var(--primary-orange);
  }

  /* 視頻模態框 */
  .apgo-video-modal {
    position: fixed;
    inset: 0;
    z-index: 3000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .apgo-video-modal.active {
    opacity: 1;
    visibility: visible;
  }

  .apgo-video-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(10px);
  }

  .apgo-video-modal-content {
    position: relative;
    z-index: 1;
    width: 90%;
    max-width: 900px;
    max-height: 80vh;
    animation: apgoModalSlideIn 0.3s ease;
  }

  @keyframes apgoModalSlideIn {
    from {
      transform: translateY(30px) scale(0.95);
      opacity: 0;
    }
    to {
      transform: translateY(0) scale(1);
      opacity: 1;
    }
  }

  .apgo-video-modal-close {
    position: absolute;
    top: -40px;
    right: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 2;
  }

  .apgo-video-modal-close:hover {
    background: rgba(240, 132, 24, 0.3);
    border-color: var(--primary-orange);
    transform: rotate(90deg);
  }

  .apgo-video-modal-player {
    width: 100%;
    background: #000;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .apgo-video-modal-player video {
    width: 100%;
    height: auto;
    max-height: 70vh;
    display: block;
  }

  .apgo-video-hidden {
    display: none !important;
  }

  .apgo-video-card.loading::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 40px;
    height: 40px;
    margin: -20px 0 0 -20px;
    border: 3px solid rgba(240, 132, 24, 0.3);
    border-top-color: var(--primary-orange);
    border-radius: 50%;
    animation: apgoSpin 1s linear infinite;
    z-index: 10;
  }

  /* iOS Safari 模態框開啟時的 body 樣式 */
  body.modal-open {
    overflow: hidden;
    position: fixed;
    width: 100%;
  }

  /* 成功通知樣式 */
  .add-on-notification {
    position: fixed;
    left: 75%;
    top: 10%;
    transform: translate(-50%, calc(-50% + 10px)) scale(0.98);
    opacity: 0;
    width: min(92vw, 460px);
    max-width: 92vw;
    padding: 18px 20px 18px 20px;
    border-radius: 12px;
    background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
    border: 1px solid rgba(240, 132, 24, 0.35);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55), 0 6px 20px rgba(0, 0, 0, 0.35);
    z-index: 99999;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .add-on-notification.show {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }

  .add-on-notification-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .add-on-notification-message {
    color: var(--text-white, #fff);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
    text-align: center;
  }

  .add-on-notification-link {
    background: linear-gradient(45deg, var(--primary-orange, #f08418), var(--secondary-orange, #ff9a3c));
    color: var(--text-white, #fff);
    text-decoration: none;
    padding: 10px 16px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
    transition: all 0.25s ease;
    display: inline-block;
    margin: 4px auto 0;
    min-width: 160px;
  }

  .add-on-notification-link:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(240, 132, 24, 0.35);
  }

  .add-on-notification-close {
    background: transparent;
    border: none;
    color: #fff;
    font-size: 1.2rem;
    cursor: pointer;
    padding: 0;
    opacity: 0.8;
    transition: opacity 0.25s ease;
    width: 24px;
    height: 24px;
    position: absolute;
    right: 10px;
    top: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .add-on-notification-close:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .apgo-main-container {
      padding-bottom: 84px;
    }

    .apgo-pdp-looping-lead {
      padding: 0 12px 10px;
    }

    .apgo-pdp-tabs {
      padding: 0 12px 20px;
    }

    .apgo-tab-panel--review {
      margin-left: -12px;
      margin-right: -12px;
      width: calc(100% + 24px);
    }

    .apgo-tab-panel--review .apgo-tab-empty {
      padding-inline: 12px;
    }

    .apgo-tab-desc-layout.has-video {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .apgo-looping-video-wrap,
    .apgo-looping-video-wrap video,
    .apgo-looping-video-wrap iframe,
    .apgo-looping-desc-wrap {
      min-height: 0;
    }

    .apgo-looping-desc-content {
      font-size: 0.85rem;
      line-height: 1.55;
    }

    .apgo-precautions {
      padding: 0 12px 20px;
    }

    .apgo-precautions-inner {
      padding: 12px 12px 14px;
    }

    .apgo-precautions-header {
      margin-bottom: 10px;
    }

    .apgo-precautions-title-outside {
      font-size: 1.05rem;
    }

    .apgo-customer-review {
      padding: 0;
    }

    .apgo-insidebox {
      padding: 0 0 20px;
    }

    .apgo-insidebox-inner {
      padding: 12px 12px 14px;
    }

    .apgo-insidebox-title {
      font-size: 1.45rem;
      line-height: 1;
    }

    .apgo-customer-review-inner {
      padding: 12px 12px 6px;
    }

    .apgo-customer-review-desktop-only {
      display: none;
    }

    .apgo-customer-review-mobile-only {
      display: block;
      width: 100vw;
      max-width: 100vw;
      margin-left: calc(50% - 50vw);
      margin-right: 0;
      overflow: visible;
    }

    .apgo-customer-review-mobile-only .apgo-customer-review-image {
      width: 100%;
      max-width: none !important;
      min-width: 0;
      height: auto;
      margin: 0;
      border-radius: 0;
      object-fit: contain;
    }

    .apgo-customer-review-header {
      margin-bottom: 10px;
    }

    .apgo-video-modal-content {
      width: 100%;
      height: 100%;
      max-width: 100%;
      max-height: 100%;
    }

    .apgo-video-modal-player {
      height: 100%;
      display: flex;
      align-items: center;
      border-radius: 0;
    }

    .apgo-video-modal-player video {
      max-height: 100vh;
    }

    .apgo-video-modal-close {
      top: 20px;
      right: 20px;
      background: rgba(0, 0, 0, 0.7);
    }

    .add-on-notification {
      top: 70px;
      right: 45%;
      left: 55%;
      max-width: calc(100vw - 30px);
      padding: 14px 16px;
      gap: 10px;
    }

    .add-on-notification-message {
      font-size: 0.85rem;
    }

    .add-on-notification-link {
      padding: 10px 16px;
      font-size: 0.82rem;
      justify-content: center;
    }

    .add-on-notification-close {
      width: 22px;
      height: 22px;
      font-size: 1rem;
    }

    .add-on-notification {
      width: min(94vw, 420px);
      padding: 16px 16px 18px;
    }

    .add-on-notification-message {
      font-size: 0.92rem;
    }

    .add-on-notification-link {
      min-width: 140px;
      font-size: 0.88rem;
    }
    .apgo-price-value {
      font-size: 1.3rem;
      font-weight: bold;
      color: var(--primary-orange);
    }
  }
  /* 輪播容器樣式 */
  .apgo-product-showcase {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    overflow: hidden; /* 添加這行 */
  }

  /* 輪播圖片容器 */
  .apgo-carousel-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .apgo-carousel-track {
    display: flex;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
    height: 100%;
    align-items: center;
  }

  .apgo-carousel-slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .apgo-product-showcase,
.apgo-carousel-container,
.apgo-carousel-track {
  touch-action: pan-y;     /* 现代浏览器 */
  -ms-touch-action: pan-y; /* 旧 Edge */
}

  /* 桌面：放大主視覺輪播（須放在檔末，避免被後面重複的 .apgo-product-showcase padding 蓋掉；手機維持 400px） */
  @media (min-width: 769px) {
    .apgo-hero-visual {
      height: min(56vh, 620px);
    }

    .apgo-product-showcase {
      padding: 24px 16px;
    }
  }
</style>

<div class="apgo-product-section" data-apgo-currency="{{ cart.currency.iso_code }}">
  <!-- 頂部導航 -->

  <!-- 主內容區 -->
  <main class="apgo-main-container">
    <!-- 產品主視覺區 -->
    <section class="apgo-hero-visual">
      {% if section.settings.show_particles %}
        <div class="apgo-floating-particles">
          <div class="apgo-particle" style="left: 10%; animation-delay: 0s;"></div>
          <div class="apgo-particle" style="left: 30%; animation-delay: 2s;"></div>
          <div class="apgo-particle" style="left: 50%; animation-delay: 4s;"></div>
          <div class="apgo-particle" style="left: 70%; animation-delay: 6s;"></div>
          <div class="apgo-particle" style="left: 90%; animation-delay: 8s;"></div>
        </div>
      {% endif %}

      <div class="apgo-product-showcase" id="apgoProductShowcase">
        <div class="apgo-carousel-container">
          <div class="apgo-carousel-track" id="apgoCarouselTrack">
            {% for image in product.images %}
              <div class="apgo-carousel-slide">
                <img
                  src="{{ image | image_url: width: 800 }}"
                  alt="{{ product.title }} - {{ 'product.image_alt' | t: index: forloop.index }}"
                  class="apgo-product-image-main is-cover"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                >
              </div>
            {% endfor %}
          </div>
        </div>

        <!-- 輪播指示點 -->
        <div class="apgo-swipe-indicator">
          <div class="apgo-swipe-dots">
            {% for image in product.images %}
              <span
                class="apgo-dot {% if forloop.first %}active{% endif %}"
                data-index="{{ forloop.index0 }}"
                onclick="apgoGoToSlide({{ forloop.index0 }})"
              ></span>
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="apgo-product-badges">
        {% if product.metafields.apgo.badges %}
          {% for badge_text in product.metafields.apgo.badges.value %}
            <span class="apgo-badge">{{ badge_text }}</span>
          {% endfor %}
        {% else %}
          {% for block in section.blocks %}
            {% if block.type == 'badge' %}
              <span class="apgo-badge">{{ block.settings.text }}</span>
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
    </section>

    <!-- 產品縮圖展示區 -->
    <section class="apgo-product-thumbnails">
      <div class="apgo-thumbnails-container">
        {% for image in product.images %}
          <div
            class="apgo-thumbnail-item {% if forloop.first %}active{% endif %}"
            onclick="apgoSelectThumbnail(this, '{{ image | image_url: width: 1200 }}')"
            data-index="{{ forloop.index0 }}"
          >
            <img
              src="{{ image | image_url: width: 150 }}"
              alt="{{ product.title }} - {{ 'product.image_alt' | t: index: forloop.index }}"
              class="apgo-thumbnail-image"
              loading="lazy"
            >
          </div>
        {% endfor %}
      </div>
    </section>

    <!-- 產品基本資訊 -->
    <section class="apgo-product-info">
      {% liquid
        assign product_custom_subtitle = product.metafields.custom.product_subtitle.value | default: product.metafields.custom.product_subtitle
      %}
      <div class="apgo-product-header">
        <h1 class="apgo-product-name">{{ product.title }}</h1>
        {% if product_custom_subtitle != blank %}
          <p class="apgo-product-metafield-subtitle">{{ product_custom_subtitle | escape }}</p>
        {% endif %}
        <p class="apgo-product-tagline">
          {{ product.metafields.apgo.subtitle | default: section.settings.subtitle_fallback }}
        </p>
      </div>

      {% if product.metafields.apgo.performance_metrics.value %}
        <div class="apgo-performance-metrics">
          <h3 class="apgo-metrics-title">{{ 'product.performance_metrics' | t }}</h3>

          {% if product.metafields.apgo.performance_metrics %}
            {% assign metrics = product.metafields.apgo.performance_metrics.value %}
            {% for metric in metrics %}
              <div class="apgo-metric-item">
                <div class="apgo-metric-header">
                  <span class="apgo-metric-label">{{ metric.label }}</span>
                  <span class="apgo-metric-value">{{ metric.value }}</span>
                </div>
                <div class="apgo-metric-bar">
                  <div class="apgo-metric-fill" style="width: {{ metric.percent }}%;"></div>
                </div>
              </div>
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}
              {% if block.type == 'metric' %}
                <div class="apgo-metric-item">
                  <div class="apgo-metric-header">
                    <span class="apgo-metric-label">{{ block.settings.label }}</span>
                    <span class="apgo-metric-value">{{ block.settings.value }}</span>
                  </div>
                  <div class="apgo-metric-bar">
                    <div class="apgo-metric-fill" style="width: {{ block.settings.percent }}%;"></div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      {% endif %}
    </section>

    {% liquid
      assign tab_desc_media = product.metafields.custom.tab_description_images.value

      assign looping_video_obj = product.metafields.custom.looping_video.value
      assign looping_video_media = blank

      if looping_video_obj != blank
        if looping_video_obj.media_type == 'video' or looping_video_obj.sources != blank
          assign looping_video_media = looping_video_obj
        elsif looping_video_obj.video != blank
          assign looping_video_media = looping_video_obj.video.value | default: looping_video_obj.video
        elsif looping_video_obj.video_file != blank
          assign looping_video_media = looping_video_obj.video_file.value | default: looping_video_obj.video_file
        endif
      endif

      assign has_looping_video = false
      if looping_video_media != blank
        assign has_looping_video = true
      endif
      assign looping_description_value = product.metafields.custom.looping_description

      assign how_to_use_raw = product.metafields.custom.how_to_use.value | default: '' | strip
      assign variation_raw = product.metafields.custom.variation.value | default: '' | strip

      assign desc_has = false
      if product.description != blank
        assign desc_has = true
      endif

      assign loop_desc_has = false
      if looping_description_value != blank
        assign loop_desc_has = true
      endif

      assign gallery_has = false
      if tab_desc_media != blank
        assign gallery_has = true
      endif

      assign description_tab_pic_list = product.metafields.custom.description_pic.value
      assign description_tab_pics_has = false
      if description_tab_pic_list != blank and description_tab_pic_list.size != 0
        assign description_tab_pics_has = true
      endif

      assign sf = section.settings.subtitle_fallback | strip

      assign how_has = false
      if how_to_use_raw != blank
        assign how_has = true
      endif

      assign insidebox_image = product.metafields.custom.insidebox.value | default: product.metafields.custom.insidebox
      assign precautions_text = product.metafields.custom.precautions.value | default: product.metafields.custom.precautions
      assign precautions_has = false
      if precautions_text != blank
        assign precautions_has = true
      endif

      assign how_tab_has_any = false
      if how_has or precautions_has
        assign how_tab_has_any = true
      endif

      assign var_has = false
      if variation_raw != blank
        assign var_has = true
      endif

      assign customer_review_image = product.metafields.custom.customer_review.value | default: product.metafields.custom.customer_review
      assign mobile_review_list = product.metafields.custom.customer_review_mobile.value

      assign review_has_any = false
      if customer_review_image != blank
        assign review_has_any = true
      endif
      if mobile_review_list != blank
        assign review_has_any = true
      endif

      assign lead_has_text = false
      if desc_has or loop_desc_has or sf != blank
        assign lead_has_text = true
      endif
      assign lead_has_visual = false
      if lead_has_text or gallery_has or has_looping_video
        assign lead_has_visual = true
      endif
    %}
    <section class="apgo-pdp-looping-lead" aria-label="Description — video and details">
      <div class="apgo-pdp-tabs-inner">
        <div class="apgo-tab-desc-layout {% if has_looping_video %}has-video{% endif %}">
          {% if has_looping_video %}
            <div class="apgo-looping-video-wrap">
              {{
                looping_video_media
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true
              }}
            </div>
          {% endif %}

          <div class="apgo-looping-desc-wrap">
            <h4 class="apgo-looping-desc-block-title apgo-looping-desc-block-title--leadin">Description</h4>

            {% if gallery_has %}
              <div class="apgo-tab-desc-gallery">
                {% for mf in tab_desc_media %}
                  {% assign mf_mt = mf.media_type | default: '' | downcase %}
                  {% if mf_mt contains 'video' %}
                    {{
                      mf
                      | video_tag:
                        controls: true,
                        muted: false,
                        playsinline: true,
                        preload: 'metadata'
                    }}
                  {% else %}
                    <img
                      src="{{ mf | image_url: width: 1200 }}"
                      alt="{{ product.title | escape }} — {{ forloop.index }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      width="1200"
                      height="1200"
                    >
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            {% unless lead_has_visual or var_has %}
              <p class="apgo-tab-empty">No description available.</p>
            {% endunless %}
            {% if lead_has_text %}
              <div class="apgo-looping-desc-content">
                {% if desc_has %}
                  <div class="apgo-looping-desc-block apgo-looping-desc-block--description">
                    {{ product.description }}
                  </div>
                {% elsif loop_desc_has %}
                  {{ looping_description_value | metafield_tag }}
                {% elsif sf != blank %}
                  <div class="apgo-looping-desc-block apgo-looping-desc-block--description">
                    {{ sf | escape | newline_to_br }}
                  </div>
                {% endif %}
              </div>
            {% endif %}

            {% if var_has %}
              {% if gallery_has or lead_has_text %}
                <hr class="apgo-looping-desc-divider" aria-hidden="true">
              {% endif %}
              <section
                class="apgo-looping-desc-block apgo-looping-desc-block--variation"
                aria-labelledby="apgo-lead-variation-{{ section.id }}"
              >
                <h5 class="apgo-looping-desc-block-title" id="apgo-lead-variation-{{ section.id }}">
                  {{ 'product.variation' | t }}
                </h5>
                <div class="apgo-looping-desc-block-body">{{ variation_raw | escape | newline_to_br }}</div>
              </section>
            {% endif %}
          </div>
        </div>
      </div>
    </section>

    {% if insidebox_image != blank %}
      <section class="apgo-insidebox">
        <div class="apgo-insidebox-inner">
          <h3 class="apgo-insidebox-title">{{ 'product.whats_included' | t }}</h3>
          <p class="apgo-insidebox-subline">{{ 'product.whats_included_subline' | t }}</p>
          <img
            class="apgo-insidebox-image"
            src="{{ insidebox_image | image_url: width: 2000 }}"
            alt="{{ 'product.whats_included' | t }}"
            loading="lazy"
          >
        </div>
      </section>
    {% endif %}

    <!-- 短影音展示區 -->
    <section class="apgo-video-showcase">
      <div class="apgo-video-header">
        <h3 class="apgo-video-title">{{ 'product.video_showcase' | t }}</h3>
      </div>

      <div class="apgo-video-scroll-container">
        {% liquid
          assign demo_raw = product.metafields.apgo.demo_videos.value
          assign use_metaobject_list = false
          assign use_file_list = false
          if demo_raw != blank
            assign demo_first = demo_raw.first
            assign file_probe = demo_first | file_url
            if file_probe != blank
              assign use_file_list = true
            elsif demo_first.video_file != blank
              assign use_metaobject_list = true
            endif
          endif
        %}
        {% if use_metaobject_list %}
          {% assign video_objects = demo_raw %}
          {% assign sorted_videos = video_objects | sort: 'sort_order' %}

          {% for video_obj in sorted_videos %}
            {% assign video_url = video_obj.video_file | file_url %}
            {% assign poster_url = '' %}
            {% if video_obj.poster %}
              {% assign poster_url = video_obj.poster | image_url: width: 800 %}
            {% endif %}

            <div
              class="apgo-video-card"
              data-source="metaobject"
              data-video-url="{{ video_url | escape }}"
              data-video-index="{{ forloop.index }}"
            >
              {% if poster_url != blank %}
                <img
                  class="apgo-video-thumbnail"
                  src="{{ poster_url }}"
                  alt="{{ video_obj.title | default: product.title }}"
                  loading="lazy"
                >
              {% else %}
                <div class="apgo-video-thumbnail apgo-video-placeholder" style="position: relative;">
                  <svg
                    width="60"
                    height="60"
                    viewBox="0 0 24 24"
                    fill="#f08418"
                    style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);"
                  >
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                  <div style="background: #333; width: 100%; height: 100%;"></div>
                </div>
              {% endif %}

              <div class="apgo-video-overlay">
                <div class="apgo-video-play-btn"></div>
                <div class="apgo-video-info">
                  <div class="apgo-video-subtitle">
                    {% if video_obj.title %}
                      {{ video_obj.title }}
                    {% else %}
                      {{ 'product.video_default_title' | t }}
                    {% endif %}
                  </div>
                  <div class="apgo-video-views">
                    {{ 'product.video_views' | t: count: video_obj.views | default: '1.2萬' }}
                  </div>
                </div>
              </div>
              <span class="apgo-video-duration">
                {{ video_obj.duration | default: '0:45' }}
              </span>
            </div>
          {% endfor %}
        {% elsif use_file_list %}
          {% for file_ref in demo_raw %}
            {% assign video_url = file_ref | file_url %}
            <div
              class="apgo-video-card"
              data-source="file"
              data-video-url="{{ video_url | escape }}"
              data-video-index="{{ forloop.index }}"
            >
              <div class="apgo-video-thumbnail apgo-video-placeholder" style="position: relative;">
                <svg
                  width="60"
                  height="60"
                  viewBox="0 0 24 24"
                  fill="#f08418"
                  style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);"
                >
                  <path d="M8 5v14l11-7z"/>
                </svg>
                <div style="background: #333; width: 100%; height: 100%;"></div>
              </div>

              <div class="apgo-video-overlay">
                <div class="apgo-video-play-btn"></div>
                <div class="apgo-video-info">
                  <div class="apgo-video-subtitle">
                    {% if file_ref.alt != blank %}
                      {{ file_ref.alt }}
                    {% else %}
                      {{ 'product.video_default_title' | t }} {{ forloop.index }}
                    {% endif %}
                  </div>
                  <div class="apgo-video-views">{{ 'product.video_views' | t: count: forloop.index }}</div>
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="apgo-no-videos">
            <p>{{ 'product.no_videos' | t }}</p>
          </div>
        {% endif %}
      </div>
    </section>

    <section
      class="apgo-pdp-tabs"
      aria-label="Product detail tabs"
      data-apgo-pdp-tabs-root="{{ section.id }}"
    >
      <div class="apgo-pdp-tabs-inner">
        <div class="apgo-pdp-tablist-wrap">
          <div class="apgo-pdp-tablist" role="tablist">
            <button
              type="button"
              class="apgo-pdp-tab"
              role="tab"
              id="apgo-tab-desc-{{ section.id }}"
              aria-controls="apgo-tab-panel-desc-{{ section.id }}"
              aria-selected="true"
              tabindex="0"
            >
              Description
            </button>
            <button
              type="button"
              class="apgo-pdp-tab"
              role="tab"
              id="apgo-tab-how-{{ section.id }}"
              aria-controls="apgo-tab-panel-how-{{ section.id }}"
              aria-selected="false"
              tabindex="-1"
            >
              How to use
            </button>
            <button
              type="button"
              class="apgo-pdp-tab"
              role="tab"
              id="apgo-tab-rev-{{ section.id }}"
              aria-controls="apgo-tab-panel-rev-{{ section.id }}"
              aria-selected="false"
              tabindex="-1"
            >
              Review
            </button>
          </div>
        </div>

        <div class="apgo-tab-panels">
          <div
            class="apgo-tab-panel apgo-looping-desc-content"
            id="apgo-tab-panel-desc-{{ section.id }}"
            role="tabpanel"
            aria-labelledby="apgo-tab-desc-{{ section.id }}"
          >
            {% if description_tab_pics_has %}
              <div class="apgo-tab-desc-gallery apgo-description-tab-gallery">
                {% for pic in description_tab_pic_list %}
                  {% if pic != blank %}
                    <img
                      src="{{ pic | image_url: width: 1400 }}"
                      alt="{{ product.title | escape }} — {{ forloop.index }}"
                      loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                      width="1400"
                      height="1400"
                    >
                  {% endif %}
                {% endfor %}
              </div>
            {% else %}
              <div class="apgo-tab-pane-empty-slot" aria-hidden="true">&nbsp;</div>
            {% endif %}
          </div>

          <div
            class="apgo-tab-panel"
            id="apgo-tab-panel-how-{{ section.id }}"
            role="tabpanel"
            aria-labelledby="apgo-tab-how-{{ section.id }}"
            hidden
          >
            {% if how_tab_has_any %}
              <div class="apgo-looping-desc-content">
                {% if how_has %}
                  <h4 class="apgo-looping-desc-block-title">{{ 'product.how_to_use' | t }}</h4>
