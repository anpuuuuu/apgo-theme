{% comment %}
  APGO v3 PDP（程式內容同步自 git be16ff9 的 apgo_product_page）
  檔案: sections/apgo_product_page_v3.liquid｜模板: templates/product.v3.json
{% endcomment %}
{% liquid
  assign subtitle_mf = product.metafields['custom']['product_subtitle']
  assign product_metafield_subtitle = ''
  if subtitle_mf != blank
    assign t_sub = subtitle_mf | metafield_text | strip
    if t_sub != blank
      assign product_metafield_subtitle = t_sub
    elsif subtitle_mf.value != blank
      assign product_metafield_subtitle = subtitle_mf.value | strip
    endif
  endif

  assign subtitle_display = product_metafield_subtitle
  if subtitle_display == blank
    assign apgo_sub_mf = product.metafields.apgo.subtitle
    if apgo_sub_mf != blank
      assign t_apgo = apgo_sub_mf | metafield_text | strip
      if t_apgo != blank
        assign subtitle_display = t_apgo
      elsif apgo_sub_mf.value != blank
        assign subtitle_display = apgo_sub_mf.value | strip
      else
        assign subtitle_display = apgo_sub_mf | strip
      endif
    endif
  endif
%}
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  :root {
    --primary-orange: #f08418;
    --secondary-orange: #ff9a3c;
    --dark-bg: #000000;
    --card-bg: #1a1a1a;
    --text-white: #ffffff;
    --text-gray: #b0b0b0;
    --text-light-gray: #cccccc;
    --border-color: #333333;
  }

  /* PDP 區塊在 #MainContent 內須明示滿寬，避免繼承建議寬度在部分 flex 環境留下右側 gutter */
  section.shopify-section.apgo-product {
    width: 100%;
    max-width: none;
    box-sizing: border-box;
  }

  .apgo-product-section {
    width: 100%;
    max-width: none;
    box-sizing: border-box;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Microsoft JhengHei', sans-serif;
    background: var(--dark-bg);
    color: var(--text-white);
    /*
      原本 overflow-x: hidden 會讓本元素變成 scroll container（y 軸自動計算為 auto），
      內層 .apgo-pdp-tablist-wrap 的 position: sticky 會錯把本層當捲動祖先 → 黏不起來。
      改用 overflow-x: clip：同樣裁掉橫向溢出，但不建立 scroll container，sticky 後代可以
      正常以 viewport 為錨點。
    */
    overflow-x: clip;
    -ms-overflow-style: none; /* IE 和 Edge */
    scrollbar-width: none; /* Firefox */
    -webkit-font-smoothing: antialiased;
  }

  /* 頂部導航列 */
  .apgo-nav-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 56px;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(240, 132, 24, 0.2);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
  }

  .apgo-back-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(240, 132, 24, 0.1);
    border: 1px solid rgba(240, 132, 24, 0.3);
    border-radius: 50%;
    color: var(--primary-orange);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .apgo-nav-logo {
    height: 35px;
    width: auto;
    filter: brightness(1.1);
  }

  .apgo-nav-actions {
    display: flex;
    gap: 8px;
  }

  .apgo-nav-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    color: var(--text-light-gray);
    cursor: pointer;
  }

  .apgo-cart-count {
    position: absolute;
    top: 5px;
    right: 5px;
    width: 18px;
    height: 18px;
    background: var(--primary-orange);
    color: white;
    border-radius: 50%;
    font-size: 0.7rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
  }

  /* 主內容區 */
  .apgo-main-container {
    width: 100%;
    max-width: none;
    min-height: 100vh;
    padding-bottom: 28px;
    -ms-overflow-style: none; /* IE 和 Edge */
    scrollbar-width: none; /* Firefox */
  }

  /*
    Hero visual — was a fixed 400px box with a dark-grey gradient. That left a
    grey letterbox around portrait/square product photos and pushed the swipe
    dots into the leftover space below the image. Switch to aspect-ratio:1
    (square — matches typical product shots) and transparent background so the
    image fills the box, the dots overlap the image edge, and there's no grey
    panel showing through.
  */
  .apgo-hero-visual {
    position: relative;
    /* Shrink the hero slightly so it doesn't dominate the viewport — leaves
       breathing room on the sides on mobile. Centered. Square aspect ratio. */
    width: 100%;
    max-width: 88vw;
    margin-left: auto;
    margin-right: auto;
    aspect-ratio: 1 / 1;
    background: transparent;
    overflow: hidden;
  }

  /* 動態光點效果 */
  .apgo-floating-particles {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
  }

  .apgo-particle {
    position: absolute;
    width: 3px;
    height: 3px;
    background: var(--primary-orange);
    border-radius: 50%;
    opacity: 0;
    animation: apgoParticleFloat 10s infinite linear;
  }

  @keyframes apgoParticleFloat {
    0% {
      transform: translateY(100vh) translateX(0);
      opacity: 0;
    }
    10% {
      opacity: 0.6;
    }
    90% {
      opacity: 0.6;
    }
    100% {
      transform: translateY(-10vh) translateX(100px);
      opacity: 0;
    }
  }

  /* 產品展示 */
  .apgo-product-showcase {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px 12px 12px;
    overflow: hidden;
  }

  /* 輪播容器樣式 */
  .apgo-product-showcase {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px 12px 12px;
    overflow: hidden;
  }

  /* 輪播圖片容器 */
  .apgo-carousel-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    min-width: 0;
  }

  .apgo-carousel-track {
    display: flex;
    width: 100%;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    will-change: transform;
    height: 100%;
    align-items: center;
  }

  .apgo-carousel-slide {
    flex: 0 0 100%;
    min-width: 100%;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .apgo-product-image-main {
    animation: none !important;
    transition: opacity 0.2s ease, transform 0.35s ease;
  }

  .apgo-product-image-main.is-cover {
    animation: none !important;
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    /*
      Show the FULL image (no cropping) so non-square product shots aren't
      clipped on mobile. Container background is transparent so the letterbox
      blends with the page. Desktop has its own hero rules.
    */
    object-fit: contain;
  }

  /* 產品標籤 */
  .apgo-product-badges {
    position: absolute;
    top: 20px;
    right: 20px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .apgo-badge {
    background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));
    color: white;
    padding: 6px 16px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    animation: apgoPulseBadge 2s ease-in-out infinite;
  }

  @keyframes apgoPulseBadge {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  /*
    Thumbnail strip — minimal, left-aligned, no vertical padding.
    Smaller tiles (52px) so a row of 5+ fits on a phone without horizontal scroll
    on a typical product. Background blends into the page.
  */
  .apgo-product-thumbnails {
    /* Small breathing gap above the strip, no horizontal padding so the
       container's own padding can center the row. */
    padding: 10px 0 0;
    background: var(--dark-bg);
    margin: 0;
  }

  .apgo-thumbnails-container {
    display: flex;
    gap: 6px;
    justify-content: center;
    overflow-x: auto;
    padding: 0 12px;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
    overflow-y: hidden;
    touch-action: pan-x;
    overscroll-behavior-x: contain;
  }

  .apgo-thumbnails-container::-webkit-scrollbar {
    display: none;
  }

  .apgo-thumbnails-container.dragging {
    cursor: grabbing;
    scroll-snap-type: none;
  }

  .apgo-thumbnail-item {
    flex: 0 0 auto;
    width: 52px;
    height: 52px;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    cursor: pointer;
    transition: border-color .2s ease, transform .15s ease;
    scroll-snap-align: start;
    border: 2px solid transparent;
    background: var(--card-bg);
    touch-action: manipulation;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .apgo-thumbnail-item.active {
    border-color: var(--primary-orange);
  }

  .apgo-thumbnail-item:active {
    transform: scale(0.95);
  }

  .apgo-thumbnail-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #2a2a2a;
    border-radius: 6px;
  }

  .apgo-thumbnail-overlay {
    position: absolute;
    inset: 0;
    background: rgba(240, 132, 24, 0.15);
    opacity: 0;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
  }

  .apgo-thumbnail-item.active .apgo-thumbnail-overlay {
    opacity: 1;
  }

  /*
    --no-subtitle-below modifier — keep the same 10px top gap as the base rule.
  */
  .apgo-product-thumbnails.apgo-product-thumbnails--no-subtitle-below {
    padding: 10px 0 0;
    margin-bottom: 0;
  }

  .apgo-product-thumbnails.apgo-product-thumbnails--no-subtitle-below .apgo-thumbnails-container {
    padding-top: 0;
    padding-bottom: 0;
  }

  .apgo-thumbnail-play-icon {
    width: 20px;
    height: 20px;
    background: var(--primary-orange);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: 0.7rem;
    opacity: 0.9;
  }

  /* 手機優化 */
  @media (max-width: 768px) {
    /* Mobile mirrors the base: 10px top breathing gap, center-aligned strip. */
    .apgo-product-thumbnails {
      padding: 10px 0 0;
    }

    .apgo-product-thumbnails.apgo-product-thumbnails--no-subtitle-below {
      padding: 10px 0 0;
      margin-bottom: 0;
    }

    .apgo-product-thumbnails.apgo-product-thumbnails--no-subtitle-below .apgo-thumbnails-container {
      padding-top: 0;
      padding-bottom: 0;
    }

    .apgo-product-info.apgo-product-info--no-subtitle {
      padding-top: 6px;
    }

    .apgo-thumbnails-container {
      gap: 6px;
      padding: 0 12px;
      justify-content: center;
    }

    .apgo-thumbnail-item {
      width: 52px;
      height: 52px;
      border-radius: 8px;
    }

    /* No scale on active — keeps tile size constant so the row doesn't jiggle when swapping */
    .apgo-thumbnail-item.active {
      transform: none;
    }
  }

  /* 產品基本資訊 — tighter top padding so title sits close to thumbnails strip */
  .apgo-product-info {
    padding: 12px 16px;
    background: var(--dark-bg);
  }

  .apgo-product-info.apgo-product-info--no-subtitle {
    padding-top: 10px;
  }

  .apgo-product-info.apgo-product-info--no-subtitle .apgo-product-name {
    margin-bottom: 0;
  }

  .apgo-product-header {
    text-align: center;
    /* Tight spacing — title sits close to the price card below */
    margin-bottom: 8px;
    padding-bottom: 0;
  }

  .apgo-product-name {
    font-size: 1.35rem;
    line-height: 1.25;
    font-weight: bold;
    background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 8px;
  }

  @media (min-width: 769px) {
    .apgo-product-name {
      font-size: 1.6rem;
    }
  }

  .apgo-product-metafield-subtitle {
    margin: 0 auto 10px;
    max-width: 36rem;
    font-size: 0.9375rem;
    font-weight: 400;
    line-height: 1.45;
    color: var(--text-gray);
  }

  /* 性能指標展示 */
  .apgo-performance-metrics {
    background: var(--card-bg);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 24px;
    border: 1px solid rgba(240, 132, 24, 0.2);
  }

  .apgo-metrics-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-white);
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .apgo-metrics-title::before {
    content: '';
    width: 4px;
    height: 20px;
    background: var(--primary-orange);
    border-radius: 2px;
  }

  .apgo-metric-item {
    margin-bottom: 16px;
  }

  .apgo-metric-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .apgo-metric-label {
    font-size: 0.85rem;
    color: var(--text-gray);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .apgo-metric-value {
    font-size: 0.95rem;
    font-weight: bold;
    background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .apgo-metric-bar {
    height: 8px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    overflow: hidden;
    position: relative;
  }

  .apgo-metric-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--primary-orange), var(--secondary-orange));
    border-radius: 8px;
    transition: width 1s ease;
    position: relative;
    overflow: hidden;
  }

  .apgo-metric-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
    animation: apgoShine 3s ease-in-out infinite;
  }

  @keyframes apgoShine {
    0% {
      left: -100%;
    }
    100% {
      left: 200%;
    }
  }

  /* PDP tabs (English labels) — video + RTE block below */
  .apgo-pdp-looping-lead {
    padding: 0 16px 12px;
    background: var(--dark-bg);
  }

  .apgo-pdp-tabs {
    padding: 0 16px 24px;
    background: var(--dark-bg);
    container-type: inline-size;
    container-name: apgo-pdp-tabs;
    /* sticky 子元素必須能脫離本層；不能 hidden/clip/auto */
    overflow: visible;
  }

  .apgo-pdp-tabs-inner {
    max-width: none;
    margin-left: auto;
    margin-right: auto;
    overflow: visible;
  }

  @media (min-width: 769px) {
    .apgo-pdp-tabs-inner {
      max-width: min(1200px, 66vw);
    }
  }

  /*
    Sticky tab bar：黏在「整個吸頂棧（header-group + 跑馬燈）」下方。
    --apgo-pdp-tabs-sticky-top 由本 section 末尾 JS 量測後寫到 body 上；fallback 100px。
    z-index 用 layer-sticky - 2，低於 header (8) 與跑馬燈 (7)，避免 tab 底色蓋住跑馬燈。
  */
  .apgo-pdp-tablist-wrap {
    position: -webkit-sticky;
    position: sticky;
    top: var(--apgo-pdp-tabs-sticky-top, 100px);
    z-index: calc(var(--layer-sticky, 8) - 2);
    background: var(--dark-bg);
    /* 細線即可：0.5px 實色橘，hairline 級別的分隔 */
    border-bottom: 0.5px solid var(--primary-orange);
    margin: 0 0 12px;
    padding: 6px 0 0;
  }

  .apgo-pdp-tablist {
    display: flex;
    flex-wrap: nowrap;
    gap: 4px;
    justify-content: center;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }

  .apgo-pdp-tab {
    flex: 0 0 auto;
    padding: 10px 12px;
    margin: 0;
    border: none;
    /* 取消底部 indicator 邊框：active 僅靠文字顏色標示 */
    border-bottom: none;
    border-radius: 8px 8px 0 0;
    background: transparent;
    /* Inactive tabs in solid white; active tab overrides to orange below */
    color: rgba(255, 255, 255, 0.92);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }

  @media (min-width: 769px) {
    .apgo-pdp-tab {
      font-size: 0.88rem;
      padding: 12px 16px;
    }
  }

  .apgo-pdp-tab[aria-selected="true"] {
    color: var(--primary-orange);
  }

  .apgo-pdp-tab:focus-visible {
    outline: 2px solid rgba(255, 255, 255, 0.45);
    outline-offset: 2px;
  }

  .apgo-tab-panel {
    /* Continuous-scroll mode: all panels visible. scroll-margin-top gives
       smooth-scroll anchor breathing room so the tab bar doesn't cover the
       top of the panel when a tab is clicked. */
    scroll-margin-top: calc(var(--apgo-pdp-tabs-sticky-top, 100px) + 60px);
    padding: 16px 0 32px;
    /* Faint divider between panels so the boundary is visible on scroll */
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }
  .apgo-tab-panel:first-of-type { border-top: none; }

  /*
    Continuous-scroll mode means we no longer use [hidden] to switch tabs.
    Keep the rule but as a no-op (display: revert) so any leftover hidden
    attribute doesn't actually conceal a panel.
  */
  .apgo-tab-panel[hidden] {
    display: revert;
  }

  .apgo-tab-desc-layout {
    display: grid;
    gap: 14px;
    background: #0f0f0f;
    border: 1px solid rgba(240, 132, 24, 0.18);
    border-radius: 14px;
    padding: 12px;
    min-width: 0;
  }

  .apgo-tab-desc-layout.has-video {
    grid-template-columns: minmax(260px, 38%) minmax(0, 1fr);
    align-items: start;
  }

  .apgo-tab-desc-layout:not(.has-video) {
    grid-template-columns: minmax(0, 1fr);
  }

  .apgo-tab-desc-gallery {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 14px;
    width: 100%;
    min-width: 0;
  }

  .apgo-tab-desc-gallery img,
  .apgo-tab-desc-gallery video {
    width: 100%;
    height: auto;
    border-radius: 10px;
    display: block;
    background: #111;
    object-fit: contain;
  }

  /*
    Review / Description 分頁：圖片置中、寬度跟著 .apgo-pdp-tabs-inner（桌面 = min(1200px, 66vw) ≈ 2/3，
    且該容器本身 margin:auto 置中），不再做 negative margin bleed-out。
  */
  .apgo-tab-panel--review,
  .apgo-tab-panel--description {
    width: 100%;
    max-width: 100%;
    margin-left: auto;
    margin-right: auto;
    box-sizing: border-box;
    padding: 0 0 8px;
  }

  .apgo-tab-panel--description .apgo-tab-desc-gallery {
    gap: 0;
    margin-bottom: 0;
    align-items: center;
  }

  .apgo-tab-panel--description .apgo-tab-desc-gallery img,
  .apgo-tab-panel--description .apgo-tab-desc-gallery video {
    border-radius: 0;
    background: #000;
    margin-left: auto;
    margin-right: auto;
  }

  .apgo-tab-panel--review .apgo-pdp-review-media-stack {
    align-items: center;
  }

  .apgo-tab-panel--review .apgo-pdp-review-media-stack img {
    margin-left: auto;
    margin-right: auto;
  }

  .apgo-pdp-review-media-stack {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
    min-width: 0;
    text-align: left;
  }

  .apgo-pdp-review-media-stack .apgo-customer-review-image {
    margin: 0;
    object-fit: contain;
    border-radius: 0;
    max-width: none !important;
    width: 100%;
    display: block;
  }

  .apgo-tab-panel--review .apgo-tab-empty {
    padding-inline: 16px;
    margin-block: 10px;
  }

  .apgo-tab-panel--faq {
    text-align: left;
  }

  .apgo-pdp-faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .apgo-pdp-faq-card {
    background: #0f0f0f;
    border: 1px solid rgba(240, 132, 24, 0.22);
    border-radius: 14px;
    overflow: hidden;
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .apgo-pdp-faq-card[open] {
    border-color: rgba(240, 132, 24, 0.45);
    box-shadow: 0 0 0 1px rgba(240, 132, 24, 0.12);
  }

  .apgo-pdp-faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 16px;
    cursor: pointer;
    list-style: none;
