    margin: 0 0 16px;
  }

  .apgo-looping-desc-content {
    color: var(--text-light-gray);
    font-size: 0.9rem;
    line-height: 1.6;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: break-word;
    word-wrap: break-word; /* 舊 WebKit */
  }

  .apgo-looping-desc-content p,
  .apgo-looping-desc-content li {
    margin: 0 0 8px;
    max-width: 100%;
    overflow-wrap: break-word;
  }

  .apgo-looping-desc-content ul,
  .apgo-looping-desc-content ol {
    padding-left: 18px;
    margin: 0 0 8px;
  }

  hr.apgo-looping-desc-divider {
