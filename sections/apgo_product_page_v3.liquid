// 更新價格顯示
function updatePriceDisplay() {
  const lineTotal = currentPrice * currentQuantity;
  const sectionEl = document.querySelector('.apgo-product-section');
  const currency =
    sectionEl && sectionEl.dataset.apgoCurrency ? sectionEl.dataset.apgoCurrency : 'TWD';
  let formatted;
  try {
    formatted = new Intl.NumberFormat(undefined, {
      style: 'currency',
      currency: currency
    }).format(lineTotal);
  } catch (e) {
