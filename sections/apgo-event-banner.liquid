{% comment %}
  APGO Special Event — full-width banner image (no crop).
  Mobile: edge-to-edge. Desktop: configurable width (default 2/3).
{% endcomment %}

{{ 'apgo-event-page.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  frame_style "crate" / "crate_simple" draw the clearance page's cardboard
  frame (styled in apgo-clearance-page.css, which only the clearance-sale
  template loads).
{%- endcomment -%}
{%- assign apgo_banner_frame = section.settings.frame_style | default: 'none' -%}
<section
  id="apgo-event-banner-{{ section.id }}"
  class="apgo-event-banner section section--full-width color-{{ section.settings.color_scheme }}{% if apgo_banner_frame != 'none' %} apgo-event-banner--{{ apgo_banner_frame }}{% endif %}"
  style="--apgo-event-banner-desktop-width: {{ section.settings.desktop_width_percent }}%;"
>
  {% if section.settings.image != blank %}
    <div class="apgo-event-banner__frame">
      {% if section.settings.link != blank %}
        <a
          href="{{ section.settings.link }}"
          class="apgo-event-banner__link"
          {% if template.suffix == 'golden-bull-award' %}
            data-apgo-campaign-promotion-link
            data-promotion-id="golden_bull_hero"
            data-promotion-name="Golden Bull Award hero"
          {% elsif template.suffix == 'clearance-sale' %}
            data-apgo-campaign-promotion-link
            data-promotion-id="clearance_sale_hero"
            data-promotion-name="Factory Expansion Clearance hero"
          {% endif %}
        >
      {% endif %}
      <img
        class="apgo-event-banner__img"
        src="{{ section.settings.image | image_url: width: 2400 }}"
        alt="{{ section.settings.image_alt | default: section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="{% if section.index == 1 %}eager{% else %}lazy{% endif %}"
      >
      {% if section.settings.link != blank %}
        </a>
      {% endif %}
      {%- if apgo_banner_frame == 'crate' -%}
        <div class="apgo-event-banner__crate-row" aria-hidden="true">
          <span class="apgo-event-banner__crate-mark">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M8 20V6M4 10l4-4 4 4M16 20V6M12 10l4-4 4 4"/></svg>
            This side up
          </span>
          <span class="apgo-event-banner__crate-mid">APGO · Old factory stock</span>
          <span>Handle with care</span>
        </div>
      {%- endif -%}
    </div>
  {% elsif request.design_mode %}
    <div class="apgo-event-banner__frame">
      <div class="apgo-event-banner__placeholder">
        {{ 'image' | placeholder_svg_tag }}
        <span>在設定中上傳 Banner 圖片</span>
      </div>
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "APGO Event Banner",
  "tag": "section",
  "class": "apgo-event-banner-wrapper",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner 圖片"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "圖片替代文字（選填）"
    },
    {
      "type": "url",
      "id": "link",
      "label": "點擊連結（選填）"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "電腦版寬度（%）",
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 67,
      "info": "手機版一律全寬貼邊；電腦版預設約 2/3 寬並置中。"
    },
    {
      "type": "select",
      "id": "frame_style",
      "label": "外框樣式",
      "options": [
        { "value": "none", "label": "無" },
        { "value": "crate", "label": "紙箱＋封箱膠帶（清倉頁）" },
        { "value": "crate_simple", "label": "紙箱邊框（清倉頁）" }
      ],
      "default": "none",
      "info": "紙箱外框只在清倉頁（clearance-sale 模板）有樣式；清倉頁的寬度固定跟內容對齊。"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-a27d2d12-7174-40fe-a01c-a128174b4c26"
    }
  ],
  "presets": [
    {
      "name": "APGO Event Banner",
      "category": "APGO"
    }
  ]
}
{% endschema %}
