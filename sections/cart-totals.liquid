{%- comment -%} Cart Totals (standalone section) {%- endcomment -%}
<div
  id="CartTotals-{{ section.id }}"
  class="cart-totals cart-totals--standalone color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="cart-totals"
  data-content-id="CartTotalsContent-{{ section.id }}"
  data-init-flag="__cartTotalsInit_{{ section.id }}"
>
  <!-- 👉 只替換這個內容區，外層 wrapper 不動 -->
  <div id="CartTotalsContent-{{ section.id }}">
    {%- liquid
      assign market_threshold_minor = 0
      assign is_sg_market = false
      assign is_my_market = false
      if localization.country.iso_code == 'SG'
        assign is_sg_market = true
        assign market_threshold_minor = 7000
      elsif localization.country.iso_code == 'MY'
        assign is_my_market = true
        assign market_threshold_minor = 15500
      endif

      capture apgo_fs_basis_raw
        render 'apgo-cart-free-shipping-basis', cart: cart
      endcapture
      assign apgo_free_shipping_basis = apgo_fs_basis_raw | plus: 0

      assign discount_total_minor = cart.total_discount
      assign remaining_for_free_shipping_minor = 0
      assign free_shipping_remaining_formatted = remaining_for_free_shipping_minor | money

      # Tag-based override: any cart line whose product carries
      # 'free-shipping' unlocks the entire order regardless of subtotal.
      capture apgo_fs_tag_title_raw
        render 'apgo-cart-free-shipping-product-title'
      endcapture
      assign apgo_fs_tag_title = apgo_fs_tag_title_raw | strip
      assign apgo_fs_tag_unlocked = false
      if apgo_fs_tag_title != blank
        assign apgo_fs_tag_unlocked = true
      endif

      assign free_shipping_unlocked = false
      if apgo_fs_tag_unlocked
        assign free_shipping_unlocked = true
      elsif market_threshold_minor > 0
        if apgo_free_shipping_basis >= market_threshold_minor
          assign free_shipping_unlocked = true
        else
          assign remaining_for_free_shipping_minor = market_threshold_minor | minus: apgo_free_shipping_basis
          assign free_shipping_remaining_formatted = remaining_for_free_shipping_minor | money
        endif
      endif

      # Mobile summary — flat shipping estimate (must mirror sections/cart-cta.liquid)
      assign apgo_flat_my_minor = section.settings.flat_shipping_my_cents | default: 290
      assign apgo_flat_sg_minor = section.settings.flat_shipping_sg_cents | default: 290
      assign apgo_shipping_estimate_minor = 0
      if market_threshold_minor > 0 and free_shipping_unlocked == false
        if is_my_market
          assign apgo_shipping_estimate_minor = apgo_flat_my_minor
        elsif is_sg_market
          assign apgo_shipping_estimate_minor = apgo_flat_sg_minor
        endif
      endif

      assign apgo_estimated_total_minor = cart.total_price | plus: apgo_shipping_estimate_minor
      assign final_total_with_shipping_minor = apgo_estimated_total_minor
      # Standalone estimated row: symbol only (e.g. RM…) — strip trailing
      # currency iso code (… MYR / … SGD) when the shop's money format includes it.
      assign total_price_formatted = final_total_with_shipping_minor | money | replace: cart.currency.iso_code, '' | strip
      assign free_shipping_remaining_formatted = free_shipping_remaining_formatted | replace: cart.currency.iso_code, '' | strip

      # Pre-format strings used by the mobile accordion
      assign apgo_summary_subtotal_fmt = cart.original_total_price | money | replace: cart.currency.iso_code, '' | strip
      assign apgo_summary_discount_fmt = discount_total_minor | money | replace: cart.currency.iso_code, '' | strip
      assign apgo_summary_shipping_fmt = apgo_shipping_estimate_minor | money | replace: cart.currency.iso_code, '' | strip
      assign apgo_summary_total_fmt = total_price_formatted
      assign apgo_show_discount_row = false
      if discount_total_minor > 0
        assign apgo_show_discount_row = true
      endif
      assign apgo_show_shipping_row = false
      if market_threshold_minor > 0
        assign apgo_show_shipping_row = true
      endif
    -%}

    {%- if section.settings.show_note_or_code -%}
      {%- if settings.show_cart_note or settings.show_add_discount_code -%}
        <div class="cart-totals__actions">
          {%- if settings.show_cart_note -%}
            {% render 'cart-note' %}
          {%- endif -%}
          {%- if settings.show_add_discount_code -%}
            {% render 'cart-discount', section_id: section.id %}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    <div class="cart__total-container">
      {%- comment -%}
        明細（小計／免運／折扣）：可於區塊設定關閉。金額幣別隨 Shopify Markets 的 cart.currency（如 MYR、SGD）。
      {%- endcomment -%}
      {%- if section.settings.show_order_breakdown -%}
        <div class="cart-totals__breakdown">
          <div class="cart__summary-item cart__original-total">
            <span class="cart__label">{{ 'content.cart_subtotal' | t }}</span>
            <span class="cart__value">{{ cart.original_total_price | money | replace: cart.currency.iso_code, '' | strip }}</span>
          </div>

          {% if is_sg_market or is_my_market %}
            <div class="cart__summary-item cart__shipping-goal">
              <span class="cart__label">{{ 'apgo_cart.free_shipping_goal_label' | t }}</span>
              <span class="cart__value">
                {%- if free_shipping_unlocked -%}
                  {{- 'apgo_cart.free_shipping_unlocked' | t -}}
                {%- else -%}
                  {{- 'apgo_cart.free_shipping_remaining' | t: amount: free_shipping_remaining_formatted -}}
                {%- endif -%}
              </span>
            </div>
          {% endif %}

          {% if discount_total_minor > 0 %}
            <div class="cart__summary-item cart__discount-total">
              <span class="cart__label">{{ 'content.discount' | t }}</span>
              <span class="cart__value">-{{ discount_total_minor | money | replace: cart.currency.iso_code, '' | strip }}</span>
            </div>
          {% endif %}

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart__summary-item cart__discount">
                <span class="cart__label">
                  {{- 'icon-discount.svg' | inline_asset_content -}}
                  {{ discount.title | escape }}
                </span>
                <span class="cart__value">-{{ discount.total_allocated_amount | money | replace: cart.currency.iso_code, '' | strip }}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} 第二張圖風格：黑底、標題＋金額同列；稅務說明緊接在 Estimated total 列下方 {%- endcomment -%}
      <div class="cart-totals__estimated-card" role="status">
        <div class="cart-totals__estimated-card-row">
          <div class="cart-totals__estimated-card-left">
            <p class="cart-totals__estimated-title">{{ 'content.cart_estimated_total' | t }}</p>
          </div>
          <text-component
            ref="cartTotalStandalone"
            value="{{ total_price_formatted | strip_html }}"
            class="cart-totals__estimated-price"
            data-cart-subtotal
          >
            {{ total_price_formatted }}
          </text-component>
        </div>
        <div class="cart-totals__estimated-tax">
          {% render 'tax-info', has_discounts_enabled: settings.show_add_discount_code %}
        </div>
      </div>

      {%- if section.settings.show_installments and settings.show_installments -%}
        <div class="cart__summary-item cart__installments">
          {% form 'cart', cart %}{{ form | payment_terms }}{% endform %}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%}
      Mobile-only Shopee/Taobao-style order summary.
      Lives inside the section content so `?sections=` re-render keeps it fresh.
      Hidden on desktop via CSS; the existing breakdown + estimated card above
      remain the desktop UI.
    {%- endcomment -%}
    <div class="cart-summary--mobile" data-cart-summary-mobile>
      <details class="cart-summary__row" data-summary-row="subtotal">
        <summary class="cart-summary__head">
          <span class="cart-summary__label">{{ 'apgo_cart.summary_subtotal' | t }}</span>
          <span class="cart-summary__right">
            <span class="cart-summary__value" data-summary-subtotal>{{ apgo_summary_subtotal_fmt }}</span>
            <span class="cart-summary__chevron" aria-hidden="true">
              <svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5l3 3 3-3"/></svg>
            </span>
          </span>
        </summary>
        <ul class="cart-summary__list cart-summary__list--items">
          {%- for item in cart.items -%}
            {%- assign apgo_is_gift = false -%}
            {%- if item.properties._free_gift == 'true' -%}{%- assign apgo_is_gift = true -%}{%- endif -%}
            <li class="cart-summary__line">
              <span class="cart-summary__line-title">
                {{ item.product.title | escape }}
                {%- if item.variant.title != 'Default Title' -%}
                  <span class="cart-summary__line-variant">{{ item.variant.title | escape }}</span>
                {%- endif -%}
                {%- if apgo_is_gift -%}
                  <span class="cart-summary__line-badge">{{ 'apgo_cart.summary_gift_badge' | t }}</span>
                {%- endif -%}
                <span class="cart-summary__line-qty">{{ 'apgo_cart.summary_qty_prefix' | t }} {{ item.quantity }}</span>
              </span>
              <span class="cart-summary__line-amount">{{ item.original_line_price | money | replace: cart.currency.iso_code, '' | strip }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </details>

      {%- if apgo_show_discount_row -%}
        <details class="cart-summary__row cart-summary__row--discount" data-summary-row="discount">
          <summary class="cart-summary__head">
            <span class="cart-summary__label">{{ 'apgo_cart.summary_discount' | t }}</span>
            <span class="cart-summary__right">
              <span class="cart-summary__value cart-summary__value--neg" data-summary-discount>-{{ apgo_summary_discount_fmt }}</span>
              <span class="cart-summary__chevron" aria-hidden="true">
                <svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5l3 3 3-3"/></svg>
              </span>
            </span>
          </summary>
          <ul class="cart-summary__list cart-summary__list--discounts">
            {%- for app in cart.cart_level_discount_applications -%}
              <li class="cart-summary__line">
                <span class="cart-summary__line-title">{{ app.title | escape }}</span>
                <span class="cart-summary__line-amount cart-summary__value--neg">-{{ app.total_allocated_amount | money | replace: cart.currency.iso_code, '' | strip }}</span>
              </li>
            {%- endfor -%}
            {%- for item in cart.items -%}
              {%- for allocation in item.line_level_discount_allocations -%}
                {%- if allocation.amount > 0 -%}
                  <li class="cart-summary__line">
                    <span class="cart-summary__line-title">
                      {{ allocation.discount_application.title | escape }}
                      <span class="cart-summary__line-variant">{{ item.product.title | escape }}</span>
                    </span>
                    <span class="cart-summary__line-amount cart-summary__value--neg">-{{ allocation.amount | money | replace: cart.currency.iso_code, '' | strip }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          </ul>
        </details>
      {%- endif -%}

      {%- if apgo_show_shipping_row -%}
        <details class="cart-summary__row cart-summary__row--shipping" data-summary-row="shipping">
          <summary class="cart-summary__head">
            <span class="cart-summary__label">{{ 'apgo_cart.summary_shipping' | t }}</span>
            <span class="cart-summary__right">
              <span class="cart-summary__value{% if free_shipping_unlocked %} cart-summary__value--free{% endif %}" data-summary-shipping>
                {%- if free_shipping_unlocked -%}
                  {{- 'apgo_cart.summary_shipping_free' | t -}}
                {%- else -%}
                  ~{{ apgo_summary_shipping_fmt }}
                {%- endif -%}
              </span>
              <span class="cart-summary__chevron" aria-hidden="true">
                <svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5l3 3 3-3"/></svg>
              </span>
            </span>
          </summary>
          <div class="cart-summary__body">
            <p class="cart-summary__note">
              {%- if is_my_market -%}
                {{- 'apgo_cart.summary_shipping_note_my' | t -}}
              {%- elsif is_sg_market -%}
                {{- 'apgo_cart.summary_shipping_note_sg' | t -}}
              {%- else -%}
                {{- 'apgo_cart.summary_shipping_note_other' | t -}}
              {%- endif -%}
            </p>
            {%- unless free_shipping_unlocked -%}
              <p class="cart-summary__note cart-summary__note--remaining">
                {{- 'apgo_cart.free_shipping_remaining' | t: amount: free_shipping_remaining_formatted -}}
              </p>
            {%- endunless -%}
          </div>
        </details>
      {%- endif -%}

      <div class="cart-summary__total" role="status">
        <span class="cart-summary__label cart-summary__label--total">{{ 'apgo_cart.summary_estimated_total' | t }}</span>
        <span class="cart-summary__value cart-summary__value--total" data-summary-total>{{ apgo_summary_total_fmt }}</span>
      </div>
      <p class="cart-summary__total-note">{{ 'apgo_cart.estimated_total_checkout_note' | t }}</p>
    </div>
  </div>
</div>
  
  {% stylesheet %}
  /* ========================================
     購物車總計區塊樣式設計 - 僅針對獨立區塊
     ======================================== */
  
  /* 主容器樣式 - 使用特定類別避免衝突 */
  .cart-totals--standalone { 
    --apgo-cart-inline-space: clamp(12px, 2.2vw, 28px);
    display: flex; 
    flex-direction: column; 
    gap: var(--gap-md); 
    background: transparent !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    border: none !important;
    padding: 0 var(--apgo-cart-inline-space) !important;
    margin: 20px 0 !important;
    max-width: none !important;
    width: 100% !important;
    position: relative !important;
    z-index: 1 !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif !important;
    color: #ffffff !important;
  }
  
  /* 移除橘色頂部線條 */
  .cart-totals--standalone::before {
    display: none !important;
  }
  
  /* 每一條就是左右兩側 */
  .cart-totals--standalone .cart__summary-item {
    display: flex !important;
    justify-content: space-between !important; /* 左右兩端對齊 */
    align-items: center !important;
    padding: 8px 0 !important;
    font-size: 14px !important;
    border: none !important; /* 預設不要底線 */
  }

  /* 小計 */
  .cart-totals--standalone .cart__original-total .cart__label {
    color: #ccc !important;
  }
  .cart-totals--standalone .cart__original-total .cart__value {
    color: #fff !important;
    font-weight: 600 !important;
  }

  /* 折扣 */
  .cart-totals--standalone .cart__discount .cart__label {
    display: flex !important;               /* 讓 icon 與文字在同一行 */
    align-items: center !important;
    gap: 4px !important;                    /* icon 與文字的距離 */
    color: #ff6b35 !important;
    font-weight: 500 !important;
  }
  .cart-totals--standalone .cart__discount .cart__value {
    color: #ff6b35 !important;
    font-weight: 500 !important;
  }
  
  /* 操作區塊 */
  .cart-totals--standalone .cart-totals__actions {
    display: flex !important;
    flex-direction: column !important;
    gap: var(--gap-2xs) !important;
    border-top: 1px solid #333333 !important;
    border-bottom: 1px solid #333333 !important;
    padding: 20px 0 !important;
    margin: 0 0 24px 0 !important;
  }
  
  /* 外層容器：不強制大色塊，由下方卡片承擔主視覺 */
  .cart-totals--standalone .cart__total-container {
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    padding: 0 !important;
    position: relative !important;
    overflow: visible !important;
    margin: 0 0 24px 0 !important;
  }

  .cart-totals--standalone .cart__total-container::before {
    display: none !important;
  }

  /* 上方明細（小計／折扣／免運） */
  .cart-totals--standalone .cart-totals__breakdown {
    margin-bottom: 14px !important;
    padding-bottom: 4px !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
  }

  .cart-totals--standalone .cart-totals__breakdown .cart__summary-item {
    padding: 6px 0 !important;
  }

  /* 第二張圖：黑底預估總計卡 */
  .cart-totals--standalone .cart-totals__estimated-card {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 10px !important;
    background: #000000 !important;
    border-radius: 10px !important;
    padding: clamp(16px, 3vw, 22px) !important;
  }

  .cart-totals--standalone .cart-totals__estimated-card-row {
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: space-between !important;
    align-items: baseline !important;
    gap: 12px 20px !important;
    width: 100% !important;
  }

  .cart-totals--standalone .cart-totals__estimated-card-left {
    flex: 1 1 200px !important;
    min-width: 0 !important;
  }

  .cart-totals--standalone .cart-totals__estimated-tax {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    font-size: 12px !important;
    line-height: 1.45 !important;
    color: #b0b0b0 !important;
  }

  .cart-totals--standalone .cart-totals__estimated-tax small {
    color: inherit !important;
  }

  .cart-totals--standalone .cart-totals__estimated-tax a {
    color: #d0d0d0 !important;
    text-decoration: underline !important;
  }

  .cart-totals--standalone .cart-totals__estimated-title {
    margin: 0 !important;
    font-size: clamp(1.35rem, 4.2vw, 1.85rem) !important;
    font-weight: 700 !important;
    line-height: 1.15 !important;
    color: #f7931e !important;
  }

  .cart-totals--standalone .cart-totals__estimated-price {
    flex: 0 0 auto !important;
    margin-left: auto !important;
    text-align: right !important;
    font-size: clamp(1.35rem, 4.2vw, 1.85rem) !important;
    font-weight: 700 !important;
    line-height: 1.15 !important;
    color: #f7931e !important;
    -webkit-text-fill-color: #f7931e !important;
  }

  /* 分期付款（稅務說明已併入 estimated 卡內） */
  .cart-totals--standalone .cart__installments {
    font-size: 12px !important;
    color: #aaa !important;
    padding-top: 10px !important;
    border: none !important;
  }

  /* 響應式設計 */
  @media (max-width: 768px) {
    .cart-totals--standalone {
      margin: 12px 0 !important;
      border-radius: 0 !important;
      padding: 0 var(--apgo-cart-inline-space) !important;
      width: 100% !important;
      max-width: none !important;
    }
    
  }
  
  @media (max-width: 480px) {
    .cart-totals--standalone {
      padding: 0 var(--apgo-cart-inline-space) !important;
      margin: 8px 0 !important;
    }
  }

  @media (min-width: 1024px) {
    .cart-totals--standalone {
      max-width: min(1200px, 66vw) !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }
  }
  
  /* 動畫效果 */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .cart-totals--standalone {
    animation: fadeInUp 0.6s ease-out !important;
    animation-delay: 0.1s !important;
    animation-fill-mode: both !important;
  }
  
  /* 移除發光效果 */
  .cart-totals--standalone:hover {
    box-shadow: none !important;
  }

  /* =========================================================
     APGO theme overlay (2026-05) — same dark-card + orange-accent
     language used on the PDP and cart items list above.

     Single outer card holds the breakdown + estimated total. They're
     separated by a 2px orange divider that highlights the total section.
     ========================================================= */
  /* Outer card */
  .cart-totals--standalone .cart__total-container {
    position: relative !important;
    background: rgba(255, 255, 255, 0.025) !important;
    border: 1px solid rgba(255, 255, 255, 0.07) !important;
    border-radius: 14px !important;
    padding: 0 !important;
    overflow: hidden !important;
    margin: 0 !important;
  }
  /* Orange accent bar across the top — matches the free-shipping card above.
     `display: block` re-enables the pseudo (an earlier rule in this same
     stylesheet sets `display: none !important` on the same selector). */
  .cart-totals--standalone .cart__total-container::before {
    content: '' !important;
    display: block !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    height: 3px !important;
    background: linear-gradient(90deg, #f08418, #ff9a3c) !important;
    z-index: 2 !important;
  }

  /* Breakdown rows (subtotal / shipping goal / discount) — tightened */
  .cart-totals--standalone .cart-totals__breakdown {
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    padding: 12px 16px 4px !important;
    margin: 0 !important;
  }
  .cart-totals--standalone .cart-totals__breakdown .cart__summary-item {
    padding: 4px 0 !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06) !important;
  }
  .cart-totals--standalone .cart-totals__breakdown .cart__summary-item:last-child {
    border-bottom: 0 !important;
  }
  .cart-totals--standalone .cart__label {
    color: rgba(255, 255, 255, 0.7) !important;
    font-weight: 500 !important;
  }
  .cart-totals--standalone .cart__value {
    color: rgba(255, 255, 255, 0.95) !important;
    font-weight: 600 !important;
  }

  /* Estimated total — same card, no divider between breakdown and total */
  .cart-totals--standalone .cart-totals__estimated-card {
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    padding: 6px 16px 14px !important;
    position: relative !important;
    overflow: visible !important;
  }
  .cart-totals--standalone .cart-totals__estimated-card::before {
    display: none !important;
  }
  .cart-totals--standalone .cart-totals__estimated-title,
  .cart-totals--standalone .cart-totals__estimated-price {
    color: #f08418 !important;
    -webkit-text-fill-color: #f08418 !important;
  }

  /* Cart-totals actions row (note + discount) — soft card */
  .cart-totals--standalone .cart-totals__actions {
    background: rgba(255, 255, 255, 0.025) !important;
    border: 1px solid rgba(255, 255, 255, 0.07) !important;
    border-radius: 14px !important;
    padding: 14px 16px !important;
    margin: 0 0 14px 0 !important;
  }

  /* =========================================================
     Shopee/Taobao-style accordion order summary
     Used on BOTH mobile and desktop — replaces the previous
     breakdown + estimated-card layout entirely. Desktop sizing
     is bumped slightly via @media min-width 750px below.
     (Class name kept as `--mobile` for backward compat; in
     reality it's rendered at every breakpoint now.)
     ========================================================= */

  /* Neutralize the legacy desktop card chrome — accordion is its own card */
  .cart-totals--standalone .cart-totals__breakdown,
  .cart-totals--standalone .cart-totals__estimated-card {
    display: none !important;
  }
  .cart-totals--standalone .cart__total-container {
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    overflow: visible !important;
  }
  .cart-totals--standalone .cart__total-container::before {
    display: none !important;
  }
  .cart-totals--standalone .cart-totals__actions {
    margin: 0 0 14px !important;
    padding: 14px 16px !important;
  }
  .cart-totals--standalone .cart__installments {
    margin-top: 10px !important;
    padding: 8px 14px 0 !important;
    border-top: 0 !important;
  }

  .cart-summary--mobile {
    display: block;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif;
    color: #fff;
  }
  .cart-summary--mobile::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, #f08418, #ff9a3c);
    z-index: 1;
  }

  .cart-summary__row { border-bottom: 1px solid rgba(255, 255, 255, 0.06); }
  .cart-summary__row[open] { background: rgba(255, 255, 255, 0.018); }
  .cart-summary__row:last-of-type { border-bottom: 0; }

  .cart-summary__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
    -webkit-tap-highlight-color: rgba(240, 132, 24, 0.2);
  }
  .cart-summary__head::-webkit-details-marker { display: none; }
  .cart-summary__head::marker { content: ''; }
  .cart-summary__head:hover { background: rgba(240, 132, 24, 0.04); }

  .cart-summary__label {
    font-size: 14px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
  }
  .cart-summary__right {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .cart-summary__value {
    font-size: 14px;
    font-weight: 600;
    color: #fff;
  }
  .cart-summary__value--neg { color: #ff8a3c; }
  .cart-summary__value--free { color: #34d399; font-weight: 700; }
  .cart-summary__chevron {
    display: inline-flex;
    width: 16px;
    height: 16px;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.55);
    transition: transform 0.22s ease;
  }
  .cart-summary__row[open] .cart-summary__chevron { transform: rotate(180deg); }

  .cart-summary__list {
    list-style: none;
    margin: 0;
    padding: 0 14px 12px;
  }
  .cart-summary__line {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 10px;
    padding: 6px 0;
    font-size: 12.5px;
    color: rgba(255, 255, 255, 0.72);
    border-top: 1px dashed rgba(255, 255, 255, 0.05);
  }
  .cart-summary__line:first-child { border-top: 0; }
  .cart-summary__line-title {
    flex: 1;
    min-width: 0;
    line-height: 1.4;
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px 6px;
  }
  .cart-summary__line-variant {
    color: rgba(255, 255, 255, 0.45);
    font-size: 11.5px;
  }
  .cart-summary__line-qty {
    color: rgba(255, 255, 255, 0.5);
    font-size: 11.5px;
    flex-shrink: 0;
  }
  .cart-summary__line-badge {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 999px;
    background: rgba(240, 132, 24, 0.18);
    color: #f08418;
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .cart-summary__line-amount {
    font-size: 12.5px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.88);
    white-space: nowrap;
    text-align: right;
  }
  .cart-summary__line-amount.cart-summary__value--neg { color: #ff8a3c; }

  .cart-summary__body {
    padding: 0 14px 12px;
  }
  .cart-summary__note {
    margin: 4px 0;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
  }
  .cart-summary__note--remaining {
    color: #f08418;
    font-weight: 600;
  }
  .cart-summary__note--tiny {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.45);
  }

  .cart-summary__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 14px 14px 6px;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background: #000;
  }
  .cart-summary__total-note {
    margin: 0;
    padding: 0 14px 12px;
    background: #000;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.45;
  }
  .cart-summary__label--total {
    font-size: 15px;
    font-weight: 700;
    color: #f08418;
    letter-spacing: 0.01em;
  }
  .cart-summary__value--total {
    font-size: 20px;
    font-weight: 800;
    color: #f08418;
    letter-spacing: 0.01em;
  }

  /* Desktop polish — slightly larger type & padding for a wider canvas */
  @media (min-width: 750px) {
    .cart-summary--mobile { border-radius: 16px; }
    .cart-summary__head { padding: 14px 18px; }
    .cart-summary__label { font-size: 15px; }
    .cart-summary__value { font-size: 15px; }
    .cart-summary__list,
    .cart-summary__body { padding-left: 18px; padding-right: 18px; padding-bottom: 14px; }
    .cart-summary__line { font-size: 13.5px; padding: 7px 0; }
    .cart-summary__line-amount { font-size: 13.5px; }
    .cart-summary__line-variant,
    .cart-summary__line-qty { font-size: 12.5px; }
    .cart-summary__line-badge { font-size: 11px; }
    .cart-summary__note { font-size: 13px; }
    .cart-summary__total { padding: 18px 18px 6px; }
    .cart-summary__label--total { font-size: 17px; }
    .cart-summary__value--total { font-size: 24px; }
    .cart-summary__total-note { padding: 0 18px 14px; font-size: 12px; }
  }
  {% endstylesheet %}
  
  {% javascript %}
  (function() {
    const wrapper = document.querySelector('[data-section-type="cart-totals"]');
    if (!wrapper) return;

    // 防止重複初始化
    const FLAG = wrapper.dataset.initFlag;
    if (window[FLAG]) return;
    window[FLAG] = true;

    const sid = wrapper.dataset.sectionId;
    const contentId = wrapper.dataset.contentId;

    // 小工具：每次都取最新的 content 容器
    const getContentEl = () => document.getElementById(contentId);

    // 去抖：把頻繁的事件合併
    let tmr;
    const debounce = (fn, delay = 180) => {
      clearTimeout(tmr);
      tmr = setTimeout(fn, delay);
    };

    // 用 routes.root 支援多語系/子路徑
    const root = (window.Shopify && Shopify.routes && Shopify.routes.root) ? Shopify.routes.root : '/';

    function htmlToNode(html) {
      const dom = new DOMParser().parseFromString(html, 'text/html');
      return dom.getElementById(contentId);
    }

    // 關鍵：每次都加 cache-buster + no-store。否則 /cart?sections=<id> 是固定
    // URL，瀏覽器會把第一次的回應快取起來，數量改變後 AJAX 仍拿到舊 HTML
    //（就是「必須硬刷新才更新」的根因）。/cart.js（免運條用的）本來就 no-cache
    // 所以一直是對的，但這個 section render 端點沒有，會被快取。
    const NO_STORE = { headers: { 'X-Requested-With': 'XMLHttpRequest' }, cache: 'no-store' };

    function refreshTotals() {
      // 先試新版 ?sections=
      const u1 = new URL(window.location.href);
      u1.pathname = root.replace(/\/$/, '') + u1.pathname.replace(root.replace(/\/$/, ''), '');
      u1.searchParams.set('sections', sid);
      u1.searchParams.set('_', Date.now());

      fetch(u1.toString(), NO_STORE)
        .then(r => r.ok ? r.json() : Promise.reject())
        .then(json => {
          const html = json && json[sid];
          if (!html) throw new Error('Sections JSON missing');
          const freshContent = htmlToNode(html);
          const contentEl = getContentEl();
          if (freshContent && contentEl) {
            contentEl.replaceWith(freshContent);
          }
        })
        .catch(() => {
          // 舊法 fallback: ?section_id=
          const u2 = new URL(window.location.href);
          u2.pathname = root.replace(/\/$/, '') + u2.pathname.replace(root.replace(/\/$/, ''), '');
          u2.searchParams.set('section_id', sid);
          u2.searchParams.set('_', Date.now());

          fetch(u2.toString(), NO_STORE)
            .then(r => r.text())
            .then(html => {
              const freshContent = htmlToNode(html);
              const contentEl = getContentEl();
              if (freshContent && contentEl) {
                contentEl.replaceWith(freshContent);
              }
            })
            .catch(() => {
              console.error('Failed to refresh totals');
            });
        });
    }

    // —— 核心：直接從 /cart.js 改寫顯示金額 ——
    // 這是免運條（apgo-coating-products）一直正確的原因：它不靠 section 重渲染，
    // 直接讀 /cart.js（永遠新鮮）自己畫數字。cart-totals 之前靠 ?sections= 重抓
    // HTML，那條路脆弱（被快取、跟 Horizon 搶、自己觸發自己），所以小計卡住。
    // 現在 cart-totals 也改成直接從 /cart.js 改寫，section 重渲染只負責折扣明細列。

    // 市場別貨幣符號（SGD → S$、MYR → RM），與 apgo-coating-products 一致，
    // 順手修掉「小計顯示 $ 而免運條顯示 S$」的不一致。
    function fmtMoney(minor, currency) {
      const amount = (Number(minor) || 0) / 100;
      const fixed = amount.toLocaleString('en', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (currency === 'MYR') return `RM ${fixed}`;
      if (currency === 'SGD') return `S$ ${fixed}`;
      try {
        return new Intl.NumberFormat('en', { style: 'currency', currency, currencyDisplay: 'narrowSymbol' }).format(amount);
      } catch (_) {
        return `${currency} ${fixed}`;
      }
    }

    // Flat shipping estimate — must mirror Liquid SSR + sections/cart-cta.liquid
    function shippingEstimateMinor(cart) {
      if (!cart) return 0;
      // Tag-unlock: any line in cart whose product_id matches the
      // free-shipping lookup zeroes shipping regardless of subtotal.
      const lookup = window.APGO_FREE_SHIPPING_LINE_LOOKUP || {};
      if (Array.isArray(cart.items)) {
        for (const line of cart.items) {
          if (lookup[line.product_id]) return 0;
        }
      }
      const ccy = cart.currency;
      const basis = (typeof window.apgoCartFreeShippingBasis === 'function')
        ? window.apgoCartFreeShippingBasis(cart)
        : Number(cart.total_price || 0);
      if (ccy === 'MYR') return basis >= 15500 ? 0 : 290;
      if (ccy === 'SGD') return basis >= 7000 ? 0 : 290;
      return 0;
    }
    // Exposed so cart-cta sticky bar can compute the same estimated total.
    window.apgoEstimatedShippingMinor = shippingEstimateMinor;

    function patchFromCart(cart) {
      if (!cart) return;
      const ccy = cart.currency;
      const ship = shippingEstimateMinor(cart);
      const estimatedTotal = Number(cart.total_price || 0) + ship;

      const subEl = document.querySelector('#' + contentId + ' .cart__original-total .cart__value');
      const totEl = document.querySelector('#' + contentId + ' [data-cart-subtotal]');
      if (subEl) subEl.textContent = fmtMoney(cart.original_total_price, ccy);
      if (totEl) {
        const t = fmtMoney(estimatedTotal, ccy);
        totEl.textContent = t;
        totEl.setAttribute('value', t);
      }

      // Mobile accordion fast-patch (full re-render arrives via ?sections= later).
      const mobileSub = document.querySelector('#' + contentId + ' [data-summary-subtotal]');
      const mobileDis = document.querySelector('#' + contentId + ' [data-summary-discount]');
      const mobileShip = document.querySelector('#' + contentId + ' [data-summary-shipping]');
      const mobileTot = document.querySelector('#' + contentId + ' [data-summary-total]');
      if (mobileSub) mobileSub.textContent = fmtMoney(cart.original_total_price, ccy);
      if (mobileDis) {
        const dis = Number(cart.total_discount || 0);
        mobileDis.textContent = dis > 0 ? '-' + fmtMoney(dis, ccy) : fmtMoney(0, ccy);
      }
      if (mobileShip) {
        if (ship === 0) {
          mobileShip.textContent = mobileShip.getAttribute('data-free-label') || 'FREE';
          mobileShip.classList.add('cart-summary__value--free');
        } else {
          mobileShip.textContent = '~' + fmtMoney(ship, ccy);
          mobileShip.classList.remove('cart-summary__value--free');
        }
      }
      if (mobileTot) mobileTot.textContent = fmtMoney(estimatedTotal, ccy);
    }

    function patchFromCartJs() {
      return fetch('/cart.js?_=' + Date.now(), { headers: { Accept: 'application/json' }, cache: 'no-store' })
        .then(r => r.json())
        .then(patchFromCart)
        .catch(() => {});
    }

    // Mobile accordion now lives inside this section, so we always refresh
    // the section HTML to rebuild the per-item / per-discount lists.
    let refreshTotalsTimer;
    function scheduleRefreshTotals() {
      clearTimeout(refreshTotalsTimer);
      refreshTotalsTimer = setTimeout(refreshTotals, 350);
    }

    // 有 event 內 cart 就同步改數字；section 重渲染僅桌面、且去抖避免連打
    function updateAll(eventCart) {
      if (eventCart && eventCart.items) {
        patchFromCart(eventCart);
      } else {
        patchFromCartJs();
      }
      scheduleRefreshTotals();
    }

    function cartFromEvent(ev) {
      if (!ev || !ev.detail) return null;
      return ev.detail.resource
        || (ev.detail.data && ev.detail.data.cart)
        || ev.detail.cart
        || null;
    }

    let lastEventAt = 0;
    document.addEventListener('cart:update', () => { lastEventAt = Date.now(); });
    document.addEventListener('cart:updated', () => { lastEventAt = Date.now(); });

    // —— A: 事件 —— //
    [
      'cart:update','cart:updated','cart:change','cart:refresh',
      'quantity:change','quantity-selector:update',
      'product:added','cart:item:added','cart:item:updated','cart:item:removed'
    ].forEach(evt => document.addEventListener(evt, (ev) => debounce(() => updateAll(cartFromEvent(ev)), 120)));

    // —— A2: 直接觀察 cart-items-component 的 DOM 變動（最可靠的「qty 改了」訊號）——
    function attachCartItemsObserver() {
      const cartItemsEl = document.querySelector('cart-items-component');
      if (!cartItemsEl || cartItemsEl.__cartTotalsObserved) return;
      cartItemsEl.__cartTotalsObserved = true;
      new MutationObserver(() => {
        if (Date.now() - lastEventAt < 900) return;
        debounce(() => updateAll(null), 150);
      }).observe(cartItemsEl, { childList: true, subtree: true, characterData: true });
    }
    attachCartItemsObserver();
    new MutationObserver(attachCartItemsObserver)
      .observe(document.body, { childList: true, subtree: true });

    // —— B: 攔截 cart 寫入請求。只比對「寫入」端點，避免 refreshTotals 自己的
    // /cart?sections= 與 /cart.js 又觸發自己造成無限迴圈。 ——
    // fetch 攔截僅作兜底（無 cart:update 事件的舊路徑）；事件路徑已帶 resource 可略過重複 /cart.js
    const isCartWrite = (u) => /\/cart\/(change|add|update|clear)(\.js)?(\?|$)/.test(String(u || ''));
    const _fetch = window.fetch;
    window.fetch = function(...args){
      return _fetch.apply(this, args).then(res => {
        try {
          if (isCartWrite(args[0]) && Date.now() - lastEventAt > 400) {
            debounce(() => updateAll(null), 150);
          }
        } catch(e){}
        return res;
      });
    };

    // 初始化先跑一次
    document.addEventListener('DOMContentLoaded', updateAll);
    updateAll();
  })();
  {% endjavascript %}
  
  {% schema %}
  {
    "name": "Cart Totals (Standalone)",
    "settings": [
      { "type": "checkbox", "id": "show_note_or_code", "label": "Show cart note / discount code (uses theme settings)", "default": true },
      { "type": "checkbox", "id": "show_order_breakdown", "label": "Show breakdown (subtotal, discounts, SG ship) above total", "default": true },
      { "type": "checkbox", "id": "show_installments", "label": "Show installments (uses theme settings)", "default": true },
      { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-3" },
      { "type": "header", "content": "手機運費估算 (Shipping estimate)" },
      { "type": "paragraph", "content": "用於手機購物車明細的 Shipping 行；達免運門檻顯示 FREE，否則顯示此固定金額。Sticky 結帳列上的 Estimated total 也會加上此運費。" },
      { "type": "number", "id": "flat_shipping_my_cents", "label": "MY 固定運費 (cents — 290 = RM 2.90)", "default": 290 },
      { "type": "number", "id": "flat_shipping_sg_cents", "label": "SG 固定運費 (cents — 290 = S$ 2.90)", "default": 290 }
    ],
    "blocks": [],
    "presets": [{ "name": "Cart Totals (Standalone)"}]
  }
  {% endschema %}