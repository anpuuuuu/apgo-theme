{%- comment -%} Cart Totals (standalone section) {%- endcomment -%}
<div
  id="CartTotals-{{ section.id }}"
  class="cart-totals cart-totals--standalone color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="cart-totals"
  data-content-id="CartTotalsContent-{{ section.id }}"
  data-init-flag="__cartTotalsInit_{{ section.id }}"
>
  <!-- 👉 只替換這個內容區，外層 wrapper 不動 -->
  <div id="CartTotalsContent-{{ section.id }}">
    {%- liquid
      assign market_threshold_minor = 0
      assign is_sg_market = false
      assign is_my_market = false
      if localization.country.iso_code == 'SG'
        assign is_sg_market = true
        assign market_threshold_minor = 5500
      elsif localization.country.iso_code == 'MY'
        assign is_my_market = true
        assign market_threshold_minor = 9900
      endif

      assign discount_total_minor = cart.total_discount
      assign remaining_for_free_shipping_minor = 0
      assign free_shipping_remaining_formatted = remaining_for_free_shipping_minor | money
      assign free_shipping_unlocked = false
      if market_threshold_minor > 0
        if cart.original_total_price >= market_threshold_minor
          assign free_shipping_unlocked = true
        else
          assign remaining_for_free_shipping_minor = market_threshold_minor | minus: cart.original_total_price
          assign free_shipping_remaining_formatted = remaining_for_free_shipping_minor | money
        endif
      endif
      assign final_total_with_shipping_minor = cart.total_price
      # Standalone estimated row: symbol only (e.g. RM…) — strip trailing
      # currency iso code (… MYR / … SGD) when the shop's money format includes it.
      assign total_price_formatted = final_total_with_shipping_minor | money | replace: cart.currency.iso_code, '' | strip
      assign free_shipping_remaining_formatted = free_shipping_remaining_formatted | replace: cart.currency.iso_code, '' | strip
    -%}

    {%- if section.settings.show_note_or_code -%}
      {%- if settings.show_cart_note or settings.show_add_discount_code -%}
        <div class="cart-totals__actions">
          {%- if settings.show_cart_note -%}
            {% render 'cart-note' %}
          {%- endif -%}
          {%- if settings.show_add_discount_code -%}
            {% render 'cart-discount', section_id: section.id %}
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}

    <div class="cart__total-container">
      {%- comment -%}
        明細（小計／免運／折扣）：可於區塊設定關閉。金額幣別隨 Shopify Markets 的 cart.currency（如 MYR、SGD）。
      {%- endcomment -%}
      {%- if section.settings.show_order_breakdown -%}
        <div class="cart-totals__breakdown">
          <div class="cart__summary-item cart__original-total">
            <span class="cart__label">{{ 'content.cart_subtotal' | t }}</span>
            <span class="cart__value">{{ cart.original_total_price | money | replace: cart.currency.iso_code, '' | strip }}</span>
          </div>

          {% if is_sg_market or is_my_market %}
            <div class="cart__summary-item cart__shipping-goal">
              <span class="cart__label">{{ 'apgo_cart.free_shipping_goal_label' | t }}</span>
              <span class="cart__value">
                {%- if free_shipping_unlocked -%}
                  {{- 'apgo_cart.free_shipping_unlocked' | t -}}
                {%- else -%}
                  {{- 'apgo_cart.free_shipping_remaining' | t: amount: free_shipping_remaining_formatted -}}
                {%- endif -%}
              </span>
            </div>
          {% endif %}

          {% if discount_total_minor > 0 %}
            <div class="cart__summary-item cart__discount-total">
              <span class="cart__label">{{ 'content.discount' | t }}</span>
              <span class="cart__value">-{{ discount_total_minor | money | replace: cart.currency.iso_code, '' | strip }}</span>
            </div>
          {% endif %}

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="cart__summary-item cart__discount">
                <span class="cart__label">
                  {{- 'icon-discount.svg' | inline_asset_content -}}
                  {{ discount.title | escape }}
                </span>
                <span class="cart__value">-{{ discount.total_allocated_amount | money | replace: cart.currency.iso_code, '' | strip }}</span>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} 第二張圖風格：黑底、標題＋金額同列；稅務說明緊接在 Estimated total 列下方 {%- endcomment -%}
      <div class="cart-totals__estimated-card" role="status">
        <div class="cart-totals__estimated-card-row">
          <div class="cart-totals__estimated-card-left">
            <p class="cart-totals__estimated-title">{{ 'content.cart_estimated_total' | t }}</p>
          </div>
          <text-component
            ref="cartTotalStandalone"
            value="{{ total_price_formatted | strip_html }}"
            class="cart-totals__estimated-price"
            data-cart-subtotal
          >
            {{ total_price_formatted }}
          </text-component>
        </div>
        <div class="cart-totals__estimated-tax">
          {% render 'tax-info', has_discounts_enabled: settings.show_add_discount_code %}
        </div>
      </div>

      {%- if section.settings.show_installments and settings.show_installments -%}
        <div class="cart__summary-item cart__installments">
          {% form 'cart', cart %}{{ form | payment_terms }}{% endform %}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
  
  {% stylesheet %}
  /* ========================================
     購物車總計區塊樣式設計 - 僅針對獨立區塊
     ======================================== */
  
  /* 主容器樣式 - 使用特定類別避免衝突 */
  .cart-totals--standalone { 
    --apgo-cart-inline-space: clamp(12px, 2.2vw, 28px);
    display: flex; 
    flex-direction: column; 
    gap: var(--gap-md); 
    background: transparent !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    border: none !important;
    padding: 0 var(--apgo-cart-inline-space) !important;
    margin: 20px 0 !important;
    max-width: none !important;
    width: 100% !important;
    position: relative !important;
    z-index: 1 !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif !important;
    color: #ffffff !important;
  }
  
  /* 移除橘色頂部線條 */
  .cart-totals--standalone::before {
    display: none !important;
  }
  
  /* 每一條就是左右兩側 */
  .cart-totals--standalone .cart__summary-item {
    display: flex !important;
    justify-content: space-between !important; /* 左右兩端對齊 */
    align-items: center !important;
    padding: 8px 0 !important;
    font-size: 14px !important;
    border: none !important; /* 預設不要底線 */
  }

  /* 小計 */
  .cart-totals--standalone .cart__original-total .cart__label {
    color: #ccc !important;
  }
  .cart-totals--standalone .cart__original-total .cart__value {
    color: #fff !important;
    font-weight: 600 !important;
  }

  /* 折扣 */
  .cart-totals--standalone .cart__discount .cart__label {
    display: flex !important;               /* 讓 icon 與文字在同一行 */
    align-items: center !important;
    gap: 4px !important;                    /* icon 與文字的距離 */
    color: #ff6b35 !important;
    font-weight: 500 !important;
  }
  .cart-totals--standalone .cart__discount .cart__value {
    color: #ff6b35 !important;
    font-weight: 500 !important;
  }
  
  /* 操作區塊 */
  .cart-totals--standalone .cart-totals__actions {
    display: flex !important;
    flex-direction: column !important;
    gap: var(--gap-2xs) !important;
    border-top: 1px solid #333333 !important;
    border-bottom: 1px solid #333333 !important;
    padding: 20px 0 !important;
    margin: 0 0 24px 0 !important;
  }
  
  /* 外層容器：不強制大色塊，由下方卡片承擔主視覺 */
  .cart-totals--standalone .cart__total-container {
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    padding: 0 !important;
    position: relative !important;
    overflow: visible !important;
    margin: 0 0 24px 0 !important;
  }

  .cart-totals--standalone .cart__total-container::before {
    display: none !important;
  }

  /* 上方明細（小計／折扣／免運） */
  .cart-totals--standalone .cart-totals__breakdown {
    margin-bottom: 14px !important;
    padding-bottom: 4px !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12) !important;
  }

  .cart-totals--standalone .cart-totals__breakdown .cart__summary-item {
    padding: 6px 0 !important;
  }

  /* 第二張圖：黑底預估總計卡 */
  .cart-totals--standalone .cart-totals__estimated-card {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 10px !important;
    background: #000000 !important;
    border-radius: 10px !important;
    padding: clamp(16px, 3vw, 22px) !important;
  }

  .cart-totals--standalone .cart-totals__estimated-card-row {
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: space-between !important;
    align-items: baseline !important;
    gap: 12px 20px !important;
    width: 100% !important;
  }

  .cart-totals--standalone .cart-totals__estimated-card-left {
    flex: 1 1 200px !important;
    min-width: 0 !important;
  }

  .cart-totals--standalone .cart-totals__estimated-tax {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    font-size: 12px !important;
    line-height: 1.45 !important;
    color: #b0b0b0 !important;
  }

  .cart-totals--standalone .cart-totals__estimated-tax small {
    color: inherit !important;
  }

  .cart-totals--standalone .cart-totals__estimated-tax a {
    color: #d0d0d0 !important;
    text-decoration: underline !important;
  }

  .cart-totals--standalone .cart-totals__estimated-title {
    margin: 0 !important;
    font-size: clamp(1.35rem, 4.2vw, 1.85rem) !important;
    font-weight: 700 !important;
    line-height: 1.15 !important;
    color: #f7931e !important;
  }

  .cart-totals--standalone .cart-totals__estimated-price {
    flex: 0 0 auto !important;
    margin-left: auto !important;
    text-align: right !important;
    font-size: clamp(1.35rem, 4.2vw, 1.85rem) !important;
    font-weight: 700 !important;
    line-height: 1.15 !important;
    color: #f7931e !important;
    -webkit-text-fill-color: #f7931e !important;
  }

  /* 分期付款（稅務說明已併入 estimated 卡內） */
  .cart-totals--standalone .cart__installments {
    font-size: 12px !important;
    color: #aaa !important;
    padding-top: 10px !important;
    border: none !important;
  }

  /* 響應式設計 */
  @media (max-width: 768px) {
    .cart-totals--standalone {
      margin: 12px 0 !important;
      border-radius: 0 !important;
      padding: 0 var(--apgo-cart-inline-space) !important;
      width: 100% !important;
      max-width: none !important;
    }
    
  }
  
  @media (max-width: 480px) {
    .cart-totals--standalone {
      padding: 0 var(--apgo-cart-inline-space) !important;
      margin: 8px 0 !important;
    }
  }

  @media (min-width: 1024px) {
    .cart-totals--standalone {
      max-width: min(1200px, 66vw) !important;
      margin-left: auto !important;
      margin-right: auto !important;
    }
  }
  
  /* 動畫效果 */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .cart-totals--standalone {
    animation: fadeInUp 0.6s ease-out !important;
    animation-delay: 0.1s !important;
    animation-fill-mode: both !important;
  }
  
  /* 移除發光效果 */
  .cart-totals--standalone:hover {
    box-shadow: none !important;
  }

  /* =========================================================
     APGO theme overlay (2026-05) — same dark-card + orange-accent
     language used on the PDP and cart items list above.

     Single outer card holds the breakdown + estimated total. They're
     separated by a 2px orange divider that highlights the total section.
     ========================================================= */
  /* Outer card */
  .cart-totals--standalone .cart__total-container {
    position: relative !important;
    background: rgba(255, 255, 255, 0.025) !important;
    border: 1px solid rgba(255, 255, 255, 0.07) !important;
    border-radius: 14px !important;
    padding: 0 !important;
    overflow: hidden !important;
    margin: 0 !important;
  }
  /* Orange accent bar across the top — matches the free-shipping card above.
     `display: block` re-enables the pseudo (an earlier rule in this same
     stylesheet sets `display: none !important` on the same selector). */
  .cart-totals--standalone .cart__total-container::before {
    content: '' !important;
    display: block !important;
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    height: 3px !important;
    background: linear-gradient(90deg, #f08418, #ff9a3c) !important;
    z-index: 2 !important;
  }

  /* Breakdown rows (subtotal / shipping goal / discount) — tightened */
  .cart-totals--standalone .cart-totals__breakdown {
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    padding: 12px 16px 4px !important;
    margin: 0 !important;
  }
  .cart-totals--standalone .cart-totals__breakdown .cart__summary-item {
    padding: 4px 0 !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06) !important;
  }
  .cart-totals--standalone .cart-totals__breakdown .cart__summary-item:last-child {
    border-bottom: 0 !important;
  }
  .cart-totals--standalone .cart__label {
    color: rgba(255, 255, 255, 0.7) !important;
    font-weight: 500 !important;
  }
  .cart-totals--standalone .cart__value {
    color: rgba(255, 255, 255, 0.95) !important;
    font-weight: 600 !important;
  }

  /* Estimated total — same card, no divider between breakdown and total */
  .cart-totals--standalone .cart-totals__estimated-card {
    background: transparent !important;
    border: 0 !important;
    border-radius: 0 !important;
    padding: 6px 16px 14px !important;
    position: relative !important;
    overflow: visible !important;
  }
  .cart-totals--standalone .cart-totals__estimated-card::before {
    display: none !important;
  }
  .cart-totals--standalone .cart-totals__estimated-title,
  .cart-totals--standalone .cart-totals__estimated-price {
    color: #f08418 !important;
    -webkit-text-fill-color: #f08418 !important;
  }

  /* Cart-totals actions row (note + discount) — soft card */
  .cart-totals--standalone .cart-totals__actions {
    background: rgba(255, 255, 255, 0.025) !important;
    border: 1px solid rgba(255, 255, 255, 0.07) !important;
    border-radius: 14px !important;
    padding: 14px 16px !important;
    margin: 0 0 14px 0 !important;
  }

  /* Edge alignment with cart items + free-shipping bar above */
  @media (max-width: 749px) {
    .cart-totals--standalone {
      padding-inline: 0 !important;
    }
  }
  {% endstylesheet %}
  
  {% javascript %}
  (function() {
    const wrapper = document.querySelector('[data-section-type="cart-totals"]');
    if (!wrapper) return;

    // 防止重複初始化
    const FLAG = wrapper.dataset.initFlag;
    if (window[FLAG]) return;
    window[FLAG] = true;

    const sid = wrapper.dataset.sectionId;
    const contentId = wrapper.dataset.contentId;

    // #region agent log
    var __dbg = function(hyp, msg, data){
      try { fetch('http://127.0.0.1:7664/ingest/6d6da4c4-6868-481c-8830-6f610c9dd71e',{method:'POST',headers:{'Content-Type':'application/json','X-Debug-Session-Id':'0c453c'},body:JSON.stringify({sessionId:'0c453c',runId:'init',hypothesisId:hyp,location:'cart-totals.liquid:'+msg,message:msg,data:data||{},timestamp:Date.now()})}).catch(function(){}); } catch(e){}
    };
    __dbg('H1','init',{sid:sid,contentId:contentId,sectionCount:document.querySelectorAll('[data-section-type="cart-totals"]').length});
    // #endregion

    // 小工具：每次都取最新的 content 容器
    const getContentEl = () => document.getElementById(contentId);

    // 去抖：把頻繁的事件合併
    let tmr;
    const debounce = (fn, delay = 180) => {
      clearTimeout(tmr);
      tmr = setTimeout(fn, delay);
    };

    // 用 routes.root 支援多語系/子路徑
    const root = (window.Shopify && Shopify.routes && Shopify.routes.root) ? Shopify.routes.root : '/';

    function htmlToNode(html) {
      const dom = new DOMParser().parseFromString(html, 'text/html');
      return dom.getElementById(contentId);
    }

    // 關鍵：每次都加 cache-buster + no-store。否則 /cart?sections=<id> 是固定
    // URL，瀏覽器會把第一次的回應快取起來，數量改變後 AJAX 仍拿到舊 HTML
    //（就是「必須硬刷新才更新」的根因）。/cart.js（免運條用的）本來就 no-cache
    // 所以一直是對的，但這個 section render 端點沒有，會被快取。
    const NO_STORE = { headers: { 'X-Requested-With': 'XMLHttpRequest' }, cache: 'no-store' };

    function refreshTotals() {
      // 先試新版 ?sections=
      const u1 = new URL(window.location.href);
      u1.pathname = root.replace(/\/$/, '') + u1.pathname.replace(root.replace(/\/$/, ''), '');
      u1.searchParams.set('sections', sid);
      u1.searchParams.set('_', Date.now());

      fetch(u1.toString(), NO_STORE)
        .then(r => r.ok ? r.json() : Promise.reject())
        .then(json => {
          const html = json && json[sid];
          if (!html) throw new Error('Sections JSON missing');
          const freshContent = htmlToNode(html);
          const contentEl = getContentEl();
          // #region agent log
          var freshSub = freshContent ? freshContent.querySelector('.cart__original-total .cart__value') : null;
          var freshTot = freshContent ? freshContent.querySelector('[data-cart-subtotal]') : null;
          __dbg('H3','refreshTotals_landed',{
            htmlLen: (html||'').length,
            freshSubText: freshSub ? freshSub.textContent.trim() : null,
            freshTotText: freshTot ? freshTot.textContent.trim() : null,
            domSubBeforeReplace: contentEl && contentEl.querySelector('.cart__original-total .cart__value') ? contentEl.querySelector('.cart__original-total .cart__value').textContent.trim() : null,
            domTotBeforeReplace: contentEl && contentEl.querySelector('[data-cart-subtotal]') ? contentEl.querySelector('[data-cart-subtotal]').textContent.trim() : null
          });
          // #endregion
          if (freshContent && contentEl) {
            contentEl.replaceWith(freshContent);
          }
        })
        .catch(() => {
          // 舊法 fallback: ?section_id=
          const u2 = new URL(window.location.href);
          u2.pathname = root.replace(/\/$/, '') + u2.pathname.replace(root.replace(/\/$/, ''), '');
          u2.searchParams.set('section_id', sid);
          u2.searchParams.set('_', Date.now());

          fetch(u2.toString(), NO_STORE)
            .then(r => r.text())
            .then(html => {
              const freshContent = htmlToNode(html);
              const contentEl = getContentEl();
              if (freshContent && contentEl) {
                contentEl.replaceWith(freshContent);
              }
            })
            .catch(() => {
              console.error('Failed to refresh totals');
            });
        });
    }

    // —— 核心：直接從 /cart.js 改寫顯示金額 ——
    // 這是免運條（apgo-coating-products）一直正確的原因：它不靠 section 重渲染，
    // 直接讀 /cart.js（永遠新鮮）自己畫數字。cart-totals 之前靠 ?sections= 重抓
    // HTML，那條路脆弱（被快取、跟 Horizon 搶、自己觸發自己），所以小計卡住。
    // 現在 cart-totals 也改成直接從 /cart.js 改寫，section 重渲染只負責折扣明細列。

    // 市場別貨幣符號（SGD → S$、MYR → RM），與 apgo-coating-products 一致，
    // 順手修掉「小計顯示 $ 而免運條顯示 S$」的不一致。
    function fmtMoney(minor, currency) {
      const amount = (Number(minor) || 0) / 100;
      const fixed = amount.toLocaleString('en', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      if (currency === 'MYR') return `RM ${fixed}`;
      if (currency === 'SGD') return `S$ ${fixed}`;
      try {
        return new Intl.NumberFormat('en', { style: 'currency', currency, currencyDisplay: 'narrowSymbol' }).format(amount);
      } catch (_) {
        return `${currency} ${fixed}`;
      }
    }

    function patchFromCartJs(tag) {
      return fetch('/cart.js?_=' + Date.now(), { headers: { Accept: 'application/json' }, cache: 'no-store' })
        .then(r => r.json())
        .then(cart => {
          const ccy = cart.currency;
          const subEl = document.querySelector('#' + contentId + ' .cart__original-total .cart__value');
          const totEl = document.querySelector('#' + contentId + ' [data-cart-subtotal]');
          // #region agent log
          __dbg('H2','patchFromCartJs',{
            tag: tag||'',
            item_count: cart.item_count,
            qty0: cart.items && cart.items[0] && cart.items[0].quantity,
            original_total_price: cart.original_total_price,
            total_price: cart.total_price,
            subElFound: !!subEl,
            totElFound: !!totEl,
            subElBefore: subEl ? subEl.textContent.trim() : null,
            totElBefore: totEl ? totEl.textContent.trim() : null
          });
          // #endregion
          if (subEl) subEl.textContent = fmtMoney(cart.original_total_price, ccy);
          if (totEl) {
            const t = fmtMoney(cart.total_price, ccy);
            totEl.textContent = t;
            totEl.setAttribute('value', t);
          }
          // #region agent log
          __dbg('H4','patch_after',{
            tag: tag||'',
            subElAfter: subEl ? subEl.textContent.trim() : null,
            totElAfter: totEl ? totEl.textContent.trim() : null
          });
          // #endregion
        })
        .catch(() => {});
    }

    // updateAll：先即時改數字（權威來源 /cart.js），再重渲染 section 補折扣列，
    // section 落地後再 patch 一次，確保不會被舊渲染蓋回去。
    function updateAll(reason) {
      // #region agent log
      __dbg('H1','updateAll_called',{reason: reason||'?'});
      // #endregion
      patchFromCartJs('immediate');
      refreshTotals();
      setTimeout(function(){ patchFromCartJs('after450'); }, 450);
    }

    // —— A: 事件 —— //
    [
      'cart:update','cart:updated','cart:change','cart:refresh',
      'quantity:change','quantity-selector:update',
      'product:added','cart:item:added','cart:item:updated','cart:item:removed'
    ].forEach(evt => document.addEventListener(evt, () => { /* #region agent log */ __dbg('H1','event_'+evt,{}); /* #endregion */ debounce(() => updateAll('evt:'+evt), 200); }));

    // —— A2: 直接觀察 cart-items-component 的 DOM 變動（最可靠的「qty 改了」訊號）——
    function attachCartItemsObserver() {
      const cartItemsEl = document.querySelector('cart-items-component');
      if (!cartItemsEl || cartItemsEl.__cartTotalsObserved) return;
      cartItemsEl.__cartTotalsObserved = true;
      // #region agent log
      __dbg('H1','observer_attached',{tag:'cart-items-component'});
      // #endregion
      new MutationObserver(() => { /* #region agent log */ __dbg('H1','mutation_fired',{}); /* #endregion */ debounce(() => updateAll('mutation'), 200); })
        .observe(cartItemsEl, { childList: true, subtree: true, characterData: true });
    }
    attachCartItemsObserver();
    new MutationObserver(attachCartItemsObserver)
      .observe(document.body, { childList: true, subtree: true });

    // —— B: 攔截 cart 寫入請求。只比對「寫入」端點，避免 refreshTotals 自己的
    // /cart?sections= 與 /cart.js 又觸發自己造成無限迴圈。 ——
    const isCartWrite = (u) => /\/cart\/(change|add|update|clear)(\.js)?(\?|$)/.test(String(u || ''));
    const _fetch = window.fetch;
    window.fetch = function(...args){
      return _fetch.apply(this, args).then(res => {
        try {
          if (isCartWrite(args[0])) {
            // #region agent log
            __dbg('H1','fetch_intercept',{url:String(args[0]).slice(0,200), status:res && res.status});
            // #endregion
            debounce(() => updateAll('fetchIntercept'), 200);
          }
        } catch(e){}
        return res;
      });
    };
    const _open = XMLHttpRequest.prototype.open;
    XMLHttpRequest.prototype.open = function(m, u, ...rest) {
      this.addEventListener('load', function(){
        try {
          if (isCartWrite(u)) {
            // #region agent log
            __dbg('H1','xhr_intercept',{url:String(u).slice(0,200)});
            // #endregion
            debounce(() => updateAll('xhrIntercept'), 200);
          }
        } catch(e){}
      });
      return _open.apply(this, [m, u, ...rest]);
    };

    // 初始化先跑一次
    document.addEventListener('DOMContentLoaded', updateAll);
    updateAll();
  })();
  {% endjavascript %}
  
