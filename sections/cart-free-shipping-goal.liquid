{% comment %}
  Cart free shipping goal section: MY (West Malaysia MYR 155) / SG (SGD 70)

  Tag override: any cart line whose product carries the 'free-shipping'
  tag unlocks the whole order. UI fills the progress bar to 100% and
  swaps the remaining-amount copy for "🎁 You got free shipping with X".
{% endcomment %}

{%- capture apgo_fs_title -%}{%- render 'apgo-cart-free-shipping-product-title' -%}{%- endcapture -%}
{%- assign apgo_fs_title = apgo_fs_title | strip -%}
{%- assign apgo_fs_unlocked = false -%}
{%- if apgo_fs_title != blank -%}
  {%- assign apgo_fs_unlocked = true -%}
{%- endif -%}

<section class="cart-free-shipping-goal" data-free-shipping-goal data-country="{{ localization.country.iso_code | escape }}">
  <div class="cart-free-shipping-goal__inner">
    <h3 class="cart-free-shipping-goal__title">{{ section.settings.title | default: 'Free shipping progress' }}</h3>
    <div class="cart-free-shipping-goal__bar-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{% if apgo_fs_unlocked %}100{% else %}0{% endif %}">
      <div class="cart-free-shipping-goal__bar-fill" data-goal-fill {% if apgo_fs_unlocked %}style="width: 100%"{% endif %}></div>
    </div>
    <div class="cart-free-shipping-goal__amounts"{% if apgo_fs_unlocked %} hidden{% endif %}>
      <span data-goal-current>--</span>
      <span data-goal-target>--</span>
    </div>
    <p class="cart-free-shipping-goal__message" data-goal-message>
      {%- if apgo_fs_unlocked -%}🎁 You got free shipping with {{ apgo_fs_title }}{%- endif -%}
    </p>
  </div>
</section>

{%- render 'apgo-cart-free-shipping-lookup' -%}

<style>
  .cart-free-shipping-goal {
    width: 100%;
    margin: 18px auto 0;
    padding: 0 20px;
  }

  .cart-free-shipping-goal__inner {
    background: #0f0f0f;
    border: 1px solid #3a3a3a;
    border-radius: 20px;
    padding: 18px 20px;
  }

  .cart-free-shipping-goal__title {
    margin: 0 0 12px;
    color: #f3f4f6;
    font-size: 1.05rem;
    font-weight: 700;
  }

  .cart-free-shipping-goal__bar-track {
    width: 100%;
    height: 10px;
    background: #2f2f2f;
    border-radius: 999px;
    overflow: hidden;
  }

  .cart-free-shipping-goal__bar-fill {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #f08418, #ff9a3c);
    transition: width 0.35s ease;
  }

  .cart-free-shipping-goal__amounts {
    margin-top: 8px;
    display: flex;
    justify-content: space-between;
    color: #d1d5db;
    font-size: 0.92rem;
  }

  .cart-free-shipping-goal__message {
    margin: 10px 0 0;
    color: #f3f4f6;
    font-size: 0.95rem;
    font-weight: 600;
  }

  @media screen and (width < 750px) {
    .cart-free-shipping-goal {
      padding: 0 12px;
    }

    .cart-free-shipping-goal__inner {
      border-radius: 16px;
      padding: 14px 14px;
    }
  }
</style>

<script>
  (() => {
    const root = document.querySelector('[data-free-shipping-goal]');
    if (!root) return;
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const fill = root.querySelector('[data-goal-fill]');
    const msg = root.querySelector('[data-goal-message]');
    const current = root.querySelector('[data-goal-current]');
    const target = root.querySelector('[data-goal-target]');
    const bar = root.querySelector('.cart-free-shipping-goal__bar-track');
    const country = (root.dataset.country || '').toUpperCase();

    const getRule = (iso) => {
      if (iso === 'MY') return { thresholdMinor: 15500, currency: 'MYR' };
      if (iso === 'SG') return { thresholdMinor: 7000,  currency: 'SGD' };
      return null;
    };

    const formatMoney = (minor, currency) =>
      new Intl.NumberFormat(document.documentElement.lang || 'en', { style: 'currency', currency }).format((minor || 0) / 100);

    /* Find a tag-unlocked product in the live cart. Uses the
       per-section global APGO_FREE_SHIPPING_LINE_LOOKUP (populated by
       the Liquid <script> at the top of this section). Returns the
       title to surface in the "🎁 You got free shipping with X"
       message, or null if no qualifying line is present. */
    const findTagUnlock = (cart) => {
      const lookup = window.APGO_FREE_SHIPPING_LINE_LOOKUP || {};
      if (!cart || !Array.isArray(cart.items)) return null;
      for (const line of cart.items) {
        const title = lookup[line.product_id];
        if (title) return title;
      }
      return null;
    };

    const render = (subtotalMinor, cart) => {
      const rule = getRule(country);
      if (!rule) {
        root.style.display = 'none';
        return;
      }

      root.style.display = '';

      /* Tag-unlock wins regardless of subtotal — show 100% bar + the
         "You got free shipping with X" copy. The amounts row is
         hidden because the threshold no longer applies. */
      const tagTitle = findTagUnlock(cart);
      const amountsRow = root.querySelector('.cart-free-shipping-goal__amounts');
      if (tagTitle) {
        fill.style.width = '100%';
        bar?.setAttribute('aria-valuenow', '100');
        if (amountsRow) amountsRow.setAttribute('hidden', '');
        msg.textContent = `🎁 You got free shipping with ${tagTitle}`;
        return;
      }
      if (amountsRow) amountsRow.removeAttribute('hidden');

      const progress = Math.min((subtotalMinor / rule.thresholdMinor) * 100, 100);
      const remaining = Math.max(rule.thresholdMinor - subtotalMinor, 0);

      fill.style.width = `${progress}%`;
      bar?.setAttribute('aria-valuenow', String(Math.round(progress)));
      current.textContent = formatMoney(subtotalMinor, rule.currency);
      target.textContent = formatMoney(rule.thresholdMinor, rule.currency);

      if (remaining <= 0) {
        msg.textContent = `{{ 'apgo_cart.free_shipping_unlocked' | t | escape }}`;
      } else {
        const amount = formatMoney(remaining, rule.currency);
        const text = `{{ 'apgo_cart.free_shipping_remaining' | t: amount: '__AMOUNT__' | escape }}`;
        msg.textContent = text.replace('__AMOUNT__', amount);
      }
    };

    const refresh = async () => {
      try {
        const res = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
        const cart = await res.json();
        const subtotalMinor = window.apgoCartFreeShippingBasis
          ? window.apgoCartFreeShippingBasis(cart)
          : Number(cart?.total_price || 0);
        render(subtotalMinor, cart);
      } catch (_) {}
    };

    ['cart:refresh', 'cart:updated', 'cart:update', 'cart:change', 'product:added', 'ajaxProduct:added'].forEach((eventName) => {
      document.addEventListener(eventName, refresh, { passive: true });
    });

    refresh();
  })();
</script>

{% schema %}
{
  "name": "Cart Free Shipping Goal",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Free shipping progress"
    }
  ],
  "presets": [
    {
      "name": "Cart Free Shipping Goal"
    }
  ]
}
{% endschema %}
