{%- comment -%}
  Global sticky marquee. Loaded from layout/theme.liquid via {% section 'free-shipping-popup' %}（設定在 config/settings_data.json → current.sections）。
  編輯：自訂主題 →「佈景設定 / Theme settings」→ 找到 Marquee／跑馬燈（schema name t:names.marquee）。
  Omits DOM when no MY/SG promo and no blocks (storefront); design mode still shows for editing.
{%- endcomment -%}

{% liquid
  assign show_market_promo = false
  assign market_promo_key = ''
  assign market_promo_flag = ''
  if section.settings.show_mysg_discount_promo
    if localization.country.iso_code == 'SG'
      assign show_market_promo = true
      assign market_promo_key = 'apgo_promotions.sg_free_shipping_banner'
      assign market_promo_flag = 'sg'
    elsif localization.country.iso_code == 'MY'
      assign show_market_promo = true
      assign market_promo_key = 'apgo_promotions.my_free_shipping_banner'
      assign market_promo_flag = 'my'
    endif
  endif

  # 顯示：MY/SG 促銷、或有掛 blocks、或編輯器
  assign marquee_has_content = show_market_promo
  if section.blocks.size > 0
    assign marquee_has_content = true
  endif
  unless marquee_has_content
    for block in section.blocks
      if block.disabled
        continue
      endif
      case block.type
        when 'text'
          assign marquee_text_stripped = block.settings.text | strip_html | strip
          if marquee_text_stripped != blank
            assign marquee_has_content = true
          endif
        when 'icon'
          if block.settings.image_upload != blank or block.settings.icon != 'none'
            assign marquee_has_content = true
          endif
        when 'logo'
          assign marquee_has_content = true
        when '_divider'
          assign marquee_has_content = true
      endcase
      if marquee_has_content
        break
      endif
    endfor
  endunless

  assign marquee_should_render = false
  if marquee_has_content or request.design_mode
    assign marquee_should_render = true
  endif
%}

{% if marquee_should_render %}
<script
  src="{{ 'marquee.js' | asset_url }}"
  type="module"
></script>

{% assign gap_between_elements = section.settings.gap_between_elements %}

{% comment %} sticky：緊貼在 #header-group 整體下方（與 critical.js 變數一致） {% endcomment %}
<div class="marquee__sticky-wrap">
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<marquee-component
  class="section spacing-style gap-style color-{{ section.settings.color_scheme }}"
  style="
    {%- render 'spacing-style', settings: section.settings %};
    {% render 'gap-style', value: gap_between_elements, name: 'marquee-gap' %}
    --marquee-direction: {{ section.settings.movement_direction }};
  "
  data-speed-factor="20"
  data-movement-direction="{{ section.settings.movement_direction }}"
>
  <div
    class="marquee__wrapper"
    ref="wrapper"
  >
    <div
      class="marquee__content"
      ref="content"
    >
      <div class="marquee__repeated-items">
        {% if show_market_promo %}
          <p class="marquee__promo-item">
            <span class="marquee__promo-flag" aria-hidden="true">
              {%- if market_promo_flag == 'my' -%}
                <svg viewBox="0 0 64 32" role="img" focusable="false" xmlns="http://www.w3.org/2000/svg">
                  <g class="my-flag-stripes">
                    <rect y="0" width="64" height="2.29" fill="#C00"></rect>
                    <rect y="2.29" width="64" height="2.29" fill="#fff"></rect>
                    <rect y="4.57" width="64" height="2.29" fill="#C00"></rect>
                    <rect y="6.86" width="64" height="2.29" fill="#fff"></rect>
                    <rect y="9.15" width="64" height="2.29" fill="#C00"></rect>
                    <rect y="11.44" width="64" height="2.29" fill="#fff"></rect>
                    <rect y="13.72" width="64" height="2.28" fill="#C00"></rect>
                    <rect y="16" width="64" height="2.29" fill="#fff"></rect>
                    <rect y="18.29" width="64" height="2.29" fill="#C00"></rect>
                    <rect y="20.58" width="64" height="2.28" fill="#fff"></rect>
                    <rect y="22.86" width="64" height="2.29" fill="#C00"></rect>
                    <rect y="25.15" width="64" height="2.28" fill="#fff"></rect>
                    <rect y="27.43" width="64" height="2.28" fill="#C00"></rect>
                    <rect y="29.71" width="64" height="2.3" fill="#fff"></rect>
                  </g>
                  <rect x="0" y="0" width="32" height="16" fill="#010066"></rect>
                  <g fill="#FFCC00" transform="translate(8,3)">
                    <circle r="1.2" fill="#FFCC00"></circle>
                    <circle cx="0.45" r="0.9" fill="#010066"></circle>
                    <polygon points="2.1,-0.25 2.3,0.35 2.9,0.35 2.4,0.7 2.6,1.3 2.1,0.95 1.6,1.3 1.8,0.7 1.3,0.35 1.9,0.35" transform="translate(3.2,0)"></polygon>
                  </g>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 64 48" role="img" focusable="false">
                  <rect width="64" height="24" fill="#EF3340"></rect>
                  <rect y="24" width="64" height="24" fill="#FFFFFF"></rect>
                  <circle cx="18" cy="13" r="8" fill="#FFFFFF"></circle>
                  <circle cx="21" cy="13" r="6.5" fill="#EF3340"></circle>
                  <g fill="#FFFFFF" transform="translate(27 7)">
                    <polygon points="2.5,0 3.2,1.8 5.1,1.8 3.6,2.9 4.2,4.8 2.5,3.6 0.8,4.8 1.4,2.9 0,1.8 1.8,1.8"></polygon>
                    <polygon points="8.5,2.3 9.2,4.1 11.1,4.1 9.6,5.2 10.2,7.1 8.5,5.9 6.8,7.1 7.4,5.2 6,4.1 7.8,4.1"></polygon>
                    <polygon points="8.5,8.8 9.2,10.6 11.1,10.6 9.6,11.7 10.2,13.6 8.5,12.4 6.8,13.6 7.4,11.7 6,10.6 7.8,10.6"></polygon>
                    <polygon points="2.5,11.1 3.2,12.9 5.1,12.9 3.6,14 4.2,15.9 2.5,14.7 0.8,15.9 1.4,14 0,12.9 1.8,12.9"></polygon>
                    <polygon points="14.5,5.6 15.2,7.4 17.1,7.4 15.6,8.5 16.2,10.4 14.5,9.2 12.8,10.4 13.4,8.5 12,7.4 13.8,7.4"></polygon>
                  </g>
                </svg>
              {%- endif -%}
            </span>
            {{ market_promo_key | t }}
          </p>
        {% endif %}
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</marquee-component>
</div>
{% endif %}

{% stylesheet %}
  /* theme.liquid 的 overflow-x:clip 可能影響 sticky 參考層 */
  html:has(#shopify-section-free-shipping-popup),
  html:has(#shopify-section-free-shipping-popup) body {
    overflow-x: visible !important;
  }

  /*
    直接讓 Shopify 自動產生的 section 外殼 (#shopify-section-free-shipping-popup) 本身吸頂。
    原本 sticky 放在內層 .marquee__sticky-wrap，但它的包含塊正是外殼，而外殼高度等於
    .marquee__sticky-wrap 本身 → sticky 沒有任何可停留的捲動範圍，視覺上就不吸頂。
    把 sticky 上移到外殼，其包含塊就是 <body>，整頁都能吸頂。ID 選擇器 (0,1,0,0)
    勝過 base.css 的 .shopify-section:not(...):has(...) (0,0,4,0)，不必擔心 position:relative 衝突。
  */
  #shopify-section-free-shipping-popup {
    position: -webkit-sticky;
    position: sticky;
    /*
      critical.js 的 calculateHeaderGroupHeight() 會加總 #header-group 底下所有 shopify-section
      的高度（主 header shell + 次選單 shell；次選單非 /collections/all 時 display:none → offsetHeight=0），
      因此單獨用 --header-group-height 就能讓跑馬燈精準吸在「整個 header-group 之下」。
      之前同時加 --header-height 等於重複計算主 header，導致偏移錯誤。

      再減 1px：主 header sticky 時使用 top:-1px（header.liquid 為了讓 IntersectionObserver 追蹤 sticky 狀態），
      可視底部實際落在 viewport y = 主 header 高度 - 1。/collections/all 有 ::before 30px 填縫遮住這 1px，
      其他頁沒有次選單也就沒這塊填縫，會露出 1px 縫。扣掉這 1px 正好貼齊；在 all 頁則是跑馬燈與次選單黑底
      重疊 1px，肉眼看不見。
    */
    top: calc(var(--header-group-height, 100px) - 1px + env(safe-area-inset-top, 0px));
    z-index: calc(var(--layer-sticky, 8) - 1);
    width: 100%;
    background: var(--color-background);
    box-shadow: 0 1px 0 rgba(from var(--color-foreground) r g b / 0.08);
  }

  .marquee__sticky-wrap {
    /* 內層保留為純版面容器；外殼已經吸頂，這裡不再重複 sticky 以免產生巢狀 sticky 問題 */
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    /* 跑馬燈上下多留 5px 呼吸空間 */
    padding-block: 5px;
  }

  /* 段落預設 margin 會讓跑馬燈條看起來上下留白 */
  .marquee__sticky-wrap .marquee__content :is(p, h1, h2, h3, h4, h5, h6) {
    margin-block: 0;
  }

  marquee-component {
    display: block;
    width: 100%;
    overflow: hidden;
  }

  .marquee__wrapper {
    display: flex;
    gap: var(--marquee-gap);
    width: fit-content;
    white-space: nowrap;
  }

  .marquee__content {
    min-width: max-content;
    display: flex;
    gap: var(--marquee-gap);
  }

  .marquee__content :is(p, h1, h2, h3, h4, h5, h6) {
    white-space: nowrap;
  }

  .marquee__content .marquee__repeated-items * {
    max-width: none;
  }

  .marquee__repeated-items {
    min-width: max-content;
    display: flex;
    gap: var(--marquee-gap);
    align-items: center;
    justify-content: center;
  }

  .marquee__repeated-items > * {
    align-content: center;
  }

  .marquee__promo-item {
    margin: 0;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #fff;
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }

  .marquee__promo-flag {
    width: 1.25em;
    height: 0.95em;
    display: inline-flex;
    align-items: center;
  }

  .marquee__promo-flag svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    marquee-component:not([data-disabled]) .marquee__wrapper {
      animation: marquee-motion var(--marquee-speed) linear infinite var(--marquee-direction);
    }
  }

  @keyframes marquee-motion {
    to {
      transform: translate3d(calc(-50% - (var(--marquee-gap) / 2)), 0, 0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.marquee",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "logo"
    },
    {
      "type": "_divider"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "movement_direction",
      "label": "t:settings.motion_direction",
      "options": [
        {
          "value": "reverse",
          "label": "t:options.forward"
        },
        {
          "value": "normal",
          "label": "t:options.reverse"
        }
      ],
      "default": "normal"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap_between_elements",
      "label": "t:settings.gap",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "show_mysg_discount_promo",
      "label": "Show MY/SG promotion in marquee",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:names.marquee_section",
      "category": "t:categories.banners",
      "blocks": {
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>We make things that work better and last longer.</p>",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "var(--font-size--h2)",
            "line_height": "tight",
            "letter_spacing": "tight",
            "case": "none",
            "wrap": "nowrap",
            "width": "fit-content"
          }
        }
      },
      "block_order": ["text"]
    }
  ]
}
{% endschema %}
