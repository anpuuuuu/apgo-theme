{%- comment -%}
  Clearance page — "Last truck leaves in" countdown on kraft tiles, with
  the end date printed underneath. Renders nothing until an end time is
  set, and hides itself once that time has passed. Styled in
  assets/apgo-clearance-page.css, which only the page.clearance-sale
  template loads. The markup lives in snippets/apgo-crate-countdown.
{%- endcomment -%}

{% render 'apgo-crate-countdown',
  end_at: section.settings.end_at,
  label: section.settings.label,
  show_end_date: section.settings.show_end_date,
  end_prefix: section.settings.end_prefix,
  contained: true,
  editor_hint: true
%}

{% schema %}
{
  "name": "Clearance countdown",
  "tag": "section",
  "class": "apgo-crate-section",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Last truck leaves in"
    },
    {
      "type": "text",
      "id": "end_at",
      "label": "Sale ends at (GMT+8)",
      "info": "Format: YYYY-MM-DDTHH:MM:SS+08:00, e.g. 2026-10-31T23:59:00+08:00. The countdown stays hidden until this is set and hides itself when the time is up."
    },
    {
      "type": "checkbox",
      "id": "show_end_date",
      "label": "Print the end date under the countdown",
      "default": true
    },
    {
      "type": "text",
      "id": "end_prefix",
      "label": "Text before the end date",
      "default": "Sale ends"
    }
  ],
  "presets": [
    {
      "name": "Clearance countdown",
      "category": "APGO"
    }
  ]
}
{% endschema %}
