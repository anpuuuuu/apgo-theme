{% comment %}
  APGO Home — product rail (2026-09 homepage redesign). One section type,
  used twice on the page: "Best Value Picks" (current deals, discount
  badges) and "Best Sellers" (no corner badge). Products come from one
  collection, in the collection's order; products locked to the other
  market (custom.only_market) are skipped, and positions are counted after
  that skip so ranks stay 1, 2, 3…

  Arrows sit on the row's left and right edges, level with the photos.
  Phones: a swipe rail showing ~2.5 cards with small outline-free arrows,
  then one full-width button. Desktop: the row stays inside the
  two-thirds column, four cards at a time. Arrows hide when every card
  already fits.

  Optional featured deal (v2): the product picked as "Featured deal" is
  drawn as one large card above the row (and left out of the row). It only
  shows while that product is in the collection and sold in the visitor's
  market, so its contents chips never end up on another product. Singapore
  fields left empty mean "same as Malaysia" (product, ribbon, line, chips).
  One exception: with a different Singapore product and no Singapore chips,
  the card shows no chips rather than the Malaysian product's contents.
{% endcomment %}

{%- liquid
  assign rail_collection = section.settings.collection
  assign rail_market = localization.country.iso_code
  assign rail_limit = section.settings.max_products
  assign rail_anchor = section.settings.anchor_id | strip | handleize
  assign rail_list_name = section.settings.heading | default: section.settings.eyebrow
  assign rail_list_id = 'home_' | append: rail_list_name | handleize | replace: '-', '_'
  assign rail_desktop = section.settings.desktop_layout
  assign rail_featured_pick = section.settings.featured_product
  assign rail_featured_label = section.settings.featured_label
  assign rail_featured_note = section.settings.featured_note
  assign rail_featured_contents = section.settings.featured_contents
  if rail_market == 'SG'
    if section.settings.featured_product_sg != blank
      assign rail_featured_pick = section.settings.featured_product_sg
    endif
    if section.settings.featured_label_sg != blank
      assign rail_featured_label = section.settings.featured_label_sg
    endif
    if section.settings.featured_note_sg != blank
      assign rail_featured_note = section.settings.featured_note_sg
    endif
    if section.settings.featured_contents_sg != blank
      assign rail_featured_contents = section.settings.featured_contents_sg
    elsif section.settings.featured_product_sg != blank and section.settings.featured_product_sg.id != section.settings.featured_product.id
      assign rail_featured_contents = ''
    endif
  endif

  capture rail_featured
    if rail_collection != blank and rail_featured_pick != blank
      for product in rail_collection.products limit: 50
        if product.id != rail_featured_pick.id
          continue
        endif
        assign rail_pm = product.metafields.custom.only_market.value | strip | upcase
        if rail_pm != blank and rail_market != rail_pm
          break
        endif
        render 'apgo-home-rail-card', product: product, position: 1, layout: 'deal', label: rail_featured_label, note: rail_featured_note, contents: rail_featured_contents, sticker: section.settings.featured_sticker
        break
      endfor
    endif
  endcapture
  assign rail_featured = rail_featured | strip
  assign rail_skip_id = 0
  assign rail_count = 0
  if rail_featured != blank
    assign rail_skip_id = rail_featured_pick.id
    assign rail_count = 1
  endif

  capture rail_items
    assign rail_shown = 0
    if rail_collection != blank
      for product in rail_collection.products limit: 50
        if product.id == rail_skip_id
          continue
        endif
        assign rail_pm = product.metafields.custom.only_market.value | strip | upcase
        if rail_pm != blank and rail_market != rail_pm
          continue
        endif
        assign rail_count = rail_count | plus: 1
        assign rail_shown = rail_shown | plus: 1
        echo '<li class="apgo-home-rail__slide">'
        render 'apgo-home-rail-card', product: product, position: rail_count, badge_style: section.settings.badge_style
        echo '</li>'
        if rail_shown >= rail_limit
          break
        endif
      endfor
    endif
  endcapture
-%}

{%- if rail_count > 0 or request.design_mode -%}
  <script src="{{ 'apgo-campaign-tracking.js' | asset_url }}" defer></script>
  <section
    {% if rail_anchor != blank %}id="{{ rail_anchor }}"{% endif %}
    class="apgo-home apgo-home-rail apgo-home-rail--{{ rail_desktop }} apgo-home-rail--rows-{{ section.settings.desktop_rows }}{% if section.settings.background == 'dark' %} apgo-home--dark{% endif %}"
    data-apgo-home-section="rail"
    data-apgo-home-init="rail"
    data-apgo-home-list
    data-list-id="{{ rail_list_id }}"
    data-list-name="{{ rail_list_name | escape }}"
  >
    {%- if section.settings.ghost_text != blank -%}
      <span class="apgo-home-rail__ghost" aria-hidden="true">{{ section.settings.ghost_text | escape }}</span>
    {%- endif -%}
    <div class="apgo-hp__container">
      <header class="apgo-hp-head">
        <div class="apgo-hp-head__text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="apgo-hp-head__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 class="apgo-hp-head__title">{{ section.settings.heading | escape }}</h2>
        </div>
        <div class="apgo-hp-head__side">
          {%- if section.settings.link_label != blank and section.settings.link != blank -%}
            <a class="apgo-hp-head__link" href="{{ section.settings.link }}">
              <span class="apgo-hp-head__link-mobile">{{ section.settings.link_label | escape }}</span>
              <span class="apgo-hp-head__link-desktop">
                {{- section.settings.link_label_desktop | default: section.settings.link_label | escape -}}
                {%- render 'apgo-home-icon', name: 'arrow-right', size: 16, stroke: 2 -%}
              </span>
            </a>
          {%- endif -%}
        </div>
      </header>
    </div>

    {%- if rail_featured != blank -%}
      <div class="apgo-hp__container apgo-home-rail__featured">
        {{ rail_featured }}
      </div>
    {%- endif -%}

    {%- if rail_shown > 0 -%}
      <div class="apgo-home-rail__viewport">
        {%- if rail_shown > 1 -%}
          <button
            type="button"
            class="apgo-home-rail__arrow apgo-home-rail__arrow--prev"
            data-apgo-rail-prev
            aria-label="Previous products"
            disabled
          >
            {%- render 'apgo-home-icon', name: 'chevron-left', size: 20, stroke: 2 -%}
          </button>
        {%- endif -%}
        <ul class="apgo-home-rail__track" data-apgo-rail-track role="list">
          {{ rail_items }}
        </ul>
        {%- if rail_shown > 1 -%}
          <button
            type="button"
            class="apgo-home-rail__arrow apgo-home-rail__arrow--next"
            data-apgo-rail-next
            aria-label="Next products"
          >
            {%- render 'apgo-home-icon', name: 'chevron-right', size: 20, stroke: 2 -%}
          </button>
        {%- endif -%}
      </div>
    {%- elsif rail_featured == blank -%}
      <div class="apgo-hp__container">
        <p class="apgo-home-rail__empty">Pick a collection with products for this row.</p>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="apgo-hp__container apgo-home-rail__footer">
        <a
          class="apgo-hp-button apgo-hp-button--{{ section.settings.button_style }}"
          href="{{ section.settings.button_link }}"
        >
          {{- section.settings.button_label | escape -}}
          {%- render 'apgo-home-icon', name: 'arrow-right', size: 16, stroke: 2 -%}
        </a>
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "APGO Home — Product row",
  "tag": "div",
  "class": "apgo-home-rail-wrapper",
  "enabled_on": {
    "templates": ["index", "page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Current deals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Value Picks"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets buttons jump here, e.g. \"deals\" for a #deals link."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products show in the collection's order. Products only sold in the other market are hidden automatically."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "badge_style",
      "label": "Corner badge",
      "options": [
        { "value": "discount", "label": "Discount (e.g. -30%)" },
        { "value": "rank", "label": "Rank (#1, #2…)" },
        { "value": "none", "label": "None" }
      ],
      "default": "discount"
    },
    {
      "type": "select",
      "id": "desktop_layout",
      "label": "Desktop layout",
      "options": [
        { "value": "grid", "label": "Grid, 4 per row" },
        { "value": "carousel", "label": "Carousel with arrows" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "desktop_rows",
      "label": "Desktop grid rows",
      "options": [
        { "value": "1", "label": "1 row (4 products)" },
        { "value": "2", "label": "2 rows (8 products)" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "black", "label": "Black" },
        { "value": "dark", "label": "Dark grey" }
      ],
      "default": "black"
    },
    {
      "type": "text",
      "id": "ghost_text",
      "label": "Large outline word behind the heading",
      "info": "Decoration, e.g. DEALS or TOP 8. Leave empty for none."
    },
    {
      "type": "header",
      "content": "Featured deal (large card)"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured deal product",
      "info": "Must be in the collection above. Shows as one large card above the row, only where it is sold (e.g. hidden in Singapore if not sold there)."
    },
    {
      "type": "text",
      "id": "featured_label",
      "label": "Ribbon",
      "default": "Deal of the week"
    },
    {
      "type": "text",
      "id": "featured_note",
      "label": "Line above the title",
      "default": "Limited time only · while stocks last"
    },
    {
      "type": "text",
      "id": "featured_contents",
      "label": "What's inside",
      "info": "Separate items with commas, e.g. 1 Crystal, 2 Refills, 4 Shampoos, 2 Coating Cloths"
    },
    {
      "type": "checkbox",
      "id": "featured_sticker",
      "label": "Show discount sticker on the photo",
      "info": "Round \"-80% OFF\" sticker. Leave off when the photo already shows the discount.",
      "default": false
    },
    {
      "type": "header",
      "content": "Featured deal for Singapore (optional)"
    },
    {
      "type": "product",
      "id": "featured_product_sg",
      "label": "Singapore featured product",
      "info": "Empty: same as Malaysia (shown in Singapore only if it is sold there). A product picked here must also be in the collection above."
    },
    {
      "type": "text",
      "id": "featured_label_sg",
      "label": "Singapore ribbon",
      "info": "Empty: same as Malaysia."
    },
    {
      "type": "text",
      "id": "featured_note_sg",
      "label": "Singapore line above the title",
      "info": "Empty: same as Malaysia."
    },
    {
      "type": "text",
      "id": "featured_contents_sg",
      "label": "Singapore what's inside",
      "info": "Separated by commas. Empty: same as Malaysia; but if you picked a different Singapore product above, empty means no chips."
    },
    {
      "type": "header",
      "content": "Header link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Label on phones",
      "default": "View all"
    },
    {
      "type": "text",
      "id": "link_label_desktop",
      "label": "Label on desktop",
      "default": "View all deals"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Button under the row (phones)"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Label",
      "default": "See all deals"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Style",
      "options": [
        { "value": "solid", "label": "Orange" },
        { "value": "outline", "label": "Outline" }
      ],
      "default": "solid"
    }
  ],
  "presets": [
    {
      "name": "APGO Home — Product row",
      "category": "APGO"
    }
  ]
}
{% endschema %}
