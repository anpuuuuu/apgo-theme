{% comment %}
  APGO Home — Hero (rebuild of legacy "Homepage S1 Eng" + "S2 Eng" merged).
  Poster image paints first (LCP), brand video lazy-loads after window load
  and fades in on top (skipped for prefers-reduced-motion / Save-Data).
{% endcomment %}

{{ 'apgo-home.css' | asset_url | stylesheet_tag }}

{% liquid
  assign hero_video_src = ''
  if section.settings.video != blank
    for source in section.settings.video.sources
      if source.format == 'mp4'
        assign hero_video_src = source.url
        break
      endif
    endfor
    if hero_video_src == blank and section.settings.video.sources.size > 0
      assign hero_video_src = section.settings.video.sources.first.url
    endif
  endif
  if hero_video_src == blank
    assign hero_video_src = section.settings.video_url
  endif

  assign cta_url = section.settings.cta_link | default: '/collections/atomic-coating-series'
%}

<section
  id="apgo-home-hero-{{ section.id }}"
  class="apgo-home apgo-home-hero color-{{ section.settings.color_scheme }}"
  data-apgo-home-section="hero"
  data-apgo-home-init="reveal herovideo"
>
  <div class="apgo-home-hero__stage">
    <div class="apgo-home-hero__media" aria-hidden="true">
      {% if section.settings.poster_image != blank %}
        <img
          class="apgo-home-hero__poster"
          src="{{ section.settings.poster_image | image_url: width: 1100 }}"
          srcset="
            {{ section.settings.poster_image | image_url: width: 750 }} 750w,
            {{ section.settings.poster_image | image_url: width: 1100 }} 1100w,
            {{ section.settings.poster_image | image_url: width: 1600 }} 1600w,
            {{ section.settings.poster_image | image_url: width: 2200 }} 2200w
          "
          sizes="100vw"
          width="{{ section.settings.poster_image.width }}"
          height="{{ section.settings.poster_image.height }}"
          alt=""
          loading="eager"
          fetchpriority="high"
        >
      {% endif %}
      {% if hero_video_src != blank %}
        <video
          class="apgo-home-hero__video"
          data-apgo-hero-video
          data-src="{{ hero_video_src }}"
          muted
          loop
          playsinline
          preload="none"
          tabindex="-1"
        ></video>
      {% endif %}
      <div class="apgo-home-hero__scrim"></div>
    </div>

    <div class="apgo-home-hero__content" data-apgo-reveal>
      {% if section.settings.eyebrow != blank %}
        <span class="apgo-home__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {% endif %}
      <h1 class="apgo-home-hero__heading">
        {{- section.settings.heading | escape }}
        {%- if section.settings.heading_accent != blank %}
          <span class="apgo-home__accent">{{ section.settings.heading_accent | escape }}</span>
        {%- endif %}
      </h1>
      {% if section.settings.subheading != blank %}
        <p class="apgo-home-hero__sub">{{ section.settings.subheading | escape }}</p>
      {% endif %}
      {% if section.settings.cta_label != blank %}
        <a class="apgo-home__cta" href="{{ cta_url }}">
          {{ section.settings.cta_label | escape }}
          <span class="apgo-home__cta-arrow" aria-hidden="true">&rarr;</span>
        </a>
      {% endif %}
    </div>

    {% if section.settings.show_scroll_hint %}
      <span class="apgo-home-hero__hint" aria-hidden="true"></span>
    {% endif %}
  </div>
</section>

<script src="{{ 'apgo-home.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "APGO Home — Hero",
  "tag": "section",
  "class": "apgo-home-hero-wrapper",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Poster image",
      "info": "Paints instantly (LCP) and stays as fallback while the video loads."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Background video URL (fallback)",
      "info": "Used when no video is picked above. MP4 URL.",
      "default": "https://cdn.shopify.com/videos/c/o/v/d8e8828223b342a3b6167dbdb1bda547.mp4"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "APGO — Professional Coating Experts"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We specialize in"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word (orange)",
      "default": "Coating"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Because it lasts far longer than waxing."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop Coating Now"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Show scroll hint",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-a27d2d12-7174-40fe-a01c-a128174b4c26"
    }
  ],
  "presets": [
    {
      "name": "APGO Home — Hero",
      "category": "APGO"
    }
  ]
}
{% endschema %}
