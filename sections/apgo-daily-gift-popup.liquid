{%- comment -%}
  APGO Daily Gift Popup — mobile-first floating mini-card.

  Used to surface a short-window gift promo (e.g. "Free shampoo with any
  order for the next 3 days"). Daily countdown resets at the configured
  HH:MM each day (default 23:59 Malaysia time).

  Behaviour:
  - Renders ONLY between `start_date` and `end_date` (admin-set).
  - 24h-loop countdown ticks every second, ends at HH:MM MY local time,
    then rolls over to the next day's HH:MM until promo `end_date` passes.
  - Customer can dismiss via X → localStorage flag keeps it hidden for
    the rest of that calendar day, comes back next morning.
  - Position: bottom-left of the viewport on mobile, scaled up slightly
    on desktop. z-index sits below the header marquee but above page
    content + chat widget.
{%- endcomment -%}

{%- if section.settings.enabled -%}

{%- assign start_str = section.settings.start_date | strip -%}
{%- assign end_str = section.settings.end_date | strip -%}
{%- assign end_time_str = section.settings.daily_end_time | default: '23:59' -%}

<aside
  class="apgo-daily-gift"
  data-apgo-daily-gift
  data-start="{{ start_str | escape }}"
  data-end="{{ end_str | escape }}"
  data-daily-end-time="{{ end_time_str | escape }}"
  data-tz-offset="+08:00"
  data-storage-key="apgo_gift_popup_{{ section.id }}"
  hidden
>
  <button type="button" class="apgo-daily-gift__close" data-apgo-daily-gift-close aria-label="Close">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>

  <div class="apgo-daily-gift__inner">
    {%- if section.settings.gift_image != blank -%}
      <img
        class="apgo-daily-gift__img"
        src="{{ section.settings.gift_image | image_url: width: 160 }}"
        alt=""
        loading="lazy"
        width="56"
        height="56"
      >
    {%- else -%}
      <span class="apgo-daily-gift__emoji" aria-hidden="true">🎁</span>
    {%- endif -%}

    <div class="apgo-daily-gift__body">
      <span class="apgo-daily-gift__badge">{{ section.settings.badge_text | default: 'LIMITED' }}</span>
      <p class="apgo-daily-gift__title">{{ section.settings.title | default: 'Free shampoo with every order' }}</p>
      {%- if section.settings.subtitle != blank -%}
        <p class="apgo-daily-gift__sub">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      <div class="apgo-daily-gift__timer-row">
        <span class="apgo-daily-gift__timer-label">{{ section.settings.timer_label | default: 'Ends in' }}</span>
        <span class="apgo-daily-gift__timer" data-apgo-daily-gift-timer>--:--:--</span>
      </div>
    </div>
  </div>
</aside>

{% stylesheet %}
  .apgo-daily-gift {
    position: fixed;
    left: 12px;
    bottom: 90px; /* above the mobile buybar */
    z-index: 90000;
    max-width: 280px;
    padding: 12px 14px;
    border-radius: 14px;
    background: rgba(15, 15, 15, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid rgba(240, 132, 24, 0.45);
    box-shadow:
      0 12px 32px rgba(0, 0, 0, 0.55),
      0 0 0 1px rgba(240, 132, 24, 0.15) inset;
    color: #fff;
    /* Slide-up enter animation */
    opacity: 0;
    transform: translateY(20px) scale(0.96);
    transition: opacity .35s cubic-bezier(.16,1,.3,1), transform .35s cubic-bezier(.16,1,.3,1);
    pointer-events: none;
  }
  .apgo-daily-gift[data-apgo-daily-gift][hidden] {
    display: none !important;
  }
  .apgo-daily-gift.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  /* Orange accent strip across the top */
  .apgo-daily-gift::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #f08418, #ff9a3c);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
  }

  .apgo-daily-gift__close {
    position: absolute;
    top: 4px;
    right: 4px;
    width: 22px;
    height: 22px;
    border: 0;
    padding: 0;
    border-radius: 4px;
    background: transparent;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .apgo-daily-gift__close:hover { color: #fff; }

  .apgo-daily-gift__inner {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .apgo-daily-gift__img,
  .apgo-daily-gift__emoji {
    flex: 0 0 auto;
    width: 56px;
    height: 56px;
    border-radius: 10px;
    object-fit: cover;
    background: rgba(255, 255, 255, 0.04);
    display: grid;
    place-items: center;
    font-size: 32px;
    line-height: 1;
  }
  .apgo-daily-gift__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .apgo-daily-gift__badge {
    align-self: flex-start;
    display: inline-block;
    padding: 1px 7px;
    border-radius: 999px;
    background: linear-gradient(45deg, #f08418, #ff9a3c);
    color: #fff;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 2px;
  }
  .apgo-daily-gift__title {
    margin: 0;
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    line-height: 1.3;
  }
  .apgo-daily-gift__sub {
    margin: 1px 0 0;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.3;
  }
  .apgo-daily-gift__timer-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-size: 11px;
  }
  .apgo-daily-gift__timer-label {
    color: rgba(255, 255, 255, 0.6);
  }
  .apgo-daily-gift__timer {
    font-weight: 700;
    color: #f08418;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  /* Desktop — sit slightly bigger and to the bottom-left of the viewport */
  @media (min-width: 750px) {
    .apgo-daily-gift {
      left: 24px;
      bottom: 24px;
      max-width: 320px;
      padding: 14px 16px;
    }
    .apgo-daily-gift__title { font-size: 14px; }
    .apgo-daily-gift__sub   { font-size: 12px; }
  }
{% endstylesheet %}

<script>
(function () {
  'use strict';
  var root = document.querySelector('[data-apgo-daily-gift]');
  if (!root) return;

  var startStr = root.getAttribute('data-start') || '';
  var endStr   = root.getAttribute('data-end')   || '';
  var dailyEnd = root.getAttribute('data-daily-end-time') || '23:59';
  var tz       = root.getAttribute('data-tz-offset') || '+08:00';
  var storageKey = root.getAttribute('data-storage-key');

  /* MY-local "today" YYYY-MM-DD */
  function myTodayStr() {
    var now = new Date(Date.now() + 8 * 3600 * 1000);
    return now.getUTCFullYear() + '-' +
           String(now.getUTCMonth() + 1).padStart(2, '0') + '-' +
           String(now.getUTCDate()).padStart(2, '0');
  }

  /* Don't render outside the promo window */
  var today = myTodayStr();
  if (startStr && today < startStr) { return; }
  if (endStr && today > endStr) { return; }

  /* Per-day dismiss flag — closed today? skip showing */
  try {
    if (storageKey && localStorage.getItem(storageKey) === today) return;
  } catch (_) {}

  var timerEl = root.querySelector('[data-apgo-daily-gift-timer]');
  var closeEl = root.querySelector('[data-apgo-daily-gift-close]');

  function endOfDayMs() {
    /* "today HH:MM MY +08:00" → ms. If past, push to tomorrow. */
    var iso = today + 'T' + dailyEnd + ':00' + tz;
    var t = Date.parse(iso);
    if (t <= Date.now()) {
      /* Add one day */
      t += 24 * 3600 * 1000;
    }
    return t;
  }
  var endMs = endOfDayMs();

  function pad(n) { return n < 10 ? '0' + n : '' + n; }
  function render() {
    var diff = endMs - Date.now();
    if (diff <= 0) {
      /* Past the deadline → recompute for next day (within promo window) */
      var nowToday = myTodayStr();
      if ((endStr && nowToday > endStr)) {
        root.remove();
        return false;
      }
      today = nowToday;
      endMs = endOfDayMs();
      diff = endMs - Date.now();
    }
    var h = Math.floor(diff / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    timerEl.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
    return true;
  }
  if (!render()) return;

  /* Show + tick */
  root.removeAttribute('hidden');
  /* Delay slightly so the page renders first */
  setTimeout(function () { root.classList.add('is-visible'); }, 400);
  setInterval(render, 1000);

  closeEl && closeEl.addEventListener('click', function () {
    root.classList.remove('is-visible');
    setTimeout(function () { root.setAttribute('hidden', ''); }, 350);
    try { if (storageKey) localStorage.setItem(storageKey, today); } catch (_) {}
  });
})();
</script>

{%- endif -%}

{% schema %}
{
  "name": "APGO Daily Gift Popup",
  "tag": "section",
  "class": "section-apgo-daily-gift",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "顯示彈窗",
      "default": true
    },
    {
      "type": "header",
      "content": "文字"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "頂部小徽章",
      "default": "LIMITED"
    },
    {
      "type": "text",
      "id": "title",
      "label": "標題",
      "default": "Free shampoo with every order"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "副標題 (optional)",
      "default": "3-day promo · Hari Raya special"
    },
    {
      "type": "text",
      "id": "timer_label",
      "label": "倒數標籤",
      "default": "Ends in"
    },
    {
      "type": "header",
      "content": "圖片"
    },
    {
      "type": "image_picker",
      "id": "gift_image",
      "label": "禮品圖片",
      "info": "留空則顯示 🎁 emoji"
    },
    {
      "type": "header",
      "content": "時間（馬來西亞 GMT+8）"
    },
    {
      "type": "text",
      "id": "start_date",
      "label": "促銷起始日（YYYY-MM-DD）",
      "info": "例：2026-05-22。今天以前不顯示。"
    },
    {
      "type": "text",
      "id": "end_date",
      "label": "促銷結束日（YYYY-MM-DD）",
      "info": "例：2026-05-24（含當日）。結束日之後不顯示。"
    },
    {
      "type": "text",
      "id": "daily_end_time",
      "label": "每日倒數結束時間（HH:MM）",
      "default": "23:59",
      "info": "每天倒數到這個時刻，過了再從下一天 00:00 重新計算。"
    }
  ],
  "presets": [
    {
      "name": "APGO Daily Gift Popup"
    }
  ]
}
{% endschema %}
