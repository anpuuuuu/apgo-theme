{% comment %}
  Checkout prefill (cart): contact + shipping address
  - Validates before checkout
  - Prefill query should use routes.cart_url + /checkout (cart checkout entry), not bare /checkout, or email/phone are often ignored.
{% endcomment %}

{%- liquid
  assign apgo_cart_checkout_url = routes.cart_url | append: '/checkout'
  assign default_country_code = localization.country.iso_code
  assign default_province = ''
  assign default_city = ''
  assign default_zip = ''
  assign default_address1 = ''
  assign default_full_name = ''
  assign default_email = ''
  assign default_phone = ''

  if customer
    assign default_email = customer.email
    assign default_phone = customer.phone | default: ''
    if customer.default_address.phone != blank and default_phone == blank
      assign default_phone = customer.default_address.phone
    endif
    capture default_full_name
      echo customer.first_name
      if customer.last_name != blank
        echo ' '
        echo customer.last_name
      endif
    endcapture
    assign default_full_name = default_full_name | strip
  endif

  if customer and customer.default_address
    if customer.default_address.country_code != blank
      assign default_country_code = customer.default_address.country_code
    endif
    assign default_province = customer.default_address.province
    assign default_city = customer.default_address.city
    assign default_zip = customer.default_address.zip
    assign default_address1 = customer.default_address.address1
  endif
-%}

<section
  class="apgo-shipping-address-section"
  data-apgo-shipping-address
  data-apgo-cart-checkout-url="{{ apgo_cart_checkout_url | escape }}"
>
  <div class="apgo-shipping-address__container">
    <div class="apgo-shipping-address__top-accent"></div>
    <div class="apgo-shipping-address__card">
      <header class="apgo-shipping-address__header">
        <h3 class="apgo-shipping-address__title">{{ 'apgo_cart.shipping_address_section_title' | t }}</h3>
        <p class="apgo-shipping-address__subtitle">{{ 'apgo_cart.shipping_address_section_subtitle' | t }}</p>
      </header>

      <div class="apgo-prefill-block">
        <h4 class="apgo-prefill-block__title">{{ 'apgo_cart.checkout_personal_section_title' | t }}</h4>
        <p class="apgo-prefill-block__subtitle">{{ 'apgo_cart.checkout_personal_section_subtitle' | t }}</p>
        <div class="apgo-shipping-address__form apgo-shipping-address__form--personal">
          <div class="apgo-shipping-address__field apgo-shipping-address__field--full">
            <label for="apgo-ship-fullname">{{ 'apgo_cart.full_name' | t }}</label>
            <input
              id="apgo-ship-fullname"
              type="text"
              value="{{ default_full_name | escape }}"
              data-apgo-fullname
              autocomplete="name"
              placeholder="{{ 'apgo_cart.placeholder_full_name' | t }}"
            >
          </div>
          <div class="apgo-shipping-address__field apgo-shipping-address__field--full">
            <label for="apgo-ship-email">{{ 'apgo_cart.email' | t }}</label>
            <input
              id="apgo-ship-email"
              type="email"
              value="{{ default_email | escape }}"
              data-apgo-email
              autocomplete="email"
              placeholder="{{ 'apgo_cart.placeholder_email' | t }}"
            >
          </div>
          <div class="apgo-shipping-address__field apgo-shipping-address__field--full">
            <label for="apgo-ship-phone">{{ 'apgo_cart.phone' | t }}</label>
            <input
              id="apgo-ship-phone"
              type="tel"
              value="{{ default_phone | escape }}"
              data-apgo-phone
              autocomplete="tel"
              placeholder="{{ 'apgo_cart.placeholder_phone' | t }}"
            >
          </div>
        </div>
      </div>

      <div class="apgo-prefill-divider" aria-hidden="true"></div>

      <div class="apgo-prefill-block">
        <h4 class="apgo-prefill-block__title">{{ 'apgo_cart.checkout_shipping_section_title' | t }}</h4>
        <p class="apgo-prefill-block__subtitle">{{ 'apgo_cart.checkout_shipping_section_subtitle' | t }}</p>
        <div class="apgo-shipping-address__form">
          <div class="apgo-shipping-address__field">
            <label for="apgo-ship-country">{{ 'apgo_cart.country' | t }}</label>
            <select id="apgo-ship-country" data-apgo-country>
              {% for country in localization.available_countries %}
                {% if country.iso_code == 'MY' or country.iso_code == 'SG' %}
                  <option
                    value="{{ country.iso_code }}"
                    {% if country.iso_code == default_country_code %}
                      selected
                    {% endif %}
                  >
                    {{ country.name }}
                  </option>
                {% endif %}
              {% endfor %}
              {% if default_country_code != 'MY' and default_country_code != 'SG' %}
                <option value="{{ default_country_code }}" selected>{{ default_country_code }}</option>
              {% endif %}
            </select>
          </div>

          <div class="apgo-shipping-address__field apgo-shipping-address__field--full">
            <label for="apgo-ship-address1">{{ 'apgo_cart.address1' | t }}</label>
            <input
              id="apgo-ship-address1"
              type="text"
              value="{{ default_address1 | escape }}"
              data-apgo-address1
              autocomplete="address-line1"
              placeholder="{{ 'apgo_cart.placeholder_address1' | t }}"
            >
          </div>

          <div class="apgo-shipping-address__field">
            <label for="apgo-ship-zip">{{ 'apgo_cart.zip' | t }}</label>
            <input
              id="apgo-ship-zip"
              type="text"
              value="{{ default_zip | escape }}"
              data-apgo-zip
              autocomplete="postal-code"
              placeholder="{{ 'apgo_cart.placeholder_zip' | t }}"
            >
          </div>

          <div class="apgo-shipping-address__field" data-apgo-city-field>
            <label for="apgo-ship-city">{{ 'apgo_cart.city' | t }}</label>
            <input
              id="apgo-ship-city"
              type="text"
              value="{{ default_city | escape }}"
              data-apgo-city
              autocomplete="address-level2"
              placeholder="{{ 'apgo_cart.placeholder_city' | t }}"
            >
          </div>

          <div class="apgo-shipping-address__field" data-apgo-province-field>
            <label for="apgo-ship-province">{{ 'apgo_cart.province' | t }}</label>
            <select id="apgo-ship-province" data-apgo-province>
              <option
                value=""
                {% if default_province == blank %}selected{% endif %}
                hidden
              >
                {{- 'apgo_cart.select_province' | t -}}
              </option>
              {% assign my_states = "Johor,Kedah,Kelantan,Kuala Lumpur,Labuan,Malacca,Negeri Sembilan,Pahang,Penang,Perak,Perlis,Putrajaya,Sabah,Sarawak,Selangor,Terengganu" | split: "," %}
              {% for state in my_states %}
                <option value="{{ state }}" {% if default_province == state %}selected{% endif %}>
                  {{ state }}
                </option>
              {% endfor %}
            </select>
          </div>
        </div>
      </div>

      <div class="apgo-shipping-address__message" data-apgo-message aria-live="polite">
        {{ 'apgo_cart.address_ready_for_checkout' | t }}
      </div>
    </div>
  </div>
</section>

<style>
  .apgo-shipping-address-section {
    --apgo-cart-inline-space: clamp(12px, 2.2vw, 28px);
    --apgo-prefill-title: #f08418;
    --apgo-prefill-body: #ffffff;
    --apgo-prefill-muted: #cccccc;
    --apgo-prefill-card: #0f0f0f;
    --apgo-prefill-page: #000000;
    --apgo-prefill-input-bg: #1a1a1a;
    --apgo-prefill-input-border: #333333;
    width: 100%;
    padding: 20px var(--apgo-cart-inline-space);
    background: var(--apgo-prefill-page);
    color: var(--apgo-prefill-body);
  }

  .apgo-shipping-address__container {
    max-width: none;
    margin: 0 auto;
    position: relative;
  }

  .apgo-shipping-address__top-accent {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 84%;
    height: 4px;
    border-radius: 16px;
    background: linear-gradient(90deg, #f08418, #ff9a3c);
    z-index: 2;
  }

  .apgo-shipping-address__card {
    margin-top: 8px;
    background: var(--apgo-prefill-card);
    border: 1px solid #252525;
    border-radius: 16px;
    box-shadow: 0 16px 40px rgb(0 0 0 / 55%);
    padding: 22px 20px;
  }

  .apgo-shipping-address__header {
    text-align: center;
    margin-bottom: 20px;
  }

  .apgo-shipping-address__title {
    margin: 0 0 8px;
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--apgo-prefill-title);
  }

  .apgo-shipping-address__subtitle {
    margin: 0;
    font-size: 0.92rem;
    color: var(--apgo-prefill-muted);
    line-height: 1.45;
  }

  .apgo-prefill-block {
    margin-bottom: 4px;
  }

  .apgo-prefill-block__title {
    margin: 0 0 6px;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--apgo-prefill-title);
    letter-spacing: 0.02em;
  }

  .apgo-prefill-block__subtitle {
    margin: 0 0 14px;
    font-size: 0.88rem;
    color: var(--apgo-prefill-muted);
    line-height: 1.45;
  }

  .apgo-prefill-divider {
    height: 1px;
    background: #2a2a2a;
    margin: 20px 0;
  }

  .apgo-shipping-address__form {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  @media (min-width: 640px) {
    .apgo-shipping-address__form:not(.apgo-shipping-address__form--personal) {
      grid-template-columns: 1fr 1fr;
    }
    .apgo-shipping-address__field--full {
      grid-column: 1 / -1;
    }
  }

  .apgo-shipping-address__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .apgo-shipping-address__field label {
    font-size: 0.9rem;
    color: var(--apgo-prefill-body);
    font-weight: 600;
  }

  .apgo-shipping-address__field input,
  .apgo-shipping-address__field select {
    width: 100%;
    min-height: 44px;
    border: 1px solid var(--apgo-prefill-input-border);
    border-radius: 12px;
    background: var(--apgo-prefill-input-bg);
    color: var(--apgo-prefill-body);
    padding: 0 12px;
    font-size: 0.92rem;
  }

  .apgo-shipping-address__field input::placeholder {
    color: var(--apgo-prefill-muted);
    opacity: 0.85;
  }

  .apgo-shipping-address__field select option {
    background: var(--apgo-prefill-input-bg);
    color: var(--apgo-prefill-body);
  }

  .apgo-shipping-address__message {
    margin-top: 16px;
    min-height: 18px;
    font-size: 0.85rem;
    color: var(--apgo-prefill-muted);
  }

  .apgo-shipping-address__message.error {
    color: #f87171;
    font-weight: 600;
  }

  .apgo-shipping-address__message.success {
    color: #86efac;
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .apgo-shipping-address__container {
      max-width: min(1200px, 66vw);
    }

    .apgo-shipping-address__card {
      padding: 24px 28px;
    }
  }
</style>

<script>
  (() => {
    if (window.__apgoShippingAddressSectionBound) return;
    window.__apgoShippingAddressSectionBound = true;

    const root = document.querySelector('[data-apgo-shipping-address]');
    if (!root) return;

    const cartCheckoutUrl = (root.getAttribute('data-apgo-cart-checkout-url') || '/cart/checkout').replace(/\/$/, '');

    const fullnameEl = root.querySelector('[data-apgo-fullname]');
    const emailEl = root.querySelector('[data-apgo-email]');
    const phoneEl = root.querySelector('[data-apgo-phone]');
    const countryEl = root.querySelector('[data-apgo-country]');
    const provinceEl = root.querySelector('[data-apgo-province]');
    const provinceFieldEl = root.querySelector('[data-apgo-province-field]');
    const cityEl = root.querySelector('[data-apgo-city]');
    const cityFieldEl = root.querySelector('[data-apgo-city-field]');
    const zipEl = root.querySelector('[data-apgo-zip]');
    const address1El = root.querySelector('[data-apgo-address1]');
    const messageEl = root.querySelector('[data-apgo-message]');
    const isSGCountry = (countryCode) => (countryCode || '').trim().toUpperCase() === 'SG';
    const isMYCountry = (countryCode) => (countryCode || '').trim().toUpperCase() === 'MY';

    const splitFullName = (full) => {
      const t = (full || '').trim();
      if (!t) return { first: '', last: '' };
      const parts = t.split(/\s+/);
      if (parts.length === 1) return { first: parts[0], last: parts[0] };
      return { first: parts[0], last: parts.slice(1).join(' ') };
    };

    const digitsOnly = (s) => String(s || '').replace(/\D/g, '');

    /** Compact phone for URL prefill (+ kept if present; spaces stripped). */
    const formatPhoneForCheckout = (raw) => {
      let t = String(raw || '').trim().replace(/\s/g, '');
      if (!t) return '';
      const d = digitsOnly(t);
      if (t.startsWith('+')) return d ? `+${d}` : '';
      return d || t;
    };

    const applyCountryFieldRules = () => {
      const countryCode = countryEl?.value;
      const sgMode = isSGCountry(countryCode);
      const myMode = isMYCountry(countryCode);

      if (cityFieldEl) cityFieldEl.style.display = sgMode ? 'none' : '';
      if (provinceFieldEl) provinceFieldEl.style.display = sgMode ? 'none' : '';

      if (sgMode) {
        if (cityEl) cityEl.value = '';
        if (provinceEl) provinceEl.value = '';
        if (zipEl) zipEl.placeholder = 'e.g. 569830';
      } else if (myMode) {
        if (zipEl) zipEl.placeholder = 'e.g. 50450';
      } else if (zipEl) {
        zipEl.placeholder = `{{ 'apgo_cart.placeholder_zip' | t | escape }}`;
      }
    };

    const setMessage = (text, kind) => {
      if (!messageEl) return;
      messageEl.textContent = text || '';
      messageEl.classList.remove('error', 'success');
      if (kind) messageEl.classList.add(kind);
    };

    const getContact = () => ({
      fullName: (fullnameEl?.value || '').trim(),
      email: (emailEl?.value || '').trim(),
      phone: (phoneEl?.value || '').trim(),
    });

    const getAddress = () => ({
      country: (countryEl?.value || '').trim(),
      province: (provinceEl?.value || '').trim(),
      city: (cityEl?.value || '').trim(),
      zip: (zipEl?.value || '').trim(),
      address1: (address1El?.value || '').trim(),
    });

    const validateContact = (c) => {
      if (!c.fullName || !c.email || !c.phone) {
        return { valid: false, key: !c.fullName ? 'fullName' : !c.email ? 'email' : 'phone', errorText: `{{ 'apgo_cart.contact_required_error' | t | escape }}` };
      }
      const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(c.email);
      if (!emailOk) return { valid: false, key: 'email', errorText: `{{ 'apgo_cart.email_invalid_error' | t | escape }}` };
      if (digitsOnly(c.phone).length < 8) return { valid: false, key: 'phone', errorText: `{{ 'apgo_cart.phone_invalid_error' | t | escape }}` };
      return { valid: true, key: '', errorText: '' };
    };

    const validateAddress = (addr) => {
      const sgMode = isSGCountry(addr.country);
      const required = sgMode ? ['country', 'zip', 'address1'] : ['country', 'province', 'city', 'zip', 'address1'];
      const firstMissingKey = required.find((key) => !addr[key]);
      if (firstMissingKey) return { valid: false, firstMissingKey, errorText: `{{ 'apgo_cart.address_required_error' | t | escape }}` };

      if (sgMode && !/^\d{6}$/.test(addr.zip)) {
        return { valid: false, firstMissingKey: 'zip', errorText: `{{ 'apgo_cart.sg_zip_error' | t | escape }}` };
      }

      return { valid: true, firstMissingKey: '' };
    };

    const focusField = (key) => {
      const map = {
        fullName: fullnameEl,
        email: emailEl,
        phone: phoneEl,
        country: countryEl,
        province: provinceEl,
        city: cityEl,
        zip: zipEl,
        address1: address1El,
      };
      map[key]?.focus();
    };

    const buildCheckoutQuery = (contact, addr) => {
      const sgMode = isSGCountry(addr.country);
      const { first, last } = splitFullName(contact.fullName);
      const phoneCheckout = formatPhoneForCheckout(contact.phone);
      const q = new URLSearchParams();
      q.set('checkout[email]', contact.email.trim());
      q.set('checkout[shipping_address][first_name]', first);
      q.set('checkout[shipping_address][last_name]', last);
      q.set('checkout[shipping_address][phone]', phoneCheckout);
      q.set('checkout[shipping_address][country]', addr.country);
      q.set('checkout[shipping_address][province]', sgMode ? '' : addr.province);
      q.set('checkout[shipping_address][city]', sgMode ? '' : addr.city);
      q.set('checkout[shipping_address][zip]', addr.zip);
      q.set('checkout[shipping_address][address1]', addr.address1);
      q.set('checkout[billing_address][phone]', phoneCheckout);
      q.set('checkout[billing_address][country]', addr.country);
      return q.toString();
    };

    const saveToCartAttributes = async (contact, addr) => {
      const sgMode = isSGCountry(addr.country);
      try {
        await fetch('/cart/update.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            attributes: {
              estimated_contact_name: contact.fullName,
              estimated_contact_email: contact.email,
              estimated_contact_phone: contact.phone,
              estimated_shipping_country: addr.country,
              estimated_shipping_province: sgMode ? '' : addr.province,
              estimated_shipping_city: sgMode ? '' : addr.city,
              estimated_shipping_zip: addr.zip,
              estimated_shipping_address1: addr.address1,
            },
          }),
        });
      } catch (_) {}
    };

    window.apgoValidateCheckoutAddress = () => {
      const contact = getContact();
      const contactCheck = validateContact(contact);
      if (!contactCheck.valid) {
        setMessage(contactCheck.errorText, 'error');
        focusField(contactCheck.key);
        return { valid: false, query: '' };
      }

      const address = getAddress();
      const addrCheck = validateAddress(address);
      if (!addrCheck.valid) {
        setMessage(addrCheck.errorText, 'error');
        focusField(addrCheck.firstMissingKey);
        return { valid: false, query: '' };
      }

      const query = buildCheckoutQuery(contact, address);
      const nextUrl = `${window.location.pathname}?${query}${window.location.hash || ''}`;
      window.history.replaceState({}, '', nextUrl);
      saveToCartAttributes(contact, address);
      setMessage(`{{ 'apgo_cart.address_ready_for_checkout' | t | escape }}`, 'success');
      return { valid: true, query };
    };

    window.buildCheckoutParams = () => {
      const result = window.apgoValidateCheckoutAddress();
      return result.valid ? `?${result.query}` : (window.location.search || '');
    };

    const bindCheckoutGuard = (buttonId) => {
      const button = document.getElementById(buttonId);
      if (!button) return;
      button.addEventListener(
        'click',
        (event) => {
          if (button.disabled || button.getAttribute('aria-disabled') === 'true') return;
          const result = window.apgoValidateCheckoutAddress();
          if (!result.valid) {
            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();
            return;
          }
          event.preventDefault();
          window.location.assign(`${cartCheckoutUrl}?${result.query}`);
        },
        true
      );
    };

    const clearableEls = [fullnameEl, emailEl, phoneEl, countryEl, provinceEl, cityEl, zipEl, address1El];
    ['input', 'change'].forEach((eventName) => {
      clearableEls.forEach((el) => {
        el?.addEventListener(eventName, () => setMessage('', ''), { passive: true });
      });
    });

    countryEl?.addEventListener('change', () => {
      applyCountryFieldRules();
      setMessage('', '');
    });

    applyCountryFieldRules();

    bindCheckoutGuard('checkout');
    bindCheckoutGuard('checkout-standalone');
  })();
</script>

{% schema %}
{
  "name": "Shipping Address",
  "enabled_on": { "templates": ["cart"] },
  "settings": [],
  "presets": [
    {
      "name": "Shipping Address"
    }
  ]
}
{% endschema %}
