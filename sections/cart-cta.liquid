{%- comment -%} Cart Checkout CTA (standalone section) {%- endcomment -%}
<div class="cart-cta color-{{ section.settings.color_scheme }}">
    <button
      type="submit"
      id="checkout-standalone"
      class="cart__checkout-button button"
      name="checkout"
      {%- if cart == empty -%}disabled{%- endif -%}
      form="cart-form"
    >
      {{ 'content.checkout' | t }}
    </button>
  
    {%- if section.settings.show_accelerated and additional_checkout_buttons and settings.show_accelerated_checkout_buttons -%}
      <div class="additional-checkout-buttons additional-checkout-buttons--vertical">
        {{ content_for_additional_checkout_buttons }}
      </div>
    {%- endif -%}
    {%- comment -%}
      Trust block — "Safe & Secure Checkout. We value your privacy." kept
      as a heading on top, followed by 3 explicit signals (SSL encryption,
      Shopify-secured payment, buyer protection). Inline SVGs avoid extra
      requests.
    {%- endcomment -%}
    <p class="cart-cta__trust-title">{{ 'content.checkout_redirect_notice' | t }}</p>
    <ul class="cart-cta__trust" role="list">
      <li class="cart-cta__trust-item">
        <span class="cart-cta__trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </span>
        <span>256-bit SSL encrypted</span>
      </li>
      <li class="cart-cta__trust-sep" aria-hidden="true">·</li>
      <li class="cart-cta__trust-item">
        <span class="cart-cta__trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
        </span>
        <span>Secured by Shopify Payments</span>
      </li>
      <li class="cart-cta__trust-sep" aria-hidden="true">·</li>
      <li class="cart-cta__trust-item">
        <span class="cart-cta__trust-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </span>
        <span>Buyer protection &amp; easy returns</span>
      </li>
    </ul>
  </div>

  {%- if section.settings.show_sticky_mobile -%}
    {%- liquid
      # Per-market threshold — mirrors sections/cart-totals.liquid (SG/MY only)
      assign sticky_threshold_minor = 0
      if localization.country.iso_code == 'SG'
        assign sticky_threshold_minor = 5500
      elsif localization.country.iso_code == 'MY'
        assign sticky_threshold_minor = 9900
      endif

      assign sticky_free_shipping_unlocked = false
      assign sticky_remaining_minor = 0
      if sticky_threshold_minor > 0
        if cart.original_total_price >= sticky_threshold_minor
          assign sticky_free_shipping_unlocked = true
        else
          assign sticky_remaining_minor = sticky_threshold_minor | minus: cart.original_total_price
        endif
      endif
      # Use the same money path as cart-totals so the symbol matches (RM not MYR, NT$ not TWD)
      assign sticky_remaining_formatted = sticky_remaining_minor | money | replace: cart.currency.iso_code, '' | strip
      assign sticky_total_formatted = cart.total_price | money | replace: cart.currency.iso_code, '' | strip

      assign loc = request.locale.iso_code | downcase
      if loc contains 'zh'
        assign label_subtotal_suffix = '件 · 小計'
        assign label_tax_note        = '含稅、結帳計運費'
        assign label_checkout        = '前往結帳'
      else
        assign label_subtotal_suffix = 'items · Subtotal'
        assign label_tax_note        = 'Tax & shipping at checkout'
        assign label_checkout        = 'Check out'
      endif

      assign sticky_progress_pct = 0
      if sticky_threshold_minor > 0
        assign sticky_progress_pct = cart.original_total_price | times: 100 | divided_by: sticky_threshold_minor
        if sticky_progress_pct > 100
          assign sticky_progress_pct = 100
        endif
      endif
    -%}
    <div class="cart-sticky-cta {% if sticky_free_shipping_unlocked %}is-free-shipping-met{% endif %}"
         data-cart-sticky-cta
         data-threshold-minor="{{ sticky_threshold_minor }}"
         style="--progress: {{ sticky_progress_pct }}%;"
         {% if cart == empty %}hidden{% endif %}>
      {%- if section.settings.show_free_shipping_progress and sticky_threshold_minor > 0 -%}
        <div class="cart-sticky-cta__progress" data-sticky-progress>
          <div class="cart-sticky-cta__progress-fill" data-sticky-progress-fill></div>
          <span class="cart-sticky-cta__progress-text" data-sticky-progress-text>
            {%- if sticky_free_shipping_unlocked -%}
              {{- 'apgo_cart.free_shipping_unlocked' | t -}}
            {%- else -%}
              {{- 'apgo_cart.free_shipping_remaining' | t: amount: sticky_remaining_formatted -}}
            {%- endif -%}
          </span>
        </div>
      {%- endif -%}
      <div class="cart-sticky-cta__row">
        <div class="cart-sticky-cta__summary">
          <span class="cart-sticky-cta__count">
            <span data-sticky-count>{{ cart.item_count }}</span> {{ label_subtotal_suffix }}
          </span>
          <span class="cart-sticky-cta__total" data-sticky-total>
            {{ sticky_total_formatted }}
          </span>
          <span class="cart-sticky-cta__note">{{ label_tax_note }}</span>
        </div>
        <button
          type="submit"
          class="cart-sticky-cta__button button"
          form="cart-form"
          name="checkout"
          data-sticky-checkout
          {%- if cart == empty -%}disabled{%- endif -%}
        >
          {{ label_checkout }} <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  {%- endif -%}

  {% stylesheet %}
  /* ========================================
     購物車結帳按鈕樣式設計
     ======================================== */
  
  /* 主容器樣式 */
  .cart-cta { 
    display: flex; 
    flex-direction: column; 
    gap: var(--gap-md); 
    margin: 32px 0 40px 0;
    background: transparent !important;
    border: none !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    padding: 0 !important;
  }
  
  /* 結帳按鈕主體樣式 */
  .cart-cta .cart__checkout-button,
  .cart-cta .button,
  #checkout-standalone.cart__checkout-button {
    background: linear-gradient(135deg, #ff6b35, #f7931e) !important;
    border: none !important;
    border-radius: 16px !important;
    padding: 20px 40px !important;
    font-size: 18px !important;
    font-weight: 700 !important;
    color: #ffffff !important;
    width: 100% !important;
    max-width: 480px !important;
    margin: 0 auto !important;
    cursor: pointer !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    box-shadow: 
        0 12px 35px rgba(255, 107, 53, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.2) !important;
    text-transform: none !important;
    letter-spacing: 1px !important;
    position: relative !important;
    overflow: hidden !important;
    display: block !important;
    z-index: 100 !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif !important;
    
    /* 確保按鈕不會被覆蓋 */
    clear: both !important;
  }
  
  /* 結帳按鈕發光效果 */
  .cart-cta .cart__checkout-button::before,
  .cart-cta .button::before,
  #checkout-standalone.cart__checkout-button::before {
    content: '' !important;
    position: absolute !important;
    top: 0 !important;
    left: -100% !important;
    width: 100% !important;
    height: 100% !important;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent) !important;
    transition: left 0.6s ease !important;
  }
  
  /* 懸停效果 */
  .cart-cta .cart__checkout-button:hover,
  .cart-cta .button:hover,
  #checkout-standalone.cart__checkout-button:hover {
    transform: translateY(-4px) !important;
    box-shadow: 
        0 16px 45px rgba(255, 107, 53, 0.5),
        inset 0 1px 0 rgba(255, 255, 255, 0.3) !important;
  }
  
  .cart-cta .cart__checkout-button:hover::before,
  .cart-cta .button:hover::before,
  #checkout-standalone.cart__checkout-button:hover::before {
    left: 100% !important;
  }
  
  /* 按下效果 */
  .cart-cta .cart__checkout-button:active,
  .cart-cta .button:active,
  #checkout-standalone.cart__checkout-button:active {
    transform: translateY(-2px) !important;
    box-shadow: 
        0 8px 25px rgba(255, 107, 53, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.2) !important;
  }
  
  /* 禁用狀態 */
  .cart-cta .cart__checkout-button:disabled,
  .cart-cta .button:disabled,
  #checkout-standalone.cart__checkout-button:disabled,
  .cart-cta .cart__checkout-button[style*="pointer-events: none"],
  .cart-cta .button[style*="pointer-events: none"],
  #checkout-standalone.cart__checkout-button[style*="pointer-events: none"] {
    background: linear-gradient(135deg, #666666, #555555) !important;
    cursor: not-allowed !important;
    transform: none !important;
    box-shadow: 
        0 4px 15px rgba(0, 0, 0, 0.2),
        inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;
    opacity: 0.6 !important;
  }
  
  /* 額外結帳按鈕樣式 */
  .additional-checkout-buttons {
    margin-top: 16px !important;
  }
  
  .additional-checkout-buttons .additional-checkout-button {
    background: linear-gradient(145deg, #2d2d2d, #1a1a1a) !important;
    border: 2px solid #404040 !important;
    border-radius: 12px !important;
    padding: 16px 20px !important;
    font-size: 15px !important;
    color: #ffffff !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    box-shadow: 
        0 4px 15px rgba(0, 0, 0, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;
    margin: 8px 0 !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif !important;
  }
  
  .additional-checkout-buttons .additional-checkout-button:hover {
    border-color: #ff6b35 !important;
    box-shadow: 
        0 8px 25px rgba(255, 107, 53, 0.3),
        inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;
    transform: translateY(-2px) !important;
  }

  /* 結帳按鈕下方的跳轉提示（legacy fallback if locale string is rendered elsewhere） */
  .cart-cta .cart__checkout-redirect-notice {
    display: block !important;
    margin-top: 12px !important;
    font-size: 12px !important;
    color: #aaa !important;
    text-align: center !important;
    max-width: 480px !important;
    margin-left: auto !important;
    margin-right: auto !important;
  }

  /* Trust title — "Safe & Secure Checkout. We value your privacy." */
  .cart-cta .cart-cta__trust-title {
    margin: 14px auto 6px !important;
    text-align: center !important;
    font-size: 13px !important;
    font-weight: 600 !important;
    color: rgba(255, 255, 255, 0.85) !important;
    letter-spacing: 0.01em !important;
  }
  /* Trust row under the Checkout button — SSL / Shopify Payments / Buyer protection */
  .cart-cta .cart-cta__trust {
    display: flex !important;
    flex-wrap: wrap !important;
    justify-content: center !important;
    align-items: center !important;
    gap: 6px 10px !important;
    margin: 0 auto !important;
    padding: 0 !important;
    max-width: 640px !important;
    list-style: none !important;
    font-size: 12px !important;
    color: rgba(255, 255, 255, 0.65) !important;
    line-height: 1.4 !important;
  }
  .cart-cta .cart-cta__trust-item {
    display: inline-flex !important;
    align-items: center !important;
    gap: 5px !important;
    white-space: nowrap !important;
  }
  .cart-cta .cart-cta__trust-icon {
    display: inline-flex !important;
    align-items: center !important;
    color: #f08418 !important;
  }
  .cart-cta .cart-cta__trust-sep {
    color: rgba(255, 255, 255, 0.25) !important;
    user-select: none !important;
  }
  @media (max-width: 480px) {
    .cart-cta .cart-cta__trust {
      gap: 4px 8px !important;
      font-size: 11px !important;
    }
    /* On small screens drop the dot separators so the three items stack
       cleanly under each other. */
    .cart-cta .cart-cta__trust-sep { display: none !important; }
    .cart-cta .cart-cta__trust-item { flex-basis: 100%; justify-content: center; }
  }
  
  /* 響應式設計 */
  @media (max-width: 768px) {
    .cart-cta .cart__checkout-button,
    .cart-cta .button,
    #checkout-standalone.cart__checkout-button {
      padding: 18px 32px !important;
      font-size: 16px !important;
      /* Pull trust block closer to the CTA on mobile */
      margin: 24px auto 8px auto !important;
      border-radius: 14px !important;
    }

    .cart-cta {
      margin: 24px 0 24px 0;
    }
    /* Tighter spacing between CTA, trust title, and trust row on mobile */
    .cart-cta .cart-cta__trust-title {
      margin: 6px auto 4px !important;
      font-size: 12px !important;
    }
  }

  @media (max-width: 480px) {
    .cart-cta .cart__checkout-button,
    .cart-cta .button,
    #checkout-standalone.cart__checkout-button {
      padding: 16px 28px !important;
      font-size: 15px !important;
      margin: 20px auto 6px auto !important;
      border-radius: 12px !important;
    }

    .cart-cta {
      margin: 20px 0 20px 0;
    }
    .cart-cta .cart-cta__trust-title {
      margin: 4px auto 2px !important;
    }
  }
  
  /* 動畫效果 */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .cart-cta {
    animation: fadeInUp 0.6s ease-out !important;
  }

  /* ========================================
     Mobile Sticky Checkout Bar
     ======================================== */
  .cart-sticky-cta { display: none; }

  @media (max-width: 749px) {
    .cart-sticky-cta {
      display: block;
      position: fixed;
      inset: auto 0 0 0;
      z-index: 70;
      background: linear-gradient(180deg, #0a0a0a 0%, #000 100%);
      border-top: 1px solid rgba(255, 107, 53, 0.3);
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.5);
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom)) 16px;
      transform: translateY(0);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      animation: fadeInUp 0.4s ease-out;
    }
    .cart-sticky-cta[hidden] { display: none; }
    .cart-sticky-cta.is-keyboard-open { transform: translateY(120%); }

    .cart-sticky-cta__row {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .cart-sticky-cta__summary {
      flex: 1 1 auto;
      min-width: 0;
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }
    .cart-sticky-cta__count {
      font-size: 12px;
      color: #cccccc;
      letter-spacing: 0.02em;
    }
    .cart-sticky-cta__total {
      font-size: 20px;
      font-weight: 700;
      color: #f7931e;
      margin-top: 2px;
    }
    .cart-sticky-cta__note {
      font-size: 10px;
      color: #888;
      margin-top: 2px;
    }

    .cart-sticky-cta__button {
      flex: 0 0 auto;
      min-width: 144px;
      padding: 14px 22px;
      border: none;
      border-radius: 12px;
      background: linear-gradient(135deg, #ff6b35, #f7931e);
      color: #ffffff;
      font-weight: 700;
      font-size: 16px;
      letter-spacing: 0.04em;
      cursor: pointer;
      box-shadow: 0 8px 20px rgba(255, 107, 53, 0.45),
                  inset 0 1px 0 rgba(255, 255, 255, 0.2);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .cart-sticky-cta__button:active {
      transform: scale(0.97);
      box-shadow: 0 4px 12px rgba(255, 107, 53, 0.35);
    }
    .cart-sticky-cta__button:disabled {
      background: linear-gradient(135deg, #666, #555);
      cursor: not-allowed;
      box-shadow: none;
      opacity: 0.6;
    }

    /* Free shipping progress micro-bar */
    .cart-sticky-cta__progress {
      position: relative;
      height: 22px;
      margin: 0 0 8px 0;
      border-radius: 11px;
      background: rgba(255, 255, 255, 0.06);
      overflow: hidden;
    }
    .cart-sticky-cta__progress-fill {
      position: absolute;
      inset: 0 auto 0 0;
      width: var(--progress, 0%);
      background: linear-gradient(90deg, #ff6b35, #f7931e);
      transition: width 0.4s ease;
    }
    .cart-sticky-cta__progress-text {
      position: relative;
      z-index: 1;
      display: block;
      text-align: center;
      font-size: 11px;
      line-height: 22px;
      color: #ffffff;
      font-weight: 500;
      text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
    }
    .cart-sticky-cta.is-free-shipping-met .cart-sticky-cta__progress-fill { width: 100%; }

    /* Push page content up so the last item is not covered by the bar */
    main,
    .shopify-section--main-cart,
    body { padding-bottom: calc(var(--apgo-sticky-cta-h, 110px) + env(safe-area-inset-bottom)); }
  }
  {% endstylesheet %}
  
  <script>
  document.addEventListener('DOMContentLoaded', function(){
    // === 設定 ===
    // true: GET 導到 routes.cart_url + /checkout?…（與 cart permalink 行為一致，email/phone 才較會帶入）
    // false: 保留主題原本的 POST，僅把 form.action 改為同一路徑 + query
    var REDIRECT_MODE = true;
    var CART_CHECKOUT_URL = {{ routes.cart_url | append: '/checkout' | json }};

    var btns = document.querySelectorAll('#checkout-standalone, [data-sticky-checkout]');
    if (!btns.length) return;
    var primaryBtn = btns[0];

    var formId = primaryBtn.getAttribute('form') || 'cart-form';
    var form   = document.getElementById(formId);

    // 取目前 query（先嘗試把最新輸入寫進網址）
    function getCurrentQuery() {
      return window.location.search || '';
    }

    // 讓 a/form 也能同步（POST 模式時用得到；或主題別處有 checkout 連結）
    function syncEntrancesNow(){
      var qs = getCurrentQuery();

      // 改本表單 action（POST 模式用）
      if (!REDIRECT_MODE && form) {
        form.action = CART_CHECKOUT_URL + qs;
      }

      // 如果主題上還有其它 /checkout 連結，也幫它們接上 query（加速結帳等仍用官方 /checkout）
      document.querySelectorAll('a[href^="/checkout"]').forEach(function(a){
        a.setAttribute('href', '/checkout' + qs);
      });
    }

    // 初始化同步一次（特別是 POST 模式要先設好 action）
    syncEntrancesNow();

    // 主要行為：點擊 CTA（同時綁定頁尾主按鈕與 sticky bar 按鈕）
    function onCheckoutClick(ev){
      var b = ev.currentTarget;
      if (b.disabled || b.getAttribute('aria-disabled') === 'true') return;

      var validated = { valid: true, query: '' };
      if (typeof window.apgoValidateCheckoutAddress === 'function') {
        validated = window.apgoValidateCheckoutAddress() || validated;
      }
      if (!validated.valid) {
        ev.preventDefault();
        return;
      }

      var qs = validated.query ? ('?' + validated.query) : getCurrentQuery();

      if (REDIRECT_MODE) {
        ev.preventDefault();
        window.location.assign(CART_CHECKOUT_URL + qs);
      } else {
        if (form) form.action = CART_CHECKOUT_URL + qs;
      }
    }
    btns.forEach(function(b){ b.addEventListener('click', onCheckoutClick, true); });

    // 若你的收件欄位用 history.replaceState 即時改網址，這裡再保險補一次
    window.addEventListener('popstate', syncEntrancesNow);

    // 有些主題/抽屜會晚載入或改動 DOM；短期輪詢補強一下
    var tries = 0, iv = setInterval(function(){
      syncEntrancesNow();
      if (++tries > 10) clearInterval(iv);
    }, 500);
  });

  /* ========================================
     Mobile Sticky CTA — mirrors the cart-totals DOM (no client-side money math
     → no drift from displayed total, correct symbol per market, locale-correct)
     ======================================== */
  (function(){
    var bar = document.querySelector('[data-cart-sticky-cta]');
    if (!bar) return;

    var countEl    = bar.querySelector('[data-sticky-count]');
    var totalEl    = bar.querySelector('[data-sticky-total]');
    var btnEl      = bar.querySelector('[data-sticky-checkout]');
    var textEl     = bar.querySelector('[data-sticky-progress-text]');
    var thresholdMinor = parseInt(bar.getAttribute('data-threshold-minor'), 10) || 0;

    // Source-of-truth elements rendered by sections/cart-totals.liquid.
    function readDisplayedTotal(){
      var el = document.querySelector('[data-cart-subtotal]');
      return el ? (el.textContent || '').trim() : null;
    }
    function readDisplayedFreeShippingLine(){
      // .cart__shipping-goal .cart__value — already localized + already in shop currency symbol
      var el = document.querySelector('.cart__shipping-goal .cart__value');
      return el ? (el.textContent || '').trim() : null;
    }

    function refreshFromDom(cart){
      // Mirror page-rendered total (zero drift)
      var displayed = readDisplayedTotal();
      if (displayed && totalEl) totalEl.textContent = displayed;

      // Mirror page-rendered free-shipping line
      var fsLine = readDisplayedFreeShippingLine();
      if (fsLine && textEl) textEl.textContent = fsLine;

      // Count + progress need cart.js (count from raw data; progress from original_total_price)
      if (cart) {
        if (cart.item_count === 0) {
          bar.setAttribute('hidden', '');
          if (btnEl) btnEl.disabled = true;
          return;
        }
        bar.removeAttribute('hidden');
        if (btnEl) btnEl.disabled = false;
        if (countEl) countEl.textContent = cart.item_count;

        if (thresholdMinor > 0) {
          var pct = Math.min(100, Math.round((cart.original_total_price / thresholdMinor) * 100));
          bar.style.setProperty('--progress', pct + '%');
          bar.classList.toggle('is-free-shipping-met', cart.original_total_price >= thresholdMinor);
        }
      }
    }

    var refreshTimer = null;
    function refreshSticky(){
      clearTimeout(refreshTimer);
      // Wait a beat so cart-totals has re-rendered before we read its DOM.
      refreshTimer = setTimeout(function(){
        fetch('/cart.js', { credentials: 'same-origin' })
          .then(function(r){ return r.json(); })
          .then(refreshFromDom)
          .catch(function(){ refreshFromDom(null); });
      }, 250);
    }

    ['cart:update', 'cart:updated', 'cart:refresh', 'quantity-selector:update'].forEach(function(ev){
      document.addEventListener(ev, refreshSticky);
    });

    // iOS / mobile keyboard: hide bar when keyboard opens so it doesn't cover inputs
    if (window.visualViewport) {
      var baseHeight = window.innerHeight;
      window.visualViewport.addEventListener('resize', function(){
        var kbOpen = window.visualViewport.height < baseHeight - 100;
        bar.classList.toggle('is-keyboard-open', kbOpen);
      });
    }
  })();
  </script>
  
