{% comment %}
  APGO Special Event — promo / deals collection listing.
  Shares panel layout with Event Collection Grid (方案 A：连续肉色内容带).
{% endcomment %}

{{ 'apgo-event-page.css' | asset_url | stylesheet_tag }}

{% liquid
  assign promo_collection = section.settings.collection
  assign product_limit = section.settings.product_limit | default: 24
%}

<div
  id="apgo-event-promo-{{ section.id }}"
  class="apgo-event-promo section section--full-width"
  style="
    --padding-block-start: {{ section.settings.padding-block-start }}px;
    --padding-block-end: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="apgo-event-collection-grid__panel">
    {% if section.settings.badge != blank or section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="apgo-event-collection-grid__header apgo-event-promo__header">
        {% if section.settings.badge != blank %}
          <span class="apgo-event-promo__badge">{{ section.settings.badge }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="apgo-event-collection-grid__heading apgo-event-promo__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <div class="apgo-event-promo__sub">{{ section.settings.subheading }}</div>
        {% endif %}
      </header>
    {% endif %}

    <div class="apgo-event-collection-grid__panel-body apgo-event-promo__grid-wrap main-collection-zgrid">
      {% render 'apgo-event-product-grid',
        section: section,
        collection: promo_collection,
        product_limit: product_limit
      %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Event Promo Collection",
  "tag": "section",
  "class": "apgo-event-promo-wrapper",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Deals collection"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge label (optional)",
      "default": "Limited Time"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Limited Time Deals"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading (optional)"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Max products",
      "min": 2,
      "max": 50,
      "step": 1,
      "default": 24
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "organic", "label": "Editorial" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "Card size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra-large", "label": "Extra large" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "Mobile card size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "Grid width",
      "options": [
        { "value": "centered", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "full-width"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "Full width on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "Horizontal gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "Vertical gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "paragraph",
      "content": "Colors are controlled by the Special Event page stylesheet (#fcead8 panel on #f08418 background). Color scheme below does not apply on this template."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme (unused on event page)",
      "default": "scheme-5"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Section top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Section bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Event Promo Collection",
      "category": "APGO"
    }
  ]
}
{% endschema %}
