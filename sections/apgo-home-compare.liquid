{% comment %}
  APGO Home — Coating VS Waxing (rebuild of legacy "Homepage S4 Eng").
  Rows are blocks; bars animate to their percentage on scroll-in
  (pure CSS transition triggered by the shared reveal observer).
{% endcomment %}

<section
  id="apgo-home-compare-{{ section.id }}"
  class="apgo-home apgo-home-compare color-{{ section.settings.color_scheme }}"
  data-apgo-home-section="compare"
  data-apgo-home-init="reveal"
  style="
    --padding-block-start: {{ section.settings.padding-block-start }}px;
    --padding-block-end: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="apgo-home__container apgo-home__container--narrow">
    <header class="apgo-home__header apgo-home__header--center" data-apgo-reveal>
      {% if section.settings.eyebrow != blank %}
        <span class="apgo-home__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {% endif %}
      <h2 class="apgo-home__heading">
        {{ section.settings.heading | escape }}
      </h2>
      {% if section.settings.subheading != blank %}
        <p class="apgo-home__sub">{{ section.settings.subheading | escape }}</p>
      {% endif %}
    </header>

    <div class="apgo-home-compare__panel" data-apgo-reveal>
      <div class="apgo-home-compare__legend">
        <span class="apgo-home-compare__legend-item apgo-home-compare__legend-item--left">
          {{- section.settings.col_left_label | escape -}}
        </span>
        <span class="apgo-home-compare__legend-item">
          {{- section.settings.col_right_label | escape -}}
        </span>
      </div>

      {% for block in section.blocks %}
        <div class="apgo-home-compare__row" data-apgo-reveal {{ block.shopify_attributes }}>
          <p class="apgo-home-compare__metric">{{ block.settings.label | escape }}</p>
          <div class="apgo-home-compare__bar">
            <span class="apgo-home-compare__track">
              <span class="apgo-home-compare__fill" style="--apgo-compare-pct: {{ block.settings.left_percent }}%"></span>
            </span>
            <span class="apgo-home-compare__value">{{ block.settings.left_value | escape }}</span>
          </div>
          <div class="apgo-home-compare__bar apgo-home-compare__bar--right">
            <span class="apgo-home-compare__track">
              <span class="apgo-home-compare__fill" style="--apgo-compare-pct: {{ block.settings.right_percent }}%"></span>
            </span>
            <span class="apgo-home-compare__value">{{ block.settings.right_value | escape }}</span>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "APGO Home — Compare",
  "tag": "section",
  "class": "apgo-home-compare-wrapper",
  "enabled_on": {
    "templates": ["index"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The honest comparison"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Coating VS Waxing"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "col_left_label",
      "label": "Left column label",
      "default": "APGO Coating"
    },
    {
      "type": "text",
      "id": "col_right_label",
      "label": "Right column label",
      "default": "Traditional Waxing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-a27d2d12-7174-40fe-a01c-a128174b4c26"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Extra top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Extra bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Metric",
          "default": "Durability"
        },
        {
          "type": "text",
          "id": "left_value",
          "label": "APGO value",
          "default": "2–3 Years"
        },
        {
          "type": "range",
          "id": "left_percent",
          "label": "APGO bar",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 95
        },
        {
          "type": "text",
          "id": "right_value",
          "label": "Waxing value",
          "default": "1–2 Weeks"
        },
        {
          "type": "range",
          "id": "right_percent",
          "label": "Waxing bar",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 8
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "APGO Home — Compare",
      "category": "APGO",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "label": "Durability",
            "left_value": "2–3 Years",
            "left_percent": 95,
            "right_value": "1–2 Weeks",
            "right_percent": 8
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Heat Resistance",
            "left_value": "200°C+",
            "left_percent": 90,
            "right_value": "60°C",
            "right_percent": 27
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Gloss Level",
            "left_value": "98%",
            "left_percent": 98,
            "right_value": "85%",
            "right_percent": 85
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "Wash Cycles",
            "left_value": "300+ Washes",
            "left_percent": 95,
            "right_value": "5–10 Washes",
            "right_percent": 5
          }
        }
      ]
    }
  ]
}
{% endschema %}
