{%- comment -%}
  APGO Cart — simplified "One step left" primer.
  Single-line banner with an icon that sits between the cart totals and
  the Checkout CTA. Aims to nudge the customer through the final click
  without overwhelming the page.
{%- endcomment -%}

<section
  class="apgo-checkout-steps"
  style="
    --padding-block-start: {{ section.settings.padding-block-start }}px;
    --padding-block-end: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="apgo-checkout-steps__banner">
    <span class="apgo-checkout-steps__icon" aria-hidden="true">
      {%- comment -%} Lightning bolt = "fast / one step" {%- endcomment -%}
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" fill="currentColor"/>
      </svg>
    </span>

    <p class="apgo-checkout-steps__text">
      {%- if section.settings.lead_text != blank -%}
        <strong class="apgo-checkout-steps__lead">{{ section.settings.lead_text }}</strong>
      {%- endif -%}
      {%- if section.settings.body_text != blank -%}
        <span class="apgo-checkout-steps__body">{{ section.settings.body_text }}</span>
      {%- endif -%}
    </p>
  </div>
</section>

{% stylesheet %}
  .apgo-checkout-steps {
    padding-block: var(--padding-block-start, 8px) var(--padding-block-end, 8px);
    padding-inline: clamp(12px, 2.2vw, 28px);
    color: #fff;
  }
  .apgo-checkout-steps__banner {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 auto;
    max-width: 1200px;
    padding: 14px 18px;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(240, 132, 24, 0.35);
    border-radius: 12px;
    overflow: hidden;
  }
  .apgo-checkout-steps__banner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #f08418, #ff9a3c);
  }
  .apgo-checkout-steps__icon {
    flex: 0 0 auto;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #f08418, #ff9a3c);
    color: #fff;
    box-shadow: 0 4px 14px rgba(240, 132, 24, 0.4);
  }
  .apgo-checkout-steps__text {
    margin: 0;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.9);
    font-size: 14px;
  }
  .apgo-checkout-steps__lead {
    color: #f08418;
    font-weight: 700;
    margin-right: 4px;
  }
  .apgo-checkout-steps__body {
    color: rgba(255, 255, 255, 0.8);
  }
  @media (max-width: 749px) {
    .apgo-checkout-steps { padding-inline: 0; }
    .apgo-checkout-steps__banner {
      padding: 12px 14px;
      gap: 10px;
      border-radius: 10px;
    }
    .apgo-checkout-steps__icon {
      width: 32px;
      height: 32px;
    }
    .apgo-checkout-steps__text { font-size: 13px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "APGO Checkout Steps",
  "tag": "section",
  "class": "section-apgo-checkout-steps",
  "enabled_on": { "templates": ["cart"] },
  "settings": [
    {
      "type": "text",
      "id": "lead_text",
      "label": "Lead text (orange)",
      "default": "One step left."
    },
    {
      "type": "text",
      "id": "body_text",
      "label": "Body text",
      "default": "Click Checkout to finish in under a minute."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "APGO Checkout Steps"
    }
  ]
}
{% endschema %}
