{%- comment -%}
  Clearance page — opening block: printed chip, the page's h1, a short
  paragraph, an offer line (bold words in red), a button down to the
  deals, luggage-tag chips, and a warehouse illustration (or an uploaded
  photo) with a red stamp; phones skip the illustration so the offer and
  button stay on the first screen. Offer and tag text can differ for
  Singapore. Styled in assets/apgo-clearance-page.css, which only the
  page.clearance-sale template loads.
{%- endcomment -%}

{%- liquid
  assign apgo_intro_heading = section.settings.heading | strip
  assign apgo_intro_accent = section.settings.heading_accent | strip
  assign apgo_intro_sign = section.settings.sign | strip | upcase

  assign apgo_intro_offer = section.settings.offer
  if localization.country.iso_code == 'SG' and section.settings.offer_sg != blank
    assign apgo_intro_offer = section.settings.offer_sg
  endif

  # The illustration's stamp is drawn inside the SVG, centred in the free
  # space between the boxes and the hand truck; its box grows with the text.
  assign apgo_stamp = section.settings.stamp | strip | upcase
  assign apgo_stamp_len = apgo_stamp | size
  assign apgo_stamp_tall_half = apgo_stamp_len | times: 12.5 | plus: 22 | divided_by: 2.0
  assign apgo_stamp_tall_x = 327 | minus: apgo_stamp_tall_half
  assign apgo_stamp_tall_w = apgo_stamp_tall_half | times: 2
  assign apgo_stamp_wide_half = apgo_stamp_len | times: 8.5 | plus: 14 | divided_by: 2.0
  assign apgo_stamp_wide_x = 228 | minus: apgo_stamp_wide_half
  assign apgo_stamp_wide_w = apgo_stamp_wide_half | times: 2
-%}

<div class="apgo-crate-intro">
  <div class="apgo-crate-container apgo-crate-intro__grid">
    <div class="apgo-crate-intro__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="apgo-crate-intro__chip">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if apgo_intro_heading != blank or apgo_intro_accent != blank -%}
        <h1 class="apgo-crate-intro__title">
          {{- apgo_intro_heading | escape -}}
          {%- if apgo_intro_accent != blank %} <span>{{ apgo_intro_accent | escape }}</span>{%- endif -%}
        </h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="apgo-crate-intro__text">{{ section.settings.text | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if apgo_intro_offer != blank -%}
        <p class="apgo-crate-intro__offer">{{ apgo_intro_offer }}</p>
      {%- elsif request.design_mode -%}
        <p class="apgo-crate-intro__offer apgo-crate-intro__offer--hint">Offer line goes here, e.g. <strong>Up to 50% off</strong> · Ends <strong>31 Oct</strong></p>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="apgo-crate-intro__cta" href="{{ section.settings.button_link }}">
          {{- section.settings.button_label | escape -}}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
        </a>
      {%- endif -%}
    </div>

    <div class="apgo-crate-intro__art">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            class: 'apgo-crate-intro__photo',
            loading: 'lazy',
            widths: '360, 540, 720, 960, 1200, 1400',
            sizes: '(min-width: 990px) 50vw, calc(100vw - 32px)',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        <svg class="apgo-crate-intro__svg apgo-crate-intro__svg--wide" width="356" height="170" viewBox="0 0 356 170" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M0 158H356" stroke="#3B2E20" stroke-width="2"/>
          <rect x="24" y="100" width="74" height="58" fill="#B98E5A" stroke="#7A5A33" stroke-width="1.5"/>
          <rect x="98" y="100" width="74" height="58" fill="#C9A06B" stroke="#7A5A33" stroke-width="1.5"/>
          <rect x="58" y="46" width="78" height="54" fill="#C9A06B" stroke="#7A5A33" stroke-width="1.5"/>
          <path d="M61 100V158M135 100V158M97 46V100" stroke="#D9B37C" stroke-width="8"/>
          <rect x="36" y="118" width="30" height="18" fill="#F3EBDC"/>
          <rect x="110" y="118" width="30" height="18" fill="#F3EBDC"/>
          <rect x="104" y="60" width="26" height="16" fill="#F3EBDC"/>
          <path d="M40 124h22M40 130h14M114 124h22M114 130h14M108 66h18M108 71h10" stroke="#1B1712" stroke-width="1.5"/>
          <rect x="196" y="112" width="60" height="46" fill="#B98E5A" stroke="#7A5A33" stroke-width="1.5"/>
          <path d="M226 112V158" stroke="#D9B37C" stroke-width="7"/>
          <path d="M286 60V150h40M286 150l-8 8M282 70h16" stroke="#8C7A63" stroke-width="3"/>
          <circle cx="296" cy="154" r="6" stroke="#8C7A63" stroke-width="3"/>
          <circle cx="320" cy="154" r="6" stroke="#8C7A63" stroke-width="3"/>
          <rect x="292" y="104" width="40" height="42" fill="#C9A06B" stroke="#7A5A33" stroke-width="1.5"/>
          <path d="M312 104V146" stroke="#D9B37C" stroke-width="6"/>
          {%- if apgo_stamp != blank -%}
            <g transform="rotate(8 228 50)">
              <rect x="{{ apgo_stamp_wide_x }}" y="37" width="{{ apgo_stamp_wide_w }}" height="26" fill="none" stroke="#F0655A" stroke-width="2"/>
              <text class="apgo-crate-intro__svg-stamp" x="228" y="56" text-anchor="middle" font-size="14" letter-spacing="1.5" fill="#F0655A">{{ apgo_stamp | escape }}</text>
            </g>
          {%- endif -%}
        </svg>
        <svg class="apgo-crate-intro__svg apgo-crate-intro__svg--tall" width="566" height="420" viewBox="0 0 566 420" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d="M0 392H566" stroke="#3B2E20" stroke-width="2"/>
          <rect x="40" y="366" width="318" height="12" fill="#6E5436"/>
          <rect x="50" y="378" width="44" height="12" fill="#5A4430"/>
          <rect x="177" y="378" width="44" height="12" fill="#5A4430"/>
          <rect x="304" y="378" width="44" height="12" fill="#5A4430"/>
          <rect x="44" y="262" width="104" height="104" fill="#B98E5A" stroke="#7A5A33" stroke-width="1.5"/>
          <rect x="148" y="262" width="104" height="104" fill="#C9A06B" stroke="#7A5A33" stroke-width="1.5"/>
          <rect x="252" y="262" width="104" height="104" fill="#B98E5A" stroke="#7A5A33" stroke-width="1.5"/>
          <rect x="96" y="168" width="104" height="94" fill="#C9A06B" stroke="#7A5A33" stroke-width="1.5"/>
          <rect x="200" y="168" width="104" height="94" fill="#B98E5A" stroke="#7A5A33" stroke-width="1.5"/>
          <rect x="148" y="86" width="104" height="82" fill="#C9A06B" stroke="#7A5A33" stroke-width="1.5"/>
          <path d="M96 262V366M200 262V366M304 262V366M148 168V262M252 168V262M200 86V168" stroke="#D9B37C" stroke-width="12"/>
          <rect x="60" y="296" width="30" height="22" fill="#F3EBDC"/>
          <rect x="164" y="296" width="30" height="22" fill="#F3EBDC"/>
          <rect x="268" y="296" width="30" height="22" fill="#F3EBDC"/>
          <rect x="112" y="196" width="30" height="22" fill="#F3EBDC"/>
          <rect x="216" y="196" width="30" height="22" fill="#F3EBDC"/>
          <rect x="164" y="108" width="30" height="22" fill="#F3EBDC"/>
          <path d="M64 303h22M64 310h14M168 303h22M168 310h14M272 303h22M272 310h14M116 203h22M116 210h14M220 203h22M220 210h14M168 115h22M168 122h14" stroke="#1B1712" stroke-width="1.5"/>
          <path d="M430 150V372H500M430 372l-10 12M418 162H444" stroke="#8C7A63" stroke-width="4"/>
          <circle cx="446" cy="380" r="12" stroke="#8C7A63" stroke-width="4"/>
          <circle cx="490" cy="380" r="12" stroke="#8C7A63" stroke-width="4"/>
          <rect x="440" y="290" width="68" height="80" fill="#C9A06B" stroke="#7A5A33" stroke-width="1.5"/>
          <rect x="444" y="222" width="60" height="68" fill="#B98E5A" stroke="#7A5A33" stroke-width="1.5"/>
          <path d="M474 290V370M474 222V290" stroke="#D9B37C" stroke-width="8"/>
          <rect x="368" y="318" width="54" height="48" fill="#B98E5A" stroke="#7A5A33" stroke-width="1.5"/>
          <path d="M395 318V366" stroke="#D9B37C" stroke-width="7"/>
          {%- if apgo_intro_sign != blank -%}
            <path d="M430 34V54M540 34V54" stroke="#8C7A63" stroke-width="2"/>
            <rect x="400" y="54" width="160" height="44" fill="#F3EBDC"/>
            <text class="apgo-crate-intro__sign" x="480" y="82" text-anchor="middle" font-size="15" font-weight="700" fill="#1B1712">{{ apgo_intro_sign | escape }}</text>
          {%- endif -%}
          {%- if apgo_stamp != blank -%}
            <g transform="rotate(8 327 112)">
              <rect x="{{ apgo_stamp_tall_x }}" y="92" width="{{ apgo_stamp_tall_w }}" height="40" fill="none" stroke="#F0655A" stroke-width="3"/>
              <text class="apgo-crate-intro__svg-stamp" x="327" y="120" text-anchor="middle" font-size="21" letter-spacing="2" fill="#F0655A">{{ apgo_stamp | escape }}</text>
            </g>
          {%- endif -%}
        </svg>
      {%- endif -%}
      {%- if section.settings.image != blank and apgo_stamp != blank -%}
        <span class="apgo-crate-intro__stamp" aria-hidden="true">{{ apgo_stamp | escape }}</span>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="apgo-crate-intro__tags" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign apgo_tag_text = block.settings.text
            if localization.country.iso_code == 'SG' and block.settings.text_sg != blank
              assign apgo_tag_text = block.settings.text_sg
            endif
          -%}
          {%- if apgo_tag_text != blank -%}
            <li class="apgo-crate-intro__tag" {{ block.shopify_attributes }}>
              <span class="apgo-crate-intro__tag-hole" aria-hidden="true"></span>
              <svg class="apgo-crate-intro__tag-icon" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                {%- case block.settings.icon -%}
                  {%- when 'box' -%}
                    <path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/>
                  {%- when 'truck' -%}
                    <path d="M2 6h11v10H2zM13 10h4l4 4v2h-8z"/><circle cx="6" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>
                  {%- when 'clock' -%}
                    <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
                  {%- when 'percent' -%}
                    <path d="M5 19L19 5"/><circle cx="7" cy="7" r="2.2"/><circle cx="17" cy="17" r="2.2"/>
                  {%- else -%}
                    <path d="M3 12V4h8l10 10-8 8z"/><circle cx="7.5" cy="8.5" r="1.4"/>
                {%- endcase -%}
              </svg>
              <span class="apgo-crate-intro__tag-text">{{ apgo_tag_text | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Clearance intro",
  "tag": "section",
  "class": "apgo-crate-section",
  "max_blocks": 4,
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Chip above the heading",
      "default": "Factory expansion · 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything",
      "info": "This is the page's main title (h1)."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading, orange part",
      "default": "must go"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "We're moving into a bigger factory, and the old stock has to go first. Clearance prices while stocks last."
    },
    {
      "type": "inline_richtext",
      "id": "offer",
      "label": "Offer line",
      "info": "The deal in one line, e.g. Up to 50% off · Ends 31 Oct. Bold words show in red. Hidden while blank."
    },
    {
      "type": "inline_richtext",
      "id": "offer_sg",
      "label": "Offer line for Singapore (optional)",
      "info": "Shown to Singapore shoppers instead of the line above."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the clearance"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Use #clearance-deals to jump to the deals on this page."
    },
    {
      "type": "header",
      "content": "Illustration"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo (optional)",
      "info": "Replaces the box illustration, e.g. a real warehouse photo."
    },
    {
      "type": "text",
      "id": "stamp",
      "label": "Red stamp",
      "default": "Clearance"
    },
    {
      "type": "text",
      "id": "sign",
      "label": "Sign on the illustration",
      "default": "New factory →",
      "info": "Shown on computers only."
    }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Tag",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "price_tag", "label": "Price tag" },
            { "value": "box", "label": "Box" },
            { "value": "truck", "label": "Truck" },
            { "value": "clock", "label": "Clock" },
            { "value": "percent", "label": "Percent" }
          ],
          "default": "price_tag"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Clearance prices"
        },
        {
          "type": "text",
          "id": "text_sg",
          "label": "Singapore text (optional)",
          "info": "Shown to Singapore shoppers instead, e.g. a different shipping time."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clearance intro",
      "category": "APGO",
      "blocks": [
        { "type": "tag", "settings": { "icon": "price_tag", "text": "Clearance prices" } },
        { "type": "tag", "settings": { "icon": "box", "text": "While stocks last" } },
        {
          "type": "tag",
          "settings": {
            "icon": "truck",
            "text": "Ships in 2–3 business days",
            "text_sg": "Ships in 3–5 business days"
          }
        }
      ]
    }
  ]
}
{% endschema %}
