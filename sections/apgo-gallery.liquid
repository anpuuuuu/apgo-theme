{%- liquid
  assign portrait_count = 0
  assign landscape_count = 0

  for block in section.blocks
    if block.settings.image != blank
      if block.type == 'portrait'
        assign portrait_count = portrait_count | plus: 1
      elsif block.type == 'landscape'
        assign landscape_count = landscape_count | plus: 1
      endif
    endif
  endfor

  assign gallery_count = portrait_count | plus: landscape_count
  if section.settings.main_image != blank
    assign gallery_count = gallery_count | plus: 1
  endif
-%}

{%- if section.settings.main_image != blank -%}
  {%- assign main_alt = section.settings.main_alt | default: section.settings.main_image.alt | default: section.settings.heading -%}
  <section
    id="ApgoGallery-{{ section.id }}"
    class="apgo-gallery"
    data-apgo-gallery
    style="
      --apgo-gallery-max-width: {{ section.settings.max_width }}px;
      --apgo-gallery-ratio: {{ section.settings.viewer_ratio }};
      --apgo-gallery-background: {{ section.settings.background_color }};
      --apgo-gallery-frame: {{ section.settings.frame_color }};
      --apgo-gallery-accent: {{ section.settings.accent_color }};
      --apgo-gallery-radius: {{ section.settings.radius }}px;
      --apgo-gallery-padding-top: {{ section.settings.padding_top }}px;
      --apgo-gallery-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="apgo-gallery__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="apgo-gallery__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <figure
        class="apgo-gallery__viewer"
        data-apgo-gallery-source
        data-gallery-index="0"
        data-gallery-src="{{ section.settings.main_image | image_url: width: 2400 }}"
        data-gallery-alt="{{ main_alt | escape }}"
        data-gallery-caption="{{ section.settings.main_caption | escape }}"
        tabindex="0"
        aria-label="{{ section.settings.heading | default: 'Gallery' | escape }}"
      >
        {{
          section.settings.main_image
          | image_url: width: 2400
          | image_tag:
            class: 'apgo-gallery__viewer-image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '480, 720, 960, 1200, 1600, 2000, 2400',
            sizes: '(min-width: 1200px) 1160px, calc(100vw - 32px)',
            alt: main_alt
        }}

        <figcaption
          class="apgo-gallery__viewer-caption{% if section.settings.main_caption == blank %} is-hidden{% endif %}"
          data-apgo-gallery-viewer-caption
        >
          {{ section.settings.main_caption | escape }}
        </figcaption>

        {%- if gallery_count > 1 and section.settings.show_main_arrows -%}
          <button
            type="button"
            class="apgo-gallery__viewer-arrow apgo-gallery__viewer-arrow--previous"
            data-apgo-gallery-previous
            aria-label="{{ 'accessibility.slideshow_previous' | t }}"
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>
          <button
            type="button"
            class="apgo-gallery__viewer-arrow apgo-gallery__viewer-arrow--next"
            data-apgo-gallery-next
            aria-label="{{ 'accessibility.slideshow_next' | t }}"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
        {%- endif -%}

        {%- if gallery_count > 1 and section.settings.show_counter -%}
          <div class="apgo-gallery__counter" aria-live="polite">
            <span data-apgo-gallery-current>1</span>
            <span aria-hidden="true">/</span>
            <span>{{ gallery_count }}</span>
          </div>
        {%- endif -%}
      </figure>

      {%- assign media_index = 1 -%}

      {%- if portrait_count > 0 -%}
        <div class="apgo-gallery__region apgo-gallery__region--portrait">
          {%- if section.settings.portrait_heading != blank -%}
            <h3 class="apgo-gallery__region-heading">{{ section.settings.portrait_heading | escape }}</h3>
          {%- endif -%}
          <div class="apgo-gallery__rail-shell" data-apgo-gallery-rail-shell>
            <div class="apgo-gallery__rail" data-apgo-gallery-rail>
              {%- for block in section.blocks -%}
                {%- if block.type == 'portrait' and block.settings.image != blank -%}
                  {%- assign portrait_alt = block.settings.alt_text | default: block.settings.image.alt | default: section.settings.portrait_heading -%}
                  {%- assign portrait_position = media_index | plus: 1 -%}
                  <button
                    type="button"
                    class="apgo-gallery__card apgo-gallery__card--portrait"
                    data-apgo-gallery-source
                    data-apgo-gallery-card
                    data-gallery-index="{{ media_index }}"
                    data-gallery-block-id="{{ block.id }}"
                    data-gallery-src="{{ block.settings.image | image_url: width: 2400 }}"
                    data-gallery-alt="{{ portrait_alt | escape }}"
                    data-gallery-caption="{{ block.settings.caption | escape }}"
                    aria-label="{{ 'accessibility.slide_status' | t: index: portrait_position, length: gallery_count }}"
                    aria-current="false"
                    {{ block.shopify_attributes }}
                  >
                    {{
                      block.settings.image
                      | image_url: width: 600
                      | image_tag:
                        class: 'apgo-gallery__card-image',
                        loading: 'lazy',
                        widths: '180, 260, 360, 480, 600',
                        sizes: '(max-width: 749px) 38vw, 180px',
                        alt: portrait_alt
                    }}
                    {%- if block.settings.caption != blank -%}
                      <span class="apgo-gallery__card-caption">{{ block.settings.caption | escape }}</span>
                    {%- endif -%}
                  </button>
                  {%- assign media_index = media_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if portrait_count > 1 and section.settings.show_rail_arrows -%}
              <button
                type="button"
                class="apgo-gallery__rail-arrow apgo-gallery__rail-arrow--previous"
                data-apgo-gallery-rail-previous
                aria-label="{{ 'accessibility.slideshow_previous' | t }}"
                disabled
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m15 18-6-6 6-6"></path>
                </svg>
              </button>
              <button
                type="button"
                class="apgo-gallery__rail-arrow apgo-gallery__rail-arrow--next"
                data-apgo-gallery-rail-next
                aria-label="{{ 'accessibility.slideshow_next' | t }}"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"></path>
                </svg>
              </button>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if landscape_count > 0 -%}
        <div class="apgo-gallery__region apgo-gallery__region--landscape">
          {%- if section.settings.landscape_heading != blank -%}
            <h3 class="apgo-gallery__region-heading">{{ section.settings.landscape_heading | escape }}</h3>
          {%- endif -%}
          <div class="apgo-gallery__rail-shell" data-apgo-gallery-rail-shell>
            <div class="apgo-gallery__rail" data-apgo-gallery-rail>
              {%- for block in section.blocks -%}
                {%- if block.type == 'landscape' and block.settings.image != blank -%}
                  {%- assign landscape_alt = block.settings.alt_text | default: block.settings.image.alt | default: section.settings.landscape_heading -%}
                  {%- assign landscape_position = media_index | plus: 1 -%}
                  <button
                    type="button"
                    class="apgo-gallery__card apgo-gallery__card--landscape"
                    data-apgo-gallery-source
                    data-apgo-gallery-card
                    data-gallery-index="{{ media_index }}"
                    data-gallery-block-id="{{ block.id }}"
                    data-gallery-src="{{ block.settings.image | image_url: width: 2400 }}"
                    data-gallery-alt="{{ landscape_alt | escape }}"
                    data-gallery-caption="{{ block.settings.caption | escape }}"
                    aria-label="{{ 'accessibility.slide_status' | t: index: landscape_position, length: gallery_count }}"
                    aria-current="false"
                    {{ block.shopify_attributes }}
                  >
                    {{
                      block.settings.image
                      | image_url: width: 1000
                      | image_tag:
                        class: 'apgo-gallery__card-image',
                        loading: 'lazy',
                        widths: '320, 480, 640, 800, 1000',
                        sizes: '(max-width: 749px) 76vw, 340px',
                        alt: landscape_alt
                    }}
                    {%- if block.settings.caption != blank -%}
                      <span class="apgo-gallery__card-caption">{{ block.settings.caption | escape }}</span>
                    {%- endif -%}
                  </button>
                  {%- assign media_index = media_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if landscape_count > 1 and section.settings.show_rail_arrows -%}
              <button
                type="button"
                class="apgo-gallery__rail-arrow apgo-gallery__rail-arrow--previous"
                data-apgo-gallery-rail-previous
                aria-label="{{ 'accessibility.slideshow_previous' | t }}"
                disabled
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m15 18-6-6 6-6"></path>
                </svg>
              </button>
              <button
                type="button"
                class="apgo-gallery__rail-arrow apgo-gallery__rail-arrow--next"
                data-apgo-gallery-rail-next
                aria-label="{{ 'accessibility.slideshow_next' | t }}"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"></path>
                </svg>
              </button>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .apgo-gallery {
    width: 100%;
    padding: var(--apgo-gallery-padding-top, 36px) 16px var(--apgo-gallery-padding-bottom, 36px);
    background: var(--apgo-gallery-background, #050505);
    box-sizing: border-box;
  }

  .apgo-gallery *,
  .apgo-gallery *::before,
  .apgo-gallery *::after {
    box-sizing: border-box;
  }

  .apgo-gallery__inner {
    width: min(100%, var(--apgo-gallery-max-width, 1200px));
    margin-inline: auto;
  }

  .apgo-gallery__heading {
    margin: 0 0 20px;
    color: #ffffff;
    font-size: clamp(24px, 4vw, 42px);
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
  }

  .apgo-gallery__viewer {
    position: relative;
    display: grid;
    width: 100%;
    margin: 0;
    overflow: hidden;
    aspect-ratio: var(--apgo-gallery-ratio, 16 / 9);
    place-items: center;
    border: 1px solid var(--apgo-gallery-frame, #3d4148);
    border-radius: var(--apgo-gallery-radius, 12px);
    background: #000000;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.34);
  }

  .apgo-gallery__viewer:focus-visible {
    outline: 2px solid var(--apgo-gallery-accent, #e3b34d);
    outline-offset: 3px;
  }

  .apgo-gallery__viewer-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    user-select: none;
    -webkit-user-drag: none;
  }

  .apgo-gallery__viewer-caption {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    padding: 44px 64px 16px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.82));
    color: #ffffff;
    font-size: 14px;
    line-height: 1.4;
    text-align: center;
  }

  .apgo-gallery__viewer-caption.is-hidden {
    display: none;
  }

  .apgo-gallery__viewer-arrow,
  .apgo-gallery__rail-arrow {
    display: grid;
    padding: 0;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.52);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.78);
    color: #ffffff;
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.34);
    cursor: pointer;
    transition: opacity 180ms ease, background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .apgo-gallery__viewer-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 50px;
    height: 50px;
    transform: translateY(-50%);
  }

  .apgo-gallery__viewer-arrow--previous {
    left: 16px;
  }

  .apgo-gallery__viewer-arrow--next {
    right: 16px;
  }

  .apgo-gallery__viewer-arrow:hover:not(:disabled),
  .apgo-gallery__rail-arrow:hover:not(:disabled) {
    background: var(--apgo-gallery-accent, #e3b34d);
    color: #050505;
  }

  .apgo-gallery__viewer-arrow:hover:not(:disabled) {
    transform: translateY(-50%) scale(1.04);
  }

  .apgo-gallery__viewer-arrow:focus-visible,
  .apgo-gallery__rail-arrow:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .apgo-gallery__viewer-arrow:disabled,
  .apgo-gallery__rail-arrow:disabled {
    opacity: 0.24;
    cursor: default;
  }

  .apgo-gallery__viewer-arrow svg,
  .apgo-gallery__rail-arrow svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .apgo-gallery__counter {
    position: absolute;
    right: 14px;
    bottom: 12px;
    z-index: 2;
    display: flex;
    gap: 5px;
    padding: 6px 10px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.76);
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
  }

  .apgo-gallery__region {
    margin-top: clamp(24px, 4vw, 44px);
  }

  .apgo-gallery__region-heading {
    margin: 0 0 12px;
    color: #ffffff;
    font-size: clamp(17px, 2vw, 24px);
    font-weight: 750;
    line-height: 1.2;
  }

  .apgo-gallery__rail-shell {
    position: relative;
  }

  .apgo-gallery__rail {
    display: flex;
    gap: 12px;
    padding: 2px 2px 9px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x proximity;
    scrollbar-color: rgba(227, 179, 77, 0.62) rgba(255, 255, 255, 0.08);
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .apgo-gallery__card {
    position: relative;
    display: block;
    flex-shrink: 0;
    padding: 0;
    overflow: hidden;
    scroll-snap-align: start;
    border: 2px solid transparent;
    border-radius: max(6px, calc(var(--apgo-gallery-radius, 12px) - 3px));
    background: #000000;
    opacity: 0.78;
    cursor: pointer;
    transition: border-color 180ms ease, opacity 180ms ease, transform 180ms ease;
  }

  .apgo-gallery__card--portrait {
    flex-basis: clamp(142px, 16vw, 188px);
    aspect-ratio: 3 / 4;
  }

  .apgo-gallery__card--landscape {
    flex-basis: clamp(260px, 30vw, 360px);
    aspect-ratio: 16 / 9;
  }

  .apgo-gallery__card:hover,
  .apgo-gallery__card.is-active {
    border-color: var(--apgo-gallery-accent, #e3b34d);
    opacity: 1;
  }

  .apgo-gallery__card:hover {
    transform: translateY(-2px);
  }

  .apgo-gallery__card:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  .apgo-gallery__card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    background: #000000;
    user-select: none;
    -webkit-user-drag: none;
  }

  .apgo-gallery__card-caption {
    position: absolute;
    inset: auto 0 0;
    padding: 24px 10px 8px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.82));
    color: #ffffff;
    font-size: 11px;
    font-weight: 650;
    line-height: 1.3;
    text-align: left;
  }

  .apgo-gallery__rail-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 46px;
    height: 46px;
    transform: translateY(-56%);
  }

  .apgo-gallery__rail-arrow--previous {
    left: 10px;
  }

  .apgo-gallery__rail-arrow--next {
    right: 10px;
  }

  @media (max-width: 749px) {
    .apgo-gallery {
      padding-inline: 10px;
    }

    .apgo-gallery__heading {
      margin-bottom: 14px;
      font-size: clamp(22px, 8vw, 32px);
    }

    .apgo-gallery__viewer-arrow {
      width: 42px;
      height: 42px;
    }

    .apgo-gallery__viewer-arrow--previous {
      left: 8px;
    }

    .apgo-gallery__viewer-arrow--next {
      right: 8px;
    }

    .apgo-gallery__viewer-caption {
      padding: 30px 52px 10px;
      font-size: 12px;
    }

    .apgo-gallery__region {
      margin-top: 24px;
    }

    .apgo-gallery__region-heading {
      margin-bottom: 9px;
      font-size: 17px;
    }

    .apgo-gallery__rail {
      gap: 8px;
    }

    .apgo-gallery__card--portrait {
      flex-basis: 38vw;
      max-width: 164px;
    }

    .apgo-gallery__card--landscape {
      flex-basis: 76vw;
      max-width: 330px;
    }

    .apgo-gallery__rail-arrow {
      width: 42px;
      height: 42px;
    }

    .apgo-gallery__rail-arrow--previous {
      left: 6px;
    }

    .apgo-gallery__rail-arrow--next {
      right: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apgo-gallery__rail {
      scroll-behavior: auto;
    }

    .apgo-gallery__viewer-arrow,
    .apgo-gallery__rail-arrow,
    .apgo-gallery__card {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const initializeGallery = (root) => {
      if (!root || root.dataset.apgoGalleryReady === 'true') return;

      const viewer = root.querySelector('.apgo-gallery__viewer');
      const viewerImage = root.querySelector('.apgo-gallery__viewer-image');
      const viewerCaption = root.querySelector('[data-apgo-gallery-viewer-caption]');
      const sources = Array.from(root.querySelectorAll('[data-apgo-gallery-source]'));
      const cards = Array.from(root.querySelectorAll('[data-apgo-gallery-card]'));
      const previousButton = root.querySelector('[data-apgo-gallery-previous]');
      const nextButton = root.querySelector('[data-apgo-gallery-next]');
      const currentLabel = root.querySelector('[data-apgo-gallery-current]');

      if (!viewer || !viewerImage || sources.length === 0) return;

      root.dataset.apgoGalleryReady = 'true';
      let currentIndex = 0;
      let touchStartX = 0;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const showMedia = (index) => {
        const nextIndex = Math.max(0, Math.min(index, sources.length - 1));
        const source = sources[nextIndex];
        if (!source) return;

        currentIndex = nextIndex;
        viewerImage.removeAttribute('srcset');
        viewerImage.removeAttribute('sizes');
        viewerImage.src = source.dataset.gallerySrc;
        viewerImage.alt = source.dataset.galleryAlt || '';

        const caption = source.dataset.galleryCaption || '';
        if (viewerCaption) {
          viewerCaption.textContent = caption;
          viewerCaption.classList.toggle('is-hidden', caption.length === 0);
        }

        cards.forEach((card) => {
          const isActive = Number(card.dataset.galleryIndex) === currentIndex;
          card.classList.toggle('is-active', isActive);
          card.setAttribute('aria-current', isActive ? 'true' : 'false');
        });

        if (previousButton) previousButton.disabled = currentIndex === 0;
        if (nextButton) nextButton.disabled = currentIndex === sources.length - 1;
        if (currentLabel) currentLabel.textContent = String(currentIndex + 1);

        const activeCard = cards.find((card) => Number(card.dataset.galleryIndex) === currentIndex);
        if (activeCard) {
          const rail = activeCard.closest('[data-apgo-gallery-rail]');
          if (rail) {
            const targetLeft = activeCard.offsetLeft - rail.offsetLeft - 12;
            rail.scrollTo({ left: targetLeft, behavior: reduceMotion ? 'auto' : 'smooth' });
          }
        }
      };

      cards.forEach((card) => {
        card.addEventListener('click', () => showMedia(Number(card.dataset.galleryIndex)));
      });

      if (previousButton) previousButton.addEventListener('click', () => showMedia(currentIndex - 1));
      if (nextButton) nextButton.addEventListener('click', () => showMedia(currentIndex + 1));

      viewer.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          showMedia(currentIndex - 1);
        }
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          showMedia(currentIndex + 1);
        }
      });

      viewer.addEventListener('touchstart', (event) => {
        touchStartX = event.changedTouches[0].clientX;
      }, { passive: true });

      viewer.addEventListener('touchend', (event) => {
        const distance = event.changedTouches[0].clientX - touchStartX;
        if (Math.abs(distance) < 45) return;
        showMedia(distance > 0 ? currentIndex - 1 : currentIndex + 1);
      }, { passive: true });

      root.querySelectorAll('[data-apgo-gallery-rail-shell]').forEach((shell) => {
        const rail = shell.querySelector('[data-apgo-gallery-rail]');
        const railPrevious = shell.querySelector('[data-apgo-gallery-rail-previous]');
        const railNext = shell.querySelector('[data-apgo-gallery-rail-next]');
        if (!rail) return;

        let frame = 0;
        const updateRailButtons = () => {
          frame = 0;
          const maxScroll = Math.max(0, rail.scrollWidth - rail.clientWidth);
          if (railPrevious) railPrevious.disabled = rail.scrollLeft <= 2;
          if (railNext) railNext.disabled = rail.scrollLeft >= maxScroll - 2;
        };

        const scrollRail = (direction) => {
          rail.scrollBy({
            left: direction * rail.clientWidth * 0.82,
            behavior: reduceMotion ? 'auto' : 'smooth'
          });
        };

        rail.addEventListener('scroll', () => {
          if (!frame) frame = window.requestAnimationFrame(updateRailButtons);
        }, { passive: true });

        if (railPrevious) railPrevious.addEventListener('click', () => scrollRail(-1));
        if (railNext) railNext.addEventListener('click', () => scrollRail(1));
        updateRailButtons();
      });

      showMedia(0);
    };

    const initializeAllGalleries = (scope = document) => {
      scope.querySelectorAll('[data-apgo-gallery]').forEach(initializeGallery);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initializeAllGalleries());
    } else {
      initializeAllGalleries();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initializeAllGalleries(event.target);
    });

    document.addEventListener('shopify:block:select', (event) => {
      const root = event.target.closest('[data-apgo-gallery]');
      if (!root) return;
      const card = root.querySelector(`[data-apgo-gallery-card][data-gallery-block-id="${event.detail.blockId}"]`);
      if (card) card.click();
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Gallery",
  "tag": "section",
  "class": "apgo-gallery-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Gallery heading",
      "default": "Gallery"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main landscape image"
    },
    {
      "type": "text",
      "id": "main_alt",
      "label": "Main image alt text"
    },
    {
      "type": "text",
      "id": "main_caption",
      "label": "Main image caption"
    },
