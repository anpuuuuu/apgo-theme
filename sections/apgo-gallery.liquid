{%- liquid
  assign portrait_count = 0
  assign landscape_count = 0

  for block in section.blocks
    if block.settings.image != blank
      if block.type == 'portrait'
        assign portrait_count = portrait_count | plus: 1
      elsif block.type == 'landscape'
        assign landscape_count = landscape_count | plus: 1
      endif
    endif
  endfor

-%}

{%- if section.settings.main_image != blank -%}
  {%- assign main_alt = section.settings.main_alt | default: section.settings.main_image.alt | default: section.settings.heading -%}
  <script src="{{ 'apgo-campaign-tracking.js' | asset_url }}" defer></script>
  <section
    id="ApgoGallery-{{ section.id }}"
    class="apgo-gallery"
    data-apgo-gallery
    style="
      --apgo-gallery-max-width: {{ section.settings.max_width }}px;
      --apgo-gallery-ratio: {{ section.settings.viewer_ratio }};
      --apgo-gallery-background: {{ section.settings.background_color }};
      --apgo-gallery-frame: {{ section.settings.frame_color }};
      --apgo-gallery-accent: {{ section.settings.accent_color }};
      --apgo-gallery-radius: {{ section.settings.radius }}px;
      --apgo-gallery-padding-top: {{ section.settings.padding_top }}px;
      --apgo-gallery-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="apgo-gallery__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="apgo-gallery__heading">
          <span class="apgo-gallery__heading-star" aria-hidden="true">★</span>
          <span>{{ section.settings.heading | escape }}</span>
          <span class="apgo-gallery__heading-star" aria-hidden="true">★</span>
        </h2>
      {%- endif -%}

      <figure
        class="apgo-gallery__viewer"
        aria-label="{{ section.settings.heading | default: 'Gallery' | escape }}"
      >
        {{
          section.settings.main_image
          | image_url: width: 2400
          | image_tag:
            class: 'apgo-gallery__viewer-image',
            loading: 'eager',
            fetchpriority: 'high',
            widths: '480, 720, 960, 1200, 1600, 2000, 2400',
            sizes: '(min-width: 1200px) 1160px, calc(100vw - 32px)',
            alt: main_alt
        }}

        <figcaption
          class="apgo-gallery__viewer-caption{% if section.settings.main_caption == blank %} is-hidden{% endif %}"
          data-apgo-gallery-viewer-caption
        >
          {{ section.settings.main_caption | escape }}
        </figcaption>

      </figure>

      {%- if portrait_count > 0 -%}
        <div class="apgo-gallery__region apgo-gallery__region--portrait">
          {%- if section.settings.portrait_heading != blank -%}
            <h3 class="apgo-gallery__region-heading">
              <span class="apgo-gallery__heading-star" aria-hidden="true">★</span>
              <span>{{ section.settings.portrait_heading | escape }}</span>
              <span class="apgo-gallery__heading-star" aria-hidden="true">★</span>
            </h3>
          {%- endif -%}
          <div class="apgo-gallery__rail-shell" data-apgo-gallery-rail-shell>
            <div
              class="apgo-gallery__rail"
              data-apgo-gallery-rail
              data-apgo-gallery-section-id="gallery_portrait"
              data-apgo-gallery-section-name="{{ section.settings.portrait_heading | default: section.settings.heading | default: 'Gallery portrait' | escape }}"
              data-apgo-gallery-section-position="1"
            >
              {%- for block in section.blocks -%}
                {%- if block.type == 'portrait' and block.settings.image != blank -%}
                  {%- assign portrait_alt = block.settings.alt_text | default: block.settings.image.alt | default: section.settings.portrait_heading -%}
                  <figure
                    class="apgo-gallery__card apgo-gallery__card--portrait"
                    data-gallery-block-id="{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    {{
                      block.settings.image
                      | image_url: width: 600
                      | image_tag:
                        class: 'apgo-gallery__card-image',
                        loading: 'lazy',
                        widths: '180, 260, 360, 480, 600',
                        sizes: '(max-width: 749px) 38vw, 180px',
                        alt: portrait_alt
                    }}
                    {%- if block.settings.caption != blank -%}
                      <figcaption class="apgo-gallery__card-caption">{{ block.settings.caption | escape }}</figcaption>
                    {%- endif -%}
                  </figure>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if portrait_count > 1 and section.settings.show_rail_arrows -%}
              <button
                type="button"
                class="apgo-gallery__rail-arrow apgo-gallery__rail-arrow--previous"
                data-apgo-gallery-rail-previous
                aria-label="{{ 'accessibility.slideshow_previous' | t }}"
                disabled
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m15 18-6-6 6-6"></path>
                </svg>
              </button>
              <button
                type="button"
                class="apgo-gallery__rail-arrow apgo-gallery__rail-arrow--next"
                data-apgo-gallery-rail-next
                aria-label="{{ 'accessibility.slideshow_next' | t }}"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"></path>
                </svg>
              </button>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if landscape_count > 0 -%}
        <div class="apgo-gallery__region apgo-gallery__region--landscape">
          {%- if section.settings.landscape_heading != blank -%}
            <h3 class="apgo-gallery__region-heading">
              <span class="apgo-gallery__heading-star" aria-hidden="true">★</span>
              <span>{{ section.settings.landscape_heading | escape }}</span>
              <span class="apgo-gallery__heading-star" aria-hidden="true">★</span>
            </h3>
          {%- endif -%}
          <div class="apgo-gallery__rail-shell" data-apgo-gallery-rail-shell>
            <div
              class="apgo-gallery__rail"
              data-apgo-gallery-rail
              data-apgo-gallery-section-id="gallery_landscape"
              data-apgo-gallery-section-name="{{ section.settings.landscape_heading | default: section.settings.heading | default: 'Gallery landscape' | escape }}"
              data-apgo-gallery-section-position="2"
            >
              {%- for block in section.blocks -%}
                {%- if block.type == 'landscape' and block.settings.image != blank -%}
                  {%- assign landscape_alt = block.settings.alt_text | default: block.settings.image.alt | default: section.settings.landscape_heading -%}
                  <figure
                    class="apgo-gallery__card apgo-gallery__card--landscape"
                    data-gallery-block-id="{{ block.id }}"
                    {{ block.shopify_attributes }}
                  >
                    {{
                      block.settings.image
                      | image_url: width: 1000
                      | image_tag:
                        class: 'apgo-gallery__card-image',
                        loading: 'lazy',
                        widths: '320, 480, 640, 800, 1000',
                        sizes: '(max-width: 749px) 76vw, 340px',
                        alt: landscape_alt
                    }}
                    {%- if block.settings.caption != blank -%}
                      <figcaption class="apgo-gallery__card-caption">{{ block.settings.caption | escape }}</figcaption>
                    {%- endif -%}
                  </figure>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if landscape_count > 1 and section.settings.show_rail_arrows -%}
              <button
                type="button"
                class="apgo-gallery__rail-arrow apgo-gallery__rail-arrow--previous"
                data-apgo-gallery-rail-previous
                aria-label="{{ 'accessibility.slideshow_previous' | t }}"
                disabled
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m15 18-6-6 6-6"></path>
                </svg>
              </button>
              <button
                type="button"
                class="apgo-gallery__rail-arrow apgo-gallery__rail-arrow--next"
                data-apgo-gallery-rail-next
                aria-label="{{ 'accessibility.slideshow_next' | t }}"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m9 18 6-6-6-6"></path>
                </svg>
              </button>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .apgo-gallery {
    width: 100%;
    padding: var(--apgo-gallery-padding-top, 36px) 16px var(--apgo-gallery-padding-bottom, 36px);
    background: var(--apgo-gallery-background, #050505);
    box-sizing: border-box;
  }

  .apgo-gallery *,
  .apgo-gallery *::before,
  .apgo-gallery *::after {
    box-sizing: border-box;
  }

  .apgo-gallery__inner {
    width: min(100%, var(--apgo-gallery-max-width, 1200px));
    margin-inline: auto;
  }

  body.apgo-golden-bull-page .apgo-gallery {
    width: 100%;
    margin-inline: auto;
    background: var(--apgo-event-panel-bg-gradient, var(--apgo-gallery-background, #050505));
    border: 1px solid rgba(242, 227, 179, 0.46);
    border-radius: 16px;
    box-shadow:
      inset 0 0 0 1px rgba(255, 252, 237, 0.09),
      0 18px 44px rgba(0, 0, 0, 0.42);
  }

  body.apgo-golden-bull-page
    .shopify-section.apgo-event-collection-grid-wrapper:has(+ .shopify-section.apgo-gallery-section)
    .apgo-event-collection-grid__panel {
    border-bottom-color: transparent !important;
    border-bottom-right-radius: 0 !important;
    border-bottom-left-radius: 0 !important;
    box-shadow: inset 0 0 0 1px rgba(255, 252, 237, 0.09);
  }

  body.apgo-golden-bull-page
    .shopify-section.apgo-event-collection-grid-wrapper:has(+ .shopify-section.apgo-gallery-section)
    .apgo-event-collection-grid__panel-body {
    padding-bottom: clamp(16px, 2.5vw, 26px) !important;
  }

  body.apgo-golden-bull-page
    .shopify-section.apgo-event-collection-grid-wrapper
    + .shopify-section.apgo-gallery-section {
    margin-top: 0 !important;
  }

  body.apgo-golden-bull-page
    .shopify-section.apgo-event-collection-grid-wrapper
    + .shopify-section.apgo-gallery-section
    .apgo-gallery {
      margin-top: -1px;
      padding-top: clamp(20px, 3vw, 32px);
      background:
        linear-gradient(
          180deg,
          #020509 0,
          rgba(2, 5, 9, 0.94) 18px,
          rgba(7, 16, 25, 0.62) 72px,
          transparent 132px
        ),
        var(--apgo-event-panel-bg-gradient, var(--apgo-gallery-background, #050505));
      border-top: 0;
      border-top-left-radius: 0;
      border-top-right-radius: 0;
  }

  body.apgo-golden-bull-page .apgo-gallery__inner {
    width: 100%;
  }

  @media (min-width: 750px) {
    body.apgo-golden-bull-page .apgo-gallery {
      width: var(--apgo-event-content-desktop-width, 67%);
      padding-inline: clamp(16px, 2.2vw, 30px);
    }
  }

  .apgo-gallery__heading {
    margin: 0 0 20px;
    color: #ffffff;
    font-size: clamp(24px, 4vw, 42px);
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
  }

  .apgo-gallery__heading-star {
    display: none;
  }

  body.apgo-golden-bull-page .apgo-gallery__heading,
  body.apgo-golden-bull-page .apgo-gallery__region-heading {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6em;
    color: var(--apgo-award-gold-core, #e3b34d);
    background: var(
      --apgo-event-heading-gradient,
      linear-gradient(90deg, #d8bf7a, #fffced 48%, #e3b34d)
    );
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-size: clamp(15px, 2.5vw, 23px);
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.14em;
    text-align: center;
    text-transform: uppercase;
  }

  body.apgo-golden-bull-page .apgo-gallery__heading {
    margin-bottom: clamp(14px, 2.5vw, 22px);
  }

  body.apgo-golden-bull-page .apgo-gallery__region-heading {
    margin-bottom: clamp(14px, 2.5vw, 22px);
  }

  body.apgo-golden-bull-page .apgo-gallery__heading::before,
  body.apgo-golden-bull-page .apgo-gallery__heading::after,
  body.apgo-golden-bull-page .apgo-gallery__region-heading::before,
  body.apgo-golden-bull-page .apgo-gallery__region-heading::after {
    content: '';
    flex: 0 1 76px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(242, 227, 179, 0.8));
  }

  body.apgo-golden-bull-page .apgo-gallery__heading::after,
  body.apgo-golden-bull-page .apgo-gallery__region-heading::after {
    transform: scaleX(-1);
  }

  body.apgo-golden-bull-page .apgo-gallery__heading-star {
    display: inline;
    flex: 0 0 auto;
    color: var(--apgo-award-gold-core, #e3b34d);
    font-size: 0.85em;
    -webkit-text-fill-color: var(--apgo-award-gold-core, #e3b34d);
    filter: drop-shadow(0 0 6px rgba(242, 227, 179, 0.48));
  }

  .apgo-gallery__viewer {
    position: relative;
    display: grid;
    width: 100%;
    margin: 0;
    overflow: hidden;
    aspect-ratio: var(--apgo-gallery-ratio, 16 / 9);
    place-items: center;
    border: 1px solid var(--apgo-gallery-frame, #3d4148);
    border-radius: var(--apgo-gallery-radius, 12px);
    background: #000000;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.34);
  }

  .apgo-gallery__viewer-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    user-select: none;
    -webkit-user-drag: none;
  }

  .apgo-gallery__viewer-caption {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    padding: 44px 64px 16px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.82));
    color: #ffffff;
    font-size: 14px;
    line-height: 1.4;
    text-align: center;
  }

  .apgo-gallery__viewer-caption.is-hidden {
    display: none;
  }

  .apgo-gallery__rail-arrow {
    display: grid;
    padding: 0;
    place-items: center;
    border: 1px solid rgba(242, 227, 179, 0.42);
    border-radius: 50%;
    background: rgba(3, 8, 13, 0.54);
    color: rgba(255, 252, 237, 0.92);
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(7px);
    -webkit-backdrop-filter: blur(7px);
    cursor: pointer;
    transition: opacity 180ms ease, background 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .apgo-gallery__rail-arrow:hover:not(:disabled) {
    border-color: rgba(255, 252, 237, 0.72);
    background: rgba(216, 191, 122, 0.68);
    color: #020509;
  }

  .apgo-gallery__rail-arrow:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .apgo-gallery__rail-arrow:disabled {
    opacity: 0.16;
    cursor: default;
  }

  .apgo-gallery__rail-arrow svg {
    width: 19px;
    height: 19px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .apgo-gallery__region {
    margin-top: clamp(24px, 4vw, 44px);
  }

  .apgo-gallery__region-heading {
    margin: 0 0 12px;
    color: #ffffff;
    font-size: clamp(17px, 2vw, 24px);
    font-weight: 750;
    line-height: 1.2;
  }

  .apgo-gallery__rail-shell {
    position: relative;
  }

  .apgo-gallery__rail {
    display: flex;
    gap: 12px;
    padding: 2px 2px 9px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x proximity;
    scrollbar-color: rgba(227, 179, 77, 0.62) rgba(255, 255, 255, 0.08);
    scrollbar-width: thin;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .apgo-gallery__card {
    position: relative;
    display: block;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
    scroll-snap-align: start;
    border: 1px solid var(--apgo-gallery-frame, #3d4148);
    border-radius: max(6px, calc(var(--apgo-gallery-radius, 12px) - 3px));
    background: #000000;
  }

  .apgo-gallery__card--portrait {
    flex-basis: clamp(142px, 16vw, 188px);
    aspect-ratio: 3 / 4;
  }

  .apgo-gallery__card--landscape {
    flex-basis: clamp(260px, 30vw, 360px);
    aspect-ratio: 16 / 9;
  }

  .apgo-gallery__card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    background: #000000;
    user-select: none;
    -webkit-user-drag: none;
  }

  .apgo-gallery__card-caption {
    position: absolute;
    inset: auto 0 0;
    padding: 24px 10px 8px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.82));
    color: #ffffff;
    font-size: 11px;
    font-weight: 650;
    line-height: 1.3;
    text-align: left;
  }

  .apgo-gallery__rail-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 38px;
    height: 38px;
    transform: translateY(-50%);
  }

  .apgo-gallery__rail-arrow--previous {
    left: 5px;
  }

  .apgo-gallery__rail-arrow--next {
    right: 5px;
  }

  @media (max-width: 749px) {
    .apgo-gallery {
      padding-inline: 10px;
    }

    body.apgo-golden-bull-page
      .shopify-section.apgo-event-collection-grid-wrapper
      + .shopify-section.apgo-gallery-section
      .apgo-gallery {
      padding-top: 20px;
    }

    .apgo-gallery__heading {
      margin-bottom: 14px;
      font-size: clamp(22px, 8vw, 32px);
    }

    body.apgo-golden-bull-page .apgo-gallery__heading,
    body.apgo-golden-bull-page .apgo-gallery__region-heading {
      width: 100%;
      gap: 0.32em;
      font-size: clamp(13px, 3.6vw, 14px);
      letter-spacing: 0.075em;
      white-space: nowrap;
    }

    body.apgo-golden-bull-page .apgo-gallery__heading::before,
    body.apgo-golden-bull-page .apgo-gallery__heading::after,
    body.apgo-golden-bull-page .apgo-gallery__region-heading::before,
    body.apgo-golden-bull-page .apgo-gallery__region-heading::after {
      flex: 1 1 12px;
      min-width: 8px;
    }

    .apgo-gallery__viewer-caption {
      padding: 30px 52px 10px;
      font-size: 12px;
    }

    .apgo-gallery__region {
      margin-top: 24px;
    }

    .apgo-gallery__region-heading {
      margin-bottom: 9px;
      font-size: 17px;
    }

    .apgo-gallery__rail {
      gap: 8px;
    }

    .apgo-gallery__rail-arrow {
      width: 34px;
      height: 34px;
    }

    .apgo-gallery__rail-arrow svg {
      width: 17px;
      height: 17px;
    }

    .apgo-gallery__rail-arrow--previous {
      left: 3px;
    }

    .apgo-gallery__rail-arrow--next {
      right: 3px;
    }

    .apgo-gallery__card--portrait {
      flex-basis: 38vw;
      max-width: 164px;
    }

    .apgo-gallery__card--landscape {
      flex-basis: 76vw;
      max-width: 330px;
    }

    .apgo-gallery__rail-arrow {
      width: 42px;
      height: 42px;
    }

    .apgo-gallery__rail-arrow--previous {
      left: 6px;
    }

    .apgo-gallery__rail-arrow--next {
      right: 6px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apgo-gallery__rail {
      scroll-behavior: auto;
    }

    .apgo-gallery__rail-arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const initializeGallery = (root) => {
      if (!root || root.dataset.apgoGalleryReady === 'true') return;

      root.dataset.apgoGalleryReady = 'true';
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      root.querySelectorAll('[data-apgo-gallery-rail-shell]').forEach((shell) => {
        const rail = shell.querySelector('[data-apgo-gallery-rail]');
        const railPrevious = shell.querySelector('[data-apgo-gallery-rail-previous]');
        const railNext = shell.querySelector('[data-apgo-gallery-rail-next]');
        if (!rail) return;

        let frame = 0;
        const updateRailButtons = () => {
          frame = 0;
          const maxScroll = Math.max(0, rail.scrollWidth - rail.clientWidth);
          if (railPrevious) railPrevious.disabled = rail.scrollLeft <= 2;
          if (railNext) railNext.disabled = rail.scrollLeft >= maxScroll - 2;
        };

        const scrollRail = (direction) => {
          rail.scrollBy({
            left: direction * rail.clientWidth * 0.82,
            behavior: reduceMotion ? 'auto' : 'smooth'
          });
        };

        rail.addEventListener('scroll', () => {
          if (!frame) frame = window.requestAnimationFrame(updateRailButtons);
        }, { passive: true });

        if (railPrevious) railPrevious.addEventListener('click', () => scrollRail(-1));
        if (railNext) railNext.addEventListener('click', () => scrollRail(1));
        updateRailButtons();
      });
    };

    const initializeAllGalleries = (scope = document) => {
      scope.querySelectorAll('[data-apgo-gallery]').forEach(initializeGallery);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initializeAllGalleries());
    } else {
      initializeAllGalleries();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initializeAllGalleries(event.target);
    });

    document.addEventListener('shopify:block:select', (event) => {
      const root = event.target.closest('[data-apgo-gallery]');
      if (!root) return;
      const card = root.querySelector(`[data-gallery-block-id="${event.detail.blockId}"]`);
      const rail = card ? card.closest('[data-apgo-gallery-rail]') : null;
      if (card && rail) {
        rail.scrollTo({ left: card.offsetLeft - rail.offsetLeft - 12, behavior: 'smooth' });
      }
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Gallery",
  "tag": "section",
  "class": "apgo-gallery-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Gallery heading",
      "default": "OUR GOLDEN MOMENT"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Main landscape image"
    },
    {
      "type": "text",
      "id": "main_alt",
      "label": "Main image alt text"
    },
    {
      "type": "text",
      "id": "main_caption",
      "label": "Main image caption"
    },
    {
      "type": "text",
      "id": "portrait_heading",
      "label": "Portrait section heading",
      "default": "AWARD NIGHT"
    },
    {
      "type": "text",
      "id": "landscape_heading",
      "label": "Landscape section heading"
    },
    {
      "type": "select",
      "id": "viewer_ratio",
      "label": "Main viewer aspect ratio",
      "options": [
        {
          "value": "16 / 9",
          "label": "Landscape 16:9"
        },
