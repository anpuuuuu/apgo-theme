{%- liquid
  assign gallery_count = 0
  for block in section.blocks
    if block.type == 'image' and block.settings.image != blank
      assign gallery_count = gallery_count | plus: 1
    endif
  endfor
-%}

{%- if gallery_count > 0 -%}
  <section
    id="ApgoGallery-{{ section.id }}"
    class="apgo-gallery"
    data-apgo-gallery
    style="
      --apgo-gallery-max-width: {{ section.settings.max_width }}px;
      --apgo-gallery-ratio: {{ section.settings.aspect_ratio }};
      --apgo-gallery-background: {{ section.settings.background_color }};
      --apgo-gallery-frame: {{ section.settings.frame_color }};
      --apgo-gallery-accent: {{ section.settings.accent_color }};
      --apgo-gallery-radius: {{ section.settings.radius }}px;
      --apgo-gallery-padding-top: {{ section.settings.padding_top }}px;
      --apgo-gallery-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="apgo-gallery__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="apgo-gallery__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      <div class="apgo-gallery__viewer">
        <div
          class="apgo-gallery__track"
          data-apgo-gallery-track
          tabindex="0"
          aria-label="{{ section.settings.heading | default: 'Gallery' | escape }}"
        >
          {%- assign gallery_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'image' and block.settings.image != blank -%}
              {%- assign gallery_position = gallery_index | plus: 1 -%}
              {%- assign image_loading = 'lazy' -%}
              {%- assign image_priority = 'auto' -%}
              {%- if gallery_index == 0 -%}
                {%- assign image_loading = 'eager' -%}
                {%- assign image_priority = 'high' -%}
              {%- endif -%}
              {%- assign image_alt = block.settings.alt_text | default: block.settings.image.alt | default: section.settings.heading -%}
              <figure
                class="apgo-gallery__slide"
                data-apgo-gallery-slide="{{ gallery_index }}"
                data-gallery-block-id="{{ block.id }}"
                aria-label="{{ 'accessibility.slide_status' | t: index: gallery_position, length: gallery_count }}"
                {{ block.shopify_attributes }}
              >
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    class: 'apgo-gallery__image',
                    loading: image_loading,
                    fetchpriority: image_priority,
                    widths: '480, 720, 960, 1200, 1600, 2000, 2400',
                    sizes: '(min-width: 1200px) 1160px, calc(100vw - 32px)',
                    alt: image_alt
                }}
                {%- if block.settings.caption != blank -%}
                  <figcaption class="apgo-gallery__caption">{{ block.settings.caption | escape }}</figcaption>
                {%- endif -%}
              </figure>
              {%- assign gallery_index = gallery_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if gallery_count > 1 and section.settings.show_arrows -%}
          <button
            type="button"
            class="apgo-gallery__arrow apgo-gallery__arrow--previous"
            data-apgo-gallery-previous
            aria-label="{{ 'accessibility.slideshow_previous' | t }}"
            disabled
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m15 18-6-6 6-6"></path>
            </svg>
          </button>
          <button
            type="button"
            class="apgo-gallery__arrow apgo-gallery__arrow--next"
            data-apgo-gallery-next
            aria-label="{{ 'accessibility.slideshow_next' | t }}"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m9 18 6-6-6-6"></path>
            </svg>
          </button>
        {%- endif -%}

        {%- if gallery_count > 1 and section.settings.show_counter -%}
          <div class="apgo-gallery__counter" data-apgo-gallery-counter aria-live="polite">
            <span data-apgo-gallery-current>1</span>
            <span aria-hidden="true">/</span>
            <span>{{ gallery_count }}</span>
          </div>
        {%- endif -%}
      </div>

      {%- if gallery_count > 1 -%}
        <div class="apgo-gallery__thumbnails" data-apgo-gallery-thumbnails>
          {%- assign thumbnail_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'image' and block.settings.image != blank -%}
              {%- assign thumbnail_position = thumbnail_index | plus: 1 -%}
              {%- assign thumbnail_alt = block.settings.alt_text | default: block.settings.image.alt | default: section.settings.heading -%}
              <button
                type="button"
                class="apgo-gallery__thumbnail{% if thumbnail_index == 0 %} is-active{% endif %}"
                data-apgo-gallery-thumbnail="{{ thumbnail_index }}"
                data-gallery-block-id="{{ block.id }}"
                aria-label="{{ 'accessibility.slide_status' | t: index: thumbnail_position, length: gallery_count }}"
                aria-current="{% if thumbnail_index == 0 %}true{% else %}false{% endif %}"
              >
                {{
                  block.settings.image
                  | image_url: width: 320
                  | image_tag:
                    class: 'apgo-gallery__thumbnail-image',
                    loading: 'lazy',
                    widths: '120, 180, 240, 320',
                    sizes: '(max-width: 749px) 26vw, 140px',
                    alt: thumbnail_alt
                }}
              </button>
              {%- assign thumbnail_index = thumbnail_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .apgo-gallery {
    width: 100%;
    padding: var(--apgo-gallery-padding-top, 36px) 16px var(--apgo-gallery-padding-bottom, 36px);
    background: var(--apgo-gallery-background, #050505);
    box-sizing: border-box;
  }

  .apgo-gallery *,
  .apgo-gallery *::before,
  .apgo-gallery *::after {
    box-sizing: border-box;
  }

  .apgo-gallery__inner {
    width: min(100%, var(--apgo-gallery-max-width, 1200px));
    margin-inline: auto;
  }

  .apgo-gallery__heading {
    margin: 0 0 20px;
    color: #ffffff;
    font-size: clamp(24px, 4vw, 42px);
    font-weight: 800;
    line-height: 1.1;
    text-align: center;
  }

  .apgo-gallery__viewer {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--apgo-gallery-ratio, 16 / 9);
    border: 1px solid var(--apgo-gallery-frame, #3d4148);
    border-radius: var(--apgo-gallery-radius, 12px);
    background: #000000;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.34);
  }

  .apgo-gallery__track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .apgo-gallery__track::-webkit-scrollbar,
  .apgo-gallery__thumbnails::-webkit-scrollbar {
    display: none;
  }

  .apgo-gallery__track:focus-visible {
    outline: 2px solid var(--apgo-gallery-accent, #e3b34d);
    outline-offset: -3px;
  }

  .apgo-gallery__slide {
    position: relative;
    display: grid;
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    margin: 0;
    place-items: center;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    background: #000000;
  }

  .apgo-gallery__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    user-select: none;
    -webkit-user-drag: none;
  }

  .apgo-gallery__caption {
    position: absolute;
    inset: auto 0 0;
    padding: 32px 18px 14px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
    color: #ffffff;
    font-size: 14px;
    line-height: 1.4;
    text-align: center;
  }

  .apgo-gallery__arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    width: 48px;
    height: 48px;
    padding: 0;
    transform: translateY(-50%);
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.72);
    color: #ffffff;
    box-shadow: 0 6px 22px rgba(0, 0, 0, 0.34);
    cursor: pointer;
    transition: opacity 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .apgo-gallery__arrow:hover:not(:disabled) {
    background: var(--apgo-gallery-accent, #e3b34d);
    color: #050505;
    transform: translateY(-50%) scale(1.04);
  }

  .apgo-gallery__arrow:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .apgo-gallery__arrow:disabled {
    opacity: 0.24;
    cursor: default;
  }

  .apgo-gallery__arrow--previous {
    left: 16px;
  }

  .apgo-gallery__arrow--next {
    right: 16px;
  }

  .apgo-gallery__arrow svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .apgo-gallery__counter {
    position: absolute;
    right: 14px;
    bottom: 12px;
    z-index: 2;
    display: flex;
    gap: 5px;
    padding: 6px 10px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.72);
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
  }

  .apgo-gallery__thumbnails {
    display: grid;
    grid-auto-columns: clamp(104px, 14vw, 150px);
    grid-auto-flow: column;
    gap: 10px;
    margin-top: 12px;
    padding: 2px 2px 8px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    -webkit-overflow-scrolling: touch;
  }

  .apgo-gallery__thumbnail {
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    scroll-snap-align: start;
    border: 2px solid transparent;
    border-radius: max(6px, calc(var(--apgo-gallery-radius, 12px) - 4px));
    background: #000000;
    opacity: 0.58;
    cursor: pointer;
    transition: border-color 180ms ease, opacity 180ms ease, transform 180ms ease;
  }

  .apgo-gallery__thumbnail:hover,
  .apgo-gallery__thumbnail.is-active {
    border-color: var(--apgo-gallery-accent, #e3b34d);
    opacity: 1;
  }

  .apgo-gallery__thumbnail:hover {
    transform: translateY(-2px);
  }

  .apgo-gallery__thumbnail:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
  }

  .apgo-gallery__thumbnail-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000000;
    user-select: none;
    -webkit-user-drag: none;
  }

  @media (max-width: 749px) {
    .apgo-gallery {
      padding-inline: 10px;
    }

    .apgo-gallery__heading {
      margin-bottom: 14px;
      font-size: clamp(22px, 8vw, 32px);
    }

    .apgo-gallery__arrow {
      width: 42px;
      height: 42px;
    }

    .apgo-gallery__arrow--previous {
      left: 8px;
    }

    .apgo-gallery__arrow--next {
      right: 8px;
    }

    .apgo-gallery__thumbnails {
      grid-auto-columns: clamp(80px, 26vw, 108px);
      gap: 8px;
    }

    .apgo-gallery__caption {
      padding: 26px 12px 10px;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apgo-gallery__track,
    .apgo-gallery__thumbnails {
      scroll-behavior: auto;
    }

    .apgo-gallery__arrow,
    .apgo-gallery__thumbnail {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const initializeGallery = (root) => {
      if (!root || root.dataset.apgoGalleryReady === 'true') return;

      const track = root.querySelector('[data-apgo-gallery-track]');
      const slides = Array.from(root.querySelectorAll('[data-apgo-gallery-slide]'));
      const thumbnails = Array.from(root.querySelectorAll('[data-apgo-gallery-thumbnail]'));
      const previousButton = root.querySelector('[data-apgo-gallery-previous]');
      const nextButton = root.querySelector('[data-apgo-gallery-next]');
      const currentLabel = root.querySelector('[data-apgo-gallery-current]');

      if (!track || slides.length === 0) return;

      root.dataset.apgoGalleryReady = 'true';
      let currentIndex = 0;
      let frame = 0;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const updateInterface = (index) => {
        currentIndex = Math.max(0, Math.min(index, slides.length - 1));

        thumbnails.forEach((thumbnail, thumbnailIndex) => {
          const isCurrent = thumbnailIndex === currentIndex;
          thumbnail.classList.toggle('is-active', isCurrent);
          thumbnail.setAttribute('aria-current', isCurrent ? 'true' : 'false');
        });

        if (previousButton) previousButton.disabled = currentIndex === 0;
        if (nextButton) nextButton.disabled = currentIndex === slides.length - 1;
        if (currentLabel) currentLabel.textContent = String(currentIndex + 1);
      };

      const goTo = (index, focusThumbnail = false) => {
        const nextIndex = Math.max(0, Math.min(index, slides.length - 1));
        track.scrollTo({
          left: nextIndex * track.clientWidth,
          behavior: reduceMotion ? 'auto' : 'smooth'
        });
        updateInterface(nextIndex);

        const thumbnail = thumbnails[nextIndex];
        if (thumbnail) {
          thumbnail.scrollIntoView({
            behavior: reduceMotion ? 'auto' : 'smooth',
            block: 'nearest',
            inline: 'nearest'
          });
          if (focusThumbnail) thumbnail.focus({ preventScroll: true });
        }
      };

      const syncFromScroll = () => {
        frame = 0;
        if (track.clientWidth === 0) return;
        updateInterface(Math.round(track.scrollLeft / track.clientWidth));
      };

      track.addEventListener('scroll', () => {
        if (!frame) frame = window.requestAnimationFrame(syncFromScroll);
      }, { passive: true });

      track.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          goTo(currentIndex - 1);
        }
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          goTo(currentIndex + 1);
        }
      });

      thumbnails.forEach((thumbnail, index) => {
        thumbnail.addEventListener('click', () => goTo(index));
      });

      if (previousButton) previousButton.addEventListener('click', () => goTo(currentIndex - 1));
      if (nextButton) nextButton.addEventListener('click', () => goTo(currentIndex + 1));

      window.addEventListener('resize', () => {
        track.scrollTo({ left: currentIndex * track.clientWidth, behavior: 'auto' });
      });

      updateInterface(0);
    };

    const initializeAllGalleries = (scope = document) => {
      scope.querySelectorAll('[data-apgo-gallery]').forEach(initializeGallery);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initializeAllGalleries());
    } else {
      initializeAllGalleries();
    }

    document.addEventListener('shopify:section:load', (event) => {
      initializeAllGalleries(event.target);
    });

    document.addEventListener('shopify:block:select', (event) => {
      const root = event.target.closest('[data-apgo-gallery]');
      if (!root) return;
      const thumbnail = root.querySelector(`[data-apgo-gallery-thumbnail][data-gallery-block-id="${event.detail.blockId}"]`);
      if (thumbnail) thumbnail.click();
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Gallery",
  "tag": "section",
  "class": "apgo-gallery-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gallery"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Viewer aspect ratio",
      "options": [
        {
          "value": "16 / 9",
          "label": "Landscape 16:9"
        },
        {
          "value": "3 / 2",
          "label": "Landscape 3:2"
        },
        {
          "value": "4 / 3",
          "label": "Landscape 4:3"
        }
      ],
      "default": "16 / 9"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show image counter",
      "default": true
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 720,
      "max": 1600,
      "step": 40,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#050505"
    },
    {
      "type": "color",
      "id": "frame_color",
      "label": "Viewer border",
      "default": "#3d4148"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Active thumbnail and button color",
      "default": "#e3b34d"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Gallery",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image"
        },
        {
          "type": "image"
        }
      ]
    }
  ]
}
{% endschema %}
