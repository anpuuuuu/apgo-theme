{% comment %}
  APGO Special Event block builder. Promo banners, product carousels and
  featured stages render in the exact order selected in Theme Editor.
{% endcomment %}

{{ 'apgo-event-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'apgo-event-cart.js' | asset_url }}" defer></script>
<script src="{{ 'apgo-campaign-tracking.js' | asset_url }}" defer></script>

{% liquid
  assign event_grid_id = section.settings.anchor_id | handleize
  if event_grid_id == blank
    assign event_grid_id = 'apgo-event-grid-' | append: section.id
  endif

  assign apgo_campaign_id = 'golden_bull_award'
  if template.suffix == 'special-event'
    assign apgo_campaign_id = 'apgo_birthday'
  elsif template.suffix != 'golden-bull-award' and page.handle != blank
    assign apgo_campaign_id = page.handle | handleize | replace: '-', '_'
  endif
%}

<div
  id="{{ event_grid_id }}"
  data-apgo-campaign-root
  data-campaign-id="{{ apgo_campaign_id | escape }}"
  data-market="{{ localization.country.iso_code }}"
  data-currency="{{ cart.currency.iso_code }}"
  class="
    apgo-event-collection-grid section section--full-width
    {% if section.settings.overlap_enabled %}apgo-event-collection-grid--overlap{% endif %}
  "
  style="
    {% if section.settings.overlap_enabled %}
      --apgo-event-overlap: {{ section.settings.overlap_offset }}px;
      --apgo-event-curve-height: {{ section.settings.overlap_offset | times: 2 | at_most: 80 }}px;
    {% endif %}
    --apgo-event-panel-radius: {{ section.settings.panel_radius }}px;
    --padding-block-start: {{ section.settings.padding-block-start }}px;
    --padding-block-end: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="apgo-event-collection-grid__panel">
    {% if section.settings.overlap_enabled %}
      <div class="apgo-event-collection-grid__curve" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none" role="presentation">
          <path d="M0,80 C360,8 1080,8 1440,80 L1440,80 L0,80 Z"/>
        </svg>
      </div>
    {% endif %}

    {%- comment -%}
      Header now renders when EITHER the heading OR the countdown is on,
      so the countdown can show even on pages with no section heading.
    {%- endcomment -%}
    {%- assign apgo_show_countdown = false -%}
    {%- if section.settings.show_countdown and section.settings.countdown_end_at != blank -%}
      {%- assign apgo_show_countdown = true -%}
    {%- endif -%}
    {% if section.settings.heading != blank or section.settings.celebration_message != blank or apgo_show_countdown %}
      <header class="apgo-event-collection-grid__header">
        {% if section.settings.heading != blank %}
          {%- comment -%}
            Festive heading lockup — gold star icons flank the title, with an
            optional anniversary badge stacked above. The decorative pieces
            render only when section.settings.show_festive_lockup is on so
            editors can fall back to the plain h2 if desired.
          {%- endcomment -%}
          {% if section.settings.show_festive_lockup %}
            <div class="apgo-event-heading-wrap">
              <span class="apgo-event-heading-star apgo-event-heading-star--left">
                {% render 'apgo-icon-star', unique: 'evt-grid-l' %}
              </span>
              <div class="apgo-event-heading-stack">
                {% if section.settings.anniversary_badge != blank %}
                  <span class="apgo-event-heading-badge">{{ section.settings.anniversary_badge }}</span>
                {% endif %}
                <h2 class="apgo-event-collection-grid__heading apgo-event-heading-text">
                  <span class="apgo-event-heading-title">{{ section.settings.heading | escape | newline_to_br }}</span>
                </h2>
                {% if section.settings.celebration_message != blank %}
                  <p class="apgo-event-heading-subtitle">{{ section.settings.celebration_message | escape }}</p>
                {% endif %}
              </div>
              <span class="apgo-event-heading-star apgo-event-heading-star--right">
                {% render 'apgo-icon-star', unique: 'evt-grid-r' %}
              </span>
            </div>
          {% else %}
            <h2 class="apgo-event-collection-grid__heading">
              <span class="apgo-event-heading-title">{{ section.settings.heading | escape | newline_to_br }}</span>
            </h2>
            {% if section.settings.celebration_message != blank %}
              <p class="apgo-event-heading-subtitle">{{ section.settings.celebration_message | escape }}</p>
            {% endif %}
          {% endif %}
        {% elsif section.settings.celebration_message != blank %}
          <p class="apgo-event-heading-subtitle">{{ section.settings.celebration_message | escape }}</p>
        {% endif %}

        {%- if apgo_show_countdown -%}
          {% render 'apgo-event-countdown',
            end_iso: section.settings.countdown_end_at,
            label: section.settings.countdown_label %}
        {%- endif -%}
      </header>
    {% endif %}

    <div class="apgo-event-collection-grid__panel-body">
      {%- assign apgo_rendered_position = 0 -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign apgo_market_visible = true
          if block.settings.market_visibility == 'my' and localization.country.iso_code == 'SG'
            assign apgo_market_visible = false
          elsif block.settings.market_visibility == 'sg' and localization.country.iso_code != 'SG'
            assign apgo_market_visible = false
          endif
        -%}

        {%- case block.type -%}
          {%- when 'promo_banner' -%}
            {%- liquid
              assign apgo_banner = block.settings.banner
              assign apgo_product = block.settings.product
              assign apgo_variant = block.settings.variant_id
              if localization.country.iso_code == 'SG'
                if block.settings.market_visibility == 'sg'
                  assign apgo_banner = block.settings.banner_sg
                  assign apgo_product = block.settings.product_sg
                  assign apgo_variant = block.settings.variant_id_sg
                else
                  if block.settings.banner_sg != blank
                    assign apgo_banner = block.settings.banner_sg
                  endif
                  if block.settings.product_sg != blank
                    assign apgo_product = block.settings.product_sg
                  endif
                  if block.settings.variant_id_sg != blank
                    assign apgo_variant = block.settings.variant_id_sg
                  endif
                endif
              endif

              assign apgo_single_cta = blank
              if block.settings.cta_mode == 'product_link'
                assign apgo_single_cta = block.settings.single_cta_label | default: 'View deal'
              endif

              assign apgo_zone_key = 'promo-' | append: block.id | handleize
              assign apgo_gift_modal_id = blank
              if block.settings.gift_enabled and block.settings.gift_pool != blank
                assign apgo_gift_modal_id = 'apgo-event-gift-' | append: block.id
              endif
            -%}

            {%- if apgo_market_visible and apgo_banner != blank and apgo_product != blank -%}
              {%- assign apgo_rendered_position = apgo_rendered_position | plus: 1 -%}
              {% render 'apgo-event-linked-banner-zone',
                heading: block.settings.heading,
                message: block.settings.message,
                show_counter: block.settings.show_counter,
                counter_release_total: block.settings.counter_release_total,
                counter_manual_deduction: block.settings.counter_manual_deduction,
                counter_milestone_total: block.settings.counter_milestone_total,
                counter_flow_baseline: block.settings.counter_flow_baseline,
                banner_image: apgo_banner,
                product: apgo_product,
                variant_id: apgo_variant,
                single_cta_label: apgo_single_cta,
                gift_modal_id: apgo_gift_modal_id,
                zone_class: apgo_zone_key,
                zone_position: apgo_rendered_position,
                campaign_id: apgo_campaign_id,
                block_attributes: block.shopify_attributes
              %}
              {%- if apgo_gift_modal_id != blank -%}
                {% render 'apgo-event-gift-modal',
                  modal_id: apgo_gift_modal_id,
                  pool: block.settings.gift_pool,
                  heading: block.settings.gift_heading,
                  count: block.settings.gift_count
                %}
              {%- endif -%}
            {%- elsif request.design_mode and apgo_market_visible -%}
              <div class="apgo-event-block-placeholder" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.heading | default: 'Promo banner' | escape }}</strong>
                <span>Select a banner and destination product for this market.</span>
              </div>
            {%- endif -%}

          {%- when 'product_carousel' -%}
            {%- liquid
              assign apgo_carousel_banner = block.settings.banner
              if localization.country.iso_code == 'SG'
                if block.settings.market_visibility == 'sg'
                  assign apgo_carousel_banner = block.settings.banner_sg
                elsif block.settings.banner_sg != blank
                  assign apgo_carousel_banner = block.settings.banner_sg
                endif
              endif
              assign apgo_zone_key = 'carousel-' | append: block.id | handleize
            -%}
            {%- if apgo_market_visible and apgo_carousel_banner != blank and block.settings.products != blank -%}
              {%- assign apgo_rendered_position = apgo_rendered_position | plus: 1 -%}
              {% render 'apgo-event-scroll-zone',
                heading: block.settings.heading,
                banner_image: apgo_carousel_banner,
                products: block.settings.products,
                variant_ids: block.settings.variant_ids,
                zone_class: apgo_zone_key,
                zone_position: apgo_rendered_position,
                hide_compare_at: block.settings.hide_compare_at,
                show_scroll_cue: block.settings.show_scroll_cue,
                show_promo_limit: block.settings.show_promo_limit,
                section_id: section.id,
                campaign_id: apgo_campaign_id,
                block_attributes: block.shopify_attributes
              %}
            {%- elsif request.design_mode and apgo_market_visible -%}
              <div class="apgo-event-block-placeholder" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.heading | default: 'Product carousel' | escape }}</strong>
                <span>Select a banner and at least one product for this market.</span>
              </div>
            {%- endif -%}

          {%- when 'featured_stage' -%}
            {%- if block.settings.product_1 != blank and block.settings.product_2 != blank and block.settings.image_1 != blank and block.settings.image_2 != blank -%}
              {%- assign apgo_rendered_position = apgo_rendered_position | plus: 1 -%}
              <section
                class="apgo-event-featured-stage"
                data-apgo-campaign-section
                data-section-id="featured-{{ block.id | escape }}"
                data-section-name="{{ block.settings.heading | escape }}"
                data-section-position="{{ apgo_rendered_position }}"
                data-promotion-id="{{ apgo_campaign_id | escape }}_featured_{{ block.id | escape }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.heading != blank -%}
                  <h3 class="apgo-event-featured-stage__heading">
                    <span class="apgo-event-featured-stage__heading-star" aria-hidden="true">★</span>
                    {{ block.settings.heading }}
                    <span class="apgo-event-featured-stage__heading-star" aria-hidden="true">★</span>
                  </h3>
                {%- endif -%}
                <div class="apgo-event-featured-stage__stack">
                  {% render 'apgo-event-featured-banner',
                    product: block.settings.product_1,
                    image: block.settings.image_1,
                    badge: block.settings.badge_text,
                    cta: block.settings.cta_label,
                    hide_compare_at: block.settings.hide_compare_at
                  %}
                  {% render 'apgo-event-featured-banner',
                    product: block.settings.product_2,
                    image: block.settings.image_2,
                    badge: block.settings.badge_text,
                    cta: block.settings.cta_label,
                    hide_compare_at: block.settings.hide_compare_at
                  %}
                </div>
              </section>
            {%- elsif request.design_mode -%}
              <div class="apgo-event-block-placeholder" {{ block.shopify_attributes }}>
                <strong>{{ block.settings.heading | default: 'Featured stage' | escape }}</strong>
                <span>Select both images and products to display this stage.</span>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Event Collection Grid",
  "tag": "section",
  "class": "apgo-event-collection-grid-wrapper",
  "max_blocks": 30,
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section anchor ID",
      "info": "Optional target used by page links. Use letters, numbers, and hyphens."
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown timer",
      "info": "Renders a gold countdown chip at the top of the panel header. Hides itself automatically when the end time has passed.",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "info": "Text shown beside the hourglass icon and the d/h/m/s boxes.",
      "default": "BIRTHDAY SALE ENDS IN"
    },
    {
      "type": "text",
      "id": "countdown_end_at",
      "label": "Countdown ends at (ISO 8601, GMT+8)",
      "info": "Format: YYYY-MM-DDTHH:MM:SS+08:00. Example: 2026-07-03T00:00:00+08:00",
      "default": "2026-07-03T00:00:00+08:00"
    },
    {
      "type": "header",
      "content": "Section heading lockup"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section heading (optional)",
      "info": "Press Enter for a second line."
    },
    {
      "type": "text",
      "id": "celebration_message",
      "label": "Celebration message",
      "info": "Meaningful customer-facing message shown below the main heading. Leave blank to hide."
    },
    {
      "type": "checkbox",
      "id": "show_festive_lockup",
      "label": "Show festive heading lockup",
      "info": "Adds gold star icons either side of the heading + optional anniversary badge above.",
      "default": true
    },
    {
      "type": "text",
      "id": "anniversary_badge",
      "label": "Anniversary badge text",
      "info": "Small gold pill above the heading. Leave blank to hide.",
      "visible_if": "{{ section.settings.show_festive_lockup }}"
    },
    {
      "type": "header",
      "content": "Panel chrome"
    },
    {
      "type": "checkbox",
      "id": "overlap_enabled",
      "label": "Lift card panel over banner",
      "default": false
    },
    {
      "type": "range",
      "id": "overlap_offset",
      "label": "Overlap distance",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.overlap_enabled }}"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Top corner radius",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Section top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Section bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "promo_banner",
      "name": "Promo banner",
      "limit": 20,
      "settings": [
        {
          "type": "select",
          "id": "market_visibility",
          "label": "Market visibility",
          "options": [
            { "value": "both", "label": "Malaysia + Singapore" },
            { "value": "my", "label": "Malaysia / default only" },
            { "value": "sg", "label": "Singapore only" }
          ],
          "default": "both"
        },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "message", "label": "Promotion message" },
        { "type": "image_picker", "id": "banner", "label": "Malaysia / default banner" },
        { "type": "product", "id": "product", "label": "Malaysia / default product" },
        { "type": "text", "id": "variant_id", "label": "Malaysia / default variant ID (optional)" },
        {
          "type": "image_picker",
          "id": "banner_sg",
          "label": "Singapore banner",
          "info": "Falls back to the Malaysia / default banner when blank."
        },
        {
          "type": "product",
          "id": "product_sg",
          "label": "Singapore product",
          "info": "Falls back to the Malaysia / default product when blank."
        },
        { "type": "text", "id": "variant_id_sg", "label": "Singapore variant ID (optional)" },
        {
          "type": "select",
          "id": "cta_mode",
          "label": "Button mode",
          "options": [
            { "value": "add_buy", "label": "Add to cart + Buy now" },
            { "value": "product_link", "label": "Single product-page button" }
          ],
          "default": "add_buy"
        },
        {
          "type": "text",
          "id": "single_cta_label",
          "label": "Single button label",
          "default": "Grab Deals Now",
          "visible_if": "{{ block.settings.cta_mode == 'product_link' }}"
        },
        {
          "type": "header",
          "content": "Optional gift picker"
        },
        {
          "type": "checkbox",
          "id": "gift_enabled",
          "label": "Open a free-gift picker",
          "info": "The discount app remains responsible for pricing selected gifts at zero.",
          "default": false
        },
        {
          "type": "product_list",
          "id": "gift_pool",
          "label": "Gift pool",
          "limit": 12,
          "info": "Used only when the free-gift picker is enabled. Shopify does not support conditional visibility on product-list settings."
        },
        {
          "type": "range",
          "id": "gift_count",
          "label": "Required gift quantity",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 2,
          "visible_if": "{{ block.settings.gift_enabled }}"
        },
        {
          "type": "text",
          "id": "gift_heading",
          "label": "Gift picker heading",
          "default": "Choose your free gifts",
          "visible_if": "{{ block.settings.gift_enabled }}"
        },
        {
          "type": "header",
          "content": "Optional stock counter"
        },
        {
          "type": "checkbox",
          "id": "show_counter",
          "label": "Show inventory counter",
          "default": false
        },
        {
          "type": "text",
          "id": "counter_milestone_total",
          "label": "Previous milestone",
          "default": "500",
          "visible_if": "{{ block.settings.show_counter }}"
        },
        {
          "type": "text",
          "id": "counter_release_total",
          "label": "Release total",
          "default": "88",
          "visible_if": "{{ block.settings.show_counter }}"
        },
        {
          "type": "text",
          "id": "counter_manual_deduction",
          "label": "Manual deduction",
          "default": "0",
          "visible_if": "{{ block.settings.show_counter }}"
        },
        {
          "type": "text",
          "id": "counter_flow_baseline",
          "label": "Flow baseline",
          "info": "Keep 0 for a fully manual counter.",
          "default": "0",
          "visible_if": "{{ block.settings.show_counter }}"
        }
      ]
    },
    {
      "type": "product_carousel",
      "name": "Product carousel",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "market_visibility",
          "label": "Market visibility",
          "options": [
            { "value": "both", "label": "Malaysia + Singapore" },
            { "value": "my", "label": "Malaysia / default only" },
            { "value": "sg", "label": "Singapore only" }
          ],
          "default": "both"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "PROMOTION DEALS" },
        { "type": "image_picker", "id": "banner", "label": "Malaysia / default banner" },
        {
          "type": "image_picker",
          "id": "banner_sg",
          "label": "Singapore banner",
          "info": "Falls back to the Malaysia / default banner when blank."
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products",
          "limit": 12
        },
        {
          "type": "textarea",
          "id": "variant_ids",
          "label": "Variant IDs (advanced, optional)",
          "info": "One numeric variant ID per line, in the same order as the product list. Leave a line blank to use that product's normal listing variant."
        },
        {
          "type": "checkbox",
          "id": "hide_compare_at",
          "label": "Hide original price",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_promo_limit",
          "label": "Show promotional purchase-limit note",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_scroll_cue",
          "label": "Show swipe cue and carousel arrows",
          "default": false
        }
      ]
    },
    {
      "type": "featured_stage",
      "name": "Featured stage",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "FEATURED HIGHLIGHTS" },
        { "type": "product", "id": "product_1", "label": "Product 01" },
        { "type": "image_picker", "id": "image_1", "label": "Banner image 01" },
        { "type": "product", "id": "product_2", "label": "Product 02" },
        { "type": "image_picker", "id": "image_2", "label": "Banner image 02" },
        { "type": "text", "id": "badge_text", "label": "Badge", "default": "BEST VALUE" },
        { "type": "text", "id": "cta_label", "label": "CTA label", "default": "View deal" },
        { "type": "checkbox", "id": "hide_compare_at", "label": "Hide original price", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Event Collection Grid",
      "category": "APGO"
    }
  ]
}
{% endschema %}
