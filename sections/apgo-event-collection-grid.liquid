{% comment %}
  APGO Special Event — 3-zone curated content panel.
    Zone 1: Discount Zone (horizontal-scroll, admin-picked products)
    Zone 2: Buy 1 Free 1 Zone (horizontal-scroll, admin-picked products)
    Zone 3: Featured Stage (two stacked 1280:680 banners at the bottom)
  Cards in zones 1 + 2 reuse apgo-event-listing-card for visual consistency
  with the rest of the page.
{% endcomment %}

{{ 'apgo-event-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'apgo-event-cart.js' | asset_url }}" defer></script>
<script src="{{ 'apgo-campaign-tracking.js' | asset_url }}" defer></script>

{% liquid
  assign event_grid_id = section.settings.anchor_id | handleize
  if event_grid_id == blank
    assign event_grid_id = 'apgo-event-grid-' | append: section.id
  endif
%}

<div
  id="{{ event_grid_id }}"
  data-apgo-campaign-root
  data-campaign-id="golden_bull_award"
  data-market="{{ localization.country.iso_code }}"
  data-currency="{{ cart.currency.iso_code }}"
  class="
    apgo-event-collection-grid section section--full-width
    {% if section.settings.overlap_enabled %}apgo-event-collection-grid--overlap{% endif %}
  "
  style="
    {% if section.settings.overlap_enabled %}
      --apgo-event-overlap: {{ section.settings.overlap_offset }}px;
      --apgo-event-curve-height: {{ section.settings.overlap_offset | times: 2 | at_most: 80 }}px;
    {% endif %}
    --apgo-event-panel-radius: {{ section.settings.panel_radius }}px;
    --padding-block-start: {{ section.settings.padding-block-start }}px;
    --padding-block-end: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="apgo-event-collection-grid__panel">
    {% if section.settings.overlap_enabled %}
      <div class="apgo-event-collection-grid__curve" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none" role="presentation">
          <path d="M0,80 C360,8 1080,8 1440,80 L1440,80 L0,80 Z"/>
        </svg>
      </div>
    {% endif %}

    {%- comment -%}
      Header now renders when EITHER the heading OR the countdown is on,
      so the countdown can show even on pages with no section heading.
    {%- endcomment -%}
    {%- assign apgo_show_countdown = false -%}
    {%- if section.settings.show_countdown and section.settings.countdown_end_at != blank -%}
      {%- assign apgo_show_countdown = true -%}
    {%- endif -%}
    {% if section.settings.heading != blank or section.settings.celebration_message != blank or apgo_show_countdown %}
      <header class="apgo-event-collection-grid__header">
        {% if section.settings.heading != blank %}
          {%- comment -%}
            Festive heading lockup — gold star icons flank the title, with an
            optional anniversary badge stacked above. The decorative pieces
            render only when section.settings.show_festive_lockup is on so
            editors can fall back to the plain h2 if desired.
          {%- endcomment -%}
          {% if section.settings.show_festive_lockup %}
            <div class="apgo-event-heading-wrap">
              <span class="apgo-event-heading-star apgo-event-heading-star--left">
                {% render 'apgo-icon-star', unique: 'evt-grid-l' %}
              </span>
              <div class="apgo-event-heading-stack">
                {% if section.settings.anniversary_badge != blank %}
                  <span class="apgo-event-heading-badge">{{ section.settings.anniversary_badge }}</span>
                {% endif %}
                <h2 class="apgo-event-collection-grid__heading apgo-event-heading-text">
                  <span class="apgo-event-heading-title">{{ section.settings.heading | escape | newline_to_br }}</span>
                </h2>
                {% if section.settings.celebration_message != blank %}
                  <p class="apgo-event-heading-subtitle">{{ section.settings.celebration_message | escape }}</p>
                {% endif %}
              </div>
              <span class="apgo-event-heading-star apgo-event-heading-star--right">
                {% render 'apgo-icon-star', unique: 'evt-grid-r' %}
              </span>
            </div>
          {% else %}
            <h2 class="apgo-event-collection-grid__heading">
              <span class="apgo-event-heading-title">{{ section.settings.heading | escape | newline_to_br }}</span>
            </h2>
            {% if section.settings.celebration_message != blank %}
              <p class="apgo-event-heading-subtitle">{{ section.settings.celebration_message | escape }}</p>
            {% endif %}
          {% endif %}
        {% elsif section.settings.celebration_message != blank %}
          <p class="apgo-event-heading-subtitle">{{ section.settings.celebration_message | escape }}</p>
        {% endif %}

        {%- if apgo_show_countdown -%}
          {% render 'apgo-event-countdown',
            end_iso: section.settings.countdown_end_at,
            label: section.settings.countdown_label %}
        {%- endif -%}
      </header>
    {% endif %}

    <div class="apgo-event-collection-grid__panel-body">
      {%- comment -%}
        Build per-zone block arrays. Blocks are flat in Shopify, so we
        partition by block.type. Each card block carries one product +
        an optional variant_id (admin pastes from product admin URL).
      {%- endcomment -%}
      {%- assign discount_card_blocks = section.blocks | where: 'type', 'discount_card' -%}
      {%- assign b1f1_card_blocks     = section.blocks | where: 'type', 'b1f1_card' -%}
      {%- assign discount_zone_banner = section.settings.discount_zone_banner -%}
      {%- if localization.country.iso_code == 'SG' and section.settings.discount_zone_banner_sg != blank -%}
        {%- assign discount_zone_banner = section.settings.discount_zone_banner_sg -%}
      {%- endif -%}
      {%- comment -%}
        Counter visibility follows the section setting on every page (the
        golden-bull-award force-on override was removed so the toggle in
        the theme editor actually controls it).
      {%- endcomment -%}
      {%- assign apgo_show_aurora_counter = section.settings.show_aurora_counter -%}

      {%- comment -%}
        ZONE — Additional promo banner. MY/default and SG can use different
        banners, products, and variants. Missing SG fields fall back to the
        MY/default values so an incomplete SG setup never creates a blank zone.
        This zone renders immediately before the Mid Month promo.
      {%- endcomment -%}
      {%- if section.settings.show_additional_promo_zone -%}
        {%- assign additional_promo_banner = section.settings.additional_promo_zone_banner -%}
        {%- assign additional_promo_product = section.settings.additional_promo_zone_product -%}
        {%- assign additional_promo_variant = section.settings.additional_promo_zone_variant_id -%}
        {%- if localization.country.iso_code == 'SG' -%}
          {%- if section.settings.additional_promo_zone_banner_sg != blank -%}
            {%- assign additional_promo_banner = section.settings.additional_promo_zone_banner_sg -%}
          {%- endif -%}
          {%- if section.settings.additional_promo_zone_product_sg != blank -%}
            {%- assign additional_promo_product = section.settings.additional_promo_zone_product_sg -%}
          {%- endif -%}
          {%- if section.settings.additional_promo_zone_variant_id_sg != blank -%}
            {%- assign additional_promo_variant = section.settings.additional_promo_zone_variant_id_sg -%}
          {%- endif -%}
        {%- endif -%}
        {% render 'apgo-event-linked-banner-zone',
          heading: section.settings.additional_promo_zone_heading,
          message: section.settings.additional_promo_zone_message,
          show_counter: false,
          banner_image: additional_promo_banner,
          product: additional_promo_product,
          variant_id: additional_promo_variant,
          single_cta_label: section.settings.additional_promo_zone_single_cta,
          zone_class: 'additional-promo',
          zone_position: 6 %}
      {%- endif -%}

      {%- comment -%}
        ZONE — Mid Month promo banner. Runs after the Additional promo,
        above the 8.8 banner. Single banner/product, no region split: the
        same offer runs in both markets, so there is nothing to branch on.

        Its Add/Buy add straight to cart. apgo-event-cart.js only
        diverts a zone's buttons into the gift modal when the button is
        inside `--glaze`, so this zone is unaffected even while the
        Glaze modal is present in the DOM.
      {%- endcomment -%}
      {%- if section.settings.show_midmonth_zone -%}
        {% render 'apgo-event-linked-banner-zone',
          heading: section.settings.midmonth_zone_heading,
          message: section.settings.midmonth_zone_message,
          show_counter: false,
          banner_image: section.settings.midmonth_zone_banner,
          product: section.settings.midmonth_zone_product,
          variant_id: section.settings.midmonth_zone_variant_id,
          single_cta_label: section.settings.midmonth_zone_single_cta,
          zone_class: 'midmonth',
          zone_position: 7 %}
      {%- endif -%}

      {%- comment -%} ZONE — Glaze promo banner (region-aware: SG sees SG banner+product, MY sees MY) {%- endcomment -%}
      {%- if section.settings.show_glaze_zone -%}
        {%- assign glaze_banner = section.settings.glaze_zone_banner -%}
        {%- assign glaze_product = section.settings.glaze_zone_product -%}
        {%- assign glaze_variant = section.settings.glaze_zone_variant_id -%}
        {%- if localization.country.iso_code == 'SG' -%}
          {%- if section.settings.glaze_zone_banner_sg != blank -%}{%- assign glaze_banner = section.settings.glaze_zone_banner_sg -%}{%- endif -%}
          {%- if section.settings.glaze_zone_product_sg != blank -%}{%- assign glaze_product = section.settings.glaze_zone_product_sg -%}{%- endif -%}
          {%- assign glaze_variant = section.settings.glaze_zone_variant_id_sg -%}
        {%- endif -%}
        {% render 'apgo-event-linked-banner-zone',
          heading: section.settings.glaze_zone_heading,
          message: section.settings.glaze_zone_message,
          show_counter: false,
          banner_image: glaze_banner,
          product: glaze_product,
          variant_id: glaze_variant,
          zone_class: 'glaze',
          zone_position: 1 %}

        {%- comment -%}
          🎁 Glaze gift-picker modal. The Glaze promo products carry a
          "choose N free gifts" step (same as their PDPs), so the zone's
          Add/Buy must NOT add directly — apgo-event-cart.js intercepts
          them when this modal is present and opens it instead (mobile:
          bottom sheet, desktop: centered dialog — CSS media query).
          Commit posts main + chosen gifts in one /cart/add.js items[]
          call with the _gift_pick property; AIOD prices the gifts $0.
        {%- endcomment -%}
        {%- if section.settings.glaze_gift_enabled and section.settings.glaze_gift_pool != blank -%}
          <div class="apgo-event-gift-modal" data-apgo-event-gift-modal data-intent="add" aria-hidden="true" hidden>
            <div class="apgo-event-gift-modal__backdrop" data-apgo-event-gift-close></div>
            <div class="apgo-event-gift-modal__panel" role="dialog" aria-modal="true" aria-label="{{ section.settings.glaze_gift_heading | default: 'Choose your free gifts' | escape }}">
              <button type="button" class="apgo-event-gift-modal__close" data-apgo-event-gift-close aria-label="Close">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
              </button>
              {%- render 'apgo-cc-gift-picker',
                pool: section.settings.glaze_gift_pool,
                heading: section.settings.glaze_gift_heading,
                count: section.settings.glaze_gift_count,
                property: '_gift_pick',
                location: 'event' -%}
              <div class="apgo-event-gift-modal__actions">
                <button type="button" class="apgo-event-gift-modal__cta apgo-event-gift-modal__cta--add" data-apgo-event-gift-add disabled>Add to cart</button>
                <button type="button" class="apgo-event-gift-modal__cta apgo-event-gift-modal__cta--buy" data-apgo-event-gift-buy disabled>Buy now</button>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- comment -%}
        ZONE — Detergent promo banner. MY-only promo: the product carries
        custom.only_market=MY (SG visitors get redirected off its PDP), so
        hide the whole zone on the SG storefront too.
      {%- endcomment -%}
      {%- assign apgo_show_detergent = section.settings.show_detergent_zone -%}
      {%- if section.settings.detergent_zone_hide_sg and localization.country.iso_code == 'SG' -%}
        {%- assign apgo_show_detergent = false -%}
      {%- endif -%}
      {%- if apgo_show_detergent -%}
        {% render 'apgo-event-linked-banner-zone',
          heading: section.settings.detergent_zone_heading,
          message: section.settings.detergent_zone_message,
          show_counter: false,
          banner_image: section.settings.detergent_zone_banner,
          product: section.settings.detergent_zone_product,
          variant_id: section.settings.detergent_zone_variant_id,
          single_cta_label: section.settings.detergent_zone_single_cta,
          zone_class: 'detergent',
          zone_position: 2 %}
      {%- endif -%}


      {%- comment -%} ZONE 1 — Discount horizontal scroll {%- endcomment -%}
      {%- if section.settings.show_discount_zone -%}
        {% render 'apgo-event-scroll-zone',
          heading: section.settings.discount_zone_heading,
          banner_image: discount_zone_banner,
          card_blocks: discount_card_blocks,
          products: section.settings.discount_zone_products,
          zone_class: 'discount',
          zone_position: 1,
          hide_compare_at: section.settings.discount_zone_hide_compare_at,
          show_scroll_cue: section.settings.show_product_scroll_cue,
          section_id: section.id %}
      {%- endif -%}

      {%- comment -%} ZONE 3 — Buy 1 Free 1 horizontal scroll {%- endcomment -%}
      {%- if section.settings.show_b1f1_zone -%}
        {% render 'apgo-event-scroll-zone',
          heading: section.settings.b1f1_zone_heading,
          banner_image: section.settings.b1f1_zone_banner,
          card_blocks: b1f1_card_blocks,
          products: section.settings.b1f1_zone_products,
          zone_class: 'b1f1',
          zone_position: 3,
          hide_compare_at: section.settings.b1f1_zone_hide_compare_at,
          show_scroll_cue: section.settings.show_product_scroll_cue,
          section_id: section.id %}
      {%- endif -%}

      {%- comment -%}
        ZONE 3 — Featured Stage banner stack.
        Both an image AND a product must be set per slot, otherwise the
        whole stage hides (never a half-empty pedestal).
      {%- endcomment -%}
      {%- assign fp1 = section.settings.featured_product_1 -%}
      {%- assign fp2 = section.settings.featured_product_2 -%}
      {%- assign fi1 = section.settings.featured_image_1 -%}
      {%- assign fi2 = section.settings.featured_image_2 -%}
      {%- if section.settings.show_featured_stage
            and fp1 != blank and fp2 != blank
            and fi1 != blank and fi2 != blank -%}
        <div class="apgo-event-featured-stage">
          {%- if section.settings.featured_heading != blank -%}
            <h3 class="apgo-event-featured-stage__heading">
              <span class="apgo-event-featured-stage__heading-star" aria-hidden="true">★</span>
              {{ section.settings.featured_heading }}
              <span class="apgo-event-featured-stage__heading-star" aria-hidden="true">★</span>
            </h3>
          {%- endif -%}
          <div class="apgo-event-featured-stage__stack">
            {% render 'apgo-event-featured-banner',
              product: fp1,
              image: fi1,
              badge: section.settings.featured_badge_text,
              cta: section.settings.featured_cta_label,
              hide_compare_at: section.settings.featured_stage_hide_compare_at %}
            {% render 'apgo-event-featured-banner',
              product: fp2,
              image: fi2,
              badge: section.settings.featured_badge_text,
              cta: section.settings.featured_cta_label,
              hide_compare_at: section.settings.featured_stage_hide_compare_at %}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ZONE — Aurora single-product banner (moved to after Boss Recommends) {%- endcomment -%}
      {%- if section.settings.show_aurora_zone -%}
        {% render 'apgo-event-linked-banner-zone',
          heading: section.settings.aurora_zone_heading,
          message: section.settings.aurora_zone_message,
          show_counter: apgo_show_aurora_counter,
          counter_release_total: section.settings.aurora_counter_release_total,
          counter_manual_deduction: section.settings.aurora_counter_manual_deduction,
          counter_milestone_total: section.settings.aurora_counter_milestone_total,
          counter_flow_baseline: section.settings.aurora_counter_flow_baseline,
          banner_image: section.settings.aurora_zone_banner,
          product: section.settings.aurora_zone_product,
          variant_id: section.settings.aurora_zone_variant_id,
          zone_class: 'aurora',
          zone_position: 5 %}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Event Collection Grid",
  "tag": "section",
  "class": "apgo-event-collection-grid-wrapper",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Section anchor ID",
      "info": "Optional target used by page links. Use letters, numbers, and hyphens."
    },
    {
      "type": "header",
      "content": "Countdown"
    },
    {
      "type": "checkbox",
      "id": "show_countdown",
      "label": "Show countdown timer",
      "info": "Renders a gold countdown chip at the top of the panel header. Hides itself automatically when the end time has passed.",
      "default": true
    },
    {
      "type": "text",
      "id": "countdown_label",
      "label": "Countdown label",
      "info": "Text shown beside the hourglass icon and the d/h/m/s boxes.",
      "default": "BIRTHDAY SALE ENDS IN"
    },
    {
      "type": "text",
      "id": "countdown_end_at",
      "label": "Countdown ends at (ISO 8601, GMT+8)",
      "info": "Format: YYYY-MM-DDTHH:MM:SS+08:00. Example: 2026-07-03T00:00:00+08:00",
      "default": "2026-07-03T00:00:00+08:00"
    },
    {
      "type": "header",
      "content": "Section heading lockup"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section heading (optional)",
      "info": "Press Enter for a second line."
    },
    {
      "type": "text",
      "id": "celebration_message",
      "label": "Celebration message",
      "info": "Meaningful customer-facing message shown below the main heading. Leave blank to hide."
    },
    {
      "type": "checkbox",
      "id": "show_product_scroll_cue",
      "label": "Show product swipe cue",
      "info": "Adds an animated swipe hint and a large next button to horizontal product lists.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_festive_lockup",
      "label": "Show festive heading lockup",
      "info": "Adds gold star icons either side of the heading + optional anniversary badge above.",
      "default": true
    },
    {
      "type": "text",
      "id": "anniversary_badge",
      "label": "Anniversary badge text",
      "info": "Small gold pill above the heading. Leave blank to hide.",
      "visible_if": "{{ section.settings.show_festive_lockup }}"
    },
    {
      "type": "header",
      "content": "Discount Zone"
    },
    {
      "type": "checkbox",
      "id": "show_discount_zone",
      "label": "Show discount zone",
      "default": true
    },
    {
      "type": "text",
      "id": "discount_zone_heading",
      "label": "Zone heading",
      "default": "DISCOUNT DEALS"
    },
    {
      "type": "image_picker",
      "id": "discount_zone_banner",
      "label": "Malaysia / default banner",
      "info": "Shown in Malaysia and all non-Singapore markets. Not clickable. Leave blank to hide."
    },
    {
      "type": "image_picker",
      "id": "discount_zone_banner_sg",
      "label": "Singapore discount banner",
      "info": "Shown only when the selected country is Singapore. Falls back to the Malaysia / default banner when blank."
    },
    {
      "type": "product_list",
      "id": "discount_zone_products",
      "label": "Discount products (LEGACY — use blocks below)",
      "info": "Only used when no 'Discount card' blocks are added. Add discount cards via 'Add block' for per-variant control.",
      "limit": 12
    },
    {
      "type": "checkbox",
      "id": "discount_zone_hide_compare_at",
      "label": "Hide original (strikethrough) price",
      "info": "Tick to show only the current price on Discount-zone cards.",
      "default": false
    },
    {
      "type": "header",
      "content": "Single-product linked banner"
    },
    {
      "type": "checkbox",
      "id": "show_aurora_zone",
      "label": "Show linked banner zone",
      "default": false
    },
    {
      "type": "text",
      "id": "aurora_zone_heading",
      "label": "Zone heading"
    },
    {
      "type": "text",
      "id": "aurora_zone_message",
      "label": "Limited-offer message"
    },
    {
      "type": "checkbox",
      "id": "show_aurora_counter",
      "label": "Show Aurora counter",
      "default": false
    },
    {
      "type": "text",
      "id": "aurora_counter_milestone_total",
      "label": "Previous sold-out milestone",
      "info": "Display-only number for the completed first release.",
      "default": "500",
      "visible_if": "{{ section.settings.show_aurora_counter }}"
    },
    {
      "type": "text",
      "id": "aurora_counter_release_total",
      "label": "Current release sets",
      "info": "Starting allocation for this release. Remaining = this number minus the extra manual deduction.",
      "default": "88",
      "visible_if": "{{ section.settings.show_aurora_counter }}"
    },
    {
      "type": "text",
      "id": "aurora_counter_manual_deduction",
      "label": "Extra deduction (manual)",
      "info": "Sets to subtract from the current release on top of live paid orders.",
      "default": "0",
      "visible_if": "{{ section.settings.show_aurora_counter }}"
    },
    {
      "type": "text",
      "id": "aurora_counter_flow_baseline",
      "label": "Flow baseline (live auto-count)",
      "info": "Set 0 to keep the counter fully manual. To make it count down live with paid orders, enter the current apgo_campaign.aurora_paid_sets metafield value here — only orders AFTER this baseline reduce the counter. Remaining = Current release − Extra deduction − (paid orders since baseline).",
      "default": "0",
      "visible_if": "{{ section.settings.show_aurora_counter }}"
    },
    {
      "type": "image_picker",
      "id": "aurora_zone_banner",
      "label": "Clickable banner",
      "info": "The zone stays hidden until both a banner and product are selected."
    },
    {
      "type": "product",
      "id": "aurora_zone_product",
      "label": "Banner destination product",
      "info": "The whole banner links directly to this product page."
    },
    {
      "type": "text",
      "id": "aurora_zone_variant_id",
      "label": "Aurora deal variant ID",
      "info": "Optional. Paste the numeric variant ID for the promoted set. When blank, the first available variant is used."
    },
    {
      "type": "header",
      "content": "Glaze Zone (region-aware)"
    },
    {
      "type": "paragraph",
      "content": "Renders first on the page. SG storefront shows the SG banner + links to the SG product; everywhere else shows the MY banner + product. Zone hides until a banner + product are set."
    },
    {
      "type": "checkbox",
      "id": "show_glaze_zone",
      "label": "Show Glaze zone",
      "default": false
    },
    {
      "type": "text",
      "id": "glaze_zone_heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "glaze_zone_message",
      "label": "Message"
    },
    {
      "type": "image_picker",
      "id": "glaze_zone_banner",
      "label": "Banner — MY (default)"
    },
    {
      "type": "product",
      "id": "glaze_zone_product",
      "label": "Destination product — MY"
    },
    {
      "type": "text",
      "id": "glaze_zone_variant_id",
      "label": "Variant ID — MY (optional)"
    },
    {
      "type": "image_picker",
