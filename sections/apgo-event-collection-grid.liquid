{% comment %}
  APGO Special Event — collection product grid with optional overlap panel.
  Uses apgo-event-listing-card (same UI as Limited Time Deals). No Theme Editor product-card blocks.
{% endcomment %}

{{ 'apgo-event-page.css' | asset_url | stylesheet_tag }}

{% liquid
  assign event_collection = section.settings.collection
  assign product_limit = section.settings.product_limit | default: 24
%}

<div
  id="apgo-event-grid-{{ section.id }}"
  class="
    apgo-event-collection-grid section section--full-width
    {% if section.settings.overlap_enabled %}apgo-event-collection-grid--overlap{% endif %}
  "
  style="
    {% if section.settings.overlap_enabled %}
      --apgo-event-overlap: {{ section.settings.overlap_offset }}px;
      --apgo-event-curve-height: {{ section.settings.overlap_offset | times: 2 | at_most: 80 }}px;
    {% endif %}
    --apgo-event-panel-radius: {{ section.settings.panel_radius }}px;
    --padding-block-start: {{ section.settings.padding-block-start }}px;
    --padding-block-end: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="apgo-event-collection-grid__panel">
    {% if section.settings.overlap_enabled %}
      <div class="apgo-event-collection-grid__curve" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none" role="presentation">
          <path d="M0,80 C360,8 1080,8 1440,80 L1440,80 L0,80 Z"/>
        </svg>
      </div>
    {% endif %}
    {% if section.settings.heading != blank %}
      <header class="apgo-event-collection-grid__header">
        {%- comment -%}
          Festive heading lockup — gold star icons flank the title, with an
          optional anniversary badge stacked above. The decorative pieces
          render only when section.settings.show_festive_lockup is on so
          editors can fall back to the plain h2 if desired.
        {%- endcomment -%}
        {% if section.settings.show_festive_lockup %}
          <div class="apgo-event-heading-wrap">
            <span class="apgo-event-heading-star apgo-event-heading-star--left">
              {% render 'apgo-icon-star', unique: 'evt-grid-l' %}
            </span>
            <div class="apgo-event-heading-stack">
              {% if section.settings.anniversary_badge != blank %}
                <span class="apgo-event-heading-badge">{{ section.settings.anniversary_badge }}</span>
              {% endif %}
              <h2 class="apgo-event-collection-grid__heading apgo-event-heading-text">
                {{ section.settings.heading | escape | newline_to_br }}
              </h2>
            </div>
            <span class="apgo-event-heading-star apgo-event-heading-star--right">
              {% render 'apgo-icon-star', unique: 'evt-grid-r' %}
            </span>
          </div>
        {% else %}
          <h2 class="apgo-event-collection-grid__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {% endif %}
      </header>
    {% endif %}
    <div class="apgo-event-collection-grid__panel-body">
      {%- comment -%}
        Featured Stage — two admin-picked hero products shown as a
        single conjoined "display pedestal". Hides entirely if the
        toggle is off OR if either product slot is empty (so the
        pedestal is never half-empty).
      {%- endcomment -%}
      {%- assign fp1 = all_products[section.settings.featured_product_1] -%}
      {%- assign fp2 = all_products[section.settings.featured_product_2] -%}
      {%- if section.settings.show_featured_stage and fp1 != blank and fp1.handle != blank and fp2 != blank and fp2.handle != blank -%}
        <div class="apgo-event-featured-stage">
          {%- if section.settings.featured_heading != blank -%}
            <h3 class="apgo-event-featured-stage__heading">
              <span class="apgo-event-featured-stage__heading-star" aria-hidden="true">★</span>
              {{ section.settings.featured_heading }}
              <span class="apgo-event-featured-stage__heading-star" aria-hidden="true">★</span>
            </h3>
          {%- endif -%}
          <div class="apgo-event-featured-stage__duo">
            {% render 'apgo-event-featured-card',
              product: fp1,
              rank: '01',
              badge: section.settings.featured_badge_text,
              cta: section.settings.featured_cta_label %}
            <span class="apgo-event-featured-stage__divider" aria-hidden="true">
              <span class="apgo-event-featured-stage__divider-orb">
                {% render 'apgo-icon-star', unique: 'stage-divider' %}
              </span>
            </span>
            {% render 'apgo-event-featured-card',
              product: fp2,
              rank: '02',
              badge: section.settings.featured_badge_text,
              cta: section.settings.featured_cta_label %}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.grid_heading != blank -%}
        <h3 class="apgo-event-grid-heading">
          <span class="apgo-event-grid-heading__star" aria-hidden="true">★</span>
          {{ section.settings.grid_heading }}
          <span class="apgo-event-grid-heading__star" aria-hidden="true">★</span>
        </h3>
      {%- endif -%}

      {% render 'apgo-event-product-grid',
        section: section,
        collection: event_collection,
        product_limit: product_limit
      %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Event Collection Grid",
  "tag": "section",
  "class": "apgo-event-collection-grid-wrapper",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Featured Stage (2 hero products)"
    },
    {
      "type": "checkbox",
      "id": "show_featured_stage",
      "label": "Show featured stage",
      "info": "Two hero products in a joined gold-rimmed pedestal at the top of the panel. Hides automatically if either product slot is empty.",
      "default": true
    },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "Stage heading",
      "default": "BIRTHDAY HIGHLIGHTS"
    },
    {
      "type": "text",
      "id": "featured_badge_text",
      "label": "Pill badge on each card",
      "default": "STAR PICK"
    },
    {
      "type": "text",
      "id": "featured_cta_label",
      "label": "CTA button label",
      "default": "View deal"
    },
    {
      "type": "product",
      "id": "featured_product_1",
      "label": "Hero product 01"
    },
    {
      "type": "product",
      "id": "featured_product_2",
      "label": "Hero product 02"
    },
    {
      "type": "text",
      "id": "grid_heading",
      "label": "Product grid heading (below the hero stage)",
      "info": "Gold pill-style heading shown above the 12-product grid. Leave blank to hide.",
      "default": "ALL BIRTHDAY DEALS"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section heading (optional)",
      "info": "Press Enter for a second line."
    },
    {
      "type": "checkbox",
      "id": "show_festive_lockup",
      "label": "Show festive heading lockup",
      "info": "Adds gold star icons either side of the heading + optional anniversary badge above.",
      "default": true
    },
    {
      "type": "text",
      "id": "anniversary_badge",
      "label": "Anniversary badge text",
      "info": "Small gold pill above the heading. Leave blank to hide.",
      "visible_if": "{{ section.settings.show_festive_lockup }}"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Max products",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 24
    },
    {
      "type": "header",
      "content": "Overlap (over banner above)"
    },
    {
      "type": "checkbox",
      "id": "overlap_enabled",
      "label": "Lift card panel over banner",
      "default": true
    },
    {
      "type": "range",
      "id": "overlap_offset",
      "label": "Overlap distance",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.overlap_enabled }}"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Top corner radius",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "organic", "label": "Editorial" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "product_card_size",
      "label": "Card size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" },
        { "value": "extra-large", "label": "Extra large" }
      ],
      "default": "large",
      "visible_if": "{{ section.settings.layout_type == 'grid' }}"
    },
    {
      "type": "select",
      "id": "mobile_product_card_size",
      "label": "Mobile card size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    },
    {
      "type": "select",
      "id": "product_grid_width",
      "label": "Grid width",
      "options": [
        { "value": "centered", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "full-width"
    },
    {
      "type": "checkbox",
      "id": "full_width_on_mobile",
      "label": "Full width on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_gap_horizontal",
      "label": "Horizontal gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "columns_gap_vertical",
      "label": "Vertical gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Section top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Section bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Event Collection Grid",
      "category": "APGO"
    }
  ]
}
{% endschema %}
