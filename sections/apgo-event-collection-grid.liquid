{% comment %}
  APGO Special Event — 3-zone curated content panel.
    Zone 1: Discount Zone (horizontal-scroll, admin-picked products)
    Zone 2: Buy 1 Free 1 Zone (horizontal-scroll, admin-picked products)
    Zone 3: Featured Stage (two stacked 1280:680 banners at the bottom)
  Cards in zones 1 + 2 reuse apgo-event-listing-card for visual consistency
  with the rest of the page.
{% endcomment %}

{{ 'apgo-event-page.css' | asset_url | stylesheet_tag }}

<div
  id="apgo-event-grid-{{ section.id }}"
  class="
    apgo-event-collection-grid section section--full-width
    {% if section.settings.overlap_enabled %}apgo-event-collection-grid--overlap{% endif %}
  "
  style="
    {% if section.settings.overlap_enabled %}
      --apgo-event-overlap: {{ section.settings.overlap_offset }}px;
      --apgo-event-curve-height: {{ section.settings.overlap_offset | times: 2 | at_most: 80 }}px;
    {% endif %}
    --apgo-event-panel-radius: {{ section.settings.panel_radius }}px;
    --padding-block-start: {{ section.settings.padding-block-start }}px;
    --padding-block-end: {{ section.settings.padding-block-end }}px;
  "
>
  <div class="apgo-event-collection-grid__panel">
    {% if section.settings.overlap_enabled %}
      <div class="apgo-event-collection-grid__curve" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 80" preserveAspectRatio="none" role="presentation">
          <path d="M0,80 C360,8 1080,8 1440,80 L1440,80 L0,80 Z"/>
        </svg>
      </div>
    {% endif %}

    {% if section.settings.heading != blank %}
      <header class="apgo-event-collection-grid__header">
        {%- comment -%}
          Festive heading lockup — gold star icons flank the title, with an
          optional anniversary badge stacked above. The decorative pieces
          render only when section.settings.show_festive_lockup is on so
          editors can fall back to the plain h2 if desired.
        {%- endcomment -%}
        {% if section.settings.show_festive_lockup %}
          <div class="apgo-event-heading-wrap">
            <span class="apgo-event-heading-star apgo-event-heading-star--left">
              {% render 'apgo-icon-star', unique: 'evt-grid-l' %}
            </span>
            <div class="apgo-event-heading-stack">
              {% if section.settings.anniversary_badge != blank %}
                <span class="apgo-event-heading-badge">{{ section.settings.anniversary_badge }}</span>
              {% endif %}
              <h2 class="apgo-event-collection-grid__heading apgo-event-heading-text">
                {{ section.settings.heading | escape | newline_to_br }}
              </h2>
            </div>
            <span class="apgo-event-heading-star apgo-event-heading-star--right">
              {% render 'apgo-icon-star', unique: 'evt-grid-r' %}
            </span>
          </div>
        {% else %}
          <h2 class="apgo-event-collection-grid__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
        {% endif %}
      </header>
    {% endif %}

    <div class="apgo-event-collection-grid__panel-body">
      {%- comment -%} ZONE 1 — Discount horizontal scroll {%- endcomment -%}
      {%- if section.settings.show_discount_zone and section.settings.discount_zone_products.size > 0 -%}
        {% render 'apgo-event-scroll-zone',
          heading: section.settings.discount_zone_heading,
          products: section.settings.discount_zone_products,
          zone_class: 'discount',
          section_id: section.id %}
      {%- endif -%}

      {%- comment -%} ZONE 2 — Buy 1 Free 1 horizontal scroll {%- endcomment -%}
      {%- if section.settings.show_b1f1_zone and section.settings.b1f1_zone_products.size > 0 -%}
        {% render 'apgo-event-scroll-zone',
          heading: section.settings.b1f1_zone_heading,
          products: section.settings.b1f1_zone_products,
          zone_class: 'b1f1',
          section_id: section.id %}
      {%- endif -%}

      {%- comment -%}
        ZONE 3 — Featured Stage banner stack.
        Both an image AND a product must be set per slot, otherwise the
        whole stage hides (never a half-empty pedestal).
      {%- endcomment -%}
      {%- assign fp1 = section.settings.featured_product_1 -%}
      {%- assign fp2 = section.settings.featured_product_2 -%}
      {%- assign fi1 = section.settings.featured_image_1 -%}
      {%- assign fi2 = section.settings.featured_image_2 -%}
      {%- if section.settings.show_featured_stage
            and fp1 != blank and fp2 != blank
            and fi1 != blank and fi2 != blank -%}
        <div class="apgo-event-featured-stage">
          {%- if section.settings.featured_heading != blank -%}
            <h3 class="apgo-event-featured-stage__heading">
              <span class="apgo-event-featured-stage__heading-star" aria-hidden="true">★</span>
              {{ section.settings.featured_heading }}
              <span class="apgo-event-featured-stage__heading-star" aria-hidden="true">★</span>
            </h3>
          {%- endif -%}
          <div class="apgo-event-featured-stage__stack">
            {% render 'apgo-event-featured-banner',
              product: fp1,
              image: fi1 %}
            {% render 'apgo-event-featured-banner',
              product: fp2,
              image: fi2 %}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Event Collection Grid",
  "tag": "section",
  "class": "apgo-event-collection-grid-wrapper",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section heading lockup"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Section heading (optional)",
      "info": "Press Enter for a second line."
    },
    {
      "type": "checkbox",
      "id": "show_festive_lockup",
      "label": "Show festive heading lockup",
      "info": "Adds gold star icons either side of the heading + optional anniversary badge above.",
      "default": true
    },
    {
      "type": "text",
      "id": "anniversary_badge",
      "label": "Anniversary badge text",
      "info": "Small gold pill above the heading. Leave blank to hide.",
      "visible_if": "{{ section.settings.show_festive_lockup }}"
    },
    {
      "type": "header",
      "content": "Discount Zone"
    },
    {
      "type": "checkbox",
      "id": "show_discount_zone",
      "label": "Show discount zone",
      "default": true
    },
    {
      "type": "text",
      "id": "discount_zone_heading",
      "label": "Zone heading",
      "default": "DISCOUNT DEALS"
    },
    {
      "type": "product_list",
      "id": "discount_zone_products",
      "label": "Discount products",
      "limit": 12
    },
    {
      "type": "header",
      "content": "Buy 1 Free 1 Zone"
    },
    {
      "type": "checkbox",
      "id": "show_b1f1_zone",
      "label": "Show Buy 1 Free 1 zone",
      "default": true
    },
    {
      "type": "text",
      "id": "b1f1_zone_heading",
      "label": "Zone heading",
      "default": "BUY 1 FREE 1"
    },
    {
      "type": "product_list",
      "id": "b1f1_zone_products",
      "label": "B1F1 products",
      "limit": 12
    },
    {
      "type": "header",
      "content": "Featured Stage (banner stack at bottom)"
    },
    {
      "type": "checkbox",
      "id": "show_featured_stage",
      "label": "Show featured stage",
      "info": "Hides automatically if any banner image OR product slot is empty.",
      "default": true
    },
    {
      "type": "text",
      "id": "featured_heading",
      "label": "Stage heading",
      "default": "BIRTHDAY HIGHLIGHTS"
    },
    {
      "type": "product",
      "id": "featured_product_1",
      "label": "Hero product 01"
    },
    {
      "type": "image_picker",
      "id": "featured_image_1",
      "label": "Banner image 01 (1280×680 recommended)"
    },
    {
      "type": "product",
      "id": "featured_product_2",
      "label": "Hero product 02"
    },
    {
      "type": "image_picker",
      "id": "featured_image_2",
      "label": "Banner image 02 (1280×680 recommended)"
    },
    {
      "type": "header",
      "content": "Panel chrome"
    },
    {
      "type": "checkbox",
      "id": "overlap_enabled",
      "label": "Lift card panel over banner",
      "default": false
    },
    {
      "type": "range",
      "id": "overlap_offset",
      "label": "Overlap distance",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56,
      "visible_if": "{{ section.settings.overlap_enabled }}"
    },
    {
      "type": "range",
      "id": "panel_radius",
      "label": "Top corner radius",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Section top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Section bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Event Collection Grid",
      "category": "APGO"
    }
  ]
}
{% endschema %}
