{% comment %}
  Reused "Spend More, Get More" section
  Simplified to one free-shipping goal (MY/SG market-aware)
{% endcomment %}

<section class="apgo-combined-goal" data-combined-goal data-country="{{ localization.country.iso_code | escape }}">
  <div class="apgo-combined-goal__inner">
    <h4 class="apgo-combined-goal__title">{{ section.settings.progress_title }}</h4>
    <div class="apgo-combined-goal__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <div class="apgo-combined-goal__fill" data-goal-fill></div>
    </div>
    <div class="apgo-combined-goal__amounts">
      <span data-goal-current>--</span>
      <span data-goal-target>--</span>
    </div>
    <p class="apgo-combined-goal__message" data-goal-message></p>
  </div>
</section>

<style>
  .apgo-combined-goal {
    width: 100%;
    max-width: none;
    margin: 18px 0 0;
    padding: 0 16px;
  }

  .apgo-combined-goal__inner {
    background: linear-gradient(145deg, #2d2d2d, #1a1a1a);
    border: 1px solid #404040;
    border-radius: 16px;
    padding: 18px;
  }

  .apgo-combined-goal__title {
    margin: 0 0 12px;
    font-size: 16px;
    font-weight: 700;
    color: {{ section.settings.text_color }};
  }

  .apgo-combined-goal__track {
    width: 100%;
    height: 10px;
    background: #333333;
    border-radius: 999px;
    overflow: hidden;
  }

  .apgo-combined-goal__fill {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, {{ section.settings.accent_color_start }}, {{ section.settings.accent_color_end }});
    transition: width 0.35s ease;
  }

  .apgo-combined-goal__amounts {
    margin-top: 8px;
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: {{ section.settings.text_secondary_color }};
  }

  .apgo-combined-goal__message {
    margin: 10px 0 0;
    font-size: 14px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
  }

  @media (max-width: 768px) {
    .apgo-combined-goal {
      padding: 0 12px;
    }
  }
</style>

<script>
  (() => {
    const root = document.querySelector('[data-combined-goal]');
    if (!root) return;
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const fill = root.querySelector('[data-goal-fill]');
    const msg = root.querySelector('[data-goal-message]');
    const current = root.querySelector('[data-goal-current]');
    const target = root.querySelector('[data-goal-target]');
    const bar = root.querySelector('.apgo-combined-goal__track');
    const country = (root.dataset.country || '').toUpperCase();

    const getRule = (iso) => {
      if (iso === 'MY') return { thresholdMinor: 10000, currency: 'MYR' };
      if (iso === 'SG') return { thresholdMinor: 7900, currency: 'SGD' };
      return null;
    };

    const formatMoney = (minor, currency) =>
      new Intl.NumberFormat(document.documentElement.lang || 'en', { style: 'currency', currency }).format((minor || 0) / 100);

    const render = (subtotalMinor) => {
      const rule = getRule(country);
      if (!rule) {
        root.style.display = 'none';
        return;
      }

      root.style.display = '';
      const progress = Math.min((subtotalMinor / rule.thresholdMinor) * 100, 100);
      const remaining = Math.max(rule.thresholdMinor - subtotalMinor, 0);

      fill.style.width = `${progress}%`;
      bar?.setAttribute('aria-valuenow', String(Math.round(progress)));
      current.textContent = formatMoney(subtotalMinor, rule.currency);
      target.textContent = formatMoney(rule.thresholdMinor, rule.currency);

      if (remaining <= 0) {
        msg.textContent = `{{ 'apgo_cart.free_shipping_unlocked' | t | escape }}`;
      } else {
        const amount = formatMoney(remaining, rule.currency);
        const text = `{{ 'apgo_cart.free_shipping_remaining' | t: amount: '__AMOUNT__' | escape }}`;
        msg.textContent = text.replace('__AMOUNT__', amount);
      }
    };

    const refresh = async () => {
      try {
        const res = await fetch('/cart.js', { headers: { Accept: 'application/json' } });
        const cart = await res.json();
        const subtotalMinor = Number(cart?.original_total_price || cart?.total_price || 0);
        render(subtotalMinor);
      } catch (_) {}
    };

    ['cart:refresh', 'cart:updated', 'cart:update', 'cart:change', 'product:added', 'ajaxProduct:added'].forEach((eventName) => {
      document.addEventListener(eventName, refresh, { passive: true });
    });

    refresh();
  })();
</script>

{% schema %}
{
  "name": "Spend More, Get More",
  "class": "section-cart-combined",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "progress_title",
      "label": "Progress title",
      "default": "Free shipping progress"
    },
    {
      "type": "color",
      "id": "accent_color_start",
      "label": "Accent color start",
      "default": "#ff6b35"
    },
    {
      "type": "color",
      "id": "accent_color_end",
      "label": "Accent color end",
      "default": "#f7931e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primary text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_secondary_color",
      "label": "Secondary text color",
      "default": "#cccccc"
    }
  ],
  "presets": [
    {
      "name": "Spend More, Get More"
    }
  ]
}
{% endschema %}
