{% comment %}
  Reused "Spend More, Get More" section
  Simplified to one free-shipping goal (MY/SG market-aware)
{% endcomment %}

<section class="apgo-combined-goal" data-combined-goal data-country="{{ localization.country.iso_code | escape }}">
  <div class="apgo-combined-goal__inner">
    <h4 class="apgo-combined-goal__title">{{ section.settings.progress_title }}</h4>
    <div class="apgo-combined-goal__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
      <div class="apgo-combined-goal__fill" data-goal-fill></div>
    </div>
    <div class="apgo-combined-goal__amounts">
      <span data-goal-current>--</span>
      <span data-goal-target>--</span>
    </div>
    <p class="apgo-combined-goal__status" data-goal-status></p>
    <p class="apgo-combined-goal__message" data-goal-message></p>
  </div>
</section>

<style>
  .apgo-combined-goal {
    --apgo-cart-inline-space: clamp(12px, 2.2vw, 28px);
  width: 100%;
    max-width: none;
    margin: 18px 0 0;
    padding: 0 var(--apgo-cart-inline-space);
  }

  /* APGO theme — soft dark card with subtle border, orange accent bar on top */
  .apgo-combined-goal__inner {
    position: relative;
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 14px;
    padding: 18px;
    overflow: hidden;
  }
  .apgo-combined-goal__inner::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: linear-gradient(90deg, #f08418, #ff9a3c);
  }

  .apgo-combined-goal__title {
    margin: 0 0 12px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .apgo-combined-goal__track {
    width: 100%;
    height: 12px;
    background: linear-gradient(180deg, #3a3a3a 0%, #2a2a2a 100%);
    border-radius: 999px;
    overflow: hidden;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 10%),
      inset 0 2px 6px rgb(0 0 0 / 38%),
      0 0 14px rgb(0 0 0 / 42%);
  }

  .apgo-combined-goal__fill {
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, {{ section.settings.accent_color_start }} 0%, {{ section.settings.accent_color_end }} 55%, {{ section.settings.accent_color_start }} 100%);
    transition: width 0.35s ease;
    box-shadow:
      0 0 12px rgb(255 255 255 / 25%),
      0 0 24px rgb(255 255 255 / 16%),
      0 0 36px rgb(255 255 255 / 10%);
  }

  .apgo-combined-goal__amounts {
    margin-top: 8px;
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    color: {{ section.settings.text_secondary_color }};
  }

  .apgo-combined-goal__message {
    margin: 10px 0 0;
    font-size: 14px;
    font-weight: 600;
    color: {{ section.settings.text_color }};
  }

  .apgo-combined-goal__status {
    margin: 10px 0 0;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .apgo-combined-goal.is-locked .apgo-combined-goal__status,
  .apgo-combined-goal.is-locked .apgo-combined-goal__message {
    color: #DC3545;
  }

  .apgo-combined-goal.is-unlocked .apgo-combined-goal__status,
  .apgo-combined-goal.is-unlocked .apgo-combined-goal__message {
    color: #28A745;
  }

  .apgo-combined-goal.is-locked .apgo-combined-goal__fill {
    background: linear-gradient(90deg, #DC3545, #DC3545) !important;
  }

  .apgo-combined-goal.is-unlocked .apgo-combined-goal__fill {
    background: linear-gradient(90deg, #34d399 0%, #22c55e 45%, #16a34a 100%) !important;
    box-shadow:
      0 0 14px rgb(34 197 94 / 95%),
      0 0 30px rgb(34 197 94 / 70%),
      0 0 48px rgb(22 163 74 / 45%);
  }

@media (max-width: 749px) {
    /* Mobile: free-shipping progress lives in sticky bar — hide duplicate card */
    .section-cart-combined {
      display: none !important;
    }
  }

  @media (min-width: 1024px) {
    .apgo-combined-goal {
      max-width: min(1200px, 66vw);
      margin: 18px auto 0;
    }
  }
</style>

<script>
  (() => {
    const root = document.querySelector('[data-combined-goal]');
    if (!root) return;
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const fill = root.querySelector('[data-goal-fill]');
    const msg = root.querySelector('[data-goal-message]');
    const status = root.querySelector('[data-goal-status]');
    const current = root.querySelector('[data-goal-current]');
    const target = root.querySelector('[data-goal-target]');
    const bar = root.querySelector('.apgo-combined-goal__track');
    const country = (root.dataset.country || '').toUpperCase();

    const getRule = (iso) => {
      if (iso === 'MY') return { thresholdMinor: 9900, currency: 'MYR' };
      if (iso === 'SG') return { thresholdMinor: 5500, currency: 'SGD' };
      return null;
    };

    /* Format with a market-specific currency symbol instead of the ISO code
       Intl outputs (which gave "MYR 772.00"). Override MYR → "RM", SGD → "S$";
       fall back to narrowSymbol for any other currency. */
    const formatMoney = (minor, currency) => {
      const amount = (minor || 0) / 100;
      const fixed = amount.toLocaleString(document.documentElement.lang || 'en', {
        minimumFractionDigits: 2, maximumFractionDigits: 2
      });
      if (currency === 'MYR') return `RM ${fixed}`;
      if (currency === 'SGD') return `S$ ${fixed}`;
      try {
        return new Intl.NumberFormat(document.documentElement.lang || 'en', {
          style: 'currency', currency, currencyDisplay: 'narrowSymbol'
        }).format(amount);
      } catch (_) {
        return `${currency} ${fixed}`;
      }
    };

    const render = (subtotalMinor) => {
      const rule = getRule(country);
      if (!rule) {
        root.style.display = 'none';
        return;
      }

      root.style.display = '';
      const progress = Math.min((subtotalMinor / rule.thresholdMinor) * 100, 100);
      const remaining = Math.max(rule.thresholdMinor - subtotalMinor, 0);

      fill.style.width = `${progress}%`;
      bar?.setAttribute('aria-valuenow', String(Math.round(progress)));
      current.textContent = formatMoney(subtotalMinor, rule.currency);
      target.textContent = formatMoney(rule.thresholdMinor, rule.currency);

      if (remaining <= 0) {
        root.classList.remove('is-locked');
        root.classList.add('is-unlocked');
        if (status) status.textContent = `🔓 {{ 'apgo_cart.free_shipping_unlocked_label' | t | escape }}`;
        /* Status row already shows "Unlocked" — drop the duplicate message row. */
        msg.textContent = '';
      } else {
        root.classList.remove('is-unlocked');
        root.classList.add('is-locked');
        if (status) status.textContent = `🔒 {{ 'apgo_cart.free_shipping_locked_label' | t | escape }}`;
        const amount = formatMoney(remaining, rule.currency);
        const text = `{{ 'apgo_cart.free_shipping_remaining' | t: amount: '__AMOUNT__' | escape }}`;
        msg.textContent = text.replace('__AMOUNT__', amount);
      }
    };

    let refreshTmr;
    const refresh = async () => {
      try {
        const res = await fetch('/cart.js', { headers: { Accept: 'application/json' }, cache: 'no-store' });
        const cart = await res.json();
        const subtotalMinor = Number(cart?.original_total_price || cart?.total_price || 0);
        render(subtotalMinor);
      } catch (_) {}
    };
    const refreshDebounced = () => { clearTimeout(refreshTmr); refreshTmr = setTimeout(refresh, 240); };

    ['cart:refresh', 'cart:updated', 'cart:update', 'cart:change', 'quantity-selector:update', 'product:added', 'ajaxProduct:added'].forEach((eventName) => {
      document.addEventListener(eventName, refreshDebounced, { passive: true });
    });

    // Most reliable trigger: Horizon morphs <cart-items-component> on every qty
    // change. Observe its DOM directly instead of trusting event names — this is
    // what makes the bar refresh without a hard reload. Re-attach if the element
    // is section-replaced.
    const attachCartItemsObserver = () => {
      const el = document.querySelector('cart-items-component');
      if (!el || el.__apgoGoalObserved) return;
      el.__apgoGoalObserved = true;
      new MutationObserver(refreshDebounced)
        .observe(el, { childList: true, subtree: true, characterData: true });
    };
    attachCartItemsObserver();
    new MutationObserver(attachCartItemsObserver)
      .observe(document.body, { childList: true, subtree: true });

    refresh();
  })();
</script>

{% schema %}
{
  "name": "Spend More, Get More",
  "class": "section-cart-combined",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "progress_title",
      "label": "Progress title",
      "default": "Free shipping progress"
    },
    {
      "type": "color",
      "id": "accent_color_start",
      "label": "Accent color start",
      "default": "#ff6b35"
    },
    {
      "type": "color",
      "id": "accent_color_end",
      "label": "Accent color end",
      "default": "#f7931e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Primary text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_secondary_color",
      "label": "Secondary text color",
      "default": "#cccccc"
      }
    ],
    "presets": [
      {
      "name": "Spend More, Get More"
      }
    ]
  }
  {% endschema %}
