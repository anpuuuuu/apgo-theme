{% comment %}
  APGO · PDP content (single section, mobile + desktop)

  This is the only PDP section on the apgo-v1s-plus product template.
  It owns BOTH the desktop hero (3-col grid: thumb rail + main image + sidebar)
  and the mobile mega-shell (carousel + info + tabs/panels + sticky CTA).

  CSS visibility toggle:
    .apgo-pdp.apgo-desktop-only         → desktop only (hidden < 768px)
    .apgo-mpdp-mobile-shell             → mobile only (hidden >= 768px)
    .apgo-mpdp-sticky                   → mobile only

  Both layouts share the same {% form 'product' %}, the same
  data-apgo-variants JSON, the same ship card (from shop metafield),
  and the same option inputs. Picking a variant or quantity in either
  layout updates BOTH (apgo-pdp.js dedupes option groups by
  data-option-position so duplicated DOM nodes still resolve to one
  variant).

  apgo-hero.liquid still exists because three /pages/* templates use it,
  but for the product template this section is the single source of truth.
{% endcomment %}

{%- liquid
  assign v = product.selected_or_first_available_variant
  assign has_compare = false
  if product.compare_at_price > product.price
    assign has_compare = true
    assign discount_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
  endif
-%}

<section class="apgo-mpdp" data-section-id="{{ section.id }}">
  {% form 'product', product, id: 'apgo-mobile-product-form', class: 'apgo-product-form apgo-mpdp-form' %}
    <input type="hidden" name="id" value="{{ v.id }}" data-apgo-variant-id>

    {%- comment -%} ====== DESKTOP-ONLY SHELL: 3-col hero (hidden on mobile) ====== {%- endcomment -%}
    <div class="apgo-pdp apgo-desktop-only">
      <div class="apgo-container">

        {%- comment -%} Breadcrumb {%- endcomment -%}
        <nav class="apgo-breadcrumb">
          <a href="{{ routes.root_url }}">Home</a>
          <span class="apgo-sep">/</span>
          {%- if collection -%}
            <a href="{{ collection.url }}">{{ collection.title }}</a>
            <span class="apgo-sep">/</span>
          {%- endif -%}
          <span>{{ product.title }}</span>
        </nav>

        <div class="apgo-hero-grid">

          {%- comment -%} Left column: main image + thumb rail {%- endcomment -%}
          <div class="apgo-hero-left">
            <div class="apgo-main-media">
              {%- if product.featured_media -%}
                <img class="apgo-main-img"
                     src="{{ product.featured_media | image_url: width: 1400 }}"
                     alt="{{ product.featured_media.alt | default: product.title }}"
                     width="{{ product.featured_media.preview_image.width }}"
                     height="{{ product.featured_media.preview_image.height }}"
                     loading="eager"
                     data-apgo-main-img>
              {%- else -%}
                <div class="apgo-main-img apgo-main-placeholder"></div>
              {%- endif -%}

              {%- if has_compare -%}
                <div class="apgo-discount-badge">Limited time {{ discount_pct }}% OFF</div>
              {%- endif -%}
            </div>

            {%- if section.settings.show_thumb_rail -%}
              <div class="apgo-thumb-rail-wrap">
                <button type="button" class="apgo-thumb-nav apgo-thumb-nav--prev" data-apgo-thumb-nav="prev" aria-label="Previous">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <div class="apgo-thumb-rail" data-apgo-thumb-rail>
                  {%- if product.media.size > 0 -%}
                    {%- for m in product.media -%}
                      <button type="button"
                              class="apgo-thumb {% if forloop.first %}active{% endif %}"
                              data-apgo-thumb-idx="{{ forloop.index0 }}"
                              data-apgo-image-id="{{ m.preview_image.id | default: m.id }}"
                              aria-label="Show image {{ forloop.index }}">
                        <img src="{{ m | image_url: width: 200 }}"
                             alt="{{ m.alt | default: product.title }}"
                             loading="lazy" width="80" height="80">
                      </button>
                    {%- endfor -%}
                  {%- endif -%}
                </div>
                <button type="button" class="apgo-thumb-nav apgo-thumb-nav--next" data-apgo-thumb-nav="next" aria-label="Next">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
              </div>
            {%- endif -%}
          </div>

          {%- comment -%} Right column: purchase sidebar {%- endcomment -%}
          <aside class="apgo-sidebar">

            {%- if section.settings.kicker != blank -%}
              <div class="apgo-kicker">{{ section.settings.kicker }}</div>
            {%- endif -%}

            <h1 class="apgo-title apgo-serif">{{ product.title }}</h1>

            {%- if product.metafields.apgo.subtitle != blank -%}
              <p class="apgo-subtitle">{{ product.metafields.apgo.subtitle }}</p>
            {%- endif -%}

            {%- if section.settings.show_rating -%}
              <div class="apgo-rating">
                <span class="apgo-stars">★★★★★</span>
                <span class="apgo-rating-num">{{ section.settings.rating_score }}</span>
                <span class="apgo-muted">· {{ section.settings.rating_count }} reviews</span>
              </div>
            {%- endif -%}

            <div class="apgo-price-row">
              <span class="apgo-serif apgo-price" data-apgo-price>{{ v.price | money }}</span>
              {%- if has_compare -%}
                <span class="apgo-price-compare" data-apgo-compare>{{ product.compare_at_price | money }}</span>
                <span class="apgo-discount-pill">−{{ discount_pct }}%</span>
              {%- endif -%}
            </div>

            {%- if section.settings.show_installment -%}
              <div class="apgo-installment apgo-muted" data-apgo-installment>
                3 interest-free installments · {{ v.price | divided_by: 3 | money }} each
              </div>
            {%- endif -%}

            {%- comment -%}
              Bundle picker (limited-time bundle) replaces variant + qty + CTAs when
              product.metafields.apgo.bundle_enabled is true. Set per-product
              in admin metafield. See docs/V1S_PLUS_BUNDLE_PLAN.md.
            {%- endcomment -%}
            {%- if product.metafields.apgo.bundle_enabled -%}
              {%- render 'apgo-bundle-widget', product: product, shell: 'desktop' -%}
            {%- else -%}

            {%- comment -%} Variant options (scent + size) {%- endcomment -%}
            {%- for option in product.options_with_values -%}
              {%- assign is_scent = false -%}
              {%- if option.name contains '香' or option.name contains 'Scent' -%}
                {%- assign is_scent = true -%}
              {%- endif -%}

              <div class="apgo-option-group" data-apgo-option-group data-option-position="{{ option.position }}">
                <div class="apgo-option-label">
                  <span class="apgo-kicker-small">{{ option.name }}</span>
                  <span class="apgo-muted apgo-option-current" data-apgo-current-value>{{ option.selected_value }}</span>
                </div>

                {%- if is_scent -%}
                  {%- assign scent_palette = shop.metafields.apgo.scents.value -%}
                  <div class="apgo-scent-grid">
                    {%- for value in option.values -%}
                      {%- assign swatch_color = '' -%}
                      {%- if scent_palette != blank -%}
                        {%- for s in scent_palette -%}
                          {%- if s.name == value -%}{%- assign swatch_color = s.hex -%}{%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                      {%- if swatch_color == '' -%}
                        {%- assign swatch_color = '#E8DFC9' -%}
                        {%- case value -%}
                          {%- when '淨心棉花' -%}{%- assign swatch_color = '#E8DFC9' -%}
                          {%- when '花漾蒼蘭' -%}{%- assign swatch_color = '#D4DDE0' -%}
                          {%- when '浪漫玫瑰' -%}{%- assign swatch_color = '#E8D4CF' -%}
                          {%- when '海洋晨曦' -%}{%- assign swatch_color = '#C8D6DA' -%}
                          {%- when '清雅白茶' -%}{%- assign swatch_color = '#DAE0CE' -%}
                          {%- when '薰衣紫戀' -%}{%- assign swatch_color = '#D6CFDD' -%}
                        {%- endcase -%}
                      {%- endif -%}
                      <label class="apgo-scentbtn {% if option.selected_value == value %}active{% endif %}">
                        <input type="radio"
                               name="options[{{ option.name | escape }}]"
                               value="{{ value | escape }}"
                               data-apgo-option-input
                               {% if option.selected_value == value %}checked{% endif %}>
                        <span class="apgo-swatch" style="background:{{ swatch_color }}"></span>
                        <span class="apgo-serif">{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="apgo-chip-row">
                    {%- for value in option.values -%}
                      <label class="apgo-chip {% if option.selected_value == value %}active{% endif %}">
                        <input type="radio"
                               name="options[{{ option.name | escape }}]"
                               value="{{ value | escape }}"
                               data-apgo-option-input
                               {% if option.selected_value == value %}checked{% endif %}>
                        <span>{{ value }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            {%- endfor -%}

            {%- comment -%} Quantity stepper {%- endcomment -%}
            <div class="apgo-option-group">
              <div class="apgo-kicker-small" style="margin-bottom:10px;">Quantity</div>
              <div class="apgo-qty">
                <button type="button" data-apgo-qty="down" aria-label="Decrease">−</button>
                <input type="number" name="quantity" value="1" min="1" data-apgo-qty-input>
                <button type="button" data-apgo-qty="up" aria-label="Increase">+</button>
              </div>
            </div>

            {%- comment -%} CTAs {%- endcomment -%}
            <div class="apgo-cta-group">
              <button type="submit" name="add"
                      class="apgo-cta-primary"
                      data-apgo-add
                      {% unless v.available %}disabled{% endunless %}>
                {%- if v.available -%}
                  Add to cart · <span data-apgo-total>{{ v.price | money }}</span>
                {%- else -%}
                  Restocking
                {%- endif -%}
              </button>

              {%- if section.settings.show_buy_now -%}
                <button type="button" class="apgo-cta-secondary" data-apgo-buy-now>
                  Buy now · Express checkout
                </button>
              {%- endif -%}
            </div>

            {%- endif -%}{%- comment -%} end of apgo.bundle_enabled if/else (desktop) {%- endcomment -%}

            {%- comment -%}
              Ship card — same shop.metafields.apgo.ship_rows source as the
              mobile shell uses below. Single edit in admin updates both.
            {%- endcomment -%}
            {%- assign desktop_ship_meta = shop.metafields.apgo.ship_rows.value -%}
            {%- assign desktop_ship_blocks = section.blocks | where: 'type', 'ship_row' -%}
            {%- if desktop_ship_meta != blank and desktop_ship_meta.size > 0 -%}
              <div class="apgo-ship-card">
                {%- for r in desktop_ship_meta -%}
                  <div class="apgo-ship-row">
                    <span class="apgo-ship-icon">{{ r.numeral }}</span>
                    <div>
                      <strong>{{ r.title }}</strong>
                      <div class="apgo-muted apgo-ship-subtitle">{{ r.subtitle | newline_to_br }}</div>
                    </div>
                  </div>
                  {%- unless forloop.last -%}<div class="apgo-ship-sep"></div>{%- endunless -%}
                {%- endfor -%}
              </div>
            {%- elsif desktop_ship_blocks.size > 0 -%}
              <div class="apgo-ship-card">
                {%- for block in desktop_ship_blocks -%}
                  <div class="apgo-ship-row" {{ block.shopify_attributes }}>
                    <span class="apgo-ship-icon">{{ block.settings.numeral }}</span>
                    <div>
                      <strong>{{ block.settings.title }}</strong>
                      <div class="apgo-muted apgo-ship-subtitle">{{ block.settings.subtitle | newline_to_br }}</div>
                    </div>
                  </div>
                  {%- unless forloop.last -%}<div class="apgo-ship-sep"></div>{%- endunless -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

          </aside>
        </div>
      </div>
    </div>
    {%- comment -%} ====== END DESKTOP-ONLY SHELL ====== {%- endcomment -%}

    {%- comment -%} ====== MOBILE-ONLY SHELL: carousel + info block (hidden on desktop) ====== {%- endcomment -%}
    <div class="apgo-mpdp-mobile-shell">

    {%- comment -%} Carousel (video optional + images) {%- endcomment -%}
    <div class="apgo-mpdp-carousel" data-apgo-carousel>
      <div class="apgo-mpdp-track" data-apgo-carousel-track>
        {%- if section.settings.video_url != blank -%}
          <div class="apgo-mpdp-slide apgo-mpdp-slide-video">
            <div class="apgo-mpdp-video-poster" style="background-image:url('{{ section.settings.video_poster | image_url: width: 800 }}');">
              <div class="apgo-mpdp-play"><span></span></div>
              <div class="apgo-mpdp-video-label">▶ {{ section.settings.video_label | default: 'Product test video · 60s' }}</div>
            </div>
          </div>
        {%- endif -%}
        {%- if product.media.size > 0 -%}
          {%- for m in product.media -%}
            <div class="apgo-mpdp-slide" data-apgo-image-id="{{ m.preview_image.id | default: m.id }}">
              <img src="{{ m | image_url: width: 900 }}" alt="{{ m.alt | default: product.title }}" width="{{ m.preview_image.width }}" height="{{ m.preview_image.height }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
      {%- if has_compare -%}
        <div class="apgo-mpdp-discount">Limited time {{ discount_pct }}% OFF</div>
      {%- endif -%}
      <div class="apgo-mpdp-counter"><span data-apgo-carousel-idx>1</span> / <span data-apgo-carousel-total></span></div>
    </div>

    {%- comment -%} Mobile thumbnail rail — click to jump carousel; swipeable; ◀ ▶ to step {%- endcomment -%}
    {%- if section.settings.show_thumb_rail and product.media.size > 1 -%}
      <div class="apgo-mpdp-thumb-rail-wrap">
        <button type="button" class="apgo-mpdp-thumb-nav apgo-mpdp-thumb-nav--prev" data-apgo-mthumb-nav="prev" aria-label="Previous">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div class="apgo-mpdp-thumb-rail" data-apgo-mthumb-rail>
          {%- for m in product.media -%}
            <button type="button"
                    class="apgo-mpdp-thumb {% if forloop.first %}active{% endif %}"
                    data-apgo-mthumb-idx="{{ forloop.index0 }}"
                    aria-label="Show image {{ forloop.index }}">
              <img src="{{ m | image_url: width: 160 }}" alt="" width="{{ m.preview_image.width }}" height="{{ m.preview_image.height }}" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
        <button type="button" class="apgo-mpdp-thumb-nav apgo-mpdp-thumb-nav--next" data-apgo-mthumb-nav="next" aria-label="Next">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
    {%- endif -%}

    {%- comment -%} Info block {%- endcomment -%}
    <div class="apgo-mpdp-info">
      {%- if section.settings.kicker != blank -%}
        <div class="apgo-mpdp-kicker">{{ section.settings.kicker }}</div>
      {%- endif -%}
      <h1 class="apgo-mpdp-title apgo-serif">{{ product.title }}</h1>
      {%- if product.metafields.apgo.subtitle != blank -%}
        <div class="apgo-mpdp-subtitle">{{ product.metafields.apgo.subtitle }}</div>
      {%- endif -%}

      {%- if section.settings.show_rating -%}
        <div class="apgo-mpdp-rating">
          <span class="apgo-stars">★★★★★</span>
          <strong>{{ section.settings.rating_score }}</strong>
          <span class="apgo-muted">· {{ section.settings.rating_count }} reviews</span>
        </div>
      {%- endif -%}

      <div class="apgo-mpdp-price-row">
        <span class="apgo-serif apgo-mpdp-price" data-apgo-price>{{ v.price | money }}</span>
        {%- if has_compare -%}
          <span class="apgo-mpdp-compare" data-apgo-compare>{{ product.compare_at_price | money }}</span>
          <span class="apgo-mpdp-discount-pill">−{{ discount_pct }}%</span>
        {%- endif -%}
      </div>
      {%- if section.settings.show_installment -%}
        <div class="apgo-mpdp-installment" data-apgo-installment>3 interest-free installments · {{ v.price | divided_by: 3 | money }} each</div>
      {%- endif -%}

      {%- comment -%}
        Bundle picker (limited-time bundle) — mobile shell. Mirrors the desktop
        path above; gated on the same product.metafields.apgo.bundle_enabled.
      {%- endcomment -%}
      {%- if product.metafields.apgo.bundle_enabled -%}
        {%- render 'apgo-bundle-widget', product: product, shell: 'mobile', with_cta: false -%}
      {%- else -%}

      {%- comment -%} Variant options {%- endcomment -%}
      {%- for option in product.options_with_values -%}
        {%- assign is_scent = false -%}
        {%- if option.name contains '香' or option.name contains 'Scent' -%}{%- assign is_scent = true -%}{%- endif -%}

        <div class="apgo-mpdp-opt" data-apgo-option-group data-option-position="{{ option.position }}">
          <div class="apgo-mpdp-opt-label">
            <span>{{ option.name }}</span>
            <span class="apgo-muted" data-apgo-current-value>{{ option.selected_value }}</span>
          </div>
          {%- if is_scent -%}
            {%- assign scent_palette = shop.metafields.apgo.scents.value -%}
            <div class="apgo-mpdp-scent-grid">
              {%- for value in option.values -%}
                {%- comment -%} Look up swatch hex from shop metaobject palette; fallback to hardcoded case {%- endcomment -%}
                {%- assign sc = '' -%}
                {%- if scent_palette != blank -%}
                  {%- for s in scent_palette -%}
                    {%- if s.name == value -%}{%- assign sc = s.hex -%}{%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                {%- if sc == '' -%}
                  {%- assign sc = '#E8DFC9' -%}
                  {%- case value -%}
                    {%- when '淨心棉花' -%}{%- assign sc = '#E8DFC9' -%}
                    {%- when '花漾蒼蘭' -%}{%- assign sc = '#D4DDE0' -%}
                    {%- when '浪漫玫瑰' -%}{%- assign sc = '#E8D4CF' -%}
                    {%- when '海洋晨曦' -%}{%- assign sc = '#C8D6DA' -%}
                    {%- when '清雅白茶' -%}{%- assign sc = '#DAE0CE' -%}
                    {%- when '薰衣紫戀' -%}{%- assign sc = '#D6CFDD' -%}
                  {%- endcase -%}
                {%- endif -%}
                <label class="apgo-mpdp-scentbtn {% if option.selected_value == value %}active{% endif %}">
                  <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-apgo-option-input {% if option.selected_value == value %}checked{% endif %}>
                  <span class="apgo-mpdp-swatch" style="background:{{ sc }}"></span>
                  <span class="apgo-serif">{{ value }}</span>
                </label>
              {%- endfor -%}
            </div>
          {%- else -%}
            <div class="apgo-mpdp-chip-grid">
              {%- for value in option.values -%}
                <label class="apgo-mpdp-chip {% if option.selected_value == value %}active{% endif %}">
                  <input type="radio" name="options[{{ option.name | escape }}]" value="{{ value | escape }}" data-apgo-option-input {% if option.selected_value == value %}checked{% endif %}>
                  <span>{{ value }}</span>
                </label>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- comment -%} Qty (inline) {%- endcomment -%}
      <div class="apgo-mpdp-qty-row">
        <span class="apgo-mpdp-qty-label">Quantity</span>
        <div class="apgo-mpdp-qty">
          <button type="button" data-apgo-qty="down" aria-label="Decrease">−</button>
          <input type="number" name="quantity" value="1" min="1" data-apgo-qty-input>
          <button type="button" data-apgo-qty="up" aria-label="Increase">+</button>
        </div>
      </div>

      {%- endif -%}{%- comment -%} end of apgo.bundle_enabled if/else (mobile) {%- endcomment -%}

      {%- comment -%}
        Ship card — single source of truth lives in
        shop.metafields.apgo.ship_rows (List of `shipping_row` metaobjects).
        If empty (e.g., during migration), fall back to legacy section blocks.
      {%- endcomment -%}
      {%- assign ship_meta = shop.metafields.apgo.ship_rows.value -%}
      {%- assign ship_blocks = section.blocks | where: 'type', 'ship_row' -%}
      {%- if ship_meta != blank and ship_meta.size > 0 -%}
        <div class="apgo-mpdp-ship">
          {%- for r in ship_meta -%}
            <div class="apgo-mpdp-ship-row">
              <span class="apgo-mpdp-ship-icon">{{ r.numeral }}</span>
              <div>
                <strong>{{ r.title }}</strong>
                <div class="apgo-muted apgo-mpdp-ship-subtitle">{{ r.subtitle | newline_to_br }}</div>
              </div>
            </div>
            {%- unless forloop.last -%}<div class="apgo-mpdp-ship-sep"></div>{%- endunless -%}
          {%- endfor -%}
        </div>
      {%- elsif ship_blocks.size > 0 -%}
        <div class="apgo-mpdp-ship">
          {%- for block in ship_blocks -%}
            <div class="apgo-mpdp-ship-row" {{ block.shopify_attributes }}>
              <span class="apgo-mpdp-ship-icon">{{ block.settings.numeral }}</span>
              <div>
                <strong>{{ block.settings.title }}</strong>
                <div class="apgo-muted apgo-mpdp-ship-subtitle">{{ block.settings.subtitle | newline_to_br }}</div>
              </div>
            </div>
            {%- unless forloop.last -%}<div class="apgo-mpdp-ship-sep"></div>{%- endunless -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>

    </div>
    {%- comment -%} ====== END MOBILE-ONLY SHELL ====== {%- endcomment -%}

    {%- comment -%}
      Product feature card — visible on BOTH desktop and mobile,
      positioned between the hero/info area and the tabs. Content comes
      from the product's main Description field (admin → Products →
      Description). Strips the <!-- apgo:sections --> marker so it
      doesn't leak into the rendered card.
    {%- endcomment -%}
    {%- assign feature_text = product.description | replace: '<!-- apgo:sections -->', '' | strip -%}
    {%- if feature_text != blank -%}
      <div class="apgo-mpdp-feature-card">
        <div class="apgo-mpdp-feature-head">
          <span class="apgo-mpdp-feature-kicker">— FEATURES —</span>
          <h3 class="apgo-mpdp-feature-title apgo-serif">Product Features</h3>
        </div>
        <div class="apgo-mpdp-feature-body rte">
          {{ feature_text }}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%} Tabs {%- endcomment -%}
    <div class="apgo-mpdp-tabs-sticky" data-apgo-mtabs-sticky>
      <div class="apgo-mpdp-tabs" role="tablist" data-apgo-mtabs>
        <button type="button" class="apgo-mpdp-tab active" id="apgo-mtab-desc-{{ section.id }}" data-apgo-mtab="desc" role="tab" aria-controls="apgo-mpanel-desc-{{ section.id }}" aria-selected="true">Product Features</button>
        <button type="button" class="apgo-mpdp-tab" id="apgo-mtab-sgs-{{ section.id }}" data-apgo-mtab="sgs" role="tab" aria-controls="apgo-mpanel-sgs-{{ section.id }}" aria-selected="false" tabindex="-1">{{ 'products.apgo_v1s_plus.sgs_certification' | t }}</button>
        <button type="button" class="apgo-mpdp-tab" id="apgo-mtab-spec-{{ section.id }}" data-apgo-mtab="spec" role="tab" aria-controls="apgo-mpanel-spec-{{ section.id }}" aria-selected="false" tabindex="-1">{{ 'products.apgo_v1s_plus.details' | t }}</button>
        <button type="button" class="apgo-mpdp-tab" id="apgo-mtab-review-{{ section.id }}" data-apgo-mtab="review" role="tab" aria-controls="apgo-mpanel-review-{{ section.id }}" aria-selected="false" tabindex="-1">{{ 'products.apgo_v1s_plus.reviews' | t }}</button>
        <button type="button" class="apgo-mpdp-tab" id="apgo-mtab-faq-{{ section.id }}" data-apgo-mtab="faq" role="tab" aria-controls="apgo-mpanel-faq-{{ section.id }}" aria-selected="false" tabindex="-1">Product FAQ</button>
      </div>
    </div>

    {%- comment -%}
      Tab panel: Product description
      ----------------------------------------------------------------
      STRICT MODE: this entire panel is driven by Shopify admin →
      Product → Description (rich-text editor, HTML mode capable).

      To reproduce the original UI (Ritual hero / pain point × solution / comparison table /
      UGC / long image) the user pastes structured HTML using the existing
      class hooks (.apgo-mpdp-ritual-wrap, .apgo-mpdp-pain-wrap,
      .apgo-mpdp-cmp-wrap, .apgo-mpdp-ugc-wrap, .apgo-mpdp-longimg-wrap).
      A reference snippet is kept in the team handbook.

      Direct-child <div> snippets in description are NOT constrained by
      .apgo-mpdp-description's reading-width rules — they keep their
      original full-bleed look (see apgo-pdp.css line ~735).
    {%- endcomment -%}
    <div class="apgo-mpdp-panel active" id="apgo-mpanel-desc-{{ section.id }}" data-apgo-mpanel="desc" role="tabpanel" aria-labelledby="apgo-mtab-desc-{{ section.id }}">
      {%- comment -%}
        Tab content order:
          1. Product description images (metafield, list of images) —
             the long-form product story shots
          2. Pain × solution (metaobject)
          3. Decorative pic (metafield)
          4. Comparison table (metaobject)
          5. UGC grid (blocks)

        Note: product.description text itself no longer renders here — it
        was moved to the .apgo-mpdp-feature-card under the ship card above.
      {%- endcomment -%}
      {%- assign feature_imgs = product.metafields.custom.product_description_images.value -%}
      {%- if feature_imgs != blank and feature_imgs.size > 0 -%}
        <div class="apgo-mpdp-feature-gallery">
          {%- for img in feature_imgs -%}
            <img src="{{ img | image_url: width: 1200 }}"
                 alt="{{ product.title }} product description image {{ forloop.index }}"
                 width="{{ img.width }}"
                 height="{{ img.height }}"
                 loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                 class="apgo-mpdp-feature-gallery-img">
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- comment -%} Pain × solution section (metaobject-driven) {%- endcomment -%}
      {%- assign mf_pain = product.metafields.apgo.pain_solutions.value -%}
      {%- if section.settings.show_pain_solution and mf_pain != blank and mf_pain.size > 0 -%}
        <div class="apgo-mpdp-pain-wrap">
          {%- if section.settings.pain_heading != blank -%}
            <h3>{{ section.settings.pain_heading }}</h3>
          {%- endif -%}
          <div class="apgo-mpdp-pain-grid">
            {%- for entry in mf_pain -%}
              <div class="apgo-mpdp-pain-card">
                <div class="apgo-muted">{{ entry.pain }}</div>
                <span class="apgo-mpdp-pain-arrow">→</span>
                <div class="apgo-serif">{{ entry.solution }}</div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} Optional decorative image between pain and cmp sections {%- endcomment -%}
      {%- assign mf_pic = product.metafields.custom.pic.value -%}
      {%- if mf_pic != blank -%}
        <div class="apgo-mpdp-pic-wrap">
          <img src="{{ mf_pic | image_url: width: 1600 }}" alt="{{ product.title }}" width="{{ mf_pic.width }}" height="{{ mf_pic.height }}" loading="lazy">
        </div>
      {%- endif -%}

      {%- comment -%} Comparison table section (metaobject-driven) {%- endcomment -%}
      {%- assign mf_cmp = product.metafields.apgo.comparison_rows.value -%}
      {%- if section.settings.show_comparison and mf_cmp != blank and mf_cmp.size > 0 -%}
        <div class="apgo-mpdp-cmp-wrap">
          {%- if section.settings.cmp_kicker != blank -%}
            <span class="apgo-mpdp-kicker">— {{ section.settings.cmp_kicker }} —</span>
          {%- endif -%}
          {%- if section.settings.cmp_title != blank -%}
            <h3>{{ section.settings.cmp_title }}</h3>
          {%- endif -%}
          <div class="apgo-mpdp-cmp">
            <div class="apgo-mpdp-cmp-head">
              <div>{{ section.settings.cmp_col_feature | default: 'Comparison' }}</div>
              <div>{{ section.settings.cmp_col_apgo | default: 'APGO Super Laundry Detergent' }}</div>
              <div>{{ section.settings.cmp_col_competitor | default: 'Typical retail detergent' }}</div>
            </div>
            {%- for entry in mf_cmp -%}
              <div class="apgo-mpdp-cmp-row">
                <div>{{ entry.feature }}</div>
                <div>{{ entry.apgo_value }}</div>
                <div>{{ entry.competitor_value }}</div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%}
        UGC grid — kept editable in theme editor (blocks of type "ugc") so
        non-technical admin can add/remove IG cells without touching HTML.
        Renders right after description; expects the description to already
        contain the heading wrap (kicker + user photos · Instagram).
      {%- endcomment -%}
      {%- assign ugc_blocks = section.blocks | where: 'type', 'ugc' -%}
      {%- if ugc_blocks.size > 0 -%}
        {%- assign ugc_has_heading = false -%}
        {%- if section.settings.ugc_kicker != blank or section.settings.ugc_title != blank -%}
          {%- assign ugc_has_heading = true -%}
        {%- endif -%}
        <div class="apgo-mpdp-ugc-wrap{% unless ugc_has_heading %} apgo-mpdp-ugc-wrap--grid-only{% endunless %}">
          {%- if section.settings.ugc_kicker != blank -%}
            <span class="apgo-mpdp-kicker">{{ section.settings.ugc_kicker }}</span>
          {%- endif -%}
          {%- if section.settings.ugc_title != blank -%}
            <h3>{{ section.settings.ugc_title }}</h3>
          {%- endif -%}
          <div class="apgo-mpdp-ugc-grid">
            {%- for block in ugc_blocks -%}
              <a href="{{ block.settings.url }}" class="apgo-mpdp-ugc-cell" {{ block.shopify_attributes }} {% if block.settings.url != blank %}target="_blank" rel="noopener"{% endif %}>
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 400 }}" alt="@{{ block.settings.handle }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
                {%- endif -%}
                <span class="apgo-mpdp-ugc-like">♡ {{ block.settings.likes }}</span>
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Tab panel: SGS — metafield-driven; if empty, panel renders empty-state {%- endcomment -%}
    {%- assign sgs_reports = product.metafields.custom.sgs_reports.value -%}
    <div class="apgo-mpdp-panel" id="apgo-mpanel-sgs-{{ section.id }}" data-apgo-mpanel="sgs" role="tabpanel" aria-labelledby="apgo-mtab-sgs-{{ section.id }}">
      {%- if sgs_reports == blank or sgs_reports.size == 0 -%}
        <div class="apgo-sgs-empty apgo-muted">SGS test reports not yet available</div>
      {%- else -%}
      <div class="apgo-sgs">
        <div class="apgo-sgs-header">
          <div class="apgo-sgs-kicker">— CERTIFIED BY SGS —</div>
          <h2 class="apgo-sgs-title apgo-serif">SGS National-Level Testing Certification</h2>
          <div class="apgo-sgs-meta">Commissioned by: Guangshidai Technology Co., Ltd.</div>
          <div class="apgo-sgs-meta">Five complete SGS test reports in total</div>
        </div>

        <div class="apgo-sgs-defs">
          <div class="apgo-sgs-def">
            <div class="apgo-sgs-def-head">
              <span class="apgo-display apgo-sgs-def-abbr">N.D.</span>
              <span class="apgo-sgs-def-name">Not Detected</span>
            </div>
            <p class="apgo-sgs-def-body">Concentration below the instrument's accurate quantification limit, treated as "not present".</p>
          </div>
          <div class="apgo-sgs-def">
            <div class="apgo-sgs-def-head">
              <span class="apgo-display apgo-sgs-def-abbr">LOQ</span>
              <span class="apgo-sgs-def-name">Limit of Quantification</span>
            </div>
            <p class="apgo-sgs-def-body">The lowest concentration the instrument can accurately quantify. SGS's LOQ is typically 10–100 times stricter than regulations.</p>
          </div>
        </div>

        <div class="apgo-sgs-cta-line">Tap to see why we test</div>

        <div class="apgo-sgs-cards">
          {%- for r in sgs_reports -%}
            <article class="apgo-sgs-card" data-sgs-card>
              <div class="apgo-sgs-card-head">
                {%- if r.report_image != blank -%}
                  <a class="apgo-sgs-thumb" href="{{ r.report_image | image_url: width: 5760 }}" target="_blank" rel="noopener" aria-label="Open SGS report image">
                    <img src="{{ r.report_image | image_url: width: 240 }}" alt="SGS report {{ r.report_no }}" width="{{ r.report_image.width }}" height="{{ r.report_image.height }}" loading="lazy">
                    <span class="apgo-sgs-thumb-badge">VIEW</span>
                  </a>
                {%- else -%}
                  <div class="apgo-sgs-thumb apgo-sgs-thumb--static">
                  </div>
                {%- endif -%}

                <button type="button" class="apgo-sgs-card-meta" data-sgs-toggle aria-expanded="false">
                  <div class="apgo-sgs-card-no">
                    <span>{{ r.report_no }}</span>
                    {%- if r.report_date != blank -%}
                      <span class="apgo-sgs-card-sep" aria-hidden="true">·</span>
                      <span class="apgo-sgs-card-date">{{ r.report_date }}</span>
                    {%- endif -%}
                  </div>
                  <div class="apgo-sgs-card-test apgo-serif">{{ r.test_name }}</div>
                  <div class="apgo-sgs-card-result-row">
                    <div class="apgo-sgs-card-result apgo-display">{{ r.test_result }}</div>
                    <div class="apgo-sgs-card-why">
                      <span>WHY</span>
                      <span class="apgo-sgs-card-arrow">↓</span>
                    </div>
                  </div>
                </button>
              </div>

              <div class="apgo-sgs-card-body" hidden>
                {%- if r.what_is_it != blank -%}
                  <div class="apgo-sgs-card-row">
                    <div class="apgo-sgs-card-row-label apgo-display">WHAT IS IT</div>
                    <div class="apgo-sgs-card-row-text">{% render 'apgo-richtext', content: r.what_is_it %}</div>
                  </div>
                {%- endif -%}
                {%- if r.impact != blank -%}
                  <div class="apgo-sgs-card-row">
                    <div class="apgo-sgs-card-row-label apgo-display">IMPACT · Effect on the body</div>
                    <div class="apgo-sgs-card-row-text">{% render 'apgo-richtext', content: r.impact %}</div>
                  </div>
                {%- endif -%}
                {%- if r.why_we_test != blank -%}
                  <div class="apgo-sgs-card-row">
                    <div class="apgo-sgs-card-row-label apgo-display">WHY WE TEST</div>
                    <div class="apgo-sgs-card-row-text">{% render 'apgo-richtext', content: r.why_we_test %}</div>
                  </div>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>

        <div class="apgo-sgs-overview">
          <h3 class="apgo-sgs-overview-title apgo-serif">Test Results Overview</h3>
          <p class="apgo-sgs-overview-sub">All harmful substances N.D., pH 6.4 mildly acidic and skin-friendly</p>
          <div class="apgo-sgs-chips">
            <div class="apgo-sgs-chip"><span class="apgo-sgs-chip-val apgo-display">N.D.</span><span class="apgo-sgs-chip-label">Nonylphenol</span></div>
            <div class="apgo-sgs-chip"><span class="apgo-sgs-chip-val apgo-display">N.D.</span><span class="apgo-sgs-chip-label">Formaldehyde</span></div>
            <div class="apgo-sgs-chip"><span class="apgo-sgs-chip-val apgo-display">6.4</span><span class="apgo-sgs-chip-label">pH</span></div>
            <div class="apgo-sgs-chip"><span class="apgo-sgs-chip-val apgo-display">Negative</span><span class="apgo-sgs-chip-label">Fluorescent agent</span></div>
            <div class="apgo-sgs-chip"><span class="apgo-sgs-chip-val apgo-display">Negative</span><span class="apgo-sgs-chip-label">Coliform bacteria</span></div>
          </div>
        </div>
      </div>

      <script>
        (function () {
          var panel = document.querySelector('[data-apgo-mpanel="sgs"]');
          if (!panel || panel.dataset.sgsBound) return;
          panel.dataset.sgsBound = '1';
          panel.querySelectorAll('[data-sgs-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
              var card = btn.closest('[data-sgs-card]');
              if (!card) return;
              var body = card.querySelector('.apgo-sgs-card-body');
              if (!body) return;
              var open = card.classList.toggle('is-open');
              btn.setAttribute('aria-expanded', open ? 'true' : 'false');
              if (open) body.removeAttribute('hidden'); else body.setAttribute('hidden', '');
            });
          });
        })();
      </script>
      {%- endif -%}
    </div>

    {%- comment -%} Tab panel: specifications — prefer metafield, fallback to blocks {%- endcomment -%}
    {%- assign mf_spec_rows = product.metafields.apgo.spec_rows.value -%}
    <div class="apgo-mpdp-panel" id="apgo-mpanel-spec-{{ section.id }}" data-apgo-mpanel="spec" role="tabpanel" aria-labelledby="apgo-mtab-spec-{{ section.id }}">
      {%- if mf_spec_rows != blank and mf_spec_rows.size > 0 -%}
        {%- for entry in mf_spec_rows -%}
          <div class="apgo-mpdp-spec-row">
            <div class="apgo-muted">{{ entry.key }}</div>
            <div class="apgo-serif">{{ entry.value }}</div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'spec' -%}
            <div class="apgo-mpdp-spec-row" {{ block.shopify_attributes }}>
              <div class="apgo-muted">{{ block.settings.key }}</div>
              <div class="apgo-serif">{{ block.settings.value }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} Tab panel: reviews — prefer metafield, fallback to blocks {%- endcomment -%}
    {%- assign mf_reviews = product.metafields.apgo.reviews.value -%}
    <div class="apgo-mpdp-panel" id="apgo-mpanel-review-{{ section.id }}" data-apgo-mpanel="review" role="tabpanel" aria-labelledby="apgo-mtab-review-{{ section.id }}">
      <div class="apgo-mpdp-rev-summary">
        <div class="apgo-serif apgo-mpdp-rev-score">{{ section.settings.rating_score }}</div>
        <div class="apgo-stars">★★★★★</div>
        <div class="apgo-muted">Based on {{ section.settings.rating_count }} genuine reviews</div>
      </div>
      {%- if mf_reviews != blank and mf_reviews.size > 0 -%}
        {%- for entry in mf_reviews -%}
          <div class="apgo-mpdp-rev-item">
            <div class="apgo-mpdp-rev-head">
              <strong>{{ entry.name }}</strong>
              <span class="apgo-stars">★★★★★</span>
            </div>
            {%- assign rev_date = entry.date | default: entry.data -%}
            <div class="apgo-mpdp-rev-meta">{{ rev_date }} · Purchased:{{ entry.scent }}</div>
            <p>{{ entry.body }}</p>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'review' -%}
            <div class="apgo-mpdp-rev-item" {{ block.shopify_attributes }}>
              <div class="apgo-mpdp-rev-head">
                <strong>{{ block.settings.name }}</strong>
                <span class="apgo-stars">★★★★★</span>
              </div>
              <div class="apgo-mpdp-rev-meta">{{ block.settings.date }} · Purchased:{{ block.settings.scent }}</div>
              <p>{{ block.settings.body }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} Tab panel: FAQ — prefer metafield, fallback to blocks {%- endcomment -%}
    {%- assign mf_faqs = product.metafields.apgo.faqs.value -%}
    <div class="apgo-mpdp-panel" id="apgo-mpanel-faq-{{ section.id }}" data-apgo-mpanel="faq" role="tabpanel" aria-labelledby="apgo-mtab-faq-{{ section.id }}">
      {%- if mf_faqs != blank and mf_faqs.size > 0 -%}
        {%- for entry in mf_faqs -%}
          <details class="apgo-mpdp-faq">
            <summary>
              <span class="apgo-serif">Q. {{ entry.question }}</span>
              <span class="apgo-mpdp-faq-toggle">+</span>
            </summary>
            <p>A. {{ entry.answer }}</p>
          </details>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <details class="apgo-mpdp-faq" {{ block.shopify_attributes }}>
              <summary>
                <span class="apgo-serif">Q. {{ block.settings.q }}</span>
                <span class="apgo-mpdp-faq-toggle">+</span>
              </summary>
              <p>A. {{ block.settings.a }}</p>
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- comment -%} Related products (horizontal scroll) {%- endcomment -%}
    {%- if section.settings.related_collection != blank -%}
      {%- assign rcol = collections[section.settings.related_collection] -%}
      {%- if rcol and rcol.products.size > 0 -%}
        <div class="apgo-mpdp-related">
          <h3 class="apgo-serif">You may also like</h3>
          <div class="apgo-mpdp-related-scroll">
            {%- for p in rcol.products limit: 8 -%}
              {%- unless p.id == product.id -%}
                <a class="apgo-mpdp-related-item" href="{{ p.url }}">
                  <img src="{{ p.featured_image | image_url: width: 280 }}" alt="{{ p.title }}" width="{{ p.featured_image.width }}" height="{{ p.featured_image.height }}" loading="lazy">
                  <div class="apgo-serif">{{ p.title }}</div>
                  <div>{{ p.price | money }}</div>
                </a>
              {%- endunless -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Sticky bottom CTA bar — two render paths {%- endcomment -%}
    {%- if product.metafields.apgo.bundle_enabled -%}
      {%- comment -%}
        Bundle mode: disabled state initially shown as a single full-width
        button. Phase B JS will swap to the enabled (add + buy) state once
        the scent counter is filled.
      {%- endcomment -%}
      <div class="apgo-mpdp-sticky apgo-mpdp-sticky--bundle">
        <button type="button"
                class="apgo-mpdp-cta-bundle-disabled"
                data-apgo-bundle-cta-disabled
                disabled>
          Please select all scents · <span data-apgo-bundle-remaining>3</span> more to go
        </button>
        <div class="apgo-mpdp-cta-bundle-enabled"
             data-apgo-bundle-cta-enabled
             style="display:none;">
          <button type="button" class="apgo-mpdp-cta-secondary" data-apgo-bundle-add>Add to cart</button>
          <button type="button" class="apgo-mpdp-cta-primary" data-apgo-bundle-buy-now>
            Buy now <span data-apgo-bundle-total>{{ 0 | money }}</span>
          </button>
        </div>
      </div>
    {%- else -%}
      <div class="apgo-mpdp-sticky">
        <button type="submit" name="add" class="apgo-mpdp-cta-secondary" data-apgo-add {% unless v.available %}disabled{% endunless %}>
          {% if v.available %}Add to cart{% else %}Restocking{% endif %}
        </button>
        <button type="button" class="apgo-mpdp-cta-primary" data-apgo-buy-now {% unless v.available %}disabled{% endunless %}>
          Buy now <span data-apgo-total>{{ v.price | money }}</span>
        </button>
      </div>
    {%- endif -%}

    <script type="application/json" data-apgo-variants>{{ product.variants | json }}</script>
  {% endform %}

  {%- comment -%}
    Mobile confirm sheet — opened by the sticky Add/Buy on ≤1023px (JS
    viewport gate; desktop commits directly). Cream bottom sheet: product
    thumb + title + price + qty stepper + one action (Add or Buy, filtered
    by data-intent). Single-variant products → no variant chips. Not
    rendered in bundle mode (that flow has its own CTAs).
  {%- endcomment -%}
  {%- unless product.metafields.apgo.bundle_enabled -%}
    <div class="apgo-mpdp-confirm" data-apgo-confirm data-intent="add" role="dialog" aria-modal="true" aria-label="Confirm your order" aria-hidden="true" hidden>
      <div class="apgo-mpdp-confirm__backdrop" data-apgo-confirm-close></div>
      <div class="apgo-mpdp-confirm__sheet" role="document">
        <button type="button" class="apgo-mpdp-confirm__close" data-apgo-confirm-close aria-label="Close">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>

        <div class="apgo-mpdp-confirm__summary">
          {%- if product.featured_media -%}
            <div class="apgo-mpdp-confirm__thumb">
              <img src="{{ product.featured_media | image_url: width: 200 }}" alt="{{ product.title | escape }}" width="72" height="72" loading="lazy">
            </div>
          {%- endif -%}
          <div class="apgo-mpdp-confirm__meta">
            <p class="apgo-mpdp-confirm__title">{{ product.title }}</p>
            <p class="apgo-mpdp-confirm__price" data-apgo-price>{{ v.price | money }}</p>
          </div>
        </div>

        <div class="apgo-mpdp-confirm__qtyrow">
          <span class="apgo-mpdp-confirm__qtylabel">Quantity</span>
          <div class="apgo-mpdp-confirm__stepper">
            <button type="button" data-apgo-confirm-qty="down" aria-label="Decrease quantity">&minus;</button>
            <input type="text" inputmode="numeric" pattern="[0-9]*" value="1" data-apgo-confirm-qty-input aria-label="Quantity">
            <button type="button" data-apgo-confirm-qty="up" aria-label="Increase quantity">+</button>
          </div>
        </div>

        <div class="apgo-mpdp-confirm__actions">
          <button type="button" class="apgo-mpdp-confirm__add" data-apgo-confirm-add>Add to cart</button>
          <button type="button" class="apgo-mpdp-confirm__buy" data-apgo-confirm-buy>Buy now</button>
        </div>
      </div>
    </div>
  {%- endunless -%}
</section>

