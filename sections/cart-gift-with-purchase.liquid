{% comment %}
  Gift with Purchase — cart page upsell when trigger product X is in cart.
  Display prices are configured per block; checkout discount = Shopify Admin Buy X Get Y.
{% endcomment %}

<style>
  .shopify-section.section-cart-gwp,
  [class*="shopify-section"][class*="cart_gift"] {
    background: transparent !important;
  }

  .cart-gwp-wrapper {
    --apgo-gwp-accent: {{ section.settings.accent_color_start | default: '#f08418' }};
    --apgo-gwp-deal-red: #FF0036;
    --apgo-gwp-grad: linear-gradient(135deg, #ff6b35 0%, #f7931e 55%, #ff9a3c 100%);
    width: 100%;
    max-width: 1240px;
    margin: 20px auto 0;
    padding: 0 20px;
    font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif;
  }

  .cart-gwp-header {
    margin-bottom: 12px;
    padding: 0 4px;
  }

  .cart-gwp-title {
    font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif !important;
    font-size: 18px;
    font-weight: 600;
    color: {{ section.settings.text_color }} !important;
    margin: 0;
    padding-left: 12px;
    position: relative;
  }

  .cart-gwp-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 20px;
    background: var(--apgo-gwp-accent);
    border-radius: 2px;
  }

  .cart-gwp-wrapper.is-unlocked .cart-gwp-triggers {
    display: none;
  }

  .cart-gwp-wrapper.is-celebrating .cart-gwp-triggers {
    display: block;
    position: relative;
    margin-bottom: 16px;
  }

  .cart-gwp-wrapper.is-celebrating .cart-gwp-triggers .cart-gwp-grid {
    opacity: 0.25;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .cart-gwp-unlocked-toast {
    display: none;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 700;
    color: var(--apgo-gwp-accent);
    text-shadow: 0 0 20px rgba(240, 132, 24, 0.45);
    z-index: 2;
    pointer-events: none;
  }

  .cart-gwp-wrapper.is-celebrating .cart-gwp-unlocked-toast {
    display: flex;
    animation: gwpToastIn 0.35s ease;
  }

  @keyframes gwpToastIn {
    from { opacity: 0; transform: scale(0.92); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes gwpPricePop {
    0% { transform: scale(1); filter: brightness(1); }
    45% { transform: scale(1.1); filter: brightness(1.35); }
    100% { transform: scale(1); filter: brightness(1); }
  }

  .cart-gwp-triggers {
    margin-bottom: 16px;
  }

  .cart-gwp-triggers__label {
    margin: 0 4px 10px;
    font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif !important;
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.4;
  }

  .cart-gwp-triggers .cart-gwp-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: visible;
    padding: 0;
  }

  .cart-gwp-gifts__label {
    margin: 0 4px 8px;
    font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif !important;
    font-size: 12px;
    font-weight: 600;
    color: #ffffff !important;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .cart-gwp-gifts .cart-gwp-grid {
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: visible;
    padding: 0;
  }

  .cart-gwp-section {
    padding: 0;
  }

  .cart-gwp-grid {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 12px 0;
    scrollbar-width: thin;
    scrollbar-color: #f08418 #000;
  }

  .cart-gwp-card {
    flex: 0 0 320px;
    background: #000 !important;
    border: 1px solid #404040 !important;
    border-radius: 10px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow: hidden;
  }

  .cart-gwp-card__link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
  }

  .cart-gwp-card__image {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    position: relative;
  }

  .cart-gwp-card__image.portrait { aspect-ratio: 4 / 5; }
  .cart-gwp-card__image.landscape { aspect-ratio: 4 / 3; }

  .cart-gwp-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cart-gwp-card__info {
    padding: 8px 8px 6px;
  }

  .cart-gwp-card__title {
    font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif !important;
    font-size: 11px;
    font-weight: 500;
    color: {{ section.settings.text_color }} !important;
    margin: 0 0 6px;
    line-height: 1.35;
    min-height: calc(2 * 1.35em);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cart-gwp-card__prices {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cart-gwp-card--trigger .cart-gwp-card__price-regular {
    font-size: 14px;
    font-weight: 700;
    color: var(--apgo-gwp-accent);
    text-decoration: none;
  }

  .cart-gwp-gifts .cart-gwp-card__price-deal {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px;
  }

  .cart-gwp-gifts .cart-gwp-card__price-regular {
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.45);
    text-decoration: line-through;
  }

  .cart-gwp-gifts .cart-gwp-card__price-arrow {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.35);
    line-height: 1;
  }

  .cart-gwp-gifts .cart-gwp-card__price-unlocked {
    display: inline-flex;
    align-items: center;
    font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif !important;
    font-size: 15px;
    font-weight: 700;
    color: var(--apgo-gwp-deal-red);
    transition: color 0.35s ease, transform 0.35s ease, filter 0.35s ease;
  }

  .cart-gwp-gifts .cart-gwp-card__image {
    position: relative;
  }

  .cart-gwp-card__badge {
    position: absolute;
    top: 6px;
    left: 6px;
    padding: 2px 6px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #fff;
    background: rgba(0, 0, 0, 0.72);
    border: 1px solid rgba(240, 132, 24, 0.55);
    border-radius: 4px;
    z-index: 1;
  }

  .cart-gwp-wrapper.is-unlocked .cart-gwp-card__badge {
    display: none;
  }

  .cart-gwp-wrapper.is-unlocked .cart-gwp-gifts .cart-gwp-card__price-regular {
    font-size: 11px;
  }

  .cart-gwp-wrapper.is-unlocked .cart-gwp-gifts .cart-gwp-card__price-unlocked {
    font-size: 16px;
  }

  .cart-gwp-wrapper.is-unlocking .cart-gwp-gifts .cart-gwp-card__price-unlocked {
    animation: gwpPricePop 0.65s ease;
  }

  .cart-gwp-card__price-regular {
    font-size: 14px;
    font-weight: 700;
    color: var(--apgo-gwp-accent);
  }

  .cart-gwp-card__price-unlocked {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.45);
  }

  .cart-gwp-card__lock {
    flex-shrink: 0;
    color: rgba(255, 255, 255, 0.5);
  }

  .cart-gwp-wrapper.is-unlocked .cart-gwp-card__price-regular {
    font-size: 12px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.45);
    text-decoration: line-through;
  }

  .cart-gwp-add {
    width: calc(100% - 16px);
    height: 32px;
    margin: 4px 8px 8px;
    align-self: center;
    border: none;
    border-radius: 6px;
    background: var(--apgo-gwp-grad) !important;
    color: #fff !important;
    font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif !important;
    font-size: 18px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 2px 10px rgba(255, 107, 53, 0.35);
  }

  .cart-gwp-add.loading { opacity: 0.7; pointer-events: none; }
  .cart-gwp-add.added { opacity: 1; }

  /* Trigger (X) + gift (Y) rows — horizontal, one per row */
  .cart-gwp-card.cart-gwp-card--trigger,
  .cart-gwp-gifts .cart-gwp-card {
    flex: none;
    width: 100%;
    flex-direction: row;
    align-items: center;
  }

  .cart-gwp-card.cart-gwp-card--trigger .cart-gwp-card__link,
  .cart-gwp-gifts .cart-gwp-card .cart-gwp-card__link {
    flex: 1;
    flex-direction: row;
    align-items: center;
    min-width: 0;
  }

  .cart-gwp-card.cart-gwp-card--trigger .cart-gwp-card__image,
  .cart-gwp-gifts .cart-gwp-card .cart-gwp-card__image {
    width: 88px;
    min-width: 88px;
    aspect-ratio: 1;
    flex-shrink: 0;
  }

  .cart-gwp-card.cart-gwp-card--trigger .cart-gwp-card__info,
  .cart-gwp-gifts .cart-gwp-card .cart-gwp-card__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 10px 12px;
  }

  .cart-gwp-card.cart-gwp-card--trigger .cart-gwp-card__title,
  .cart-gwp-gifts .cart-gwp-card .cart-gwp-card__title {
    font-size: 12px;
    -webkit-line-clamp: 2;
  }

  .cart-gwp-card.cart-gwp-card--trigger .cart-gwp-add,
  .cart-gwp-gifts .cart-gwp-card .cart-gwp-add {
    width: 44px;
    min-width: 44px;
    height: 44px;
    margin: 0 10px 0 0;
    align-self: center;
    flex-shrink: 0;
  }

  .cart-gwp-editor-note {
    padding: 16px;
    font-size: 13px;
    color: #888;
    text-align: center;
    border: 1px dashed #404040;
    border-radius: 8px;
  }

  @media (max-width: 768px) {
    .cart-gwp-wrapper { padding: 0 16px; }
  }
</style>

{% liquid
  assign is_my_market = false
  if localization.country.iso_code == 'MY'
    assign is_my_market = true
  endif

  assign trigger_products = section.settings.trigger_product_list
  assign trigger_in_cart = false
  if trigger_products != blank
    for trigger in trigger_products
      for item in cart.items
        if item.product_id == trigger.id
          assign trigger_in_cart = true
          break
        endif
      endfor
      if trigger_in_cart
        break
      endif
    endfor
  endif

  assign img_width = 400
  case section.settings.image_ratio
    when 'portrait'
      assign img_height = 500
    when 'landscape'
      assign img_height = 300
    else
      assign img_height = 400
  endcase
%}

<div class="cart-gwp-wrapper{% if trigger_in_cart %} is-unlocked{% endif %}"
     id="cart-gwp-{{ section.id }}"
     data-section-id="{{ section.id }}"
     data-trigger-product-ids="{% for trigger in trigger_products %}{{ trigger.id }}{% unless forloop.last %},{% endunless %}{% endfor %}">

  <div class="cart-gwp-header">
    <h3 class="cart-gwp-title">{{ section.settings.section_title }}</h3>
  </div>

  {% if trigger_products != blank %}
    <div class="cart-gwp-triggers" data-gwp-triggers>
      <p class="cart-gwp-triggers__label">{{ 'apgo_cart.gwp_trigger_label' | t }}</p>
      <div class="cart-gwp-unlocked-toast" data-gwp-toast aria-live="polite">{{ 'apgo_cart.gwp_unlocked_toast' | t }}</div>
      <div class="cart-gwp-grid">
        {% for trigger in trigger_products %}
          {% assign trigger_price = trigger.price | money %}
          {% if is_my_market %}
            {% assign trigger_price = trigger_price | replace: ' MYR', '' | replace: 'MYR', '' | strip %}
          {% endif %}

          <div class="cart-gwp-card cart-gwp-card--trigger">
            <a href="{{ trigger.url }}" class="cart-gwp-card__link">
              <div class="cart-gwp-card__image {{ section.settings.image_ratio }}">
                {% if trigger.featured_image %}
                  <img src="{{ trigger.featured_image | image_url: width: img_width }}"
                       alt="{{ trigger.title | escape }}"
                       width="{{ img_width }}"
                       height="{{ img_height }}"
                       loading="lazy">
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>
              <div class="cart-gwp-card__info">
                <h4 class="cart-gwp-card__title">{{ trigger.title }}</h4>
                {% if section.settings.show_prices %}
                  <div class="cart-gwp-card__prices">
                    <span class="cart-gwp-card__price-regular">{{ trigger_price }}</span>
                  </div>
                {% endif %}
              </div>
            </a>
            {% if section.settings.enable_quick_add %}
              <button type="button"
                      class="cart-gwp-add"
                      data-variant-id="{{ trigger.selected_or_first_available_variant.id }}"
                      data-gwp-add
                      data-gwp-trigger-add>
                <span>+</span>
              </button>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <div class="cart-gwp-section cart-gwp-gifts">
    {% if trigger_products != blank %}
      <p class="cart-gwp-gifts__label">{{ 'apgo_cart.gwp_gifts_label' | t }}</p>
    {% endif %}
    <div class="cart-gwp-grid">
      {% assign gift_count = 0 %}
      {% for block in section.blocks %}
        {% if gift_count >= section.settings.max_products %}
          {% break %}
        {% endif %}
        {% assign gift_product = block.settings.product %}
        {% if gift_product == blank %}
          {% continue %}
        {% endif %}
        {% assign gift_count = gift_count | plus: 1 %}

        {% assign gift_variant = gift_product.selected_or_first_available_variant %}
        {% assign original_cents = gift_variant.compare_at_price %}
        {% if original_cents == blank or original_cents == 0 %}
          {% assign original_cents = gift_product.compare_at_price %}
        {% endif %}
        {% if original_cents == blank or original_cents == 0 or original_cents <= gift_variant.price %}
          {% assign original_cents = gift_variant.price %}
        {% endif %}
        {% assign original_price = original_cents | money %}
        {% if is_my_market %}
          {% assign original_price = original_price | replace: ' MYR', '' | replace: 'MYR', '' | strip %}
        {% endif %}

        {% assign unlocked_label = block.settings.unlocked_price_label | default: 'FREE' %}

        <div class="cart-gwp-card" {{ block.shopify_attributes }}>
          <a href="{{ gift_product.url }}" class="cart-gwp-card__link">
            <div class="cart-gwp-card__image {{ section.settings.image_ratio }}">
              {% if gift_product.featured_image %}
                <img src="{{ gift_product.featured_image | image_url: width: img_width }}"
                     alt="{{ gift_product.title | escape }}"
                     width="{{ img_width }}"
                     height="{{ img_height }}"
                     loading="lazy">
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
              <span class="cart-gwp-card__badge">{{ 'apgo_cart.gwp_locked_badge' | t }}</span>
            </div>
            <div class="cart-gwp-card__info">
              <h4 class="cart-gwp-card__title">{{ gift_product.title }}</h4>
              {% if section.settings.show_prices %}
                <div class="cart-gwp-card__prices">
                  <div class="cart-gwp-card__price-deal">
                    <span class="cart-gwp-card__price-regular">{{ original_price }}</span>
                    <span class="cart-gwp-card__price-arrow" aria-hidden="true">→</span>
                    <span class="cart-gwp-card__price-unlocked">{{ unlocked_label }}</span>
                  </div>
                </div>
              {% endif %}
            </div>
          </a>
          {% if section.settings.enable_quick_add %}
            <button type="button"
                    class="cart-gwp-add"
                    data-variant-id="{{ gift_product.selected_or_first_available_variant.id }}"
                    data-gwp-add>
              <span>+</span>
            </button>
          {% endif %}
        </div>
      {% endfor %}

      {% if gift_count == 0 and request.design_mode %}
        <div class="cart-gwp-editor-note">
          {{ 'apgo_cart.gwp_editor_empty' | t }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
(function () {
  var root = document.getElementById('cart-gwp-{{ section.id }}');
  if (!root) return;

  var triggerIds = (root.getAttribute('data-trigger-product-ids') || '')
    .split(',')
    .map(function (id) { return parseInt(id.trim(), 10); })
    .filter(function (id) { return !isNaN(id); });

  function cartHasTrigger(cart) {
    if (!triggerIds.length || !cart || !cart.items) return false;
    return cart.items.some(function (item) {
      return triggerIds.indexOf(Number(item.product_id)) !== -1;
    });
  }

  function setUnlocked(unlocked, options) {
    options = options || {};
    var wasUnlocked = root.classList.contains('is-unlocked');

    if (unlocked && !wasUnlocked && options.animate) {
      root.classList.add('is-celebrating', 'is-unlocking');
      window.setTimeout(function () {
        root.classList.add('is-unlocked');
        root.classList.remove('is-celebrating');
      }, 650);
      window.setTimeout(function () {
        root.classList.remove('is-unlocking');
      }, 1100);
      return;
    }

    root.classList.toggle('is-unlocked', unlocked);
    if (!unlocked) {
      root.classList.remove('is-celebrating', 'is-unlocking');
    }
  }

  function syncFromCart(cart, animate) {
    if (!triggerIds.length) return;
    setUnlocked(cartHasTrigger(cart), { animate: !!animate });
  }

  function cartFromEvent(ev) {
    if (!ev || !ev.detail) return null;
    return ev.detail.resource
      || (ev.detail.data && ev.detail.data.cart)
      || ev.detail.cart
      || null;
  }

  function getCartSectionIds() {
    var ids = [];
    document.querySelectorAll('cart-items-component[data-section-id]').forEach(function (el) {
      if (el.dataset.sectionId) ids.push(el.dataset.sectionId);
    });
    return ids;
  }

  function dispatchCartUpdate(cart, sections) {
    document.dispatchEvent(new CustomEvent('cart:update', {
      bubbles: true,
      detail: {
        resource: cart,
        sourceId: 'gwp-block-{{ section.id }}',
        data: {
          itemCount: cart.item_count,
          source: 'gwp-block',
          sections: sections || {}
        }
      }
    }));
  }

  root.querySelectorAll('[data-gwp-add]').forEach(function (btn) {
    btn.addEventListener('click', function (ev) {
      ev.preventDefault();
      ev.stopPropagation();

      var variantId = btn.getAttribute('data-variant-id');
      if (!variantId) return;

      btn.classList.add('loading');
      btn.innerHTML = '<span>...</span>';

      var sectionIds = getCartSectionIds();
      var payload = { items: [{ id: parseInt(variantId, 10), quantity: 1 }] };
      if (sectionIds.length) {
        payload.sections = sectionIds.join(',');
        payload.sections_url = window.location.pathname;
      }

      fetch(window.Shopify.routes.root + 'cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload)
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.status) throw new Error(data.description || data.message || 'Add failed');
          btn.classList.remove('loading');
          btn.classList.add('added');
          btn.innerHTML = '<span>✓</span>';
          return fetch('/cart.js', { credentials: 'same-origin', cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (cart) {
              var isTriggerAdd = btn.hasAttribute('data-gwp-trigger-add');
              syncFromCart(cart, isTriggerAdd && cartHasTrigger(cart));
              dispatchCartUpdate(cart, data.sections);
            });
        })
        .then(function () {
          setTimeout(function () {
            btn.classList.remove('added');
            btn.innerHTML = '<span>+</span>';
          }, 3000);
        })
        .catch(function (err) {
          console.error('[cart-gwp] add failed:', err);
          btn.classList.remove('loading');
          btn.innerHTML = '<span>✗</span>';
          setTimeout(function () { btn.innerHTML = '<span>+</span>'; }, 2000);
        });
    });
  });

  function handleCartSignal(ev) {
    var cart = cartFromEvent(ev);
    if (cart && cart.items) {
      syncFromCart(cart);
      return;
    }
    fetch('/cart.js', { credentials: 'same-origin', cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(syncFromCart)
      .catch(function () {});
  }

  ['cart:update', 'cart:updated', 'cart:refresh'].forEach(function (ev) {
    document.addEventListener(ev, handleCartSignal);
  });

  if (triggerIds.length) {
    fetch('/cart.js', { credentials: 'same-origin', cache: 'no-store' })
      .then(function (r) { return r.json(); })
      .then(syncFromCart)
      .catch(function () {});
  }
})();
</script>

{% schema %}
{
  "name": "Gift with Purchase",
  "class": "section-cart-gwp",
  "tag": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Configure a matching Buy X Get Y automatic discount in Shopify Admin. Set each gift block's unlocked price label to match that discount (e.g. FREE, RM29.00). Do not use the same gift SKU in APGO auto-gift reconciler unless intended."
    },
    {
      "type": "header",
      "content": "基本設定"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "區塊標題",
      "default": "Gift with Purchase"
    },
    {
      "type": "product_list",
      "id": "trigger_product_list",
      "label": "觸發商品 (X)",
      "limit": 12,
      "info": "可選多個商品，一列一個展示；購物車含任一 X 即解鎖下方贈品價"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "最多顯示商品數",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "顏色設定"
    },
    {
      "type": "color",
      "id": "accent_color_start",
      "label": "強調色",
      "default": "#f08418"
    },
    {
