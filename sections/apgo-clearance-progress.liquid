{%- comment -%}
  Clearance page — "Where it's all going": taped polaroids of the new
  factory next to a moving checklist. Photos without an image and
  milestones without a title are skipped; with neither, the section
  renders nothing on the storefront (the theme editor shows a hint).
  Styled in assets/apgo-clearance-page.css, which only the
  page.clearance-sale template loads.
{%- endcomment -%}

{%- liquid
  assign apgo_photo_count = 0
  assign apgo_step_count = 0
  for block in section.blocks
    if block.type == 'photo' and block.settings.image != blank
      assign apgo_photo_count = apgo_photo_count | plus: 1
    elsif block.type == 'milestone' and block.settings.title != blank
      assign apgo_step_count = apgo_step_count | plus: 1
    endif
  endfor

  assign apgo_progress_show = false
  if apgo_photo_count > 0 or apgo_step_count > 0 or request.design_mode
    assign apgo_progress_show = true
  endif
-%}

{%- if apgo_progress_show -%}
  <div class="apgo-crate-progress">
    <div class="apgo-crate-container apgo-crate-progress__inner">
      {% render 'apgo-clearance-label',
        title: section.settings.heading,
        note: section.settings.note,
        lot: section.settings.code,
        barcode: false,
        modifier: 'tilt-right'
      %}

      <div class="apgo-crate-progress__body{% if apgo_photo_count == 0 or apgo_step_count == 0 %} apgo-crate-progress__body--single{% endif %}">
        {%- if apgo_photo_count > 0 -%}
          <div class="apgo-crate-progress__photos">
            {%- for block in section.blocks -%}
              {%- if block.type == 'photo' and block.settings.image != blank -%}
                {%- assign apgo_photo_alt = block.settings.caption | default: block.settings.image.alt -%}
                <figure class="apgo-crate-polaroid" {{ block.shopify_attributes }}>
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      class: 'apgo-crate-polaroid__img',
                      loading: 'lazy',
                      widths: '240, 360, 480, 640, 800',
                      sizes: '(min-width: 990px) 260px, 45vw',
                      alt: apgo_photo_alt
                  }}
                  {%- if block.settings.caption != blank -%}
                    <figcaption class="apgo-crate-polaroid__caption">{{ block.settings.caption | escape }}</figcaption>
                  {%- endif -%}
                </figure>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- elsif request.design_mode -%}
          <div class="apgo-crate-placeholder">Add Photo blocks to show the new factory.</div>
        {%- endif -%}

        {%- if apgo_step_count > 0 -%}
          <div class="apgo-crate-checklist">
            {%- if section.settings.checklist_title != blank -%}
              <p class="apgo-crate-checklist__title">{{ section.settings.checklist_title | escape }}</p>
            {%- endif -%}
            <ol class="apgo-crate-checklist__list" role="list">
              {%- for block in section.blocks -%}
                {%- if block.type == 'milestone' and block.settings.title != blank -%}
                  {%- liquid
                    assign apgo_step_note = block.settings.note | strip
                    if apgo_step_note == blank
                      case block.settings.status
                        when 'done'
                          assign apgo_step_note = 'Done'
                        when 'in_progress'
                          assign apgo_step_note = 'In progress'
                      endcase
                    endif
                  -%}
                  <li class="apgo-crate-checklist__item apgo-crate-checklist__item--{{ block.settings.status }}" {{ block.shopify_attributes }}>
                    <span class="apgo-crate-checklist__box" aria-hidden="true">
                      {%- if block.settings.status == 'done' -%}
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12l5 5 9-10"/></svg>
                      {%- endif -%}
                    </span>
                    <span class="apgo-crate-checklist__text">{{ block.settings.title | escape }}</span>
                    {%- if apgo_step_note != blank -%}
                      <span class="apgo-crate-checklist__note">{{ apgo_step_note | escape }}</span>
                    {%- endif -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ol>
          </div>
        {%- elsif request.design_mode -%}
          <div class="apgo-crate-placeholder">Add Milestone blocks for the moving checklist.</div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Clearance progress",
  "tag": "section",
  "class": "apgo-crate-section",
  "max_blocks": 14,
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where it's all going"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Printed note on the label",
      "default": "Destination: new factory"
    },
    {
      "type": "text",
      "id": "code",
      "label": "Red code on the label",
      "default": "Update"
    },
    {
      "type": "text",
      "id": "checklist_title",
      "label": "Checklist title",
      "default": "Moving checklist"
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    },
    {
      "type": "milestone",
      "name": "Milestone",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Milestone"
        },
        {
          "type": "select",
          "id": "status",
          "label": "Status",
          "options": [
            { "value": "done", "label": "Done" },
            { "value": "in_progress", "label": "In progress" },
            { "value": "upcoming", "label": "Upcoming" }
          ],
          "default": "upcoming"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note on the right (optional)",
          "info": "Replaces the automatic \"Done\" / \"In progress\" text, e.g. a move-in date."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Clearance progress",
      "category": "APGO"
    }
  ]
}
{% endschema %}
