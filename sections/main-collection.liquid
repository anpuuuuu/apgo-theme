

{% liquid
  # Onboarding: When no products are available, we show placeholder items
  assign products = ''
  if request.design_mode and shop.products_count == 0
    for i in (1..16)
      assign products = products | append: ' ,'
    endfor
    assign products = products | split: ','
  endif

  # All 整合目錄：僅在 handle 為 all 且開關開啟時，改用手動 handle 清單 + collections[handle] 分段
  assign use_all_catalog_hub = false
  if collection.handle == 'all' and section.settings.enable_all_catalog_hub_layout
    assign use_all_catalog_hub = true
  endif

  assign apgo_hub_handles_raw = section.settings.all_catalog_hub_handles | strip
  if apgo_hub_handles_raw == blank
    assign apgo_hub_handles_raw = 'atomic-coating-series,car-interior,cleaning-supplies,pre-wash-car-wash,restoration,others,household,2025-new-launch'
  endif
  assign apgo_hub_handles_raw = apgo_hub_handles_raw | newline_to_br | replace: '<br />', ',' | replace: '<br/>', ','
  assign apgo_catalog_handles = apgo_hub_handles_raw | replace: ' ,', ',' | replace: ', ', ',' | split: ','

  assign apgo_hub_section_limit = section.settings.all_catalog_hub_per_section_limit | default: 48
  if apgo_hub_section_limit > 50
    assign apgo_hub_section_limit = 50
  endif
%}

<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
></script>

{% javascript %}
  {% unless use_all_catalog_hub %}
    const url = new URL(window.location.href);
    if (url.hash) {
      document.addEventListener(
        'DOMContentLoaded',
        () => {
          const card = document.getElementById(url.hash.slice(1));
          if (card) {
            card.scrollIntoView({ behavior: 'instant' });
          }
        },
        { once: true }
      );
    }
  {% endunless %}
{% endjavascript %}

{% comment %} We always render this full-width, as the child blocks have width: page/full settings {% endcomment %}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
{% if use_all_catalog_hub %}
  <div
    class="section product-grid-container color-{{ section.settings.color_scheme }} main-collection-zgrid apgo-all-catalog-root"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div class="collection-wrapper gap-style collection-wrapper--all-catalog-hub">
      {% for handle_token in apgo_catalog_handles %}
        {% assign ch = handle_token | strip %}
        {% if ch == blank %}
          {% continue %}
        {% endif %}
        {% assign cat_coll = collections[ch] %}
        {% if cat_coll == blank or cat_coll.products_count == 0 %}
          {% continue %}
        {% endif %}

        <section
          class="apgo-catalog-hub-section spacing-style"
          data-apgo-catalog-handle="{{ ch }}"
          style="--padding-block-end: {{ section.settings.columns_gap_vertical }}px;"
        >
          <h2 class="apgo-catalog-heading h3" id="collection-{{ ch }}">{{ cat_coll.title }}</h2>

          {% assign catalog_chunk_is_first = forloop.first %}
          {% capture children %}
            {% for product in cat_coll.products limit: apgo_hub_section_limit %}
              <li
                id="{{ section.id }}-{{ product.id }}-{{ ch }}"
                class="product-grid__item product-grid__item--{{ forloop.index0 }}"
                data-page="1"
                data-product-id="{{ product.id }}"
                ref="cards[]"
              >
                {% content_for 'block', type: 'product-card', id: 'product-card', closest.product: product %}
              </li>
            {% endfor %}
          {% endcapture %}

          {% if catalog_chunk_is_first %}
            {% render 'product-grid',
              section: section,
              children: children,
              products: cat_coll.products
            %}
          {% else %}
            {% render 'product-grid',
              section: section,
              children: children,
              products: cat_coll.products,
              grid_wrapper_id: false,
              skip_session_script: true
            %}
          {% endif %}
        </section>
      {% endfor %}
    </div>
  </div>

  <script src="{{ 'collection-all-hub.js' | asset_url }}" type="module" defer></script>
{% else %}
  <results-list
    class="section product-grid-container color-{{ section.settings.color_scheme }} main-collection-zgrid"
    style="--padding-block-start: {{ section.settings.padding-block-start }}px; --padding-block-end: {{ section.settings.padding-block-end }}px;"
    section-id="{{ section.id }}"
  >
    {% render 'skip-to-content-link', href: '#ResultsList', text: 'accessibility.skip_to_results_list' %}

    <div
      class="collection-wrapper grid gap-style"
    >
      {% content_for 'block',
        type: 'filters',
        id: 'filters',
        results: collection,
        results_size: collection.products_count
      %}

      {% if request.design_mode and shop.products_count == 0 %}
        {% paginate products by 24 %}
          {% capture children %}
            {% for product in products %}
              <li
                class="product-grid__item product-grid__item--{{ forloop.index0 }}"
                data-page="{{ paginate.current_page }}"
                data-product-id="{{ product.id }}"
                data-view-transition-id="{{ product.id }}"
                ref="cards[]"
              >
                {% content_for 'block', type: 'product-card', id: 'product-card', closest.product: product %}
              </li>
            {% endfor %}
          {% endcapture %}
          {% render 'product-grid', section: section, children: children, products: products, paginate: paginate %}
        {% endpaginate %}
      {% else %}
        {% paginate collection.products by 24 %}
          {% capture children %}
            {% for product in collection.products %}
              <li
                id="{{ section.id }}-{{ product.id }}"
                class="product-grid__item product-grid__item--{{ forloop.index0 }}"
                data-page="{{ paginate.current_page }}"
                data-product-id="{{ product.id }}"
                ref="cards[]"
              >
                {% # theme-check-disable %}
                {% content_for 'block', type: 'product-card', id: 'product-card', closest.product: product %}
                {% # theme-check-enable %}
              </li>
            {% endfor %}
          {% endcapture %}
          {% render 'product-grid',
            section: section,
            children: children,
            products: collection.products,
            paginate: paginate
          %}
        {% endpaginate %}
      {% endif %}
    </div>
  </results-list>
{% endif %}

{% stylesheet %}
  .main-collection-grid {
    grid-column: var(--grid-column--mobile);
    @media screen and (width >= 750px) {
      grid-column: var(--grid-column--desktop);
    }
  }

  .collection-wrapper {
    @media screen and (width >= 750px) {
      grid-template-columns:
        1fr repeat(
          var(--centered-column-number),
          minmax(0, calc((var(--page-width) - var(--page-margin) * 2) / var(--centered-column-number)))
        )
        1fr;
    }
  }

  /* 桌機：集合頁 z-grid 商品區（.collection-wrapper）為內容欄寬的 2/3 並置中；不縮外層 .section 以免背景／全站網格跑版 */
  @media screen and (width >= 750px) {
    .main-collection-zgrid .collection-wrapper {
      box-sizing: border-box;
      width: 100%;
      max-width: calc(100% * 2 / 3);
      margin-inline: auto;
    }
  }

  .collection-wrapper:has(.facets-block-wrapper--full-width),
  .collection-wrapper:has(.collection-wrapper--full-width) {
    @media screen and (width >= 750px) {
      grid-column: 1 / -1;
      grid-template-columns:
        minmax(var(--page-margin), 1fr) repeat(
          var(--centered-column-number),
          minmax(0, calc((var(--page-width) - var(--page-margin) * 2) / var(--centered-column-number)))
        )
        minmax(var(--page-margin), 1fr);
    }
  }

  .collection-wrapper:has(.facets--vertical) .facets-block-wrapper--vertical:not(.hidden) ~ .main-collection-grid {
    @media screen and (width >= 750px) {
      grid-column: var(--facets-vertical-col-width) / var(--full-width-column-number);
    }
  }

  .collection-wrapper:has(.facets-block-wrapper--vertical:not(#filters-drawer)):has(.collection-wrapper--full-width) {
    @media screen and (width >= 750px) {
      grid-column: 1 / -1;
      grid-template-columns: 0fr repeat(var(--centered-column-number), minmax(0, 1fr)) 0fr;
    }
  }

  :is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile)
    [product-grid-view='default']
    .product-grid__item
    .group-block {
    @media screen and (width < 750px) {
      padding-inline-start: max(var(--padding-xs), var(--padding-inline-start));
      padding-inline-end: max(var(--padding-xs), var(--padding-inline-end));
    }
  }

  :is(.collection-wrapper--full-width, .collection-wrapper--full-width-on-mobile)
    [product-grid-view='mobile-single']
    .product-grid__item
    .group-block {
    @media screen and (width < 750px) {
      padding-inline-start: max(var(--padding-xs), var(--padding-inline-start));
      padding-inline-end: max(var(--padding-xs), var(--padding-inline-end));
    }
  }

  /*
    Collection Z-grid：深灰卡殼（手機／桌機共用）、圖片貼齊卡殼頂與兩側、上緣圓角與卡殼一致。
    collection 價格見 snippets/price.liquid。
  */
  .main-collection-zgrid {
    --mc-z-card-bg: #2e2e2e;
    --mc-card-radius: 15px;
    --mc-card-image-inset: 0;
    /* 立體卡：上緣內高光 + 內凹陰影 + 多層外陰影 */
    --mc-z-card-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.11),
      inset 0 -3px 6px rgba(0, 0, 0, 0.32),
      0 2px 4px rgba(0, 0, 0, 0.38),
      0 10px 24px rgba(0, 0, 0, 0.45),
      0 22px 44px rgba(0, 0, 0, 0.4);
    --mc-z-card-shadow-hover:
      inset 0 1px 0 rgba(255, 255, 255, 0.15),
      inset 0 -3px 6px rgba(0, 0, 0, 0.28),
      0 5px 10px rgba(0, 0, 0, 0.45),
      0 14px 32px rgba(0, 0, 0, 0.52),
      0 32px 56px rgba(0, 0, 0, 0.46);
  }

  .main-collection-zgrid ul.product-grid[product-grid-view='default'] {
    align-items: stretch;
    box-sizing: border-box;
  }

  .main-collection-zgrid ul.product-grid[product-grid-view='default'] .product-grid__item:not(.product-grid__item--z-spacer) {
    box-sizing: border-box;
    height: 100%;
    background: var(--mc-z-card-bg);
    border: none;
    border-radius: var(--mc-card-radius);
    box-shadow: var(--mc-z-card-shadow);
    overflow: hidden;
    isolation: isolate;
    position: relative;
    transition: box-shadow 0.35s ease, transform 0.35s ease;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .main-collection-zgrid
      ul.product-grid[product-grid-view='default']
      .product-grid__item:not(.product-grid__item--z-spacer):hover {
      z-index: 2;
      box-shadow: var(--mc-z-card-shadow-hover);
      transform: translateY(-4px);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: reduce) {
    .main-collection-zgrid
      ul.product-grid[product-grid-view='default']
      .product-grid__item:not(.product-grid__item--z-spacer):hover {
      z-index: 2;
      box-shadow: var(--mc-z-card-shadow-hover);
    }
  }

  /* 卡片撐滿格線高度，讓下方灰區可分配剩餘空間 */
  .main-collection-zgrid ul.product-grid[product-grid-view='default'] .product-grid__item:not(.product-grid__item--z-spacer) product-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }

  .main-collection-zgrid ul.product-grid[product-grid-view='default'] .product-grid__item:not(.product-grid__item--z-spacer) .product-card {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    height: 100%;
  }

  .main-collection-zgrid
    ul.product-grid[product-grid-view='default']
    > .product-grid__item:not(.product-grid__item--z-spacer):nth-child(odd),
  .main-collection-zgrid
    ul.product-grid[product-grid-view='default']
    > .product-grid__item:not(.product-grid__item--z-spacer):nth-child(even) {
    grid-column: auto;
    transform: none;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card {
    flex: 1 1 auto;
    min-height: 0;
    gap: 10px;
    padding-block: 0;
    padding-inline: 0;
    background: var(--mc-z-card-bg);
    border-radius: var(--mc-card-radius);
    color: rgba(245, 240, 230, 0.94);
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card > .card-gallery {
    flex: 0 0 auto;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-badges {
    z-index: 6;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card > .group-block {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    margin-top: 0;
    padding: 4px 12px 10px;
    background: var(--mc-z-card-bg);
    box-shadow: none;
    border-radius: 0 0 var(--mc-card-radius) var(--mc-card-radius);
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card > .group-block > .group-block-content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
    justify-content: flex-start;
  }

  /* collection 卡片常為外層 group 包內層 group（標題＋價錢）：內層撐滿剩餘高度，價錢才能沉底 */
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card > .group-block .group-block:has(product-price) {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
    align-self: stretch;
    width: 100%;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card > .group-block .group-block:has(product-price) > .group-block-content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card > .group-block > .group-block-content > .group-block:not(:has(product-price)) {
    flex: 0 0 auto;
  }

  /* 字級：品名見下方 @media（對齊 paragraph 價錢字級，寫在 > *） */
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card .h4,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card .text-block:is(.h4, .h5) {
    color: rgba(245, 240, 230, 0.96);
    line-height: 1.26;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card .h6 {
    color: rgba(245, 240, 230, 0.96);
  }

  /* 價格：左對齊；沉到灰區底部（價錢元件本身 margin-top:auto，勿套到內層 *） */
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price.text-block--align-right {
    margin-inline-start: 0 !important;
    margin-inline-end: 0 !important;
    margin-top: auto;
    margin-block-end: 0;
    padding-block-end: 0;
    text-align: left;
    width: 100%;
    align-self: stretch;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price.text-block--align-right > * {
    margin-inline-start: 0 !important;
    margin-inline-end: 0 !important;
    text-align: left;
  }

  /* 同一列：折扣價（橘）在左、劃線原價在右；order 覆蓋 show_sale_price_first 的 DOM 順序 */
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price > div {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-start;
    gap: 0.25em 0.5em;
    width: 100%;
    text-align: left;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price > div > [role='group'] {
    line-height: 1.12;
    margin: 0;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price > div > [role='group']:has(.price) {
    order: 1;
    flex: 0 1 auto;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price > div > [role='group']:has(.compare-at-price) {
    order: 2;
    margin-inline-start: auto;
    flex: 0 0 auto;
    text-align: right;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price > div .price,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price > div .compare-at-price {
    line-height: 1.12;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price {
    color: rgba(245, 240, 230, 0.96);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.45);
  }

  /* 現價：品牌橘 */
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price > div .price {
    color: #f08418;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price .compare-at-price {
    color: rgba(200, 200, 200, 0.85);
  }

  /*
    可點區域貼齊實際卡片：外層 li 裁切圓角，連結與卡片同圓角。
  */
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-card,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-card__link {
    border-radius: var(--mc-card-radius);
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-card__link {
    clip-path: inset(0 round var(--mc-card-radius));
  }

  /*
    圖貼齊卡殼頂／左右；slideshow 與媒體層級設明確圓角（四角，與 --mc-card-radius 一致；不用 inherit 以免 web component 不生效）。
  */
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery {
    box-sizing: border-box;
    width: calc(100% - 2 * var(--mc-card-image-inset));
    max-width: calc(100% - 2 * var(--mc-card-image-inset));
    margin: var(--mc-card-image-inset) var(--mc-card-image-inset) 0;
    align-self: stretch;
    flex-shrink: 0;
    border-radius: var(--mc-card-radius);
    overflow: hidden;
    isolation: isolate;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery slideshow-component,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery slideshow-container,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery slideshow-slides,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery slideshow-slide,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery .product-media-container,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery .product-media,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery deferred-media,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery placeholder-image {
    border-radius: var(--mc-card-radius);
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery slideshow-slide,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery .product-media-container,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery .product-media {
    overflow: hidden;
  }

  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery .product-media__image,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery .deferred-media__poster-image,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery img,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery video,
  .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .card-gallery iframe {
    border-radius: var(--mc-card-radius);
  }

  @media screen and (width < 750px) {
    /*
      主題 section 的 padding-block-start 會疊在 collection-links 下方；
      手機上收斂頂部留白（仍保留極小間距）。
    */
    results-list.main-collection-zgrid.product-grid-container,
    .apgo-all-catalog-root.main-collection-zgrid.product-grid-container {
      padding-block-start: 4px !important;
    }

    .main-collection-zgrid ul.product-grid[product-grid-view='default'] {
      --product-grid-gap: 10px 10px;
      gap: 10px 10px;
      padding-inline: 4px;
    }

    /* 手機：品名與價格（paragraph）同階字級，略大 5% */
    .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card .text-block:is(.h4, .h5) > * {
      font-size: clamp(
        0.75rem,
        2.5vw,
        calc(var(--font-paragraph--size, var(--font-size--paragraph, 0.875rem)) * 1.05)
      );
    }
  }

  @media screen and (width >= 750px) {
    results-list.main-collection-zgrid.product-grid-container,
    .apgo-all-catalog-root.main-collection-zgrid.product-grid-container {
      padding-block-start: var(--padding-block-start) !important;
    }

    .main-collection-zgrid ul.product-grid[product-grid-view='default'] {
      /* 略縮橫向間距，五欄時單卡可寬一點點 */
      --product-grid-gap: 16px 14px;
      gap: 16px 14px;
      padding-inline: 0;
    }

    /* 桌機：固定 5 欄均分，讓同一版心寬度約為「先前 auto-fill 約 3 大卡」時可並排 5 張 */
    .main-collection-zgrid ul.product-grid.product-grid--grid[product-grid-view='default'] {
      --product-grid-columns-desktop: repeat(5, minmax(0, 1fr));
    }

    /* 桌機五欄：品名略小於 paragraph，易在窄卡內換行 */
    .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card .text-block:is(.h4, .h5) > * {
      font-size: clamp(
        0.6875rem,
        0.52rem + 0.32vw,
        calc(var(--font-paragraph--size, var(--font-size--paragraph, 0.875rem)) * 0.86)
      );
      line-height: 1.2;
    }

    .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price > div .price {
      font-size: clamp(0.7rem, 0.58rem + 0.28vw, 0.8125rem);
    }

    .main-collection-zgrid .product-grid__item:not(.product-grid__item--z-spacer) .product-grid__card product-price > div .compare-at-price {
      font-size: clamp(0.625rem, 0.52rem + 0.22vw, 0.75rem);
    }
  }

  /*
    All 整合目錄：避免 (1) product-grid-container 在桌機變 grid 把 skip 連結與內容並排
    (2) collection-wrapper.grid 把每個 section 塞進多欄模板的單格 → 極窄欄、標題疊在一起。
  */
  @media screen and (width >= 750px) {
    .apgo-all-catalog-root.product-grid-container {
      display: block;
      width: 100%;
      max-width: 100%;
    }
  }

  .collection-wrapper--all-catalog-hub {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xl, 2rem);
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  @media screen and (width >= 750px) {
    .collection-wrapper--all-catalog-hub {
      max-width: min(100%, var(--page-width, 120rem));
      margin-inline: auto;
      padding-inline: var(--page-margin);
    }
  }

  .apgo-catalog-hub-section {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    width: 100%;
    min-width: 0;
  }

  .apgo-all-catalog-root .main-collection-grid {
    grid-column: unset;
    width: 100%;
    max-width: 100%;
  }

  .apgo-all-catalog-root .main-collection-grid > div {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .apgo-catalog-hub-section .apgo-catalog-heading {
    margin: 0 0 var(--padding-sm);
    padding-inline: max(var(--padding-xs), var(--page-margin, 1rem));
    width: 100%;
    box-sizing: border-box;
    overflow-wrap: break-word;
    scroll-margin-top: calc(
      var(--sticky-header-offset, var(--header-height, 72px)) + var(--header-group-height, 0px) + 4.25rem
    );
  }

  @media screen and (width >= 750px) {
    .apgo-catalog-hub-section .apgo-catalog-heading {
      padding-inline: 0;
      scroll-margin-top: calc(
        var(--sticky-header-offset, var(--header-height, 80px)) + var(--header-group-height, 0px) + 4.25rem
      );
    }
  }

  html.apgo-catalog-hub-smooth-scroll {
    scroll-behavior: smooth;
  }
{% endstylesheet %}

{% schema %}
