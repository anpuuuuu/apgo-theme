{%- comment -%}
  Phones only: the menu as one swipeable row of buttons under the header
  (2026-10, owner's request). Under 750px the header folds its menu into
  the ☰ drawer, so shoppers arriving from ads never saw "Clearance Sales".
  The link chosen as "Red button" stands out; links to Malaysia-only pages
  are left out for Singapore (snippets/apgo-market-only-pages.liquid), like
  the header menu. From 750px up the header shows its own menu and this row
  hides. Lives in the header group (sections/header-group.json), AFTER the
  category bar section: header.liquid styles whatever section comes right
  after the header (sticky, black, 2.75rem tall on /collections/all), so
  placed first this row took over the category bar's sticky slot.

  Same items as the header (snippets/header-menu.liquid, header-drawer.liquid):
  "Category" is skipped, "Contact" shows as About Us, and Find Us follows it.
{%- endcomment -%}
{%- liquid
  assign apgo_mr_menu = linklists[section.settings.menu]
  assign apgo_mr_hot = section.settings.highlight_link | default: '' | downcase
  assign apgo_mr_find_us_done = false
-%}
{%- if apgo_mr_menu.links.size > 0 -%}
  <nav class="apgo-menu-row" aria-label="{{ apgo_mr_menu.title | escape }}">
    <ul class="apgo-menu-row__list" role="list">
      {%- for link in apgo_mr_menu.links -%}
        {%- liquid
          assign apgo_mr_title = link.title | downcase | strip
          assign apgo_mr_handle = link.handle | downcase | strip
          assign apgo_mr_skip = false
          if apgo_mr_title == 'category' or apgo_mr_title == 'categories' or apgo_mr_title == '分類'
            assign apgo_mr_skip = true
          endif
          if apgo_mr_handle == 'category' or apgo_mr_handle == 'categories'
            assign apgo_mr_skip = true
          endif
          assign apgo_mr_link_url = link.url
          assign apgo_mr_label = link.title
          assign apgo_mr_current = link.current
          if apgo_mr_title == 'contact'
            assign apgo_mr_link_url = '/pages/about-us'
            assign apgo_mr_label = 'About Us'
            assign apgo_mr_current = false
            if request.path contains '/pages/about-us'
              assign apgo_mr_current = true
            endif
          endif
          capture apgo_mr_hidden
            render 'apgo-market-only-pages', part: 'check', url: apgo_mr_link_url
          endcapture
          if apgo_mr_hidden contains 'hidden'
            assign apgo_mr_skip = true
          endif
          assign apgo_mr_url = apgo_mr_link_url | downcase
        -%}
        {%- unless apgo_mr_skip -%}
          <li>
            <a
              class="apgo-menu-row__link{% if apgo_mr_hot != blank and apgo_mr_url == apgo_mr_hot %} apgo-menu-row__link--hot{% endif %}"
              href="{{ apgo_mr_link_url }}"
              {% if apgo_mr_current %}
                aria-current="page"
              {% endif %}
            >
              {{- apgo_mr_label | escape -}}
            </a>
          </li>
          {%- liquid
            assign apgo_mr_do_find_us = false
            if apgo_mr_find_us_done == false
              if apgo_mr_title == 'contact'
                assign apgo_mr_do_find_us = true
              elsif link.object != blank and link.object.handle == 'about-us'
                assign apgo_mr_do_find_us = true
              endif
            endif
            if apgo_mr_do_find_us
              render 'apgo-header-find-us-nav', layout: 'row'
              assign apgo_mr_find_us_done = true
            endif
          -%}
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </nav>
  <script>
    /* Bring the current page's button into view when the row scrolls. */
    (function () {
      var nav = document.currentScript && document.currentScript.previousElementSibling;
      var list = nav && nav.querySelector('.apgo-menu-row__list');
      var current = list && list.querySelector('[aria-current="page"]');
      if (current && current.offsetLeft + current.offsetWidth > list.clientWidth) {
        list.scrollLeft = current.offsetLeft - 16;
      }
    })();
    /* The row scrolls away while the header and the shipping marquee stay
       pinned. --header-group-height counts the row, so the marquee's sticky
       top (sections/free-shipping-popup.liquid) takes this height off again;
       without it a row-high gap opened under the header (2026-10-08). 0 from
       750px up, where the row is hidden. */
    (function () {
      var nav = document.querySelector('.apgo-menu-row');
      var row = nav && (nav.closest('.shopify-section') || nav);
      if (!row) return;
      function setHeight() {
        document.body.style.setProperty('--apgo-menu-row-h', row.offsetHeight + 'px');
      }
      setHeight();
      if (window.ResizeObserver) new ResizeObserver(setHeight).observe(row);
      else window.addEventListener('resize', setHeight);
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .apgo-menu-row {
    padding: 0 0 6px;
    background: #000;
  }

  .apgo-menu-row__list {
    position: relative;
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 4px 16px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .apgo-menu-row__list::-webkit-scrollbar {
    display: none;
  }

  .apgo-menu-row__list > li {
    flex: 0 0 auto;
    margin: 0;
  }

  .apgo-menu-row__link {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 999px;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
  }

  .apgo-menu-row__link[aria-current='page'] {
    border-color: #f08418;
    color: #f08418;
  }

  .apgo-menu-row__link--hot,
  .apgo-menu-row__link--hot[aria-current='page'] {
    border-color: #e0352b;
    background: #e0352b;
    color: #fff;
  }

  .apgo-menu-row__link:focus-visible {
    outline: 2px solid #f08418;
    outline-offset: 1px;
  }

  @media screen and (min-width: 750px) {
    .apgo-menu-row {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "APGO menu row (phone)",
  "class": "apgo-menu-row-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Phones only (under 750px wide): the menu as one row of buttons under the header, swipeable sideways. Larger screens show the header's own menu."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "url",
      "id": "highlight_link",
      "label": "Red button",
      "info": "The menu link shown as a red button, e.g. the clearance sale page. Leave empty for none."
    }
  ],
  "presets": [
    {
      "name": "APGO menu row (phone)",
      "category": "APGO"
    }
  ]
}
{% endschema %}
