{"sections":{"about_redesign":{"type":"custom-liquid","name":"About Us Redesign","settings":{"custom_liquid":"\n<section class=\"apgo-about-page\">\n  <section class=\"apgo-hero-video\" id=\"apgoHeroVideoSection\">\n    <video\n      id=\"apgoAboutVideo\"\n      class=\"apgo-about-video\"\n      autoplay\n      muted\n      loop\n      playsinline\n      preload=\"auto\"\n      controls\n    >\n      <!-- ?????????? Shopify Files,??? file_url -->\n      <source src=\"{{ 'APGO ?? Video A 2.mp4' | file_url }}\" type=\"video/mp4\">\n    </video>\n    <div class=\"apgo-video-overlay\"></div>\n  </section>\n\n  <section class=\"apgo-brand-philosophy\">\n    <h2>Behind every APGO product is a team committed to quality.</h2>\n    <p>\n      From product development and testing to packaging and delivery, every step is carefully executed to ensure consistency and performance.\n      We believe great results don't happen by chance - they are built through dedication, experience, and attention to detail.\n    </p>\n  </section>\n\n  <section class=\"apgo-vm-section\">\n    <article class=\"apgo-vm-card\">\n      <div class=\"apgo-vm-icon apgo-vm-icon--orange\">&gt;&gt;</div>\n      <h3>VISION</h3>\n      <p>To redefine modern car care by setting new standards in performance, quality, and user experience worldwide.</p>\n    </article>\n\n    <article class=\"apgo-vm-card\">\n      <div class=\"apgo-vm-icon apgo-vm-icon--red\">&gt;&gt;</div>\n      <h3>MISSION</h3>\n      <p>We aim to engineer premium car care products and make professional detailing results accessible to every car owner.</p>\n    </article>\n  </section>\n</section>\n\n<style>\n  .apgo-about-page {\n    background: #000;\n    color: #fff;\n    font-family: Arial, 'Helvetica Neue', sans-serif;\n  }\n\n  .apgo-hero-video {\n    position: relative;\n    width: 100%;\n    min-height: 52vh;\n    max-height: 78vh;\n    overflow: hidden;\n    background: #050505;\n    border-bottom: 1px solid rgba(240, 132, 24, 0.25);\n  }\n\n  .apgo-about-video {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n    filter: contrast(1.05) saturate(1.05);\n  }\n\n  .apgo-video-overlay {\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(to top, rgba(0, 0, 0, 0.72), rgba(0, 0, 0, 0.15));\n    pointer-events: none;\n  }\n\n  .apgo-brand-philosophy {\n    max-width: 980px;\n    margin: 0 auto;\n    padding: 72px 24px 56px;\n    text-align: center;\n  }\n\n  .apgo-brand-philosophy h2 {\n    font-size: clamp(1.5rem, 2.7vw, 2.45rem);\n    line-height: 1.35;\n    margin-bottom: 22px;\n    letter-spacing: 0.02em;\n  }\n\n  .apgo-brand-philosophy p {\n    color: #d2d2d2;\n    font-size: clamp(1rem, 1.4vw, 1.125rem);\n    line-height: 1.9;\n    max-width: 860px;\n    margin: 0 auto;\n  }\n\n  .apgo-vm-section {\n    max-width: 1220px;\n    margin: 0 auto;\n    padding: 8px 24px 92px;\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 24px;\n  }\n\n  .apgo-vm-card {\n    background: radial-gradient(circle at top right, rgba(240, 132, 24, 0.1), rgba(0, 0, 0, 0.9) 56%);\n    border: 1px solid rgba(240, 132, 24, 0.34);\n    border-radius: 20px;\n    padding: 34px 30px;\n    box-shadow: 0 0 24px rgba(240, 132, 24, 0.18);\n    transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;\n  }\n\n  .apgo-vm-card:hover {\n    transform: translateY(-4px) scale(1.015);\n    box-shadow: 0 0 34px rgba(240, 132, 24, 0.32);\n    border-color: rgba(240, 132, 24, 0.7);\n  }\n\n  .apgo-vm-icon {\n    font-size: 1.18rem;\n    font-weight: 800;\n    letter-spacing: 0.08em;\n    margin-bottom: 10px;\n  }\n\n  .apgo-vm-icon--orange {\n    color: #f08418;\n  }\n\n  .apgo-vm-icon--red {\n    color: #ff4d4f;\n  }\n\n  .apgo-vm-card h3 {\n    margin: 0 0 12px;\n    font-size: 1.35rem;\n    letter-spacing: 0.08em;\n  }\n\n  .apgo-vm-card p {\n    margin: 0;\n    color: #d8d8d8;\n    line-height: 1.8;\n    font-size: 1rem;\n  }\n\n  @media (max-width: 900px) {\n    .apgo-vm-section {\n      grid-template-columns: 1fr;\n      padding-bottom: 70px;\n    }\n\n    .apgo-hero-video {\n      min-height: 38vh;\n      max-height: 56vh;\n    }\n  }\n</style>\n\n<script>\n  (function () {\n    const video = document.getElementById('apgoAboutVideo');\n    if (!video) return;\n\n    // ????????;?????????????\n    video.muted = true;\n\n    video.addEventListener('fullscreenchange', () => {\n      if (document.fullscreenElement === video || document.fullscreenElement === video.parentElement) {\n        video.muted = false;\n      } else {\n        video.muted = true;\n      }\n    });\n\n    // ??????????(??????????)\n    video.addEventListener('click', async () => {\n      if (!document.fullscreenElement && video.requestFullscreen) {\n        try {\n          await video.requestFullscreen();\n        } catch (e) {\n          // ignore - user gesture / browser policy may block\n        }\n      }\n    });\n  })();\n</script>\n","color_scheme":"","section_width":"full-width","padding-block-start":0,"padding-block-end":0}}},"order":["about_redesign"]}