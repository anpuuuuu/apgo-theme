    "custom_liquid_QNhCUK": {
      "type": "custom-liquid",
      "name": "新美化",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"zh-TW\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>AKO 插件響應式 CSS</title>\n</head>\n<body>\n<style>\n/* ========================================\n   AKO 購物車插件完整解決方案 - 響應式修正版\n   包含手機版、平板、桌面版完整優化\n   ======================================== */\n\n/* CSS 變數定義 */\n:root {\n    --primary-orange: #f08418;\n    --secondary-orange: #ff6b35;\n    --gradient-orange: linear-gradient(135deg, #ff6b35, #f7931e);\n    --gradient-orange-subtle: linear-gradient(135deg, rgba(255, 107, 53, 0.1), rgba(247, 147, 30, 0.05));\n    --dark-bg: #0a0a0a;\n    --dark-secondary: #1a1a1a;\n    --dark-tertiary: #2d2d2d;\n    --card-bg: rgba(255, 255, 255, 0.02);\n    --border-color: rgba(255, 255, 255, 0.08);\n    --border-hover: rgba(240, 132, 24, 0.3);\n    --text-primary: #ffffff;\n    --text-secondary: #cccccc;\n    --text-muted: #888888;\n    --success: #4ade80;\n    --error: #f87171;\n}\n\n/* 全域重設 */\n#akocommerce_cvs_section,\n#akocommerce_cvs_section *,\n.akoCvsScNS,\n.akoCvsScNS * {\n    color: var(--text-primary) !important;\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;\n    box-sizing: border-box !important;\n}\n\n/* 主容器樣式 - 響應式調整 */\n#akocommerce_cvs_section,\n.akoCvsScNS {\n    background: var(--dark-bg) !important;\n    padding: 60px 0 !important;\n    position: relative !important;\n    overflow: hidden !important;\n    margin: 0 !important;\n    border: none !important;\n}\n\n/* 內容容器 - 根據螢幕寬度自適應 */\n.ako-container {\n    width: 100% !important;\n    max-width: 1200px !important;\n    margin: 0 auto !important;\n    padding: 0 20px !important;\n    position: relative !important;\n    z-index: 1 !important;\n    background: transparent !important;\n    border: none !important;\n    box-shadow: none !important;\n    display: flex !important;\n    flex-direction: column !important;\n    gap: 30px !important;\n    min-height: auto !important;\n}\n\n/* 區段樣式 */\n.ako-invoice,\n.ako-cvs-section,\nsection.ako-invoice,\nsection.ako-cvs-section {\n    background: linear-gradient(145deg, var(--dark-secondary), var(--dark-tertiary)) !important;\n    border: 2px solid var(--border-color) !important;\n    border-radius: 20px !important;\n    padding: 32px !important;\n    margin-bottom: 2rem !important;\n    position: relative !important;\n    overflow: visible !important;\n    box-shadow: \n        0 25px 50px rgba(0, 0, 0, 0.5),\n        inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;\n    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1) !important;\n}\n\n/* 頂部裝飾線 */\n.ako-invoice::before,\n.ako-cvs-section::before {\n    content: '' !important;\n    position: absolute !important;\n    top: 0 !important;\n    left: 32px !important;\n    right: 32px !important;\n    height: 3px !important;\n    background: var(--gradient-orange) !important;\n    border-radius: 0 0 2px 2px !important;\n}\n\n/* 標題樣式 */\n.ako-invoice-title,\n.ako-cvs-title,\nh2.ako-invoice-title,\nh2.ako-cvs-title {\n    font-size: 24px !important;\n    font-weight: 700 !important;\n    color: var(--text-primary) !important;\n    margin: 0 0 8px 0 !important;\n    background: var(--gradient-orange) !important;\n    -webkit-background-clip: text !important;\n    -webkit-text-fill-color: transparent !important;\n    background-clip: text !important;\n    text-shadow: 0 0 10px rgba(255, 107, 53, 0.5) !important;\n    text-align: left !important;\n    padding: 0 !important;\n}\n\n/* 副標題 */\n.ako-invoice-subtitle {\n    font-size: 16px !important;\n    font-weight: 600 !important;\n    color: var(--text-secondary) !important;\n    margin: 0 0 16px 0 !important;\n    padding: 0 !important;\n}\n\n/* 描述文字 */\n.akocommerce-description {\n    font-size: 14px !important;\n    color: var(--text-muted) !important;\n    line-height: 1.6 !important;\n    margin-bottom: 24px !important;\n}\n\n/* 資訊框 */\n.ako-info-box,\np.ako-info-box {\n    background: linear-gradient(135deg, rgba(240, 132, 24, 0.1), rgba(255, 107, 53, 0.05)) !important;\n    border: 1px solid var(--primary-orange) !important;\n    border-radius: 12px !important;\n    padding: 20px !important;\n    margin: 0 0 24px 0 !important;\n    font-size: 14px !important;\n    color: #e0e0e0 !important;\n    position: relative !important;\n    overflow: hidden !important;\n    line-height: 1.5 !important;\n}\n\n.ako-info-box::before {\n    content: '' !important;\n    position: absolute !important;\n    top: 0 !important;\n    left: 0 !important;\n    right: 0 !important;\n    height: 3px !important;\n    background: var(--gradient-orange) !important;\n}\n\n.ako-info-box strong {\n    color: var(--primary-orange) !important;\n    font-weight: 600 !important;\n}\n\n/* ========================================\n   發票選擇改造 - 下拉選單樣式\n   ======================================== */\n\n.ako-invoice-setting,\n.ako-invoice-type {\n    display: flex !important;\n    flex-direction: column !important;\n    gap: 16px !important;\n    margin: 0 !important;\n    padding: 0 !important;\n}\n\n/* 下拉選單容器 */\n.ako-menu {\n    position: relative !important;\n    z-index: 9999 !important;\n    margin: 0 0 20px 0 !important;\n    width: 100% !important;\n}\n\n/* 下拉按鈕 */\n.ako-menu-button {\n    width: 100% !important;\n    background: linear-gradient(145deg, #2d2d2d, #1a1a1a) !important;\n    border: 2px solid #404040 !important;\n    border-radius: 12px !important;\n    padding: 16px 20px !important;\n    font-size: 15px !important;\n    color: var(--text-primary) !important;\n    cursor: pointer !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: space-between !important;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;\n    box-shadow: \n        0 4px 15px rgba(0, 0, 0, 0.3),\n        inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;\n    margin: 0 !important;\n    min-height: 56px !important;\n}\n\n.ako-menu-button:hover {\n    border-color: var(--primary-orange) !important;\n    box-shadow: \n        0 8px 25px rgba(255, 107, 53, 0.3),\n        inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;\n    transform: translateY(-2px) !important;\n}\n\n/* 箭頭圖示 */\n.ako-menu-button__arrow {\n    width: 20px !important;\n    height: 20px !important;\n    color: #888888 !important;\n    transition: transform 0.3s ease, color 0.3s ease !important;\n    flex-shrink: 0 !important;\n}\n\n.ako-menu-button:hover .ako-menu-button__arrow {\n    color: var(--primary-orange) !important;\n}\n\n/* 下拉選單列表 */\n.ako-menu-list {\n    position: absolute !important;\n    top: 100% !important;\n    left: 0 !important;\n    right: 0 !important;\n    width: 100% !important;\n    background: linear-gradient(145deg, #2d2d2d, #1a1a1a) !important;\n    border: 2px solid #404040 !important;\n    border-radius: 12px !important;\n    margin: 8px 0 0 0 !important;\n    padding: 0 !important;\n    z-index: 10000 !important;\n    box-shadow: \n        0 20px 40px rgba(0, 0, 0, 0.5),\n        inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;\n    \n    /* 預設隱藏 */\n    max-height: 0 !important;\n    overflow: hidden !important;\n    opacity: 0 !important;\n    visibility: hidden !important;\n    transform: translateY(-10px) scale(0.95) !important;\n    pointer-events: none !important;\n    \n    /* 動畫 */\n    transition: \n        max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),\n        opacity 0.3s ease,\n        visibility 0.3s ease,\n        transform 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;\n}\n\n/* 下拉選單顯示狀態 */\n.ako-menu-list[style*=\"max-height\"][style*=\"px\"]:not([style*=\"max-height: 0px\"]) {\n    max-height: 300px !important;\n    overflow: visible !important;\n    opacity: 1 !important;\n    visibility: visible !important;\n    transform: translateY(0) scale(1) !important;\n    pointer-events: auto !important;\n    border-color: var(--primary-orange) !important;\n}\n\n/* 下拉選單項目 */\n.ako-menu-list .ako-menu__item,\n.ako-menu-list li.ako-menu__item {\n    padding: 18px 20px !important;\n    cursor: pointer !important;\n    display: flex !important;\n    align-items: center !important;\n    gap: 12px !important;\n    justify-content: space-between !important;\n    border-bottom: 1px solid #404040 !important;\n    color: #e0e0e0 !important;\n    list-style: none !important;\n    margin: 0 !important;\n    position: relative !important;\n    transition: all 0.2s ease !important;\n}\n\n.ako-menu-list .ako-menu__item:last-child {\n    border-bottom: none !important;\n}\n\n.ako-menu-list .ako-menu__item:hover {\n    background: linear-gradient(90deg, rgba(255, 107, 53, 0.1), rgba(247, 147, 30, 0.1)) !important;\n    color: var(--primary-orange) !important;\n}\n\n/* 選中狀態 */\n.ako-menu-list .ako-menu__item.selected,\n.ako-menu-list .ako-menu__item[data-selected=\"true\"] {\n    background: linear-gradient(90deg, rgba(255, 107, 53, 0.15), rgba(247, 147, 30, 0.15)) !important;\n    color: var(--primary-orange) !important;\n    font-weight: 600 !important;\n}\n\n/* 圖示樣式 */\n.ako-item__left-icon {\n    width: 28px !important;\n    height: 28px !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    border-radius: 6px !important;\n    background: linear-gradient(135deg, #404040, #2d2d2d) !important;\n}\n\n.ako-item__right-icon {\n    width: 20px !important;\n    height: 20px !important;\n    color: var(--primary-orange) !important;\n}\n\n/* ========================================\n   輸入欄位樣式\n   ======================================== */\n\n.ako-label {\n    display: block !important;\n    font-size: 14px !important;\n    font-weight: 600 !important;\n    color: var(--primary-orange) !important;\n    margin: 0 0 8px 0 !important;\n    text-shadow: 0 0 10px rgba(255, 107, 53, 0.3) !important;\n}\n\n.ako-input {\n    width: 100% !important;\n    height: 56px !important;\n    padding: 16px 20px !important;\n    background: linear-gradient(145deg, #2d2d2d, #1a1a1a) !important;\n    border: 2px solid #404040 !important;\n    border-radius: 12px !important;\n    color: var(--text-primary) !important;\n    font-size: 15px !important;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;\n    box-shadow: \n        0 4px 15px rgba(0, 0, 0, 0.3),\n        inset 0 1px 0 rgba(255, 255, 255, 0.05) !important;\n    outline: none !important;\n    margin: 0 !important;\n}\n\n.ako-input:focus,\n.ako-input--start {\n    border-color: var(--primary-orange) !important;\n    box-shadow: \n        0 8px 25px rgba(255, 107, 53, 0.3),\n        inset 0 1px 0 rgba(255, 255, 255, 0.1),\n        0 0 20px rgba(255, 107, 53, 0.4) !important;\n    transform: translateY(-1px) !important;\n    background: linear-gradient(145deg, #333333, #1d1d1d) !important;\n}\n\n.ako-input::placeholder {\n    color: #888888 !important;\n    opacity: 1 !important;\n}\n\n/* 輸入框容器 */\n.ako-company-invoice {\n    display: flex !important;\n    flex-direction: column !important;\n    gap: 20px !important;\n    margin: 20px 0 0 0 !important;\n    padding: 0 !important;\n}\n\n/* 提示文字 */\n.ako-helper-text {\n    display: flex !important;\n    align-items: center !important;\n    gap: 8px !important;\n    margin: 8px 0 0 0 !important;\n    padding: 0 !important;\n    font-size: 13px !important;\n    color: var(--text-secondary) !important;\n    line-height: 1.4 !important;\n}\n\n.ako-helper-text--start {\n    color: var(--primary-orange) !important;\n    font-weight: 500 !important;\n}\n\n/* ========================================\n   核取方塊樣式\n   ======================================== */\n\n.ako-checkbox {\n    display: flex !important;\n    align-items: flex-start !important;\n    gap: 16px !important;\n    padding: 20px !important;\n    background: linear-gradient(135deg, rgba(255, 255, 255, 0.02), rgba(255, 255, 255, 0.01)) !important;\n    border: 1px solid var(--border-color) !important;\n    border-radius: 12px !important;\n    cursor: pointer !important;\n    transition: all 0.3s ease !important;\n    margin: 16px 0 0 0 !important;\n    font-size: 14px !important;\n    line-height: 1.5 !important;\n    color: #e0e0e0 !important;\n}\n\n.ako-checkbox:hover {\n    border-color: rgba(240, 132, 24, 0.3) !important;\n    box-shadow: 0 8px 20px rgba(240, 132, 24, 0.1) !important;\n}\n\n.ako-checkbox input {\n    display: none !important;\n}\n\n.ako-checkmark {\n    width: 24px !important;\n    height: 24px !important;\n    border: 2px solid var(--primary-orange) !important;\n    border-radius: 6px !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    flex-shrink: 0 !important;\n    background: transparent !important;\n    transition: all 0.3s ease !important;\n}\n\n.ako-checkbox input:checked + .ako-checkmark {\n    background: var(--gradient-orange) !important;\n    border-color: transparent !important;\n}\n\n.ako-checkmark svg {\n    width: 14px !important;\n    height: 14px !important;\n    color: var(--text-primary) !important;\n    opacity: 0 !important;\n    transition: opacity 0.3s ease !important;\n}\n\n.ako-checkbox input:checked + .ako-checkmark svg {\n    opacity: 1 !important;\n}\n\n/* ========================================\n   物流選擇按鈕\n   ======================================== */\n\n.akocommerce-logistics-buttons {\n    display: flex !important;\n    gap: 16px !important;\n    margin: 20px 0 !important;\n    flex-wrap: wrap !important;\n}\n\n.akocommerce-logistics-button {\n    display: flex !important;\n    flex-direction: column !important;\n    justify-content: center !important;\n    align-items: center !important;\n    border: 2px solid #404040 !important;\n    flex: 1 !important;\n    box-shadow: \n        0 4px 15px rgba(0, 0, 0, 0.3),\n        inset 0 1px 0 rgba(255, 255, 255, 0.05) !important;\n    min-height: 120px !important;\n    cursor: pointer !important;\n    border-radius: 12px !important;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;\n    background: linear-gradient(145deg, #2d2d2d, #1a1a1a) !important;\n    position: relative !important;\n    overflow: hidden !important;\n    padding: 20px !important;\n    margin: 0 !important;\n    color: var(--text-primary) !important;\n}\n\n.akocommerce-logistics-button:hover {\n    border-color: var(--primary-orange) !important;\n    box-shadow: \n        0 12px 35px rgba(255, 107, 53, 0.3),\n        inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;\n    transform: translateY(-4px) !important;\n}\n\n.akocommerce-logistics-button.active {\n    background: var(--gradient-orange) !important;\n    border-color: transparent !important;\n    color: var(--text-primary) !important;\n    box-shadow: \n        0 12px 35px rgba(255, 107, 53, 0.4),\n        inset 0 1px 0 rgba(255, 255, 255, 0.2) !important;\n}\n\n.akocommerce-logistics-button__icon {\n    width: 48px !important;\n    height: 48px !important;\n    display: flex !important;\n    align-items: center !important;\n    justify-content: center !important;\n    margin: 0 0 10px 0 !important;\n}\n\n.akocommerce-logistics-button__icon svg {\n    width: 40px !important;\n    height: 26px !important;\n    fill: currentColor !important;\n}\n\n.akocommerce-logistics-button div {\n    font-size: 14px !important;\n    font-weight: 600 !important;\n    color: inherit !important;\n    line-height: 1.4 !important;\n    text-align: center !important;\n}\n\n/* ========================================\n   超商品牌選擇按鈕\n   ======================================== */\n\n.akocommerce-company-buttons {\n    display: flex !important;\n    gap: 16px !important;\n    margin: 20px 0 !important;\n    flex-wrap: wrap !important;\n}\n\n.akocommerce-company-button {\n    display: flex !important;\n    justify-content: center !important;\n    align-items: center !important;\n    border: 2px solid #404040 !important;\n    flex: 1 !important;\n    height: 96px !important;\n    cursor: pointer !important;\n    border-radius: 12px !important;\n    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;\n    background: linear-gradient(145deg, #2d2d2d, #1a1a1a) !important;\n    position: relative !important;\n    overflow: hidden !important;\n    padding: 20px !important;\n    margin: 0 !important;\n    box-shadow: \n        0 4px 15px rgba(0, 0, 0, 0.3),\n        inset 0 1px 0 rgba(255, 255, 255, 0.05) !important;\n}\n\n.akocommerce-company-button:hover {\n    border-color: var(--primary-orange) !important;\n    box-shadow: \n        0 12px 35px rgba(255, 107, 53, 0.3),\n        inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;\n    transform: translateY(-4px) !important;\n}\n\n.akocommerce-company-button[data-selected='true'] {\n    background: var(--gradient-orange) !important;\n    border-color: transparent !important;\n    box-shadow: \n        0 12px 35px rgba(255, 107, 53, 0.4),\n        inset 0 1px 0 rgba(255, 255, 255, 0.2) !important;\n}\n\n.akocommerce-company-button[data-selected='false'] {\n    opacity: 0.6 !important;\n}\n\n.akocommerce-company-button img {\n    width: 48px !important;\n    height: 48px !important;\n    object-fit: contain !important;\n}\n\n/* ========================================\n   結果顯示區塊\n   ======================================== */\n\n.akocommerce-result {\n    background: linear-gradient(135deg, rgba(240, 132, 24, 0.1), rgba(255, 107, 53, 0.05)) !important;\n    border: 1px solid var(--primary-orange) !important;\n    border-radius: 12px !important;\n    padding: 20px !important;\n    margin: 20px 0 !important;\n    position: relative !important;\n    overflow: hidden !important;\n    box-shadow: \n        0 8px 25px rgba(0, 0, 0, 0.3),\n        inset 0 1px 0 rgba(255, 255, 255, 0.05) !important;\n}\n\n.akocommerce-result::before {\n    content: '' !important;\n    position: absolute !important;\n    top: 0 !important;\n    left: 0 !important;\n    right: 0 !important;\n    height: 3px !important;\n    background: var(--gradient-orange) !important;\n}\n\n.akocommerce-result-title {\n    color: var(--primary-orange) !important;\n    font-size: 14px !important;\n    font-weight: 600 !important;\n    margin: 0 0 12px 0 !important;\n    text-shadow: 0 0 10px rgba(255, 107, 53, 0.3) !important;\n}\n\n.akocommerce-result-shop {\n    color: var(--text-primary) !important;\n    font-size: 16px !important;\n    font-weight: 500 !important;\n    line-height: 1.5 !important;\n    margin: 0 0 8px 0 !important;\n}\n\n.akocommerce-result-shop:first-of-type {\n    font-size: 18px !important;\n    font-weight: 600 !important;\n    color: var(--primary-orange) !important;\n}\n\n/* 警告和注意事項 */\n.akocommerce-warning {\n    background: linear-gradient(135deg, #ff4444, #cc3333) !important;\n    color: var(--text-primary) !important;\n    padding: 16px 20px !important;\n    border-radius: 8px !important;\n    margin: 16px 0 !important;\n    font-size: 14px !important;\n    font-weight: 600 !important;\n    text-align: center !important;\n    box-shadow: \n        0 4px 15px rgba(255, 68, 68, 0.3),\n        inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;\n}\n\n.akocommerce-note {\n    color: var(--text-secondary) !important;\n    font-size: 13px !important;\n    font-weight: 400 !important;\n    line-height: 1.5 !important;\n    margin: 16px 0 0 0 !important;\n    padding: 16px !important;\n    background: rgba(255, 107, 53, 0.1) !important;\n    border-left: 4px solid var(--primary-orange) !important;\n    border-radius: 0 8px 8px 0 !important;\n}\n\n/* ========================================\n   響應式設計 - 完整修正\n   ======================================== */\n\n/* 平板橫向 (1024px) */\n@media (max-width: 1024px) {\n    .ako-container {\n        max-width: 960px !important;\n    }\n}\n\n/* 平板直向 (768px) */\n@media (max-width: 768px) {\n    #akocommerce_cvs_section,\n    .akoCvsScNS {\n        padding: 40px 0 !important;\n    }\n\n    .ako-container {\n        padding: 0 16px !important;\n        gap: 24px !important;\n    }\n\n    .ako-invoice,\n    .ako-cvs-section {\n        padding: 24px 20px !important;\n        border-radius: 16px !important;\n        margin-bottom: 1.5rem !important;\n    }\n    \n    .ako-invoice::before,\n    .ako-cvs-section::before {\n        left: 20px !important;\n        right: 20px !important;\n    }\n\n    .ako-invoice-title,\n    .ako-cvs-title {\n        font-size: 20px !important;\n    }\n\n    /* 下拉選單手機版優化 */\n    .ako-menu-button {\n        min-height: 60px !important;\n        padding: 20px !important;\n        font-size: 16px !important;\n    }\n    \n    .ako-menu-list {\n        max-height: 250px !important;\n        overflow-y: auto !important;\n        -webkit-overflow-scrolling: touch !important;\n    }\n    \n    .ako-menu-list .ako-menu__item {\n        min-height: 60px !important;\n        padding: 20px !important;\n        font-size: 16px !important;\n    }\n\n    /* 物流按鈕平板優化 */\n    .akocommerce-logistics-buttons {\n        gap: 12px !important;\n    }\n\n    .akocommerce-logistics-button {\n        padding: 16px !important;\n        min-height: 100px !important;\n    }\n\n    .akocommerce-logistics-button__icon svg {\n        width: 35px !important;\n        height: 24px !important;\n    }\n\n    .akocommerce-logistics-button div {\n        font-size: 13px !important;\n    }\n\n    /* 輸入框優化 */\n    .ako-input {\n        height: 52px !important;\n        padding: 14px 18px !important;\n        font-size: 16px !important; /* 防止 iOS 縮放 */\n    }\n    \n    .ako-label {\n        font-size: 13px !important;\n    }\n    \n    .ako-helper-text {\n        font-size: 12px !important;\n    }\n\n    /* 超商按鈕優化 */\n    .akocommerce-company-buttons {\n        gap: 12px !important;\n    }\n    \n    .akocommerce-company-button {\n        height: 80px !important;\n        padding: 16px !important;\n    }\n    \n    .akocommerce-company-button img {\n        width: 40px !important;\n        height: 40px !important;\n    }\n\n    /* 結果區塊優化 */\n    .akocommerce-result {\n        padding: 16px !important;\n        margin: 16px 0 !important;\n    }\n    \n    .akocommerce-result-title {\n        font-size: 13px !important;\n    }\n    \n    .akocommerce-result-shop {\n        font-size: 15px !important;\n    }\n    \n    .akocommerce-result-shop:first-of-type {\n        font-size: 16px !important;\n    }\n}\n\n/* 手機橫向 (640px) */\n@media (max-width: 640px) {\n    .ako-container {\n        gap: 20px !important;\n    }\n\n    /* 物流按鈕改為垂直排列 */\n    .akocommerce-logistics-buttons {\n        flex-direction: column !important;\n        gap: 12px !important;\n    }\n\n    .akocommerce-logistics-button {\n        width: 100% !important;\n        padding: 20px !important;\n    }\n}\n\n/* 手機直向 (480px) */\n@media (max-width: 480px) {\n    #akocommerce_cvs_section,\n    .akoCvsScNS {\n        padding: 32px 0 !important;\n    }\n\n    .ako-container {\n        padding: 0 12px !important;\n    }\n\n    .ako-invoice,\n    .ako-cvs-section {\n        padding: 20px 16px !important;\n        border-radius: 12px !important;\n        margin-bottom: 1.2rem !important;\n    }\n\n    .ako-invoice::before,\n    .ako-cvs-section::before {\n        left: 16px !important;\n        right: 16px !important;\n        height: 2px !important;\n    }\n\n    .ako-invoice-title,\n    .ako-cvs-title {\n        font-size: 18px !important;\n        margin-bottom: 6px !important;\n    }\n\n    .ako-invoice-subtitle {\n        font-size: 14px !important;\n        margin-bottom: 12px !important;\n    }\n\n    /* 資訊框手機版 */\n    .ako-info-box {\n        padding: 16px !important;\n        margin-bottom: 20px !important;\n        font-size: 13px !important;\n    }\n\n    /* 下拉選單手機版 */\n    .ako-menu {\n        margin: 0 0 16px 0 !important;\n    }\n    \n    .ako-menu-button {\n        min-height: 56px !important;\n        padding: 16px !important;\n        font-size: 15px !important;\n        border-radius: 10px !important;\n    }\n\n    .ako-menu-button__arrow {\n        width: 18px !important;\n        height: 18px !important;\n    }\n    \n    .ako-menu-list {\n        margin: 6px 0 0 0 !important;\n        border-radius: 10px !important;\n        max-height: 200px !important;\n    }\n    \n    .ako-menu-list .ako-menu__item {\n        min-height: 56px !important;\n        padding: 16px !important;\n        font-size: 15px !important;\n        gap: 10px !important;\n    }\n\n    .ako-item__left-icon {\n        width: 24px !important;\n        height: 24px !important;\n    }\n\n    /* 輸入框手機版 */\n    .ako-input {\n        height: 50px !important;\n        padding: 12px 16px !important;\n        font-size: 16px !important;\n        border-radius: 10px !important;\n    }\n    \n    .ako-label {\n        font-size: 12px !important;\n        margin-bottom: 6px !important;\n    }\n    \n    .ako-helper-text {\n        font-size: 11px !important;\n        margin-top: 6px !important;\n    }\n\n    .ako-company-invoice {\n        gap: 16px !important;\n    }\n\n    /* 核取方塊手機版 */\n    .ako-checkbox {\n        padding: 16px !important;\n        gap: 12px !important;\n        font-size: 13px !important;\n        border-radius: 10px !important;\n    }\n\n    .ako-checkmark {\n        width: 20px !important;\n        height: 20px !important;\n        border-radius: 4px !important;\n    }\n\n    /* 物流按鈕手機版 */\n    .akocommerce-logistics-button {\n        min-height: 90px !important;\n        padding: 16px !important;\n        border-radius: 10px !important;\n    }\n\n    .akocommerce-logistics-button__icon {\n        width: 40px !important;\n        height: 40px !important;\n        margin-bottom: 8px !important;\n    }\n\n    .akocommerce-logistics-button__icon svg {\n        width: 32px !important;\n        height: 22px !important;\n    }\n\n    .akocommerce-logistics-button div {\n        font-size: 12px !important;\n        line-height: 1.3 !important;\n    }\n\n    /* 超商按鈕手機版 */\n    .akocommerce-company-buttons {\n        flex-direction: column !important;\n        gap: 10px !important;\n    }\n    \n    .akocommerce-company-button {\n        width: 100% !important;\n        height: 70px !important;\n        padding: 14px !important;\n        border-radius: 10px !important;\n    }\n\n    .akocommerce-company-button img {\n        width: 36px !important;\n        height: 36px !important;\n    }\n\n    /* 結果區塊手機版 */\n    .akocommerce-result {\n        padding: 14px !important;\n        margin: 14px 0 !important;\n        border-radius: 10px !important;\n    }\n\n    .akocommerce-result::before {\n        height: 2px !important;\n    }\n    \n    .akocommerce-result-title {\n        font-size: 12px !important;\n        margin-bottom: 8px !important;\n    }\n    \n    .akocommerce-result-shop {\n        font-size: 14px !important;\n        margin-bottom: 6px !important;\n    }\n    \n    .akocommerce-result-shop:first-of-type {\n        font-size: 15px !important;\n    }\n\n    /* 警告和注意事項手機版 */\n    .akocommerce-warning {\n        padding: 12px 16px !important;\n        font-size: 13px !important;\n        border-radius: 6px !important;\n    }\n\n    .akocommerce-note {\n        font-size: 12px !important;\n        padding: 12px !important;\n        margin-top: 12px !important;\n    }\n\n    .akocommerce-description {\n        font-size: 13px !important;\n        margin-bottom: 20px !important;\n        line-height: 1.5 !important;\n    }\n}\n\n/* 超小手機 (380px) */\n@media (max-width: 380px) {\n    .ako-container {\n        padding: 0 10px !important;\n    }\n\n    .ako-invoice,\n    .ako-cvs-section {\n        padding: 16px 14px !important;\n    }\n\n    .ako-invoice-title,\n    .ako-cvs-title {\n        font-size: 17px !important;\n    }\n\n    .ako-menu-button {\n        padding: 14px !important;\n        font-size: 14px !important;\n    }\n\n    .ako-menu-list .ako-menu__item {\n        padding: 14px !important;\n        font-size: 14px !important;\n    }\n\n    .akocommerce-logistics-button {\n        padding: 14px !important;\n        min-height: 80px !important;\n    }\n\n    .akocommerce-company-button {\n        height: 65px !important;\n        padding: 12px !important;\n    }\n}\n\n/* 觸控設備優化 */\n@media (hover: none) and (pointer: coarse) {\n    /* 移除懸停效果，改用點擊效果 */\n    .ako-menu-button:active {\n        border-color: var(--primary-orange) !important;\n        transform: scale(0.98) !important;\n    }\n\n    .ako-menu-list .ako-menu__item:active {\n        background: rgba(255, 107, 53, 0.2) !important;\n    }\n\n    .akocommerce-logistics-button:active,\n    .akocommerce-company-button:active {\n        transform: scale(0.98) !important;\n    }\n\n    /* 增加觸控區域 */\n    .ako-menu-button,\n    .ako-menu-list .ako-menu__item,\n    .akocommerce-logistics-button,\n    .akocommerce-company-button,\n    .ako-checkbox {\n        -webkit-tap-highlight-color: rgba(255, 107, 53, 0.2) !important;\n        touch-action: manipulation !important;\n    }\n}\n\n/* 確保文字在小螢幕上可讀 */\n@media (max-width: 480px) {\n    body {\n        -webkit-text-size-adjust: 100% !important;\n        -ms-text-size-adjust: 100% !important;\n        text-size-adjust: 100% !important;\n    }\n}\n\n/* 動畫效果 */\n@keyframes fadeInUp {\n    from {\n        opacity: 0;\n        transform: translateY(20px);\n    }\n    to {\n        opacity: 1;\n        transform: translateY(0);\n    }\n}\n\n.ako-invoice,\n.ako-cvs-section {\n    animation: fadeInUp 0.6s ease-out !important;\n}\n\n.ako-cvs-section {\n    animation-delay: 0.1s !important;\n}\n\n.ako-company-invoice {\n    animation: fadeInUp 0.6s ease-out !important;\n    animation-delay: 0.2s !important;\n    animation-fill-mode: both !important;\n}\n\n.akocommerce-result {\n    animation: fadeInUp 0.6s ease-out !important;\n    animation-delay: 0.3s !important;\n    animation-fill-mode: both !important;\n}\n</style>\n\n<script>\n// 響應式 JavaScript 增強\ndocument.addEventListener('DOMContentLoaded', function() {\n    // 偵測裝置類型\n    const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);\n    const isTouch = 'ontouchstart' in window || navigator.maxTouchPoints > 0;\n\n    // 下拉選單響應式處理\n    const menuButtons = document.querySelectorAll('.ako-menu-button');\n    const menuLists = document.querySelectorAll('.ako-menu-list');\n\n    menuButtons.forEach((button, index) => {\n        const list = menuLists[index];\n        if (!list) return;\n\n        // 點擊事件處理\n        button.addEventListener('click', function(e) {\n            e.preventDefault();\n            e.stopPropagation();\n            \n            const isOpen = list.style.maxHeight && list.style.maxHeight !== '0px';\n            \n            // 關閉其他開啟的選單\n            menuLists.forEach((otherList, otherIndex) => {\n                if (otherIndex !== index) {\n                    otherList.style.maxHeight = '0px';\n                }\n            });\n\n            // 切換當前選單\n            if (isOpen) {\n                list.style.maxHeight = '0px';\n            } else {\n                // 計算實際高度\n                list.style.maxHeight = 'none';\n                const actualHeight = list.scrollHeight;\n                list.style.maxHeight = '0px';\n                \n                // 觸發重排\n                list.offsetHeight;\n                \n                // 設定動畫高度\n                list.style.maxHeight = actualHeight + 'px';\n            }\n        });\n    });\n\n    // 點擊外部關閉選單\n    document.addEventListener('click', function(e) {\n        if (!e.target.closest('.ako-menu')) {\n            menuLists.forEach(list => {\n                list.style.maxHeight = '0px';\n            });\n        }\n    });\n\n    // 選單項目點擊處理\n    const menuItems = document.querySelectorAll('.ako-menu__item');\n    menuItems.forEach(item => {\n        item.addEventListener('click', function(e) {\n            e.stopPropagation();\n            \n            // 更新按鈕顯示\n            const menu = this.closest('.ako-menu');\n            const button = menu.querySelector('.ako-menu-button');\n            const list = menu.querySelector('.ako-menu-list');\n            \n            if (button && list) {\n                // 更新按鈕內容\n                button.innerHTML = this.innerHTML + button.querySelector('.ako-menu-button__arrow').outerHTML;\n                \n                // 關閉選單\n                list.style.maxHeight = '0px';\n                \n                // 更新選中狀態\n                menuItems.forEach(mi => mi.classList.remove('selected'));\n                this.classList.add('selected');\n            }\n        });\n    });\n\n    // 視窗大小改變時的處理\n    let resizeTimer;\n    window.addEventListener('resize', function() {\n        clearTimeout(resizeTimer);\n        resizeTimer = setTimeout(function() {\n            // 重置所有選單高度\n            menuLists.forEach(list => {\n                if (list.style.maxHeight && list.style.maxHeight !== '0px') {\n                    list.style.maxHeight = list.scrollHeight + 'px';\n                }\n            });\n        }, 250);\n    });\n\n    // 觸控設備優化\n    if (isTouch) {\n        // 防止雙擊縮放\n        let lastTouchEnd = 0;\n        document.addEventListener('touchend', function(e) {\n            const now = Date.now();\n            if (now - lastTouchEnd <= 300) {\n                e.preventDefault();\n            }\n            lastTouchEnd = now;\n        }, false);\n\n        // 改善點擊反饋\n        const clickableElements = document.querySelectorAll(\n            '.ako-menu-button, .ako-menu__item, .akocommerce-logistics-button, ' +\n            '.akocommerce-company-button, .ako-checkbox, .ako-input'\n        );\n\n        clickableElements.forEach(element => {\n            element.addEventListener('touchstart', function() {\n                this.classList.add('touching');\n            });\n\n            element.addEventListener('touchend', function() {\n                setTimeout(() => {\n                    this.classList.remove('touching');\n                }, 100);\n            });\n        });\n    }\n\n    // 平滑滾動到結果\n    const observer = new MutationObserver(function(mutations) {\n        mutations.forEach(function(mutation) {\n            if (mutation.type === 'childList') {\n                const results = document.querySelectorAll('.akocommerce-result');\n                results.forEach(result => {\n                    if (!result.hasAttribute('data-scrolled')) {\n                        result.setAttribute('data-scrolled', 'true');\n                        \n                        // 延遲滾動以確保動畫完成\n                        setTimeout(() => {\n                            result.scrollIntoView({ \n                                behavior: 'smooth', \n                                block: 'center',\n                                inline: 'nearest'\n                            });\n                        }, 300);\n                    }\n                });\n            }\n        });\n    });\n\n    const akoSection = document.getElementById('akocommerce_cvs_section') || document.querySelector('.akoCvsScNS');\n    if (akoSection) {\n        observer.observe(akoSection, { \n            childList: true, \n            subtree: true \n        });\n    }\n});\n\n// 觸控狀態樣式\nconst touchStyles = document.createElement('style');\ntouchStyles.textContent = `\n    .touching {\n        opacity: 0.8 !important;\n        transform: scale(0.98) !important;\n    }\n`;\ndocument.head.appendChild(touchStyles);\n</script>\n</body>\n</html>",
