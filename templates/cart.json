le(1.1) !important;\n  /* filter: brightness(1.2) 已移除 */\n}\n\n/* ========================================\n   商品資訊單元格 - 往右移動\n   ======================================== */\n.cart-items__details {\n  width: auto !important; /* 自動寬度 */\n  padding: 20px 16px 20px 24px !important; /* 關鍵修復：增加左邊距 */\n  min-width: 350px !important; /* 增加最小寬度 */\n  max-width: none !important; /* 移除最大寬度限制 */\n}\n\n.cart-items__details p {\n  margin: 0 0 12px 0 !important;\n}\n\n/* 商品標題 */\n.cart-items__title {\n  font-size: 16px !important;\n  font-weight: 600 !important;\n  color: #ffffff !important;\n  text-decoration: none !important;\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;\n  position: relative !important;\n  display: inline-block !important;\n  line-height: 1.4 !important;\n  word-wrap: break-word !important; /* 允許換行 */\n  white-space: normal !important; /* 允許換行 */\n}\n\n/* 標題懸停效果 */\n.cart-items__title::after {\n  content: '' !important;\n  position: absolute !important;\n  bottom: -2px !important;\n  left: 0 !important;\n  width: 0 !important;\n  height: 2px !important;\n  background: linear-gradient(135deg, #ff6b35, #f7931e) !important;\n  transition: width 0.3s ease !important;\n}\n\n.cart-items__title:hover {\n  color: #ff6b35 !important;\n  text-shadow: 0 0 20px rgba(255, 107, 53, 0.5) !important;\n}\n\n.cart-items__title:hover::after {\n  width: 100% !important;\n}\n\n/* 商品規格 */\n.cart-items__variants {\n  margin: 8px 0 !important;\n}\n\n.cart-items__variant {\n  display: inline-block !important;\n  background: linear-gradient(135deg, #2a1810, #1a1a1a) !important;\n  padding: 4px 12px !important;\n  border-radius: 20px !important;\n  border: 1px solid #ff6b35 !important;\n  font-size: 12px !important;\n  margin: 4px 4px 4px 0 !important;\n}\n\n.cart-items__variant dt {\n  display: inline !important;\n  color: #888888 !important;\n  margin-right: 4px !important;\n}\n\n.cart-items__variant dd {\n  display: inline !important;\n  color: #e0e0e0 !important;\n  margin: 0 !important;\n}\n\n/* 單價 */\n.cart-items__details > div:last-child {\n  color: #cccccc !important;\n  font-size: 14px !important;\n  margin-top: 8px !important;\n}\n\n.cart-items__details > div:last-child span:last-child {\n  color: #ff6b35 !important;\n  font-weight: 600 !important;\n}\n\n/* ========================================\n   數量選擇器單元格 - 修復元素分配\n   ======================================== */\n.cart-items__quantity {\n  width: 200px !important; /* 增加寬度給數量選擇器更多空間 */\n  text-align: center !important;\n  padding: 20px 12px !important;\n}\n\n/* ========================================\n   數量選擇器容器 - 針對實際 HTML 結構\n   ======================================== */\nquantity-selector-component.quantity-selector.cart-primary-typography,\n.quantity-selector.cart-primary-typography quantity-selector-component {\n  display: flex !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n  background: linear-gradient(145deg, #2d2d2d, #1a1a1a) !important;\n  border: 2px solid #404040 !important;\n  border-radius: 12px !important;\n  overflow: hidden !important;\n  box-shadow: \n    0 4px 15px rgba(0, 0, 0, 0.3),\n    inset 0 1px 0 rgba(255, 255, 255, 0.05) !important;\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;\n  width: 160px !important;\n  height: 44px !important;\n  padding: 0 !important;\n  margin: 0 !important;\n  gap: 0 !important;\n  box-sizing: border-box !important;\n}\n\n/* 懸停效果 */\nquantity-selector-component.quantity-selector.cart-primary-typography:hover,\n.quantity-selector.cart-primary-typography quantity-selector-component:hover {\n  border-color: #ff6b35 !important;\n  box-shadow: \n    0 8px 25px rgba(255, 107, 53, 0.3),\n    inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;\n}\n\n/* ========================================\n   減少按鈕 - 針對實際 class 名稱\n   ======================================== */\nquantity-selector-component.quantity-selector.cart-primary-typography .button.quantity-minus.