確保最後一個td（價格）使用所有剩餘空間 */\n  .cart-items__table-row td:last-child {\n    width: auto !important;\n    white-space: nowrap !important;\n    padding-right: 12px !important;  /* 確保價格有足夠右邊距 */\n  }\n  \n  /* 特別針對 cart-secondary-typography 的價格區域 */\n  .cart-items__price.cart-secondary-typography {\n    display: block !important;\n    text-align: right !important;\n    padding-right: 8px !important;\n    width: 100% !important;\n    min-width: 90px !important;\n  }\n}\n\n/* ========================================\n   防止整體頁面溢出\n   ======================================== */\n@media (max-width: 768px) {\n  /* 防止body出現水平滾動 */\n  body {\n    overflow-x: hidden !important;\n  }\n  \n  /* 確保所有元素不會溢出 */\n  .cart-items__table * {\n    max-width: 100% !important;\n    box-sizing: border-box !important;\n  }\n  \n  /* 移除水平滾動條樣式（因為已經不需要） */\n  .cart-items.spacing-style.cart-items--dividers::-webkit-scrollbar {\n    display: none !important;\n  }\n  \n  /* 優化表格空間分配 */\n  .cart-items__table {\n    table-layout: auto !important;\n  }\n  \n  /* 確保商品資訊能自動調整以填充可用空間 */\n  .cart-items__table-row {\n    width: 100% !important;\n  }\n  \n  /* 強制所有td使用可用寬度 */\n  .cart-items__table-row td {\n    white-space: nowrap !important;\n  }\n  \n  .cart-items__table-row td.cart-items__details {\n    white-space: normal !important;\n    width: 100% !important;\n  }\n  \n  /* 確保價格單元格延伸到容器邊緣 */\n  .cart-items__table-row td:last-child {\n    padding-right: 8px !important;\n  }\n}\n\n/* ========================================\n   動畫效果\n   ======================================== */\n@keyframes fadeInUp {\n  from {\n    opacity: 0;\n    transform: translateY(20px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.cart-items__table-row {\n  animation: fadeInUp 0.6s ease-out !important;\n  animation-fill-mode: both !important;\n}\n\n.cart-items__table-row:nth-child(1) { animation-delay: 0.1s !important; }\n.cart-items__table-row:nth-child(2) { animation-delay: 0.2s !important; }\n.cart-items__table-row:nth-child(3) { animation-delay: 0.3s !important; }\n.cart-items__table-row:nth-child(4) { animation-delay: 0.4s !important; }\n.cart-items__table-row:nth-child(5) { animation-delay: 0.5s !important; }\n</style>"
