          "settings": {
            "custom_liquid": "<style>\n/* ========================================\n   購物車商品區塊 AKO 風格美化\n   針對 .cart-items.spacing-style.cart-items--dividers\n   模仿 #akocommerce_cvs_section 風格\n   版本: 4.8.1 - 移除圖片亮度效果版\n   ======================================== */\n\n/* ========================================\n   購物車商品標題區塊樣式 - 保持在容器內\n   ======================================== */\n.cart-products-header {\n  display: grid !important;\n  grid-template-columns: 1fr auto !important;\n  gap: 12px !important;\n  align-items: center !important;\n  margin-bottom: 12px !important;\n  padding: 0 !important;\n}\n\n.cart-products-title {\n  font-size: 18px !important;\n  font-weight: 600 !important;\n  color: #ffffff !important;\n  margin: 0 !important;\n  position: relative !important;\n  padding-left: 12px !important;\n  min-width: 0 !important;\n  overflow: hidden !important;\n  text-overflow: ellipsis !important;\n  white-space: nowrap !important;\n}\n\n.cart-products-title::before {\n  content: '' !important;\n  position: absolute !important;\n  left: 0 !important;\n  top: 50% !important;\n  transform: translateY(-50%) !important;\n  width: 3px !important;\n  height: 20px !important;\n  background: linear-gradient(135deg, #ff6b35, #f7931e) !important;\n  border-radius: 2px !important;\n}\n\n/* ========================================\n   主容器 - 仿 AKO 容器風格（灰色底色包覆）\n   ======================================== */\n.cart-items.spacing-style.cart-items--dividers {\n  background: linear-gradient(145deg, #1a1a1a, #2d2d2d) !important;\n  border-radius: 20px !important;\n  box-shadow: \n    0 25px 50px rgba(0, 0, 0, 0.5),\n    inset 0 1px 0 rgba(255, 255, 255, 0.1) !important;\n  border: 1px solid #333333 !important;\n  padding: 16px 20px !important;  /* 添加內距，與推薦區塊一致 */\n  margin: 20px auto !important;\n  overflow: hidden !important;\n  width: 100% !important;\n  max-width: 1200px !important;\n  box-sizing: border-box !important;\n  position: relative !important;\n  z-index: 1 !important;\n  will-change: transform !important;\n}\n\n/* 頂部橘色線條 - AKO 標誌 */\n.cart-items.spacing-style.cart-items--dividers::before {\n  content: '' !important;\n  position: absolute !important;\n  top: 0 !important;\n  left: 0 !important;\n  right: 0 !important;\n  height: 3px !important;\n  background: linear-gradient(90deg, #ff6b35, #f7931e) !important;\n  z-index: 10 !important;\n}\n\n/* 如果標題在容器內，為標題區塊添加上邊距 */\n.cart-items.spacing-style.cart-items--dividers .cart-products-header {\n  margin-top: 0 !important;\n  margin-bottom: 12px !important;\n}\n\n/* ========================================\n   表格樣式調整 - 適應新的內距\n   ======================================== */\n.cart-items__table {\n  width: 100% !important;\n  background: transparent !important;\n  border-collapse: collapse !important;\n  border-spacing: 0 !important;\n  table-layout: auto !important;\n  margin: 0 -20px !important;  /* 負 margin 讓表格延伸到容器邊緣 */\n  width: calc(100% + 40px) !important;  /* 補償負 margin */\n}\n\n/* ========================================\n   表格樣式重置 - 修復版\n   ======================================== */\n.cart-items__table {\n  width: 100% !important;\n  background: transparent !important;\n  border-collapse: collapse !important;\n  border-spacing: 0 !important;\n  table-layout: auto !important; /* 改為 auto 讓內容決定寬度 */\n  margin-top: 0 !important;  /* 確保表格緊貼容器頂部 */\n}\n\n.cart-items__table caption {\n  display: none !important;\n}\n\n.cart-items__table thead {\n  display: none !important;\n}\n\n.cart-items__table tbody {\n  display: table-row-group !important;\n}\n\n/* 如果有固定標題，為其預留空間 */\n.cart-items.spacing-style.cart-items--dividers.has-sticky-header {\n  padding-top: 40px !important;  /* 為固定標題預留空間 */\n}\n\n/* 固定標題樣式（如果存在） */\n.cart-items__header,\n.cart-header {\n  position: sticky !important;\n  top: 0 !important;\n  background: linear-gradient(145deg, #1a1a1a, #2d2d2d) !important;\n  z-index: 5 !important;\n  padding: 12px 20px !important;\n  border-bottom: 1px solid #333333 !important;\n  margin: 0 !important;\n}\n\n/* ========================================\n   桌面版表格寬度控制 - 重新設計\n   ======================================== */\n@media (min-width: 769px) {\n  .cart-items.spacing-style.cart-items--dividers {\n    max-width: 1200px !important;\n    margin: 20px auto !important;\n  }\n  \n  .cart-items__table {\n    table-layout: auto !important; /* 使用 auto 佈局 */\n    width: 100% !important;\n    min-width: 900px !important; /* 增加最小寬度 */\n  }\n  \n  /* 桌面版單元格寬度分配 - 重新調整 */\n  .cart-items__media {\n    width: 120px !important; /* 進一步減少圖片寬度 */\n    min-width: 120px !important;\n    max-width: 120px !important;\n  }\n  \n  .cart-items__details {\n    width: auto !important; /* 自動寬度 */\n    min-width: 350px !important; /* 增加文字區域最小寬度 */\n    padding-left: 24px !important; /* 關鍵修復：增加左邊距，讓文字區塊往右移 */\n  }\n  \n  .cart-items__quantity {\n    width: 200px !important; /* 增加數量選擇器寬度 */\n    min-width: 200px !important;\n    max-width: 200px !important;\n  }\n  \n  .cart-items__error {\n    width: 40px !important;\n    min-width: 40px !important;\n    max-width: 40px !important;\n  }\n  \n  .cart-items__price {\n    width: 150px !important;\n    min-width: 150px !important;\n    max-width: 150px !important;\n  }\n}\n\n/* ========================================\n   商品行 - 仿 AKO 項目樣式（表格結構）\n   ======================================== */\n.cart-items__table-row {\n  background: transparent !important;\n  border-bottom: 1px solid #333333 !important;\n  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;\n  position: relative !important;\n}\n\n.cart-items__table-row:last-child {\n  border-bottom: none !important;\n}\n\n/* 懸停效果 */\n.cart-items__table-row:hover {\n  background: linear-gradient(90deg, rgba(255, 107, 53, 0.05), rgba(247, 147, 30, 0.05)) !important;\n}\n\n/* 左側橘色指示條 */\n.cart-items__table-row::before {\n  content: '' !important;\n  position: absolute !important;\n  left: 16px !important;\n  top: 50% !important;\n  transform: translateY(-50%) !im