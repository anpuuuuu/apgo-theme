      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>APGO Coating vs Waxing Comparison</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            --primary-orange: #f08418;\n            --secondary-orange: #ff9a3c;\n            --bg-black: #000000;\n            --text-white: #ffffff;\n            --text-gray: #cccccc;\n        }\n\n        html, body {\n            overflow-x: hidden;\n            width: 100%;\n        }\n\n        body {\n            font-family: 'Arial', 'Microsoft JhengHei', sans-serif;\n            background: var(--bg-black);\n            color: var(--text-white);\n        }\n\n        /* 對比區塊 */\n        .comparison-section {\n            background: var(--bg-black);\n            padding: 60px 0;\n            width: 100%;\n            overflow: hidden;\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 16px;\n        }\n\n        /* 標題區域 */\n        .section-header {\n            text-align: center;\n            margin-bottom: 40px;\n        }\n\n        .section-title {\n            font-size: 2.5rem;\n            font-weight: bold;\n            background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            margin-bottom: 10px;\n        }\n\n        .section-subtitle {\n            font-size: 1.1rem;\n            color: var(--text-gray);\n        }\n\n        /* 對比容器 */\n        .comparison-wrapper {\n            background: rgba(255, 255, 255, 0.03);\n            border-radius: 20px;\n            border: 1px solid rgba(240, 132, 24, 0.2);\n            overflow: hidden;\n        }\n\n        /* 桌面版表格 */\n        .desktop-table {\n            display: table;\n            width: 100%;\n        }\n\n        .table-header {\n            display: table-row;\n            background: rgba(240, 132, 24, 0.1);\n        }\n\n        .header-cell {\n            display: table-cell;\n            padding: 20px;\n            text-align: center;\n            font-weight: bold;\n            font-size: 1.2rem;\n            border-bottom: 2px solid rgba(240, 132, 24, 0.3);\n        }\n\n        .header-cell:first-child {\n            text-align: left;\n            width: 40%;\n        }\n\n        .table-row {\n            display: table-row;\n            transition: background 0.3s ease;\n        }\n\n        .table-row:hover {\n            background: rgba(240, 132, 24, 0.05);\n        }\n\n        .table-cell {\n            display: table-cell;\n            padding: 20px;\n            text-align: center;\n            border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n            vertical-align: middle;\n        }\n\n        .table-cell:first-child {\n            text-align: left;\n            font-weight: 600;\n        }\n\n        .label-highlight {\n            display: inline-block;\n            width: 4px;\n            height: 16px;\n            background: var(--primary-orange);\n            border-radius: 2px;\n            margin-right: 10px;\n            vertical-align: middle;\n        }\n\n        /* 數值樣式 */\n        .value-number {\n            font-size: 1.3rem;\n            font-weight: bold;\n            display: block;\n            margin-bottom: 8px;\n        }\n\n        .wax-value {\n            color: var(--text-gray);\n        }\n\n        .coating-value {\n            color: var(--primary-orange);\n        }\n\n        /* 進度條 */\n        .comparison-bar {\n            width: 100%;\n            max-width: 120px;\n            height: 6px;\n            background: rgba(255, 255, 255, 0.1);\n            border-radius: 3px;\n            overflow: hidden;\n            margin: 0 auto;\n        }\n\n        .bar-fill {\n            height: 100%;\n            border-radius: 3px;\n            transition: width 1.5s ease;\n        }\n\n        .wax-bar {\n            background: #666666;\n        }\n\n        .coating-bar {\n            background: linear-gradient(90deg, var(--primary-orange), var(--secondary-orange));\n        }\n\n        /* 手機版表格 */\n        .mobile-table {\n            display: none;\n        }\n\n        .mobile-card {\n            background: rgba(255, 255, 255, 0.05);\n            border-radius: 12px;\n            padding: 16px;\n            margin-bottom: 12px;\n        }\n\n        .mobile-card-title {\n            font-weight: 600;\n            margin-bottom: 12px;\n            text-align: center;\n            font-size: 1rem;\n        }\n\n        .mobile-values {\n            display: flex;\n            gap: 12px;\n            width: 100%;\n        }\n\n        .mobile-value-item {\n            flex: 1;\n            text-align: center;\n            padding: 12px 8px;\n            background: rgba(0, 0, 0, 0.3);\n            border-radius: 8px;\n        }\n\n        .mobile-value-label {\n            font-size: 0.8rem;\n            color: var(--text-gray);\n            margin-bottom: 6px;\n        }\n\n        .mobile-value-number {\n            font-size: 1rem;\n            font-weight: bold;\n            margin-bottom: 6px;\n        }\n\n        /* CTA 區域 */\n        .cta-area {\n            text-align: center;\n            padding: 30px 20px;\n            background: rgba(240, 132, 24, 0.05);\n        }\n\n        .cta-text {\n            font-size: 1rem;\n            color: var(--text-gray);\n            margin-bottom: 16px;\n        }\n\n        .cta-button {\n            display: inline-block;\n            padding: 14px 36px;\n            background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange));\n            color: var(--text-white);\n      