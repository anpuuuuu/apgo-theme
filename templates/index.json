    "custom_liquid_hUDYDn": {
      "type": "custom-liquid",
      "name": "Homepage S8 Eng",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>APGO Brand Story</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            --primary-orange: #f08418;\n            --text-white: #ffffff;\n            --text-gray: #cccccc;\n            --dark-bg: #000000;\n        }\n\n        body {\n            font-family: 'Arial', 'Microsoft JhengHei', sans-serif;\n            background: var(--dark-bg);\n            color: var(--text-white);\n        }\n\n        /* Brand story main section */\n        .brand-story-section {\n            background: #000000;\n            padding: 100px 0;\n            position: relative;\n            overflow: hidden;\n        }\n\n        /* Background decorative effects */\n        .brand-story-section::before {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 800px;\n            height: 800px;\n            background: radial-gradient(circle, rgba(240, 132, 24, 0.05) 0%, transparent 70%);\n            animation: pulse 4s ease-in-out infinite;\n        }\n\n        @keyframes pulse {\n            0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; }\n            50% { transform: translate(-50%, -50%) scale(1.2); opacity: 0.8; }\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 20px;\n            position: relative;\n            z-index: 1;\n        }\n\n        /* Title area */\n        .story-header {\n            text-align: center;\n            margin-bottom: 80px;\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        @keyframes fadeInUp {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .story-title {\n            font-size: 3rem;\n            font-weight: bold;\n            margin-bottom: 20px;\n            background: linear-gradient(45deg, #f08418, #ff9a3c);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .story-subtitle {\n            font-size: 1.2rem;\n            color: var(--text-gray);\n            max-width: 600px;\n            margin: 0 auto;\n            line-height: 1.6;\n        }\n\n        /* Timeline design */\n        .timeline {\n            position: relative;\n            max-width: 900px;\n            margin: 0 auto;\n            padding: 20px 0;\n        }\n\n        /* Central vertical line */\n        .timeline::before {\n            content: '';\n            position: absolute;\n            top: 0;\n            left: 50%;\n            transform: translateX(-50%);\n            width: 3px;\n            height: 100%;\n            background: linear-gradient(to bottom, \n                transparent 0%, \n                var(--primary-orange) 20%, \n                #ff9a3c 80%, \n                transparent 100%\n            );\n        }\n\n        /* Timeline items */\n        .timeline-item {\n            position: relative;\n            padding: 40px 0;\n            opacity: 0;\n            animation: fadeIn 0.8s ease forwards;\n        }\n\n        .timeline-item:nth-child(1) { animation-delay: 0.2s; }\n        .timeline-item:nth-child(2) { animation-delay: 0.3s; }\n        .timeline-item:nth-child(3) { animation-delay: 0.4s; }\n        .timeline-item:nth-child(4) { animation-delay: 0.5s; }\n        .timeline-item:nth-child(5) { animation-delay: 0.6s; }\n        .timeline-item:nth-child(6) { animation-delay: 0.7s; }\n        .timeline-item:nth-child(7) { animation-delay: 0.8s; }\n        .timeline-item:nth-child(8) { animation-delay: 0.9s; }\n\n        @keyframes fadeIn {\n            to { opacity: 1; }\n        }\n\n        /* Content cards */\n        .timeline-content {\n            position: relative;\n            width: 45%;\n            padding: 30px;\n            background: radial-gradient(circle at top right, rgba(240, 132, 24, 0.1), rgba(0, 0, 0, 0.9) 56%);\n            border-radius: 20px;\n            border: 1px solid rgba(240, 132, 24, 0.34);\n            box-shadow: 0 0 24px rgba(240, 132, 24, 0.18);\n            transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;\n        }\n\n        /* Alternating left-right layout */\n        .timeline-item:nth-child(odd) .timeline-content {\n            margin-left: auto;\n            transform: translateX(30px);\n            opacity: 0;\n            animation: slideInRight 0.8s ease forwards;\n        }\n\n        .timeline-item:nth-child(even) .timeline-content {\n            transform: translateX(-30px);\n            opacity: 0;\n            animation: slideInLeft 0.8s ease forwards;\n        }\n\n        .timeline-item:nth-child(1) .timeline-content { animation-delay: 0.2s; }\n        .timeline-item:nth-child(2) .timeline-content { animation-delay: 0.3s; }\n        .timeline-item:nth-child(3) .timeline-content { animation-delay: 0.4s; }\n        .timeline-item:nth-child(4) .timeline-content { animation-delay: 0.5s; }\n        .timeline-item:nth-child(5) .timeline-content { animation-delay: 0.6s; }\n        .timeline-item:nth-child(6) .timeline-content { animation-delay: 0.7s; }\n        .timeline-item:nth-child(7) .timeline-content { animation-delay: 0.8s; }\n        .timeline-item:nth-child(8) .timeline-content { animation-delay: 0.9s; }\n\n        @keyframes slideInLeft {\n            to {\n                opacity: 1;\n                transform: translateX(0);\n            }\n        }\n\n        @keyframes slideInRight {\n            to {\n                opacity: 1;\n                transform: translateX(0);\n            }\n        }\n\n        /* Hover effects */\n        .timeline-content:hover {\n            transform: translateY(-4px) scale(1.015);\n            box-shadow: 0 0 34px rgba(240, 132, 24, 0.32);\n            border-color: rgba(240, 132, 24, 0.7);\n        }\n\n        /* Timeline dot circles */\n        .timeline-dot {\n            position: absolute;\n            top: 50px;\n            left: 50%;\n            transform: translateX(-50%);\n            width: 24px;\n            height: 24px;\n            background: var(--primary-orange);\n            border: 4px solid var(--dark-bg);\n            border-radius: 50%;\n            box-shadow: 0 0 30px rgba(240, 132, 24, 0.6);\n            z-index: 2;\n            animation: glow 2s ease-in-out infinite;\n        }\n\n        @keyframes glow {\n            0%, 100% { box-shadow: 0 0 30px rgba(240, 132, 24, 0.6); }\n            50% { box-shadow: 0 0 50px rgba(240, 132, 24, 0.9); }\n        }\n\n        /* Connecting lines */\n        .timeline-item::after {\n            content: '';\n            position: absolute;\n            top: 62px;\n            width: 50%;\n            height: 2px;\n            background: rgba(240, 132, 24, 0.3);\n        }\n\n        .timeline-item:nth-child(odd)::after {\n            left: 0;\n            right: 50%;\n        }\n\n        .timeline-item:nth-child(even)::after {\n            left: 50%;\n            right: 0;\n        }\n\n        /* Year titles */\n        .timeline-year {\n            font-size: 2rem;\n            font-weight: bold;\n            color: var(--primary-orange);\n            margin-bottom: 15px;\n            position: relative;\n            display: inline-block;\n        }\n\n        /* Year decorations */\n        .timeline-year::after {\n            content: '';\n            position: absolute;\n            bottom: -5px;\n            left: 0;\n            width: 50px;\n            height: 3px;\n            background: linear-gradient(90deg, var(--primary-orange), transparent);\n            border-radius: 2px;\n        }\n\n        /* Milestone titles */\n        .milestone-title {\n            font-size: 1.3rem;\n            font-weight: bold;\n            color: var(--text-white);\n            margin-bottom: 12px;\n        }\n\n        /* Description text */\n        .timeline-text {\n            color: var(--text-gray);\n            line-height: 1.8;\n            font-size: 1rem;\n        }\n\n        /* Icons */\n        .timeline-icon {\n            position: absolute;\n            top: 20px;\n            right: 20px;\n            font-size: 2rem;\n            opacity: 0.3;\n        }\n\n        /* Bottom decorative line */\n        .decorative-line {\n            width: 100px;\n            height: 2px;\n            background: linear-gradient(90deg, transparent, var(--primary-orange), transparent);\n            margin: 80px auto 0;\n            opacity: 0;\n            animation: fadeIn 1s ease 1.2s forwards;\n        }\n\n        /* Responsive design */\n        @media (max-width: 768px) {\n            .brand-story-section {\n                padding: 60px 0;\n            }\n\n            .story-title {\n                font-size: 2rem;\n            }\n\n            .story-subtitle {\n                font-size: 1rem;\n                padding: 0 20px;\n            }\n\n            .timeline::before {\n                left: 40px;\n            }\n\n            .timeline-item {\n                padding: 30px 0;\n            }\n\n            .timeline-content {\n                width: calc(100% - 80px);\n                margin-left: 80px !important;\n                transform: none !important;\n                padding: 25px;\n            }\n\n            .timeline-dot {\n                left: 40px;\n            }\n\n            .timeline-item::after {\n                display: none;\n            }\n\n            .timeline-year {\n                font-size: 1.5rem;\n            }\n\n            .milestone-title {\n                font-size: 1.1rem;\n            }\n\n            .timeline-text {\n                font-size: 0.9rem;\n            }\n\n            .timeline-icon {\n                display: none;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .timeline::before {\n                left: 30px;\n            }\n\n            .timeline-content {\n                width: calc(100% - 60px);\n                margin-left: 60px !important;\n                padding: 20px;\n            }\n\n            .timeline-dot {\n                left: 30px;\n                width: 20px;\n                height: 20px;\n            }\n        }\n    </style>\n</head>\n<body>\n    <section class=\"brand-story-section\">\n        <div class=\"container\">\n            <!-- Title Area -->\n            <div class=\"story-header\">\n                <h2 class=\"story-title\">APGO Brand Story</h2>\n                <p class=\"story-subtitle\">From electronics manufacturing leader to coating brand pioneer - 17 years of innovation</p>\n            </div>\n\n            <!-- Timeline -->\n            <div class=\"timeline\">\n                <!-- 2007 -->\n                <div class=\"timeline-item\">\n                    <div class=\"timeline-content\">\n                        <span class=\"timeline-icon\">💻</span>\n                        <div class=\"timeline-year\">2007</div>\n                        <h3 class=\"milestone-title\">Electronics Development Foundation</h3>\n                        <p class=\"timeline-text\">\n                            Started with electronics development and dashcam OEM manufacturing. The founder accumulated ten years of R&D and manufacturing experience, becoming the driving force behind Taiwan's major well-known brands, establishing the foundation of quality dedication.\n                        </p>\n                    </div>\n                    <div class=\"timeline-dot\"></div>\n                </div>\n\n                <!-- 2011 -->\n                <div class=\"timeline-item\">\n                    <div class=\"timeline-content\">\n                        <span class=\"timeline-icon\">🏭</span>\n                        <div class=\"timeline-year\">2011</div>\n                        <h3 class=\"milestone-title\">Established Dashcam Factory</h3>\n                        <p class=\"timeline-text\">\n                            Built professional factory with ISO9001 certification, providing one-stop service from design to production. Gained favor from major manufacturers like ADATA, Sampo, Asustek, and Patriot, even undertaking orders from Singapore's Ministry of Defense.\n                        </p>\n                    </div>\n                    <div class=\"timeline-dot\"></div>\n                </div>\n\n                <!-- 2014 -->\n                <div class=\"timeline-item\">\n                    <div class=\"timeline-content\">\n                        <span class=\"timeline-icon\">🚗</span>\n                        <div class=\"timeline-year\">2014</div>\n                        <h3 class=\"milestone-title\">Developed First Generation Car Wash Coating</h3>\n                        <p class=\"timeline-text\">\n                            From a car enthusiast's perspective, the founder began developing car wash coating products. Hoping to enable everyone to care for their beloved cars themselves, experience the joy of DIY, and stop wasting money unnecessarily.\n                        </p>\n                    </div>\n                    <div class=\"timeline-dot\"></div>\n                </div>\n\n                <!-- 2017 -->\n                <div class=\"timeline-item\">\n                    <div class=\"timeline-content\">\n                        <span class=\"timeline-icon\">🚀</span>\n                        <div class=\"timeline-year\">2017</div>\n                        <h3 class=\"milestone-title\">APGO Brand Born</h3>\n                        <p class=\"timeline-text\">\n                            APGO was officially born named after the founder! Adhering to the strict standards of electronics manufacturing, all production materials and processes undergo rigorous quality control, aspiring to become Taiwan's largest coating production factory.\n                        </p>\n                    </div>\n                    <div class=\"timeline-dot\"></div>\n                </div>\n\n                <!-- 2019 -->\n                <div class=\"timeline-item\">\n                    <div class=\"timeline-content\">\n                        <span class=\"timeline-icon\">🌏</span>\n                        <div class=\"timeline-year\">2019</div>\n                        <h3 class=\"milestone-title\">Entered International Markets</h3>\n                        <p class=\"timeline-text\">\n                            First generation water coating officially launched, while establishing Malaysian company to expand into Southeast Asian markets. From Taiwan to the world, letting more people experience APGO's quality products.\n                        </p>\n                    </div>\n                    <div class=\"timeline-dot\"></div>\n                </div>\n\n                <!-- 2021 -->\n                <div class=\"timeline-item\">\n                    <div class=\"timeline-content\">\n                        <span class=\"timeline-icon\">⭐</span>\n                        <div class=\"timeline-year\">2021</div>\n                        <h3 class=\"milestone-title\">Complete Product Upgrade</h3>\n                        <p class=\"timeline-text\">\n                            Second generation atomic coating series fully upgraded, adding preparation work and interior care series. Same year established Singapore company and received strong recommendations from famous KOLs Cool and Joeman.\n                        </p>\n                    </div>\n                    <div class=\"timeline-dot\"></div>\n                </div>\n\n                <!-- 2022 -->\n                <div class=\"timeline-item\">\n                    <div class=\"timeline-content\">\n                        <span class=\"timeline-icon\">🏆</span>\n                        <div class=\"timeline-year\">2022</div>\n                        <h3 class=\"milestone-title\">Media Recognition & Endorsement</h3>\n                        <p class=\"timeline-text\">\n                            Famous automotive show host Liao Ying-ting strongly recommended, and famous KOL Liao Lao-da collaborated to launch atomic glaze. Brand influence continues to expand, becoming a leading brand in the automotive beauty industry.\n                        </p>\n                    </div>\n                    <div class=\"timeline-dot\"></div>\n                </div>\n\n                <!-- 2024 -->\n                <div class=\"timeline-item\">\n                    <div class=\"timeline-content\">\n                        <span class=\"timeline-icon\">🚀</span>\n                        <div class=\"timeline-year\">2024</div>\n                        <h3 class=\"milestone-title\">Sales Milestone</h3>\n                        <p class=\"timeline-text\">\n                            Annual sales exceeded 50,000 sets, becoming a well-known coating brand in Southeast Asia. From novice housewives to professional coating enthusiasts, everyone can easily get started, bringing automotive beauty into every household.\n                        </p>\n                    </div>\n                    <div class=\"timeline-dot\"></div>\n                </div>\n            </div>\n\n            <!-- Decorative Line -->\n            <div class=\"decorative-line\"></div>\n        </div>\n    </section>\n\n    <script>\n        // Scroll-triggered animations\n        const observerOptions = {\n            threshold: 0.2,\n            rootMargin: '0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    entry.target.style.opacity = '1';\n                    entry.target.style.transform = 'translateY(0)';\n                }\n            });\n        }, observerOptions);\n\n        // Observe all elements that need animation\n        document.addEventListener('DOMContentLoaded', () => {\n            const animatedElements = document.querySelectorAll('.timeline-item, .story-header');\n            animatedElements.forEach(el => {\n                observer.observe(el);\n            });\n        });\n\n        // Parallax scrolling effect\n        window.addEventListener('scroll', () => {\n            const scrolled = window.pageYOffset;\n            const section = document.querySelector('.brand-story-section');\n            \n            if (section) {\n                const rect = section.getBoundingClientRect();\n                if (rect.top < window.innerHeight && rect.bottom > 0) {\n                    const parallaxSpeed = 0.3;\n                    const yPos = -(scrolled * parallaxSpeed);\n                    section.style.backgroundPosition = `center ${yPos}px`;\n                }\n            }\n        });\n    </script>\n</body>\n</html>",
