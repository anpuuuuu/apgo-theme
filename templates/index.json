      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"zh-TW\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>APGO Live Streaming Performance Data Section</title>\n    <style>\n        /* Basic Reset and Variables */\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            --primary-orange: #f08418;\n            --secondary-dark: #374151;\n            --dark-bg: #1a1a1a;\n            --darker-bg: #0f0f0f;\n            --text-white: #ffffff;\n            --text-gray: #cccccc;\n            --text-light-gray: #b0b0b0;\n            --gradient-bg: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);\n            --orange-gradient: linear-gradient(45deg, #f08418, #ff9a3c);\n        }\n\n        body {\n            font-family: 'Arial', 'Microsoft JhengHei', sans-serif;\n            background: #000000;\n            color: var(--text-white);\n        }\n\n        /* Second Section: Live Streaming Performance Data */\n        .livestream-section {\n            background: #000000;\n            padding: 100px 0;\n            position: relative;\n            overflow: hidden;\n        }\n\n        /* Background Dynamic Glow Effect */\n        .livestream-section::before {\n            content: '';\n            position: absolute;\n            top: -50%;\n            right: -50%;\n            width: 200%;\n            height: 200%;\n            background: radial-gradient(circle, rgba(240, 132, 24, 0.05) 0%, transparent 70%);\n            animation: rotate 30s linear infinite;\n            pointer-events: none;\n        }\n\n        @keyframes rotate {\n            from { transform: rotate(0deg); }\n            to { transform: rotate(360deg); }\n        }\n\n        .livestream-container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 20px;\n            position: relative;\n            z-index: 1;\n        }\n\n        /* Title Area */\n        .livestream-header {\n            text-align: center;\n            margin-bottom: 60px;\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        @keyframes fadeInUp {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .livestream-title {\n            font-size: 2.5rem;\n            font-weight: bold;\n            background: var(--orange-gradient);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n            margin-bottom: 15px;\n        }\n\n        .livestream-subtitle {\n            font-size: 1.2rem;\n            color: var(--text-gray);\n        }\n\n        /* Team Images Area */\n        .team-showcase {\n            margin-bottom: 60px;\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease 0.2s forwards;\n            width: 100%;\n            max-width: 100%;\n        }\n\n        /* Tab Buttons */\n        .team-tabs {\n            display: flex;\n            justify-content: center;\n            gap: 20px;\n            margin-top: 30px;\n        }\n\n        .tab-button {\n            display: flex;\n            align-items: center;\n            gap: 10px;\n            padding: 12px 30px;\n            background: rgba(255, 255, 255, 0.05);\n            border: 2px solid rgba(240, 132, 24, 0.3);\n            border-radius: 50px;\n            color: var(--text-gray);\n            font-size: 1rem;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            backdrop-filter: blur(10px);\n        }\n\n        .tab-button:hover {\n            background: rgba(240, 132, 24, 0.1);\n            border-color: var(--primary-orange);\n            color: var(--text-white);\n            transform: translateY(-2px);\n        }\n\n        .tab-button.active {\n            background: var(--orange-gradient);\n            border-color: transparent;\n            color: var(--text-white);\n        }\n\n        .tab-icon {\n            font-size: 1.5rem;\n        }\n\n        /* Image Container - Modified to Portrait */\n        .team-images {\n            position: relative;\n            width: 100%;\n            max-width: 400px;\n            margin: 0 auto;\n            height: 600px;\n            border-radius: 20px;\n            overflow: hidden;\n            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);\n        }\n\n        .team-image-wrapper {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            opacity: 0;\n            transform: translateX(100px);\n            transition: all 0.5s ease;\n        }\n\n        .team-image-wrapper.active {\n            opacity: 1;\n            transform: translateX(0);\n        }\n\n        /* Use Colors Instead of Images */\n        .team-image {\n            width: 100%;\n            height: 100%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            font-size: 2rem;\n            font-weight: bold;\n            color: rgba(255, 255, 255, 0.8);\n            position: relative;\n            overflow: hidden;\n        }\n\n        /* Video Styles */\n        .team-video {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            position: absolute;\n            top: 0;\n            left: 0;\n            z-index: 1;\n        }\n\n        .taiwan-team {\n            background: linear-gradient(135deg, #e74c3c, #c0392b);\n        }\n\n        .sg-my-team {\n            background: linear-gradient(135deg, #3498db, #2980b9);\n        }\n\n        /* Hearts Container */\n        .hearts-container {\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            pointer-events: none;\n            overflow: hidden;\n            z-index: 2;\n        }\n\n        /* Heart Styles */\n        .heart {\n            position: absolute;\n            bottom: -50px;\n            right: 30px;\n            width: 20px;\n            height: 20px;\n            background-color: var(--heart-color, #ff6b6b);\n            transform: rotate(-45deg);\n            animation-timing-function: ease-in-out;\n            opacity: 0.9;\n        }\n\n        .heart::before,\n        .heart::after {\n            content: \"\";\n            position: absolute;\n            width: 20px;\n            height: 20px;\n            background-color: var(--heart-color, #ff6b6b);\n            border-radius: 50%;\n        }\n\n        .heart::before {\n            top: -10px;\n            left: 0;\n        }\n\n        .heart::after {\n            top: 0;\n            left: 10px;\n        }\n\n        /* Hearts with Different Colors */\n        .heart-red { --heart-color: #ff6b6b; }\n        .heart-pink { --heart-color: #ff69b4; }\n        .heart-orange { --heart-color: #ffa726; }\n        .heart-yellow { --heart-color: #ffeb3b; }\n        .heart-purple { --heart-color: #ba68c8; }\n\n        /* Different Floating Paths */\n        @keyframes floatPath1 {\n            0% {\n                bottom: -50px;\n                transform: rotate(-45deg) scale(0) translateX(0);\n                opacity: 0;\n            }\n            10% {\n                opacity: 0.9;\n                transform: rotate(-45deg) scale(1) translateX(0);\n            }\n            30% {\n                transform: rotate(-45deg) scale(1) translateX(-20px);\n            }\n            50% {\n                transform: rotate(-45deg) scale(1) translateX(10px);\n            }\n            70% {\n                transform: rotate(-45deg) scale(1) translateX(-30px);\n            }\n            90% {\n                opacity: 0.9;\n                transform: rotate(-45deg) scale(1) translateX(0);\n            }\n            100% {\n                bottom: 40%;\n                opacity: 0;\n                transform: rotate(-45deg) scale(0.8) translateX(-15px);\n            }\n        }\n\n        @keyframes floatPath2 {\n            0% {\n                bottom: -50px;\n                transform: rotate(-45deg) scale(0) translateX(0);\n                opacity: 0;\n            }\n            10% {\n                opacity: 0.9;\n                transform: rotate(-45deg) scale(1) translateX(0);\n            }\n            25% {\n                transform: rotate(-45deg) scale(1) translateX(15px);\n            }\n            45% {\n                transform: rotate(-45deg) scale(1) translateX(-25px);\n            }\n            65% {\n                transform: rotate(-45deg) scale(1) translateX(20px);\n            }\n            85% {\n                opacity: 0.9;\n                transform: rotate(-45deg) scale(1) translateX(-10px);\n            }\n            100% {\n                bottom: 40%;\n                opacity: 0;\n                transform: rotate(-45deg) scale(0.8) translateX(25px);\n            }\n        }\n\n        @keyframes floatPath3 {\n            0% {\n                bottom: -50px;\n                transform: rotate(-45deg) scale(0) translateX(0);\n                opacity: 0;\n            }\n            10% {\n                opacity: 0.9;\n                transform: rotate(-45deg) scale(1) translateX(0);\n            }\n            20% {\n                transform: rotate(-45deg) scale(1) translateX(-15px);\n            }\n            40% {\n                transform: rotate(-45deg) scale(1) translateX(-5px);\n            }\n            60% {\n                transform: rotate(-45deg) scale(1) translateX(-25px);\n            }\n            80% {\n                opacity: 0.9;\n                transform: rotate(-45deg) scale(1) translateX(-10px);\n            }\n            100% {\n                bottom: 40%;\n                opacity: 0;\n                transform: rotate(-45deg) scale(0.8) translateX(-20px);\n            }\n        }\n\n        @keyframes floatPath4 {\n            0% {\n                bottom: -50px;\n                transform: rotate(-45deg) scale(0) translateX(0);\n                opacity: 0;\n            }\n            10% {\n                opacity: 0.9;\n                transform: rotate(-45deg) scale(1) translateX(0);\n            }\n            35% {\n                transform: rotate(-45deg) scale(1) translateX(25px);\n            }\n            55% {\n                transform: rotate(-45deg) scale(1) translateX(5px);\n            }\n            75% {\n                transform: rotate(-45deg) scale(1) translateX(30px);\n            }\n            90% {\n                opacity: 0.9;\n                transform: rotate(-45deg) scale(1) translateX(15px);\n            }\n            100% {\n                bottom: 40%;\n                opacity: 0;\n                transform: rotate(-45deg) scale(0.8) translateX(10px);\n            }\n        }\n\n        /* Apply Different Paths */\n        .heart-path-1 { animation: floatPath1 4.5s ease-in-out forwards; }\n        .heart-path-2 { animation: floatPath2 4.8s ease-in-out forwards; }\n        .heart-path-3 { animation: floatPath3 4.2s ease-in-out forwards; }\n        .heart-path-4 { animation: floatPath4 5s ease-in-out forwards; }\n\n        /* Glowing Border Effect */\n        .team-images::before {\n            content: '';\n            position: absolute;\n            top: -2px;\n            left: -2px;\n            right: -2px;\n            bottom: -2px;\n            background: linear-gradient(45deg, #f08418, #ff9a3c, #f08418);\n            background-size: 300% 300%;\n            border-radius: 20px;\n            z-index: -1;\n            animation: borderGlow 3s ease-in-out infinite;\n            opacity: 0.6;\n        }\n\n        @keyframes borderGlow {\n            0%, 100% { background-position: 0% 50%; }\n            50% { background-position: 100% 50%; }\n        }\n\n        /* Data Display Area - Single Row Layout */\n        .stats-showcase {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            gap: 60px;\n            margin-bottom: 60px;\n            flex-wrap: wrap;\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease 0.4s forwards;\n        }\n\n        .stat-item {\n            text-align: center;\n            position: relative;\n            padding: 20px;\n        }\n\n        .stat-value {\n            font-size: 3.5rem;\n            font-weight: bold;\n            color: var(--primary-orange);\n            line-height: 1;\n            margin-bottom: 10px;\n            display: flex;\n            align-items: baseline;\n            justify-content: center;\n            gap: 10px;\n            font-family: 'Arial', monospace;\n        }\n\n        .stat-unit {\n            font-size: 1.8rem;\n            color: var(--text-white);\n            font-weight: normal;\n        }\n\n        .stat-label {\n            font-size: 1rem;\n            color: var(--text-gray);\n            font-weight: 600;\n        }\n\n        /* Special Handling for First Item Unit */\n        .stat-label .stat-unit {\n            color: var(--text-gray);\n            font-size: 1rem;\n            font-weight: 600;\n        }\n\n        /* Flag Carousel Effect */\n        .country-carousel {\n            width: 60px;\n            height: 60px;\n            overflow: hidden;\n            position: relative;\n            margin: 0 auto;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n        }\n\n        .country-track {\n            display: flex;\n            animation: scrollFlags 12s linear infinite;\n            width: 360px; /* 6 flags x 60px */\n        }\n\n        .country-flag {\n            font-size: 3rem;\n            line-height: 60px;\n            width: 60px;\n            text-align: center;\n            flex-shrink: 0;\n            display: inline-block;\n        }\n\n        @keyframes scrollFlags {\n            0% {\n                transform: translateX(0);\n            }\n            100% {\n                transform: translateX(-180px); /* Move 3 flags distance */\n            }\n        }\n\n        /* Dynamic Light Effect */\n        .stat-item::before {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            width: 120%;\n            height: 120%;\n            background: radial-gradient(circle, rgba(240, 132, 24, 0.2) 0%, transparent 70%);\n            opacity: 0;\n            transition: opacity 0.3s ease;\n            pointer-events: none;\n            border-radius: 50%;\n        }\n\n        .stat-item:hover::before {\n            opacity: 1;\n        }\n\n        /* CTA Area */\n        .trust-cta-section {\n            text-align: center;\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease 0.6s forwards;\n        }\n\n        /* CTA Button */\n        .cta-container {\n            margin-top: 30px;\n        }\n\n        .cta-button {\n            display: inline-block;\n            padding: 18px 50px;\n            background: linear-gradient(45deg, var(--primary-orange), #ff9a3c);\n            color: var(--text-white);\n            text-decoration: none;\n            font-size: 1.2rem;\n            font-weight: bold;\n            border-radius: 50px;\n            transition: all 0.3s ease;\n            position: relative;\n            overflow: hidden;\n            box-shadow: 0 4px 15px rgba(240, 132, 24, 0.3);\n        }\n\n        .cta-button::before {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            width: 0;\n            height: 0;\n            background: rgba(255, 255, 255, 0.3);\n            border-radius: 50%;\n            transform: translate(-50%, -50%);\n            transition: width 0.6s ease, height 0.6s ease;\n        }\n\n        .cta-button:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 10px 30px rgba(240, 132, 24, 0.4);\n        }\n\n        .cta-button:hover::before {\n            width: 300px;\n            height: 300px;\n        }\n\n        /* Number Animation */\n        .counting {\n            animation: countPulse 0.3s ease;\n        }\n\n        @keyframes countPulse {\n            0% { transform: scale(1); }\n            50% { transform: scale(1.05); }\n            100% { transform: scale(1); }\n        }\n\n        /* Responsive Design */\n        @media (max-width: 1024px) {\n            .stats-showcase {\n                gap: 40px;\n            }\n\n            .stat-value {\n                font-size: 3rem;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .livestream-section {\n                padding: 60px 0;\n            }\n\n            .livestream-title {\n                font-size: 1.8rem;\n                margin-bottom: 10px;\n            }\n\n            .livestream-subtitle {\n                font-size: 0.95rem;\n            }\n\n            .livestream-header {\n                margin-bottom: 40px;\n            }\n\n            .team-showcase {\n                margin-bottom: 30px;\n                padding: 0;\n            }\n\n            .team-tabs {\n                gap: 10px;\n            }\n\n            .tab-button {\n                padding: 10px 20px;\n                font-size: 0.9rem;\n            }\n\n            .tab-icon {\n                font-size: 1.2rem;\n            }\n\n            .team-images {\n                height: 600px;\n                max-width: 95%;\n            }\n\n            /* Mobile Heart Adjustments */\n            .heart {\n                width: 18px;\n                height: 18px;\n                right: 20px;\n            }\n\n            .heart::before,\n            .heart::after {\n                width: 18px;\n                height: 18px;\n            }\n\n            .heart::before {\n                top: -9px;\n            }\n\n            .heart::after {\n                left: 9px;\n            }\n\n            /* Mobile Data Display Area - Keep Single Row */\n            .stats-showcase {\n                display: flex;\n                justify-content: center;\n                align-items: center;\n                gap: 15px;\n                flex-wrap: nowrap;\n                padding: 20px 10px;\n            }\n\n            .stat-item {\n                flex: 0 1 auto;\n                padding: 10px 8px;\n                text-align: center;\n            }\n\n            .stat-value {\n                font-size: 2.5rem;\n                gap: 5px;\n            }\n\n            .stat-unit {\n                font-size: 1.3rem;\n            }\n\n            .stat-label {\n                font-size: 1rem;\n                white-space: nowrap;\n            }\n\n            /* Special Handling for First Item Unit */\n            .stat-label .stat-unit {\n                font-size: 1rem;\n            }\n\n            .cta-button {\n                padding: 12px 30px;\n                font-size: 1rem;\n            }\n        }\n\n        @media (max-width: 480px) {\n            .team-images {\n                height: 650px;\n                max-width: 95%;\n            }\n\n            .stats-showcase {\n                gap: 10px;\n                padding: 15px 10px;\n            }\n\n            .stat-item {\n                padding: 5px 5px;\n            }\n\n            .stat-value {\n                font-size: 2rem;\n                gap: 3px;\n            }\n\n            .stat-unit {\n                font-size: 1.1rem;\n            }\n\n            .stat-label {\n                font-size: 0.85rem;\n                white-space: nowrap;\n                line-height: 1.2;\n            }\n\n            /* Special Handling for First Item Unit */\n            .stat-label .stat-unit {\n                font-size: 0.85rem;\n            }\n\n            /* Adjustments for Specific Data */\n            .stat-number[data-target=\"5000000\"] {\n                font-size: 1.8rem;\n            }\n\n            .country-carousel {\n                width: 50px;\n                height: 50px;\n            }\n\n            .country-track {\n                width: 300px; /* 6 flags x 50px */\n            }\n\n            .country-flag {\n                font-size: 2.5rem;\n                line-height: 50px;\n                width: 50px;\n            }\n\n            @keyframes scrollFlags {\n                0% {\n                    transform: translateX(0);\n                }\n                100% {\n                    transform: translateX(-150px); /* Move 3 flags distance */\n                }\n            }\n\n            .tab-button {\n                padding: 8px 15px;\n                font-size: 0.85rem;\n            }\n\n            .tab-icon {\n                display: none;\n            }\n\n            .heart {\n                width: 16px;\n                height: 16px;\n                right: 15px;\n            }\n\n            .heart::before,\n            .heart::after {\n                width: 16px;\n                height: 16px;\n            }\n\n            .heart::before {\n                top: -8px;\n            }\n\n            .heart::after {\n                left: 8px;\n            }\n        }\n\n        /* Extra Small Screen Optimization */\n        @media (max-width: 360px) {\n            .stat-value {\n                font-size: 1.8rem;\n            }\n\n            .stat-unit {\n                font-size: 1rem;\n            }\n\n            .stat-label {\n                font-size: 0.8rem;\n            }\n\n            /* Special Handling for First Item Unit */\n            .stat-label .stat-unit {\n                font-size: 0.8rem;\n            }\n\n            .stat-number[data-target=\"5000000\"] {\n                font-size: 1.6rem;\n            }\n\n            .country-carousel {\n                width: 45px;\n                height: 45px;\n            }\n\n            .country-track {\n                width: 270px; /* 6 flags x 45px */\n            }\n\n            .country-flag {\n                font-size: 2rem;\n                line-height: 45px;\n                width: 45px;\n            }\n\n            @keyframes scrollFlags {\n                0% {\n                    transform: translateX(0);\n                }\n                100% {\n                    transform: translateX(-135px); /* Move 3 flags distance */\n                }\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Second Section: Live Streaming Performance Data -->\n    <section class=\"livestream-section\">\n        <div class=\"livestream-container\">\n            <!-- Title Area -->\n            <div class=\"livestream-header\">\n                <h2 class=\"livestream-title\">Cross-border Live Streaming, Quality Witnessed by All</h2>\n                <p class=\"livestream-subtitle\">Authentic presentation is the most direct guarantee for customers</p>\n            </div>\n\n            <!-- Team Images Showcase Area -->\n            <div class=\"team-showcase\">\n                <!-- Image Container -->\n                <div class=\"team-images\">\n                    <div class=\"team-image-wrapper active\" id=\"taiwan-team\">\n                        <div class=\"team-image taiwan-team\">\n                            <video \n                                class=\"team-video\"\n                                src=\"https://cdn.shopify.com/videos/c/o/v/9a0fa6d2993b468b9f3b3ecc48056039.mp4\"\n                                autoplay\n                                muted\n                                playsinline\n                                poster=\"\">\n                            </video>\n                            <!-- Hearts Container -->\n                            <div class=\"hearts-container\" id=\"taiwan-hearts\"></div>\n                        </div>\n                    </div>\n                    <div class=\"team-image-wrapper\" id=\"sg-my-team\">\n                        <div class=\"team-image sg-my-team\">\n                            <video \n                                class=\"team-video\"\n                                src=\"https://cdn.shopify.com/videos/c/o/v/4ddb944f1ef94ed4bf6a6f3fe93a0a6c.mp4\"\n                                autoplay\n                                muted\n                                playsinline\n                                poster=\"\">\n                            </video>\n                            <!-- Hearts Container -->\n                            <div class=\"hearts-container\" id=\"sg-my-hearts\"></div>\n                        </div>\n                    </div>\n                </div>\n\n                <!-- Tab Buttons -->\n                <div class=\"team-tabs\">\n                    <button class=\"tab-button active\" data-team=\"taiwan\">\n                        <span class=\"tab-icon\">🇹🇼</span>\n                        <span>Taiwan Team</span>\n                    </button>\n                    <button class=\"tab-button\" data-team=\"sg-my\">\n                        <span class=\"tab-icon\">🇸🇬🇲🇾</span>\n                        <span>Singapore/Malaysia Team</span>\n                    </button>\n                </div>\n            </div>\n\n            <!-- Data Display Area - Single Row Layout -->\n            <div class=\"stats-showcase\">\n                <div class=\"stat-item\">\n                    <div class=\"stat-value\">\n                        <span class=\"stat-number\" data-target=\"5000000\">0</span>\n                    </div>\n                    <div class=\"stat-label\">\n                        <span class=\"stat-unit\">Units</span>Annual Sales\n                    </div>\n                </div>\n\n                <div class=\"stat-item\">\n                    <div class=\"stat-value\">\n                        <div class=\"country-carousel\">\n                            <div class=\"country-track\">\n                                <span class=\"country-flag\">🇹🇼</span>\n                                <span class=\"country-flag\">🇸🇬</span>\n                                <span class=\"country-flag\">🇲🇾</span>\n                                <span class=\"country-flag\">🇹🇼</span>\n                                <span class=\"country-flag\">🇸🇬</span>\n                                <span class=\"country-flag\">🇲🇾</span>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"stat-label\">Stable Sales Countries</div>\n                </div>\n\n                <div class=\"stat-item\">\n                    <div class=\"stat-value\">\n                        <span class=\"stat-number\" data-target=\"10\">0</span>\n                        <span class=\"stat-unit\">Years</span>\n                    </div>\n                    <div class=\"stat-label\">Live Streaming Experience</div>\n                </div>\n\n                <div class=\"stat-item\">\n                    <div class=\"stat-value\">\n                        <span class=\"stat-number\" data-target=\"30\">0</span>\n                        <span class=\"stat-unit\">People</span>\n                    </div>\n                    <div class=\"stat-label\">Professional Streamers</div>\n                </div>\n            </div>\n\n            <!-- CTA -->\n            <div class=\"trust-cta-section\">\n                <div class=\"cta-container\">\n                    <a href=\"https://apgo.tw/pages/buy_atomic_coating\" target=\"_self\" class=\"cta-button\" onclick=\"window.location.href='https://apgo.tw/pages/buy_atomic_coating'; return false;\">Learn More</a>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <script>\n        // Function to create hearts\n        function createHeart(container) {\n            const heart = document.createElement('div');\n            const colors = ['heart-red', 'heart-pink', 'heart-orange', 'heart-yellow', 'heart-purple'];\n            const paths = ['heart-path-1', 'heart-path-2', 'heart-path-3', 'heart-path-4'];\n            const randomColor = colors[Math.floor(Math.random() * colors.length)];\n            const randomPath = paths[Math.floor(Math.random() * paths.length)];\n            \n            heart.className = `heart ${randomColor} ${randomPath}`;\n            \n            // Fixed on the right side with slight random offset\n            const randomOffset = Math.random() * 10 - 5; // -5 to +5 offset\n            heart.style.right = (30 + randomOffset) + 'px';\n            \n            // Random size\n            const randomScale = 0.85 + Math.random() * 0.3;\n            heart.style.transform = `rotate(-45deg) scale(${randomScale})`;\n            \n            // Random animation duration (add variation)\n            const randomDuration = 4 + Math.random() * 2;\n            heart.style.animationDuration = randomDuration + 's';\n            \n            container.appendChild(heart);\n            \n            // Remove after animation ends\n            setTimeout(() => {\n                heart.remove();\n            }, randomDuration * 1000);\n        }\n\n        // Continuously generate hearts\n        function startHeartAnimation() {\n            const activeWrapper = document.querySelector('.team-image-wrapper.active');\n            if (activeWrapper) {\n                const heartsContainer = activeWrapper.querySelector('.hearts-container');\n                if (heartsContainer) {\n                    createHeart(heartsContainer);\n                }\n            }\n        }\n\n        // Generate hearts at intervals\n        let heartInterval = setInterval(startHeartAnimation, 800);\n\n        // Tab switching functionality\n        function initTabSwitching() {\n            const tabButtons = document.querySelectorAll('.tab-button');\n            const teamImages = document.querySelectorAll('.team-image-wrapper');\n            const taiwanVideo = document.querySelector('#taiwan-team .team-video');\n            const sgMyVideo = document.querySelector('#sg-my-team .team-video');\n\n            // Manual switching functionality\n            tabButtons.forEach(button => {\n                button.addEventListener('click', function() {\n                    // Remove all active classes\n                    tabButtons.forEach(btn => btn.classList.remove('active'));\n                    teamImages.forEach(img => img.classList.remove('active'));\n\n                    // Add active class to clicked button\n                    this.classList.add('active');\n\n                    // Show corresponding image\n                    const teamType = this.dataset.team;\n                    const targetImage = document.getElementById(`${teamType}-team`);\n                    if (targetImage) {\n                        targetImage.classList.add('active');\n                    }\n\n                    // Pause inactive video, play active video\n                    if (teamType === 'taiwan') {\n                        taiwanVideo.play();\n                        sgMyVideo.pause();\n                        sgMyVideo.currentTime = 0;\n                    } else {\n                        sgMyVideo.play();\n                        taiwanVideo.pause();\n                        taiwanVideo.currentTime = 0;\n                    }\n                });\n            });\n\n            // Auto switching functionality - when Taiwan video ends\n            if (taiwanVideo) {\n                taiwanVideo.addEventListener('ended', function() {\n                    // Switch to Singapore/Malaysia team\n                    const sgMyButton = document.querySelector('[data-team=\"sg-my\"]');\n                    const taiwanButton = document.querySelector('[data-team=\"taiwan\"]');\n                    \n                    // Update button status\n                    taiwanButton.classList.remove('active');\n                    sgMyButton.classList.add('active');\n                    \n                    // Switch videos\n                    document.getElementById('taiwan-team').classList.remove('active');\n                    document.getElementById('sg-my-team').classList.add('active');\n                    \n                    // Play Singapore/Malaysia video\n                    sgMyVideo.currentTime = 0;\n                    sgMyVideo.play();\n                });\n            }\n\n            // When Singapore/Malaysia video ends, switch back to Taiwan video\n            if (sgMyVideo) {\n                sgMyVideo.addEventListener('ended', function() {\n                    // Switch back to Taiwan team\n                    const sgMyButton = document.querySelector('[data-team=\"sg-my\"]');\n                    const taiwanButton = document.querySelector('[data-team=\"taiwan\"]');\n                    \n                    // Update button status\n                    sgMyButton.classList.remove('active');\n                    taiwanButton.classList.add('active');\n                    \n                    // Switch videos\n                    document.getElementById('sg-my-team').classList.remove('active');\n                    document.getElementById('taiwan-team').classList.add('active');\n                    \n                    // Play Taiwan video\n                    taiwanVideo.currentTime = 0;\n                    taiwanVideo.play();\n                });\n            }\n        }\n\n        // Number animation\n        function animateNumbers() {\n            const numbers = document.querySelectorAll('.stat-number');\n            \n            numbers.forEach((number, index) => {\n                const target = parseInt(number.getAttribute('data-target'));\n                const duration = 2000;\n                const increment = target / (duration / 16);\n                let current = 0;\n                \n                // Delayed start to create sequential animation effect\n                setTimeout(() => {\n                    const updateNumber = () => {\n                        current += increment;\n                        if (current < target) {\n                            number.textContent = formatNumber(Math.floor(current));\n                            number.classList.add('counting');\n                            setTimeout(() => number.classList.remove('counting'), 100);\n                            requestAnimationFrame(updateNumber);\n                        } else {\n                            number.textContent = formatNumber(target);\n                        }\n                    };\n                    updateNumber();\n                }, index * 200);\n            });\n        }\n\n        // Format numbers (add thousands separator)\n        function formatNumber(num) {\n            if (num >= 1000000) {\n                return Math.floor(num / 1000) + 'K';\n            } else if (num >= 1000) {\n                return (num / 1000).toFixed(0) + 'K';\n            }\n            return num.toString().replace(/\\B(?=(\\d{3})+(?!\\d))/g, ',');\n        }\n\n        // Intersection Observer to monitor elements entering viewport\n        const observerOptions = {\n            threshold: 0.3,\n            rootMargin: '0px'\n        };\n\n        const observer = new IntersectionObserver((entries) => {\n            entries.forEach(entry => {\n                if (entry.isIntersecting) {\n                    animateNumbers();\n                    observer.disconnect();\n                }\n            });\n        }, observerOptions);\n\n        // Start observing\n        document.addEventListener('DOMContentLoaded', () => {\n            initTabSwitching();\n            \n            const section = document.querySelector('.stats-showcase');\n            if (section) {\n                observer.observe(section);\n            }\n        });\n\n        // CTA button ripple effect\n        document.querySelector('.cta-button').addEventListener('click', function(e) {\n            const ripple = document.createElement('span');\n            const rect = this.getBoundingClientRect();\n            const size = Math.max(rect.width, rect.height);\n            const x = e.clientX - rect.left - size / 2;\n            const y = e.clientY - rect.top - size / 2;\n            \n            ripple.style.cssText = `\n                position: absolute;\n                width: ${size}px;\n                height: ${size}px;\n                border-radius: 50%;\n                background: rgba(255, 255, 255, 0.5);\n                left: ${x}px;\n                top: ${y}px;\n                pointer-events: none;\n                transform: scale(0);\n                animation: rippleEffect 0.6s ease-out;\n            `;\n            \n            this.appendChild(ripple);\n            setTimeout(() => ripple.remove(), 600);\n        });\n\n        // Add ripple animation styles\n        const style = document.createElement('style');\n        style.textContent = `\n            @keyframes rippleEffect {\n                to {\n                    transform: scale(4);\n                    opacity: 0;\n                }\n            }\n        `;\n        document.head.appendChild(style);\n\n        // Clean up timer (when page closes)\n        window.addEventListener('beforeunload', () => {\n            clearInterval(heartInterval);\n        });\n    </script>\n</body>\n</html>",
