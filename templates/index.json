    "custom_liquid_jMHpAt": {
      "type": "custom-liquid",
      "name": "Homepage S1 Eng",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n    <html lang=\"en\">\n    <head>\n        <meta charset=\"UTF-8\">\n        <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n        <title>APGO - Professional Coating Experts</title>\n        <style>\n            * {\n                margin: 0;\n                padding: 0;\n                box-sizing: border-box;\n            }\n    \n            :root {\n                --primary-orange: #f08418;\n                --text-white: #ffffff;\n                --text-gray: #cccccc;\n                --text-light-gray: #b0b0b0;\n            }\n    \n            body {\n                font-family: 'Arial', 'Microsoft JhengHei', sans-serif;\n                background: #000000;\n                color: var(--text-white);\n                overflow-x: hidden;\n            }\n    \n            /* Hero Section */\n            .hero-section {\n                position: relative;\n                width: 100%;\n                height: 100vh;\n                min-height: 600px;\n                overflow: hidden;\n                display: flex;\n                align-items: center;\n                background: #000000;\n            }\n    \n            /* Background Image Container */\n            .hero-background {\n                position: absolute;\n                top: 0;\n                left: 0;\n                width: 100%;\n                height: 100%;\n                z-index: 1;\n            }\n    \n            .hero-image {\n                width: 100%;\n                height: 100%;\n                object-fit: cover;\n                object-position: center right;\n                filter: brightness(0.85) contrast(1.1);\n                transform: scale(1.05);\n                animation: slowZoom 20s ease-in-out infinite alternate;\n            }\n    \n            @keyframes slowZoom {\n                0% { transform: scale(1.05); }\n                100% { transform: scale(1.1); }\n            }\n    \n            /* Gradient Overlay - Ensure Text Area Clarity */\n            .hero-overlay {\n                position: absolute;\n                top: 0;\n                left: 0;\n                width: 100%;\n                height: 100%;\n                background: linear-gradient(\n                    90deg, \n                    rgba(0, 0, 0, 0.85) 0%, \n                    rgba(0, 0, 0, 0.4) 40%, \n                    rgba(0, 0, 0, 0.1) 70%, \n                    transparent 100%\n                );\n                z-index: 2;\n            }\n    \n            /* Dynamic Particle Effects */\n            .floating-particles {\n                position: absolute;\n                top: 0;\n                left: 0;\n                width: 100%;\n                height: 100%;\n                z-index: 3;\n                pointer-events: none;\n            }\n    \n            .particle {\n                position: absolute;\n                width: 3px;\n                height: 3px;\n                background: var(--primary-orange);\n                border-radius: 50%;\n                opacity: 0.8;\n                box-shadow: 0 0 6px var(--primary-orange);\n                animation: float 12s infinite linear;\n            }\n    \n            .particle:nth-child(1) { left: 5%; animation-delay: 0s; }\n            .particle:nth-child(2) { left: 15%; animation-delay: 2s; }\n            .particle:nth-child(3) { left: 25%; animation-delay: 4s; }\n            .particle:nth-child(4) { left: 8%; animation-delay: 6s; }\n            .particle:nth-child(5) { left: 18%; animation-delay: 8s; }\n            .particle:nth-child(6) { left: 12%; animation-delay: 1s; }\n            .particle:nth-child(7) { left: 22%; animation-delay: 3s; }\n            .particle:nth-child(8) { left: 6%; animation-delay: 5s; }\n            .particle:nth-child(9) { left: 28%; animation-delay: 7s; }\n            .particle:nth-child(10) { left: 14%; animation-delay: 9s; }\n            .particle:nth-child(11) { left: 10%; animation-delay: 1.5s; }\n            .particle:nth-child(12) { left: 20%; animation-delay: 3.5s; }\n            .particle:nth-child(13) { left: 30%; animation-delay: 5.5s; }\n            .particle:nth-child(14) { left: 4%; animation-delay: 7.5s; }\n            .particle:nth-child(15) { left: 16%; animation-delay: 9.5s; }\n            .particle:nth-child(16) { left: 26%; animation-delay: 0.5s; }\n            .particle:nth-child(17) { left: 9%; animation-delay: 2.5s; }\n            .particle:nth-child(18) { left: 19%; animation-delay: 4.5s; }\n            .particle:nth-child(19) { left: 13%; animation-delay: 6.5s; }\n            .particle:nth-child(20) { left: 23%; animation-delay: 8.5s; }\n    \n            @keyframes float {\n                0% {\n                    transform: translateY(100vh) scale(0);\n                    opacity: 0;\n                }\n                10% {\n                    opacity: 0.6;\n                    transform: scale(1);\n                }\n                90% {\n                    opacity: 0.6;\n                    transform: scale(1);\n                }\n                100% {\n                    transform: translateY(-10vh) scale(0);\n                    opacity: 0;\n                }\n            }\n    \n            /* Main Content Container */\n            .hero-content {\n                position: relative;\n                z-index: 4;\n                max-width: 1200px;\n                margin: 0 auto;\n                padding: 0 40px;\n                width: 100%;\n                height: 100%;\n                display: flex;\n                align-items: center;\n            }\n    \n            /* Text Content Area */\n            .content-wrapper {\n                max-width: 600px;\n                opacity: 0;\n                transform: translateX(-50px);\n                animation: slideInLeft 1.2s ease 0.5s forwards;\n            }\n    \n            @keyframes slideInLeft {\n                to {\n                    opacity: 1;\n                    transform: translateX(0);\n                }\n            }\n    \n            /* Brand Logo */\n            .brand-logo {\n                margin-bottom: 20px;\n                opacity: 0;\n                transform: translateY(20px);\n                animation: fadeInUp 0.8s ease 0.8s forwards;\n            }\n    \n            .brand-logo img {\n                height: 60px;\n                width: auto;\n                max-width: 200px;\n                object-fit: contain;\n                filter: brightness(1.1) contrast(1.1);\n                transition: all 0.3s ease;\n            }\n    \n            .brand-logo img:hover {\n                filter: brightness(1.2) contrast(1.2);\n                transform: scale(1.05);\n            }\n    \n            /* Main Title */\n            .hero-title {\n                font-size: 3.5rem;\n                font-weight: bold;\n                line-height: 1.2;\n                margin-bottom: 30px;\n                color: var(--text-white);\n                opacity: 0;\n                transform: translateY(30px);\n                animation: fadeInUp 0.8s ease 1s forwards;\n            }\n    \n            .title-highlight {\n                color: var(--primary-orange);\n                position: relative;\n                display: inline-block;\n            }\n    \n            .title-highlight::after {\n                content: '';\n                position: absolute;\n                bottom: -5px;\n                left: 0;\n                width: 0;\n                height: 3px;\n                background: linear-gradient(90deg, var(--primary-orange), #ff9a3c);\n                animation: underlineExpand 1s ease 1.5s forwards;\n            }\n    \n            @keyframes underlineExpand {\n                to { width: 100%; }\n            }\n    \n            /* Subtitle */\n            .hero-subtitle {\n                font-size: 1.3rem;\n                color: var(--text-gray);\n                line-height: 1.6;\n                margin-bottom: 40px;\n                opacity: 0;\n                transform: translateY(20px);\n                animation: fadeInUp 0.8s ease 1.2s forwards;\n            }\n    \n            .subtitle-highlight {\n                color: var(--primary-orange);\n                font-weight: 600;\n            }\n    \n            @keyframes fadeInUp {\n                to {\n                    opacity: 1;\n                    transform: translateY(0);\n                }\n            }\n    \n            /* CTA Button */\n            .cta-container {\n                opacity: 0;\n                transform: translateY(20px);\n                animation: fadeInUp 0.8s ease 1.4s forwards;\n            }\n    \n            .cta-button {\n                display: inline-block;\n                background: linear-gradient(45deg, var(--primary-orange), #ff9a3c);\n                color: var(--text-white);\n                text-decoration: none;\n                padding: 18px 40px;\n                border-radius: 50px;\n                font-size: 1.2rem;\n                font-weight: bold;\n                letter-spacing: 1px;\n                transition: all 0.3s ease;\n                position: relative;\n                overflow: hidden;\n                box-shadow: 0 8px 25px rgba(240, 132, 24, 0.3);\n                border: 2px solid transparent;\n            }\n    \n            .cta-button::before {\n                content: '';\n                position: absolute;\n                top: 50%;\n                left: 50%;\n                width: 0;\n                height: 0;\n                background: rgba(255, 255, 255, 0.2);\n                border-radius: 50%;\n                transform: translate(-50%, -50%);\n                transition: width 0.6s ease, height 0.6s ease;\n            }\n    \n            .cta-button:hover {\n                transform: translateY(-3px);\n                box-shadow: 0 12px 35px rgba(240, 132, 24, 0.4);\n                border-color: rgba(255, 255, 255, 0.3);\n            }\n    \n            .cta-button:hover::before {\n                width: 300px;\n                height: 300px;\n            }\n    \n            .cta-button span {\n                position: relative;\n                z-index: 1;\n            }\n    \n            /* Responsive Design */\n            @media (max-width: 1024px) {\n                .hero-content {\n                    padding: 0 30px;\n                }\n    \n                .brand-logo img {\n                    height: 50px;\n                    max-width: 180px;\n                }\n    \n                .hero-title {\n                    font-size: 2.8rem;\n                }\n    \n                .hero-subtitle {\n                    font-size: 1.1rem;\n                }\n            }\n    \n            @media (max-width: 768px) {\n                .hero-section {\n                    min-height: 500px;\n                    height: 80vh;\n                }\n    \n                .hero-content {\n                    padding: 0 20px;\n                }\n    \n                .content-wrapper {\n                    max-width: 100%;\n                }\n    \n                .brand-logo {\n                    margin-bottom: 20px;\n                }\n    \n                .brand-logo img {\n                    height: 45px;\n                    max-width: 150px;\n                }\n    \n                .hero-title {\n                    font-size: 2.1rem;\n                    margin-bottom: 18px;\n                    line-height: 1.1;\n                }\n    \n                .hero-subtitle {\n                    font-size: 1rem;\n                    margin-bottom: 30px;\n                    line-height: 1.4;\n                }\n    \n                .cta-button {\n                    padding: 15px 32px;\n                    font-size: 1rem;\n                }\n    \n                /* Mobile particle effects adjustment */\n                .particle {\n                    width: 2px;\n                    height: 2px;\n                    opacity: 0.9;\n                    box-shadow: 0 0 4px var(--primary-orange);\n                }\n    \n                /* Adjust image position to ensure vehicle visibility */\n                .hero-image {\n                    object-position: center center;\n                }\n    \n                .hero-overlay {\n                    background: linear-gradient(\n                        180deg, \n                        rgba(0, 0, 0, 0.7) 0%, \n                        rgba(0, 0, 0, 0.3) 50%, \n                        rgba(0, 0, 0, 0.8) 100%\n                    );\n                }\n    \n            }\n    \n            @media (max-width: 480px) {\n                .hero-section {\n                    min-height: 450px;\n                    height: 75vh;\n                }\n    \n                .brand-logo {\n                    margin-bottom: 18px;\n                }\n    \n                .brand-logo img {\n                    height: 40px;\n                    max-width: 130px;\n                }\n    \n                .hero-title {\n                    font-size: 1.9rem;\n                    margin-bottom: 15px;\n                }\n    \n                .hero-subtitle {\n                    font-size: 0.9rem;\n                    margin-bottom: 25px;\n                }\n    \n                .cta-button {\n                    padding: 13px 28px;\n                    font-size: 0.9rem;\n                }\n    \n            }\n    \n            /* High Resolution Display Optimization */\n            @media (min-width: 1920px) {\n                .hero-content {\n                    max-width: 1400px;\n                }\n    \n                .brand-logo img {\n                    height: 70px;\n                    max-width: 220px;\n                }\n    \n                .hero-title {\n                    font-size: 4rem;\n                }\n    \n                .hero-subtitle {\n                    font-size: 1.5rem;\n                }\n            }\n        </style>\n    </head>\n    <body>\n        <section class=\"hero-section\">\n            <!-- 背景圖片 -->\n            <div class=\"hero-background\">\n                <img \n                    src=\"https://cdn.shopify.com/s/files/1/0760/8002/1755/files/fa6f8da217907f3de717e871bebef875.png?v=1750353188\" \n                    alt=\"APGO Professional Car Coating\" \n                    class=\"hero-image\"\n                />\n            </div>\n    \n            <!-- 漸層遮罩 -->\n            <div class=\"hero-overlay\"></div>\n    \n            <!-- 動態光點效果 -->\n            <div class=\"floating-particles\">\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n                <div class=\"particle\"></div>\n            </div>\n    \n            <!-- 主要內容 -->\n            <div class=\"hero-content\">\n                <div class=\"content-wrapper\">\n                    <div class=\"brand-logo\">\n                        <img \n                            src=\"https://cdn.shopify.com/s/files/1/0760/8002/1755/files/logo.png?v=1749123901\" \n                            alt=\"APGO Professional Coating Experts\"\n                        />\n                    </div>\n                    \n                    <h1 class=\"hero-title\">\n                        We specialize in <span class=\"title-highlight\">coating</span>\n                    </h1>\n                    \n                    <p class=\"hero-subtitle\">\n                        Because it's <span class=\"subtitle-highlight\">easier</span>, <span class=\"subtitle-highlight\">more durable</span>, and <span class=\"subtitle-highlight\">shinier</span> than waxing\n                    </p>\n                    \n                    <div class=\"cta-container\">\n                        <a href=\"https://apgo.my/collections/atomic-coating-series\" target=\"_self\" class=\"cta-button\" onclick=\"window.location.href='https://apgo.my/collections/atomic-coating-series'; return false;\">\n                            <span>Shop Your Perfect Coating Now</span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n    \n        </section>\n    \n        <script>\n            // Parallax effect\n            window.addEventListener('scroll', function() {\n                const scrolled = window.pageYOffset;\n                const heroImage = document.querySelector('.hero-image');\n                const parallaxSpeed = 0.5;\n                if (heroImage && scrolled < window.innerHeight) {\n                    heroImage.style.transform = `scale(1.05) translateY(${scrolled * parallaxSpeed}px)`;\n                }\n            });\n    \n            // Preload next section content (if exists)\n            window.addEventListener('load', function() {\n                // Preload images to improve user experience\n                const nextSectionImages = document.querySelectorAll('img[data-src]');\n                nextSectionImages.forEach(img => {\n                    const observer = new IntersectionObserver((entries, observer) => {\n                        entries.forEach(entry => {\n                            if (entry.isIntersecting) {\n                                const img = entry.target;\n                                img.src = img.dataset.src;\n                                img.removeAttribute('data-src');\n                                observer.unobserve(img);\n                            }\n                        });\n                    });\n                    observer.observe(img);\n                });\n            });\n        </script>\n    </body>\n    </html>",
