        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Why Choose APGO</title>\n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n\n        :root {\n            --primary-orange: #f08418;\n            --text-white: #ffffff;\n            --text-gray: #cccccc;\n            --dark-bg: #000000;\n        }\n\n        body {\n            font-family: 'Arial', 'Microsoft JhengHei', sans-serif;\n            background: var(--dark-bg);\n            color: var(--text-white);\n        }\n\n        /* Main Section */\n        .why-apgo-section {\n            background: #000000;\n            padding: 100px 0;\n            position: relative;\n            overflow: hidden;\n        }\n\n        /* Background Animation Effect */\n        .why-apgo-section::before {\n            content: '';\n            position: absolute;\n            top: -50%;\n            left: -50%;\n            width: 200%;\n            height: 200%;\n            background: radial-gradient(circle at 30% 50%, rgba(240, 132, 24, 0.1) 0%, transparent 50%);\n            animation: breathe 8s ease-in-out infinite;\n        }\n\n        @keyframes breathe {\n            0%, 100% { transform: scale(1); opacity: 0.5; }\n            50% { transform: scale(1.1); opacity: 0.8; }\n        }\n\n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 0 20px;\n            position: relative;\n            z-index: 1;\n        }\n\n        /* Header Section */\n        .section-header {\n            text-align: center;\n            margin-bottom: 80px;\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease forwards;\n        }\n\n        @keyframes fadeInUp {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        .main-title {\n            font-size: 3rem;\n            font-weight: bold;\n            margin-bottom: 20px;\n            background: linear-gradient(45deg, #f08418, #ff9a3c);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n            background-clip: text;\n        }\n\n        .subtitle {\n            font-size: 1.3rem;\n            color: var(--text-gray);\n            max-width: 700px;\n            margin: 0 auto;\n            line-height: 1.6;\n        }\n\n        /* Core Features - Large Image Background Cards */\n        .core-features {\n            display: grid;\n            grid-template-columns: repeat(2, 1fr);\n            gap: 30px;\n            margin-bottom: 80px;\n        }\n\n        .feature-card {\n            position: relative;\n            height: 400px;\n            border-radius: 20px;\n            overflow: hidden;\n            cursor: pointer;\n            opacity: 0;\n            transform: translateY(50px);\n            animation: slideUp 0.8s ease forwards;\n        }\n\n        .feature-card:nth-child(1) { animation-delay: 0.1s; }\n        .feature-card:nth-child(2) { animation-delay: 0.2s; }\n        .feature-card:nth-child(3) { animation-delay: 0.3s; }\n        .feature-card:nth-child(4) { animation-delay: 0.4s; }\n\n        @keyframes slideUp {\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n\n        /* Image Background (using gradients instead of actual images) */\n        .feature-bg {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            transition: transform 0.5s ease;\n        }\n\n        .lab-bg {\n            background: linear-gradient(135deg, #1a237e 0%, #3949ab 100%);\n        }\n\n        .factory-bg {\n            background: linear-gradient(135deg, #b71c1c 0%, #e53935 100%);\n        }\n\n        .tech-bg {\n            background: linear-gradient(135deg, #f57c00 0%, #ff9800 100%);\n        }\n\n        .quality-bg {\n            background: linear-gradient(135deg, #2e7d32 0%, #43a047 100%);\n        }\n\n        .feature-card:hover .feature-bg {\n            transform: scale(1.1);\n        }\n\n        /* Content Overlay */\n        .feature-content {\n            position: absolute;\n            bottom: 0;\n            left: 0;\n            right: 0;\n            padding: 40px 30px;\n            background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.7) 70%, transparent 100%);\n            transform: translateY(20px);\n            transition: transform 0.3s ease;\n        }\n\n        .feature-card:hover .feature-content {\n            transform: translateY(0);\n        }\n\n        .feature-icon {\n            font-size: 3rem;\n            margin-bottom: 15px;\n            color: var(--primary-orange);\n        }\n\n        .feature-title {\n            font-size: 1.5rem;\n            font-weight: bold;\n            margin-bottom: 10px;\n            color: var(--text-white);\n        }\n\n        .feature-desc {\n            font-size: 0.95rem;\n            color: var(--text-gray);\n            line-height: 1.5;\n        }\n\n        /* Statistics Display Bar */\n        .stats-bar {\n            background: rgba(255, 255, 255, 0.05);\n            backdrop-filter: blur(10px);\n            border-radius: 20px;\n            padding: 40px;\n            display: flex;\n            justify-content: space-around;\n            align-items: center;\n            border: 1px solid rgba(255, 255, 255, 0.1);\n            margin-bottom: 80px;\n            opacity: 0;\n            transform: translateY(30px);\n            animation: fadeInUp 0.8s ease 0.5s forwards;\n        }\n\n        .stat-item {\n            text-align: center;\n        }\n\n        .stat-number {\n            font-size: 2.5rem;\n            font-weight: bold;\n            color: var(--primary-orange);\n            display: block;\n            margin-bottom: 5px;\n        }\n\n        .stat-label {\n            font-size: 0.9rem;\n            color: var(--text-gray);\n        }\n\n        /* CTA Section */\n        .cta-section {\n            text-align: center;\n            padding: 40px 0;\n        }\n\n        .cta-text {\n            font-size: 1.5rem;\n            margin-bottom: 30px;\n            color: var(--text-white);\n        }\n\n        .cta-button {\n            display: inline-block;\n            padding: 18px 50px;\n            background: linear-gradient(45deg, var(--primary-orange), #ff9a3c);\n            color: var(--text-white);\n            text-decoration: none;\n            font-size: 1.2rem;\n            font-weight: bold;\n            border-radius: 50px;\n            transition: all 0.3s ease;\n            position: relative;\n            overflow: hidden;\n            box-shadow: 0 4px 15px rgba(240, 132, 24, 0.3);\n        }\n\n        .cta-button:hover {\n            transform: translateY(-3px);\n            box-shadow: 0 10px 30px rgba(240, 132, 24, 0.4);\n        }\n\n        .cta-button::before {\n            content: '';\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            width: 0;\n            height: 0;\n            background: rgba(255, 255, 255, 0.2);\n            border-radius: 50%;\n            transform: translate(-50%, -50%);\n            transition: width 0.6s ease, height 0.6s ease;\n        }\n\n        .cta-button:hover::before {\n            width: 300px;\n            height: 300px;\n        }\n\n        /* Responsive Design */\n        @media (max-width: 1024px) {\n            .core-features {\n                grid-template-columns: 1fr;\n                gap: 20px;\n            }\n\n            .feature-card {\n                height: 300px;\n            }\n        }\n\n        @media (max-width: 768px) {\n            .why-apgo-section {\n                padding: 60px 0;\n            }\n\n            .main-title {\n                font-size: 2rem;\n            }\n\n            .subtitle {\n                font-size: 1.1rem;\n            }\n\n            .section-header {\n                margin-bottom: 50px;\n            }\n\n            .core-features {\n                margin-bottom: 50px;\n            }\n\n            .stats-bar {\n                flex-direction: column;\n                gap: 30px;\n                padding: 30px 20px;\n                margin-bottom: 50px;\n            }\n\n            .feature-content {\n                padding: 30px 20px;\n            }\n\n            .feature-title {\n                font-size: 1.3rem;\n            }\n\n            .cta-text {\n                font-size: 1.2rem;\n            }\n\n            .cta-button {\n                padding: 15px 40px;\n                font-size: 1rem;\n            }\n        }\n    </style>\n</head>\n<body>\n    <section class=\"why-apgo-section\">\n        <div class=\"container\">\n            <!-- Header Section -->\n            <div class=\"section-header\">\n                <h2 class=\"main-title\">Why Choose APGO?</h2>\n                <p class=\"subtitle\">17-year local brand, one-stop control from R&D to production, exclusive technology hot-selling in Southeast Asia</p>\n            </div>\n\n            <!-- Core Features - Large Image Cards -->\n            <div class=\"core-features\">\n                <div class=\"feature-card\">\n                    <div class=\"feature-bg lab-bg\"></div>\n                    <div class=\"feature-content\">\n                        <div class=\"feature-icon\">🔬</div>\n                        <h3 class=\"feature-title\">Independent R&D Laboratory</h3>\n                        <p class=\"feature-desc\">Equipped with professional R&D laboratory, all product formulas are personally developed and controlled by the founder, ensuring every bottle is a crystallization of exclusive technology</p>\n                    </div>\n                </div>\n\n                <div class=\"feature-card\">\n                    <div class=\"feature-bg factory-bg\"></div>\n                    <div class=\"feature-content\">\n                        <div class=\"feature-icon\">🏭</div>\n                        <h3 class=\"feature-title\">One-Stop Production Factory</h3>\n                        <p class=\"feature-desc\">From raw material procurement to finished product packaging, the entire process is completed in our own factory with strict quality control, every step is handled personally</p>\n                    </div>\n                </div>\n\n                <div class=\"feature-card\">\n                    <div class=\"feature-bg tech-bg\"></div>\n                    <div class=\"feature-content\">\n                        <div class=\"feature-icon\">⚡</div>\n                        <h3 class=\"feature-title\">Exclusive Coating Technology</h3>\n                        <p class=\"feature-desc\">17 years of technical accumulation, developed multiple exclusive formulas with effects surpassing international manufacturers at more affordable prices</p>\n                    </div>\n                </div>\n\n                <div class=\"feature-card\">\n                    <div class=\"feature-bg quality-bg\"></div>\n                    <div class=\"feature-content\">\n                        <div class=\"feature-icon\">🌏</div>\n                        <h3 class=\"feature-title\">Southeast Asian Market Certification</h3>\n                        <p class=\"feature-desc\">Products are hot-selling in Malaysia, Singapore and other regions, withstanding tropical climate tests with quality widely recognized</p>\n                    </div>\n                </div>\n            </div>\n\n            <!-- CTA -->\n            <div class=\"cta-section\">\n                <p class=\"cta-text\">Choose APGO, Choose Quality and Trust</p>\n                <a href=\"#\" class=\"cta-button\">Experience Now</a>\n            </div>\n        </div>\n    </section>\n\n    <script>\n        // Parallax scrolling effect\n        window.addEventListener('scroll', () => {\n            const scrolled = window.pageYOffset;\n            const section = document.querySelector('.why-apgo-section');\n            if (section && scrolled < window.innerHeight * 2) {\n                const parallax = section.querySelector('::before');\n                const speed = 0.5;\n                section.style.backgroundPosition = `center ${scrolled * speed}px`;\n            }\n        });\n    </script>\n</body>\n</html>",
