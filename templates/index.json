    "apgo_home_story": {
      "type": "apgo-home-story",
      "blocks": {
        "story_2007": {
          "type": "milestone",
          "settings": {
            "year": "2007",
            "title": "Electronics Development Foundation",
            "description": "Started with electronics development and dashcam OEM manufacturing. The founder accumulated ten years of R&D and manufacturing experience, becoming the driving force behind Taiwan's major well-known brands, establishing the foundation of quality dedication."
          }
        },
        "story_2011": {
          "type": "milestone",
          "settings": {
            "year": "2011",
            "title": "Established Dashcam Factory",
            "description": "Built professional factory with ISO9001 certification, providing one-stop service from design to production. Gained favor from major manufacturers like ADATA, Sampo, Asustek, and Patriot, even undertaking orders from Singapore's Ministry of Defense."
          }
        },
        "story_2014": {
          "type": "milestone",
          "settings": {
            "year": "2014",
            "title": "Developed First Generation Car Wash Coating",
            "description": "From a car enthusiast's perspective, the founder began developing car wash coating products. Hoping to enable everyone to care for their beloved cars themselves, experience the joy of DIY, and stop wasting money unnecessarily."
          }
        },
        "story_2017": {
          "type": "milestone",
          "settings": {
            "year": "2017",
            "title": "APGO Brand Born",
            "description": "APGO was officially born named after the founder! Adhering to the strict standards of electronics manufacturing, all production materials and processes undergo rigorous quality control, aspiring to become Taiwan's largest coating production factory."
          }
        },
        "story_2019": {
          "type": "milestone",
          "settings": {
            "year": "2019",
            "title": "Entered International Markets",
            "description": "First generation water coating officially launched, while establishing Malaysian company to expand into Southeast Asian markets. From Taiwan to the world, letting more people experience APGO's quality products."
          }
        },
        "story_2021": {
          "type": "milestone",
          "settings": {
            "year": "2021",
            "title": "Complete Product Upgrade",
            "description": "Second generation atomic coating series fully upgraded, adding preparation work and interior care series. Same year established Singapore company and received strong recommendations from famous KOLs Cool and Joeman."
          }
        },
        "story_2022": {
          "type": "milestone",
          "settings": {
            "year": "2022",
            "title": "Media Recognition & Endorsement",
            "description": "Famous automotive show host Liao Ying-ting strongly recommended, and famous KOL Liao Lao-da collaborated to launch atomic glaze. Brand influence continues to expand, becoming a leading brand in the automotive beauty industry."
          }
        },
        "story_2024": {
          "type": "milestone",
          "settings": {
            "year": "2024",
            "title": "Sales Milestone",
            "description": "Annual sales exceeded 50,000 sets, becoming a well-known coating brand in Southeast Asia. From novice housewives to professional coating enthusiasts, everyone can easily get started, bringing automotive beauty into every household."
          }
        }
