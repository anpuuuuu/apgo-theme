      "type": "custom-liquid",
      "name": "Homepage S6 Eng",
      "settings": {
        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>APGO - Quick Product Guide Section</title>\n  <style>\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n\n    :root {\n      --primary-orange: #f08418;\n      --text-white: #ffffff;\n      --text-gray: #cccccc;\n      --gradient-bg: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);\n    }\n\n    body {\n      font-family: 'Arial', 'Microsoft JhengHei', sans-serif;\n      background: #000000;\n      color: var(--text-white);\n      overflow-x: hidden; /* ✅ Prevent horizontal scrolling */\n    }\n\n    /* Section 5: Quick Product Guide */\n    .guide-section {\n      background: #000000;\n      padding: 60px 0;\n    }\n\n    .guide-container {\n      max-width: 1200px;\n      margin: 0 auto;\n      padding: 0 20px;\n      text-align: center;\n    }\n\n    .guide-title {\n      font-size: 2.5rem;\n      color: var(--text-white);\n      margin-bottom: 15px;\n    }\n\n    .guide-subtitle {\n      font-size: 1.2rem;\n      color: var(--text-gray);\n      margin-bottom: 40px;\n    }\n\n    .guide-options {\n      display: grid;\n      grid-template-columns: repeat(2, 1fr);\n      gap: 20px;\n      max-width: 600px;\n      margin: 0 auto;\n      width: 100%;\n    }\n\n    .guide-option {\n      background: rgba(255, 255, 255, 0.05);\n      backdrop-filter: blur(10px);\n      border-radius: 20px;\n      padding: 30px 25px;\n      border: 1px solid rgba(255, 255, 255, 0.1);\n      cursor: pointer;\n      transition: all 0.3s ease;\n    }\n\n    .guide-option:hover {\n      transform: translateY(-5px);\n      border-color: var(--primary-orange);\n      background: rgba(240, 132, 24, 0.1);\n    }\n\n    .guide-option h3 {\n      font-size: 1.3rem;\n      color: var(--primary-orange);\n      margin-bottom: 15px;\n    }\n\n    .guide-option p {\n      color: var(--text-gray);\n      line-height: 1.6;\n    }\n\n    /* ✅ Responsive adjustments (mobile optimization) */\n    @media (max-width: 768px) {\n      .guide-section {\n        padding: 40px 0;\n      }\n\n      .guide-container {\n        padding: 0 16px;\n      }\n\n      .guide-title {\n        font-size: 2rem;\n      }\n\n      .guide-subtitle {\n        font-size: 1rem;\n        margin-bottom: 30px;\n      }\n\n      .guide-options {\n        grid-template-columns: repeat(2, 1fr);\n        gap: 16px;\n        width: 100%;\n        max-width: 100%;\n        padding: 0;\n      }\n\n      .guide-option {\n        padding: 20px 15px;\n      }\n    }\n  </style>\n</head>\n<body>\n  <!-- Section 5: Quick Product Guide -->\n  <section class=\"guide-section\">\n    <div class=\"guide-container\">\n      <h2 class=\"guide-title\">Not sure which one to choose?</h2>\n      <p class=\"guide-subtitle\">Let us help you find the most suitable coating product</p>\n      <div class=\"guide-options\">\n        <div class=\"guide-option\" data-type=\"new\">\n          <h3>New Car Protection</h3>\n          <p>Just purchased a new car and want the best protection</p>\n        </div>\n        <div class=\"guide-option\" data-type=\"old\">\n          <h3>Old Car Restoration</h3>\n          <p>Used for a while and want to restore the shine</p>\n        </div>\n        <div class=\"guide-option\" data-type=\"diy\">\n          <h3>DIY Beginner</h3>\n          <p>First time doing it yourself, need something simple and easy to use</p>\n        </div>\n        <div class=\"guide-option\" data-type=\"pro\">\n          <h3>Professional Needs</h3>\n          <p>Seeking the highest level of protection effects</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n <script>\n  function initGuideOptions() {\n    const options = document.querySelectorAll('.guide-option');\n    options.forEach(option => {\n      option.addEventListener('click', function () {\n        const type = this.dataset.type;\n        handleGuideSelection(type);\n      });\n    });\n  }\n\n  function handleGuideSelection(type) {\n    switch (type) {\n      case 'new':\n        window.location.href = 'https://apgo.my/collections/atomic-coating-series';\n        break;\n\n      case 'old':\n        window.location.href = 'https://apgo.my/collections/restoration';\n        break;\n\n      case 'diy':\n        window.location.href = 'https://apgo.my/products/apgo-atomic-car-nano-coating-standard?variant=46971377942682';\n        break;\n\n      case 'pro':\n        window.location.href = 'https://apgo.my/collections/2025-new-launch';\n        break;\n    }\n  }\n\n  document.addEventListener('DOMContentLoaded', function () {\n    initGuideOptions();\n  });\n</script>\n\n</body>\n</html>",
