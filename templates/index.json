        "custom_liquid": "<!DOCTYPE html>\n<html lang=\"zh-TW\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>Coating Product Showcase - Left Image Layout</title>\n  <style>\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n    body {\n      font-family: 'Arial', sans-serif;\n      background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);\n      color: #ffffff;\n      overflow-x: hidden;\n    }\n    \n    /* 標題區域樣式 */\n    .header-section {\n      text-align: center;\n      padding: 40px 20px 20px 20px;\n    }\n    \n    .main-title {\n      font-size: 2.5rem;\n      font-weight: bold;\n      color: #f08418;\n      margin-bottom: 16px;\n      line-height: 1.2;\n    }\n    \n    .description-text {\n      font-size: 1.1rem;\n      color: #b0b0b0;\n      line-height: 1.6;\n      max-width: 800px;\n      margin: 0 auto;\n    }\n    \n    .coating-showcase {\n      padding: 20px 20px 60px 20px;\n      position: relative;\n      width: 100%;\n      max-width: 100vw;\n    }\n    .product-scroll-wrapper {\n      display: flex;\n      gap: 30px;\n      overflow-x: auto !important;\n      overflow-y: hidden !important;\n      padding: 20px 0 40px 0;\n      scroll-behavior: smooth;\n      -webkit-overflow-scrolling: touch;\n      /* 強制顯示滾動條 */\n      scrollbar-width: thin !important;\n      scrollbar-color: #f08418 rgba(255, 255, 255, 0.1) !important;\n    }\n    \n    /* WebKit 瀏覽器滾動條 - 提高優先級 */\n    .coating-showcase .product-scroll-wrapper.coating-products-scrollbar::-webkit-scrollbar {\n      height: 8px !important;\n      display: block !important;\n    }\n    .coating-showcase .product-scroll-wrapper.coating-products-scrollbar::-webkit-scrollbar-track {\n      background: rgba(255, 255, 255, 0.1) !important;\n      border-radius: 4px !important;\n    }\n    .coating-showcase .product-scroll-wrapper.coating-products-scrollbar::-webkit-scrollbar-thumb {\n      background: #f08418 !important;\n      border-radius: 4px !important;\n    }\n    .coating-showcase .product-scroll-wrapper.coating-products-scrollbar::-webkit-scrollbar-thumb:hover {\n      background: #ff9a3c !important;\n    }\n    \n    /* 右邊漸層提示 - 讓用戶知道還有更多內容 */\n    .coating-showcase::after {\n      content: '';\n      position: absolute;\n      top: 20px;\n      right: 0;\n      width: 30px;\n      height: calc(100% - 120px);\n      background: linear-gradient(90deg, transparent 0%, rgba(26, 26, 26, 0.8) 100%);\n      pointer-events: none;\n      z-index: 5;\n    }\n    \n    /* 滾動指示器 - 強制樣式 */\n    .scroll-indicator {\n      position: absolute !important;\n      bottom: 20px !important;\n      left: 50% !important;\n      transform: translateX(-50%) !important;\n      color: #f08418 !important;\n      font-size: 0.8rem !important;\n      text-align: center !important;\n      z-index: 10 !important;\n      opacity: 0.8 !important;\n      display: flex !important;\n      flex-direction: column !important;\n      align-items: center !important;\n      justify-content: center !important;\n      width: 200px !important;\n    }\n    \n    .scroll-indicator-text {\n      margin-bottom: 8px !important;\n      color: #f08418 !important;\n      font-size: 0.8rem !important;\n      text-align: center !important;\n      display: block !important;\n      width: 100% !important;\n      line-height: 1.2 !important;\n    }\n    \n    .scroll-dots {\n      display: flex !important;\n      gap: 8px !important;\n      justify-content: center !important;\n      align-items: center !important;\n      margin: 0 auto !important;\n      width: 100% !important;\n    }\n    \n    .scroll-dot {\n      width: 8px !important;\n      height: 8px !important;\n      border-radius: 50% !important;\n      background: rgba(240, 132, 24, 0.3) !important;\n      transition: all 0.3s ease !important;\n      display: block !important;\n      flex-shrink: 0 !important;\n    }\n    \n    .scroll-dot.active {\n      background: #f08418 !important;\n      transform: scale(1.2) !important;\n    }\n    \n    .product-block {\n      flex: 0 0 auto;\n      width: 420px;\n      height: 400px;\n      position: relative;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .product-card {\n      position: relative;\n      width: 100%;\n      height: 100%;\n      background: #252525 !important;\n      border-radius: 16px;\n      padding: 24px;\n      border: 1px solid #3a3a3a;\n      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);\n      transition: all 0.3s ease;\n      display: flex;\n      flex-direction: row;\n      align-items: stretch;\n      color: inherit;\n      text-decoration: none;\n      cursor: pointer;\n    }\n\n    .product-card:focus-visible {\n      outline: 3px solid #f08418;\n      outline-offset: 3px;\n    }\n    \n    .product-card:hover {\n      box-shadow: 0 12px 32px rgba(240, 132, 24, 0.3);\n      transform: translateY(-4px);\n    }\n    \n    .product-card-top-bar {\n      position: absolute;\n      top: 0;\n      left: 50%;\n      transform: translateX(-50%);\n      width: 85%;\n      height: 4px;\n      background: linear-gradient(90deg, #f08418, #ff9a3c);\n      border-radius: 16px;\n      z-index: 1;\n    }\n    \n    .product-badge {\n      position: absolute;\n      top: 16px;\n      left: 16px;\n      background: #f08418;\n      color: white;\n      padding: 1px 12px;\n      border-radius: 15px;\n      font-size: 0.9rem;\n      font-weight: bold;\n      z-index: 10;\n    }\n\n    .product-image {\n      width: 160px;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      flex-shrink: 0;\n    }\n\n    .product-image img {\n      width: auto;\n      height: 90%;\n      max-width: 100%;\n      object-fit: contain;\n      display: block;\n      filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.3));\n    }\n\n    .product-content {\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n      padding-left: 20px;\n      justify-content: center;\n      height: 100%;\n      position: relative;\n    }\n\n    .cta-wrapper {\n      text-align: center;\n      margin-top: 15px;\n    }\n\n    .cta-button {\n      display: block;\n      width: 100%;\n      background: linear-gradient(45deg, #f08418, #ff9a3c);\n      color: white;\n      text-decoration: none;\n      padding: 8px 12px !important;\n      border-radius: 12px;\n      font-size: 0.85rem !important;\n      font-weight: bold;\n      cursor: pointer;\n      transition: all 0.3s ease;\n      box-shadow: 0 2px 6px rgba(240, 132, 24, 0.3);\n      border: none;\n      text-align: center;\n    }\n\n    .cta-button:hover {\n      background: linear-gradient(45deg, #ff9a3c, #f08418);\n      transform: translateY(-1px);\n      box-shadow: 0 3px 10px rgba(240, 132, 24, 0.4);\n    }\n    \n    .product-name {\n      font-size: 1.5rem !important;\n      font-weight: bold;\n      color: #f08418;\n      margin-bottom: 8px;\n    }\n    \n    /* 各產品專屬效果 */\n    /* 鈦晶鍍膜 - 極光漸變效果 */\n    .titanium-product .product-name {\n      background: linear-gradient(45deg, #4FC3F7, #81E6F3, #4DD0E1);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      background-clip: text;\n      animation: titanium-aurora 3s ease-in-out infinite;\n    }\n    \n    @keyframes titanium-aurora {\n      0%, 100% { \n        background: linear-gradient(45deg, #4FC3F7, #81E6F3, #4DD0E1);\n        -webkit-background-clip: text;\n        background-clip: text;\n      }\n      50% { \n        background: linear-gradient(45deg, #81E6F3, #4DD0E1, #4FC3F7);\n        -webkit-background-clip: text;\n        background-clip: text;\n      }\n    }\n    \n    /* 原子極光鍍膜 - 星形閃爍效果 */\n    .aurora-product .product-name {\n      color: #4DD0E1 !important;\n      position: relative;\n    }\n    \n    .aurora-product .product-name::before {\n      content: '✦';\n      position: absolute;\n      top: -5px;\n      right: -8px;\n      font-size: 0.8rem;\n      color: #4DD0E1;\n      animation: aurora-twinkle 2s ease-in-out infinite;\n    }\n    \n    @keyframes aurora-twinkle {\n      0%, 100% { \n        opacity: 0.3;\n        transform: scale(0.8);\n      }\n      50% { \n        opacity: 1;\n        transform: scale(1.2);\n      }\n    }\n    \n    /* 原子釉鍍膜 - 釉面光澤效果（維持不變） */\n    .glaze-product .product-name {\n      color: #66BB6A !important;\n      position: relative;\n      overflow: hidden;\n    }\n    \n    .glaze-product .product-name::after {\n      content: '';\n      position: absolute;\n      top: 0;\n      left: -100%;\n      width: 100%;\n      height: 100%;\n      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);\n      animation: glaze-sweep 4s ease-in-out infinite;\n    }\n    \n    @keyframes glaze-sweep {\n      0% { left: -100%; }\n      20% { left: 100%; }\n      100% { left: 100%; }\n    }\n    \n    /* 原子微晶鍍膜 - 蠟筆風格點綴 */\n    .crystal-product .product-name {\n      color: #81C784 !important;\n      position: relative;\n    }\n    \n    .crystal-product .product-name::before {\n      content: '●';\n      position: absolute;\n      top: -3px;\n      left: -18px;\n      font-size: 0.6rem;\n      color: #A5D6A7;\n      animation: crayon-dot1 3s ease-in-out infinite;\n    }\n    \n    .crystal-product .product-name::after {\n      content: '●';\n      position: absolute;\n      bottom: -3px;\n      right: -18px;\n      font-size: 0.8rem;\n      color: #66BB6A;\n      animation: crayon-dot2 3s ease-in-out infinite 1.5s;\n    }\n    \n    @keyframes crayon-dot1 {\n      0%, 100% { \n        opacity: 0.4;\n        transform: translateY(0) scale(0.8);\n      }\n      50% { \n        opacity: 0.8;\n        transform: translateY(-2px) scale(1.1);\n      }\n    }\n    \n    @keyframes crayon-dot2 {\n      0%, 100% { \n        opacity: 0.5;\n        transform: translateY(0) scale(0.9);\n      }\n      50% { \n        opacity: 0.9;\n        transform: translateY(2px) scale(1.2);\n      }\n    }\n    \n    /* 原子封體鍍膜 - 蠟筆風格線條 */\n    .sealing-product .product-name {\n      color: #D4AF37 !important;\n      position: relative;\n    }\n    \n    .sealing-product .product-name::before {\n      content: '';\n      position: absolute;\n      bottom: -8px;\n      left: 0;\n      width: 100%;\n      height: 3px;\n      background: linear-gradient(90deg, transparent, #F7DC6F, #D4AF37, #F7DC6F, transparent);\n      border-radius: 2px;\n      animation: crayon-underline 4s ease-in-out infinite;\n    }\n    \n    .sealing-product .product-name::after {\n      content: '◆';\n      position: absolute;\n      top: -5px;\n      right: -20px;\n      font-size: 0.7rem;\n      color: #F7DC6F;\n      animation: crayon-diamond 2.5s ease-in-out infinite;\n    }\n    \n    @keyframes crayon-underline {\n      0%, 100% { \n        opacity: 0.6;\n        transform: scaleX(0.8);\n      }\n      50% { \n        opacity: 1;\n        transform: scaleX(1.1);\n      }\n    }\n    \n    @keyframes crayon-diamond {\n      0%, 100% { \n        opacity: 0.5;\n        transform: rotate(0deg) scale(0.9);\n      }\n      50% { \n        opacity: 0.9;\n        transform: rotate(45deg) scale(1.1);\n      }\n    }\n    \n    /* 原子鍍膜 - 簡潔效果 */\n    .basic-product .product-name {\n      color: #f08418 !important;\n      transition: all 0.3s ease;\n    }\n    \n    .basic-product .product-name:hover {\n      color: #ff9a3c !important;\n      text-shadow: 0 2px 8px rgba(240, 132, 24, 0.3);\n    }\n    \n    .product-description {\n      font-size: 0.95rem !important;\n      color: #b0b0b0;\n      margin-bottom: 18px;\n      line-height: 1.4;\n    }\n    .properties {\n      display: flex;\n      flex-direction: column;\n      gap: 4px;\n    }\n    .property {\n      margin-bottom: 0px;\n    }\n    .property-header {\n      display: flex;\n      justify-content: space-between;\n      margin-bottom: 5px;\n    }\n    .property-name {\n      font-size: 0.85rem !important;\n      color: #ffffff;\n    }\n    .property-value {\n      font-size: 0.85rem !important;\n      font-weight: bold;\n      color: #f08418;\n    }\n    .progress-bar {\n      height: 8px;\n      background: rgba(255, 255, 255, 0.1);\n      border-radius: 8px;\n      overflow: hidden;\n    }\n    .progress-fill {\n      height: 100%;\n      background: linear-gradient(90deg, #f08418, #ff9a3c);\n      border-radius: 8px;\n      transition: width 0.5s ease;\n    }\n\n    /* Mobile snap carousel controls */\n    .mobile-carousel-controls {\n      display: none;\n    }\n\n    .mobile-scroll-dots {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 7px;\n    }\n\n    .mobile-scroll-dot {\n      width: 8px;\n      height: 8px;\n      padding: 0;\n      appearance: none;\n      border: 0;\n      border-radius: 50%;\n      background: rgba(240, 132, 24, 0.3);\n      transition: background 0.2s ease, transform 0.2s ease;\n      cursor: pointer;\n    }\n\n    .mobile-scroll-dot.active {\n      background: #f08418;\n      transform: scale(1.25);\n    }\n\n    .carousel-arrow {\n      width: 38px;\n      height: 38px;\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      flex-shrink: 0;\n      padding: 0;\n      border: 1px solid rgba(240, 132, 24, 0.7);\n      border-radius: 50%;\n      background: #252525;\n      color: #f08418;\n      font-size: 1.6rem;\n      line-height: 1;\n      cursor: pointer;\n    }\n\n    .carousel-arrow:disabled {\n      opacity: 0.3;\n      cursor: default;\n    }\n\n    .carousel-counter {\n      min-width: 34px;\n      color: #f08418;\n      font-size: 0.75rem;\n      text-align: center;\n    }\n\n    /* 響應式設計 */\n    @media (max-width: 768px) {\n      .header-section {\n        padding: 30px 20px 15px 20px;\n      }\n\n      .main-title {\n        font-size: 2rem;\n      }\n\n      .description-text {\n        font-size: 0.95rem;\n        padding: 0 10px;\n      }\n\n      .coating-showcase {\n        padding: 15px 16px 24px;\n        overflow: hidden;\n      }\n\n      .product-scroll-wrapper {\n        display: flex;\n        align-items: flex-start;\n        gap: 12px;\n        overflow-x: auto !important;\n        overflow-y: hidden !important;\n        scroll-snap-type: x mandatory;\n        scroll-padding-inline: 0;\n        overscroll-behavior-x: contain;\n        padding: 12px 0 16px !important;\n        scrollbar-width: none !important;\n        -ms-overflow-style: none;\n      }\n\n      .coating-showcase .product-scroll-wrapper.coating-products-scrollbar::-webkit-scrollbar {\n        display: none !important;\n        width: 0 !important;\n        height: 0 !important;\n      }\n\n      .coating-showcase::after {\n        display: none;\n      }\n\n      .scroll-indicator {\n        display: none !important;\n      }\n\n      .product-block {\n        flex: 0 0 100%;\n        width: 100%;\n        max-width: 100%;\n        height: auto;\n        min-height: 0;\n        align-items: flex-start;\n        scroll-snap-align: start;\n        scroll-snap-stop: always;\n      }\n\n      .product-card {\n        display: grid;\n        grid-template-columns: minmax(90px, 30%) minmax(0, 1fr);\n        grid-template-rows: auto 1fr;\n        column-gap: 12px;\n        align-items: start;\n        width: 100%;\n        height: auto;\n        min-height: 0;\n        padding: 16px;\n        border-radius: 12px;\n        background: #1a1a1a !important;\n      }\n\n      .product-badge {\n        position: static;\n        grid-column: 2;\n        grid-row: 1;\n        justify-self: end;\n        margin-bottom: 6px;\n        padding: 1px 9px;\n        font-size: 0.75rem;\n        white-space: nowrap;\n      }\n\n      .product-image {\n        grid-column: 1;\n        grid-row: 1 / span 2;\n        align-self: center;\n        width: 100%;\n        min-width: 0;\n        max-width: 110px;\n        height: auto;\n      }\n\n      .product-image img {\n        width: 100%;\n        height: auto;\n        max-height: 280px;\n        object-fit: contain;\n      }\n\n      .product-content {\n        grid-column: 2;\n        grid-row: 2;\n        min-width: 0;\n        height: auto;\n        padding-left: 0;\n        justify-content: flex-start;\n      }\n\n      .product-name {\n        padding-right: 6px;\n        font-size: 1.05rem !important;\n        line-height: 1.2;\n      }\n\n      .product-description {\n        margin-bottom: 10px;\n        font-size: 0.8rem !important;\n        line-height: 1.35;\n      }\n\n      .properties {\n        gap: 5px;\n      }\n\n      .property-name,\n      .property-value {\n        font-size: 0.72rem !important;\n      }\n\n      .progress-bar {\n        height: 6px;\n      }\n\n      .cta-wrapper {\n        margin-top: 14px;\n      }\n\n      .cta-button {\n        padding: 10px 8px !important;\n        border-radius: 10px !important;\n        font-size: 0.9rem !important;\n      }\n\n      .mobile-carousel-controls {\n        display: flex;\n        align-items: center;\n        justify-content: center;\n        gap: 12px;\n        width: 100%;\n        margin-top: 10px;\n      }\n    }\n\n    /* 桌面版隱藏滾動指示器 */\n    @media (min-width: 769px) {\n      .scroll-indicator {\n        display: flex !important;\n      }\n    }\n  </style>\n  <script>\n    // Product carousel state and controls\n    document.addEventListener('DOMContentLoaded', function() {\n      const scroller = document.getElementById('productScroller');\n      const cards = Array.from(scroller?.querySelectorAll('.product-block') || []);\n      const desktopDots = Array.from(document.querySelectorAll('.scroll-indicator .scroll-dot'));\n      const mobileDots = Array.from(document.querySelectorAll('#mobileProductDots .mobile-scroll-dot'));\n      const previousButton = document.getElementById('productPrev');\n      const nextButton = document.getElementById('productNext');\n      const counter = document.getElementById('productCounter');\n\n      if (!scroller || cards.length === 0) return;\n\n      let activeIndex = 0;\n      let animationFrame = null;\n\n      function getClosestCardIndex() {\n        const scrollerLeft = scroller.getBoundingClientRect().left;\n\n        return cards.reduce((closest, card, index) => {\n          const distance = Math.abs(card.getBoundingClientRect().left - scrollerLeft);\n          return distance < closest.distance ? { index, distance } : closest;\n        }, { index: 0, distance: Number.POSITIVE_INFINITY }).index;\n      }\n\n      function updateDotGroup(dots) {\n        dots.forEach((dot, index) => {\n          const isActive = index === activeIndex;\n          dot.classList.toggle('active', isActive);\n          dot.setAttribute('aria-current', isActive ? 'true' : 'false');\n        });\n      }\n\n      function updateControls() {\n        activeIndex = getClosestCardIndex();\n        const maxScroll = scroller.scrollWidth - scroller.clientWidth;\n        const desktopIndex = maxScroll > 0\n          ? Math.round((scroller.scrollLeft / maxScroll) * (desktopDots.length - 1))\n          : 0;\n\n        desktopDots.forEach((dot, index) => {\n          dot.classList.toggle('active', index === desktopIndex);\n        });\n        updateDotGroup(mobileDots);\n\n        if (counter) counter.textContent = `${activeIndex + 1} / ${cards.length}`;\n        if (previousButton) previousButton.disabled = activeIndex === 0;\n        if (nextButton) nextButton.disabled = activeIndex === cards.length - 1;\n      }\n\n      function goToCard(index) {\n        const safeIndex = Math.max(0, Math.min(index, cards.length - 1));\n        const cardRect = cards[safeIndex].getBoundingClientRect();\n        const scrollerRect = scroller.getBoundingClientRect();\n        const targetLeft = scroller.scrollLeft + cardRect.left - scrollerRect.left;\n\n        scroller.scrollTo({ left: targetLeft, behavior: 'smooth' });\n      }\n\n      previousButton?.addEventListener('click', function() {\n        goToCard(activeIndex - 1);\n      });\n\n      nextButton?.addEventListener('click', function() {\n        goToCard(activeIndex + 1);\n      });\n\n      mobileDots.forEach((dot, index) => {\n        dot.addEventListener('click', function() {\n          goToCard(index);\n        });\n      });\n\n      scroller.addEventListener('scroll', function() {\n        if (animationFrame) cancelAnimationFrame(animationFrame);\n        animationFrame = requestAnimationFrame(updateControls);\n      }, { passive: true });\n\n      window.addEventListener('resize', updateControls);\n      updateControls();\n    });\n  </script>\n</head>\n<body>\n  <!-- Header Section -->\n  <div class=\"header-section\">\n    <h1 class=\"main-title\">Professional Coating Product Series</h1>\n    <p class=\"description-text\">APGO-developed coatings work on all car colors and materials. Start choosing your exclusive coating now!</p>\n  </div>\n\n  <section class=\"coating-showcase\">\n    <div class=\"product-scroll-wrapper coating-products-scrollbar\" id=\"productScroller\">\n      <!-- Titanium Crystal Coating -->\n      <div class=\"product-block\">\n        <a class=\"product-card titanium-product\" href=\"/products/apgo-atomic-titanium-crystal-car-nano-coating-premium\">\n          <div class=\"product-card-top-bar\"></div>\n          <div class=\"product-badge\">Premium</div>\n          <div class=\"product-image\">\n            <img src=\"https://cdn.shopify.com/s/files/1/0760/8002/1755/files/0_895dd8bc-acff-4324-859d-5d3466502d8a.png?v=1750764774\" alt=\"Titanium Crystal Coating\" />\n          </div>\n          <div class=\"product-content\">\n            <div>\n              <h3 class=\"product-name\">Titanium Crystal Coating</h3>\n              <p class=\"product-description\">High-hardness titanium crystal structure, ultimat