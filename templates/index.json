        "custom_liquid": "<!DOCTYPE html> <html lang=\"en\"> <head> <meta charset=\"UTF-8\"> <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"> <title>APGO Brand Image Video</title> <style> * { margin: 0; padding: 0; box-sizing: border-box; } :root { --primary-orange: #f08418; --secondary-orange: #ff9a3c; } body { font-family: 'Arial', 'Microsoft JhengHei', sans-serif; background: #000000; color: #ffffff; overflow-x: hidden; } /* Minimalist brand video section - independent namespace */ .cinematic-video-section { position: relative; width: 100%; height: auto; min-height: 0; background: #000000; overflow: hidden; display: flex; align-items: center; justify-content: center; padding: 4vh 0; } /* Dynamic particle background - independent naming */ .cinematic-video-section .particle-canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; } .cinematic-video-section .floating-particle { position: absolute; width: 2px; height: 2px; background: var(--primary-orange); border-radius: 50%; opacity: 0; animation: cinematic-particleFloat 20s infinite linear; } .cinematic-video-section .floating-particle:nth-child(odd) { box-shadow: 0 0 6px var(--primary-orange); } .cinematic-video-section .floating-particle:nth-child(even) { background: var(--secondary-orange); box-shadow: 0 0 4px var(--secondary-orange); } @keyframes cinematic-particleFloat { 0% { transform: translateY(100vh) translateX(-50px) scale(0); opacity: 0; } 10% { opacity: 0.8; transform: scale(1); } 90% { opacity: 0.3; transform: scale(1); } 100% { transform: translateY(-100px) translateX(50px) scale(0); opacity: 0; } } /* Main video container - cinematic presentation */ .cinematic-video-section .video-stage { position: relative; width: 85%; max-width: 1400px; aspect-ratio: 16/9; z-index: 5; opacity: 0; transform: scale(0.95); animation: cinematic-videoEntrance 2s ease 0.5s forwards; } @keyframes cinematic-videoEntrance { to { opacity: 1; transform: scale(1); } } /* Multi-layer glowing border system */ .cinematic-video-section .video-stage::before { content: ''; position: absolute; top: -8px; left: -8px; right: -8px; bottom: -8px; background: linear-gradient(45deg, var(--primary-orange), var(--secondary-orange), #ffb366, var(--secondary-orange), var(--primary-orange) ); background-size: 400% 400%; border-radius: 24px; z-index: -2; animation: cinematic-gradientShift 6s ease-in-out infinite; filter: blur(1px); } .cinematic-video-section .video-stage::after { content: ''; position: absolute; top: -4px; left: -4px; right: -4px; bottom: -4px; background: linear-gradient(135deg, rgba(240, 132, 24, 0.8), rgba(255, 154, 60, 0.6), rgba(240, 132, 24, 0.8) ); background-size: 200% 200%; border-radius: 20px; z-index: -1; animation: cinematic-innerGlow 4s ease-in-out infinite; } @keyframes cinematic-gradientShift { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } } @keyframes cinematic-innerGlow { 0%, 100% { background-position: 0% 0%; opacity: 0.8; } 50% { background-position: 100% 100%; opacity: 1; } } /* Video body */ .cinematic-video-section .brand-video { width: 100%; height: 100%; object-fit: contain; object-position: center center; border-radius: 16px; background: #0a0a0a; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.1); transition: all 0.6s ease; } .cinematic-video-section .brand-video:hover { transform: scale(1.02); box-shadow: 0 30px 80px rgba(0, 0, 0, 0.9), 0 0 40px rgba(240, 132, 24, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.1); } /* Minimalist play control */ .cinematic-video-section .play-control { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80px; height: 80px; background: rgba(240, 132, 24, 0.15); border: 2px solid rgba(240, 132, 24, 0.6); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; backdrop-filter: blur(20px); opacity: 0; transform: translate(-50%, -50%) scale(0.8); transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); } .cinematic-video-section .play-control.show { opacity: 1; transform: translate(-50%, -50%) scale(1); } .cinematic-video-section .play-control:hover { background: rgba(240, 132, 24, 0.25); border-color: var(--primary-orange); transform: translate(-50%, -50%) scale(1.1); } .cinematic-video-section .play-icon { width: 0; height: 0; border-left: 20px solid var(--primary-orange); border-top: 12px solid transparent; border-bottom: 12px solid transparent; margin-left: 4px; filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.3)); } /* Play status indicator */ .cinematic-video-section .status-indicator { position: absolute; top: 30px; right: 30px; width: 12px; height: 12px; background: var(--primary-orange); border-radius: 50%; opacity: 0; box-shadow: 0 0 10px var(--primary-orange), 0 0 20px rgba(240, 132, 24, 0.5); animation: cinematic-pulse 2s ease-in-out infinite; } .cinematic-video-section .status-indicator.active { opacity: 1; } @keyframes cinematic-pulse { 0%, 100% { transform: scale(1); box-shadow: 0 0 10px var(--primary-orange), 0 0 20px rgba(240, 132, 24, 0.5); } 50% { transform: scale(1.2); box-shadow: 0 0 20px var(--primary-orange), 0 0 40px rgba(240, 132, 24, 0.7); } } /* Progress bar */ .cinematic-video-section .progress-track { position: absolute; bottom: 0; left: 0; width: 100%; height: 3px; background: rgba(255, 255, 255, 0.1); border-radius: 0 0 16px 16px; overflow: hidden; } .cinematic-video-section .progress-bar { height: 100%; width: 0%; background: linear-gradient(90deg, var(--primary-orange), var(--secondary-orange)); border-radius: inherit; transition: width 0.1s ease; box-shadow: 0 0 10px rgba(240, 132, 24, 0.6); } /* Ambient lighting effect */ .cinematic-video-section .ambient-glow { position: absolute; top: 50%; left: 50%; width: 120%; height: 120%; transform: translate(-50%, -50%); background: radial-gradient( ellipse at center, rgba(240, 132, 24, 0.05) 0%, rgba(255, 154, 60, 0.03) 40%, transparent 70% ); z-index: -3; animation: cinematic-ambientPulse 8s ease-in-out infinite; } @keyframes cinematic-ambientPulse { 0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.5; } 50% { transform: translate(-50%, -50%) scale(1.1); opacity: 0.8; } } /* Loading animation */ .cinematic-video-section .loading-ring { position: absolute; top: 50%; left: 50%; width: 60px; height: 60px; transform: translate(-50%, -50%); opacity: 1; transition: opacity 0.5s ease; } .cinematic-video-section .loading-ring.hide { opacity: 0; } .cinematic-video-section .loading-ring::before { content: ''; position: absolute; width: 60px; height: 60px; border: 3px solid transparent; border-top: 3px solid var(--primary-orange); border-radius: 50%; animation: cinematic-loadingSpin 1.5s linear infinite; } .cinematic-video-section .loading-ring::after { content: ''; position: absolute; top: 6px; left: 6px; width: 48px; height: 48px; border: 2px solid transparent; border-bottom: 2px solid var(--secondary-orange); border-radius: 50%; animation: cinematic-loadingSpin 1s linear infinite reverse; } @keyframes cinematic-loadingSpin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } } /* Responsive design */ @media (max-width: 1024px) { .cinematic-video-section { height: auto; min-height: 0; padding: 3vh 0; } .cinematic-video-section .video-stage { width: 90%; } .cinematic-video-section .play-control { width: 70px; height: 70px; } .cinematic-video-section .play-icon { border-left-width: 16px; border-top-width: 10px; border-bottom-width: 10px; } } @media (max-width: 768px) { .cinematic-video-section { min-height: 0; height: auto; padding: 2vh 0; } .cinematic-video-section .video-stage { width: 95%; } .cinematic-video-section .play-control { width: 60px; height: 60px; } .cinematic-video-section .play-icon { border-left-width: 14px; border-top-width: 8px; border-bottom-width: 8px; } .cinematic-video-section .status-indicator { top: 20px; right: 20px; width: 10px; height: 10px; } } @media (max-width: 480px) { .cinematic-video-section { min-height: 0; height: auto; padding: 2vh 0; } .cinematic-video-section .video-stage::before { top: -4px; left: -4px; right: -4px; bottom: -4px; } .cinematic-video-section .video-stage::after { top: -2px; left: -2px; right: -2px; bottom: -2px; } } /* High resolution optimization */ @media (min-width: 1920px) { .cinematic-video-section .video-stage { max-width: 1600px; } .cinematic-video-section .play-control { width: 100px; height: 100px; } .cinematic-video-section .play-icon { border-left-width: 24px; border-top-width: 15px; border-bottom-width: 15px; } } </style> </head> <body> <section class=\"cinematic-video-section\" id=\"cinematicSectionS2Eng\"> <!-- Dynamic particle background --> <div class=\"particle-canvas\" id=\"particleCanvasS2Eng\"></div> <!-- Ambient lighting effect --> <div class=\"ambient-glow\"></div> <!-- Video stage --> <div class=\"video-stage\" tabindex=\"-1\"> <video class=\"brand-video\" id=\"brandVideoS2Eng\" playsinline preload=\"auto\" tabindex=\"-1\" > <source src=\"https://cdn.shopify.com/videos/c/o/v/d8e8828223b342a3b6167dbdb1bda547.mp4\" type=\"video/mp4\"> </video> <!-- Loading animation --> <div class=\"loading-ring\" id=\"loadingRingS2Eng\"></div> <!-- Play control --> <div class=\"play-control\" id=\"playControlS2Eng\"> <div class=\"play-icon\"></div> </div> <!-- Status indicator --> <div class=\"status-indicator\" id=\"statusIndicatorS2Eng\"></div> <!-- Progress bar --> <div class=\"progress-track\"> <div class=\"progress-bar\" id=\"progressBarS2Eng\"></div> </div> </div> </section> <script> class CinematicVideoController { constructor() { this.video = document.getElementById('brandVideoS2Eng'); this.playControl = document.getElementById('playControlS2Eng'); this.statusIndicator = document.getElementById('statusIndicatorS2Eng'); this.progressBar = document.getElementById('progressBarS2Eng'); this.loadingRing = document.getElementById('loadingRingS2Eng'); this.hasPlayed = false; if (!this.video || !this.loadingRing) { return; } this.init(); this.createParticles(); } init() { this.setupIntersectionObserver(); this.setupVideoEvents(); this.setupPlayControl(); } createParticles() { const canvas = document.getElementById('particleCanvasS2Eng'); const particleCount = window.innerWidth < 768 ? 8 : 15; for (let i = 0; i < particleCount; i++) { const particle = document.createElement('div'); particle.className = 'floating-particle'; particle.style.left = Math.random() * 100 + '%'; particle.style.animationDelay = Math.random() * 20 + 's'; particle.style.animationDuration = (15 + Math.random() * 10) + 's'; canvas.appendChild(particle); } } setupIntersectionObserver() { const observer = new IntersectionObserver((entries) => { entries.forEach(entry => { if (entry.isIntersecting && !this.hasPlayed) { this.autoPlay(); } }); }, { threshold: 0.1, rootMargin: '100px 0px -50px 0px' }); observer.observe(this.video); } setupVideoEvents() { this.video.addEventListener('loadeddata', () => { this.loadingRing.classList.add('hide'); }); this.video.addEventListener('loadedmetadata', () => { this.loadingRing.classList.add('hide'); }); this.video.addEventListener('canplay', () => { this.loadingRing.classList.add('hide'); }); if (this.video.readyState >= 1) { this.loadingRing.classList.add('hide'); } this.video.load(); this.video.addEventListener('loadedmetadata', () => { this.loadingRing.classList.add('hide'); }); this.video.addEventListener('loadedmetadata', () => { this.loadingRing.classList.add('hide'); }); this.video.addEventListener('loadedmetadata', () => { this.loadingRing.classList.add('hide'); }); this.video.addEventListener('loadedmetadata', () => { this.loadingRing.classList.add('hide'); }); this.video.addEventListener('play', () => { this.statusIndicator.classList.add('active'); this.playControl.classList.remove('show'); }); this.video.addEventListener('pause', () => { this.statusIndicator.classList.remove('active'); this.playControl.classList.add('show'); }); this.video.addEventListener('ended', () => { this.statusIndicator.classList.remove('active'); this.playControl.classList.add('show'); this.progressBar.style.width = '0%'; }); this.video.addEventListener('timeupdate', () => { if (this.video.duration) { const progress = (this.video.currentTime / this.video.duration) * 100; this.progressBar.style.width = progress + '%'; } }); this.video.addEventListener('error', () => { this.loadingRing.classList.add('hide'); this.playControl.classList.add('show'); }); } setupPlayControl() { this.playControl.addEventListener('click', () => { this.playVideo(); }); } async autoPlay() { try { this.video.muted = false; await this.video.play(); this.hasPlayed = true; } catch (error) { console.log('Audio play failed, trying muted play:', error); try { this.video.muted = true; await this.video.play(); this.hasPlayed = true; this.showVolumeControl(); } catch (mutedError) { console.log('Auto-play completely failed, showing play button'); this.playControl.classList.add('show'); } } } showVolumeControl() { if (!document.getElementById('volumeHintS2Eng')) { const volumeHint = document.createElement('div'); volumeHint.id = 'volumeHintS2Eng'; volumeHint.style.cssText = 'position: absolute; top: 30px; left: 30px; background: rgba(240, 132, 24, 0.9); color: white; padding: 8px 15px; border-radius: 20px; font-size: 0.9rem; cursor: pointer; backdrop-filter: blur(10px); animation: fadeIn 0.5s ease; z-index: 10;'; volumeHint.innerHTML = '🔊 Click to enable sound'; volumeHint.onclick = () => { this.video.muted = false; volumeHint.remove(); }; this.video.parentElement.appendChild(volumeHint); } } async playVideo() { try { if (this.video.ended) { this.video.currentTime = 0; } this.video.muted = false; await this.video.play(); this.hasPlayed = true; const volumeHint = document.getElementById('volumeHintS2Eng'); if (volumeHint) { volumeHint.remove(); } } catch (error) { console.error('Play failed:', error); } } } if (document.readyState === 'loading') { if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', () => { new CinematicVideoController(); }); } else { new CinematicVideoController(); } } else { new CinematicVideoController(); } document.addEventListener('visibilitychange', () => { const video = document.getElementById('brandVideoS2Eng'); if (document.hidden && !video.paused) { video.pause(); } }); const section = document.getElementById('cinematicSectionS2Eng'); if (section) { section.style.transform = 'translateY(0)'; } document.addEventListener('keydown', (e) => { const isSpace = (e.code === 'Space' || e.key === ' '); if (!isSpace) return; const section = document.getElementById('cinematicSectionS2Eng'); const active = document.activeElement; if (section && active && section.contains(active)) { e.preventDefault(); e.stopPropagation(); } }, true); </script> </body> </html>",
