{% include 'shogun-content-handler' %}
<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {{ 'base.css' | asset_url | stylesheet_tag }}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    {% render 'apgo-aboutus-page-particles' %}
  
  {% render 'shogun-head' %}
  {% render 'abpilot-ui-sdk' %}
  <meta name="google-site-verification" content="1M5qttF-zRS-f4aDnJxbTBz-JOhpRaFQWohNRCHKXdY" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    html,
    body,
    body *,
    button,
    input,
    textarea,
    select {
      font-family: 'Poppins', 'Microsoft JhengHei', Arial, sans-serif !important;
    }
  </style>
  </head>

  {% liquid
    assign apgo_aboutus_main_class = ''
    if request.page_type == 'page' and page.handle == 'about-us'
      assign apgo_aboutus_main_class = ' apgo-aboutus-main-particles'
    elsif template.name == 'page' and template.suffix == 'about-us'
      assign apgo_aboutus_main_class = ' apgo-aboutus-main-particles'
    elsif template.name == 'page' and template.suffix == 'social_media'
      assign apgo_aboutus_main_class = ' apgo-aboutus-main-particles'
    endif

    assign apgo_body_page_class = ''
    if request.page_type == 'collection' and collection.handle == 'all'
      assign apgo_body_page_class = ' apgo-all-products-collection'
    endif
  %}

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}{{ apgo_body_page_class }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    {% comment %} 全站跑馬燈：靜態 section + settings_data，避免僅存在 header-group 檔時線上商店未同步而不渲染 {% endcomment %}
    {% section 'free-shipping-popup' %}

    <main
      id="MainContent"
      class="content-for-layout{{ apgo_aboutus_main_class }}"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% comment %}
      Homepage custom-liquid sections ship global `body, html { overflow-x: hidden }`.
      That rule is injected after theme CSS and breaks `position: sticky` on the header.
      `clip` suppresses horizontal overflow without the same sticky regression; `!important`
      runs after those inline section styles in document order.
    {% endcomment %}
    <style id="apgo-sticky-header-overflow-fix">
      html,
      body {
        overflow-x: clip !important;
      }
    </style>

    {%- comment -%}
      Scroll-up reveal for the header + marquee stack.

      Tricky bit: when the main header is sticky, header.liquid sets
      `#header-group { display: contents }`. Elements with display:contents
      generate NO box, so `transform` on them is ignored. We therefore have to
      transform #header-group's CHILDREN (the actual shopify-section shells:
      the main header section + the optional _blocks/secondary-menu section)
      and the marquee section in parallel.

      `position: sticky` defined in the sections themselves keeps layout flow
      unaffected. The slide distance comes from a JS-computed --apgo-stack-h
      variable so the off-screen translate exactly matches the live combined
      height (header + secondary menu + marquee).
    {%- endcomment -%}
    <style id="apgo-scroll-hide-css">
      /*
        Mobile only (≤749px). Desktop keeps the always-pinned sticky header
        + marquee that the user expects on larger viewports.

        The PDP tab bar (.apgo-pdp-tablist-wrap) is also covered: when the
        header + marquee slide up, the tab bar slides up the same distance
        so it ends at top:0 (its sticky `top` was already var(--stack-h)).
        Without this, the tab bar would stay in its original position and
        page content would scroll through the empty space above it.
      */
      @media (max-width: 749px) {
        #header-group > .shopify-section,
        #shopify-section-free-shipping-popup,
        .apgo-pdp-tablist-wrap {
          transition: transform .28s cubic-bezier(0.22, 1, 0.36, 1);
          will-change: transform;
        }
        body.apgo-scroll-hide #header-group > .shopify-section,
        body.apgo-scroll-hide #shopify-section-free-shipping-popup,
        body.apgo-scroll-hide .apgo-pdp-tablist-wrap {
          transform: translateY(calc(-1 * var(--apgo-stack-h, 120px)));
        }
      }
    </style>
    <script src="{{ 'apgo-scroll-hide.js' | asset_url }}" defer></script>

    {%- comment -%}
      Global APGO Gift-with-Purchase map (X variant id → Y variant id).
      Loaded on every page so quick-add (collection page), cart drawer,
      app-driven cart updates etc. all trigger gift reconciliation.

      To run a new GWP promo: add an entry below, then make sure the
      matching Shopify Discount (Buy X get Y) is set up so Y is free at
      checkout. The PDP-level emission in apgo_product_page_v3.liquid
      still works — both add into the same window.APGO_GIFT_MAP.
    {%- endcomment -%}
    <script>
      window.APGO_GIFT_MAP = window.APGO_GIFT_MAP || {};
      window.APGO_GIFT_PRODUCT_TITLES = window.APGO_GIFT_PRODUCT_TITLES || {};
      /* Hari Raya Haji Bundle → Car Wash Shampoo */
      window.APGO_GIFT_MAP[48112452010138] = 46516355006618;
      window.APGO_GIFT_PRODUCT_TITLES[48112452010138] = 'Atomic Glaze Coating Hari Raya Haji Bundle';
    </script>
    <script src="{{ 'apgo-gift-reconciler.js' | asset_url }}" defer></script>

    {% render 'search-modal' %}
    {% render 'apgo-cart-toast' %}
    {% if template.name == 'collection' %}
      {% render 'apgo-collection-variant-drawer' %}
    {% endif %}

    {% # theme-check-disable ParserBlockingScript %}
    <script src="{{ 'critical.js' | asset_url }}"></script>
    {% # theme-check-enable ParserBlockingScript %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
    
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const video = document.getElementById('brandVideo');
    if (!video) return;
    video.setAttribute('tabindex', '-1');
    video.addEventListener('pointerdown', () => video.blur());
    video.addEventListener('click', () => video.blur());
    video.addEventListener('focus', () => video.blur());
  });
</script>

  </body>
</html>
